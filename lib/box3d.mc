b3Vec3 b3Shape_GetClosestPoint(b3ShapeId shapeId, b3Vec3 target) {
    b3World* world = b3GetWorld(cast(i32, shapeId.world0));
    if world == null {
        return b3Vec3_zero;
    }
    b3Shape* shape = b3GetShape(world, shapeId);
    b3Body* body = world.bodies.data + shape.bodyId;
    b3Transform transform = b3ToRelativeTransform(b3GetBodyTransformQuick(world, body), b3Pos_zero);
    noinit b3DistanceInput input;
    input.proxyA = b3MakeShapeProxy(shape);
    input.proxyB = b3ShapeProxy{&target, 1, 0.0f};
    input.transform = b3InvMulTransforms(transform, b3Transform_identity);
    input.useRadii = true;
    b3SimplexCache cache;
    b3DistanceOutput output = b3ShapeDistance(&input, &cache, null, 0);
    return b3TransformPoint(transform, output.pointA);
}

// https://en.wikipedia.org/wiki/Density_of_air
// https://www.engineeringtoolbox.com/wind-load-d_1775.html
// force = 0.5 * air_density * velocity^2 * area
// https://en.wikipedia.org/wiki/Lift_(force)
void b3Shape_ApplyWind(b3ShapeId shapeId, b3Vec3 wind, f32 drag, f32 lift, f32 maxSpeed, bool wake) {
    b3World* world = b3GetWorld(cast(i32, shapeId.world0));
    if world == null {
        return;
    }
    while true {
        if world.recording != null {
            var recArgs = b3RecArgs_ShapeApplyWind{shapeId, wind, drag, lift, maxSpeed, wake};
            b3RecWrite_ShapeApplyWind(world.recording, &recArgs);
        }
        if !(0 != 0) { break; }
    }
    b3Shape* shape = b3GetShape(world, shapeId);
    b3ShapeType shapeType = shape.type;
    if shapeType != b3_sphereShape && shapeType != b3_capsuleShape && shapeType != b3_hullShape {
        return;
    }
    b3Body* body = world.bodies.data + shape.bodyId;
    if body.type != b3_dynamicBody {
        return;
    }
    if body.setIndex == b3_disabledSet {
        return;
    }
    if body.setIndex >= b3_firstSleepingSet && wake == false {
        return;
    }
    b3BodySim* sim = b3GetBodySim(world, body);
    if body.setIndex != b3_awakeSet {
        b3WakeBodyWithLock(world, body);
    }
    b3BodyState* state = b3GetBodyState(world, body);
    b3Transform transform = b3ToRelativeTransform(sim.transform, b3Pos_zero);
    f32 lengthUnits = b3GetLengthUnitsPerMeter();
    f32 volumeUnits = lengthUnits * lengthUnits * lengthUnits;
    f32 airDensity = 1.225f / volumeUnits;
    b3Vec3 force;
    b3Vec3 torque;
    switch shape.type {
        case b3_sphereShape: {
            {
                f32 radius = shape.sphere.radius;
                b3Vec3 centroid = shape.localCentroid;
                b3Vec3 lever = b3RotateVector(transform.q, b3Sub(centroid, sim.localCenter));
                b3Vec3 shapeVelocity = b3Add(state.linearVelocity, b3Cross(state.angularVelocity, lever));
                b3Vec3 relativeVelocity = b3MulSub(wind, drag, shapeVelocity);
                f32 speed;
                b3Vec3 direction = b3GetLengthAndNormalize(&speed, relativeVelocity);
                speed = b3MinFloat(speed, maxSpeed);
                f32 projectedArea = 3.14159265359f * radius * radius;
                force = b3MulSV(0.5f * airDensity * projectedArea * speed * speed, direction);
                torque = b3Cross(lever, force);
            }
        }
        case b3_capsuleShape: {
            {
                b3Vec3 centroid = shape.localCentroid;
                b3Vec3 lever = b3RotateVector(transform.q, b3Sub(centroid, sim.localCenter));
                b3Vec3 shapeVelocity = b3Add(state.linearVelocity, b3Cross(state.angularVelocity, lever));
                b3Vec3 relativeVelocity = b3MulSub(wind, drag, shapeVelocity);
                f32 speed;
                b3Vec3 direction = b3GetLengthAndNormalize(&speed, relativeVelocity);
                speed = b3MinFloat(speed, maxSpeed);
                b3Vec3 d = b3Sub(shape.capsule.center2, shape.capsule.center1);
                d = b3RotateVector(transform.q, d);
                f32 radius = shape.capsule.radius;
                f32 projectedArea = 3.14159265359f * radius * radius + 2.0f * radius * b3Length(b3Cross(d, direction));
                b3Vec3 e = b3Normalize(d);
                b3Vec3 normal = b3Sub(b3MulSV(b3Dot(direction, e), e), direction);
                b3Vec3 liftDirection = b3Cross(b3Cross(normal, direction), direction);
                f32 forceMagnitude = 0.5f * airDensity * projectedArea * speed * speed;
                force = b3MulSV(forceMagnitude, b3MulAdd(direction, lift, liftDirection));
                b3Vec3 edgeLever = b3MulAdd(lever, radius, normal);
                torque = b3Cross(edgeLever, force);
            }
        }
        case b3_hullShape: {
            {
                b3Matrix3 matrix = b3MakeMatrixFromQuat(transform.q);
                i32 faceCount = shape.hull.faceCount;
                b3Vec3* points = b3GetHullPoints(shape.hull);
                b3HullFace* faces = b3GetHullFaces(shape.hull);
                b3HullHalfEdge* edges = b3GetHullEdges(shape.hull);
                b3Plane* planes = b3GetHullPlanes(shape.hull);
                b3Vec3 linearVelocity = state.linearVelocity;
                b3Vec3 angularVelocity = state.angularVelocity;
                b3Vec3 localCenterOfMass = sim.localCenter;
                for i32 i = 0; i < faceCount; ++i {
                    b3HullFace* face = faces + i;
                    b3HullHalfEdge* edge1 = edges + face.edge;
                    b3HullHalfEdge* edge2 = edges + edge1.next;
                    b3HullHalfEdge* edge3 = edges + edge2.next;
                    b3Vec3 localPoint1 = points[edge1.origin];
                    b3Vec3 localPoint2 = points[edge2.origin];
                    b3Vec3 v1 = b3MulMV(matrix, localPoint1);
                    b3Vec3 v2 = b3MulMV(matrix, localPoint2);
                    b3Vec3 normal = b3MulMV(matrix, planes[i].normal);
                    while true {
                        b3Vec3 localPoint3 = points[edge3.origin];
                        b3Vec3 v3 = b3MulMV(matrix, localPoint3);
                        b3Vec3 localCenter = b3MulSV(0.333333f, b3Add(localPoint1, b3Add(localPoint2, localPoint3)));
                        b3Vec3 lever = b3MulMV(matrix, b3Sub(localCenter, localCenterOfMass));
                        b3Vec3 centerVelocity = b3Add(linearVelocity, b3Cross(angularVelocity, lever));
                        b3Vec3 relativeVelocity = b3MulSub(wind, drag, centerVelocity);
                        f32 speed;
                        b3Vec3 direction = b3GetLengthAndNormalize(&speed, relativeVelocity);
                        if b3Dot(normal, direction) < cast(f32, -FLT_EPSILON) {
                            f32 projectedArea = -0.5f * b3Dot(b3Cross(b3Sub(v2, v1), b3Sub(v3, v1)), direction);
                            b3Vec3 liftDirection = b3Cross(b3Cross(normal, direction), direction);
                            speed = b3MinFloat(speed, maxSpeed);
                            f32 forceMagnitude = 0.5f * airDensity * projectedArea * speed * speed;
                            b3Vec3 deltaForce = b3MulSV(forceMagnitude, b3MulAdd(direction, lift, liftDirection));
                            b3Vec3 deltaTorque = b3Cross(lever, deltaForce);
                            force = b3Add(force, deltaForce);
                            torque = b3Add(torque, deltaTorque);
                        }
                        edge2 = edge3;
                        edge3 = edges + edge3.next;
                        v2 = v3;
                        localPoint2 = localPoint3;
                        if !(edge1 != edge3) { break; }
                    }
                }
            }
        }
        default: {
        }
    }
    sim.force = b3Add(sim.force, force);
    sim.torque = b3Add(sim.torque, torque);
}

private {
bool b3MeshTimeOfImpactFcn(b3Vec3 a, b3Vec3 b, b3Vec3 c, i32 triangleIndex, void* context) {
    ignore triangleIndex;
    b3MeshImpactContext* toiContext = context;
    toiContext.visitCount += 1;
    b3Vec3 c1 = toiContext.meshLocalCentroidB1;
    b3Vec3 c2 = toiContext.meshLocalCentroidB2;
    b3Vec3 n = b3Normalize(b3Cross(b3Sub(b, a), b3Sub(c, a)));
    f32 offset1 = b3Dot(n, b3Sub(c1, a));
    f32 offset2 = b3Dot(n, b3Sub(c2, a));
    if offset1 < 0.0f {
        return true;
    }
    if toiContext.isSensor == false && offset1 - offset2 < toiContext.fallbackRadius && offset2 > toiContext.fallbackRadius {
        return true;
    }
    b3Vec3[3] triangle = {a, b, c};
    toiContext.toiInput.proxyA.points = triangle;
    toiContext.toiInput.proxyA.count = 3;
    b3TOIOutput output = b3TimeOfImpact(&toiContext.toiInput);
    if 0.0f < output.fraction && output.fraction < toiContext.toiInput.maxFraction {
        toiContext.toiOutput = output;
        toiContext.toiInput.maxFraction = output.fraction;
    } else if 0.0f == output.fraction {
        b3TOIInput fallbackInput = toiContext.toiInput;
        fallbackInput.proxyB = b3ShapeProxy{
            &toiContext.localCentroidB, 1,
            toiContext.fallbackRadius + 0.005f * b3GetLengthUnitsPerMeter(),
        };
        output = b3TimeOfImpact(&fallbackInput);
        if 0.0f < output.fraction && output.fraction < toiContext.toiInput.maxFraction {
            toiContext.toiOutput = output;
            toiContext.toiInput.maxFraction = output.fraction;
            toiContext.toiOutput.usedFallback = true;
        }
    }
    return true;
}

// Implements b3CompoundQueryFcn
bool b3CompoundTimeOfImpactFcn(b3CompoundData* compound, i32 childIndex, void* context) {
    var toiContext = cast(b3CompoundImpactContext*, context);
    b3ChildShape child = b3GetCompoundChild(compound, childIndex);
    b3TOIOutput output;
    toiContext.toiInput.sweepA = b3MakeCompoundChildSweep(toiContext.compoundTransform, child.transform);
    switch child.type {
        case b3_capsuleShape: {
            {
                toiContext.toiInput.proxyA.points = &child.capsule.center1;
                toiContext.toiInput.proxyA.count = 2;
                toiContext.toiInput.proxyA.radius = child.capsule.radius;
                output = b3TimeOfImpact(&toiContext.toiInput);
            }
        }
        case b3_hullShape: {
            {
                toiContext.toiInput.proxyA.points = b3GetHullPoints(child.hull);
                toiContext.toiInput.proxyA.count = child.hull.vertexCount;
                toiContext.toiInput.proxyA.radius = 0.0f;
                output = b3TimeOfImpact(&toiContext.toiInput);
            }
        }
        case b3_meshShape: {
            {
                b3MeshImpactContext meshContext;
                meshContext.toiInput = toiContext.toiInput;
                meshContext.isSensor = false;
                meshContext.localCentroidB = toiContext.localCentroidB;
                meshContext.fallbackRadius = toiContext.fallbackRadius;
                b3Transform meshWorldTransform = b3MulTransforms(toiContext.compoundTransform, child.transform);
                b3Sweep* sweepB = &toiContext.toiInput.sweepB;
                var xfB1 = b3Transform{
                    .p = b3Sub(sweepB.c1, b3RotateVector(sweepB.q1, sweepB.localCenter)),
                    .q = sweepB.q1,
                };
                var xfB2 = b3Transform{
                    .p = b3Sub(sweepB.c2, b3RotateVector(sweepB.q2, sweepB.localCenter)),
                    .q = sweepB.q2,
                };
                meshContext.meshLocalCentroidB1 = b3InvTransformPoint(meshWorldTransform, b3TransformPoint(xfB1, meshContext.localCentroidB));
                meshContext.meshLocalCentroidB2 = b3InvTransformPoint(meshWorldTransform, b3TransformPoint(xfB2, meshContext.localCentroidB));
                b3AABB localBounds = b3AABB_Transform(b3InvertTransform(child.transform), toiContext.localSweepBoundsB);
                b3QueryMesh(&child.mesh, localBounds, cast(b3MeshQueryFcn, b3MeshTimeOfImpactFcn), &meshContext);
                output = meshContext.toiOutput;
            }
        }
        case b3_sphereShape: {
            {
                toiContext.toiInput.proxyA.points = &child.sphere.center;
                toiContext.toiInput.proxyA.count = 1;
                toiContext.toiInput.proxyA.radius = child.sphere.radius;
                output = b3TimeOfImpact(&toiContext.toiInput);
            }
        }
        default: {
        }
    }
    if 0.0f < output.fraction && output.fraction < toiContext.toiInput.maxFraction {
        toiContext.toiOutput = output;
        toiContext.toiInput.maxFraction = output.fraction;
    }
    toiContext.toiInput.proxyA = b3ShapeProxy{};
    return true;
}
}

b3TOIOutput b3ShapeTimeOfImpact(b3Shape* shapeA, b3Shape* shapeB, b3Sweep* sweepA, b3Sweep* sweepB, f32 maxFraction) {
    bool isSensor = shapeA.sensorIndex != -1;
    b3ShapeType typeA = shapeA.type;
    if typeA == b3_compoundShape {
        b3CompoundImpactContext context;
        context.toiInput.proxyB = b3MakeShapeProxy(shapeB);
        context.toiInput.sweepB = *sweepB;
        context.toiInput.maxFraction = maxFraction;
        context.compoundTransform = b3Transform{.p = sweepA.c1, .q = sweepA.q1};
        b3Vec3 localCentroidB = b3GetShapeCentroid(shapeB);
        context.localCentroidB = localCentroidB;
        b3ShapeExtent extents = b3ComputeShapeExtent(shapeB, context.localCentroidB);
        context.fallbackRadius = b3MaxFloat(0.75f * extents.minExtent, 4.0f * (0.005f * b3GetLengthUnitsPerMeter()));
        b3AABB bounds = b3ComputeSweptShapeAABB(shapeB, sweepB, maxFraction);
        b3AABB localBounds = b3AABB_Transform(b3InvertTransform(context.compoundTransform), bounds);
        context.localSweepBoundsB = localBounds;
        b3QueryCompound(shapeA.compound, localBounds, cast(b3CompoundQueryFcn, b3CompoundTimeOfImpactFcn), &context);
        return context.toiOutput;
    }
    if typeA == b3_heightShape || typeA == b3_meshShape {
        u64 ticks = b3GetTicks();
        b3MeshImpactContext context;
        context.toiInput.sweepA = *sweepA;
        context.toiInput.proxyA.count = 3;
        context.toiInput.proxyB = b3MakeShapeProxy(shapeB);
        context.toiInput.sweepB = *sweepB;
        context.toiInput.maxFraction = maxFraction;
        context.isSensor = isSensor;
        b3Vec3 localCentroidB = b3GetShapeCentroid(shapeB);
        context.localCentroidB = localCentroidB;
        var xfA = b3Transform{
            .p = b3Sub(sweepA.c1, b3RotateVector(sweepA.q1, sweepA.localCenter)),
            .q = sweepA.q1,
        };
        var xfB1 = b3Transform{
            .p = b3Sub(sweepB.c1, b3RotateVector(sweepB.q1, sweepB.localCenter)),
            .q = sweepB.q1,
        };
        var xfB2 = b3Transform{
            .p = b3Sub(sweepB.c2, b3RotateVector(sweepB.q2, sweepB.localCenter)),
            .q = sweepB.q2,
        };
        context.meshLocalCentroidB1 = b3InvTransformPoint(xfA, b3TransformPoint(xfB1, localCentroidB));
        context.meshLocalCentroidB2 = b3InvTransformPoint(xfA, b3TransformPoint(xfB2, localCentroidB));
        b3ShapeExtent extents = b3ComputeShapeExtent(shapeB, context.localCentroidB);
        context.fallbackRadius = b3MaxFloat(0.5f * extents.minExtent, 0.005f * b3GetLengthUnitsPerMeter());
        b3AABB bounds = b3ComputeSweptShapeAABB(shapeB, sweepB, maxFraction);
        b3AABB localBounds = b3AABB_Transform(b3InvertTransform(xfA), bounds);
        if typeA == b3_meshShape {
            b3QueryMesh(&shapeA.mesh, localBounds, cast(b3MeshQueryFcn, b3MeshTimeOfImpactFcn), &context);
        } else if typeA == b3_heightShape {
            b3QueryHeightField(shapeA.heightField, localBounds, cast(b3MeshQueryFcn, b3MeshTimeOfImpactFcn), &context);
        }
        f32 ms = b3GetMilliseconds(ticks);
        if ms > 1000.0f * b3GetStallThreshold() {
            b3Log("CCD stall: visited %d triangles", context.visitCount);
        }
        return context.toiOutput;
    }
    noinit b3TOIInput input;
    input.proxyA = b3MakeShapeProxy(shapeA);
    input.proxyB = b3MakeShapeProxy(shapeB);
    input.sweepA = *sweepA;
    input.sweepB = *sweepB;
    input.maxFraction = maxFraction;
    b3TOIOutput output = b3TimeOfImpact(&input);
    return output;
}

// Resolve the user material id for a hit point on the given shape. Mesh/heightfield shapes
// use the manifold-point triangleIndex to pick a per-triangle material. Compound shapes use
// the contact's childIndex to find the participating child, then for a mesh child apply the
// child's materialIndices indirection on top of the per-triangle index. Convex shapes fall
// back to materials[0]. childIndex is unused for non-compound shapes.
u64 b3GetShapeUserMaterialId(b3Shape* shape, i32 childIndex, i32 triangleIndex) {
    if shape.materialCount == 0 {
        return 0;
    }
    i32 materialIndex = 0;
    if shape.type == b3_meshShape {
        u8* indices = b3GetMeshMaterialIndices(shape.mesh.data);
        if indices != null {
            materialIndex = cast(i32, indices[triangleIndex]);
        }
    } else if shape.type == b3_heightShape {
        materialIndex = b3GetHeightFieldMaterial(shape.heightField, triangleIndex);
    } else if shape.type == b3_compoundShape {
        b3ChildShape child = b3GetCompoundChild(shape.compound, childIndex);
        if child.type == b3_meshShape {
            u8* indices = b3GetMeshMaterialIndices(child.mesh.data);
            var meshMaterialIndex = cast(i32, indices != null ? indices[triangleIndex] : 0);
            meshMaterialIndex = b3ClampInt(meshMaterialIndex, 0, 4 - 1);
            materialIndex = child.materialIndices[meshMaterialIndex];
        } else {
            materialIndex = child.materialIndices[0];
        }
    }
    materialIndex = b3ClampInt(materialIndex, 0, shape.materialCount - 1);
    return b3GetShapeMaterials(shape)[materialIndex].userMaterialId;
}

// SPDX-FileCopyrightText: 2026 Erin Catto
// SPDX-License-Identifier: MIT
// Dirk Gregorius contributed portions of this code
private {
b3V32 b3SplatXV(b3V32 v) {
    return v.xxxx;
}

b3V32 b3SplatYV(b3V32 v) {
    return v.yyyy;
}

b3V32 b3SplatZV(b3V32 v) {
    return v.zzzz;
}

bool b3AnyGreaterEq3V(b3V32 a, b3V32 b) {
    b3V32 v = cmpge4(a, b);
    return (movemask4(v) & 0x07) != 0;
}

b3V32 b3Dot3V(b3V32 a, b3V32 b) {
    b3V32 m = a * b;
    b3V32 x = m.xxxx;
    b3V32 y = m.yyyy;
    b3V32 z = m.zzzz;
    return x + y + z;
}
}

bool b3TestBoundsTriangleOverlap(b3V32 nodeCenter, b3V32 nodeExtent, b3V32 vertex1, b3V32 vertex2, b3V32 vertex3) {
    b3V32 two = b3SplatV(2.0f);
    vertex1 = b3SubV(vertex1, nodeCenter);
    vertex2 = b3SubV(vertex2, nodeCenter);
    vertex3 = b3SubV(vertex3, nodeCenter);
    b3V32 triangleMin = b3MinV(vertex1, b3MinV(vertex2, vertex3));
    b3V32 triangleMax = b3MaxV(vertex1, b3MaxV(vertex2, vertex3));
    b3V32 separation1 = b3SubV(triangleMin, nodeExtent);
    b3V32 separation2 = b3AddV(triangleMax, nodeExtent);
    b3V32 faceSeparation = b3MaxV(separation1, b3NegV(separation2));
    if b3AnyGreater3V(faceSeparation, b3_zeroV) != 0 {
        return false;
    }
    b3V32 edge1 = b3SubV(vertex2, vertex1);
    b3V32 edge2 = b3SubV(vertex3, vertex2);
    b3V32 edge3 = b3SubV(vertex1, vertex3);
    b3V32 normal = b3CrossV(edge1, edge2);
    b3V32 triangleSeparation = b3SubV(b3AbsV(b3Dot3V(normal, vertex1)), b3Dot3V(b3AbsV(normal), nodeExtent));
    if b3AnyGreater3V(triangleSeparation, b3_zeroV) != 0 {
        return false;
    }
    b3V32 edgeSeparation1 = b3SubV(b3SubV(b3AbsV(b3CrossV(edge1, b3AddV(vertex1, vertex3))), b3AbsV(b3CrossV(edge1, edge3))), b3MulV(two, b3ModifiedCrossV(b3AbsV(edge1), nodeExtent)));
    if b3AnyGreater3V(edgeSeparation1, b3_zeroV) != 0 {
        return false;
    }
    b3V32 edgeSeparation2 = b3SubV(b3SubV(b3AbsV(b3CrossV(edge2, b3AddV(vertex1, vertex2))), b3AbsV(b3CrossV(edge2, edge1))), b3MulV(two, b3ModifiedCrossV(b3AbsV(edge2), nodeExtent)));
    if b3AnyGreater3V(edgeSeparation2, b3_zeroV) != 0 {
        return false;
    }
    b3V32 edgeSeparation3 = b3SubV(b3SubV(b3AbsV(b3CrossV(edge3, b3AddV(vertex2, vertex3))), b3AbsV(b3CrossV(edge3, edge2))), b3MulV(two, b3ModifiedCrossV(b3AbsV(edge3), nodeExtent)));
    if b3AnyGreater3V(edgeSeparation3, b3_zeroV) != 0 {
        return false;
    }
    return true;
}

f32 b3IntersectRayTriangle(b3V32 rayStart, b3V32 rayDelta, b3V32 vertex1, b3V32 vertex2, b3V32 vertex3) {
    {
        b3V32 edge1 = b3SubV(vertex3, vertex2);
        b3V32 edge2 = b3SubV(vertex1, vertex3);
        b3V32 edge3 = b3SubV(vertex2, vertex1);
        b3V32 midPoint1 = b3MulV(b3_halfV, b3AddV(vertex2, vertex3));
        b3V32 midPoint2 = b3MulV(b3_halfV, b3AddV(vertex3, vertex1));
        b3V32 midPoint3 = b3MulV(b3_halfV, b3AddV(vertex1, vertex2));
        b3V32 normal1 = b3CrossV(edge1, b3SubV(midPoint1, rayStart));
        b3V32 normal2 = b3CrossV(edge2, b3SubV(midPoint2, rayStart));
        b3V32 normal3 = b3CrossV(edge3, b3SubV(midPoint3, rayStart));
        {
            var T1 = float4{normal1.x, normal2.x, normal1.y, normal2.y};
            var T2 = float4{normal1.z, normal2.z, normal1.w, normal2.w};
            normal1 = float4{T1.x, T1.y, normal3.x, normal3.x};
            normal2 = float4{T1.z, T1.w, normal3.y, normal3.y};
            normal3 = float4{T2.x, T2.y, normal3.z, normal3.z};
        }
        b3V32 rayDeltaX = b3SplatXV(rayDelta);
        b3V32 rayDeltaY = b3SplatYV(rayDelta);
        b3V32 rayDeltaZ = b3SplatZV(rayDelta);
        b3V32 volumes = b3AddV(b3AddV(b3MulV(normal1, rayDeltaX), b3MulV(normal2, rayDeltaY)), b3MulV(normal3, rayDeltaZ));
        if b3AnyLess3V(volumes, b3_zeroV) != 0 {
            return 1.0f;
        }
    }
    b3V32 edge1 = b3SubV(vertex2, vertex1);
    b3V32 edge2 = b3SubV(vertex3, vertex1);
    b3V32 normal = b3CrossV(edge1, edge2);
    b3V32 denominator = b3Dot3V(normal, rayDelta);
    if b3AnyGreaterEq3V(denominator, b3_zeroV) != 0 {
        return 1.0f;
    }
    b3V32 lambda = b3DivV(b3Dot3V(normal, b3SubV(vertex1, rayStart)), denominator);
    if b3AnyLessEq3V(lambda, b3_zeroV) != 0 {
        return 1.0f;
    }
    lambda = b3MinV(lambda, b3_oneV);
    return b3GetXV(lambda);
}
// SPDX-FileCopyrightText: 2025 Erin Catto
// SPDX-License-Identifier: MIT

// these are useful for solver testing
private {
void b3Pause() {
}

// Integrate velocities, apply damping, and gyroscopic torque
void b3IntegrateVelocitiesTask(b3SolverBlock block, b3StepContext* context) {
    b3BodyState* states = context.states;
    b3BodySim* sims = context.sims;
    b3Vec3 gravity = context.world.gravity;
    f32 h = context.h;
    for i32 i = block.startIndex; i < block.startIndex + block.count; ++i {
        b3BodySim* sim = sims + i;
        b3BodyState* state = states + i;
        b3Vec3 v = state.linearVelocity;
        b3Vec3 w = state.angularVelocity;
        f32 linearDamping = 1.0f / (1.0f + h * sim.linearDamping);
        f32 angularDamping = 1.0f / (1.0f + h * sim.angularDamping);
        f32 gravityScale = sim.invMass > 0.0f ? sim.gravityScale : 0.0f;
        b3Vec3 linearVelocityDelta = b3Blend2(h * sim.invMass, sim.force, h * gravityScale, gravity);
        v = b3MulAdd(linearVelocityDelta, linearDamping, v);
        b3Vec3 angularVelocityDelta = b3MulSV(h, b3MulMV(sim.invInertiaWorld, sim.torque));
        w = b3MulAdd(angularVelocityDelta, angularDamping, w);
        {
            b3Quat q0 = sim.transform.q;
            b3Quat q = b3MulQuat(state.deltaRotation, q0);
            b3Matrix3 inertiaLocal = b3InvertMatrix(sim.invInertiaLocal);
            b3Vec3 omega1 = b3InvRotateVector(q, w);
            b3Vec3 omega2 = omega1;
            f32 i00 = inertiaLocal.cx.x;
            f32 i01 = inertiaLocal.cy.x;
            f32 i02 = inertiaLocal.cz.x;
            f32 i11 = inertiaLocal.cy.y;
            f32 i12 = inertiaLocal.cz.y;
            f32 i22 = inertiaLocal.cz.z;
            for i32 gyroIteration = 0; gyroIteration < 1; ++gyroIteration {
                f32 w1 = omega2.x;
                f32 w2 = omega2.y;
                f32 w3 = omega2.z;
                f32 Iw1 = i00 * w1 + i01 * w2 + i02 * w3;
                f32 Iw2 = i01 * w1 + i11 * w2 + i12 * w3;
                f32 Iw3 = i02 * w1 + i12 * w2 + i22 * w3;
                b3Vec3 dw = b3Sub(omega2, omega1);
                var b = b3Vec3{
                    i00 * dw.x + i01 * dw.y + i02 * dw.z + h * (w2 * Iw3 - w3 * Iw2),
                    i01 * dw.x + i11 * dw.y + i12 * dw.z + h * (w3 * Iw1 - w1 * Iw3),
                    i02 * dw.x + i12 * dw.y + i22 * dw.z + h * (w1 * Iw2 - w2 * Iw1),
                };
                var J = b3Matrix3{
                    b3Vec3{
                        i00 + h * (w2 * i02 - w3 * i01), i01 + h * (w3 * i00 - w1 * i02 - Iw3),
                        i02 + h * (w1 * i01 - w2 * i00 + Iw2),
                    },
                    b3Vec3{
                        i01 + h * (w2 * i12 - w3 * i11 + Iw3), i11 + h * (w3 * i01 - w1 * i12),
                        i12 + h * (w1 * i11 - w2 * i01 - Iw1),
                    },
                    b3Vec3{
                        i02 + h * (w2 * i22 - w3 * i12 - Iw2),
                        i12 + h * (w3 * i02 - w1 * i22 + Iw1), i22 + h * (w1 * i12 - w2 * i02),
                    },
                };
                omega2 = b3Sub(omega2, b3Solve3(J, b));
            }
            w = b3RotateVector(q, omega2);
        }
        state.linearVelocity = v;
        state.angularVelocity = w;
    }
}

void b3IntegratePositionsTask(b3SolverBlock block, b3StepContext* context) {
    b3BodyState* states = context.states;
    f32 h = context.h;
    f32 maxLinearSpeed = context.maxLinearVelocity;
    f32 maxAngularSpeed = 0.25f * 3.14159265359f * context.inv_dt;
    f32 maxLinearSpeedSquared = maxLinearSpeed * maxLinearSpeed;
    f32 maxAngularSpeedSquared = maxAngularSpeed * maxAngularSpeed;
    for i32 i = block.startIndex; i < block.startIndex + block.count; ++i {
        b3BodyState* state = states + i;
        b3Vec3 v = state.linearVelocity;
        b3Vec3 w = state.angularVelocity;
        v.x = (state.flags & cast(u32, b3_lockLinearX)) != 0 ? 0.0f : v.x;
        v.y = (state.flags & cast(u32, b3_lockLinearY)) != 0 ? 0.0f : v.y;
        v.z = (state.flags & cast(u32, b3_lockLinearZ)) != 0 ? 0.0f : v.z;
        w.x = (state.flags & cast(u32, b3_lockAngularX)) != 0 ? 0.0f : w.x;
        w.y = (state.flags & cast(u32, b3_lockAngularY)) != 0 ? 0.0f : w.y;
        w.z = (state.flags & cast(u32, b3_lockAngularZ)) != 0 ? 0.0f : w.z;
        if b3Dot(v, v) > maxLinearSpeedSquared {
            f32 ratio = maxLinearSpeed / b3Length(v);
            v = b3MulSV(ratio, v);
            state.flags |= cast(u32, b3_isSpeedCapped);
        }
        if b3Dot(w, w) > maxAngularSpeedSquared && (state.flags & cast(u32, b3_allowFastRotation)) == 0 {
            f32 ratio = maxAngularSpeed / b3Length(w);
            w = b3MulSV(ratio, w);
            state.flags |= cast(u32, b3_isSpeedCapped);
        }
        state.linearVelocity = v;
        state.angularVelocity = w;
        state.deltaPosition = b3MulAdd(state.deltaPosition, h, v);
        state.deltaRotation = b3IntegrateRotation(state.deltaRotation, b3MulSV(h, w));
    }
}

void b3PrepareJointsTask(b3SolverBlock block, b3StepContext* context) {
    b3JointPrepareSpan* spans = context.jointPrepareSpans;
    i32 index = block.startIndex;
    i32 endIndex = block.startIndex + block.count;
    i32 colorIndex = 0;
    while spans[colorIndex + 1].start <= index {
        colorIndex += 1;
    }
    while index < endIndex {
        i32 colorStart = spans[colorIndex].start;
        i32 colorEndIndex = b3MinInt(spans[colorIndex + 1].start, endIndex);
        b3JointSim* joints = spans[colorIndex].joints;
        for ; index < colorEndIndex; ++index {
            b3JointSim* joint = joints + (index - colorStart);
            b3PrepareJoint(joint, context);
        }
        colorIndex += 1;
    }
}

void b3WarmStartJointsTask(b3SolverBlock block, b3StepContext* context) {
    b3GraphColor* color = context.graph.colors + block.colorIndex;
    b3JointSim* joints = color.jointSims.data;
    for i32 i = block.startIndex; i < block.startIndex + block.count; ++i {
        b3JointSim* joint = joints + i;
        b3WarmStartJoint(joint, context);
    }
}

void b3SolveJointsTask(b3SolverBlock block, b3StepContext* context, bool useBias, i32 workerIndex) {
    b3GraphColor* color = context.graph.colors + block.colorIndex;
    b3JointSim* joints = color.jointSims.data;
    b3BitSet* jointStateBitSet = &context.world.taskContexts.data[workerIndex].jointStateBitSet;
    for i32 i = block.startIndex; i < block.startIndex + block.count; ++i {
        b3JointSim* joint = joints + i;
        b3SolveJoint(joint, context, useBias);
        if useBias && (joint.forceThreshold < FLT_MAX || joint.torqueThreshold < FLT_MAX) && b3GetBit(jointStateBitSet, cast(u32, joint.jointId)) == false {
            f32 force;
            f32 torque;
            b3GetJointReaction(context.world, joint, context.inv_h, &force, &torque);
            if force >= joint.forceThreshold || torque >= joint.torqueThreshold {
                b3SetBit(jointStateBitSet, cast(u32, joint.jointId));
            }
        }
    }
}

// This is called from b3DynamicTree_Query for continuous collision
bool b3ContinuousQueryCallback(i32 proxyId, u64 userData, void* context) {
    ignore proxyId;
    var shapeId = cast(i32, userData);
    b3ContinuousContext* continuousContext = context;
    continuousContext.visitCount += 1;
    b3Shape* fastShape = continuousContext.fastShape;
    b3BodySim* fastBodySim = continuousContext.fastBodySim;
    if shapeId == fastShape.id {
        return true;
    }
    b3World* world = continuousContext.world;
    b3Shape* shape = world.shapes.data + shapeId;
    if shape.bodyId == fastShape.bodyId {
        return true;
    }
    bool isSensor = shape.sensorIndex != -1;
    if isSensor && ((shape.flags & b3_enableSensorEvents) == 0 || (fastShape.flags & b3_enableSensorEvents) == 0) {
        return true;
    }
    bool canCollide = b3ShouldShapesCollide(fastShape.filter, shape.filter);
    if canCollide == false {
        return true;
    }
    b3Body* body = world.bodies.data + shape.bodyId;
    b3BodySim* bodySim = b3GetBodySim(world, body);
    if (bodySim.flags & cast(u32, b3_isBullet)) != 0 {
        return true;
    }
    b3Body* fastBody = world.bodies.data + fastBodySim.bodyId;
    canCollide = b3ShouldBodiesCollide(world, fastBody, body);
    if canCollide == false {
        return true;
    }
    if (shape.flags & b3_enableCustomFiltering) != 0 || (fastShape.flags & b3_enableCustomFiltering) != 0 {
        b3CustomFilterFcn customFilterFcn = world.customFilterFcn;
        if customFilterFcn != null {
            var idA = b3ShapeId{shape.id + 1, world.worldId, shape.generation};
            var idB = b3ShapeId{fastShape.id + 1, world.worldId, fastShape.generation};
            canCollide = customFilterFcn(idA, idB, world.customFilterContext);
            if canCollide == false {
                return true;
            }
        }
    }
    u64 ticks = b3GetTicks();
    b3Sweep sweepA = b3MakeRelativeSweep(bodySim, continuousContext.base);
    b3TOIOutput output = b3ShapeTimeOfImpact(shape, fastShape, &sweepA, &continuousContext.sweep, continuousContext.fraction);
    if isSensor != 0 {
        if output.fraction <= continuousContext.fraction && continuousContext.sensorCount < 8 {
            i32 index = continuousContext.sensorCount;
            var sensorHit = b3SensorHit{.sensorId = shape.id, .visitorId = fastShape.id};
            continuousContext.sensorHits[index] = sensorHit;
            continuousContext.sensorFractions[index] = output.fraction;
            continuousContext.sensorCount += 1;
        }
    } else if 0.0f < output.fraction && output.fraction < continuousContext.fraction {
        bool didHit = true;
        if didHit && (shape.flags & b3_enablePreSolveEvents || fastShape.flags & b3_enablePreSolveEvents) {
            var shapeIdA = b3ShapeId{shape.id + 1, world.worldId, shape.generation};
            var shapeIdB = b3ShapeId{fastShape.id + 1, world.worldId, fastShape.generation};
            b3Pos point = b3OffsetPos(continuousContext.base, output.point);
            didHit = world.preSolveFcn(shapeIdA, shapeIdB, point, output.normal, world.preSolveContext);
        }
        if didHit != 0 {
            fastBodySim.flags |= cast(u32, b3_hadTimeOfImpact);
            continuousContext.fraction = output.fraction;
            continuousContext.distanceIterations = b3MaxInt(continuousContext.distanceIterations, output.distanceIterations);
            continuousContext.pushBackIterations = b3MaxInt(continuousContext.pushBackIterations, output.pushBackIterations);
            continuousContext.rootIterations = b3MaxInt(continuousContext.rootIterations, output.rootIterations);
        }
    }
    f32 ms = b3GetMilliseconds(ticks);
    if ms > 1000.0f * b3GetStallThreshold() {
        u8* nameFast = b3FindNameWithDefault(&world.names, fastBody.nameId, "NULL");
        u8* name = b3FindNameWithDefault(&world.names, body.nameId, "NULL");
        b3Log("CCD stall: duration %.1f ms for %s versus %s", ms, nameFast, name);
    }
    return true;
}

// Continuous collision of dynamic versus static
void b3SolveContinuous(b3World* world, i32 bodySimIndex, b3TaskContext* taskContext) {
    u64 ticks = b3GetTicks();
    b3SolverSet* awakeSet = world.solverSets.data + b3_awakeSet;
    b3BodySim* fastBodySim = awakeSet.bodySims.data + bodySimIndex;
    b3Pos base = fastBodySim.center0;
    b3Sweep sweep = b3MakeRelativeSweep(fastBodySim, base);
    noinit b3Transform xf1;
    xf1.q = sweep.q1;
    xf1.p = b3Sub(sweep.c1, b3RotateVector(sweep.q1, sweep.localCenter));
    noinit b3Transform xf2;
    xf2.q = sweep.q2;
    xf2.p = b3Sub(sweep.c2, b3RotateVector(sweep.q2, sweep.localCenter));
    b3DynamicTree* staticTree = world.broadPhase.trees + b3_staticBody;
    b3DynamicTree* kinematicTree = world.broadPhase.trees + b3_kinematicBody;
    b3DynamicTree* dynamicTree = world.broadPhase.trees + b3_dynamicBody;
    b3Body* fastBody = world.bodies.data + fastBodySim.bodyId;
    b3ContinuousContext context;
    context.world = world;
    context.sweep = sweep;
    context.base = base;
    context.fastBodySim = fastBodySim;
    context.fraction = 1.0f;
    bool isBullet = (fastBodySim.flags & cast(u32, b3_isBullet)) != 0;
    i32 shapeId = fastBody.headShapeId;
    while shapeId != -1 {
        b3Shape* fastShape = world.shapes.data + shapeId;
        shapeId = fastShape.nextShapeId;
        context.fastShape = fastShape;
        context.centroid1 = b3TransformPoint(xf1, fastShape.localCentroid);
        context.centroid2 = b3TransformPoint(xf2, fastShape.localCentroid);
        b3AABB box1 = fastShape.aabb;
        b3AABB box2 = b3OffsetAABB(b3ComputeShapeAABB(fastShape, xf2), base);
        fastShape.aabb = box2;
        if fastShape.type == b3_meshShape || fastShape.type == b3_heightShape {
            continue;
        }
        if fastShape.sensorIndex != -1 {
            continue;
        }
        b3AABB sweptBox = b3AABB_Union(box1, box2);
        b3DynamicTree_Query(staticTree, sweptBox, -1, false, cast(b3TreeQueryCallbackFcn, b3ContinuousQueryCallback), &context);
        if isBullet != 0 {
            b3DynamicTree_Query(kinematicTree, sweptBox, -1, false, cast(b3TreeQueryCallbackFcn, b3ContinuousQueryCallback), &context);
            b3DynamicTree_Query(dynamicTree, sweptBox, -1, false, cast(b3TreeQueryCallbackFcn, b3ContinuousQueryCallback), &context);
        }
    }
    f32 speculativeScalar = 4.0f * (0.005f * b3GetLengthUnitsPerMeter());
    if context.fraction < 1.0f {
        b3Quat q = b3NLerp(sweep.q1, sweep.q2, context.fraction);
        b3Vec3 c = b3Lerp(sweep.c1, sweep.c2, context.fraction);
        b3Vec3 origin = b3Sub(c, b3RotateVector(q, sweep.localCenter));
        var transform = b3WorldTransform{b3OffsetPos(base, origin), q};
        b3Pos center = b3OffsetPos(base, c);
        fastBodySim.transform = transform;
        fastBodySim.center = center;
        fastBodySim.rotation0 = q;
        fastBodySim.center0 = center;
        b3BodyMoveEvent* event = world.bodyMoveEvents.data + bodySimIndex;
        event.transform = fastBodySim.transform;
        shapeId = fastBody.headShapeId;
        while shapeId != -1 {
            b3Shape* shape = world.shapes.data + shapeId;
            b3AABB aabb = b3ComputeFatShapeAABB(shape, transform, speculativeScalar);
            shape.aabb = aabb;
            if b3AABB_Contains(shape.fatAABB, aabb) == false {
                f32 marginScalar = shape.aabbMargin;
                var aabbMargin = b3Vec3{marginScalar, marginScalar, marginScalar};
                shape.fatAABB = b3AABB{
                    b3Sub(aabb.lowerBound, aabbMargin), b3Add(aabb.upperBound, aabbMargin),
                };
                shape.flags |= cast(u8, b3_enlargedAABB);
                fastBodySim.flags |= cast(u32, b3_enlargeBounds);
            }
            shapeId = shape.nextShapeId;
        }
    } else {
        fastBodySim.rotation0 = fastBodySim.transform.q;
        fastBodySim.center0 = fastBodySim.center;
        shapeId = fastBody.headShapeId;
        while shapeId != -1 {
            b3Shape* shape = world.shapes.data + shapeId;
            if b3AABB_Contains(shape.fatAABB, shape.aabb) == false {
                f32 marginScalar = shape.aabbMargin;
                var aabbMargin = b3Vec3{marginScalar, marginScalar, marginScalar};
                shape.fatAABB = b3AABB{
                    .lowerBound = b3Sub(shape.aabb.lowerBound, aabbMargin),
                    .upperBound = b3Add(shape.aabb.upperBound, aabbMargin),
                };
                shape.flags |= cast(u8, b3_enlargedAABB);
                fastBodySim.flags |= cast(u32, b3_enlargeBounds);
            }
            shapeId = shape.nextShapeId;
        }
    }
    for i32 i = 0; i < context.sensorCount; ++i {
        if context.sensorFractions[i] < context.fraction {
            while true {
                if taskContext.sensorHits.count >= taskContext.sensorHits.capacity {
                    var oldSize = cast(i32, taskContext.sensorHits.capacity * sizeof(*taskContext.sensorHits.data));
                    i32 newCapacity = taskContext.sensorHits.capacity == 0 ? 8 : 2 * taskContext.sensorHits.capacity;
                    var newSize = cast(i32, newCapacity * sizeof(*taskContext.sensorHits.data));
                    taskContext.sensorHits.data = b3GrowAlloc(taskContext.sensorHits.data, oldSize, newSize);
                    taskContext.sensorHits.capacity = newCapacity;
                }
                taskContext.sensorHits.data[taskContext.sensorHits.count++] = context.sensorHits[i];
                if !(0 != 0) { break; }
            }
        }
    }
    taskContext.distanceIterations = b3MaxInt(taskContext.distanceIterations, context.distanceIterations);
    taskContext.pushBackIterations = b3MaxInt(taskContext.pushBackIterations, context.pushBackIterations);
    taskContext.rootIterations = b3MaxInt(taskContext.rootIterations, context.rootIterations);
    f32 ms = b3GetMilliseconds(ticks);
    if ms > 1000.0f * b3GetStallThreshold() {
        u8* nameFast = b3FindNameWithDefault(&world.names, fastBody.nameId, "NULL");
        b3Vec3 c1 = sweep.c1;
        b3Vec3 c2 = sweep.c2;
        i32 vc = context.visitCount;
        b3Log("CCD stall: duration %.1f ms and visit count %d for %s: c1 = (%g, %g, %g), c2 = (%g, %g, %g)", ms, vc, nameFast, c1.x, c1.y, c1.z, c2.x, c2.y, c2.z);
    }
}

// Implements b3ParallelForCallback
void b3FinalizeBodiesTask(i32 startIndex, i32 endIndex, i32 workerIndex, void* context) {
    var stepContext = cast(b3StepContext*, context);
    b3World* world = stepContext.world;
    b3Body* bodies = world.bodies.data;
    b3BodySim* sims = stepContext.sims;
    b3BodyState* states = stepContext.states;
    bool enableSleep = world.enableSleep;
    bool enableContinuous = world.enableContinuous;
    f32 timeStep = stepContext.dt;
    f32 invTimeStep = stepContext.inv_dt;
    u16 worldId = world.worldId;
    b3BodyMoveEvent* moveEvents = world.bodyMoveEvents.data;
    b3TaskContext* taskContext = world.taskContexts.data + workerIndex;
    b3BitSet* enlargedSimBitSet = &taskContext.enlargedSimBitSet;
    b3BitSet* awakeIslandBitSet = &taskContext.awakeIslandBitSet;
    f32 speculativeScalar = 4.0f * (0.005f * b3GetLengthUnitsPerMeter());
    for i32 simIndex = startIndex; simIndex < endIndex; ++simIndex {
        b3BodyState* state = states + simIndex;
        b3BodySim* sim = sims + simIndex;
        b3Vec3 v = state.linearVelocity;
        b3Vec3 w = state.angularVelocity;
        b3Vec3 localOmega = b3InvRotateVector(sim.transform.q, w);
        b3Vec3 localDeltaRotation = b3InvRotateVector(sim.transform.q, state.deltaRotation.v);
        if b3IsValidVec3(v) == false || b3IsValidVec3(w) == false {
            u8* name = b3FindNameWithDefault(&world.names, bodies[sim.bodyId].nameId, "NULL");
            b3Log("unstable: %s", name);
        }
        sim.center = b3OffsetPos(sim.center, state.deltaPosition);
        sim.transform.q = b3NormalizeQuat(b3MulQuat(state.deltaRotation, sim.transform.q));
        b3Vec3 velocityArc = b3ModifiedCross(b3Abs(localOmega), sim.maxExtent);
        f32 maxVelocity = b3Length(v) + b3Length(velocityArc);
        b3Vec3 rotationArc = b3ModifiedCross(b3Abs(localDeltaRotation), sim.maxExtent);
        f32 maxDeltaPosition = b3Length(state.deltaPosition) + 2.0f * b3Length(rotationArc);
        f32 positionSleepFactor = 0.5f;
        f32 sleepVelocity = b3MaxFloat(maxVelocity, positionSleepFactor * invTimeStep * maxDeltaPosition);
        state.deltaPosition = b3Vec3_zero;
        state.deltaRotation = b3Quat_identity;
        sim.transform.p = b3OffsetPos(sim.center, b3Neg(b3RotateVector(sim.transform.q, sim.localCenter)));
        b3Body* body = bodies + sim.bodyId;
        body.bodyMoveIndex = simIndex;
        body.sleepVelocity = sleepVelocity;
        moveEvents[simIndex].userData = body.userData;
        moveEvents[simIndex].transform = sim.transform;
        moveEvents[simIndex].bodyId = b3BodyId{sim.bodyId + 1, worldId, body.generation};
        moveEvents[simIndex].fellAsleep = false;
        sim.force = b3Vec3_zero;
        sim.torque = b3Vec3_zero;
        body.flags &= cast(u32, ~b3_bodyTransientFlags);
        body.flags |= sim.flags & cast(u32, b3_isSpeedCapped | b3_hadTimeOfImpact);
        body.flags |= state.flags & cast(u32, b3_isSpeedCapped | b3_hadTimeOfImpact);
        sim.flags &= cast(u32, ~b3_bodyTransientFlags);
        state.flags &= cast(u32, ~b3_bodyTransientFlags);
        if enableSleep == false || (body.flags & cast(u32, b3_enableSleep)) == 0 || sleepVelocity > body.sleepThreshold {
            body.sleepTime = 0.0f;
            f32 safetyFactor = 0.5f;
            f32 maxMotion = b3MaxFloat(maxDeltaPosition, maxVelocity * timeStep);
            if body.type == b3_dynamicBody && enableContinuous && maxMotion > safetyFactor * sim.minExtent {
                sim.flags |= cast(u32, b3_isFast);
                if (sim.flags & cast(u32, b3_isBullet)) != 0 {
                    i32 bulletIndex = b3AtomicFetchAddInt(&stepContext.bulletBodyCount, 1);
                    stepContext.bulletBodies[bulletIndex] = simIndex;
                } else {
                    b3SolveContinuous(world, simIndex, taskContext);
                }
            } else {
                sim.center0 = sim.center;
                sim.rotation0 = sim.transform.q;
            }
        } else {
            sim.center0 = sim.center;
            sim.rotation0 = sim.transform.q;
            body.sleepTime += timeStep;
        }
        sim.invInertiaWorld = b3RotateInvInertia(sim.transform.q, sim.invInertiaLocal);
        b3Island* island = world.islands.data + body.islandId;
        if body.sleepTime < 0.5f {
            i32 islandIndex = island.localIndex;
            b3SetBit(awakeIslandBitSet, cast(u32, islandIndex));
        } else if island.constraintRemoveCount > 0 {
            if body.sleepTime > taskContext.splitSleepTime || body.sleepTime == taskContext.splitSleepTime && body.islandId > taskContext.splitIslandId {
                taskContext.splitIslandId = body.islandId;
                taskContext.splitSleepTime = body.sleepTime;
            }
        }
        b3WorldTransform transform = sim.transform;
        bool isFast = (sim.flags & cast(u32, b3_isFast)) != 0;
        i32 shapeId = body.headShapeId;
        while shapeId != -1 {
            b3Shape* shape = world.shapes.data + shapeId;
            if isFast != 0 {
                b3SetBit(enlargedSimBitSet, cast(u32, simIndex));
            } else {
                b3AABB aabb = b3ComputeFatShapeAABB(shape, transform, speculativeScalar);
                shape.aabb = aabb;
                if b3AABB_Contains(shape.fatAABB, aabb) == false {
                    f32 marginScalar = shape.aabbMargin;
                    var aabbMargin = b3Vec3{marginScalar, marginScalar, marginScalar};
                    shape.fatAABB = b3AABB{
                        b3Sub(aabb.lowerBound, aabbMargin), b3Add(aabb.upperBound, aabbMargin),
                    };
                    shape.flags |= cast(u8, b3_enlargedAABB);
                    b3SetBit(enlargedSimBitSet, cast(u32, simIndex));
                }
            }
            shapeId = shape.nextShapeId;
        }
    }
}

// A block is a range of tasks, a start index and count as a sub-array. Each worker receives at
// most M blocks of work. The workers may receive less blocks if there is not sufficient work.
// Each block of work has a minimum number of elements (block size). This in turn may limit the
// number of blocks. If there are many elements then the block size is increased so there are
// still at most M blocks of work per worker. M is a tunable number that has two goals:
// 1. keep M small to reduce overhead
// 2. keep M large enough for other workers to be able to steal work
// The block size is a power of two to make math efficient.
b3BlockDim b3ComputeBlockCount(i32 itemCount, i32 minSize, i32 maxBlockCount) {
    b3BlockDim dim;
    if itemCount == 0 {
        return dim;
    }
    if itemCount <= minSize * maxBlockCount {
        dim.size = minSize;
    } else {
        dim.size = (itemCount + maxBlockCount - 1) / maxBlockCount;
    }
    dim.count = (itemCount + dim.size - 1) / dim.size;
    return dim;
}

// Initialize solver blocks for a contiguous range of items. Computes block size internally
// from the same parameters used by b3ComputeBlockCount. The atomic claim counter is zeroed
// so workers can CAS (0, 1) on the first stage that owns these blocks.
void b3InitBlocks(b3SyncBlock* blocks, b3BlockDim dim, i32 itemCount, u8 blockType, u8 colorIndex) {
    if dim.count == 0 {
        return;
    }
    i32 blockSize = dim.size;
    for i32 i = 0; i < dim.count; ++i {
        blocks[i].block.startIndex = i * blockSize;
        blocks[i].block.count = cast(u16, blockSize);
        blocks[i].block.blockType = blockType;
        blocks[i].block.colorIndex = colorIndex;
        b3AtomicStoreInt(&blocks[i].syncIndex, 0);
    }
    blocks[dim.count - 1].block.count = cast(u16, itemCount - (dim.count - 1) * blockSize);
}

b3SolverStage* b3InitStage(b3SolverStage* stage, b3SolverStageType type, b3SyncBlock* blocks, i32 blockCount, u8 colorIndex) {
    stage.type = type;
    stage.blocks = blocks;
    stage.blockCount = blockCount;
    stage.colorIndex = colorIndex;
    b3AtomicStoreInt(&stage.completionCount, 0);
    return stage + 1;
}

// Initialize one stage per color for each iteration. Used for warm start, solve, relax, and restitution.
// All iterations of a given color share the same b3SyncBlock array so the per-block syncIndex
// grows monotonically across stages within that color.
b3SolverStage* b3InitColorStages(b3SolverStage* stage, b3SolverStageType type, i32 iterations, i32 activeColorCount, b3SyncBlock** colorBlocks, i32* colorBlockCounts, i32* activeColorIndices) {
    for i32 j = 0; j < iterations; ++j {
        for i32 i = 0; i < activeColorCount; ++i {
            stage = b3InitStage(stage, type, colorBlocks[i], colorBlockCounts[i], cast(u8, activeColorIndices[i]));
        }
    }
    return stage;
}

void b3ExecuteBlock(b3SolverStage* stage, b3StepContext* context, b3SolverBlock block, i32 workerIndex) {
    b3SolverStageType stageType = stage.type;
    var blockType = cast(b3SolverBlockType, block.blockType);
    switch stageType {
        case b3_stagePrepareJoints: {
            b3PrepareJointsTask(block, context);
        }
        case b3_stagePrepareWideContacts: {
            b3PrepareContacts_Convex(block, context);
        }
        case b3_stagePrepareContacts: {
            b3PrepareContacts_Mesh(block, context);
        }
        case b3_stageIntegrateVelocities: {
            b3IntegrateVelocitiesTask(block, context);
        }
        case b3_stageWarmStart: {
            if blockType == b3_graphJointBlock {
                b3WarmStartJointsTask(block, context);
            } else if blockType == b3_graphWideContactBlock {
                b3WarmStartContacts_Convex(block, context);
            } else {
                b3WarmStartContacts_Mesh(block, context);
            }
        }
        case b3_stageSolve: {
            if blockType == b3_graphJointBlock {
                bool useBias = true;
                b3SolveJointsTask(block, context, useBias, workerIndex);
            } else if blockType == b3_graphWideContactBlock {
                bool useBias = true;
                b3SolveContacts_Convex(block, context, useBias);
            } else {
                bool useBias = true;
                b3SolveContacts_Mesh(block, context, useBias);
            }
        }
        case b3_stageIntegratePositions: {
            b3IntegratePositionsTask(block, context);
        }
        case b3_stageRelax: {
            if blockType == b3_graphJointBlock {
                bool useBias = false;
                b3SolveJointsTask(block, context, useBias, workerIndex);
            } else if blockType == b3_graphWideContactBlock {
                bool useBias = false;
                b3SolveContacts_Convex(block, context, useBias);
            } else {
                bool useBias = false;
                b3SolveContacts_Mesh(block, context, useBias);
            }
        }
        case b3_stageRestitution: {
            if blockType == b3_graphWideContactBlock {
                b3ApplyRestitution_Convex(block, context);
            } else if blockType == b3_graphContactBlock {
                b3ApplyRestitution_Mesh(block, context);
            }
        }
        case b3_stageStoreWideImpulses: {
            b3StoreImpulses_Convex(block, context, workerIndex);
        }
        case b3_stageStoreImpulses: {
            b3StoreImpulses_Mesh(block, context, workerIndex);
        }
    }
}

// This staggers the worker start indices so they avoid touching the same solver blocks
i32 GetWorkerStartIndex(i32 workerIndex, i32 blockCount, i32 workerCount) {
    if blockCount <= workerCount {
        return workerIndex < blockCount ? workerIndex : -1;
    }
    i32 blocksPerWorker = blockCount / workerCount;
    i32 remainder = blockCount - blocksPerWorker * workerCount;
    return blocksPerWorker * workerIndex + b3MinInt(remainder, workerIndex);
}

// Execute a stage, which is an array of solver blocks, each controlled with an atomic sync index.
// Each worker starts at its home index and sweeps the ring, CAS-claiming any unclaimed blocks.
void b3ExecuteStage(b3SolverStage* stage, b3StepContext* context, i32 previousSyncIndex, i32 syncIndex, i32 workerIndex) {
    i32 completedCount = 0;
    b3SyncBlock* blocks = stage.blocks;
    i32 blockCount = stage.blockCount;
    i32 startIndex = GetWorkerStartIndex(workerIndex, blockCount, context.workerCount);
    if startIndex == -1 {
        return;
    }
    i32 blockIndex = startIndex;
    for i32 i = 0; i < blockCount; ++i {
        if b3AtomicCompareExchangeInt(&blocks[blockIndex].syncIndex, previousSyncIndex, syncIndex) != 0 {
            b3ExecuteBlock(stage, context, blocks[blockIndex].block, workerIndex);
            completedCount += 1;
        }
        blockIndex += 1;
        if blockIndex >= blockCount {
            blockIndex = 0;
        }
    }
    ignore b3AtomicFetchAddInt(&stage.completionCount, completedCount);
}

// Execute a stage on worker 0 (main thread).
void b3ExecuteMainStage(b3SolverStage* stage, b3StepContext* context, u32 syncBits) {
    i32 blockCount = stage.blockCount;
    if blockCount == 0 {
        return;
    }
    i32 workerIndex = 0;
    if blockCount == 1 {
        b3ExecuteBlock(stage, context, stage.blocks[0].block, workerIndex);
    } else {
        b3AtomicStoreU32(&context.atomicSyncBits, syncBits);
        var syncIndex = cast(i32, syncBits >> 16 & 0xFFFF);
        i32 previousSyncIndex = syncIndex - 1;
        b3ExecuteStage(stage, context, previousSyncIndex, syncIndex, workerIndex);
        while b3AtomicLoadInt(&stage.completionCount) != blockCount {
            b3Pause();
        }
        b3AtomicStoreInt(&stage.completionCount, 0);
    }
}

// Parallel solver task
void b3SolverTask(void* taskContext) {
    var workerContext = cast(b3WorkerContext*, taskContext);
    i32 workerIndex = workerContext.workerIndex;
    b3StepContext* context = workerContext.context;
    i32 activeColorCount = context.activeColorCount;
    b3SolverStage* stages = context.stages;
    b3Profile* profile = &context.world.profile;
    if workerIndex == 0 {
        if b3AtomicCompareExchangeInt(&context.mainClaimed, 0, 1) == false {
            return;
        }
        u64 ticks = b3GetTicks();
        i32 bodySyncIndex = 1;
        i32 stageIndex = 0;
        u32 jointSyncIndex = 1;
        u32 syncBits = jointSyncIndex << 16 | cast(u32, stageIndex);
        b3ExecuteMainStage(stages + stageIndex, context, syncBits);
        stageIndex += 1;
        jointSyncIndex += 1;
        u32 convexSyncIndex = 1;
        syncBits = convexSyncIndex << 16 | cast(u32, stageIndex);
        b3ExecuteMainStage(stages + stageIndex, context, syncBits);
        stageIndex += 1;
        convexSyncIndex += 1;
        u32 meshSyncIndex = 1;
        syncBits = meshSyncIndex << 16 | cast(u32, stageIndex);
        b3ExecuteMainStage(stages + stageIndex, context, syncBits);
        stageIndex += 1;
        meshSyncIndex += 1;
        b3PrepareJoints_Overflow(context);
        b3PrepareContacts_Overflow(context);
        profile.prepareConstraints += b3GetMillisecondsAndReset(&ticks);
        i32 graphSyncIndex = 1;
        i32 subStepCount = context.subStepCount;
        for i32 subStepIndex = 0; subStepIndex < subStepCount; ++subStepIndex {
            i32 iterationStageIndex = stageIndex;
            syncBits = cast(u32, bodySyncIndex << 16 | iterationStageIndex);
            b3ExecuteMainStage(stages + iterationStageIndex, context, syncBits);
            iterationStageIndex += 1;
            bodySyncIndex += 1;
            profile.integrateVelocities += b3GetMillisecondsAndReset(&ticks);
            b3WarmStartJoints_Overflow(context);
            b3WarmStartContacts_Overflow(context);
            for i32 colorIndex = 0; colorIndex < activeColorCount; ++colorIndex {
                syncBits = cast(u32, graphSyncIndex << 16 | iterationStageIndex);
                b3ExecuteMainStage(stages + iterationStageIndex, context, syncBits);
                iterationStageIndex += 1;
            }
            graphSyncIndex += 1;
            profile.warmStart += b3GetMillisecondsAndReset(&ticks);
            bool useBias = true;
            for i32 j = 0; j < 1; ++j {
                b3SolveJoints_Overflow(context, useBias);
                b3SolveContacts_Overflow(context, useBias);
                for i32 colorIndex = 0; colorIndex < activeColorCount; ++colorIndex {
                    syncBits = cast(u32, graphSyncIndex << 16 | iterationStageIndex);
                    b3ExecuteMainStage(stages + iterationStageIndex, context, syncBits);
                    iterationStageIndex += 1;
                }
                graphSyncIndex += 1;
            }
            profile.solveImpulses += b3GetMillisecondsAndReset(&ticks);
            syncBits = cast(u32, bodySyncIndex << 16 | iterationStageIndex);
            b3ExecuteMainStage(stages + iterationStageIndex, context, syncBits);
            iterationStageIndex += 1;
            bodySyncIndex += 1;
            profile.integratePositions += b3GetMillisecondsAndReset(&ticks);
            useBias = false;
            for i32 j = 0; j < 1; ++j {
                b3SolveJoints_Overflow(context, useBias);
                b3SolveContacts_Overflow(context, useBias);
                for i32 colorIndex = 0; colorIndex < activeColorCount; ++colorIndex {
                    syncBits = cast(u32, graphSyncIndex << 16 | iterationStageIndex);
                    b3ExecuteMainStage(stages + iterationStageIndex, context, syncBits);
                    iterationStageIndex += 1;
                }
                graphSyncIndex += 1;
            }
            profile.relaxImpulses += b3GetMillisecondsAndReset(&ticks);
        }
        stageIndex += 1 + activeColorCount + 1 * activeColorCount + 1 + 1 * activeColorCount;
        for i32 iteration = 0; iteration < 1; ++iteration {
            b3ApplyRestitution_Overflow(context);
            i32 iterStageIndex = stageIndex;
            for i32 colorIndex = 0; colorIndex < activeColorCount; ++colorIndex {
                syncBits = cast(u32, graphSyncIndex << 16 | iterStageIndex);
                b3ExecuteMainStage(stages + iterStageIndex, context, syncBits);
                iterStageIndex += 1;
            }
            graphSyncIndex += 1;
            stageIndex += activeColorCount;
        }
        profile.applyRestitution += b3GetMillisecondsAndReset(&ticks);
        b3StoreImpulses_Overflow(context);
        syncBits = convexSyncIndex << 16 | cast(u32, stageIndex);
        b3ExecuteMainStage(stages + stageIndex, context, syncBits);
        stageIndex += 1;
        syncBits = meshSyncIndex << 16 | cast(u32, stageIndex);
        b3ExecuteMainStage(stages + stageIndex, context, syncBits);
        stageIndex += 1;
        profile.storeImpulses += b3GetMillisecondsAndReset(&ticks);
        b3AtomicStoreU32(&context.atomicSyncBits, UINT_MAX);
        return;
    }
    u32 lastSyncBits = 0;
    while true {
        u32 syncBits;
        i32 spinCount = 0;
        while true {
            syncBits = b3AtomicLoadU32(&context.atomicSyncBits);
            if syncBits == lastSyncBits == 0 {
                break;
            }
            if spinCount > 5 {
                b3Yield();
                spinCount = 0;
            } else {
                b3Pause();
                b3Pause();
                spinCount += 1;
            }
        }
        if syncBits == UINT_MAX {
            break;
        }
        var stageIndex = cast(i32, syncBits & 0xFFFF);
        var syncIndex = cast(i32, syncBits >> 16 & 0xFFFF);
        i32 previousSyncIndex = syncIndex - 1;
        b3SolverStage* stage = stages + stageIndex;
        b3ExecuteStage(stage, context, previousSyncIndex, syncIndex, workerIndex);
        lastSyncBits = syncBits;
    }
}

void b3BulletBodyTask(i32 startIndex, i32 endIndex, i32 workerIndex, void* context) {
    var stepContext = cast(b3StepContext*, context);
    b3TaskContext* taskContext = stepContext.world.taskContexts.data + workerIndex;
    for i32 i = startIndex; i < endIndex; ++i {
        i32 simIndex = stepContext.bulletBodies[i];
        b3SolveContinuous(stepContext.world, simIndex, taskContext);
    }
}
}

// Solve with graph coloring
void b3Solve(b3World* world, b3StepContext* stepContext) {
    world.stepIndex += 1;
    b3SolverSet* awakeSet = world.solverSets.data + b3_awakeSet;
    i32 awakeBodyCount = awakeSet.bodySims.count;
    if awakeBodyCount == 0 {
        b3ValidateNoEnlarged(&world.broadPhase);
        return;
    }
    {
        u64 setupTicks = b3GetTicks();
        b3AtomicStoreInt(&stepContext.bulletBodyCount, 0);
        stepContext.bulletBodies = cast(i32*, b3StackAlloc(&world.stack, cast(i32, awakeBodyCount * sizeof(i32)), "bullet bodies"));
        b3ConstraintGraph* graph = &world.constraintGraph;
        b3GraphColor* colors = graph.colors;
        stepContext.sims = awakeSet.bodySims.data;
        stepContext.states = awakeSet.bodyStates.data;
        i32 activeColorCount = 0;
        for i32 i = 0; i < 24 - 1; ++i {
            i32 perColorContactCount = colors[i].convexContacts.count + colors[i].contacts.count;
            i32 perColorJointCount = colors[i].jointSims.count;
            i32 occupancyCount = perColorContactCount + perColorJointCount;
            activeColorCount += occupancyCount > 0 ? 1 : 0;
        }
        while true {
            while true {
                if world.bodyMoveEvents.capacity < awakeBodyCount {
                    var oldSize = cast(i32, world.bodyMoveEvents.capacity * sizeof(*world.bodyMoveEvents.data));
                    var newSize = cast(i32, awakeBodyCount * sizeof(*world.bodyMoveEvents.data));
                    world.bodyMoveEvents.data = b3GrowAlloc(world.bodyMoveEvents.data, oldSize, newSize);
                    world.bodyMoveEvents.capacity = awakeBodyCount;
                }
                if !(0 != 0) { break; }
            }
            world.bodyMoveEvents.count = awakeBodyCount;
            if !(0 != 0) { break; }
        }
        i32 workerCount = world.workerCount;
        i32 maxBlockCount = 4 * workerCount;
        i32 minBodiesPerBlock = 32;
        b3BlockDim bodyDim = b3ComputeBlockCount(awakeBodyCount, minBodiesPerBlock, maxBlockCount);
        i32 minContactsPerBlock = 4;
        i32 minJointsPerBlock = 4;
        noinit i32[24] activeColorIndices;
        noinit i32[24] colorWideContactCounts;
        noinit i32[24] colorContactCounts;
        noinit i32[24] colorJointCounts;
        noinit b3BlockDim[24] graphWideContactDims;
        noinit b3BlockDim[24] graphContactDims;
        noinit b3BlockDim[24] graphJointDims;
        i32 graphBlockCount = 0;
        i32 wideContactCount = 0;
        i32 contactCount = 0;
        i32 manifoldCount = 0;
        i32 jointCount = 0;
        i32 c = 0;
        for i32 i = 0; i < 24 - 1; ++i {
            b3GraphColor* color = colors + i;
            i32 colorConvexContactCount = color.convexContacts.count;
            i32 colorContactCount = color.contacts.count;
            i32 colorJointCount = color.jointSims.count;
            if colorConvexContactCount + colorContactCount + colorJointCount == 0 {
                continue;
            }
            activeColorIndices[c] = i;
            i32 colorWideConstraintCount = colorConvexContactCount > 0 ? (colorConvexContactCount - 1 >> 2) + 1 : 0;
            wideContactCount += colorWideConstraintCount;
            colorWideContactCounts[c] = colorWideConstraintCount;
            colorContactCounts[c] = colorContactCount;
            contactCount += colorContactCount;
            for i32 j = 0; j < colorContactCount; ++j {
                color.contacts.data[j].manifoldStart = manifoldCount;
                manifoldCount += cast(i32, color.contacts.data[j].manifoldCount);
            }
            colorJointCounts[c] = colorJointCount;
            jointCount += colorJointCount;
            graphWideContactDims[c] = b3ComputeBlockCount(colorWideConstraintCount, minContactsPerBlock, maxBlockCount);
            graphContactDims[c] = b3ComputeBlockCount(colorContactCount, minContactsPerBlock, maxBlockCount);
            graphJointDims[c] = b3ComputeBlockCount(colorJointCount, minJointsPerBlock, maxBlockCount);
            graphBlockCount += graphWideContactDims[c].count + graphContactDims[c].count + graphJointDims[c].count;
            c += 1;
        }
        activeColorCount = c;
        b3BlockDim convexPrepareDim = b3ComputeBlockCount(wideContactCount, minContactsPerBlock, maxBlockCount);
        b3BlockDim meshPrepareDim = b3ComputeBlockCount(contactCount, minContactsPerBlock, maxBlockCount);
        b3BlockDim jointPrepareDim = b3ComputeBlockCount(jointCount, minJointsPerBlock, maxBlockCount);
        i32 wideContactByteCount = b3GetWideContactConstraintByteCount();
        var wideConstraints = cast(b3ContactConstraintWide*, b3StackAlloc(&world.stack, wideContactCount * wideContactByteCount, "wide contacts"));
        var contactConstraints = cast(b3ContactConstraint*, b3StackAlloc(&world.stack, cast(i32, contactCount * sizeof(b3ContactConstraint)), "contacts"));
        var manifoldConstraints = cast(b3ManifoldConstraint*, b3StackAlloc(&world.stack, cast(i32, manifoldCount * sizeof(b3ManifoldConstraint)), "manifold constraints"));
        b3GraphColor* overflow = colors + (24 - 1);
        i32 overflowCount = overflow.contacts.count;
        i32 overflowManifoldCount = 0;
        for i32 i = 0; i < overflowCount; ++i {
            overflow.contacts.data[i].manifoldStart = overflowManifoldCount;
            overflowManifoldCount += cast(i32, overflow.contacts.data[i].manifoldCount);
        }
        overflow.contactConstraints = cast(b3ContactConstraint*, b3StackAlloc(&world.stack, cast(i32, overflowCount * sizeof(b3ContactConstraint)), "overflow contacts"));
        overflow.manifoldConstraints = cast(b3ManifoldConstraint*, b3StackAlloc(&world.stack, cast(i32, overflowManifoldCount * sizeof(b3ManifoldConstraint)), "overflow manifolds"));
        noinit b3WidePrepareSpan[25] widePrepareSpans;
        noinit b3ContactPrepareSpan[25] contactPrepareSpans;
        noinit b3JointPrepareSpan[25] jointPrepareSpans;
        {
            i32 wideBase = 0;
            i32 contactBase = 0;
            i32 jointBase = 0;
            for i32 i = 0; i < activeColorCount; ++i {
                i32 j = activeColorIndices[i];
                b3GraphColor* color = colors + j;
                i32 colorConvexContactCount = color.convexContacts.count;
                widePrepareSpans[i].start = wideBase;
                widePrepareSpans[i].count = colorConvexContactCount;
                widePrepareSpans[i].contacts = color.convexContacts.data;
                if colorConvexContactCount == 0 {
                    color.wideConstraints = null;
                    color.wideConstraintCount = 0;
                } else {
                    color.wideConstraints = cast(b3ContactConstraintWide*, cast(u8*, wideConstraints) + wideBase * wideContactByteCount);
                    i32 colorContactCountW = (colorConvexContactCount - 1 >> 2) + 1;
                    color.wideConstraintCount = colorContactCountW;
                    if (colorConvexContactCount & 4 - 1) != 0 {
                        memset(cast(u8*, color.wideConstraints) + (colorContactCountW - 1) * wideContactByteCount, 0, cast(u64, wideContactByteCount));
                    }
                    wideBase += colorContactCountW;
                }
                i32 colorContactCount = color.contacts.count;
                contactPrepareSpans[i].start = contactBase;
                contactPrepareSpans[i].count = colorContactCount;
                contactPrepareSpans[i].contacts = color.contacts.data;
                if colorContactCount == 0 {
                    color.contactConstraints = null;
                    color.contactConstraintCount = 0;
                } else {
                    color.contactConstraints = contactConstraints + contactBase;
                    color.contactConstraintCount = colorContactCount;
                    contactBase += colorContactCount;
                }
                jointPrepareSpans[i].start = jointBase;
                jointPrepareSpans[i].count = color.jointSims.count;
                jointPrepareSpans[i].joints = color.jointSims.data;
                jointBase += color.jointSims.count;
            }
            widePrepareSpans[activeColorCount].start = wideContactCount;
            widePrepareSpans[activeColorCount].count = 0;
            widePrepareSpans[activeColorCount].contacts = null;
            contactPrepareSpans[activeColorCount].start = contactCount;
            contactPrepareSpans[activeColorCount].count = 0;
            contactPrepareSpans[activeColorCount].contacts = null;
            jointPrepareSpans[activeColorCount].start = jointCount;
            jointPrepareSpans[activeColorCount].count = 0;
            jointPrepareSpans[activeColorCount].joints = null;
        }
        b3ContactPrepareSpan[2] overflowSpans;
        overflowSpans[0].start = 0;
        overflowSpans[0].count = overflow.contacts.count;
        overflowSpans[0].contacts = overflow.contacts.data;
        overflowSpans[1].start = overflow.contacts.count;
        overflowSpans[1].count = 0;
        overflowSpans[1].contacts = null;
        i32 stageCount = 0;
        stageCount += 1;
        stageCount += 1;
        stageCount += 1;
        stageCount += 1;
        stageCount += activeColorCount;
        stageCount += 1 * activeColorCount;
        stageCount += 1;
        stageCount += 1 * activeColorCount;
        stageCount += 1 * activeColorCount;
        stageCount += 1;
        stageCount += 1;
        var stages = cast(b3SolverStage*, b3StackAlloc(&world.stack, cast(i32, stageCount * sizeof(b3SolverStage)), "stages"));
        var bodyBlocks = cast(b3SyncBlock*, b3StackAlloc(&world.stack, cast(i32, bodyDim.count * sizeof(b3SyncBlock)), "body blocks"));
        var convexBlocks = cast(b3SyncBlock*, b3StackAlloc(&world.stack, cast(i32, convexPrepareDim.count * sizeof(b3SyncBlock)), "convex blocks"));
        var meshBlocks = cast(b3SyncBlock*, b3StackAlloc(&world.stack, cast(i32, meshPrepareDim.count * sizeof(b3SyncBlock)), "mesh blocks"));
        var jointBlocks = cast(b3SyncBlock*, b3StackAlloc(&world.stack, cast(i32, jointPrepareDim.count * sizeof(b3SyncBlock)), "joint blocks"));
        var graphBlocks = cast(b3SyncBlock*, b3StackAlloc(&world.stack, cast(i32, graphBlockCount * sizeof(b3SyncBlock)), "graph blocks"));
        void* splitIslandTask = null;
        if world.splitIslandId != -1 {
            if world.taskCount < 256 {
                splitIslandTask = world.enqueueTaskFcn(&b3SplitIslandTask, world, world.userTaskContext, "split");
                world.taskCount += 1;
                world.activeTaskCount += splitIslandTask == null ? 0 : 1;
            } else {
                b3SplitIslandTask(world);
            }
        }
        b3InitBlocks(bodyBlocks, bodyDim, awakeBodyCount, cast(u8, b3_bodyBlock), 255);
        b3InitBlocks(convexBlocks, convexPrepareDim, wideContactCount, cast(u8, b3_wideContactBlock), 255);
        b3InitBlocks(meshBlocks, meshPrepareDim, contactCount, cast(u8, b3_contactBlock), 255);
        b3InitBlocks(jointBlocks, jointPrepareDim, jointCount, cast(u8, b3_jointBlock), 255);
        b3SyncBlock*[24] graphColorBlocks;
        b3SyncBlock* baseGraphBlock = graphBlocks;
        i32[24] graphBlockCounts;
        for i32 i = 0; i < activeColorCount; ++i {
            graphColorBlocks[i] = baseGraphBlock;
            var colorIndex = cast(u8, activeColorIndices[i]);
            b3InitBlocks(baseGraphBlock, graphJointDims[i], colorJointCounts[i], cast(u8, b3_graphJointBlock), colorIndex);
            baseGraphBlock += graphJointDims[i].count;
            b3InitBlocks(baseGraphBlock, graphWideContactDims[i], colorWideContactCounts[i], cast(u8, b3_graphWideContactBlock), colorIndex);
            baseGraphBlock += graphWideContactDims[i].count;
            b3InitBlocks(baseGraphBlock, graphContactDims[i], colorContactCounts[i], cast(u8, b3_graphContactBlock), colorIndex);
            baseGraphBlock += graphContactDims[i].count;
            graphBlockCounts[i] = graphJointDims[i].count + graphWideContactDims[i].count + graphContactDims[i].count;
        }
        b3SolverStage* stage = stages;
        stage = b3InitStage(stage, b3_stagePrepareJoints, jointBlocks, jointPrepareDim.count, 255);
        stage = b3InitStage(stage, b3_stagePrepareWideContacts, convexBlocks, convexPrepareDim.count, 255);
        stage = b3InitStage(stage, b3_stagePrepareContacts, meshBlocks, meshPrepareDim.count, 255);
        stage = b3InitStage(stage, b3_stageIntegrateVelocities, bodyBlocks, bodyDim.count, 255);
        stage = b3InitColorStages(stage, b3_stageWarmStart, 1, activeColorCount, graphColorBlocks, graphBlockCounts, activeColorIndices);
        stage = b3InitColorStages(stage, b3_stageSolve, 1, activeColorCount, graphColorBlocks, graphBlockCounts, activeColorIndices);
        stage = b3InitStage(stage, b3_stageIntegratePositions, bodyBlocks, bodyDim.count, 255);
        stage = b3InitColorStages(stage, b3_stageRelax, 1, activeColorCount, graphColorBlocks, graphBlockCounts, activeColorIndices);
        stage = b3InitColorStages(stage, b3_stageRestitution, 1, activeColorCount, graphColorBlocks, graphBlockCounts, activeColorIndices);
        stage = b3InitStage(stage, b3_stageStoreWideImpulses, convexBlocks, convexPrepareDim.count, 255);
        stage = b3InitStage(stage, b3_stageStoreImpulses, meshBlocks, meshPrepareDim.count, 255);
        noinit b3WorkerContext[32] workerContext;
        stepContext.graph = graph;
        stepContext.activeColorCount = activeColorCount;
        stepContext.workerCount = workerCount;
        stepContext.stageCount = stageCount;
        stepContext.stages = stages;
        stepContext.wideConstraints = wideConstraints;
        stepContext.widePrepareSpans = widePrepareSpans;
        stepContext.wideContactCount = wideContactCount;
        stepContext.manifoldConstraints = manifoldConstraints;
        stepContext.contactConstraints = contactConstraints;
        stepContext.contactPrepareSpans = contactPrepareSpans;
        stepContext.overflowSpans = overflowSpans;
        stepContext.jointPrepareSpans = jointPrepareSpans;
        b3AtomicStoreU32(&stepContext.atomicSyncBits, 0);
        b3AtomicStoreInt(&stepContext.mainClaimed, 0);
        world.profile.solverSetup = b3GetMillisecondsAndReset(&setupTicks);
        u64 constraintTicks = b3GetTicks();
        i32 jointIdCapacity = b3GetIdCapacity(&world.jointIdPool);
        i32 contactIdCapacity = b3GetIdCapacity(&world.contactIdPool);
        for i32 i = 0; i < workerCount; ++i {
            b3TaskContext* taskContext = world.taskContexts.data + i;
            b3SetBitCountAndClear(&taskContext.jointStateBitSet, cast(u32, jointIdCapacity));
            b3SetBitCountAndClear(&taskContext.hitEventBitSet, cast(u32, contactIdCapacity));
            taskContext.hasHitEvents = false;
            workerContext[i].context = stepContext;
            workerContext[i].workerIndex = i;
            if world.taskCount < 256 {
                noinit u8[16] buffer;
                snprintf(buffer, sizeof(buffer), "solve[%d]", i);
                workerContext[i].userTask = world.enqueueTaskFcn(&b3SolverTask, workerContext + i, world.userTaskContext, buffer);
                world.taskCount += 1;
                world.activeTaskCount += workerContext[i].userTask == null ? 0 : 1;
            } else {
                workerContext[i].userTask = null;
                b3SolverTask(workerContext + i);
            }
        }
        var callerContext = b3WorkerContext{stepContext, 0, null};
        b3SolverTask(&callerContext);
        for i32 i = 0; i < workerCount; ++i {
            if workerContext[i].userTask != null {
                world.finishTaskFcn(workerContext[i].userTask, world.userTaskContext);
                world.activeTaskCount -= 1;
            }
        }
        if splitIslandTask != null {
            world.finishTaskFcn(splitIslandTask, world.userTaskContext);
            world.activeTaskCount -= 1;
        }
        world.splitIslandId = -1;
        world.profile.constraints = b3GetMillisecondsAndReset(&constraintTicks);
        u64 transformTicks = b3GetTicks();
        i32 awakeIslandCount = awakeSet.islandSims.count;
        for i32 i = 0; i < world.workerCount; ++i {
            b3TaskContext* taskContext = world.taskContexts.data + i;
            while true {
                taskContext.sensorHits.count = 0;
                if !(0 != 0) { break; }
            }
            b3SetBitCountAndClear(&taskContext.enlargedSimBitSet, cast(u32, awakeBodyCount));
            b3SetBitCountAndClear(&taskContext.awakeIslandBitSet, cast(u32, awakeIslandCount));
            taskContext.splitIslandId = -1;
            taskContext.splitSleepTime = 0.0f;
        }
        b3ParallelFor(world, &b3FinalizeBodiesTask, awakeBodyCount, 16, stepContext, "ccd");
        b3StackFree(&world.stack, graphBlocks);
        b3StackFree(&world.stack, jointBlocks);
        b3StackFree(&world.stack, meshBlocks);
        b3StackFree(&world.stack, convexBlocks);
        b3StackFree(&world.stack, bodyBlocks);
        b3StackFree(&world.stack, stages);
        b3StackFree(&world.stack, overflow.manifoldConstraints);
        b3StackFree(&world.stack, overflow.contactConstraints);
        b3StackFree(&world.stack, manifoldConstraints);
        b3StackFree(&world.stack, contactConstraints);
        b3StackFree(&world.stack, wideConstraints);
        world.profile.transforms = b3GetMilliseconds(transformTicks);
    }
    {
        u64 jointEventTicks = b3GetTicks();
        b3BitSet* jointStateBitSet = &world.taskContexts.data[0].jointStateBitSet;
        for i32 i = 1; i < world.workerCount; ++i {
            b3InPlaceUnion(jointStateBitSet, &world.taskContexts.data[i].jointStateBitSet);
        }
        {
            u32 wordCount = jointStateBitSet.blockCount;
            u64* bits = jointStateBitSet.bits;
            b3Joint* jointArray = world.joints.data;
            u16 worldIndex0 = world.worldId;
            for u32 k = 0; k < wordCount; ++k {
                u64 word = bits[k];
                while word != 0 {
                    u32 ctz = b3CTZ64(word);
                    var jointId = cast(i32, 64 * k + ctz);
                    b3Joint* joint = jointArray + jointId;
                    var event = b3JointEvent{
                        .jointId = b3JointId{
                            .index1 = jointId + 1,
                            .world0 = worldIndex0,
                            .generation = joint.generation,
                        },
                        .userData = joint.userData,
                    };
                    while true {
                        if world.jointEvents.count >= world.jointEvents.capacity {
                            var oldSize = cast(i32, world.jointEvents.capacity * sizeof(*world.jointEvents.data));
                            i32 newCapacity = world.jointEvents.capacity == 0 ? 8 : 2 * world.jointEvents.capacity;
                            var newSize = cast(i32, newCapacity * sizeof(*world.jointEvents.data));
                            world.jointEvents.data = b3GrowAlloc(world.jointEvents.data, oldSize, newSize);
                            world.jointEvents.capacity = newCapacity;
                        }
                        world.jointEvents.data[world.jointEvents.count++] = event;
                        if !(0 != 0) { break; }
                    }
                    word = word & word - 1;
                }
            }
        }
        world.profile.jointEvents = b3GetMilliseconds(jointEventTicks);
    }
    {
        u64 hitTicks = b3GetTicks();
        bool anyHitEvents = false;
        for i32 i = 0; i < world.workerCount; ++i {
            if world.taskContexts.data[i].hasHitEvents != 0 {
                anyHitEvents = true;
                break;
            }
        }
        if anyHitEvents != 0 {
            b3BitSet* hitEventBitSet = &world.taskContexts.data[0].hitEventBitSet;
            for i32 i = 1; i < world.workerCount; ++i {
                if world.taskContexts.data[i].hasHitEvents != 0 {
                    b3InPlaceUnion(hitEventBitSet, &world.taskContexts.data[i].hitEventBitSet);
                }
            }
            f32 threshold = world.hitEventThreshold;
            b3Contact* contactArray = world.contacts.data;
            u16 worldId = world.worldId;
            u32 wordCount = hitEventBitSet.blockCount;
            u64* bits = hitEventBitSet.bits;
            for u32 k = 0; k < wordCount; ++k {
                u64 word = bits[k];
                while word != 0 {
                    u32 ctz = b3CTZ64(word);
                    var contactId = cast(i32, 64 * k + ctz);
                    b3Contact* contact = contactArray + contactId;
                    b3Shape* shapeA = world.shapes.data + contact.shapeIdA;
                    b3Shape* shapeB = world.shapes.data + contact.shapeIdB;
                    b3Body* bodyA = world.bodies.data + shapeA.bodyId;
                    b3Body* bodyB = world.bodies.data + shapeB.bodyId;
                    b3BodySim* simA = b3GetBodySim(world, bodyA);
                    b3BodySim* simB = b3GetBodySim(world, bodyB);
                    b3Pos midCenter = b3LerpPosition(simA.center, simB.center, 0.5f);
                    b3ContactHitEvent event;
                    event.approachSpeed = threshold;
                    bool found = false;
                    i32 triangleIndex = 0;
                    i32 manifoldCount = contact.manifoldCount;
                    for i32 i = 0; i < manifoldCount; ++i {
                        b3Manifold* manifold = contact.manifolds + i;
                        i32 pointCount = manifold.pointCount;
                        for i32 p = 0; p < pointCount; ++p {
                            b3ManifoldPoint* mp = manifold.points + p;
                            f32 approachSpeed = -mp.normalVelocity;
                            if approachSpeed > event.approachSpeed && mp.totalNormalImpulse > 0.0f {
                                event.approachSpeed = approachSpeed;
                                event.point = b3OffsetPos(midCenter, b3Lerp(mp.anchorA, mp.anchorB, 0.5f));
                                event.normal = manifold.normal;
                                triangleIndex = mp.triangleIndex;
                                found = true;
                            }
                        }
                    }
                    if found == true {
                        event.shapeIdA = b3ShapeId{shapeA.id + 1, worldId, shapeA.generation};
                        event.shapeIdB = b3ShapeId{shapeB.id + 1, worldId, shapeB.generation};
                        event.contactId = b3ContactId{
                            .index1 = contact.contactId + 1,
                            .world0 = worldId,
                            .padding = 0,
                            .generation = contact.generation,
                        };
                        event.userMaterialIdA = b3GetShapeUserMaterialId(shapeA, contact.childIndex, triangleIndex);
                        event.userMaterialIdB = b3GetShapeUserMaterialId(shapeB, 0, triangleIndex);
                        while true {
                            if world.contactHitEvents.count >= world.contactHitEvents.capacity {
                                var oldSize = cast(i32, world.contactHitEvents.capacity * sizeof(*world.contactHitEvents.data));
                                i32 newCapacity = world.contactHitEvents.capacity == 0 ? 8 : 2 * world.contactHitEvents.capacity;
                                var newSize = cast(i32, newCapacity * sizeof(*world.contactHitEvents.data));
                                world.contactHitEvents.data = b3GrowAlloc(world.contactHitEvents.data, oldSize, newSize);
                                world.contactHitEvents.capacity = newCapacity;
                            }
                            world.contactHitEvents.data[world.contactHitEvents.count++] = event;
                            if !(0 != 0) { break; }
                        }
                    }
                    word = word & word - 1;
                }
            }
        }
        world.profile.hitEvents = b3GetMilliseconds(hitTicks);
    }
    {
        u64 refitTicks = b3GetTicks();
        if world.userTreeTask != null {
            world.finishTaskFcn(world.userTreeTask, world.userTaskContext);
            world.userTreeTask = null;
            world.activeTaskCount -= 1;
        }
        b3ValidateNoEnlarged(&world.broadPhase);
        b3BitSet* enlargedBodyBitSet = &world.taskContexts.data[0].enlargedSimBitSet;
        for i32 i = 1; i < world.workerCount; ++i {
            b3InPlaceUnion(enlargedBodyBitSet, &world.taskContexts.data[i].enlargedSimBitSet);
        }
        {
            b3BroadPhase* broadPhase = &world.broadPhase;
            u32 wordCount = enlargedBodyBitSet.blockCount;
            u64* bits = enlargedBodyBitSet.bits;
            b3Body* bodyArray = world.bodies.data;
            b3BodySim* bodySimArray = awakeSet.bodySims.data;
            b3Shape* shapeArray = world.shapes.data;
            for u32 k = 0; k < wordCount; ++k {
                u64 word = bits[k];
                while word != 0 {
                    u32 ctz = b3CTZ64(word);
                    u32 bodySimIndex = 64 * k + ctz;
                    b3BodySim* bodySim = bodySimArray + bodySimIndex;
                    b3Body* body = bodyArray + bodySim.bodyId;
                    i32 shapeId = body.headShapeId;
                    if (bodySim.flags & cast(u32, b3_isBullet | b3_isFast)) == cast(u32, b3_isBullet | b3_isFast) {
                        while shapeId != -1 {
                            b3Shape* shape = shapeArray + shapeId;
                            b3BufferMove(broadPhase, shape.proxyKey);
                            shapeId = shape.nextShapeId;
                        }
                    } else {
                        while shapeId != -1 {
                            b3Shape* shape = shapeArray + shapeId;
                            if (shape.flags & b3_enlargedAABB) != 0 {
                                b3BroadPhase_EnlargeProxy(broadPhase, shape.proxyKey, shape.fatAABB);
                                shape.flags &= cast(u8, ~b3_enlargedAABB);
                            }
                            shapeId = shape.nextShapeId;
                        }
                    }
                    word = word & word - 1;
                }
            }
        }
        b3ValidateBroadPhase(&world.broadPhase);
        world.profile.refit = b3GetMilliseconds(refitTicks);
    }
    i32 bulletBodyCount = b3AtomicLoadInt(&stepContext.bulletBodyCount);
    if bulletBodyCount > 0 {
        u64 bulletTicks = b3GetTicks();
        i32 minRange = 8;
        b3ParallelFor(world, &b3BulletBodyTask, bulletBodyCount, minRange, stepContext, "bullets");
        b3BroadPhase* broadPhase = &world.broadPhase;
        b3DynamicTree* dynamicTree = broadPhase.trees + b3_dynamicBody;
        b3Body* bodyArray = world.bodies.data;
        b3BodySim* bodySimArray = awakeSet.bodySims.data;
        b3Shape* shapeArray = world.shapes.data;
        i32* bulletBodySimIndices = stepContext.bulletBodies;
        for i32 i = 0; i < bulletBodyCount; ++i {
            b3BodySim* bulletBodySim = bodySimArray + bulletBodySimIndices[i];
            if (bulletBodySim.flags & cast(u32, b3_enlargeBounds)) == 0 {
                continue;
            }
            bulletBodySim.flags &= cast(u32, ~b3_enlargeBounds);
            i32 bodyId = bulletBodySim.bodyId;
            b3Body* bulletBody = bodyArray + bodyId;
            i32 shapeId = bulletBody.headShapeId;
            while shapeId != -1 {
                b3Shape* shape = shapeArray + shapeId;
                if (shape.flags & b3_enlargedAABB) == 0 {
                    shapeId = shape.nextShapeId;
                    continue;
                }
                shape.flags &= cast(u8, ~b3_enlargedAABB);
                i32 proxyKey = shape.proxyKey;
                i32 proxyId = proxyKey >> 2;
                b3DynamicTree_EnlargeProxy(dynamicTree, proxyId, shape.fatAABB);
                shapeId = shape.nextShapeId;
            }
        }
        world.profile.bullets = b3GetMilliseconds(bulletTicks);
    }
    b3StackFree(&world.stack, stepContext.bulletBodies);
    stepContext.bulletBodies = null;
    b3AtomicStoreInt(&stepContext.bulletBodyCount, 0);
    {
        u64 sensorHitTicks = b3GetTicks();
        i32 workerCount = world.workerCount;
        for i32 i = 0; i < workerCount; ++i {
            b3TaskContext* taskContext = world.taskContexts.data + i;
            i32 hitCount = taskContext.sensorHits.count;
            b3SensorHit* hits = taskContext.sensorHits.data;
            for i32 j = 0; j < hitCount; ++j {
                b3SensorHit hit = hits[j];
                b3Shape* sensorShape = world.shapes.data + hit.sensorId;
                b3Shape* visitor = world.shapes.data + hit.visitorId;
                b3Sensor* sensor = world.sensors.data + sensorShape.sensorIndex;
                var shapeRef = b3Visitor{.shapeId = hit.visitorId, .generation = visitor.generation};
                while true {
                    if sensor.hits.count >= sensor.hits.capacity {
                        var oldSize = cast(i32, sensor.hits.capacity * sizeof(*sensor.hits.data));
                        i32 newCapacity = sensor.hits.capacity == 0 ? 8 : 2 * sensor.hits.capacity;
                        var newSize = cast(i32, newCapacity * sizeof(*sensor.hits.data));
                        sensor.hits.data = b3GrowAlloc(sensor.hits.data, oldSize, newSize);
                        sensor.hits.capacity = newCapacity;
                    }
                    sensor.hits.data[sensor.hits.count++] = shapeRef;
                    if !(0 != 0) { break; }
                }
            }
        }
        world.profile.sensorHits = b3GetMilliseconds(sensorHitTicks);
    }
    if world.enableSleep == true {
        u64 sleepTicks = b3GetTicks();
        f32 splitSleepTimer = 0.0f;
        for i32 i = 0; i < world.workerCount; ++i {
            b3TaskContext* taskContext = world.taskContexts.data + i;
            if taskContext.splitIslandId != -1 && taskContext.splitSleepTime >= splitSleepTimer {
                if taskContext.splitSleepTime == splitSleepTimer && taskContext.splitIslandId < world.splitIslandId {
                    continue;
                }
                world.splitIslandId = taskContext.splitIslandId;
                splitSleepTimer = taskContext.splitSleepTime;
            }
        }
        b3BitSet* awakeIslandBitSet = &world.taskContexts.data[0].awakeIslandBitSet;
        for i32 i = 1; i < world.workerCount; ++i {
            b3InPlaceUnion(awakeIslandBitSet, &world.taskContexts.data[i].awakeIslandBitSet);
        }
        b3IslandSim* islands = awakeSet.islandSims.data;
        i32 count = awakeSet.islandSims.count;
        for i32 islandIndex = count - 1; islandIndex >= 0; islandIndex -= 1 {
            if b3GetBit(awakeIslandBitSet, cast(u32, islandIndex)) == true {
                continue;
            }
            b3IslandSim* island = islands + islandIndex;
            i32 islandId = island.islandId;
            b3TrySleepIsland(world, islandId);
        }
        b3ValidateSolverSets(world);
        world.profile.sleepIslands = b3GetMilliseconds(sleepTicks);
    }
}

// SPDX-FileCopyrightText: 2025 Erin Catto
// SPDX-License-Identifier: MIT
void b3DestroySolverSet(b3World* world, i32 setIndex) {
    b3SolverSet* set = world.solverSets.data + setIndex;
    while true {
        b3Free(set.bodySims.data, cast(u64, set.bodySims.capacity * sizeof(*set.bodySims.data)));
        set.bodySims.data = null;
        set.bodySims.count = 0;
        set.bodySims.capacity = 0;
        if !(0 != 0) { break; }
    }
    while true {
        b3Free(set.bodyStates.data, cast(u64, set.bodyStates.capacity * sizeof(*set.bodyStates.data)));
        set.bodyStates.data = null;
        set.bodyStates.count = 0;
        set.bodyStates.capacity = 0;
        if !(0 != 0) { break; }
    }
    while true {
        b3Free(set.contactIndices.data, cast(u64, set.contactIndices.capacity * sizeof(*set.contactIndices.data)));
        set.contactIndices.data = null;
        set.contactIndices.count = 0;
        set.contactIndices.capacity = 0;
        if !(0 != 0) { break; }
    }
    while true {
        b3Free(set.jointSims.data, cast(u64, set.jointSims.capacity * sizeof(*set.jointSims.data)));
        set.jointSims.data = null;
        set.jointSims.count = 0;
        set.jointSims.capacity = 0;
        if !(0 != 0) { break; }
    }
    while true {
        b3Free(set.islandSims.data, cast(u64, set.islandSims.capacity * sizeof(*set.islandSims.data)));
        set.islandSims.data = null;
        set.islandSims.count = 0;
        set.islandSims.capacity = 0;
        if !(0 != 0) { break; }
    }
    b3FreeId(&world.solverSetIdPool, setIndex);
    *set = b3SolverSet{};
    set.setIndex = -1;
}

// Wake a solver set. Does not merge islands.
// Contacts can be in several places:
// 1. non-touching contacts in the disabled set
// 2. non-touching contacts already in the awake set
// 3. touching contacts in the sleeping set
// This handles contact types 1 and 3. Type 2 doesn't need any action.
void b3WakeSolverSet(b3World* world, i32 setIndex) {
    b3SolverSet* set = world.solverSets.data + setIndex;
    b3SolverSet* awakeSet = world.solverSets.data + b3_awakeSet;
    b3SolverSet* disabledSet = world.solverSets.data + b3_disabledSet;
    b3Body* bodies = world.bodies.data;
    i32 bodyCount = set.bodySims.count;
    for i32 i = 0; i < bodyCount; ++i {
        b3BodySim* simSrc = set.bodySims.data + i;
        b3Body* body = bodies + simSrc.bodyId;
        body.setIndex = b3_awakeSet;
        body.localIndex = awakeSet.bodySims.count;
        body.sleepTime = 0.0f;
        b3BodySim* simDst = b3EmplaceHelper(cast(void**, &awakeSet.bodySims.data), &awakeSet.bodySims.count, &awakeSet.bodySims.capacity, cast(i32, sizeof(*awakeSet.bodySims.data)));
        memcpy(simDst, simSrc, cast(u64, sizeof(b3BodySim)));
        b3BodyState* state = b3EmplaceHelper(cast(void**, &awakeSet.bodyStates.data), &awakeSet.bodyStates.count, &awakeSet.bodyStates.capacity, cast(i32, sizeof(*awakeSet.bodyStates.data)));
        *state = b3_identityBodyState;
        state.flags = body.flags;
        i32 contactKey = body.headContactKey;
        while contactKey != -1 {
            i32 edgeIndex = contactKey & 1;
            i32 contactId = contactKey >> 1;
            b3Contact* contact = world.contacts.data + contactId;
            contactKey = contact.edges[edgeIndex].nextKey;
            if contact.setIndex != b3_disabledSet {
                continue;
            }
            i32 localIndex = contact.localIndex;
            contact.setIndex = b3_awakeSet;
            contact.localIndex = awakeSet.contactIndices.count;
            while true {
                if awakeSet.contactIndices.count >= awakeSet.contactIndices.capacity {
                    var oldSize = cast(i32, awakeSet.contactIndices.capacity * sizeof(*awakeSet.contactIndices.data));
                    i32 newCapacity = awakeSet.contactIndices.capacity == 0 ? 8 : 2 * awakeSet.contactIndices.capacity;
                    var newSize = cast(i32, newCapacity * sizeof(*awakeSet.contactIndices.data));
                    awakeSet.contactIndices.data = b3GrowAlloc(awakeSet.contactIndices.data, oldSize, newSize);
                    awakeSet.contactIndices.capacity = newCapacity;
                }
                awakeSet.contactIndices.data[awakeSet.contactIndices.count++] = contactId;
                if !(0 != 0) { break; }
            }
            i32 movedLocalIndex = b3RemoveHelper(disabledSet.contactIndices.data, &disabledSet.contactIndices.count, localIndex, cast(i32, sizeof(*disabledSet.contactIndices.data)));
            if movedLocalIndex != -1 {
                i32 movedContactIndex = disabledSet.contactIndices.data[localIndex];
                b3Contact* movedContact = world.contacts.data + movedContactIndex;
                movedContact.localIndex = localIndex;
            }
        }
    }
    {
        i32 contactCount = set.contactIndices.count;
        for i32 i = 0; i < contactCount; ++i {
            i32 contactIndex = set.contactIndices.data[i];
            b3Contact* contact = world.contacts.data + contactIndex;
            b3AddContactToGraph(world, contact);
            contact.setIndex = b3_awakeSet;
        }
    }
    {
        i32 jointCount = set.jointSims.count;
        for i32 i = 0; i < jointCount; ++i {
            b3JointSim* jointSim = set.jointSims.data + i;
            b3Joint* joint = world.joints.data + jointSim.jointId;
            b3AddJointToGraph(world, jointSim, joint);
            joint.setIndex = b3_awakeSet;
        }
    }
    {
        i32 islandCount = set.islandSims.count;
        for i32 i = 0; i < islandCount; ++i {
            b3IslandSim* islandSrc = set.islandSims.data + i;
            b3Island* island = world.islands.data + islandSrc.islandId;
            island.setIndex = b3_awakeSet;
            island.localIndex = awakeSet.islandSims.count;
            b3IslandSim* islandDst = b3EmplaceHelper(cast(void**, &awakeSet.islandSims.data), &awakeSet.islandSims.count, &awakeSet.islandSims.capacity, cast(i32, sizeof(*awakeSet.islandSims.data)));
            memcpy(islandDst, islandSrc, cast(u64, sizeof(b3IslandSim)));
        }
    }
    b3DestroySolverSet(world, setIndex);
}

void b3TrySleepIsland(b3World* world, i32 islandId) {
    b3Island* island = world.islands.data + islandId;
    if island.constraintRemoveCount > 0 && island.bodies.count > 1 {
        return;
    }
    i32 sleepSetId = b3AllocId(&world.solverSetIdPool);
    if sleepSetId == world.solverSets.count {
        b3SolverSet set;
        set.setIndex = -1;
        while true {
            if world.solverSets.count >= world.solverSets.capacity {
                var oldSize = cast(i32, world.solverSets.capacity * sizeof(*world.solverSets.data));
                i32 newCapacity = world.solverSets.capacity == 0 ? 8 : 2 * world.solverSets.capacity;
                var newSize = cast(i32, newCapacity * sizeof(*world.solverSets.data));
                world.solverSets.data = b3GrowAlloc(world.solverSets.data, oldSize, newSize);
                world.solverSets.capacity = newCapacity;
            }
            world.solverSets.data[world.solverSets.count++] = set;
            if !(0 != 0) { break; }
        }
    }
    b3SolverSet* sleepSet = world.solverSets.data + sleepSetId;
    *sleepSet = b3SolverSet{};
    b3SolverSet* awakeSet = world.solverSets.data + b3_awakeSet;
    b3SolverSet* disabledSet = world.solverSets.data + b3_disabledSet;
    sleepSet.setIndex = sleepSetId;
    while true {
        if sleepSet.bodySims.capacity < island.bodies.count {
            var oldSize = cast(i32, sleepSet.bodySims.capacity * sizeof(*sleepSet.bodySims.data));
            var newSize = cast(i32, island.bodies.count * sizeof(*sleepSet.bodySims.data));
            sleepSet.bodySims.data = b3GrowAlloc(sleepSet.bodySims.data, oldSize, newSize);
            sleepSet.bodySims.capacity = island.bodies.count;
        }
        if !(0 != 0) { break; }
    }
    while true {
        if sleepSet.contactIndices.capacity < island.contacts.count {
            var oldSize = cast(i32, sleepSet.contactIndices.capacity * sizeof(*sleepSet.contactIndices.data));
            var newSize = cast(i32, island.contacts.count * sizeof(*sleepSet.contactIndices.data));
            sleepSet.contactIndices.data = b3GrowAlloc(sleepSet.contactIndices.data, oldSize, newSize);
            sleepSet.contactIndices.capacity = island.contacts.count;
        }
        if !(0 != 0) { break; }
    }
    while true {
        if sleepSet.jointSims.capacity < island.joints.count {
            var oldSize = cast(i32, sleepSet.jointSims.capacity * sizeof(*sleepSet.jointSims.data));
            var newSize = cast(i32, island.joints.count * sizeof(*sleepSet.jointSims.data));
            sleepSet.jointSims.data = b3GrowAlloc(sleepSet.jointSims.data, oldSize, newSize);
            sleepSet.jointSims.capacity = island.joints.count;
        }
        if !(0 != 0) { break; }
    }
    {
        for i32 i = 0; i < island.bodies.count; ++i {
            i32 bodyId = island.bodies.data[i];
            b3Body* body = world.bodies.data + bodyId;
            if body.bodyMoveIndex != -1 {
                b3BodyMoveEvent* moveEvent = world.bodyMoveEvents.data + body.bodyMoveIndex;
                moveEvent.fellAsleep = true;
                body.bodyMoveIndex = -1;
            }
            i32 awakeBodyIndex = body.localIndex;
            b3BodySim* awakeSim = awakeSet.bodySims.data + awakeBodyIndex;
            i32 sleepBodyIndex = sleepSet.bodySims.count;
            b3BodySim* sleepBodySim = b3EmplaceHelper(cast(void**, &sleepSet.bodySims.data), &sleepSet.bodySims.count, &sleepSet.bodySims.capacity, cast(i32, sizeof(*sleepSet.bodySims.data)));
            memcpy(sleepBodySim, awakeSim, cast(u64, sizeof(b3BodySim)));
            i32 movedIndex = b3RemoveHelper(awakeSet.bodySims.data, &awakeSet.bodySims.count, awakeBodyIndex, cast(i32, sizeof(*awakeSet.bodySims.data)));
            if movedIndex != -1 {
                b3BodySim* movedSim = awakeSet.bodySims.data + awakeBodyIndex;
                i32 movedId = movedSim.bodyId;
                b3Body* movedBody = world.bodies.data + movedId;
                movedBody.localIndex = awakeBodyIndex;
            }
            b3RemoveHelper(awakeSet.bodyStates.data, &awakeSet.bodyStates.count, awakeBodyIndex, cast(i32, sizeof(*awakeSet.bodyStates.data)));
            body.setIndex = sleepSetId;
            body.localIndex = sleepBodyIndex;
            i32 contactKey = body.headContactKey;
            while contactKey != -1 {
                i32 contactId = contactKey >> 1;
                i32 edgeIndex = contactKey & 1;
                b3Contact* contact = world.contacts.data + contactId;
                contactKey = contact.edges[edgeIndex].nextKey;
                if contact.setIndex == b3_disabledSet {
                    continue;
                }
                if contact.colorIndex != -1 {
                    continue;
                }
                i32 otherEdgeIndex = edgeIndex ^ 1;
                i32 otherBodyId = contact.edges[otherEdgeIndex].bodyId;
                b3Body* otherBody = world.bodies.data + otherBodyId;
                if otherBody.setIndex == b3_awakeSet {
                    continue;
                }
                i32 localIndex = contact.localIndex;
                contact.setIndex = b3_disabledSet;
                contact.localIndex = disabledSet.contactIndices.count;
                while true {
                    if disabledSet.contactIndices.count >= disabledSet.contactIndices.capacity {
                        var oldSize = cast(i32, disabledSet.contactIndices.capacity * sizeof(*disabledSet.contactIndices.data));
                        i32 newCapacity = disabledSet.contactIndices.capacity == 0 ? 8 : 2 * disabledSet.contactIndices.capacity;
                        var newSize = cast(i32, newCapacity * sizeof(*disabledSet.contactIndices.data));
                        disabledSet.contactIndices.data = b3GrowAlloc(disabledSet.contactIndices.data, oldSize, newSize);
                        disabledSet.contactIndices.capacity = newCapacity;
                    }
                    disabledSet.contactIndices.data[disabledSet.contactIndices.count++] = contact.contactId;
                    if !(0 != 0) { break; }
                }
                i32 movedLocalIndex = b3RemoveHelper(awakeSet.contactIndices.data, &awakeSet.contactIndices.count, localIndex, cast(i32, sizeof(*awakeSet.contactIndices.data)));
                if movedLocalIndex != -1 {
                    i32 movedContactIndex = awakeSet.contactIndices.data[localIndex];
                    b3Contact* movedContact = world.contacts.data + movedContactIndex;
                    movedContact.localIndex = localIndex;
                }
            }
        }
    }
    {
        for i32 i = 0; i < island.contacts.count; ++i {
            i32 contactId = island.contacts.data[i].contactId;
            b3Contact* contact = world.contacts.data + contactId;
            i32 colorIndex = contact.colorIndex;
            b3GraphColor* color = world.constraintGraph.colors + colorIndex;
            if colorIndex != 24 - 1 {
                b3ClearBit(&color.bodySet, cast(u32, contact.edges[0].bodyId));
                b3ClearBit(&color.bodySet, cast(u32, contact.edges[1].bodyId));
            }
            i32 sleepContactIndex = sleepSet.contactIndices.count;
            while true {
                if sleepSet.contactIndices.count >= sleepSet.contactIndices.capacity {
                    var oldSize = cast(i32, sleepSet.contactIndices.capacity * sizeof(*sleepSet.contactIndices.data));
                    i32 newCapacity = sleepSet.contactIndices.capacity == 0 ? 8 : 2 * sleepSet.contactIndices.capacity;
                    var newSize = cast(i32, newCapacity * sizeof(*sleepSet.contactIndices.data));
                    sleepSet.contactIndices.data = b3GrowAlloc(sleepSet.contactIndices.data, oldSize, newSize);
                    sleepSet.contactIndices.capacity = newCapacity;
                }
                sleepSet.contactIndices.data[sleepSet.contactIndices.count++] = contactId;
                if !(0 != 0) { break; }
            }
            i32 localIndex = contact.localIndex;
            if contact.flags & cast(u32, b3_simMeshContact) || colorIndex == 24 - 1 {
                i32 movedLocalIndex = b3RemoveHelper(color.contacts.data, &color.contacts.count, localIndex, cast(i32, sizeof(*color.contacts.data)));
                if movedLocalIndex != -1 {
                    i32 movedContactId = color.contacts.data[localIndex].contactId;
                    b3Contact* movedContact = world.contacts.data + movedContactId;
                    movedContact.localIndex = localIndex;
                }
            } else {
                i32 movedLocalIndex = b3RemoveHelper(color.convexContacts.data, &color.convexContacts.count, localIndex, cast(i32, sizeof(*color.convexContacts.data)));
                if movedLocalIndex != -1 {
                    i32 movedContactId = color.convexContacts.data[localIndex];
                    b3Contact* movedContact = world.contacts.data + movedContactId;
                    movedContact.localIndex = localIndex;
                }
            }
            contact.setIndex = sleepSetId;
            contact.colorIndex = -1;
            contact.localIndex = sleepContactIndex;
        }
    }
    {
        for i32 i = 0; i < island.joints.count; ++i {
            i32 jointId = island.joints.data[i].jointId;
            b3Joint* joint = world.joints.data + jointId;
            i32 colorIndex = joint.colorIndex;
            i32 localIndex = joint.localIndex;
            b3GraphColor* color = world.constraintGraph.colors + colorIndex;
            b3JointSim* awakeJointSim = color.jointSims.data + localIndex;
            if colorIndex != 24 - 1 {
                b3ClearBit(&color.bodySet, cast(u32, joint.edges[0].bodyId));
                b3ClearBit(&color.bodySet, cast(u32, joint.edges[1].bodyId));
            }
            i32 sleepJointIndex = sleepSet.jointSims.count;
            b3JointSim* sleepJointSim = b3EmplaceHelper(cast(void**, &sleepSet.jointSims.data), &sleepSet.jointSims.count, &sleepSet.jointSims.capacity, cast(i32, sizeof(*sleepSet.jointSims.data)));
            memcpy(sleepJointSim, awakeJointSim, cast(u64, sizeof(b3JointSim)));
            i32 movedIndex = b3RemoveHelper(color.jointSims.data, &color.jointSims.count, localIndex, cast(i32, sizeof(*color.jointSims.data)));
            if movedIndex != -1 {
                b3JointSim* movedJointSim = color.jointSims.data + localIndex;
                i32 movedId = movedJointSim.jointId;
                b3Joint* movedJoint = world.joints.data + movedId;
                movedJoint.localIndex = localIndex;
            }
            joint.setIndex = sleepSetId;
            joint.colorIndex = -1;
            joint.localIndex = sleepJointIndex;
        }
    }
    {
        i32 islandIndex = island.localIndex;
        b3IslandSim* sleepIsland = b3EmplaceHelper(cast(void**, &sleepSet.islandSims.data), &sleepSet.islandSims.count, &sleepSet.islandSims.capacity, cast(i32, sizeof(*sleepSet.islandSims.data)));
        sleepIsland.islandId = islandId;
        i32 movedIslandIndex = b3RemoveHelper(awakeSet.islandSims.data, &awakeSet.islandSims.count, islandIndex, cast(i32, sizeof(*awakeSet.islandSims.data)));
        if movedIslandIndex != -1 {
            b3IslandSim* movedIslandSim = awakeSet.islandSims.data + islandIndex;
            i32 movedIslandId = movedIslandSim.islandId;
            b3Island* movedIsland = world.islands.data + movedIslandId;
            movedIsland.localIndex = islandIndex;
        }
        island.setIndex = sleepSetId;
        island.localIndex = 0;
    }
    if world.splitIslandId == islandId {
        world.splitIslandId = -1;
    }
    b3ValidateSolverSets(world);
}

// This is called when joints are created between sets. I want to allow the sets
// to continue sleeping if both are asleep. Otherwise one set is waked.
// Islands will get merge when the set is woke.
void b3MergeSolverSets(b3World* world, i32 setId1, i32 setId2) {
    b3SolverSet* set1 = world.solverSets.data + setId1;
    b3SolverSet* set2 = world.solverSets.data + setId2;
    if set1.bodySims.count < set2.bodySims.count {
        b3SolverSet* tempSet = set1;
        set1 = set2;
        set2 = tempSet;
        i32 tempId = setId1;
        setId1 = setId2;
        setId2 = tempId;
    }
    {
        b3Body* bodies = world.bodies.data;
        i32 bodyCount = set2.bodySims.count;
        for i32 i = 0; i < bodyCount; ++i {
            b3BodySim* simSrc = set2.bodySims.data + i;
            b3Body* body = bodies + simSrc.bodyId;
            body.setIndex = setId1;
            body.localIndex = set1.bodySims.count;
            b3BodySim* simDst = b3EmplaceHelper(cast(void**, &set1.bodySims.data), &set1.bodySims.count, &set1.bodySims.capacity, cast(i32, sizeof(*set1.bodySims.data)));
            memcpy(simDst, simSrc, cast(u64, sizeof(b3BodySim)));
        }
    }
    {
        i32 contactCount = set2.contactIndices.count;
        for i32 i = 0; i < contactCount; ++i {
            i32 contactIndex = set2.contactIndices.data[i];
            b3Contact* contact = world.contacts.data + contactIndex;
            contact.setIndex = setId1;
            contact.localIndex = set1.contactIndices.count;
            while true {
                if set1.contactIndices.count >= set1.contactIndices.capacity {
                    var oldSize = cast(i32, set1.contactIndices.capacity * sizeof(*set1.contactIndices.data));
                    i32 newCapacity = set1.contactIndices.capacity == 0 ? 8 : 2 * set1.contactIndices.capacity;
                    var newSize = cast(i32, newCapacity * sizeof(*set1.contactIndices.data));
                    set1.contactIndices.data = b3GrowAlloc(set1.contactIndices.data, oldSize, newSize);
                    set1.contactIndices.capacity = newCapacity;
                }
                set1.contactIndices.data[set1.contactIndices.count++] = contactIndex;
                if !(0 != 0) { break; }
            }
        }
    }
    {
        i32 jointCount = set2.jointSims.count;
        for i32 i = 0; i < jointCount; ++i {
            b3JointSim* jointSrc = set2.jointSims.data + i;
            b3Joint* joint = world.joints.data + jointSrc.jointId;
            joint.setIndex = setId1;
            joint.localIndex = set1.jointSims.count;
            b3JointSim* jointDst = b3EmplaceHelper(cast(void**, &set1.jointSims.data), &set1.jointSims.count, &set1.jointSims.capacity, cast(i32, sizeof(*set1.jointSims.data)));
            memcpy(jointDst, jointSrc, cast(u64, sizeof(b3JointSim)));
        }
    }
    {
        i32 islandCount = set2.islandSims.count;
        for i32 i = 0; i < islandCount; ++i {
            b3IslandSim* islandSrc = set2.islandSims.data + i;
            i32 islandId = islandSrc.islandId;
            b3Island* island = world.islands.data + islandId;
            island.setIndex = setId1;
            island.localIndex = set1.islandSims.count;
            b3IslandSim* islandDst = b3EmplaceHelper(cast(void**, &set1.islandSims.data), &set1.islandSims.count, &set1.islandSims.capacity, cast(i32, sizeof(*set1.islandSims.data)));
            memcpy(islandDst, islandSrc, cast(u64, sizeof(b3IslandSim)));
        }
    }
    b3DestroySolverSet(world, setId2);
    b3ValidateSolverSets(world);
}

void b3TransferBody(b3World* world, b3SolverSet* targetSet, b3SolverSet* sourceSet, b3Body* body) {
    if targetSet == sourceSet {
        return;
    }
    i32 sourceIndex = body.localIndex;
    b3BodySim* sourceSim = sourceSet.bodySims.data + sourceIndex;
    i32 targetIndex = targetSet.bodySims.count;
    b3BodySim* targetSim = b3EmplaceHelper(cast(void**, &targetSet.bodySims.data), &targetSet.bodySims.count, &targetSet.bodySims.capacity, cast(i32, sizeof(*targetSet.bodySims.data)));
    memcpy(targetSim, sourceSim, cast(u64, sizeof(b3BodySim)));
    targetSim.flags &= cast(u32, ~(b3_isFast | b3_isSpeedCapped | b3_hadTimeOfImpact));
    i32 movedIndex = b3RemoveHelper(sourceSet.bodySims.data, &sourceSet.bodySims.count, sourceIndex, cast(i32, sizeof(*sourceSet.bodySims.data)));
    if movedIndex != -1 {
        b3BodySim* movedSim = sourceSet.bodySims.data + sourceIndex;
        i32 movedId = movedSim.bodyId;
        b3Body* movedBody = world.bodies.data + movedId;
        movedBody.localIndex = sourceIndex;
    }
    if sourceSet.setIndex == b3_awakeSet {
        b3RemoveHelper(sourceSet.bodyStates.data, &sourceSet.bodyStates.count, sourceIndex, cast(i32, sizeof(*sourceSet.bodyStates.data)));
    } else if targetSet.setIndex == b3_awakeSet {
        b3BodyState* state = b3EmplaceHelper(cast(void**, &targetSet.bodyStates.data), &targetSet.bodyStates.count, &targetSet.bodyStates.capacity, cast(i32, sizeof(*targetSet.bodyStates.data)));
        *state = b3_identityBodyState;
        state.flags = body.flags;
    }
    body.setIndex = targetSet.setIndex;
    body.localIndex = targetIndex;
}

void b3TransferJoint(b3World* world, b3SolverSet* targetSet, b3SolverSet* sourceSet, b3Joint* joint) {
    if targetSet == sourceSet {
        return;
    }
    i32 localIndex = joint.localIndex;
    i32 colorIndex = joint.colorIndex;
    b3JointSim* sourceSim;
    if sourceSet.setIndex == b3_awakeSet {
        b3GraphColor* color = world.constraintGraph.colors + colorIndex;
        sourceSim = color.jointSims.data + localIndex;
    } else {
        sourceSim = sourceSet.jointSims.data + localIndex;
    }
    if targetSet.setIndex == b3_awakeSet {
        b3AddJointToGraph(world, sourceSim, joint);
        joint.setIndex = b3_awakeSet;
    } else {
        joint.setIndex = targetSet.setIndex;
        joint.localIndex = targetSet.jointSims.count;
        joint.colorIndex = -1;
        b3JointSim* targetSim = b3EmplaceHelper(cast(void**, &targetSet.jointSims.data), &targetSet.jointSims.count, &targetSet.jointSims.capacity, cast(i32, sizeof(*targetSet.jointSims.data)));
        memcpy(targetSim, sourceSim, cast(u64, sizeof(b3JointSim)));
    }
    if sourceSet.setIndex == b3_awakeSet {
        b3RemoveJointFromGraph(world, joint.edges[0].bodyId, joint.edges[1].bodyId, colorIndex, localIndex);
    } else {
        i32 movedIndex = b3RemoveHelper(sourceSet.jointSims.data, &sourceSet.jointSims.count, localIndex, cast(i32, sizeof(*sourceSet.jointSims.data)));
        if movedIndex != -1 {
            b3JointSim* movedJointSim = sourceSet.jointSims.data + localIndex;
            i32 movedId = movedJointSim.jointId;
            b3Joint* movedJoint = world.joints.data + movedId;
            movedJoint.localIndex = localIndex;
        }
    }
}

// SPDX-FileCopyrightText: 2026 Erin Catto
// SPDX-License-Identifier: MIT
// Dirk Gregorius contributed portions of this code
b3MassData b3ComputeSphereMass(b3Sphere* shape, f32 density) {
    b3Vec3 center = shape.center;
    f32 radius = shape.radius;
    f32 volume = 4.0f / 3.0f * 3.14159265359f * radius * radius * radius;
    f32 mass = volume * density;
    f32 ixx = 0.4f * mass * radius * radius;
    noinit b3MassData out;
    out.mass = mass;
    out.center = center;
    out.inertia = b3MakeDiagonalMatrix(ixx, ixx, ixx);
    return out;
}

b3AABB b3ComputeSphereAABB(b3Sphere* shape, b3Transform transform) {
    b3Vec3 center = b3TransformPoint(transform, shape.center);
    f32 radius = shape.radius;
    var extent = b3Vec3{radius, radius, radius};
    return b3AABB{b3Sub(center, extent), b3Add(center, extent)};
}

b3AABB b3ComputeSweptSphereAABB(b3Sphere* shape, b3Transform xf1, b3Transform xf2) {
    var r = b3Vec3{shape.radius, shape.radius, shape.radius};
    b3Vec3 center1 = b3TransformPoint(xf1, shape.center);
    b3Vec3 center2 = b3TransformPoint(xf2, shape.center);
    return b3AABB{b3Sub(b3Min(center1, center2), r), b3Add(b3Max(center1, center2), r)};
}

bool b3OverlapSphere(b3Sphere* shape, b3Transform shapeTransform, b3ShapeProxy* proxy) {
    noinit b3DistanceInput input;
    input.proxyA = b3ShapeProxy{&shape.center, 1, shape.radius};
    input.proxyB = *proxy;
    input.transform = b3InvMulTransforms(shapeTransform, b3Transform_identity);
    input.useRadii = true;
    b3SimplexCache cache;
    b3DistanceOutput output = b3ShapeDistance(&input, &cache, null, 0);
    return output.distance < 0.1f * (0.005f * b3GetLengthUnitsPerMeter());
}

// Precision Improvements for Ray / Sphere Intersection - Ray Tracing Gems 2019
// http://www.codercorner.com/blog/?p=321
b3CastOutput b3RayCastSphere(b3Sphere* shape, b3RayCastInput* input) {
    b3CastOutput output;
    b3Vec3 p = shape.center;
    b3Vec3 s = b3Sub(input.origin, p);
    f32 r = shape.radius;
    f32 rr = r * r;
    f32 length;
    b3Vec3 d = b3GetLengthAndNormalize(&length, input.translation);
    if length == 0.0f {
        if b3LengthSquared(s) < rr {
            output.point = input.origin;
            output.hit = true;
        }
        return output;
    }
    f32 t = -b3Dot(s, d);
    b3Vec3 c = b3MulAdd(s, t, d);
    f32 cc = b3Dot(c, c);
    if cc > rr {
        return output;
    }
    f32 h = sqrtf(rr - cc);
    f32 fraction = t - h;
    if fraction < 0.0f || input.maxFraction * length < fraction {
        if b3LengthSquared(s) < rr {
            output.point = input.origin;
            output.hit = true;
        }
        return output;
    }
    b3Vec3 hitPoint = b3MulAdd(s, fraction, d);
    output.fraction = fraction / length;
    if output.fraction > input.maxFraction {
        b3Log("sphere input fraction = %g, output fraction = %g", input.maxFraction, output.fraction);
        output.fraction = input.maxFraction;
    }
    output.normal = b3Normalize(hitPoint);
    output.point = b3MulAdd(p, shape.radius, output.normal);
    output.hit = true;
    return output;
}

// Precision Improvements for Ray / Sphere Intersection - Ray Tracing Gems 2019
// http://www.codercorner.com/blog/?p=321
// This will do interior hits.
b3CastOutput b3RayCastHollowSphere(b3Sphere* sphere, b3RayCastInput* input) {
    b3Vec3 p = sphere.center;
    b3CastOutput output;
    b3Vec3 s = b3Sub(input.origin, p);
    b3Vec3 d = b3Normalize(input.translation);
    f32 t = -b3Dot(s, d);
    b3Vec3 c = b3MulAdd(s, t, d);
    f32 cc = b3Dot(c, c);
    f32 r = sphere.radius;
    f32 rr = r * r;
    if cc > rr {
        return output;
    }
    f32 h = sqrtf(rr - cc);
    f32 fraction = t - h;
    if fraction < 0.0f {
        fraction = t + h;
    }
    if fraction < 0.0f {
        return output;
    }
    if fraction > input.maxFraction {
        return output;
    }
    b3Vec3 hitPoint = b3MulAdd(s, fraction, d);
    output.fraction = fraction;
    output.normal = b3Normalize(hitPoint);
    output.point = b3MulAdd(p, sphere.radius, output.normal);
    output.hit = true;
    return output;
}

b3CastOutput b3ShapeCastSphere(b3Sphere* sphere, b3ShapeCastInput* input) {
    noinit b3ShapeCastPairInput pairInput;
    pairInput.proxyA = b3ShapeProxy{&sphere.center, 1, sphere.radius};
    pairInput.proxyB = input.proxy;
    pairInput.transform = b3Transform_identity;
    pairInput.translationB = input.translation;
    pairInput.maxFraction = input.maxFraction;
    pairInput.canEncroach = input.canEncroach;
    b3CastOutput output = b3ShapeCast(&pairInput);
    return output;
}

i32 b3CollideMoverAndSphere(b3PlaneResult* result, b3Sphere* shape, b3Capsule* mover) {
    f32 totalRadius = mover.radius + shape.radius;
    b3Vec3 closest = b3PointToSegmentDistance(mover.center1, mover.center2, shape.center);
    f32 distance;
    b3Vec3 normal = b3GetLengthAndNormalize(&distance, b3Sub(closest, shape.center));
    if distance > totalRadius {
        return 0;
    }
    f32 linearSlop = 0.005f * b3GetLengthUnitsPerMeter();
    if distance < linearSlop {
        f32 length;
        b3Vec3 axis = b3GetLengthAndNormalize(&length, b3Sub(mover.center2, mover.center1));
        normal = length > linearSlop ? b3Perp(axis) : b3Vec3_axisY;
        distance = 0.0f;
    }
    var plane = b3Plane{normal, totalRadius - distance};
    *result = b3PlaneResult{plane, shape.center};
    return 1;
}

// SPDX-FileCopyrightText: 2025 Erin Catto
// SPDX-License-Identifier: MIT
// needed for dll export
void b3SphericalJoint_EnableConeLimit(b3JointId jointId, bool enableLimit) {
    b3World* world = b3GetWorld(cast(i32, jointId.world0));
    while true {
        if world.recording != null {
            var recArgs = b3RecArgs_SphericalJointEnableConeLimit{jointId, enableLimit};
            b3RecWrite_SphericalJointEnableConeLimit(world.recording, &recArgs);
        }
        if !(0 != 0) { break; }
    }
    b3JointSim* base = b3GetJointSimCheckType(jointId, b3_sphericalJoint);
    if enableLimit != base.sphericalJoint.enableConeLimit {
        base.sphericalJoint.swingImpulse = 0.0f;
    }
    base.sphericalJoint.enableConeLimit = enableLimit;
}

bool b3SphericalJoint_IsConeLimitEnabled(b3JointId jointId) {
    b3JointSim* base = b3GetJointSimCheckType(jointId, b3_sphericalJoint);
    return base.sphericalJoint.enableConeLimit;
}

f32 b3SphericalJoint_GetConeLimit(b3JointId jointId) {
    b3JointSim* base = b3GetJointSimCheckType(jointId, b3_sphericalJoint);
    return base.sphericalJoint.coneAngle;
}

void b3SphericalJoint_SetConeLimit(b3JointId jointId, f32 angleRadians) {
    b3World* world = b3GetWorld(cast(i32, jointId.world0));
    while true {
        if world.recording != null {
            var recArgs = b3RecArgs_SphericalJointSetConeLimit{jointId, angleRadians};
            b3RecWrite_SphericalJointSetConeLimit(world.recording, &recArgs);
        }
        if !(0 != 0) { break; }
    }
    b3JointSim* base = b3GetJointSimCheckType(jointId, b3_sphericalJoint);
    base.sphericalJoint.coneAngle = angleRadians;
}

f32 b3SphericalJoint_GetConeAngle(b3JointId jointId) {
    b3World* world = b3GetWorld(cast(i32, jointId.world0));
    b3JointSim* base = b3GetJointSimCheckType(jointId, b3_sphericalJoint);
    b3WorldTransform transformA = b3GetBodyTransform(world, base.bodyIdA);
    b3WorldTransform transformB = b3GetBodyTransform(world, base.bodyIdB);
    b3Quat quatA = b3MulQuat(transformA.q, base.localFrameA.q);
    b3Quat quatB = b3MulQuat(transformB.q, base.localFrameB.q);
    if b3DotQuat(quatA, quatB) < 0.0f {
        quatB = b3NegateQuat(quatB);
    }
    b3Quat relQ = b3InvMulQuat(quatA, quatB);
    return b3GetSwingAngle(relQ);
}

void b3SphericalJoint_EnableTwistLimit(b3JointId jointId, bool enableLimit) {
    b3World* world = b3GetWorld(cast(i32, jointId.world0));
    while true {
        if world.recording != null {
            var recArgs = b3RecArgs_SphericalJointEnableTwistLimit{jointId, enableLimit};
            b3RecWrite_SphericalJointEnableTwistLimit(world.recording, &recArgs);
        }
        if !(0 != 0) { break; }
    }
    b3JointSim* base = b3GetJointSimCheckType(jointId, b3_sphericalJoint);
    if enableLimit != base.sphericalJoint.enableTwistLimit {
        base.sphericalJoint.lowerTwistImpulse = 0.0f;
        base.sphericalJoint.upperTwistImpulse = 0.0f;
    }
    base.sphericalJoint.enableTwistLimit = enableLimit;
}

bool b3SphericalJoint_IsTwistLimitEnabled(b3JointId jointId) {
    b3JointSim* base = b3GetJointSimCheckType(jointId, b3_sphericalJoint);
    return base.sphericalJoint.enableTwistLimit;
}

f32 b3SphericalJoint_GetLowerTwistLimit(b3JointId jointId) {
    b3JointSim* base = b3GetJointSimCheckType(jointId, b3_sphericalJoint);
    return base.sphericalJoint.lowerTwistAngle;
}

f32 b3SphericalJoint_GetUpperTwistLimit(b3JointId jointId) {
    b3JointSim* base = b3GetJointSimCheckType(jointId, b3_sphericalJoint);
    return base.sphericalJoint.upperTwistAngle;
}

void b3SphericalJoint_SetTwistLimits(b3JointId jointId, f32 lowerLimitRadians, f32 upperLimitRadians) {
    b3World* world = b3GetWorld(cast(i32, jointId.world0));
    while true {
        if world.recording != null {
            var recArgs = b3RecArgs_SphericalJointSetTwistLimits{jointId, lowerLimitRadians, upperLimitRadians};
            b3RecWrite_SphericalJointSetTwistLimits(world.recording, &recArgs);
        }
        if !(0 != 0) { break; }
    }
    f32 lowerAngle = b3MinFloat(lowerLimitRadians, upperLimitRadians);
    f32 upperAngle = b3MaxFloat(lowerLimitRadians, upperLimitRadians);
    b3JointSim* base = b3GetJointSimCheckType(jointId, b3_sphericalJoint);
    base.sphericalJoint.lowerTwistAngle = b3ClampFloat(lowerAngle, -0.99f * 3.14159265359f, 0.99f * 3.14159265359f);
    base.sphericalJoint.upperTwistAngle = b3ClampFloat(upperAngle, -0.99f * 3.14159265359f, 0.99f * 3.14159265359f);
}

f32 b3SphericalJoint_GetTwistAngle(b3JointId jointId) {
    b3World* world = b3GetWorld(cast(i32, jointId.world0));
    b3JointSim* base = b3GetJointSimCheckType(jointId, b3_sphericalJoint);
    b3WorldTransform transformA = b3GetBodyTransform(world, base.bodyIdA);
    b3WorldTransform transformB = b3GetBodyTransform(world, base.bodyIdB);
    b3Quat quatA = b3MulQuat(transformA.q, base.localFrameA.q);
    b3Quat quatB = b3MulQuat(transformB.q, base.localFrameB.q);
    if b3DotQuat(quatA, quatB) < 0.0f {
        quatB = b3NegateQuat(quatB);
    }
    b3Quat relQ = b3InvMulQuat(quatA, quatB);
    return b3GetTwistAngle(relQ);
}

void b3SphericalJoint_EnableSpring(b3JointId jointId, bool enableSpring) {
    b3World* world = b3GetWorld(cast(i32, jointId.world0));
    while true {
        if world.recording != null {
            var recArgs = b3RecArgs_SphericalJointEnableSpring{jointId, enableSpring};
            b3RecWrite_SphericalJointEnableSpring(world.recording, &recArgs);
        }
        if !(0 != 0) { break; }
    }
    b3JointSim* base = b3GetJointSimCheckType(jointId, b3_sphericalJoint);
    if enableSpring != base.sphericalJoint.enableSpring {
        base.sphericalJoint.springImpulse = b3Vec3_zero;
    }
    base.sphericalJoint.enableSpring = enableSpring;
}

bool b3SphericalJoint_IsSpringEnabled(b3JointId jointId) {
    b3JointSim* base = b3GetJointSimCheckType(jointId, b3_sphericalJoint);
    return base.sphericalJoint.enableSpring;
}

void b3SphericalJoint_SetTargetRotation(b3JointId jointId, b3Quat targetRotation) {
    b3World* world = b3GetWorld(cast(i32, jointId.world0));
    while true {
        if world.recording != null {
            var recArgs = b3RecArgs_SphericalJointSetTargetRotation{jointId, targetRotation};
            b3RecWrite_SphericalJointSetTargetRotation(world.recording, &recArgs);
        }
        if !(0 != 0) { break; }
    }
    b3JointSim* base = b3GetJointSimCheckType(jointId, b3_sphericalJoint);
    base.sphericalJoint.targetRotation = targetRotation;
}

b3Quat b3SphericalJoint_GetTargetRotation(b3JointId jointId) {
    b3JointSim* base = b3GetJointSimCheckType(jointId, b3_sphericalJoint);
    return base.sphericalJoint.targetRotation;
}

void b3SphericalJoint_SetSpringHertz(b3JointId jointId, f32 hertz) {
    b3World* world = b3GetWorld(cast(i32, jointId.world0));
    while true {
        if world.recording != null {
            var recArgs = b3RecArgs_SphericalJointSetSpringHertz{jointId, hertz};
            b3RecWrite_SphericalJointSetSpringHertz(world.recording, &recArgs);
        }
        if !(0 != 0) { break; }
    }
    b3JointSim* base = b3GetJointSimCheckType(jointId, b3_sphericalJoint);
    base.sphericalJoint.hertz = hertz;
}

f32 b3SphericalJoint_GetSpringHertz(b3JointId jointId) {
    b3JointSim* base = b3GetJointSimCheckType(jointId, b3_sphericalJoint);
    return base.sphericalJoint.hertz;
}

void b3SphericalJoint_SetSpringDampingRatio(b3JointId jointId, f32 dampingRatio) {
    b3World* world = b3GetWorld(cast(i32, jointId.world0));
    while true {
        if world.recording != null {
            var recArgs = b3RecArgs_SphericalJointSetSpringDampingRatio{jointId, dampingRatio};
            b3RecWrite_SphericalJointSetSpringDampingRatio(world.recording, &recArgs);
        }
        if !(0 != 0) { break; }
    }
    b3JointSim* base = b3GetJointSimCheckType(jointId, b3_sphericalJoint);
    base.sphericalJoint.dampingRatio = dampingRatio;
}

f32 b3SphericalJoint_GetSpringDampingRatio(b3JointId jointId) {
    b3JointSim* base = b3GetJointSimCheckType(jointId, b3_sphericalJoint);
    return base.sphericalJoint.dampingRatio;
}

void b3SphericalJoint_EnableMotor(b3JointId jointId, bool enableMotor) {
    b3World* world = b3GetWorld(cast(i32, jointId.world0));
    while true {
        if world.recording != null {
            var recArgs = b3RecArgs_SphericalJointEnableMotor{jointId, enableMotor};
            b3RecWrite_SphericalJointEnableMotor(world.recording, &recArgs);
        }
        if !(0 != 0) { break; }
    }
    b3JointSim* base = b3GetJointSimCheckType(jointId, b3_sphericalJoint);
    if enableMotor != base.sphericalJoint.enableMotor {
        base.sphericalJoint.motorImpulse = b3Vec3_zero;
    }
    base.sphericalJoint.enableMotor = enableMotor;
}

bool b3SphericalJoint_IsMotorEnabled(b3JointId jointId) {
    b3JointSim* base = b3GetJointSimCheckType(jointId, b3_sphericalJoint);
    return base.sphericalJoint.enableMotor;
}

void b3SphericalJoint_SetMotorVelocity(b3JointId jointId, b3Vec3 motorVelocity) {
    b3World* world = b3GetWorld(cast(i32, jointId.world0));
    while true {
        if world.recording != null {
            var recArgs = b3RecArgs_SphericalJointSetMotorVelocity{jointId, motorVelocity};
            b3RecWrite_SphericalJointSetMotorVelocity(world.recording, &recArgs);
        }
        if !(0 != 0) { break; }
    }
    b3JointSim* base = b3GetJointSimCheckType(jointId, b3_sphericalJoint);
    base.sphericalJoint.motorVelocity = motorVelocity;
}

b3Vec3 b3SphericalJoint_GetMotorVelocity(b3JointId jointId) {
    b3JointSim* base = b3GetJointSimCheckType(jointId, b3_sphericalJoint);
    return base.sphericalJoint.motorVelocity;
}

void b3SphericalJoint_SetMaxMotorTorque(b3JointId jointId, f32 maxForce) {
    b3World* world = b3GetWorld(cast(i32, jointId.world0));
    while true {
        if world.recording != null {
            var recArgs = b3RecArgs_SphericalJointSetMaxMotorTorque{jointId, maxForce};
            b3RecWrite_SphericalJointSetMaxMotorTorque(world.recording, &recArgs);
        }
        if !(0 != 0) { break; }
    }
    b3JointSim* base = b3GetJointSimCheckType(jointId, b3_sphericalJoint);
    base.sphericalJoint.maxMotorTorque = maxForce;
}

f32 b3SphericalJoint_GetMaxMotorTorque(b3JointId jointId) {
    b3JointSim* base = b3GetJointSimCheckType(jointId, b3_sphericalJoint);
    return base.sphericalJoint.maxMotorTorque;
}

b3Vec3 b3SphericalJoint_GetMotorTorque(b3JointId jointId) {
    b3World* world = b3GetWorld(cast(i32, jointId.world0));
    b3JointSim* base = b3GetJointSimCheckType(jointId, b3_sphericalJoint);
    return b3MulSV(world.inv_h, base.sphericalJoint.motorImpulse);
}

b3Vec3 b3GetSphericalJointForce(b3World* world, b3JointSim* base) {
    b3Vec3 force = b3MulSV(world.inv_h, base.sphericalJoint.linearImpulse);
    return force;
}

b3Vec3 b3GetSphericalJointTorque(b3World* world, b3JointSim* base) {
    b3WorldTransform xfA = b3GetBodyTransform(world, base.bodyIdA);
    b3WorldTransform xfB = b3GetBodyTransform(world, base.bodyIdB);
    b3Quat qA = b3MulQuat(xfA.q, base.localFrameA.q);
    b3Quat qB = b3MulQuat(xfB.q, base.localFrameB.q);
    b3Vec3 coneAxis = b3RotateVector(qA, b3Vec3_axisZ);
    b3Vec3 twistAxis = b3RotateVector(qB, b3Vec3_axisZ);
    b3Vec3 swingAxis = b3Normalize(b3Cross(coneAxis, twistAxis));
    b3SphericalJoint* joint = &base.sphericalJoint;
    b3Vec3 impulse = b3Add(joint.springImpulse, joint.motorImpulse);
    impulse = b3MulAdd(impulse, joint.lowerTwistImpulse - joint.upperTwistImpulse, twistAxis);
    impulse = b3MulAdd(impulse, joint.swingImpulse, swingAxis);
    b3Vec3 torque = b3MulSV(world.inv_h, impulse);
    return torque;
}

// Point-to-point constraint
// C = p2 - p1
// Cdot = v2 - v1
//      = v2 + cross(w2, r2) - v1 - cross(w1, r1)
// J = [-I r1_skew I -r2_skew ]
// K = J * invM * transpose(J)
// transpose(skew(r)) = -skew(r)
// K = diag(1/m1 + 1/m2) - r1_skew * invI1 * r1_skew - r2_skew * invI2 * r2_skew
// r_skew = R * skew(r_local) * RT
// invI = R * invI_local * RT
// r_skew * invI * r_skew = R * skew(r_local) * RT * R * invI_local * RT * R * r_skew * RT
//                        = R * ( skew(r_local) * invI_local * skew(r_local) ) * RT
void b3PrepareSphericalJoint(b3JointSim* base, b3StepContext* context) {
    b3World* world = context.world;
    b3Body* bodyA = world.bodies.data + base.bodyIdA;
    b3Body* bodyB = world.bodies.data + base.bodyIdB;
    b3SolverSet* setA = world.solverSets.data + bodyA.setIndex;
    b3SolverSet* setB = world.solverSets.data + bodyB.setIndex;
    i32 localIndexA = bodyA.localIndex;
    i32 localIndexB = bodyB.localIndex;
    b3BodySim* bodySimA = setA.bodySims.data + localIndexA;
    b3BodySim* bodySimB = setB.bodySims.data + localIndexB;
    base.invMassA = bodySimA.invMass;
    base.invMassB = bodySimB.invMass;
    base.invIA = bodySimA.invInertiaWorld;
    base.invIB = bodySimB.invInertiaWorld;
    b3Matrix3 invInertiaSum = b3AddMM(base.invIA, base.invIB);
    base.fixedRotation = b3Det(invInertiaSum) < 1000.0f * FLT_MIN;
    b3SphericalJoint* joint = &base.sphericalJoint;
    joint.indexA = bodyA.setIndex == b3_awakeSet ? localIndexA : -1;
    joint.indexB = bodyB.setIndex == b3_awakeSet ? localIndexB : -1;
    joint.frameA.q = b3MulQuat(bodySimA.transform.q, base.localFrameA.q);
    joint.frameA.p = b3RotateVector(bodySimA.transform.q, b3Sub(base.localFrameA.p, bodySimA.localCenter));
    joint.frameB.q = b3MulQuat(bodySimB.transform.q, base.localFrameB.q);
    joint.frameB.p = b3RotateVector(bodySimB.transform.q, b3Sub(base.localFrameB.p, bodySimB.localCenter));
    joint.deltaCenter = b3SubPos(bodySimB.center, bodySimA.center);
    b3Vec3 coneAxis = b3RotateVector(joint.frameA.q, b3Vec3_axisZ);
    b3Vec3 twistAxis = b3RotateVector(joint.frameB.q, b3Vec3_axisZ);
    if joint.enableConeLimit != 0 {
        b3Vec3 swingAxis = b3Normalize(b3Cross(coneAxis, twistAxis));
        f32 k = b3Dot(swingAxis, b3MulMV(invInertiaSum, swingAxis));
        joint.swingMass = k > 0.0f ? 1.0f / k : 0.0f;
        joint.swingAxis = swingAxis;
    }
    if joint.enableTwistLimit != 0 {
        b3Quat relQ = b3InvMulQuat(joint.frameA.q, joint.frameB.q);
        f32 tanThetaOver2 = sqrtf((relQ.v.x * relQ.v.x + relQ.v.y * relQ.v.y) / (relQ.v.z * relQ.v.z + relQ.s * relQ.s));
        b3Vec3 swingAxis = b3Normalize(b3Cross(coneAxis, twistAxis));
        b3Vec3 perpAxis = b3Cross(swingAxis, coneAxis);
        b3Vec3 twistJacobian = b3MulAdd(coneAxis, tanThetaOver2, perpAxis);
        f32 k = b3Dot(twistJacobian, b3MulMV(invInertiaSum, twistJacobian));
        joint.twistMass = k > 0.0f ? 1.0f / k : 0.0f;
        joint.twistJacobian = twistJacobian;
    }
    if base.fixedRotation == false {
        joint.rotationMass = b3InvertMatrix(invInertiaSum);
    } else {
        joint.rotationMass = b3Mat3_zero;
    }
    joint.springSoftness = b3MakeSoft(joint.hertz, joint.dampingRatio, context.h);
    if context.enableWarmStarting == false {
        joint.linearImpulse = b3Vec3_zero;
        joint.motorImpulse = b3Vec3_zero;
        joint.springImpulse = b3Vec3_zero;
        joint.swingImpulse = 0.0f;
        joint.lowerTwistImpulse = 0.0f;
        joint.upperTwistImpulse = 0.0f;
    }
}

void b3WarmStartSphericalJoint(b3JointSim* base, b3StepContext* context) {
    f32 mA = base.invMassA;
    f32 mB = base.invMassB;
    b3Matrix3 iA = base.invIA;
    b3Matrix3 iB = base.invIB;
    b3BodyState dummyState = b3_identityBodyState;
    b3SphericalJoint* joint = &base.sphericalJoint;
    b3BodyState* stateA = joint.indexA == -1 ? &dummyState : context.states + joint.indexA;
    b3BodyState* stateB = joint.indexB == -1 ? &dummyState : context.states + joint.indexB;
    b3Vec3 vA = stateA.linearVelocity;
    b3Vec3 wA = stateA.angularVelocity;
    b3Vec3 vB = stateB.linearVelocity;
    b3Vec3 wB = stateB.angularVelocity;
    b3Vec3 rA = b3RotateVector(stateA.deltaRotation, joint.frameA.p);
    b3Vec3 rB = b3RotateVector(stateB.deltaRotation, joint.frameB.p);
    b3Vec3 angularImpulse = b3Add(joint.springImpulse, joint.motorImpulse);
    angularImpulse = b3MulSub(angularImpulse, joint.swingImpulse, joint.swingAxis);
    angularImpulse = b3MulAdd(angularImpulse, joint.lowerTwistImpulse - joint.upperTwistImpulse, joint.twistJacobian);
    vA = b3MulSub(vA, mA, joint.linearImpulse);
    wA = b3Sub(wA, b3MulMV(iA, b3Add(b3Cross(rA, joint.linearImpulse), angularImpulse)));
    vB = b3MulAdd(vB, mB, joint.linearImpulse);
    wB = b3Add(wB, b3MulMV(iB, b3Add(b3Cross(rB, joint.linearImpulse), angularImpulse)));
    if (stateA.flags & cast(u32, b3_dynamicFlag)) != 0 {
        stateA.linearVelocity = vA;
        stateA.angularVelocity = wA;
    }
    if (stateB.flags & cast(u32, b3_dynamicFlag)) != 0 {
        stateB.linearVelocity = vB;
        stateB.angularVelocity = wB;
    }
}

void b3SolveSphericalJoint(b3JointSim* base, b3StepContext* context, bool useBias) {
    f32 mA = base.invMassA;
    f32 mB = base.invMassB;
    b3Matrix3 iA = base.invIA;
    b3Matrix3 iB = base.invIB;
    b3BodyState dummyState = b3_identityBodyState;
    b3SphericalJoint* joint = &base.sphericalJoint;
    b3BodyState* stateA = joint.indexA == -1 ? &dummyState : context.states + joint.indexA;
    b3BodyState* stateB = joint.indexB == -1 ? &dummyState : context.states + joint.indexB;
    b3Vec3 vA = stateA.linearVelocity;
    b3Vec3 wA = stateA.angularVelocity;
    b3Vec3 vB = stateB.linearVelocity;
    b3Vec3 wB = stateB.angularVelocity;
    bool fixedRotation = base.fixedRotation;
    b3Quat quatA = b3MulQuat(stateA.deltaRotation, joint.frameA.q);
    b3Quat quatB = b3MulQuat(stateB.deltaRotation, joint.frameB.q);
    b3Quat relQ = b3InvMulQuat(quatA, quatB);
    if joint.enableSpring && fixedRotation == false {
        b3Vec3 deltaRotation = b3DeltaQuatToRotation(relQ, joint.targetRotation);
        b3Vec3 c = b3Neg(b3RotateVector(quatA, deltaRotation));
        b3Vec3 bias = b3MulSV(joint.springSoftness.biasRate, c);
        f32 massScale = joint.springSoftness.massScale;
        f32 impulseScale = joint.springSoftness.impulseScale;
        b3Vec3 cdot = b3Sub(wB, wA);
        b3Vec3 impulse = b3MulSub(b3MulSV(-massScale, b3MulMV(joint.rotationMass, b3Add(cdot, bias))), impulseScale, joint.springImpulse);
        joint.springImpulse = b3Add(joint.springImpulse, impulse);
        wA = b3Sub(wA, b3MulMV(iA, impulse));
        wB = b3Add(wB, b3MulMV(iB, impulse));
    }
    if joint.enableMotor && fixedRotation == false {
        b3Vec3 cdot = b3Sub(wB, wA);
        b3Vec3 lambda = b3Neg(b3MulMV(joint.rotationMass, b3Sub(cdot, joint.motorVelocity)));
        b3Vec3 newImpulse = b3Add(joint.motorImpulse, lambda);
        f32 length = b3Length(newImpulse);
        f32 maxImpulse = joint.maxMotorTorque * context.h;
        if length > maxImpulse {
            newImpulse = b3MulSV(maxImpulse / length, newImpulse);
        }
        lambda = b3Sub(newImpulse, joint.motorImpulse);
        joint.motorImpulse = newImpulse;
        wA = b3Sub(wA, b3MulMV(iA, lambda));
        wB = b3Add(wB, b3MulMV(iB, lambda));
    }
    if joint.enableTwistLimit && fixedRotation == false {
        f32 twistAngle = b3GetTwistAngle(relQ);
        b3Vec3 twistJacobian = joint.twistJacobian;
        {
            f32 c = twistAngle - joint.lowerTwistAngle;
            f32 bias = 0.0f;
            f32 massScale = 1.0f;
            f32 impulseScale = 0.0f;
            if c > 0.0f {
                bias = c * context.inv_h;
            } else if useBias != 0 {
                bias = base.constraintSoftness.biasRate * c;
                massScale = base.constraintSoftness.massScale;
                impulseScale = base.constraintSoftness.impulseScale;
            }
            f32 cdot = b3Dot(b3Sub(wB, wA), twistJacobian);
            f32 oldImpulse = joint.lowerTwistImpulse;
            f32 deltaImpulse = -massScale * joint.twistMass * (cdot + bias) - impulseScale * oldImpulse;
            joint.lowerTwistImpulse = b3MaxFloat(oldImpulse + deltaImpulse, 0.0f);
            deltaImpulse = joint.lowerTwistImpulse - oldImpulse;
            wA = b3MulSub(wA, deltaImpulse, b3MulMV(iA, twistJacobian));
            wB = b3MulAdd(wB, deltaImpulse, b3MulMV(iB, twistJacobian));
        }
        {
            f32 c = joint.upperTwistAngle - twistAngle;
            f32 bias = 0.0f;
            f32 massScale = 1.0f;
            f32 impulseScale = 0.0f;
            if c > 0.0f {
                bias = c * context.inv_h;
            } else if useBias != 0 {
                bias = base.constraintSoftness.biasRate * c;
                massScale = base.constraintSoftness.massScale;
                impulseScale = base.constraintSoftness.impulseScale;
            }
            f32 cdot = b3Dot(b3Sub(wA, wB), twistJacobian);
            f32 oldImpulse = joint.upperTwistImpulse;
            f32 deltaImpulse = -massScale * joint.twistMass * (cdot + bias) - impulseScale * oldImpulse;
            joint.upperTwistImpulse = b3MaxFloat(oldImpulse + deltaImpulse, 0.0f);
            deltaImpulse = joint.upperTwistImpulse - oldImpulse;
            wA = b3MulAdd(wA, deltaImpulse, b3MulMV(iA, twistJacobian));
            wB = b3MulSub(wB, deltaImpulse, b3MulMV(iB, twistJacobian));
        }
    }
    if joint.enableConeLimit && fixedRotation == false {
        f32 swingAngle = b3GetSwingAngle(relQ);
        b3Vec3 swingAxis = joint.swingAxis;
        f32 c = joint.coneAngle - swingAngle;
        f32 bias = 0.0f;
        f32 massScale = 1.0f;
        f32 impulseScale = 0.0f;
        if c > 0.0f {
            bias = c * context.inv_h;
        } else if useBias != 0 {
            bias = base.constraintSoftness.biasRate * c;
            massScale = base.constraintSoftness.massScale;
            impulseScale = base.constraintSoftness.impulseScale;
        }
        f32 cdot = b3Dot(b3Sub(wA, wB), swingAxis);
        f32 oldImpulse = joint.swingImpulse;
        f32 deltaImpulse = -massScale * joint.swingMass * (cdot + bias) - impulseScale * oldImpulse;
        joint.swingImpulse = b3MaxFloat(oldImpulse + deltaImpulse, 0.0f);
        deltaImpulse = joint.swingImpulse - oldImpulse;
        wA = b3MulAdd(wA, deltaImpulse, b3MulMV(iA, swingAxis));
        wB = b3MulSub(wB, deltaImpulse, b3MulMV(iB, swingAxis));
    }
    {
        b3Vec3 rA = b3RotateVector(stateA.deltaRotation, joint.frameA.p);
        b3Vec3 rB = b3RotateVector(stateB.deltaRotation, joint.frameB.p);
        b3Vec3 cdot = b3Sub(b3Sub(b3Add(vB, b3Cross(wB, rB)), vA), b3Cross(wA, rA));
        b3Vec3 bias = b3Vec3_zero;
        f32 massScale = 1.0f;
        f32 impulseScale = 0.0f;
        if useBias != 0 {
            b3Vec3 dcA = stateA.deltaPosition;
            b3Vec3 dcB = stateB.deltaPosition;
            b3Vec3 separation = b3Add(b3Sub(dcB, dcA), b3Sub(rB, rA));
            separation = b3Add(separation, joint.deltaCenter);
            bias = b3MulSV(base.constraintSoftness.biasRate, separation);
            massScale = base.constraintSoftness.massScale;
            impulseScale = base.constraintSoftness.impulseScale;
        }
        b3Matrix3 sA = b3Skew(rA);
        b3Matrix3 sB = b3Skew(rB);
        b3Matrix3 kA = b3MulMM(sA, b3MulMM(base.invIA, sA));
        b3Matrix3 kB = b3MulMM(sB, b3MulMM(base.invIB, sB));
        b3Matrix3 k = b3NegateMat3(b3AddMM(kA, kB));
        k.cx.x += mA + mB;
        k.cy.y += mA + mB;
        k.cz.z += mA + mB;
        b3Vec3 b = b3Solve3(k, b3Add(cdot, bias));
        b3Vec3 impulse = b3MulSub(b3MulSV(-massScale, b), impulseScale, joint.linearImpulse);
        joint.linearImpulse = b3Add(joint.linearImpulse, impulse);
        vA = b3MulSub(vA, mA, impulse);
        wA = b3Sub(wA, b3MulMV(iA, b3Cross(rA, impulse)));
        vB = b3MulAdd(vB, mB, impulse);
        wB = b3Add(wB, b3MulMV(iB, b3Cross(rB, impulse)));
    }
    if (stateA.flags & cast(u32, b3_dynamicFlag)) != 0 {
        stateA.linearVelocity = vA;
        stateA.angularVelocity = wA;
    }
    if (stateB.flags & cast(u32, b3_dynamicFlag)) != 0 {
        stateB.linearVelocity = vB;
        stateB.angularVelocity = wB;
    }
}

void b3DrawSphericalJoint(b3DebugDraw* draw, b3JointSim* base, b3WorldTransform transformA, b3WorldTransform transformB, f32 scale) {
    b3WorldTransform frameA = b3MulWorldTransforms(transformA, base.localFrameA);
    f32 length1 = 0.1f * scale;
    draw.DrawSegmentFcn(frameA.p, b3OffsetPos(frameA.p, b3MulSV(length1, b3RotateVector(frameA.q, b3Vec3_axisX))), b3_colorRed, draw.context);
    draw.DrawSegmentFcn(frameA.p, b3OffsetPos(frameA.p, b3MulSV(length1, b3RotateVector(frameA.q, b3Vec3_axisY))), b3_colorGreen, draw.context);
    draw.DrawSegmentFcn(frameA.p, b3OffsetPos(frameA.p, b3MulSV(length1, b3RotateVector(frameA.q, b3Vec3_axisZ))), b3_colorBlue, draw.context);
    b3WorldTransform frameB = b3MulWorldTransforms(transformB, base.localFrameB);
    f32 length2 = 0.2f * scale;
    draw.DrawSegmentFcn(frameB.p, b3OffsetPos(frameB.p, b3MulSV(length2, b3RotateVector(frameB.q, b3Vec3_axisZ))), b3_colorOrange, draw.context);
    b3SphericalJoint* joint = &base.sphericalJoint;
    if joint.enableTwistLimit != 0 {
        b3Quat quatA = frameA.q;
        b3Quat quatB = frameB.q;
        if b3DotQuat(quatA, quatB) < 0.0f {
            quatB = b3NegateQuat(quatB);
        }
        b3Quat relQ = b3InvMulQuat(quatA, quatB);
        f32 wedgeRadius = 0.1f * scale;
        for i32 index = 0; index < kSliceCount; ++index {
            f32 t1 = cast(f32, index + 0) / cast(f32, kSliceCount);
            f32 alpha1 = (1.0f - t1) * joint.lowerTwistAngle + t1 * joint.upperTwistAngle;
            f32 t2 = cast(f32, index + 1) / cast(f32, kSliceCount);
            f32 alpha2 = (1.0f - t2) * joint.lowerTwistAngle + t2 * joint.upperTwistAngle;
            var vertex1 = b3Vec3{wedgeRadius * b3Cos(alpha1), wedgeRadius * b3Sin(alpha1), 0.0f};
            var vertex2 = b3Vec3{wedgeRadius * b3Cos(alpha2), wedgeRadius * b3Sin(alpha2), 0.0f};
            if index == 0 {
                draw.DrawSegmentFcn(frameA.p, b3TransformWorldPoint(frameA, vertex1), b3_colorCyan, draw.context);
            }
            if index == kSliceCount - 1 {
                draw.DrawSegmentFcn(b3TransformWorldPoint(frameA, vertex2), frameA.p, b3_colorCyan, draw.context);
            }
            draw.DrawSegmentFcn(b3TransformWorldPoint(frameA, vertex1), b3TransformWorldPoint(frameA, vertex2), b3_colorCyan, draw.context);
        }
        f32 twistAngle = b3GetTwistAngle(relQ);
        var p2 = b3Vec3{wedgeRadius * b3Cos(twistAngle), wedgeRadius * b3Sin(twistAngle), 0.0f};
        draw.DrawSegmentFcn(frameA.p, b3TransformWorldPoint(frameA, p2), b3_colorYellow, draw.context);
    }
    if joint.enableConeLimit != 0 {
        f32 radius = 0.1f * scale;
        f32 coneRadius = radius * b3Sin(joint.coneAngle);
        f32 coneHeight = radius * b3Cos(joint.coneAngle);
        for i32 index = 0; index < kSliceCount; ++index {
            f32 phi1 = 2.0f * cast(f32, index + 0) / cast(f32, kSliceCount) * 3.14159265359f;
            f32 phi2 = 2.0f * cast(f32, index + 1) / cast(f32, kSliceCount) * 3.14159265359f;
            var vertex1 = b3Vec3{coneRadius * b3Cos(phi1), coneRadius * b3Sin(phi1), coneHeight};
            var vertex2 = b3Vec3{coneRadius * b3Cos(phi2), coneRadius * b3Sin(phi2), coneHeight};
            draw.DrawSegmentFcn(frameA.p, b3TransformWorldPoint(frameA, vertex1), b3_colorCyan, draw.context);
            draw.DrawSegmentFcn(b3TransformWorldPoint(frameA, vertex1), b3TransformWorldPoint(frameA, vertex2), b3_colorCyan, draw.context);
        }
    }
}
// SPDX-FileCopyrightText: 2025 Erin Catto
// SPDX-License-Identifier: MIT

b3HashSet b3CreateSet(i32 capacity) {
    b3HashSet set;
    if capacity > 16 {
        set.capacity = cast(u32, b3RoundUpPowerOf2(capacity));
    } else {
        set.capacity = 16;
    }
    set.count = 0;
    set.items = cast(b3SetItem*, b3Alloc(cast(u64, set.capacity * sizeof(b3SetItem))));
    memset(set.items, 0, cast(u64, set.capacity * sizeof(b3SetItem)));
    return set;
}

void b3DestroySet(b3HashSet* set) {
    b3Free(set.items, cast(u64, set.capacity * sizeof(b3SetItem)));
    set.items = null;
    set.count = 0;
    set.capacity = 0;
}

void b3ClearSet(b3HashSet* set) {
    set.count = 0;
    memset(set.items, 0, cast(u64, set.capacity * sizeof(b3SetItem)));
}

// I need a good hash because the keys are built from pairs of increasing integers.
// A simple hash like hash = (integer1 XOR integer2) has many collisions.
// https://lemire.me/blog/2018/08/15/fast-strongly-universal-64-bit-hashing-everywhere/
// https://preshing.com/20130107/this-hash-set-is-faster-than-a-judy-array/
// todo try: https://www.jandrewrogers.com/2019/02/12/fast-perfect-hashing/
// todo try:
// https://probablydance.com/2018/06/16/fibonacci-hashing-the-optimization-that-the-world-forgot-or-a-better-alternative-to-integer-modulo/
private {
u32 b3KeyHash(u64 key) {
    u64 h = key;
    h ^= h >> 33;
    h *= 0xff51afd7ed558ccd;
    h ^= h >> 33;
    h *= 0xc4ceb9fe1a85ec53;
    h ^= h >> 33;
    return cast(u32, h);
}

i32 b3FindSlot(b3HashSet* set, u64 key, u32 hash) {
    u32 capacity = set.capacity;
    var index = cast(i32, hash & capacity - 1);
    b3SetItem* items = set.items;
    while items[index].hash != 0 && items[index].key != key {
        index = cast(u32, index + 1) & capacity - 1;
    }
    return index;
}

void b3AddKeyHaveCapacity(b3HashSet* set, u64 key, u32 hash) {
    i32 index = b3FindSlot(set, key, hash);
    b3SetItem* items = set.items;
    items[index].key = key;
    items[index].hash = hash;
    set.count += 1;
}

void b3GrowTable(b3HashSet* set) {
    u32 oldCount = set.count;
    ignore oldCount;
    u32 oldCapacity = set.capacity;
    b3SetItem* oldItems = set.items;
    set.count = 0;
    set.capacity = 2 * oldCapacity;
    set.items = cast(b3SetItem*, b3Alloc(cast(u64, set.capacity * sizeof(b3SetItem))));
    memset(set.items, 0, cast(u64, set.capacity * sizeof(b3SetItem)));
    for u32 i = 0; i < oldCapacity; ++i {
        b3SetItem* item = oldItems + i;
        if item.hash == 0 {
            continue;
        }
        b3AddKeyHaveCapacity(set, item.key, item.hash);
    }
    b3Free(oldItems, cast(u64, oldCapacity * sizeof(b3SetItem)));
}
}

bool b3ContainsKey(b3HashSet* set, u64 key) {
    u32 hash = b3KeyHash(key);
    i32 index = b3FindSlot(set, key, hash);
    return set.items[index].key == key;
}

i32 b3GetHashSetBytes(b3HashSet* set) {
    return cast(i32, set.capacity * cast(u32, cast(i32, sizeof(b3SetItem))));
}

bool b3AddKey(b3HashSet* set, u64 key) {
    u32 hash = b3KeyHash(key);
    i32 index = b3FindSlot(set, key, hash);
    if set.items[index].hash != 0 {
        return true;
    }
    if 2 * set.count >= set.capacity {
        b3GrowTable(set);
    }
    b3AddKeyHaveCapacity(set, key, hash);
    return false;
}

// See https://en.wikipedia.org/wiki/Open_addressing
bool b3RemoveKey(b3HashSet* set, u64 key) {
    u32 hash = b3KeyHash(key);
    i32 i = b3FindSlot(set, key, hash);
    b3SetItem* items = set.items;
    if items[i].hash == 0 {
        return false;
    }
    items[i].key = 0;
    items[i].hash = 0;
    set.count -= 1;
    i32 j = i;
    u32 capacity = set.capacity;
    while true {
        j = cast(u32, j + 1) & capacity - 1;
        if items[j].hash == 0 {
            break;
        }
        var k = cast(i32, items[j].hash & capacity - 1);
        if i <= j {
            if i < k && k <= j {
                continue;
            }
        } else {
            if i < k || k <= j {
                continue;
            }
        }
        items[i] = items[j];
        items[j].key = 0;
        items[j].hash = 0;
        i = j;
    }
    return true;
}

// This function is here because ctz.h is included by
// this file but not in bitset.c
i32 b3CountSetBits(b3BitSet* bitSet) {
    i32 popCount = 0;
    u32 blockCount = bitSet.blockCount;
    for u32 i = 0; i < blockCount; ++i {
        popCount += b3PopCount64(bitSet.bits[i]);
    }
    return popCount;
}

// SPDX-FileCopyrightText: 2025 Erin Catto
// SPDX-License-Identifier: MIT
// Required on Linux to expose pthread_setname_np. Must be defined before any
// system header is included.
// transminc: B3_EXTERNAL_PLATFORM hands the whole platform layer (timing,
// sleep/yield, mutex, semaphore, thread) to the embedder. The minc port
// implements these 14 functions over the language's cross-platform
// threading/timing builtins, so one transpile serves every target.
// nothing: b3GetTicks/b3Sleep/b3*Mutex/b3*Semaphore/b3*Thread come from
// the embedder (see ext/box3d_platform.mc).
// djb2 hash, folded 8 bytes per iteration to shorten the dependency chain.
// memcpy lowers to a single load on most targets; on big-endian we byte-swap so
// the hash value is identical across endianness (preserving cross-platform determinism).
// Equivalent to byte-wise djb2 only in spirit; values differ from the original recurrence.
u32 b3Hash(u32 hash, u8* data, i32 count) {
    u32 result = hash;
    i32 i = 0;
    while i + 8 <= count {
        u64 word;
        memcpy(&word, data + i, cast(u64, sizeof(word)));
        result = (result << 5) + result + cast(u32, word);
        result = (result << 5) + result + cast(u32, word >> 32);
        i += 8;
    }
    while i < count {
        result = (result << 5) + result + data[i];
        i++;
    }
    return result;
}
// Indexed by the 3-bit vertex mask
private {
b3TriangleFeature[8] s_triangleFeatures = {
    b3_featureNone, b3_featureVertex1, b3_featureVertex2, b3_featureEdge1, b3_featureVertex3,
    b3_featureEdge3, b3_featureEdge2, b3_featureTriangleFace,
};

b3TriangleFeature b3GetTriangleFeature(b3SimplexCache* cache) {
    var count = cast(i32, cache.count);
    i32 mask = 0;
    for i32 i = 0; i < count; ++i {
        mask |= 1 << cast(i32, cache.indexA[i]);
    }
    return s_triangleFeatures[mask];
}
}

void b3CollideTriangleAndSphere(b3LocalManifold* manifold, i32 capacity, b3Vec3* triangleA, b3Sphere* sphereB) {
    manifold.pointCount = 0;
    if capacity == 0 {
        return;
    }
    b3Vec3 center = sphereB.center;
    b3Vec3 v1 = triangleA[0];
    b3Vec3 v2 = triangleA[1];
    b3Vec3 v3 = triangleA[2];
    b3Plane plane = b3MakePlaneFromPoints(v1, v2, v3);
    f32 offset = b3PlaneSeparation(plane, center);
    if offset < 0.0f {
        return;
    }
    f32 radius = sphereB.radius;
    b3TrianglePoint closest = b3ClosestPointOnTriangle(v1, v2, v3, center);
    f32 squaredDistance = b3DistanceSquared(closest.point, center);
    f32 speculativeDistance = 4.0f * (0.005f * b3GetLengthUnitsPerMeter());
    f32 maxDistance = radius + speculativeDistance;
    if squaredDistance > maxDistance * maxDistance {
        return;
    }
    f32 distance = sqrtf(squaredDistance);
    noinit b3Vec3 normal;
    if distance * distance > 1000.0f * FLT_MIN {
        normal = b3MulSV(1.0f / distance, b3Sub(center, closest.point));
    } else {
        normal = b3Normalize(b3Cross(b3Sub(v2, v1), b3Sub(v3, v1)));
    }
    b3Vec3 contactPoint = b3MulSV(0.5f, b3Add(b3Sub(center, b3MulSV(radius, normal)), closest.point));
    manifold.normal = normal;
    manifold.pointCount = 1;
    manifold.feature = closest.feature;
    manifold.squaredDistance = squaredDistance;
    b3LocalManifoldPoint* mp = manifold.points + 0;
    mp.point = contactPoint;
    mp.separation = distance - radius;
    mp.pair = b3FeaturePair_single;
}

private {
bool b3ClipSegmentToTriangleFace(b3ClipVertex* segment, b3Vec3* points, b3Plane plane) {
    b3Vec3 vertex1 = points[2];
    for i32 i = 0; i < 3; ++i {
        b3Vec3 vertex2 = points[i];
        b3Vec3 tangent = b3Normalize(b3Sub(vertex2, vertex1));
        b3Vec3 binormal = b3Cross(tangent, plane.normal);
        b3Plane clipPlane = b3MakePlaneFromNormalAndPoint(binormal, vertex1);
        i32 vertexCount = 0;
        b3ClipVertex p1 = segment[0];
        b3ClipVertex p2 = segment[1];
        f32 distance1 = b3PlaneSeparation(clipPlane, p1.position);
        f32 distance2 = b3PlaneSeparation(clipPlane, p2.position);
        if distance1 <= 0.0f {
            segment[vertexCount++] = p1;
        }
        if distance2 <= 0.0f {
            segment[vertexCount++] = p2;
        }
        if distance1 * distance2 < 0.0f {
            f32 t = distance1 / (distance1 - distance2);
            segment[vertexCount].position = b3Lerp(p1.position, p2.position, t);
            segment[vertexCount].pair = distance1 > 0.0f ? p1.pair : p2.pair;
            vertexCount++;
        }
        if vertexCount != 2 {
            return false;
        }
        vertex1 = vertex2;
    }
    return true;
}

b3SeparatingAxis b3QueryTriangleFaceAndCapsule(b3Plane plane, b3Capsule* capsule) {
    f32 separation1 = b3PlaneSeparation(plane, capsule.center1);
    f32 separation2 = b3PlaneSeparation(plane, capsule.center2);
    if separation1 < separation2 {
        return b3SeparatingAxis{
            .normal = plane.normal,
            .separation = separation1,
            .indexA = 0,
            .indexB = 0,
        };
    }
    return b3SeparatingAxis{
        .normal = plane.normal,
        .separation = separation2,
        .indexA = 0,
        .indexB = 1,
    };
}

b3SeparatingAxis b3QueryTriangleAndCapsuleEdges(b3Vec3* vertices, b3Plane plane, b3Capsule* capsule) {
    b3Vec3 p1 = capsule.center1;
    b3Vec3 p2 = capsule.center2;
    b3Vec3 capsuleEdge = b3Sub(p2, p1);
    b3Vec3 maxNormal = b3Vec3_zero;
    f32 maxSeparation = -FLT_MAX;
    i32 maxIndex1 = -1;
    i32 maxIndex2 = -1;
    f32 squaredTolerance = 0.005f * 0.005f;
    i32 edgeIndex = 2;
    b3Vec3 v1 = vertices[2];
    for i32 index = 0; index < 3; ++index {
        b3Vec3 v2 = vertices[index];
        b3Vec3 triangleEdge = b3Sub(v2, v1);
        b3Vec3 sideNormal = b3Normalize(b3Cross(triangleEdge, plane.normal));
        f32 a = b3Dot(capsuleEdge, plane.normal);
        f32 b = b3Dot(capsuleEdge, sideNormal);
        if a * a + b * b < squaredTolerance * b3LengthSquared(capsuleEdge) {
            continue;
        }
        noinit b3Vec3 axis;
        if a * b <= 0.0f {
            f32 t = b / (b - a);
            axis = b3Lerp(sideNormal, plane.normal, t);
        } else {
            f32 t = b / (a + b);
            axis = b3Lerp(sideNormal, b3Neg(plane.normal), t);
        }
        axis = b3Normalize(axis);
        f32 separation = b3Dot(axis, b3Sub(p1, v1));
        if separation > maxSeparation {
            maxNormal = axis;
            maxSeparation = separation;
            maxIndex1 = edgeIndex;
            maxIndex2 = 0;
        }
        v1 = v2;
        edgeIndex = index;
    }
    return b3SeparatingAxis{
        .normal = maxNormal,
        .separation = maxSeparation,
        .indexA = maxIndex1,
        .indexB = maxIndex2,
    };
}

void b3BuildTriangleAndCapsuleFaceContact(b3LocalManifold* manifold, b3Vec3* triangle, b3Plane plane, b3Capsule* capsule) {
    noinit b3ClipVertex[2] segment;
    segment[0].position = capsule.center1;
    segment[0].separation = 0.0f;
    segment[0].pair = b3MakeFeaturePair(b3_featureShapeA, 0, b3_featureShapeA, 0);
    segment[1].position = capsule.center2;
    segment[1].separation = 0.0f;
    segment[1].pair = b3MakeFeaturePair(b3_featureShapeA, 1, b3_featureShapeA, 1);
    bool havePoints = b3ClipSegmentToTriangleFace(segment, triangle, plane);
    if havePoints == false {
        return;
    }
    f32 radius = capsule.radius;
    f32 distance1 = b3PlaneSeparation(plane, segment[0].position);
    f32 distance2 = b3PlaneSeparation(plane, segment[1].position);
    f32 speculativeDistance = 4.0f * (0.005f * b3GetLengthUnitsPerMeter());
    if distance1 > speculativeDistance + radius && distance2 > speculativeDistance + radius {
        return;
    }
    b3Vec3 point1 = b3MulSub(segment[0].position, 0.5f * (distance1 + capsule.radius), plane.normal);
    b3Vec3 point2 = b3MulSub(segment[1].position, 0.5f * (distance2 + capsule.radius), plane.normal);
    manifold.normal = plane.normal;
    manifold.feature = b3_featureTriangleFace;
    manifold.pointCount = 2;
    b3LocalManifoldPoint* pt = manifold.points + 0;
    pt.point = point1;
    pt.separation = distance1 - capsule.radius;
    pt.pair = segment[0].pair;
    pt = manifold.points + 1;
    pt.point = point2;
    pt.separation = distance2 - capsule.radius;
    pt.pair = segment[1].pair;
}

void b3BuildTriangleAndCapsuleEdgeContact(b3LocalManifold* manifold, b3Vec3* triangle, b3Plane plane, b3Capsule* capsule, b3SeparatingAxis query) {
    b3Vec3 p1 = capsule.center1;
    b3Vec3 p2 = capsule.center2;
    b3Vec3 capsuleEdge = b3Sub(p2, p1);
    b3Vec3* vs = triangle;
    b3Vec3 v1 = vs[query.indexA];
    b3Vec3 v2 = vs[(query.indexA + 1) % 3];
    b3Vec3 triangleEdge = b3Sub(v2, v1);
    b3Vec3 sideNormal = b3Normalize(b3Cross(triangleEdge, plane.normal));
    f32 a = b3Dot(capsuleEdge, plane.normal);
    f32 b = b3Dot(capsuleEdge, sideNormal);
    f32 squaredTolerance = 0.005f * 0.005f;
    if a * a + b * b < squaredTolerance * b3LengthSquared(capsuleEdge) {
        return;
    }
    b3Vec3 normal = query.normal;
    b3SegmentDistanceResult result = b3LineDistance(v1, triangleEdge, p1, capsuleEdge);
    if result.fraction1 < 0.0f || 1.0f < result.fraction1 || result.fraction2 < 0.0f || 1.0f < result.fraction2 {
        return;
    }
    b3Vec3 point = b3Lerp(b3MulSub(result.point1, capsule.radius, normal), result.point2, 0.5f);
    f32 separation = b3Dot(normal, b3Sub(p1, v1));
    manifold.normal = normal;
    manifold.pointCount = 1;
    b3TriangleFeature[3] edgesFeatures = {b3_featureEdge1, b3_featureEdge2, b3_featureEdge3};
    manifold.feature = edgesFeatures[query.indexA];
    b3LocalManifoldPoint* pt = manifold.points + 0;
    pt.point = point;
    pt.separation = separation - capsule.radius;
    pt.pair = b3MakeFeaturePair(b3_featureShapeA, query.indexA, b3_featureShapeB, query.indexB);
}
}

void b3CollideTriangleAndCapsule(b3LocalManifold* manifold, i32 capacity, b3Vec3* triangleA, b3Capsule* capsuleB, b3SimplexCache* cache) {
    manifold.pointCount = 0;
    if capacity < 2 {
        return;
    }
    b3Vec3 v1 = triangleA[0];
    b3Vec3 v2 = triangleA[1];
    b3Vec3 v3 = triangleA[2];
    b3Plane plane = b3MakePlaneFromPoints(v1, v2, v3);
    b3Vec3 capsuleCenter = b3Lerp(capsuleB.center1, capsuleB.center2, 0.5f);
    f32 offset = b3PlaneSeparation(plane, capsuleCenter);
    if offset < 0.0f {
        return;
    }
    noinit b3DistanceInput distanceInput;
    distanceInput.proxyA = b3ShapeProxy{triangleA, 3, 0.0f};
    distanceInput.proxyB = b3ShapeProxy{&capsuleB.center1, 2, 0.0f};
    distanceInput.transform = b3Transform_identity;
    distanceInput.useRadii = false;
    b3DistanceOutput distanceOutput = b3ShapeDistance(&distanceInput, cache, null, 0);
    f32 radius = capsuleB.radius;
    if distanceOutput.distance > radius + 4.0f * (0.005f * b3GetLengthUnitsPerMeter()) {
        return;
    }
    if distanceOutput.distance > 100.0f * FLT_EPSILON {
        b3Vec3 delta = b3Normalize(b3Sub(distanceOutput.pointB, distanceOutput.pointA));
        f32 kTolerance = 0.2f;
        f32 cosAngle = b3AbsFloat(b3Dot(plane.normal, delta));
        if cosAngle > kTolerance {
            noinit b3ClipVertex[2] segment;
            segment[0].position = capsuleB.center1;
            segment[0].separation = 0.0f;
            segment[0].pair = b3MakeFeaturePair(b3_featureShapeA, 0, b3_featureShapeA, 0);
            segment[1].position = capsuleB.center2;
            segment[1].separation = 0.0f;
            segment[1].pair = b3MakeFeaturePair(b3_featureShapeA, 1, b3_featureShapeA, 1);
            bool havePoints = b3ClipSegmentToTriangleFace(segment, triangleA, plane);
            if havePoints == true {
                f32 distance1 = b3PlaneSeparation(plane, segment[0].position);
                f32 distance2 = b3PlaneSeparation(plane, segment[1].position);
                b3Vec3 normal = plane.normal;
                b3Vec3 point1 = b3MulSub(segment[0].position, 0.5f * (radius + distance1), normal);
                b3Vec3 point2 = b3MulSub(segment[1].position, 0.5f * (radius + distance2), normal);
                manifold.normal = normal;
                manifold.feature = b3_featureTriangleFace;
                manifold.pointCount = 2;
                b3LocalManifoldPoint* mp = manifold.points + 0;
                mp.point = point1;
                mp.separation = distance1 - radius;
                mp.pair = segment[0].pair;
                mp = manifold.points + 1;
                mp.point = point2;
                mp.separation = distance2 - radius;
                mp.pair = segment[1].pair;
                return;
            }
        }
        b3Vec3 point = b3MulSV(0.5f, b3Add(b3Sub(distanceOutput.pointA, b3MulSV(radius, delta)), distanceOutput.pointB));
        manifold.normal = delta;
        manifold.pointCount = 1;
        manifold.feature = b3GetTriangleFeature(cache);
        b3LocalManifoldPoint* mp = manifold.points + 0;
        mp.point = point;
        mp.separation = distanceOutput.distance - radius;
        mp.pair = b3FeaturePair_single;
        return;
    }
    b3SeparatingAxis faceQuery = b3QueryTriangleFaceAndCapsule(plane, capsuleB);
    if faceQuery.separation > radius {
        return;
    }
    b3SeparatingAxis edgeQuery = b3QueryTriangleAndCapsuleEdges(triangleA, plane, capsuleB);
    if edgeQuery.separation > radius {
        return;
    }
    f32 faceSeparation = faceQuery.separation - radius;
    b3BuildTriangleAndCapsuleFaceContact(manifold, triangleA, plane, capsuleB);
    if manifold.pointCount == 2 {
        faceSeparation = b3MinFloat(manifold.points[0].separation, manifold.points[1].separation);
    }
    f32 kRelEdgeTolerance = 0.5f;
    f32 kAbsTolerance = 1.0f * (0.005f * b3GetLengthUnitsPerMeter());
    f32 edgeSeparation = edgeQuery.separation - radius;
    if manifold.pointCount == 0 || edgeSeparation > kRelEdgeTolerance * faceSeparation + kAbsTolerance {
        b3BuildTriangleAndCapsuleEdgeContact(manifold, triangleA, plane, capsuleB, edgeQuery);
    }
}

private {
i32 b3GetTriangleSupport(b3Vec3* points, b3Vec3 direction) {
    i32 index = 0;
    f32 distance = b3Dot(points[0], direction);
    f32 d = b3Dot(points[1], direction);
    if d > distance {
        distance = d;
        index = 1;
    }
    d = b3Dot(points[2], direction);
    if d > distance {
        return 2;
    }
    return index;
}

b3SeparatingAxis b3QueryTriangleFace(b3TriangleData* triangle, b3HullData* hull) {
    b3Vec3* hullPoints = b3GetHullPoints(hull);
    b3Plane plane = triangle.plane;
    b3Vec3 normal = b3Neg(plane.normal);
    i32 vertexIndex = b3FindHullSupportVertex(hull, normal);
    b3Vec3 support = hullPoints[vertexIndex];
    f32 separation = b3PlaneSeparation(plane, support);
    return b3SeparatingAxis{
        .normal = plane.normal,
        .separation = separation,
        .indexA = 0,
        .indexB = vertexIndex,
        .type = b3_faceAxisA,
    };
}

b3SeparatingAxis b3QueryHullFace(b3TriangleData* triangle, b3HullData* hull) {
    b3Plane* hullPlanes = b3GetHullPlanes(hull);
    i32 faceCount = hull.faceCount;
    b3Vec3[3] trianglePoints = {triangle.v1, triangle.v2, triangle.v3};
    b3Vec3 maxNormal = b3Vec3_zero;
    f32 maxFaceSeparation = -INFINITY;
    i32 maxFaceIndex = -1;
    i32 maxVertexIndex = -1;
    for i32 faceIndex = 0; faceIndex < faceCount; ++faceIndex {
        b3Plane plane = hullPlanes[faceIndex];
        i32 vertexIndex = b3GetTriangleSupport(trianglePoints, b3Neg(plane.normal));
        b3Vec3 support = trianglePoints[vertexIndex];
        f32 separation = b3PlaneSeparation(plane, support);
        if separation > maxFaceSeparation {
            maxNormal = plane.normal;
            maxFaceSeparation = separation;
            maxFaceIndex = faceIndex;
            maxVertexIndex = vertexIndex;
        }
    }
    return b3SeparatingAxis{
        .normal = b3Neg(maxNormal),
        .separation = maxFaceSeparation,
        .indexA = maxVertexIndex,
        .indexB = maxFaceIndex,
        .type = b3_faceAxisB,
    };
}

// A: hull, B: triangle
b3SeparatingAxis b3QueryTriangleAndHullEdges(b3TriangleData* triangle, b3HullData* hull) {
    var result = b3SeparatingAxis{
        .normal = b3Vec3_zero,
        .separation = -INFINITY,
        .indexA = -1,
        .indexB = -1,
        .type = b3_edgePairAxis,
    };
    b3Vec3[3] trianglePoints = {triangle.v1, triangle.v2, triangle.v3};
    b3Vec3[3] triangleEdges = {triangle.e1, triangle.e2, triangle.e3};
    i32 triangleFlags = triangle.flags;
    ignore triangleFlags;
    b3Vec3 triNormal = triangle.plane.normal;
    b3HullHalfEdge* hullEdges = b3GetHullEdges(hull);
    b3Vec3* hullPoints = b3GetHullPoints(hull);
    b3Plane* hullPlanes = b3GetHullPlanes(hull);
    i32 edgeCount = hull.edgeCount;
    f32 squaredTolerance = 0.005f * 0.005f;
    for i32 i = 0; i < edgeCount; i += 2 {
        b3HullHalfEdge* edge = hullEdges + i;
        b3HullHalfEdge* twin = hullEdges + i + 1;
        b3Vec3 hullPoint = hullPoints[edge.origin];
        b3Vec3 hullEdge = b3Sub(hullPoints[twin.origin], hullPoint);
        b3Vec3 hullNormal1 = hullPlanes[edge.face].normal;
        b3Vec3 hullNormal2 = hullPlanes[twin.face].normal;
        for i32 j = 0; j < 3; ++j {
            b3Vec3 triEdge = triangleEdges[j];
            f32 cab = b3Dot(hullNormal1, triEdge);
            f32 dab = b3Dot(hullNormal2, triEdge);
            f32 bcd = b3Dot(triNormal, hullEdge);
            if cab * dab >= 0.0f || cab * bcd <= 0.0f {
                continue;
            }
            if b3MaxFloat(cab * cab, dab * dab) < squaredTolerance * b3LengthSquared(triEdge) {
                continue;
            }
            f32 t = cab / (cab - dab);
            b3Vec3 axis = b3Lerp(hullNormal1, hullNormal2, t);
            axis = b3Normalize(axis);
            f32 separation = b3Dot(axis, b3Sub(trianglePoints[j], hullPoint));
            if separation > result.separation {
                result.normal = b3Neg(axis);
                result.separation = separation;
                result.indexA = j;
                result.indexB = i;
            }
        }
    }
    return result;
}

f32 b3CollideHullFace(b3LocalManifold* manifold, i32 pointCapacity, b3TriangleData* triangle, b3HullData* hull, b3SeparatingAxis query, b3SATCache* cache, bool enableSpeculative) {
    manifold.pointCount = 0;
    b3HullFace* hullFaces = b3GetHullFaces(hull);
    b3HullHalfEdge* hullEdges = b3GetHullEdges(hull);
    b3Plane* hullPlanes = b3GetHullPlanes(hull);
    b3Vec3* hullPoints = b3GetHullPoints(hull);
    b3Plane refPlane = hullPlanes[query.indexB];
    noinit b3ClipVertex[64] buffer1;
    noinit b3ClipVertex[64] buffer2;
    b3Vec3 v1 = triangle.v1;
    b3Vec3 v2 = triangle.v2;
    b3Vec3 v3 = triangle.v3;
    buffer1[0].position = v1;
    buffer1[0].separation = b3PlaneSeparation(refPlane, v1);
    buffer1[0].pair = b3MakeFeaturePair(b3_featureShapeB, 2, b3_featureShapeB, 0);
    buffer1[1].position = v2;
    buffer1[1].separation = b3PlaneSeparation(refPlane, v2);
    buffer1[1].pair = b3MakeFeaturePair(b3_featureShapeB, 0, b3_featureShapeB, 1);
    buffer1[2].position = v3;
    buffer1[2].separation = b3PlaneSeparation(refPlane, v3);
    buffer1[2].pair = b3MakeFeaturePair(b3_featureShapeB, 1, b3_featureShapeB, 2);
    i32 pointCount = 3;
    b3ClipVertex* input = buffer1;
    b3ClipVertex* output = buffer2;
    b3HullFace* face = hullFaces + query.indexB;
    var edgeIndex = cast(i32, face.edge);
    while true {
        b3HullHalfEdge* edge = hullEdges + edgeIndex;
        var nextEdgeIndex = cast(i32, edge.next);
        b3HullHalfEdge* next = hullEdges + nextEdgeIndex;
        b3Vec3 vertex1 = hullPoints[edge.origin];
        b3Vec3 vertex2 = hullPoints[next.origin];
        b3Vec3 tangent = b3Normalize(b3Sub(vertex2, vertex1));
        b3Vec3 binormal = b3Cross(tangent, refPlane.normal);
        b3Plane clipPlane = b3MakePlaneFromNormalAndPoint(binormal, vertex1);
        pointCount = b3ClipPolygon(output, input, pointCount, clipPlane, edgeIndex, refPlane);
        if pointCount < 3 {
            *cache = b3SATCache{};
            return query.separation;
        }
        while true {
            noinit u8[sizeof(output)] B3_SWAP_TEMP;
            memcpy(B3_SWAP_TEMP, &output, cast(u64, sizeof(output)));
            memcpy(&output, &input, cast(u64, sizeof(output)));
            memcpy(&input, B3_SWAP_TEMP, cast(u64, sizeof(output)));
            if !(0 != 0) { break; }
        }
        edgeIndex = nextEdgeIndex;
        if !(edgeIndex != cast(i32, face.edge)) { break; }
    }
    pointCount = b3MinInt(pointCount, pointCapacity);
    f32 minSeparation = FLT_MAX;
    i32 finalPointCount = 0;
    for i32 i = 0; i < pointCount; ++i {
        b3ClipVertex* clipPoint = input + i;
        minSeparation = b3MinFloat(minSeparation, clipPoint.separation);
        if enableSpeculative == false && clipPoint.separation > 0.0f {
            continue;
        }
        b3Vec3 point = b3MulSub(clipPoint.position, clipPoint.separation, refPlane.normal);
        b3LocalManifoldPoint* pt = manifold.points + finalPointCount;
        pt.point = point;
        pt.separation = clipPoint.separation;
        pt.pair = b3FlipPair(clipPoint.pair);
        finalPointCount += 1;
    }
    f32 speculativeDistance = enableSpeculative != 0 ? 4.0f * (0.005f * b3GetLengthUnitsPerMeter()) : 0.0f;
    if minSeparation > speculativeDistance {
        manifold.pointCount = 0;
        *cache = b3SATCache{};
        return minSeparation;
    }
    manifold.pointCount = finalPointCount;
    manifold.normal = b3Neg(refPlane.normal);
    manifold.feature = b3_featureHullFace;
    cache.separation = minSeparation;
    cache.type = cast(u8, b3_faceAxisB);
    cache.indexA = cast(u8, query.indexA);
    cache.indexB = cast(u8, query.indexB);
    return minSeparation;
}

f32 b3CollideTriangleFace(b3LocalManifold* manifold, i32 pointCapacity, b3TriangleData* triangle, b3HullData* hull, b3SeparatingAxis query, b3SATCache* cache, bool enableSpeculative) {
    b3HullFace* hullFaces = b3GetHullFaces(hull);
    b3HullHalfEdge* hullEdges = b3GetHullEdges(hull);
    b3Vec3* hullPoints = b3GetHullPoints(hull);
    b3Plane refPlane = triangle.plane;
    i32 incFace = b3FindIncidentFace(hull, refPlane.normal, query.indexB);
    noinit b3ClipVertex[128] buffer1;
    noinit b3ClipVertex[128] buffer2;
    i32 pointCount = 0;
    b3HullFace* face = hullFaces + incFace;
    var hullEdgeIndex = cast(i32, face.edge);
    while true {
        b3HullHalfEdge* edge = hullEdges + hullEdgeIndex;
        var nextEdgeIndex = cast(i32, edge.next);
        b3HullHalfEdge* next = hullEdges + nextEdgeIndex;
        b3Vec3 hullPoint = hullPoints[next.origin];
        buffer1[pointCount].position = hullPoint;
        buffer1[pointCount].separation = b3PlaneSeparation(refPlane, hullPoint);
        buffer1[pointCount].pair = b3MakeFeaturePair(b3_featureShapeB, hullEdgeIndex, b3_featureShapeB, nextEdgeIndex);
        pointCount += 1;
        hullEdgeIndex = nextEdgeIndex;
        if !(hullEdgeIndex != cast(i32, face.edge) && pointCount < 2 * 64) { break; }
    }
    b3ClipVertex* input = buffer1;
    b3ClipVertex* output = buffer2;
    b3Vec3[3] trianglePoints = {triangle.v1, triangle.v2, triangle.v3};
    b3Vec3[3] triangleEdges = {triangle.e1, triangle.e2, triangle.e3};
    for i32 i = 0; i < 3 && pointCount > 0; ++i {
        b3Vec3 sideNormal = b3Cross(triangleEdges[i], refPlane.normal);
        sideNormal = b3Normalize(sideNormal);
        b3Plane clipPlane = b3MakePlaneFromNormalAndPoint(sideNormal, trianglePoints[i]);
        pointCount = b3ClipPolygon(output, input, pointCount, clipPlane, i, refPlane);
        while true {
            noinit u8[sizeof(output)] B3_SWAP_TEMP;
            memcpy(B3_SWAP_TEMP, &output, cast(u64, sizeof(output)));
            memcpy(&output, &input, cast(u64, sizeof(output)));
            memcpy(&input, B3_SWAP_TEMP, cast(u64, sizeof(output)));
            if !(0 != 0) { break; }
        }
    }
    if pointCount == 0 {
        *cache = b3SATCache{};
        return FLT_MAX;
    }
    pointCount = b3MinInt(pointCount, pointCapacity);
    f32 minSeparation = FLT_MAX;
    i32 finalPointCount = 0;
    for i32 i = 0; i < pointCount; ++i {
        b3ClipVertex* clipPoint = input + i;
        minSeparation = b3MinFloat(minSeparation, clipPoint.separation);
        if enableSpeculative == false && clipPoint.separation > 0.0f {
            continue;
        }
        b3Vec3 point = clipPoint.position;
        b3LocalManifoldPoint* pt = manifold.points + finalPointCount;
        pt.point = point;
        pt.separation = clipPoint.separation;
        pt.pair = clipPoint.pair;
        finalPointCount += 1;
    }
    f32 speculativeDistance = enableSpeculative != 0 ? 4.0f * (0.005f * b3GetLengthUnitsPerMeter()) : 0.0f;
    if minSeparation >= speculativeDistance {
        *cache = b3SATCache{};
        return minSeparation;
    }
    manifold.pointCount = finalPointCount;
    manifold.normal = refPlane.normal;
    manifold.feature = b3_featureTriangleFace;
    cache.separation = minSeparation;
    cache.type = cast(u8, b3_faceAxisA);
    cache.indexA = cast(u8, query.indexA);
    cache.indexB = cast(u8, query.indexB);
    return minSeparation;
}

void b3CollideTriangleAndHullEdges(b3LocalManifold* manifold, i32 capacity, b3Vec3 trianglePoint, b3Vec3 triangleEdge, b3HullData* hull, b3SeparatingAxis query, b3SATCache* cache) {
    b3Vec3 pA = trianglePoint;
    b3Vec3 eA = triangleEdge;
    b3HullHalfEdge* edgesB = b3GetHullEdges(hull);
    b3Vec3* pointsB = b3GetHullPoints(hull);
    b3HullHalfEdge* edgeB = edgesB + query.indexB;
    b3HullHalfEdge* twinB = edgesB + edgeB.twin;
    b3Vec3 pB = pointsB[edgeB.origin];
    b3Vec3 qB = pointsB[twinB.origin];
    b3Vec3 eB = b3Sub(qB, pB);
    b3SegmentDistanceResult result = b3LineDistance(pA, eA, pB, eB);
    if capacity == 0 || result.fraction1 < 0.0f || 1.0f < result.fraction1 || result.fraction2 < 0.0f || 1.0f < result.fraction2 {
        *cache = b3SATCache{};
        return;
    }
    f32 separation = b3Dot(query.normal, b3Sub(pB, pA));
    b3Vec3 point = b3MulSV(0.5f, b3Add(result.point1, result.point2));
    b3LocalManifoldPoint* pt = manifold.points + 0;
    pt.point = point;
    pt.separation = separation;
    pt.pair = b3MakeFeaturePair(b3_featureShapeA, query.indexA, b3_featureShapeB, query.indexB);
    cache.separation = separation;
    cache.type = cast(u8, b3_edgePairAxis);
    cache.indexA = cast(u8, query.indexA);
    cache.indexB = cast(u8, query.indexB);
    manifold.normal = query.normal;
    manifold.pointCount = 1;
    b3TriangleFeature[3] edgesFeatures = {b3_featureEdge1, b3_featureEdge2, b3_featureEdge3};
    manifold.feature = edgesFeatures[query.indexA];
}
}
b3AtomicInt b3_triangleConvexCalls;
b3AtomicInt b3_triangleCacheHits;

// Triangle is in the local space of the hull for efficiency.
void b3CollideTriangleAndHull(b3LocalManifold* manifold, i32 capacity, b3Vec3 v1, b3Vec3 v2, b3Vec3 v3, i32 triangleFlags, b3HullData* hullB, b3SATCache* cache, bool enableSpeculative) {
    manifold.pointCount = 0;
    manifold.feature = b3_featureNone;
    if capacity < 4 {
        return;
    }
    b3Plane trianglePlane = b3MakePlaneFromPoints(v1, v2, v3);
    f32 linearSlop = 0.005f * b3GetLengthUnitsPerMeter();
    f32 offset = b3PlaneSeparation(trianglePlane, hullB.center);
    if cast(i32, cache.type) == b3_backsideAxis {
        if b3AbsFloat(cache.separation - offset) < linearSlop {
            return;
        }
        cache.type = cast(u8, b3_invalidAxis);
    }
    if offset < -linearSlop {
        cache.type = cast(u8, b3_backsideAxis);
        cache.separation = offset;
        return;
    }
    b3Vec3[3] trianglePoints = {v1, v2, v3};
    b3Vec3[3] triangleEdges = {b3Sub(v2, v1), b3Sub(v3, v2), b3Sub(v1, v3)};
    var triangle = b3TriangleData{
        .v1 = v1,
        .v2 = v2,
        .v3 = v3,
        .e1 = triangleEdges[0],
        .e2 = triangleEdges[1],
        .e3 = triangleEdges[2],
        .plane = trianglePlane,
        .flags = triangleFlags,
    };
    b3HullHalfEdge* edges = b3GetHullEdges(hullB);
    b3Plane* hullPlanes = b3GetHullPlanes(hullB);
    b3Vec3* hullPoints = b3GetHullPoints(hullB);
    f32 speculativeDistance = enableSpeculative != 0 ? 4.0f * (0.005f * b3GetLengthUnitsPerMeter()) : 0.0f;
    cache.hit = 1;
    switch cache.type {
        case b3_faceAxisA: {
            {
                i32 vertexIndex = b3FindHullSupportVertex(hullB, b3Neg(trianglePlane.normal));
                b3Vec3 support = hullPoints[vertexIndex];
                f32 separation = b3PlaneSeparation(trianglePlane, support);
                if separation > speculativeDistance {
                    return;
                }
                noinit b3SeparatingAxis faceQuery;
                faceQuery.normal = trianglePlane.normal;
                faceQuery.separation = separation;
                faceQuery.indexA = cast(i32, cache.indexA);
                faceQuery.indexB = vertexIndex;
                faceQuery.type = b3_faceAxisA;
                b3SATCache localCache = *cache;
                f32 clippedSeparation = b3CollideTriangleFace(manifold, capacity, &triangle, hullB, faceQuery, &localCache, enableSpeculative);
                if manifold.pointCount > 0 && b3AbsFloat(cache.separation - clippedSeparation) < linearSlop {
                    return;
                }
                manifold.pointCount = 0;
                *cache = b3SATCache{};
            }
        }
        case b3_faceAxisB: {
            {
                b3Plane plane = hullPlanes[cache.indexB];
                i32 vertexIndex = 0;
                f32 distance = -b3Dot(v1, plane.normal);
                for i32 i = 1; i < 3; ++i {
                    f32 d = -b3Dot(trianglePoints[i], plane.normal);
                    if d > distance {
                        distance = d;
                        vertexIndex = i;
                    }
                }
                b3Vec3 support = trianglePoints[vertexIndex];
                f32 separation = b3PlaneSeparation(plane, support);
                if separation > speculativeDistance {
                    return;
                }
                bool isDeep = separation < -2.0f * linearSlop;
                if isDeep == false {
                    noinit b3SeparatingAxis faceQuery;
                    faceQuery.normal = b3Neg(plane.normal);
                    faceQuery.separation = separation;
                    faceQuery.indexA = vertexIndex;
                    faceQuery.indexB = cast(i32, cache.indexB);
                    faceQuery.type = b3_faceAxisB;
                    b3SATCache localCache = *cache;
                    f32 clippedSeparation = b3CollideHullFace(manifold, capacity, &triangle, hullB, faceQuery, &localCache, enableSpeculative);
                    if manifold.pointCount > 0 && b3AbsFloat(cache.separation - clippedSeparation) < linearSlop {
                        return;
                    }
                }
                manifold.pointCount = 0;
                *cache = b3SATCache{};
            }
        }
        case b3_edgePairAxis: {
            {
                var indexA = cast(i32, cache.indexA);
                b3Vec3 triPoint = trianglePoints[indexA];
                b3Vec3 triEdge = triangleEdges[indexA];
                var indexB = cast(i32, cache.indexB);
                b3HullHalfEdge* edge2 = edges + indexB;
                b3HullHalfEdge* twin2 = edges + indexB + 1;
                b3Vec3 hullPoint = hullPoints[edge2.origin];
                b3Vec3 hullEdge = b3Sub(hullPoints[twin2.origin], hullPoint);
                b3Vec3 hullNormal1 = hullPlanes[edge2.face].normal;
                b3Vec3 hullNormal2 = hullPlanes[twin2.face].normal;
                f32 cab = b3Dot(hullNormal1, triEdge);
                f32 dab = b3Dot(hullNormal2, triEdge);
                f32 bcd = b3Dot(trianglePlane.normal, hullEdge);
                if cab * dab < 0.0f && cab * bcd > 0.0f {
                    f32 squaredTolerance = 0.005f * 0.005f;
                    if b3MaxFloat(cab * cab, dab * dab) >= squaredTolerance * b3LengthSquared(triEdge) {
                        f32 t = cab / (cab - dab);
                        b3Vec3 axis = b3Lerp(hullNormal1, hullNormal2, t);
                        axis = b3Normalize(axis);
                        f32 separation = b3Dot(axis, b3Sub(triPoint, hullPoint));
                        if separation > speculativeDistance {
                            return;
                        }
                        if b3AbsFloat(cache.separation - separation) < linearSlop {
                            noinit b3SeparatingAxis edgeQuery;
                            edgeQuery.normal = b3Neg(axis);
                            edgeQuery.indexA = indexA;
                            edgeQuery.indexB = indexB;
                            edgeQuery.separation = separation;
                            edgeQuery.type = b3_edgePairAxis;
                            b3SATCache localCache = *cache;
                            b3CollideTriangleAndHullEdges(manifold, capacity, triPoint, triEdge, hullB, edgeQuery, &localCache);
                            if manifold.pointCount > 0 {
                                return;
                            }
                        }
                    }
                }
                *cache = b3SATCache{};
            }
        }
        case b3_manualFaceAxisA: {
            {
                b3SeparatingAxis query = b3QueryTriangleFace(&triangle, hullB);
                b3CollideTriangleFace(manifold, capacity, &triangle, hullB, query, cache, enableSpeculative);
                return;
            }
        }
        case b3_manualFaceAxisB: {
            {
                b3SeparatingAxis query = b3QueryHullFace(&triangle, hullB);
                b3CollideHullFace(manifold, capacity, &triangle, hullB, query, cache, enableSpeculative);
                return;
            }
        }
        case b3_manualEdgePairAxis: {
            {
                b3SeparatingAxis query = b3QueryTriangleAndHullEdges(&triangle, hullB);
                if query.indexA != -1 {
                    b3Vec3 trianglePoint = trianglePoints[query.indexA];
                    b3Vec3 triangleEdge = triangleEdges[query.indexA];
                    b3CollideTriangleAndHullEdges(manifold, capacity, trianglePoint, triangleEdge, hullB, query, cache);
                }
                return;
            }
        }
        default: {
        }
    }
    cache.hit = 0;
    b3SeparatingAxis faceQueryA = b3QueryTriangleFace(&triangle, hullB);
    if faceQueryA.separation > speculativeDistance {
        cache.separation = faceQueryA.separation;
        cache.type = cast(u8, b3_faceAxisA);
        cache.indexA = cast(u8, faceQueryA.indexA);
        cache.indexB = cast(u8, faceQueryA.indexB);
        return;
    }
    b3SeparatingAxis faceQueryB = b3QueryHullFace(&triangle, hullB);
    if faceQueryB.separation > speculativeDistance {
        cache.separation = faceQueryB.separation;
        cache.type = cast(u8, b3_faceAxisB);
        cache.indexA = cast(u8, faceQueryB.indexA);
        cache.indexB = cast(u8, faceQueryB.indexB);
        return;
    }
    b3SeparatingAxis edgeQuery = b3QueryTriangleAndHullEdges(&triangle, hullB);
    if edgeQuery.separation > speculativeDistance {
        cache.separation = edgeQuery.separation;
        cache.type = cast(u8, b3_edgePairAxis);
        cache.indexA = cast(u8, edgeQuery.indexA);
        cache.indexB = cast(u8, edgeQuery.indexB);
        return;
    }
    f32 clipSeparation;
    bool pushingDown = b3Dot(faceQueryB.normal, trianglePlane.normal) < -0.25f;
    if faceQueryB.separation >= faceQueryA.separation && pushingDown == false {
        clipSeparation = b3CollideHullFace(manifold, capacity, &triangle, hullB, faceQueryB, cache, enableSpeculative);
    } else {
        clipSeparation = b3CollideTriangleFace(manifold, capacity, &triangle, hullB, faceQueryA, cache, enableSpeculative);
    }
    if edgeQuery.indexA != -1 {
        f32 maxFaceSeparation = b3MaxFloat(faceQueryA.separation, faceQueryB.separation);
        if manifold.pointCount == 0 && edgeQuery.separation > maxFaceSeparation || manifold.pointCount == 1 && edgeQuery.separation > clipSeparation + linearSlop {
            b3Vec3 trianglePoint = trianglePoints[edgeQuery.indexA];
            b3Vec3 triangleEdge = triangleEdges[edgeQuery.indexA];
            manifold.pointCount = 0;
            b3CollideTriangleAndHullEdges(manifold, capacity, trianglePoint, triangleEdge, hullB, edgeQuery, cache);
        }
    }
    if manifold.pointCount == 0 {
        b3Vec3[3] triangleB = {v1, v2, v3};
        b3DistanceInput input;
        input.proxyA = b3ShapeProxy{.points = triangleB, .count = 3, .radius = 0.0f};
        input.proxyB = b3ShapeProxy{
            .points = hullPoints,
            .count = hullB.vertexCount,
            .radius = 0.0f,
        };
        input.transform = b3Transform_identity;
        input.useRadii = false;
        b3SimplexCache simplexCache;
        b3DistanceOutput output = b3ShapeDistance(&input, &simplexCache, null, 0);
        if output.distance > 0.0f {
            manifold.pointCount = 1;
            manifold.feature = b3GetTriangleFeature(&simplexCache);
            manifold.normal = output.normal;
            manifold.points[0].point = output.pointB;
            manifold.points[0].separation = output.distance;
            manifold.points[0].pair = b3FeaturePair_single;
        }
        *cache = b3SATCache{};
    }
}

// SPDX-FileCopyrightText: 2025 Erin Catto
// SPDX-License-Identifier: MIT
b3WorldDef b3DefaultWorldDef() {
    f32 lengthUnits = b3GetLengthUnitsPerMeter();
    b3WorldDef def;
    def.gravity.x = 0.0f;
    def.gravity.y = -10.0f;
    def.hitEventThreshold = 1.0f * lengthUnits;
    def.restitutionThreshold = 1.0f * lengthUnits;
    def.contactSpeed = 3.0f * lengthUnits;
    def.contactHertz = 30.0f;
    def.contactDampingRatio = 10.0f;
    def.maximumLinearSpeed = 400.0f * lengthUnits;
    def.enableSleep = true;
    def.enableContinuous = true;
    def.internalValue = 1152023;
    return def;
}

b3BodyDef b3DefaultBodyDef() {
    b3BodyDef def;
    def.type = b3_staticBody;
    def.rotation = b3Quat_identity;
    def.sleepThreshold = 0.05f * b3GetLengthUnitsPerMeter();
    def.gravityScale = 1.0f;
    def.enableSleep = true;
    def.isAwake = true;
    def.isEnabled = true;
    def.enableContactRecycling = true;
    def.internalValue = 1152023;
    return def;
}

b3Filter b3DefaultFilter() {
    var filter = b3Filter{-1, -1, 0};
    return filter;
}

b3QueryFilter b3DefaultQueryFilter() {
    var filter = b3QueryFilter{-1, -1, 0, null};
    return filter;
}

b3SurfaceMaterial b3DefaultSurfaceMaterial() {
    b3SurfaceMaterial surfaceMaterial;
    surfaceMaterial.friction = 0.6f;
    return surfaceMaterial;
}

b3ShapeDef b3DefaultShapeDef() {
    f32 lengthUnits = b3GetLengthUnitsPerMeter();
    b3ShapeDef def;
    def.baseMaterial = b3DefaultSurfaceMaterial();
    def.density = 1000.0f / (lengthUnits * lengthUnits * lengthUnits);
    def.explosionScale = 1.0f;
    def.filter = b3DefaultFilter();
    def.updateBodyMass = true;
    def.invokeContactCreation = true;
    def.enableSpeculativeContact = true;
    def.internalValue = 1152023;
    return def;
}

