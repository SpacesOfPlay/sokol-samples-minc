void b3RecDispatch_StateHash(b3RecArgs_StateHash* a, b3RecReader* rdr) {
    b3World* world = b3GetWorldFromId(rdr.replayWorldId);
    u64 computed = b3HashWorldState(world);
    if computed != a.hash {
        printf("b3ReplayFile: StateHash mismatch (recorded=0x%llx, computed=0x%llx)\n", a.hash, computed);
        rdr.diverged = true;
    }
}

void b3RecDispatch_RecordingBounds(b3RecArgs_RecordingBounds* a, b3RecReader* rdr) {
    if rdr.owner != null {
        rdr.owner.bounds = a.bounds;
    }
}
}

// Grow the reader's hit scratch to at least n entries, preserving contents. n is bounded by the file
// size since every recorded hit consumes at least one byte, so a corrupt count fails the read.
void b3RecEnsureHits(b3RecReader* rdr, i32 n) {
    b3RecReserveScratch(rdr, cast(void**, &rdr.hits), &rdr.hitCap, n, cast(i32, sizeof(b3RecRecordedHit)));
}

// Bitwise float compare so the determinism check is exact, not within a tolerance.
private {
bool b3RecF32Differs(f32 a, f32 b) {
    u32 ua;
    u32 ub;
    memcpy(&ua, &a, cast(u64, 4));
    memcpy(&ub, &b, cast(u64, 4));
    return ua != ub;
}

bool b3RecVec3Differs(b3Vec3 a, b3Vec3 b) {
    return b3RecF32Differs(a.x, b.x) || b3RecF32Differs(a.y, b.y) || b3RecF32Differs(a.z, b.z);
}

bool b3RecReplayOverlapTrampoline(b3ShapeId id, void* ctx) {
    b3RecReplayQueryCtx* rc = ctx;
    if rc.cursor >= rc.count {
        rc.rdr.diverged = true;
        return false;
    }
    b3RecRecordedHit* h = &rc.hits[rc.cursor++];
    if id.index1 != h.id.index1 || id.generation != h.id.generation {
        rc.rdr.diverged = true;
    }
    return h.userReturnB;
}

// The mover filter has the same bool(shapeId, ctx) shape as an overlap callback, so it replays the
// same way. A distinct typed wrapper keeps the function-pointer types clean.
bool b3RecReplayMoverFilterTrampoline(b3ShapeId id, void* ctx) {
    return b3RecReplayOverlapTrampoline(id, ctx);
}

f32 b3RecReplayCastTrampoline(b3ShapeId id, b3Pos point, b3Vec3 normal, f32 fraction, u64 userMaterialId, i32 triangleIndex, i32 childIndex, void* ctx) {
    b3RecReplayQueryCtx* rc = ctx;
    if rc.cursor >= rc.count {
        rc.rdr.diverged = true;
        return 0.0f;
    }
    b3RecRecordedHit* h = &rc.hits[rc.cursor++];
    if id.index1 != h.id.index1 || id.generation != h.id.generation || b3RecVec3Differs(b3SubPos(point, h.point), b3Vec3_zero) || b3RecVec3Differs(normal, h.normal) || b3RecF32Differs(fraction, h.fraction) || userMaterialId != h.userMaterialId || triangleIndex != h.triangleIndex || childIndex != h.childIndex {
        rc.rdr.diverged = true;
    }
    return h.userReturnF;
}

// 3D delivers a whole shape's planes in one call. The recorded group starts at the cursor with its
// plane count and user return replicated on each hit, so compare the batch and advance by the
// recorded count to stay aligned with the stream even when the count itself diverged.
bool b3RecReplayPlaneTrampoline(b3ShapeId id, b3PlaneResult* planes, i32 planeCount, void* ctx) {
    b3RecReplayQueryCtx* rc = ctx;
    if rc.cursor >= rc.count {
        rc.rdr.diverged = true;
        return true;
    }
    b3RecRecordedHit* head = &rc.hits[rc.cursor];
    i32 recordedCount = head.planeCount;
    bool ret = head.userReturnB;
    if id.index1 != head.id.index1 || id.generation != head.id.generation || recordedCount != planeCount {
        rc.rdr.diverged = true;
    }
    i32 n = recordedCount < planeCount ? recordedCount : planeCount;
    for i32 i = 0; i < n; ++i {
        b3RecRecordedHit* h = &rc.hits[rc.cursor + i];
        if b3RecVec3Differs(h.plane.plane.normal, planes[i].plane.normal) || b3RecF32Differs(h.plane.plane.offset, planes[i].plane.offset) || b3RecVec3Differs(h.plane.point, planes[i].point) {
            rc.rdr.diverged = true;
        }
    }
    rc.cursor += recordedCount;
    return ret;
}

// Copy a decoded proxy's points into a draw record so the overlay does not depend on reader scratch.
void b3RecStashProxy(b3RecDrawQuery* q, b3ShapeProxy* proxy) {
    i32 count = proxy.count;
    if count > 64 {
        count = 64;
    }
    q.proxyCount = count;
    q.proxyRadius = proxy.radius;
    for i32 i = 0; i < count; ++i {
        q.proxyPoints[i] = proxy.points[i];
    }
}

// Tight world-space bounds of a query's swept geometry, so the viewer can frame any query and not
// just the overlap AABB. Mover and proxy points are origin relative. A cast sweeps the shape from the
// origin to origin plus translation. The overlap AABB is already a world-space box.
void b3RecComputeQueryBounds(b3RecDrawQuery* q) {
    if q.kind == B3_RECQ_OVERLAP_AABB {
        return;
    }
    noinit b3Vec3[64] local;
    i32 count = 0;
    f32 radius = 0.0f;
    switch q.kind {
        case B3_RECQ_CAST_MOVER, B3_RECQ_COLLIDE_MOVER: {
            local[0] = q.mover.center1;
            local[1] = q.mover.center2;
            count = 2;
            radius = q.mover.radius;
        }
        case B3_RECQ_OVERLAP_SHAPE, B3_RECQ_CAST_SHAPE: {
            count = q.proxyCount;
            for i32 i = 0; i < count; ++i {
                local[i] = q.proxyPoints[i];
            }
            radius = q.proxyRadius;
        }
        default: {
        }
    }
    if count == 0 {
        local[0] = b3Vec3_zero;
        count = 1;
    }
    b3Pos end = b3OffsetPos(q.origin, q.translation);
    noinit b3Vec3[128] world;
    i32 n = 0;
    for i32 i = 0; i < count; ++i {
        world[n++] = b3ToVec3(b3OffsetPos(q.origin, local[i]));
        world[n++] = b3ToVec3(b3OffsetPos(end, local[i]));
    }
    q.aabb = b3MakeAABB(world, n, radius);
}

void b3RecDispatch_QueryOverlapAABB(b3RecArgs_QueryOverlapAABB* a, b3RecReader* rdr) {
    u32 n = b3RecR_U32(rdr);
    b3RecEnsureHits(rdr, cast(i32, n));
    if rdr.ok == 0 {
        return;
    }
    for u32 i = 0; i < n; ++i {
        rdr.hits[i].id = b3RecMakeShapeId(rdr, b3RecR_SHAPEID(rdr));
        rdr.hits[i].userReturnB = b3RecR_BOOL(rdr);
    }
    ignore b3RecR_TREESTATS(rdr);
    if rdr.ok == 0 {
        return;
    }
    var rc = b3RecReplayQueryCtx{rdr, rdr.hits, cast(i32, n), 0};
    b3World_OverlapAABB(rdr.replayWorldId, a.aabb, a.filter, cast(b3OverlapResultFcn, b3RecReplayOverlapTrampoline), &rc);
    if rc.cursor != cast(i32, n) {
        rdr.diverged = true;
    }
    if rdr.owner != null {
        b3RecDrawQuery* q = b3RecStashQueryBegin(rdr.owner, B3_RECQ_OVERLAP_AABB, rdr.hits, cast(i32, n));
        q.filter = a.filter;
        q.aabb = a.aabb;
        b3RecComputeQueryBounds(q);
    }
}

