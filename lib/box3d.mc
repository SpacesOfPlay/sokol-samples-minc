private {
bool ExplosionCallback(i32 proxyId, u64 userData, void* context) {
    ignore proxyId;
    var shapeId = cast(i32, userData);
    var explosionContext = cast(ExplosionContext*, context);
    b3World* world = explosionContext.world;
    b3Shape* shape = world.shapes.data + shapeId;
    if shape.explosionScale == 0.0f {
        return true;
    }
    b3Body* body = world.bodies.data + shape.bodyId;
    b3WorldTransform xf = b3GetBodyTransformQuick(world, body);
    b3Vec3 localPosition = b3InvTransformWorldPoint(xf, explosionContext.position);
    noinit b3DistanceInput input;
    input.proxyA = b3MakeShapeProxy(shape);
    input.proxyB = b3ShapeProxy{&localPosition, 1, 0.0f};
    input.transform = b3Transform_identity;
    input.useRadii = true;
    b3SimplexCache cache;
    b3DistanceOutput output = b3ShapeDistance(&input, &cache, null, 0);
    f32 radius = explosionContext.radius;
    f32 falloff = explosionContext.falloff;
    if output.distance > radius + falloff {
        return true;
    }
    b3WakeBody(world, body);
    if body.setIndex != b3_awakeSet {
        return true;
    }
    b3Vec3 closestPoint = output.pointA;
    if output.distance == 0.0f {
        closestPoint = b3GetShapeCentroid(shape);
    }
    b3Vec3 direction = b3Sub(closestPoint, localPosition);
    if b3LengthSquared(direction) > 100.0f * FLT_EPSILON * FLT_EPSILON {
        direction = b3Normalize(direction);
    } else {
        direction = b3Vec3{1.0f, 0.0f, 0.0f};
    }
    f32 area = b3GetShapeProjectedArea(shape, direction);
    f32 scale = 1.0f;
    if output.distance > radius && falloff > 0.0f {
        scale = b3ClampFloat((radius + falloff - output.distance) / falloff, 0.0f, 1.0f);
    }
    f32 magnitude = explosionContext.impulsePerArea * area * scale * shape.explosionScale;
    b3Vec3 impulse = b3MulSV(magnitude, b3RotateVector(xf.q, direction));
    i32 localIndex = body.localIndex;
    b3SolverSet* set = world.solverSets.data + b3_awakeSet;
    b3BodyState* state = set.bodyStates.data + localIndex;
    b3BodySim* bodySim = set.bodySims.data + localIndex;
    state.linearVelocity = b3MulAdd(state.linearVelocity, bodySim.invMass, impulse);
    b3Vec3 r = b3RotateVector(xf.q, b3Sub(closestPoint, bodySim.localCenter));
    state.angularVelocity = b3Add(state.angularVelocity, b3MulMV(bodySim.invInertiaWorld, b3Cross(r, impulse)));
    return true;
}
}

void b3World_Explode(b3WorldId worldId, b3ExplosionDef* explosionDef) {
    u64 maskBits = explosionDef.maskBits;
    b3Pos position = explosionDef.position;
    f32 radius = explosionDef.radius;
    f32 falloff = explosionDef.falloff;
    f32 impulsePerArea = explosionDef.impulsePerArea;
    b3World* world = b3GetUnlockedWorldFromId(worldId);
    if world == null {
        return;
    }
    while true {
        if world.recording != null {
            var recArgs = b3RecArgs_WorldExplode{worldId, *explosionDef};
            b3RecWrite_WorldExplode(world.recording, &recArgs);
        }
        if !(0 != 0) { break; }
    }
    world.locked = true;
    var explosionContext = ExplosionContext{world, position, radius, falloff, impulsePerArea};
    f32 extent = radius + falloff;
    var localBox = b3AABB{b3Vec3{-extent, -extent, -extent}, b3Vec3{extent, extent, extent}};
    b3AABB aabb = b3OffsetAABB(localBox, position);
    b3DynamicTree_Query(world.broadPhase.trees + b3_dynamicBody, aabb, maskBits, false, cast(b3TreeQueryCallbackFcn, ExplosionCallback), &explosionContext);
    world.locked = false;
}

void b3World_RebuildStaticTree(b3WorldId worldId) {
    b3World* world = b3GetUnlockedWorldFromId(worldId);
    if world == null {
        return;
    }
    while true {
        if world.recording != null {
            var recArgs = b3RecArgs_WorldRebuildStaticTree{worldId};
            b3RecWrite_WorldRebuildStaticTree(world.recording, &recArgs);
        }
        if !(0 != 0) { break; }
    }
    b3DynamicTree* staticTree = world.broadPhase.trees + b3_staticBody;
    b3DynamicTree_Rebuild(staticTree, true);
}

void b3World_EnableSpeculative(b3WorldId worldId, bool flag) {
