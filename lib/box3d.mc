// needed for dll export
private {
b3JointDef b3DefaultJointDef() {
    b3JointDef def;
    def.localFrameA.q = b3Quat_identity;
    def.localFrameB.q = b3Quat_identity;
    def.forceThreshold = FLT_MAX;
    def.torqueThreshold = FLT_MAX;
    def.constraintHertz = 60.0f;
    def.constraintDampingRatio = 2.0f;
    def.drawScale = b3GetLengthUnitsPerMeter();
    def.internalValue = 1152023;
    return def;
}
}

b3ParallelJointDef b3DefaultParallelJointDef() {
    b3ParallelJointDef def;
    def.base = b3DefaultJointDef();
    def.hertz = 1.0f;
    def.dampingRatio = 1.0f;
    def.maxTorque = FLT_MAX;
    return def;
}

b3DistanceJointDef b3DefaultDistanceJointDef() {
    b3DistanceJointDef def;
    def.base = b3DefaultJointDef();
    def.lowerSpringForce = -FLT_MAX;
    def.upperSpringForce = FLT_MAX;
    def.length = 1.0f;
    def.maxLength = 100000.0f * b3GetLengthUnitsPerMeter();
    return def;
}

b3MotorJointDef b3DefaultMotorJointDef() {
    b3MotorJointDef def;
    def.base = b3DefaultJointDef();
    return def;
}

b3FilterJointDef b3DefaultFilterJointDef() {
    b3FilterJointDef def;
    def.base = b3DefaultJointDef();
    return def;
}

b3PrismaticJointDef b3DefaultPrismaticJointDef() {
    b3PrismaticJointDef def;
    def.base = b3DefaultJointDef();
    return def;
}

b3RevoluteJointDef b3DefaultRevoluteJointDef() {
    b3RevoluteJointDef def;
    def.base = b3DefaultJointDef();
    return def;
}

b3SphericalJointDef b3DefaultSphericalJointDef() {
    b3SphericalJointDef def;
    def.base = b3DefaultJointDef();
    def.targetRotation = b3Quat_identity;
    return def;
}

b3WeldJointDef b3DefaultWeldJointDef() {
    b3WeldJointDef def;
    def.base = b3DefaultJointDef();
    return def;
}

b3WheelJointDef b3DefaultWheelJointDef() {
    b3WheelJointDef def;
    def.base = b3DefaultJointDef();
    def.enableSuspensionSpring = true;
    def.suspensionHertz = 1.0f;
    def.suspensionDampingRatio = 0.7f;
    def.steeringHertz = 1.0f;
    def.steeringDampingRatio = 0.7f;
    return def;
}

b3ExplosionDef b3DefaultExplosionDef() {
    b3ExplosionDef def;
    def.maskBits = -1;
    return def;
}

b3Joint* b3GetJointFullId(b3World* world, b3JointId jointId) {
    i32 id = jointId.index1 - 1;
    b3Joint* joint = world.joints.data + id;
    return joint;
}

b3JointSim* b3GetJointSim(b3World* world, b3Joint* joint) {
    if joint.setIndex == b3_awakeSet {
        b3GraphColor* color = world.constraintGraph.colors + joint.colorIndex;
        return color.jointSims.data + joint.localIndex;
    }
    b3SolverSet* set = world.solverSets.data + joint.setIndex;
    return set.jointSims.data + joint.localIndex;
}

b3JointSim* b3GetJointSimCheckType(b3JointId jointId, b3JointType type) {
    ignore type;
    b3World* world = b3GetWorld(cast(i32, jointId.world0));
    b3Joint* joint = b3GetJointFullId(world, jointId);
    b3JointSim* jointSim = b3GetJointSim(world, joint);
    return jointSim;
}

private {
b3JointPair b3CreateJoint(b3World* world, b3JointDef* def, b3JointType type) {
    b3Body* bodyA = b3GetBodyFullId(world, def.bodyIdA);
    b3Body* bodyB = b3GetBodyFullId(world, def.bodyIdB);
    i32 bodyIdA = bodyA.id;
    i32 bodyIdB = bodyB.id;
    i32 maxSetIndex = b3MaxInt(bodyA.setIndex, bodyB.setIndex);
    i32 jointId = b3AllocId(&world.jointIdPool);
    if jointId == world.joints.count {
        while true {
            if world.joints.count >= world.joints.capacity {
                var oldSize = cast(i32, world.joints.capacity * sizeof(*world.joints.data));
                i32 newCapacity = world.joints.capacity == 0 ? 8 : 2 * world.joints.capacity;
                var newSize = cast(i32, newCapacity * sizeof(*world.joints.data));
                world.joints.data = b3GrowAlloc(world.joints.data, oldSize, newSize);
                world.joints.capacity = newCapacity;
            }
            world.joints.data[world.joints.count++] = b3Joint{};
            if !(0 != 0) { break; }
        }
    }
    b3Joint* joint = world.joints.data + jointId;
    joint.jointId = jointId;
    joint.userData = def.userData;
    joint.generation += 1;
    joint.setIndex = -1;
    joint.colorIndex = -1;
    joint.localIndex = -1;
    joint.islandId = -1;
    joint.islandIndex = -1;
    joint.drawScale = def.drawScale;
    joint.type = type;
    joint.collideConnected = def.collideConnected;
    joint.edges[0].bodyId = bodyIdA;
    joint.edges[0].prevKey = -1;
    joint.edges[0].nextKey = bodyA.headJointKey;
    i32 keyA = jointId << 1 | 0;
    if bodyA.headJointKey != -1 {
        b3Joint* jointA = world.joints.data + (bodyA.headJointKey >> 1);
        b3JointEdge* edgeA = jointA.edges + (bodyA.headJointKey & 1);
        edgeA.prevKey = keyA;
    }
    bodyA.headJointKey = keyA;
    bodyA.jointCount += 1;
    joint.edges[1].bodyId = bodyIdB;
    joint.edges[1].prevKey = -1;
    joint.edges[1].nextKey = bodyB.headJointKey;
    i32 keyB = jointId << 1 | 1;
    if bodyB.headJointKey != -1 {
        b3Joint* jointB = world.joints.data + (bodyB.headJointKey >> 1);
        b3JointEdge* edgeB = jointB.edges + (bodyB.headJointKey & 1);
        edgeB.prevKey = keyB;
    }
    bodyB.headJointKey = keyB;
    bodyB.jointCount += 1;
    b3JointSim* jointSim;
    if bodyA.setIndex == b3_disabledSet || bodyB.setIndex == b3_disabledSet {
        b3SolverSet* set = world.solverSets.data + b3_disabledSet;
        joint.setIndex = b3_disabledSet;
        joint.localIndex = set.jointSims.count;
        jointSim = b3EmplaceHelper(cast(void**, &set.jointSims.data), &set.jointSims.count, &set.jointSims.capacity, cast(i32, sizeof(*set.jointSims.data)));
        memset(jointSim, 0, cast(u64, sizeof(b3JointSim)));
        jointSim.jointId = jointId;
        jointSim.bodyIdA = bodyIdA;
        jointSim.bodyIdB = bodyIdB;
    } else if bodyA.type != b3_dynamicBody && bodyB.type != b3_dynamicBody {
        b3SolverSet* set = world.solverSets.data + b3_staticSet;
        joint.setIndex = b3_staticSet;
        joint.localIndex = set.jointSims.count;
        jointSim = b3EmplaceHelper(cast(void**, &set.jointSims.data), &set.jointSims.count, &set.jointSims.capacity, cast(i32, sizeof(*set.jointSims.data)));
        memset(jointSim, 0, cast(u64, sizeof(b3JointSim)));
        jointSim.jointId = jointId;
        jointSim.bodyIdA = bodyIdA;
        jointSim.bodyIdB = bodyIdB;
    } else if bodyA.setIndex == b3_awakeSet || bodyB.setIndex == b3_awakeSet {
        if maxSetIndex >= b3_firstSleepingSet {
            b3WakeSolverSet(world, maxSetIndex);
        }
        joint.setIndex = b3_awakeSet;
        jointSim = b3CreateJointInGraph(world, joint);
        jointSim.jointId = jointId;
        jointSim.bodyIdA = bodyIdA;
        jointSim.bodyIdB = bodyIdB;
    } else {
        i32 setIndex = maxSetIndex;
        b3SolverSet* set = world.solverSets.data + setIndex;
        joint.setIndex = setIndex;
        joint.localIndex = set.jointSims.count;
        jointSim = b3EmplaceHelper(cast(void**, &set.jointSims.data), &set.jointSims.count, &set.jointSims.capacity, cast(i32, sizeof(*set.jointSims.data)));
        memset(jointSim, 0, cast(u64, sizeof(b3JointSim)));
        jointSim.jointId = jointId;
        jointSim.bodyIdA = bodyIdA;
        jointSim.bodyIdB = bodyIdB;
        if bodyA.setIndex != bodyB.setIndex && bodyA.setIndex >= b3_firstSleepingSet && bodyB.setIndex >= b3_firstSleepingSet {
            b3MergeSolverSets(world, bodyA.setIndex, bodyB.setIndex);
            setIndex = bodyA.setIndex;
            b3SolverSet* mergedSet = world.solverSets.data + setIndex;
            jointSim = mergedSet.jointSims.data + joint.localIndex;
        }
    }
    jointSim.localFrameA = def.localFrameA;
    jointSim.localFrameB = def.localFrameB;
    jointSim.type = type;
    jointSim.constraintHertz = def.constraintHertz;
    jointSim.constraintDampingRatio = def.constraintDampingRatio;
    jointSim.constraintSoftness = b3Softness{.biasRate = 0.0f, .massScale = 1.0f, .impulseScale = 0.0f};
    jointSim.forceThreshold = def.forceThreshold;
    jointSim.torqueThreshold = def.torqueThreshold;
    if joint.setIndex > b3_disabledSet {
        b3LinkJoint(world, joint);
    }
    b3ValidateSolverSets(world);
    return b3JointPair{joint, jointSim};
}

void b3DestroyContactsBetweenBodies(b3World* world, b3Body* bodyA, b3Body* bodyB) {
    i32 contactKey;
    i32 otherBodyId;
    if bodyA.contactCount < bodyB.contactCount {
        contactKey = bodyA.headContactKey;
        otherBodyId = bodyB.id;
    } else {
        contactKey = bodyB.headContactKey;
        otherBodyId = bodyA.id;
    }
    bool wakeBodies = false;
    while contactKey != -1 {
        i32 contactId = contactKey >> 1;
        i32 edgeIndex = contactKey & 1;
        b3Contact* contact = world.contacts.data + contactId;
        contactKey = contact.edges[edgeIndex].nextKey;
        i32 otherEdgeIndex = edgeIndex ^ 1;
        if contact.edges[otherEdgeIndex].bodyId == otherBodyId {
            b3DestroyContact(world, contact, wakeBodies);
        }
    }
    b3ValidateSolverSets(world);
}
}

void b3Joint_SetConstraintTuning(b3JointId jointId, f32 hertz, f32 dampingRatio) {
    b3World* world = b3GetWorld(cast(i32, jointId.world0));
    while true {
        if world.recording != null {
            var recArgs = b3RecArgs_JointSetConstraintTuning{jointId, hertz, dampingRatio};
            b3RecWrite_JointSetConstraintTuning(world.recording, &recArgs);
        }
        if !(0 != 0) { break; }
    }
    b3Joint* joint = b3GetJointFullId(world, jointId);
    b3JointSim* base = b3GetJointSim(world, joint);
    base.constraintHertz = hertz;
    base.constraintDampingRatio = dampingRatio;
}

void b3Joint_GetConstraintTuning(b3JointId jointId, f32* hertz, f32* dampingRatio) {
    b3World* world = b3GetWorld(cast(i32, jointId.world0));
    b3Joint* joint = b3GetJointFullId(world, jointId);
    b3JointSim* base = b3GetJointSim(world, joint);
    *hertz = base.constraintHertz;
    *dampingRatio = base.constraintDampingRatio;
}

void b3Joint_SetForceThreshold(b3JointId jointId, f32 threshold) {
    b3World* world = b3GetWorld(cast(i32, jointId.world0));
    while true {
        if world.recording != null {
            var recArgs = b3RecArgs_JointSetForceThreshold{jointId, threshold};
            b3RecWrite_JointSetForceThreshold(world.recording, &recArgs);
        }
        if !(0 != 0) { break; }
    }
    b3Joint* joint = b3GetJointFullId(world, jointId);
    b3JointSim* base = b3GetJointSim(world, joint);
    base.forceThreshold = threshold;
}

f32 b3Joint_GetForceThreshold(b3JointId jointId) {
    b3World* world = b3GetWorld(cast(i32, jointId.world0));
    b3Joint* joint = b3GetJointFullId(world, jointId);
    b3JointSim* base = b3GetJointSim(world, joint);
    return base.forceThreshold;
}

void b3Joint_SetTorqueThreshold(b3JointId jointId, f32 threshold) {
    b3World* world = b3GetWorld(cast(i32, jointId.world0));
    while true {
        if world.recording != null {
            var recArgs = b3RecArgs_JointSetTorqueThreshold{jointId, threshold};
            b3RecWrite_JointSetTorqueThreshold(world.recording, &recArgs);
        }
        if !(0 != 0) { break; }
    }
    b3Joint* joint = b3GetJointFullId(world, jointId);
    b3JointSim* base = b3GetJointSim(world, joint);
    base.torqueThreshold = threshold;
}

f32 b3Joint_GetTorqueThreshold(b3JointId jointId) {
    b3World* world = b3GetWorld(cast(i32, jointId.world0));
    b3Joint* joint = b3GetJointFullId(world, jointId);
    b3JointSim* base = b3GetJointSim(world, joint);
    return base.torqueThreshold;
}

b3JointId b3CreateDistanceJoint(b3WorldId worldId, b3DistanceJointDef* def) {
    b3World* world = b3GetUnlockedWorldFromId(worldId);
    if world == null {
        return b3JointId{};
    }
    b3JointPair pair = b3CreateJoint(world, &def.base, b3_distanceJoint);
    b3JointSim* joint = pair.jointSim;
    joint.distanceJoint = b3DistanceJoint{};
    joint.distanceJoint.length = b3MaxFloat(def.length, 0.005f * b3GetLengthUnitsPerMeter());
    joint.distanceJoint.hertz = def.hertz;
    joint.distanceJoint.dampingRatio = def.dampingRatio;
    joint.distanceJoint.lowerSpringForce = def.lowerSpringForce;
    joint.distanceJoint.upperSpringForce = def.upperSpringForce;
    joint.distanceJoint.minLength = b3MaxFloat(def.minLength, 0.005f * b3GetLengthUnitsPerMeter());
    joint.distanceJoint.maxLength = b3MaxFloat(def.minLength, def.maxLength);
    joint.distanceJoint.maxMotorForce = def.maxMotorForce;
    joint.distanceJoint.motorSpeed = def.motorSpeed;
    joint.distanceJoint.enableSpring = def.enableSpring;
    joint.distanceJoint.enableLimit = def.enableLimit;
    joint.distanceJoint.enableMotor = def.enableMotor;
    joint.distanceJoint.impulse = 0.0f;
    joint.distanceJoint.lowerImpulse = 0.0f;
    joint.distanceJoint.upperImpulse = 0.0f;
    joint.distanceJoint.motorImpulse = 0.0f;
    var jointId = b3JointId{joint.jointId + 1, world.worldId, pair.joint.generation};
    while true {
        if world.recording != null {
            var recCreateArgs = b3RecArgs_CreateDistanceJoint{worldId, *def};
            b3RecWriteRet_CreateDistanceJoint(world.recording, &recCreateArgs, jointId);
        }
        if !(0 != 0) { break; }
    }
    return jointId;
}

