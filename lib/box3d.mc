/*--------------------------------------------------------------------------------------------------------------------*/
/*                                               Common header section                                                */
/*--------------------------------------------------------------------------------------------------------------------*/
/*--------------------------------------------------------------------------------------------------------------------*/
/*                                                  Prefixed structs                                                  */
/*--------------------------------------------------------------------------------------------------------------------*/
/*--------------------------------------------------------------------------------------------------------------------*/
/*                                                Function prototypes                                                 */
/*--------------------------------------------------------------------------------------------------------------------*/
/*--------------------------------------------------------------------------------------------------------------------*/
/*                                              Function implementations                                              */
/*--------------------------------------------------------------------------------------------------------------------*/
when !(defined(HEADER_MODE)) {
// Default settings.

void b3HullMap_init(b3HullMap* table) {
    table.key_count = 0;
    table.buckets_mask = 0x0000000000000000;
    table.buckets = null;
    table.metadata = &vt_empty_placeholder_metadatum;
}

// For efficiency, especially in the case of a small table, the buckets array and metadata share the same dynamic memory
// allocation:
//   +-----------------------------+-----+----------------+--------+
//   |           Buckets           | Pad |    Metadata    | Excess |
//   +-----------------------------+-----+----------------+--------+
// Any allocated metadata array requires four excess elements to ensure that iteration functions, which read four
// metadata at a time, never read beyond the end of it.
// This function returns the offset of the beginning of the metadata, i.e. the size of the buckets array plus the
// (usually zero) padding.
// It assumes that the bucket count is not zero.
private {
u64 b3HullMap_metadata_offset(b3HullMap* table) {
    return ((table.buckets_mask + 1) * cast(u64, sizeof(b3HullMap_bucket)) + cast(u64, sizeof(u16)) - 1) / cast(u64, sizeof(u16)) * cast(u64, sizeof(u16));
}

// Returns the total allocation size, including the buckets array, padding, metadata, and excess metadata.
// As above, this function assumes that the bucket count is not zero.
u64 b3HullMap_total_alloc_size(b3HullMap* table) {
    return b3HullMap_metadata_offset(table) + (table.buckets_mask + 1 + 4) * cast(u64, sizeof(u16));
}
}

bool b3HullMap_init_clone(b3HullMap* table, b3HullMap* source) {
    table.key_count = source.key_count;
    table.buckets_mask = source.buckets_mask;
    if source.buckets_mask == 0 {
        table.metadata = &vt_empty_placeholder_metadatum;
        table.buckets = null;
        return true;
    }
    void* allocation = b3Alloc(b3HullMap_total_alloc_size(table));
    if allocation == null {
        return false;
    }
    table.buckets = cast(b3HullMap_bucket*, allocation);
    table.metadata = cast(u16*, cast(u8*, allocation) + b3HullMap_metadata_offset(table));
    memcpy(allocation, source.buckets, b3HullMap_total_alloc_size(table));
    return true;
}

u64 b3HullMap_size(b3HullMap* table) {
    return table.key_count;
}

u64 b3HullMap_bucket_count(b3HullMap* table) {
    return table.buckets_mask + cast(u64, cast(bool, table.buckets_mask));
}

bool b3HullMap_is_end(b3HullMap_itr itr) {
    return itr.metadatum == itr.metadata_end;
}

// Finds the earliest empty bucket in which a key belonging to home_bucket can be placed, assuming that home_bucket
// is already occupied.
// The reason to begin the search at home_bucket, rather than the end of the existing chain, is that keys deleted from
// other chains might have freed up buckets that could fall in this chain before the final key.
// Returns true if an empty bucket within the range of the displacement limit was found, in which case the final two
// pointer arguments contain the index of the empty bucket and its quadratic displacement from home_bucket.
private {
bool b3HullMap_find_first_empty(b3HullMap* table, u64 home_bucket, u64* empty, u16* displacement) {
    *displacement = 1;
    u64 linear_dispacement = 1;
    while true {
        *empty = home_bucket + linear_dispacement & table.buckets_mask;
        if table.metadata[*empty] == 0x0000 {
            return true;
        }
        if ++*displacement == 0x07FF {
            return false;
        }
        linear_dispacement += *displacement;
    }
}

// Finds the key in the chain beginning in home_bucket after which to link a new key with displacement_to_empty
// quadratic displacement and returns the index of the bucket containing that key.
// Although the new key could simply be linked to the end of the chain, keeping the chain ordered by displacement
// theoretically improves cache locality during lookups.
u64 b3HullMap_find_insert_location_in_chain(b3HullMap* table, u64 home_bucket, u16 displacement_to_empty) {
    u64 candidate = home_bucket;
    while true {
        u16 displacement = table.metadata[candidate] & 0x07FF;
        if displacement > displacement_to_empty {
            return candidate;
        }
        candidate = home_bucket + vt_quadratic(displacement) & table.buckets_mask;
    }
}

// Frees up a bucket occupied by a key not belonging there so that a new key belonging there can be placed there as the
// beginning of a new chain.
// This requires:
// * Finding the previous key in the chain to which the occupying key belongs by rehashing it and then traversing the
//   chain.
// * Disconnecting the key from the chain.
// * Finding the appropriate empty bucket to which to move the key.
// * Moving the key (and value) data to the empty bucket.
// * Re-linking the key to the chain.
// Returns true if the eviction succeeded, or false if no empty bucket to which to evict the occupying key could be
// found within the displacement limit.
bool b3HullMap_evict(b3HullMap* table, u64 bucket) {
    u64 home_bucket = b3HashHullData(table.buckets[bucket].key) & table.buckets_mask;
    u64 prev = home_bucket;
    while true {
        u64 next = home_bucket + vt_quadratic(table.metadata[prev] & 0x07FF) & table.buckets_mask;
        if next == bucket {
            break;
        }
        prev = next;
    }
    table.metadata[prev] = cast(u16, table.metadata[prev] & ~0x07FF | table.metadata[bucket] & 0x07FF);
    u64 empty;
    u16 displacement;
    if b3HullMap_find_first_empty(table, home_bucket, &empty, &displacement) == 0 {
        return false;
    }
    prev = b3HullMap_find_insert_location_in_chain(table, home_bucket, displacement);
    table.buckets[empty] = table.buckets[bucket];
    table.metadata[empty] = table.metadata[bucket] & 0xF000 | table.metadata[prev] & 0x07FF;
    table.metadata[prev] = cast(u16, table.metadata[prev] & ~0x07FF | displacement);
    return true;
}

// Returns an end iterator, i.e. any iterator for which .metadatum == .metadata_end.
// This function just cleans up the library code in functions that return an end iterator as a failure indicator.
b3HullMap_itr b3HullMap_end_itr() {
    b3HullMap_itr itr;
    return itr;
}

// Inserts a key, optionally replacing the existing key if it already exists.
// There are two main cases that must be handled:
// * If the key's home bucket is empty or occupied by a key that does not belong there, then the key is inserted there,
//   evicting the occupying key if there is one.
// * Otherwise, the chain of keys beginning at the home bucket is (if unique is false) traversed in search of a matching
//   key.
//   If none is found, then the new key is inserted at the earliest available bucket, per quadratic probing from the
//   home bucket, and then linked to the chain in a manner that maintains its quadratic order.
// The unique argument tells the function whether to skip searching for the key before inserting it (on rehashing, this
// step is unnecessary).
// The replace argument tells the function whether to replace an existing key.
// If replace is true, the function returns an iterator to the inserted key, or an end iterator if the key was not
// inserted because of the maximum load factor or displacement limit constraints.
// If replace is false, then the return value is as described above, except that if the key already exists, the function
// returns an iterator to the existing key.
b3HullMap_itr b3HullMap_insert_raw(b3HullMap* table, b3HullData* key, i32* val, bool unique, bool replace) {
    u64 hash = b3HashHullData(key);
    u16 hashfrag = vt_hashfrag(hash);
    u64 home_bucket = hash & table.buckets_mask;
    if (table.metadata[home_bucket] & 0x0800) == 0 {
        if cast(f64, table.key_count + 1) > cast(f64, b3HullMap_bucket_count(table)) * 0.9 || table.metadata[home_bucket] != 0x0000 && !b3HullMap_evict(table, home_bucket) {
            return b3HullMap_end_itr();
        }
        table.buckets[home_bucket].key = key;
        table.buckets[home_bucket].val = *val;
        table.metadata[home_bucket] = hashfrag | 0x0800 | 0x07FF;
        ++table.key_count;
        var itr = b3HullMap_itr{
            table.buckets + home_bucket, table.metadata + home_bucket,
            table.metadata + table.buckets_mask + 1, home_bucket,
        };
        return itr;
    }
    if unique == 0 {
        u64 bucket = home_bucket;
        while true {
            if (table.metadata[bucket] & 0xF000) == hashfrag && b3CompareHullData(table.buckets[bucket].key, key) {
                if replace != 0 {
                    table.buckets[bucket].key = key;
                    table.buckets[bucket].val = *val;
                }
                var itr = b3HullMap_itr{
                    table.buckets + bucket, table.metadata + bucket,
                    table.metadata + table.buckets_mask + 1, home_bucket,
                };
                return itr;
            }
            u16 displacement = table.metadata[bucket] & 0x07FF;
            if displacement == 0x07FF {
                break;
            }
            bucket = home_bucket + vt_quadratic(displacement) & table.buckets_mask;
        }
    }
    u64 empty;
    u16 displacement;
    if cast(f64, table.key_count + 1) > cast(f64, b3HullMap_bucket_count(table)) * 0.9 || !b3HullMap_find_first_empty(table, home_bucket, &empty, &displacement) {
        return b3HullMap_end_itr();
    }
    u64 prev = b3HullMap_find_insert_location_in_chain(table, home_bucket, displacement);
    table.buckets[empty].key = key;
    table.buckets[empty].val = *val;
    table.metadata[empty] = hashfrag | table.metadata[prev] & 0x07FF;
    table.metadata[prev] = cast(u16, table.metadata[prev] & ~0x07FF | displacement);
    ++table.key_count;
    var itr = b3HullMap_itr{
        table.buckets + empty, table.metadata + empty, table.metadata + table.buckets_mask + 1,
        home_bucket,
    };
    return itr;
}

// Resizes the bucket array.
// This function assumes that bucket_count is a power of two and large enough to accommodate all keys without violating
// the maximum load factor.
// Returns false in the case of allocation failure.
// As this function is called very rarely in _insert and _get_or_insert, ideally it should not be inlined into those
// functions.
// In testing, the no-inline approach showed a performance benefit when inserting existing keys (i.e. replacing).
bool b3HullMap_rehash(b3HullMap* table, u64 bucket_count) {
    while true {
        var new_table = b3HullMap{0, bucket_count - 1, null, null};
        void* allocation = b3Alloc(b3HullMap_total_alloc_size(&new_table));
        if allocation == null {
            return false;
        }
        new_table.buckets = cast(b3HullMap_bucket*, allocation);
        new_table.metadata = cast(u16*, cast(u8*, allocation) + b3HullMap_metadata_offset(&new_table));
        memset(new_table.metadata, 0x00, (bucket_count + 4) * cast(u64, sizeof(u16)));
        new_table.metadata[bucket_count] = 0x01;
        for u64 bucket = 0; bucket < b3HullMap_bucket_count(table); ++bucket {
            if table.metadata[bucket] != 0x0000 {
                b3HullMap_itr itr = b3HullMap_insert_raw(&new_table, table.buckets[bucket].key, &table.buckets[bucket].val, true, false);
                if b3HullMap_is_end(itr) != 0 {
                    break;
                }
            }
        }
        if new_table.key_count < table.key_count {
            b3Free(new_table.buckets, b3HullMap_total_alloc_size(&new_table));
            bucket_count *= 2;
            continue;
        }
        if table.buckets_mask != 0 {
            b3Free(table.buckets, b3HullMap_total_alloc_size(table));
        }
        *table = new_table;
        return true;
    }
}
}

b3HullMap_itr b3HullMap_insert(b3HullMap* table, b3HullData* key, i32 val) {
    while true {
        b3HullMap_itr itr = b3HullMap_insert_raw(table, key, &val, false, true);
        if !b3HullMap_is_end(itr) || !b3HullMap_rehash(table, table.buckets_mask != 0 ? b3HullMap_bucket_count(table) * 2 : 8) {
            return itr;
        }
    }
}

b3HullMap_itr b3HullMap_get_or_insert(b3HullMap* table, b3HullData* key, i32 val) {
    while true {
        b3HullMap_itr itr = b3HullMap_insert_raw(table, key, &val, false, false);
        if !b3HullMap_is_end(itr) || !b3HullMap_rehash(table, table.buckets_mask != 0 ? b3HullMap_bucket_count(table) * 2 : 8) {
            return itr;
        }
    }
}

b3HullMap_itr b3HullMap_get(b3HullMap* table, b3HullData* key) {
    u64 hash = b3HashHullData(key);
    u64 home_bucket = hash & table.buckets_mask;
    if (table.metadata[home_bucket] & 0x0800) == 0 {
        return b3HullMap_end_itr();
    }
    u16 hashfrag = vt_hashfrag(hash);
    u64 bucket = home_bucket;
    while true {
        if (table.metadata[bucket] & 0xF000) == hashfrag && b3CompareHullData(table.buckets[bucket].key, key) {
            var itr = b3HullMap_itr{
                table.buckets + bucket, table.metadata + bucket,
                table.metadata + table.buckets_mask + 1, home_bucket,
            };
            return itr;
        }
        u16 displacement = table.metadata[bucket] & 0x07FF;
        if displacement == 0x07FF {
            return b3HullMap_end_itr();
        }
        bucket = home_bucket + vt_quadratic(displacement) & table.buckets_mask;
    }
}

// Erases the key pointed to by the specified iterator.
// The erasure always occurs at the end of the chain to which the key belongs.
// If the key to be erased is not the last in the chain, it is swapped with the last so that erasure occurs at the end.
// This helps keep a chain's keys close to their home bucket for the sake of cache locality.
// Returns true if, in the case of iteration from first to end, NAME_next should now be called on the iterator to find
// the next key.
// This return value is necessary because at the iterator location, the erasure could result in an empty bucket, a
// bucket containing a moved key already visited during the iteration, or a bucket containing a moved key not yet
// visited.
bool b3HullMap_erase_itr_raw(b3HullMap* table, b3HullMap_itr itr) {
    --table.key_count;
    var itr_bucket = cast(u64, cast(i64, itr.metadatum - table.metadata));
    if table.metadata[itr_bucket] & 0x0800 && (table.metadata[itr_bucket] & 0x07FF) == 0x07FF {
        table.metadata[itr_bucket] = 0x0000;
        return true;
    }
    if itr.home_bucket == SIZE_MAX {
        if (table.metadata[itr_bucket] & 0x0800) != 0 {
            itr.home_bucket = itr_bucket;
        } else {
            itr.home_bucket = b3HashHullData(table.buckets[itr_bucket].key) & table.buckets_mask;
        }
    }
    if (table.metadata[itr_bucket] & 0x07FF) == 0x07FF {
        u64 bucket = itr.home_bucket;
        while true {
            u16 displacement = table.metadata[bucket] & 0x07FF;
            u64 next = itr.home_bucket + vt_quadratic(displacement) & table.buckets_mask;
            if next == itr_bucket {
                table.metadata[bucket] |= 0x07FF;
                table.metadata[itr_bucket] = 0x0000;
                return true;
            }
            bucket = next;
        }
    }
    u64 bucket = itr_bucket;
    while true {
        u64 prev = bucket;
        bucket = itr.home_bucket + vt_quadratic(table.metadata[bucket] & 0x07FF) & table.buckets_mask;
        if (table.metadata[bucket] & 0x07FF) == 0x07FF {
            table.buckets[itr_bucket] = table.buckets[bucket];
            table.metadata[itr_bucket] = cast(u16, table.metadata[itr_bucket] & ~0xF000 | table.metadata[bucket] & 0xF000);
            table.metadata[prev] |= 0x07FF;
            table.metadata[bucket] = 0x0000;
            if bucket > itr_bucket {
                return false;
            }
            return true;
        }
    }
}

// Erases the specified key, if it exists.
// Returns true if a key was erased.
bool b3HullMap_erase(b3HullMap* table, b3HullData* key) {
    b3HullMap_itr itr = b3HullMap_get(table, key);
    if b3HullMap_is_end(itr) != 0 {
        return false;
    }
    b3HullMap_erase_itr_raw(table, itr);
    return true;
}

// Finds the first occupied bucket at or after the bucket pointed to by itr.
// This function scans four buckets at a time, ideally using intrinsics.
private {
void b3HullMap_fast_forward(b3HullMap_itr* itr) {
    while true {
        u64 metadata;
        memcpy(&metadata, itr.metadatum, sizeof(u64));
        if metadata != 0 {
            i32 offset = vt_first_nonzero_uint16(metadata);
            itr.data += offset;
            itr.metadatum += offset;
            itr.home_bucket = SIZE_MAX;
            return;
        }
        itr.data += 4;
        itr.metadatum += 4;
    }
}
}

b3HullMap_itr b3HullMap_next(b3HullMap_itr itr) {
    ++itr.data;
    ++itr.metadatum;
    b3HullMap_fast_forward(&itr);
    return itr;
}

// Returns the minimum bucket count required to accommodate a certain number of keys, which is governed by the maximum
// load factor.
private {
u64 b3HullMap_min_bucket_count_for_size(u64 size) {
    if size == 0 {
        return 0;
    }
    u64 bucket_count = 8;
    while cast(f64, size) > cast(f64, bucket_count) * 0.9 {
        bucket_count *= 2;
    }
    return bucket_count;
}
}

bool b3HullMap_reserve(b3HullMap* table, u64 size) {
    u64 bucket_count = b3HullMap_min_bucket_count_for_size(size);
    if bucket_count <= b3HullMap_bucket_count(table) {
        return true;
    }
    return b3HullMap_rehash(table, bucket_count);
}

bool b3HullMap_shrink(b3HullMap* table) {
    u64 bucket_count = b3HullMap_min_bucket_count_for_size(table.key_count);
    if bucket_count == b3HullMap_bucket_count(table) {
        return true;
    }
    if bucket_count == 0 {
        b3Free(table.buckets, b3HullMap_total_alloc_size(table));
        table.buckets_mask = 0x0000000000000000;
        table.metadata = &vt_empty_placeholder_metadatum;
        return true;
    }
    return b3HullMap_rehash(table, bucket_count);
}

b3HullMap_itr b3HullMap_first(b3HullMap* table) {
    if table.key_count == 0 {
        return b3HullMap_end_itr();
    }
    var itr = b3HullMap_itr{
        table.buckets, table.metadata, table.metadata + table.buckets_mask + 1, SIZE_MAX,
    };
    b3HullMap_fast_forward(&itr);
    return itr;
}

void b3HullMap_clear(b3HullMap* table) {
    if table.key_count == 0 {
        return;
    }
    for u64 i = 0; i < b3HullMap_bucket_count(table); ++i {
        if table.metadata[i] != 0x0000 {
        }
        table.metadata[i] = 0x0000;
    }
    table.key_count = 0;
}

void b3HullMap_cleanup(b3HullMap* table) {
    if table.buckets_mask == 0 {
        return;
    }
    when defined(KEY_DTOR_FN) || defined(VAL_DTOR_FN) {
        b3HullMap_clear(table);
    }
    b3Free(table.buckets, b3HullMap_total_alloc_size(table));
    b3HullMap_init(table);
}
}

u64 b3HullMapByteCount(b3HullMap* map) {
    var byteCount = cast(u64, sizeof(b3HullMap));
    if b3HullMap_bucket_count(map) > 0 {
        byteCount += b3HullMap_total_alloc_size(map);
    }
    return byteCount;
}

b3HullData* b3CloneAndTransformHull(b3HullData* original, b3Transform transform, b3Vec3 scale) {
    if original == null || b3IsValidHull(original) == false {
        return null;
    }
    b3HullData* hull = b3Alloc(cast(u64, original.byteCount));
    memcpy(hull, original, cast(u64, original.byteCount));
    b3Vec3 safeScale = b3SafeScale(scale);
    b3HullHalfEdge* edges = b3GetHullEdgesWrite(hull);
    b3HullFace* faces = b3GetHullFaces(hull);
    i32 faceCount = hull.faceCount;
    i32 vertexCount = hull.vertexCount;
    if safeScale.x * safeScale.y * safeScale.z < 0.0f {
        for i32 i = 0; i < faceCount; ++i {
            b3HullFace* face = faces + i;
            u8 startEdgeIndex = face.edge;
            u8 currentEdgeIndex = startEdgeIndex;
            u8 prevEdgeIndex = 255;
            while true {
                b3HullHalfEdge* edge = edges + currentEdgeIndex;
                if edge.next == startEdgeIndex {
                    prevEdgeIndex = currentEdgeIndex;
                    break;
                }
                currentEdgeIndex = edge.next;
                if !(currentEdgeIndex != startEdgeIndex) { break; }
            }
            currentEdgeIndex = startEdgeIndex;
            while true {
                b3HullHalfEdge* edge = edges + currentEdgeIndex;
                u8 nextIndex = edge.next;
                edge.next = prevEdgeIndex;
                if currentEdgeIndex < edge.twin {
                    b3HullHalfEdge* twin = edges + edge.twin;
                    while true {
                        noinit u8[sizeof(edge.origin)] B3_SWAP_TEMP;
                        memcpy(B3_SWAP_TEMP, &edge.origin, cast(u64, sizeof(edge.origin)));
                        memcpy(&edge.origin, &twin.origin, cast(u64, sizeof(edge.origin)));
                        memcpy(&twin.origin, B3_SWAP_TEMP, cast(u64, sizeof(edge.origin)));
                        if !(0 != 0) { break; }
                    }
                }
                prevEdgeIndex = currentEdgeIndex;
                currentEdgeIndex = nextIndex;
                if !(currentEdgeIndex != startEdgeIndex) { break; }
            }
        }
        b3HullVertex* vertices = b3GetHullVerticesWrite(hull);
        for i32 i = 0; i < vertexCount; ++i {
            b3HullVertex* vertex = vertices + i;
            b3HullHalfEdge* edge = edges + vertex.edge;
            vertex.edge = edge.twin;
        }
    }
    b3Matrix3 matrix = b3MakeMatrixFromQuat(transform.q);
    b3Vec3* points = b3GetHullPointsWrite(hull);
    i32 soaVertexCount = vertexCount + 3 & ~3;
    f32* vx = b3GetHullSoaVerticesWrite(hull);
    f32* vy = vx + soaVertexCount;
    f32* vz = vy + soaVertexCount;
    for i32 i = 0; i < vertexCount; ++i {
        b3Vec3 p = b3Add(b3MulMV(matrix, b3Mul(safeScale, points[i])), transform.p);
        points[i] = p;
        vx[i] = p.x;
        vy[i] = p.y;
        vz[i] = p.z;
    }
    for i32 i = vertexCount; i < soaVertexCount; ++i {
        vx[i] = vx[0];
        vy[i] = vy[0];
        vz[i] = vz[0];
    }
    b3Plane* planes = b3GetHullPlanesWrite(hull);
    i32 soaNormalCount = faceCount + 3 & ~3;
    f32* nx = b3GetHullSoaNormalsWrite(hull);
    f32* ny = nx + soaNormalCount;
    f32* nz = ny + soaNormalCount;
    for i32 i = 0; i < faceCount; ++i {
        i32 count = 0;
        b3Vec3 centroid = b3Vec3_zero;
        b3Vec3 normal = b3Vec3_zero;
        b3HullFace* face = faces + i;
        u8 startEdgeIndex = face.edge;
        u8 currentEdgeIndex = startEdgeIndex;
        b3HullHalfEdge* startEdge = edges + currentEdgeIndex;
        b3Vec3 origin = points[startEdge.origin];
        while true {
            b3HullHalfEdge* edge = edges + currentEdgeIndex;
            b3HullHalfEdge* twin = edges + edge.twin;
            b3Vec3 v1 = b3Sub(points[edge.origin], origin);
            b3Vec3 v2 = b3Sub(points[twin.origin], origin);
            count++;
            centroid = b3Add(centroid, v1);
            normal.x += (v1.y - v2.y) * (v1.z + v2.z);
            normal.y += (v1.z - v2.z) * (v1.x + v2.x);
            normal.z += (v1.x - v2.x) * (v1.y + v2.y);
            currentEdgeIndex = edge.next;
            if !(currentEdgeIndex != startEdgeIndex) { break; }
        }
        centroid = b3MulSV(1.0f / cast(f32, count), centroid);
        centroid = b3Add(centroid, origin);
        f32 area = b3Length(normal);
        normal = b3MulSV(1.0f / area, normal);
        planes[i] = b3MakePlaneFromNormalAndPoint(normal, centroid);
        nx[i] = normal.x;
        ny[i] = normal.y;
        nz[i] = normal.z;
    }
    for i32 i = faceCount; i < soaNormalCount; ++i {
        nx[i] = 0.0f;
        ny[i] = 0.0f;
        nz[i] = 0.0f;
    }
    b3UpdateHullBounds(hull);
    bool success = b3UpdateHullBulkProperties(hull);
    if success == false {
        b3Free(hull, cast(u64, original.byteCount));
        return null;
    }
    hull.hash = 0;
    hull.hash = b3NonZeroHash(b3Hash(5381, cast(u8*, hull), hull.byteCount));
    return hull;
}

void b3DestroyHull(b3HullData* hull) {
    b3Free(hull, cast(u64, hull.byteCount));
}

b3MassData b3ComputeHullMass(b3HullData* shape, f32 density) {
    noinit b3MassData out;
    out.mass = density * shape.volume;
    out.center = shape.center;
    out.inertia = b3MulSM(density, shape.centralInertia);
    return out;
}

b3AABB b3ComputeHullAABB(b3HullData* shape, b3Transform transform) {
    return b3AABB_Transform(transform, shape.aabb);
}

b3AABB b3ComputeSweptHullAABB(b3HullData* shape, b3Transform xf1, b3Transform xf2) {
    b3AABB aabb1 = b3AABB_Transform(xf1, shape.aabb);
    b3AABB aabb2 = b3AABB_Transform(xf2, shape.aabb);
    return b3AABB_Union(aabb1, aabb2);
}

bool b3OverlapHull(b3HullData* shape, b3Transform shapeTransform, b3ShapeProxy* proxy) {
    b3Vec3* points = b3GetHullPoints(shape);
    noinit b3DistanceInput input;
    input.proxyA = b3ShapeProxy{points, shape.vertexCount, 0.0f};
    input.proxyB = *proxy;
    input.transform = b3InvMulTransforms(shapeTransform, b3Transform_identity);
    input.useRadii = true;
    b3SimplexCache cache;
    b3DistanceOutput output = b3ShapeDistance(&input, &cache, null, 0);
    return output.distance < 0.1f * (0.005f * b3GetLengthUnitsPerMeter());
}

b3CastOutput b3RayCastHull(b3HullData* shape, b3RayCastInput* input) {
    b3CastOutput output;
    f32 lower = 0.0f;
    f32 upper = input.maxFraction;
    i32 bestFace = -1;
    b3Plane* planes = b3GetHullPlanes(shape);
    for i32 faceIndex = 0; faceIndex < shape.faceCount; ++faceIndex {
        b3Plane plane = planes[faceIndex];
        f32 distance = plane.offset - b3Dot(plane.normal, input.origin);
        f32 denominator = b3Dot(plane.normal, input.translation);
        if denominator == 0.0f {
            if distance < 0.0f {
                return output;
            }
        } else {
            f32 fraction = distance / denominator;
            if denominator < 0.0f {
                if fraction > lower {
                    bestFace = faceIndex;
                    lower = fraction;
                }
            } else {
                if fraction < upper {
                    upper = fraction;
                }
            }
            if upper < lower {
                return output;
            }
        }
    }
    if bestFace >= 0 {
        output.point = b3Add(input.origin, b3MulSV(lower, input.translation));
        output.normal = planes[bestFace].normal;
        output.fraction = lower;
        output.hit = true;
    } else {
        output.point = input.origin;
        output.hit = true;
    }
    return output;
}

b3CastOutput b3ShapeCastHull(b3HullData* shape, b3ShapeCastInput* input) {
    b3Vec3* points = b3GetHullPoints(shape);
    noinit b3ShapeCastPairInput pairInput;
    pairInput.proxyA = b3ShapeProxy{points, shape.vertexCount, 0.0f};
    pairInput.proxyB = input.proxy;
    pairInput.transform = b3Transform_identity;
    pairInput.translationB = input.translation;
    pairInput.maxFraction = input.maxFraction;
    pairInput.canEncroach = input.canEncroach;
    b3CastOutput output = b3ShapeCast(&pairInput);
    return output;
}

i32 b3CollideMoverAndHull(b3PlaneResult* result, b3HullData* shape, b3Capsule* mover) {
    b3Vec3* points = b3GetHullPoints(shape);
    noinit b3DistanceInput distanceInput;
    distanceInput.proxyA = b3ShapeProxy{points, shape.vertexCount, 0.0f};
    distanceInput.proxyB = b3ShapeProxy{&mover.center1, 2, mover.radius};
    distanceInput.transform = b3Transform_identity;
    distanceInput.useRadii = false;
    f32 totalRadius = mover.radius;
    b3SimplexCache cache;
    b3DistanceOutput distanceOutput = b3ShapeDistance(&distanceInput, &cache, null, 0);
    if distanceOutput.distance == 0.0f {
        return 0;
    }
    if distanceOutput.distance <= totalRadius {
        var plane = b3Plane{distanceOutput.normal, totalRadius - distanceOutput.distance};
        *result = b3PlaneResult{plane, distanceOutput.pointA};
        return 1;
    }
    return 0;
}

b3ShapeExtent b3ComputeHullExtent(b3HullData* hull, b3Vec3 origin) {
    b3Vec3* points = b3GetHullPoints(hull);
    noinit b3ShapeExtent extent;
    extent.minExtent = hull.innerRadius;
    extent.maxExtent = b3Vec3_zero;
    for i32 index = 0; index < hull.vertexCount; ++index {
        b3Vec3 point = points[index];
        extent.maxExtent = b3Max(extent.maxExtent, b3Abs(b3Sub(point, origin)));
    }
    return extent;
}

f32 b3ComputeHullProjectedArea(b3HullData* hull, b3Vec3 direction) {
    f32 area = 0.0f;
    i32 faceCount = hull.faceCount;
    b3HullFace* hullFaces = b3GetHullFaces(hull);
    b3HullHalfEdge* hullEdges = b3GetHullEdges(hull);
    b3Vec3* hullPoints = b3GetHullPoints(hull);
    for i32 i = 0; i < faceCount; ++i {
        b3HullFace* face = hullFaces + i;
        var baseEdge = cast(i32, face.edge);
        b3HullHalfEdge* edge = hullEdges + baseEdge;
        b3Vec3 p1 = hullPoints[edge.origin];
        var edgeIndex = cast(i32, edge.next);
        edge = hullEdges + edgeIndex;
        b3Vec3 p2 = hullPoints[edge.origin];
        edgeIndex = cast(i32, edge.next);
        while true {
            edge = hullEdges + edgeIndex;
            b3Vec3 p3 = hullPoints[edge.origin];
            b3Vec3 e1 = b3Sub(p2, p1);
            b3Vec3 e2 = b3Sub(p3, p1);
            b3Vec3 n = b3Cross(e1, e2);
            f32 a = b3Dot(n, direction);
            area += b3MaxFloat(a, 0.0f);
            p2 = p3;
            edgeIndex = cast(i32, edge.next);
            if !(edgeIndex != baseEdge) { break; }
        }
    }
    return 0.5f * area;
}
// Constant template box (vertex/edge/face/topology). b3MakeTransformedBoxHull copies and
// fills in the runtime-dependent fields (boxPoints, boxPlanes, aabb, mass properties, hash).
private {
b3BoxHull s_boxHull = b3BoxHull{
    .base = b3HullData{
        .version = 0xDA5150191B994C01,
        .byteCount = cast(i32, sizeof(b3BoxHull)),
        .hash = 0,
        .vertexCount = 8,
        .edgeCount = 24,
        .faceCount = 6,
        .vertexOffset = cast(u32, &cast(b3BoxHull*, 0).boxVertices),
        .pointOffset = cast(u32, &cast(b3BoxHull*, 0).boxPoints),
        .edgeOffset = cast(u32, &cast(b3BoxHull*, 0).boxEdges),
        .planeOffset = cast(u32, &cast(b3BoxHull*, 0).boxPlanes),
        .faceOffset = cast(u32, &cast(b3BoxHull*, 0).boxFaces),
        .soaVertexOffset = cast(u32, &cast(b3BoxHull*, 0).vx),
        .soaNormalOffset = cast(u32, &cast(b3BoxHull*, 0).nx),
    },
    .boxVertices = {
        b3HullVertex{.edge = 8},
        b3HullVertex{.edge = 1},
        b3HullVertex{.edge = 0},
        b3HullVertex{.edge = 9},
        b3HullVertex{.edge = 13},
        b3HullVertex{.edge = 3},
        b3HullVertex{.edge = 5},
        b3HullVertex{.edge = 11},
    },
    .boxEdges = {
        b3HullHalfEdge{2, 1, 2, 0},
        b3HullHalfEdge{17, 0, 1, 5},
        b3HullHalfEdge{4, 3, 1, 0},
        b3HullHalfEdge{20, 2, 5, 3},
        b3HullHalfEdge{6, 5, 5, 0},
        b3HullHalfEdge{23, 4, 6, 4},
        b3HullHalfEdge{0, 7, 6, 0},
        b3HullHalfEdge{18, 6, 2, 2},
        b3HullHalfEdge{10, 9, 0, 1},
        b3HullHalfEdge{21, 8, 3, 5},
        b3HullHalfEdge{12, 11, 3, 1},
        b3HullHalfEdge{16, 10, 7, 2},
        b3HullHalfEdge{14, 13, 7, 1},
        b3HullHalfEdge{19, 12, 4, 4},
        b3HullHalfEdge{8, 15, 4, 1},
        b3HullHalfEdge{22, 14, 0, 3},
        b3HullHalfEdge{7, 17, 3, 2},
        b3HullHalfEdge{9, 16, 2, 5},
        b3HullHalfEdge{11, 19, 6, 2},
        b3HullHalfEdge{5, 18, 7, 4},
        b3HullHalfEdge{15, 21, 1, 3},
        b3HullHalfEdge{1, 20, 0, 5},
        b3HullHalfEdge{3, 23, 4, 3},
        b3HullHalfEdge{13, 22, 5, 4},
    },
    .boxFaces = {
        b3HullFace{.edge = 0},
        b3HullFace{.edge = 8},
        b3HullFace{.edge = 16},
        b3HullFace{.edge = 20},
        b3HullFace{.edge = 19},
        b3HullFace{.edge = 21},
    },
};
}

b3BoxHull b3MakeTransformedBoxHull(f32 hx, f32 hy, f32 hz, b3Transform transform) {
    b3BoxHull boxHull = s_boxHull;
    f32 minH = 0.2f * (0.005f * b3GetLengthUnitsPerMeter());
    b3Vec3 h = b3Max(b3Vec3{minH, minH, minH}, b3Vec3{hx, hy, hz});
    boxHull.base.aabb = b3AABB_Transform(transform, b3AABB{b3Neg(h), h});
    boxHull.base.surfaceArea = 8.0f * (h.x * h.y + h.x * h.z + h.y * h.z);
    boxHull.base.volume = 8.0f * h.x * h.y * h.z;
    boxHull.base.innerRadius = b3MinFloat(h.x, b3MinFloat(h.y, h.z));
    boxHull.base.center = transform.p;
    b3Matrix3 boxInertia = b3BoxInertia(boxHull.base.volume, b3Neg(h), h);
    boxHull.base.centralInertia = b3RotateInertia(transform.q, boxInertia);
    b3Vec3 lower = b3Neg(h);
    b3Vec3 upper = h;
    boxHull.boxPlanes[0] = b3TransformPlane(transform, b3MakePlaneFromNormalAndPoint(b3Neg(b3Vec3_axisX), lower));
    boxHull.boxPlanes[1] = b3TransformPlane(transform, b3MakePlaneFromNormalAndPoint(b3Vec3_axisX, upper));
    boxHull.boxPlanes[2] = b3TransformPlane(transform, b3MakePlaneFromNormalAndPoint(b3Neg(b3Vec3_axisY), lower));
    boxHull.boxPlanes[3] = b3TransformPlane(transform, b3MakePlaneFromNormalAndPoint(b3Vec3_axisY, upper));
    boxHull.boxPlanes[4] = b3TransformPlane(transform, b3MakePlaneFromNormalAndPoint(b3Neg(b3Vec3_axisZ), lower));
    boxHull.boxPlanes[5] = b3TransformPlane(transform, b3MakePlaneFromNormalAndPoint(b3Vec3_axisZ, upper));
    boxHull.boxPoints[0] = b3TransformPoint(transform, b3Vec3{h.x, h.y, h.z});
    boxHull.boxPoints[1] = b3TransformPoint(transform, b3Vec3{-h.x, h.y, h.z});
    boxHull.boxPoints[2] = b3TransformPoint(transform, b3Vec3{-h.x, -h.y, h.z});
    boxHull.boxPoints[3] = b3TransformPoint(transform, b3Vec3{h.x, -h.y, h.z});
    boxHull.boxPoints[4] = b3TransformPoint(transform, b3Vec3{h.x, h.y, -h.z});
    boxHull.boxPoints[5] = b3TransformPoint(transform, b3Vec3{-h.x, h.y, -h.z});
    boxHull.boxPoints[6] = b3TransformPoint(transform, b3Vec3{-h.x, -h.y, -h.z});
    boxHull.boxPoints[7] = b3TransformPoint(transform, b3Vec3{h.x, -h.y, -h.z});
    boxHull.vx[0] = boxHull.boxPoints[0].x;
    boxHull.vx[1] = boxHull.boxPoints[1].x;
    boxHull.vx[2] = boxHull.boxPoints[2].x;
    boxHull.vx[3] = boxHull.boxPoints[3].x;
    boxHull.vx[4] = boxHull.boxPoints[4].x;
    boxHull.vx[5] = boxHull.boxPoints[5].x;
    boxHull.vx[6] = boxHull.boxPoints[6].x;
    boxHull.vx[7] = boxHull.boxPoints[7].x;
    boxHull.vy[0] = boxHull.boxPoints[0].y;
    boxHull.vy[1] = boxHull.boxPoints[1].y;
    boxHull.vy[2] = boxHull.boxPoints[2].y;
    boxHull.vy[3] = boxHull.boxPoints[3].y;
    boxHull.vy[4] = boxHull.boxPoints[4].y;
    boxHull.vy[5] = boxHull.boxPoints[5].y;
    boxHull.vy[6] = boxHull.boxPoints[6].y;
    boxHull.vy[7] = boxHull.boxPoints[7].y;
    boxHull.vz[0] = boxHull.boxPoints[0].z;
    boxHull.vz[1] = boxHull.boxPoints[1].z;
    boxHull.vz[2] = boxHull.boxPoints[2].z;
    boxHull.vz[3] = boxHull.boxPoints[3].z;
    boxHull.vz[4] = boxHull.boxPoints[4].z;
    boxHull.vz[5] = boxHull.boxPoints[5].z;
    boxHull.vz[6] = boxHull.boxPoints[6].z;
    boxHull.vz[7] = boxHull.boxPoints[7].z;
    boxHull.nx[0] = boxHull.boxPlanes[0].normal.x;
    boxHull.nx[1] = boxHull.boxPlanes[1].normal.x;
    boxHull.nx[2] = boxHull.boxPlanes[2].normal.x;
    boxHull.nx[3] = boxHull.boxPlanes[3].normal.x;
    boxHull.nx[4] = boxHull.boxPlanes[4].normal.x;
    boxHull.nx[5] = boxHull.boxPlanes[5].normal.x;
    boxHull.nx[6] = 0.0f;
    boxHull.nx[7] = 0.0f;
    boxHull.ny[0] = boxHull.boxPlanes[0].normal.y;
    boxHull.ny[1] = boxHull.boxPlanes[1].normal.y;
    boxHull.ny[2] = boxHull.boxPlanes[2].normal.y;
    boxHull.ny[3] = boxHull.boxPlanes[3].normal.y;
    boxHull.ny[4] = boxHull.boxPlanes[4].normal.y;
    boxHull.ny[5] = boxHull.boxPlanes[5].normal.y;
    boxHull.ny[6] = 0.0f;
    boxHull.ny[7] = 0.0f;
    boxHull.nz[0] = boxHull.boxPlanes[0].normal.z;
    boxHull.nz[1] = boxHull.boxPlanes[1].normal.z;
    boxHull.nz[2] = boxHull.boxPlanes[2].normal.z;
    boxHull.nz[3] = boxHull.boxPlanes[3].normal.z;
    boxHull.nz[4] = boxHull.boxPlanes[4].normal.z;
    boxHull.nz[5] = boxHull.boxPlanes[5].normal.z;
    boxHull.nz[6] = 0.0f;
    boxHull.nz[7] = 0.0f;
    boxHull.base.hash = 0;
    boxHull.base.hash = b3NonZeroHash(b3Hash(5381, cast(u8*, &boxHull), cast(i32, sizeof(b3BoxHull))));
    return boxHull;
}

b3BoxHull b3MakeCubeHull(f32 halfWidth) {
    return b3MakeBoxHull(halfWidth, halfWidth, halfWidth);
}

b3BoxHull b3MakeOffsetBoxHull(f32 hx, f32 hy, f32 hz, b3Vec3 offset) {
    var transform = b3Transform{.p = offset, .q = b3Quat_identity};
    return b3MakeTransformedBoxHull(hx, hy, hz, transform);
}

b3BoxHull b3MakeBoxHull(f32 hx, f32 hy, f32 hz) {
    return b3MakeTransformedBoxHull(hx, hy, hz, b3Transform_identity);
}

void b3ScaleBox(b3Vec3* halfWidths, b3Transform* transform, b3Vec3 postScale, f32 minHalfWidth) {
    b3Quat q = transform.q;
    if postScale.x < 0.0f || postScale.y < 0.0f || postScale.z < 0.0f {
        b3Matrix3 m = b3MakeMatrixFromQuat(q);
        m.cx.x *= postScale.x;
        m.cy.x *= postScale.x;
        m.cz.x *= postScale.x;
        m.cx.y *= postScale.y;
        m.cy.y *= postScale.y;
        m.cz.y *= postScale.y;
        m.cx.z *= postScale.z;
        m.cy.z *= postScale.z;
        m.cz.z *= postScale.z;
        m.cx = b3Normalize(m.cx);
        m.cy = b3Normalize(m.cy);
        m.cz = b3Normalize(m.cz);
        m.cx = postScale.x < 0.0f ? b3Neg(m.cx) : m.cx;
        m.cy = postScale.y < 0.0f ? b3Neg(m.cy) : m.cy;
        m.cz = postScale.z < 0.0f ? b3Neg(m.cz) : m.cz;
        q = b3MakeQuatFromMatrix(&m);
    }
    b3Vec3 absScale = b3Abs(postScale);
    b3Vec3 h = *halfWidths;
    b3Vec3 p1 = b3Mul(absScale, b3RotateVector(q, b3Neg(h)));
    b3Vec3 p2 = b3Mul(absScale, b3RotateVector(q, h));
    b3Vec3 localP1 = b3InvRotateVector(q, p1);
    b3Vec3 localP2 = b3InvRotateVector(q, p2);
    b3Vec3 lower = b3Min(localP1, localP2);
    b3Vec3 upper = b3Max(localP1, localP2);
    b3Vec3 scaledHalfWidth = b3MulSV(0.5f, b3Sub(upper, lower));
    var mLimit = b3Vec3{minHalfWidth, minHalfWidth, minHalfWidth};
    *halfWidths = b3Max(scaledHalfWidth, mLimit);
    transform.p = b3Mul(postScale, transform.p);
    transform.q = q;
}

// todo use new hull scaling technique
b3BoxHull b3MakeScaledBoxHull(b3Vec3 halfWidths, b3Transform transform, b3Vec3 postScale) {
    b3Vec3 h = halfWidths;
    b3Transform xf = transform;
    b3ScaleBox(&h, &xf, postScale, 4.0f * (0.005f * b3GetLengthUnitsPerMeter()));
    return b3MakeTransformedBoxHull(h.x, h.y, h.z, xf);
}

// SPDX-FileCopyrightText: 2025 Erin Catto
// SPDX-License-Identifier: MIT
b3IdPool b3CreateIdPool() {
    b3IdPool pool;
    while true {
        if pool.freeArray.capacity < 32 {
            var oldSize = cast(i32, pool.freeArray.capacity * sizeof(*pool.freeArray.data));
            var newSize = cast(i32, 32 * sizeof(*pool.freeArray.data));
            pool.freeArray.data = b3GrowAlloc(pool.freeArray.data, oldSize, newSize);
            pool.freeArray.capacity = 32;
        }
        if !(0 != 0) { break; }
    }
    return pool;
}

void b3DestroyIdPool(b3IdPool* pool) {
    while true {
        b3Free(pool.freeArray.data, cast(u64, pool.freeArray.capacity * sizeof(*pool.freeArray.data)));
        pool.freeArray.data = null;
        pool.freeArray.count = 0;
        pool.freeArray.capacity = 0;
        if !(0 != 0) { break; }
    }
    *pool = b3IdPool{};
}

i32 b3AllocId(b3IdPool* pool) {
    i32 count = pool.freeArray.count;
    if count > 0 {
        i32 id = pool.freeArray.data[-1 + pool.freeArray.count--];
        return id;
    }
    i32 id = pool.nextIndex;
    pool.nextIndex += 1;
    return id;
}

void b3FreeId(b3IdPool* pool, i32 id) {
    if id == pool.nextIndex {
        pool.nextIndex -= 1;
        return;
    }
    while true {
        if pool.freeArray.count >= pool.freeArray.capacity {
            var oldSize = cast(i32, pool.freeArray.capacity * sizeof(*pool.freeArray.data));
            i32 newCapacity = pool.freeArray.capacity == 0 ? 8 : 2 * pool.freeArray.capacity;
            var newSize = cast(i32, newCapacity * sizeof(*pool.freeArray.data));
            pool.freeArray.data = b3GrowAlloc(pool.freeArray.data, oldSize, newSize);
            pool.freeArray.capacity = newCapacity;
        }
        pool.freeArray.data[pool.freeArray.count++] = id;
        if !(0 != 0) { break; }
    }
}

void b3ValidateFreeId(b3IdPool* pool, i32 id) {
    ignore pool;
    ignore id;
}

// SPDX-FileCopyrightText: 2025 Erin Catto
// SPDX-License-Identifier: MIT
b3Island* b3CreateIsland(b3World* world, i32 setIndex) {
    i32 islandId = b3AllocId(&world.islandIdPool);
    if islandId == world.islands.count {
        b3Island emptyIsland;
        while true {
            if world.islands.count >= world.islands.capacity {
                var oldSize = cast(i32, world.islands.capacity * sizeof(*world.islands.data));
                i32 newCapacity = world.islands.capacity == 0 ? 8 : 2 * world.islands.capacity;
                var newSize = cast(i32, newCapacity * sizeof(*world.islands.data));
                world.islands.data = b3GrowAlloc(world.islands.data, oldSize, newSize);
                world.islands.capacity = newCapacity;
            }
            world.islands.data[world.islands.count++] = emptyIsland;
            if !(0 != 0) { break; }
        }
    } else {
    }
    b3SolverSet* set = world.solverSets.data + setIndex;
    b3Island* island = world.islands.data + islandId;
    island.setIndex = setIndex;
    island.localIndex = set.islandSims.count;
    island.islandId = islandId;
    while true {
        island.bodies.data = null;
        island.bodies.count = 0;
        island.bodies.capacity = 0;
        if !(0 != 0) { break; }
    }
    while true {
        island.contacts.data = null;
        island.contacts.count = 0;
        island.contacts.capacity = 0;
        if !(0 != 0) { break; }
    }
    while true {
        island.joints.data = null;
        island.joints.count = 0;
        island.joints.capacity = 0;
        if !(0 != 0) { break; }
    }
    island.constraintRemoveCount = 0;
    b3IslandSim* islandSim = b3EmplaceHelper(cast(void**, &set.islandSims.data), &set.islandSims.count, &set.islandSims.capacity, cast(i32, sizeof(*set.islandSims.data)));
    islandSim.islandId = islandId;
    return island;
}

void b3DestroyIsland(b3World* world, i32 islandId) {
    if world.splitIslandId == islandId {
        world.splitIslandId = -1;
    }
    b3Island* island = world.islands.data + islandId;
    b3SolverSet* set = world.solverSets.data + island.setIndex;
    {
        i32 localIndex = island.localIndex;
        i32 lastIndex = set.islandSims.count - 1;
        i32 moveIslandId = set.islandSims.data[lastIndex].islandId;
        set.islandSims.data[localIndex] = set.islandSims.data[lastIndex];
        world.islands.data[moveIslandId].localIndex = localIndex;
        set.islandSims.count -= 1;
    }
    while true {
        b3Free(island.bodies.data, cast(u64, island.bodies.capacity * sizeof(*island.bodies.data)));
        island.bodies.data = null;
        island.bodies.count = 0;
        island.bodies.capacity = 0;
        if !(0 != 0) { break; }
    }
    while true {
        b3Free(island.contacts.data, cast(u64, island.contacts.capacity * sizeof(*island.contacts.data)));
        island.contacts.data = null;
        island.contacts.count = 0;
        island.contacts.capacity = 0;
        if !(0 != 0) { break; }
    }
    while true {
        b3Free(island.joints.data, cast(u64, island.joints.capacity * sizeof(*island.joints.data)));
        island.joints.data = null;
        island.joints.count = 0;
        island.joints.capacity = 0;
        if !(0 != 0) { break; }
    }
    island.constraintRemoveCount = 0;
    island.localIndex = -1;
    island.islandId = -1;
    island.setIndex = -1;
    b3FreeId(&world.islandIdPool, islandId);
}

private {
i32 b3MergeIslands(b3World* world, i32 islandIdA, i32 islandIdB) {
    if islandIdA == islandIdB {
        return islandIdA;
    }
    if islandIdA == -1 {
        return islandIdB;
    }
    if islandIdB == -1 {
        return islandIdA;
    }
    b3Island* smallIsland;
    b3Island* bigIsland;
    {
        b3Island* islandA = world.islands.data + islandIdA;
        b3Island* islandB = world.islands.data + islandIdB;
        if islandA.bodies.count >= islandB.bodies.count {
            bigIsland = islandA;
            smallIsland = islandB;
        } else {
            bigIsland = islandB;
            smallIsland = islandA;
        }
    }
    i32 bigIslandId = bigIsland.islandId;
    while true {
        if bigIsland.bodies.capacity < bigIsland.bodies.count + smallIsland.bodies.count {
            var oldSize = cast(i32, bigIsland.bodies.capacity * sizeof(*bigIsland.bodies.data));
            var newSize = cast(i32, (bigIsland.bodies.count + smallIsland.bodies.count) * sizeof(*bigIsland.bodies.data));
            bigIsland.bodies.data = b3GrowAlloc(bigIsland.bodies.data, oldSize, newSize);
            bigIsland.bodies.capacity = bigIsland.bodies.count + smallIsland.bodies.count;
        }
        if !(0 != 0) { break; }
    }
    for i32 i = 0; i < smallIsland.bodies.count; ++i {
        i32 bodyId = smallIsland.bodies.data[i];
        b3Body* body = world.bodies.data + bodyId;
        body.islandId = bigIslandId;
        body.islandIndex = bigIsland.bodies.count;
        while true {
            if bigIsland.bodies.count >= bigIsland.bodies.capacity {
                var oldSize = cast(i32, bigIsland.bodies.capacity * sizeof(*bigIsland.bodies.data));
                i32 newCapacity = bigIsland.bodies.capacity == 0 ? 8 : 2 * bigIsland.bodies.capacity;
                var newSize = cast(i32, newCapacity * sizeof(*bigIsland.bodies.data));
                bigIsland.bodies.data = b3GrowAlloc(bigIsland.bodies.data, oldSize, newSize);
                bigIsland.bodies.capacity = newCapacity;
            }
            bigIsland.bodies.data[bigIsland.bodies.count++] = bodyId;
            if !(0 != 0) { break; }
        }
    }
    if smallIsland.contacts.count > 0 {
        while true {
            if bigIsland.contacts.capacity < bigIsland.contacts.count + smallIsland.contacts.count {
                var oldSize = cast(i32, bigIsland.contacts.capacity * sizeof(*bigIsland.contacts.data));
                var newSize = cast(i32, (bigIsland.contacts.count + smallIsland.contacts.count) * sizeof(*bigIsland.contacts.data));
                bigIsland.contacts.data = b3GrowAlloc(bigIsland.contacts.data, oldSize, newSize);
                bigIsland.contacts.capacity = bigIsland.contacts.count + smallIsland.contacts.count;
            }
            if !(0 != 0) { break; }
        }
        for i32 i = 0; i < smallIsland.contacts.count; ++i {
            b3ContactLink* link = smallIsland.contacts.data + i;
            b3Contact* contact = world.contacts.data + link.contactId;
            contact.islandId = bigIslandId;
            contact.islandIndex = bigIsland.contacts.count;
            while true {
                if bigIsland.contacts.count >= bigIsland.contacts.capacity {
                    var oldSize = cast(i32, bigIsland.contacts.capacity * sizeof(*bigIsland.contacts.data));
                    i32 newCapacity = bigIsland.contacts.capacity == 0 ? 8 : 2 * bigIsland.contacts.capacity;
                    var newSize = cast(i32, newCapacity * sizeof(*bigIsland.contacts.data));
                    bigIsland.contacts.data = b3GrowAlloc(bigIsland.contacts.data, oldSize, newSize);
                    bigIsland.contacts.capacity = newCapacity;
                }
                bigIsland.contacts.data[bigIsland.contacts.count++] = *link;
                if !(0 != 0) { break; }
            }
        }
    }
    if smallIsland.joints.count > 0 {
        while true {
            if bigIsland.joints.capacity < bigIsland.joints.count + smallIsland.joints.count {
                var oldSize = cast(i32, bigIsland.joints.capacity * sizeof(*bigIsland.joints.data));
                var newSize = cast(i32, (bigIsland.joints.count + smallIsland.joints.count) * sizeof(*bigIsland.joints.data));
                bigIsland.joints.data = b3GrowAlloc(bigIsland.joints.data, oldSize, newSize);
                bigIsland.joints.capacity = bigIsland.joints.count + smallIsland.joints.count;
            }
            if !(0 != 0) { break; }
        }
        for i32 i = 0; i < smallIsland.joints.count; ++i {
            b3JointLink* link = smallIsland.joints.data + i;
            b3Joint* joint = world.joints.data + link.jointId;
            joint.islandId = bigIslandId;
            joint.islandIndex = bigIsland.joints.count;
            while true {
                if bigIsland.joints.count >= bigIsland.joints.capacity {
                    var oldSize = cast(i32, bigIsland.joints.capacity * sizeof(*bigIsland.joints.data));
                    i32 newCapacity = bigIsland.joints.capacity == 0 ? 8 : 2 * bigIsland.joints.capacity;
                    var newSize = cast(i32, newCapacity * sizeof(*bigIsland.joints.data));
                    bigIsland.joints.data = b3GrowAlloc(bigIsland.joints.data, oldSize, newSize);
                    bigIsland.joints.capacity = newCapacity;
                }
                bigIsland.joints.data[bigIsland.joints.count++] = *link;
                if !(0 != 0) { break; }
            }
        }
    }
    bigIsland.constraintRemoveCount += smallIsland.constraintRemoveCount;
    b3DestroyIsland(world, smallIsland.islandId);
    b3ValidateIsland(world, bigIslandId);
    return bigIslandId;
}

void b3AddContactToIsland(b3World* world, i32 islandId, b3Contact* contact) {
    b3Island* island = world.islands.data + islandId;
    contact.islandId = islandId;
    contact.islandIndex = island.contacts.count;
    noinit b3ContactLink link;
    link.contactId = contact.contactId;
    link.bodyIdA = contact.edges[0].bodyId;
    link.bodyIdB = contact.edges[1].bodyId;
    while true {
        if island.contacts.count >= island.contacts.capacity {
            var oldSize = cast(i32, island.contacts.capacity * sizeof(*island.contacts.data));
            i32 newCapacity = island.contacts.capacity == 0 ? 8 : 2 * island.contacts.capacity;
            var newSize = cast(i32, newCapacity * sizeof(*island.contacts.data));
            island.contacts.data = b3GrowAlloc(island.contacts.data, oldSize, newSize);
            island.contacts.capacity = newCapacity;
        }
        island.contacts.data[island.contacts.count++] = link;
        if !(0 != 0) { break; }
    }
    b3ValidateIsland(world, islandId);
}
}

// Link a contact into an island.
void b3LinkContact(b3World* world, b3Contact* contact) {
    i32 bodyIdA = contact.edges[0].bodyId;
    i32 bodyIdB = contact.edges[1].bodyId;
    b3Body* bodyA = world.bodies.data + bodyIdA;
    b3Body* bodyB = world.bodies.data + bodyIdB;
    if bodyA.setIndex == b3_awakeSet && bodyB.setIndex >= b3_firstSleepingSet {
        b3WakeSolverSet(world, bodyB.setIndex);
    }
    if bodyB.setIndex == b3_awakeSet && bodyA.setIndex >= b3_firstSleepingSet {
        b3WakeSolverSet(world, bodyA.setIndex);
    }
    i32 islandIdA = bodyA.islandId;
    i32 islandIdB = bodyB.islandId;
    i32 finalIslandId = b3MergeIslands(world, islandIdA, islandIdB);
    b3AddContactToIsland(world, finalIslandId, contact);
}

// This is called when a contact no longer has contact points or when a contact is destroyed.
void b3UnlinkContact(b3World* world, b3Contact* contact) {
    i32 islandId = contact.islandId;
    b3Island* island = world.islands.data + islandId;
    i32 removeIndex = contact.islandIndex;
    i32 movedIndex = b3RemoveHelper(island.contacts.data, &island.contacts.count, removeIndex, cast(i32, sizeof(*island.contacts.data)));
    if movedIndex != -1 {
        b3ContactLink* movedLink = island.contacts.data + removeIndex;
        b3Contact* movedContact = world.contacts.data + movedLink.contactId;
        movedContact.islandIndex = removeIndex;
    }
    contact.islandId = -1;
    contact.islandIndex = -1;
    island.constraintRemoveCount += 1;
    b3ValidateIsland(world, islandId);
}

private {
void b3AddJointToIsland(b3World* world, i32 islandId, b3Joint* joint) {
    b3Island* island = world.islands.data + islandId;
    joint.islandId = islandId;
    joint.islandIndex = island.joints.count;
    noinit b3JointLink link;
    link.jointId = joint.jointId;
    link.bodyIdA = joint.edges[0].bodyId;
    link.bodyIdB = joint.edges[1].bodyId;
    while true {
        if island.joints.count >= island.joints.capacity {
            var oldSize = cast(i32, island.joints.capacity * sizeof(*island.joints.data));
            i32 newCapacity = island.joints.capacity == 0 ? 8 : 2 * island.joints.capacity;
            var newSize = cast(i32, newCapacity * sizeof(*island.joints.data));
            island.joints.data = b3GrowAlloc(island.joints.data, oldSize, newSize);
            island.joints.capacity = newCapacity;
        }
        island.joints.data[island.joints.count++] = link;
        if !(0 != 0) { break; }
    }
    b3ValidateIsland(world, islandId);
}
}

void b3LinkJoint(b3World* world, b3Joint* joint) {
    b3Body* bodyA = world.bodies.data + joint.edges[0].bodyId;
    b3Body* bodyB = world.bodies.data + joint.edges[1].bodyId;
    if bodyA.setIndex == b3_awakeSet && bodyB.setIndex >= b3_firstSleepingSet {
        b3WakeSolverSet(world, bodyB.setIndex);
    } else if bodyB.setIndex == b3_awakeSet && bodyA.setIndex >= b3_firstSleepingSet {
        b3WakeSolverSet(world, bodyA.setIndex);
    }
    i32 islandIdA = bodyA.islandId;
    i32 islandIdB = bodyB.islandId;
    i32 finalIslandId = b3MergeIslands(world, islandIdA, islandIdB);
    b3AddJointToIsland(world, finalIslandId, joint);
}

void b3UnlinkJoint(b3World* world, b3Joint* joint) {
    if joint.islandId == -1 {
        return;
    }
    i32 islandId = joint.islandId;
    b3Island* island = world.islands.data + islandId;
    i32 removeIndex = joint.islandIndex;
    i32 movedIndex = b3RemoveHelper(island.joints.data, &island.joints.count, removeIndex, cast(i32, sizeof(*island.joints.data)));
    if movedIndex != -1 {
        b3JointLink* movedLink = island.joints.data + removeIndex;
        b3Joint* movedJoint = world.joints.data + movedLink.jointId;
        movedJoint.islandIndex = removeIndex;
    }
    joint.islandId = -1;
    joint.islandIndex = -1;
    island.constraintRemoveCount += 1;
    b3ValidateIsland(world, islandId);
}

// Find parent of a node. Use path halving to speed up further queries.
private {
i32 b3IslandFindParent(i32* parents, i32 node) {
    while parents[node] != node {
        i32 grandParent = parents[parents[node]];
        parents[node] = grandParent;
        node = grandParent;
    }
    return node;
}

// Connect the components containing node1 and node2.
// Uses rank to keep tree balanced. Tracks per-component contact and joint counts.
void b3IslandUnion(i32* parents, i32* ranks, i32 node1, i32 node2, i32* contactCounts, i32* jointCounts) {
    i32 root1 = b3IslandFindParent(parents, node1);
    i32 root2 = b3IslandFindParent(parents, node2);
    if root1 != root2 {
        if ranks[root1] < ranks[root2] {
            parents[root1] = root2;
            contactCounts[root2] += contactCounts[root1];
            jointCounts[root2] += jointCounts[root1];
        } else if ranks[root1] > ranks[root2] {
            parents[root2] = root1;
            contactCounts[root1] += contactCounts[root2];
            jointCounts[root1] += jointCounts[root2];
        } else {
            parents[root2] = root1;
            ranks[root1] += 1;
            contactCounts[root1] += contactCounts[root2];
            jointCounts[root1] += jointCounts[root2];
        }
    }
}
}

// This uses union-find.
// https://en.wikipedia.org/wiki/Disjoint-set_data_structure
void b3SplitIsland(b3World* world, i32 baseId) {
    b3Island* baseIsland = world.islands.data + baseId;
    b3ValidateIsland(world, baseId);
    i32 baseBodyCount = baseIsland.bodies.count;
    i32* baseBodyIds = baseIsland.bodies.data;
    i32 baseBodyCapacity = baseIsland.bodies.capacity;
    i32 baseContactCount = baseIsland.contacts.count;
    b3ContactLink* baseContacts = baseIsland.contacts.data;
    i32 baseContactCapacity = baseIsland.contacts.capacity;
    i32 baseJointCount = baseIsland.joints.count;
    b3JointLink* baseJoints = baseIsland.joints.data;
    i32 baseJointCapacity = baseIsland.joints.capacity;
    b3Stack* alloc_var = &world.stack;  // renamed from: alloc
    i32* parents = b3StackAlloc(alloc_var, cast(i32, baseBodyCount * sizeof(i32)), "parents");
    i32* contactCounts = b3StackAlloc(alloc_var, cast(i32, baseBodyCount * sizeof(i32)), "contact counts");
    i32* jointCounts = b3StackAlloc(alloc_var, cast(i32, baseBodyCount * sizeof(i32)), "joint counts");
    i32* ranks = b3StackAlloc(alloc_var, cast(i32, baseBodyCount * sizeof(i32)), "ranks");
    for i32 i = 0; i < baseBodyCount; ++i {
        parents[i] = i;
        ranks[i] = 0;
        contactCounts[i] = 0;
        jointCounts[i] = 0;
    }
    b3Body* bodies = world.bodies.data;
    for i32 i = 0; i < baseContactCount; ++i {
        i32 bodyIdA = baseContacts[i].bodyIdA;
        i32 bodyIdB = baseContacts[i].bodyIdB;
        b3Body* bodyA = bodies + bodyIdA;
        b3Body* bodyB = bodies + bodyIdB;
        i32 islandIndexA = bodyA.islandIndex;
        i32 islandIndexB = bodyB.islandIndex;
        if islandIndexA != -1 && islandIndexB != -1 {
            b3IslandUnion(parents, ranks, islandIndexA, islandIndexB, contactCounts, jointCounts);
            i32 root = b3IslandFindParent(parents, islandIndexA);
            contactCounts[root] += 1;
        } else {
            i32 islandIndex = islandIndexA != -1 ? islandIndexA : islandIndexB;
            i32 root = b3IslandFindParent(parents, islandIndex);
            contactCounts[root] += 1;
        }
    }
    for i32 i = 0; i < baseJointCount; ++i {
        i32 bodyIdA = baseJoints[i].bodyIdA;
        i32 bodyIdB = baseJoints[i].bodyIdB;
        b3Body* bodyA = bodies + bodyIdA;
        b3Body* bodyB = bodies + bodyIdB;
        i32 islandIndexA = bodyA.islandIndex;
        i32 islandIndexB = bodyB.islandIndex;
        if islandIndexA != -1 && islandIndexB != -1 {
            b3IslandUnion(parents, ranks, islandIndexA, islandIndexB, contactCounts, jointCounts);
            i32 root = b3IslandFindParent(parents, islandIndexA);
            jointCounts[root] += 1;
        } else {
            i32 islandIndex = islandIndexA != -1 ? islandIndexA : islandIndexB;
            i32 root = b3IslandFindParent(parents, islandIndex);
            jointCounts[root] += 1;
        }
    }
    b3StackFree(alloc_var, ranks);
    ranks = null;
    i32 componentCount = 0;
    for i32 i = 0; i < baseBodyCount; ++i {
        parents[i] = b3IslandFindParent(parents, i);
        if parents[i] == i {
            componentCount += 1;
        }
    }
    if componentCount == 1 {
        baseIsland.constraintRemoveCount = 0;
        b3StackFree(alloc_var, jointCounts);
        b3StackFree(alloc_var, contactCounts);
        b3StackFree(alloc_var, parents);
        return;
    }
    baseIsland.bodies.data = null;
    baseIsland.bodies.count = 0;
    baseIsland.bodies.capacity = 0;
    baseIsland.contacts.data = null;
    baseIsland.contacts.count = 0;
    baseIsland.contacts.capacity = 0;
    baseIsland.joints.data = null;
    baseIsland.joints.count = 0;
    baseIsland.joints.capacity = 0;
    baseIsland = null;
    i32* rootMap = b3StackAlloc(alloc_var, cast(i32, baseBodyCount * sizeof(i32)), "root map");
    for i32 i = 0; i < baseBodyCount; ++i {
        rootMap[i] = -1;
    }
    i32* componentBodyCounts = b3StackAlloc(alloc_var, cast(i32, componentCount * sizeof(i32)), "component body counts");
    i32* componentContactCounts = b3StackAlloc(alloc_var, cast(i32, componentCount * sizeof(i32)), "component contact counts");
    i32* componentJointCounts = b3StackAlloc(alloc_var, cast(i32, componentCount * sizeof(i32)), "component joint counts");
    i32 islandCount = 0;
    for i32 i = 0; i < baseBodyCount; ++i {
        i32 rootIndex = parents[i];
        if rootMap[rootIndex] == -1 {
            rootMap[rootIndex] = islandCount;
            componentBodyCounts[islandCount] = 0;
            componentContactCounts[islandCount] = contactCounts[rootIndex];
            componentJointCounts[islandCount] = jointCounts[rootIndex];
            islandCount += 1;
        }
        componentBodyCounts[rootMap[rootIndex]] += 1;
    }
    i32* islandIds = b3StackAlloc(alloc_var, cast(i32, islandCount * sizeof(i32)), "island ids");
    for i32 i = 0; i < islandCount; ++i {
        b3Island* newIsland = b3CreateIsland(world, b3_awakeSet);
        islandIds[i] = newIsland.islandId;
        while true {
            if newIsland.bodies.capacity < componentBodyCounts[i] {
                var oldSize = cast(i32, newIsland.bodies.capacity * sizeof(*newIsland.bodies.data));
                var newSize = cast(i32, componentBodyCounts[i] * sizeof(*newIsland.bodies.data));
                newIsland.bodies.data = b3GrowAlloc(newIsland.bodies.data, oldSize, newSize);
                newIsland.bodies.capacity = componentBodyCounts[i];
            }
            if !(0 != 0) { break; }
        }
        while true {
            if newIsland.contacts.capacity < componentContactCounts[i] {
                var oldSize = cast(i32, newIsland.contacts.capacity * sizeof(*newIsland.contacts.data));
                var newSize = cast(i32, componentContactCounts[i] * sizeof(*newIsland.contacts.data));
                newIsland.contacts.data = b3GrowAlloc(newIsland.contacts.data, oldSize, newSize);
                newIsland.contacts.capacity = componentContactCounts[i];
            }
            if !(0 != 0) { break; }
        }
        while true {
            if newIsland.joints.capacity < componentJointCounts[i] {
                var oldSize = cast(i32, newIsland.joints.capacity * sizeof(*newIsland.joints.data));
                var newSize = cast(i32, componentJointCounts[i] * sizeof(*newIsland.joints.data));
                newIsland.joints.data = b3GrowAlloc(newIsland.joints.data, oldSize, newSize);
                newIsland.joints.capacity = componentJointCounts[i];
            }
            if !(0 != 0) { break; }
        }
    }
    for i32 i = 0; i < baseBodyCount; ++i {
        i32 bodyId = baseBodyIds[i];
        i32 root = b3IslandFindParent(parents, i);
        i32 newIslandId = islandIds[rootMap[root]];
        b3Body* body = world.bodies.data + bodyId;
        b3Island* newIsland = world.islands.data + newIslandId;
        body.islandId = newIslandId;
        body.islandIndex = newIsland.bodies.count;
        while true {
            if newIsland.bodies.count >= newIsland.bodies.capacity {
                var oldSize = cast(i32, newIsland.bodies.capacity * sizeof(*newIsland.bodies.data));
                i32 newCapacity = newIsland.bodies.capacity == 0 ? 8 : 2 * newIsland.bodies.capacity;
                var newSize = cast(i32, newCapacity * sizeof(*newIsland.bodies.data));
                newIsland.bodies.data = b3GrowAlloc(newIsland.bodies.data, oldSize, newSize);
                newIsland.bodies.capacity = newCapacity;
            }
            newIsland.bodies.data[newIsland.bodies.count++] = bodyId;
            if !(0 != 0) { break; }
        }
    }
    for i32 i = 0; i < baseContactCount; ++i {
        b3ContactLink* link = baseContacts + i;
        b3Contact* contact = world.contacts.data + link.contactId;
        b3Body* bodyA = world.bodies.data + link.bodyIdA;
        b3Body* bodyB = world.bodies.data + link.bodyIdB;
        i32 targetIslandId = bodyA.islandId != -1 ? bodyA.islandId : bodyB.islandId;
        b3Island* targetIsland = world.islands.data + targetIslandId;
        contact.islandId = targetIslandId;
        contact.islandIndex = targetIsland.contacts.count;
        while true {
            if targetIsland.contacts.count >= targetIsland.contacts.capacity {
                var oldSize = cast(i32, targetIsland.contacts.capacity * sizeof(*targetIsland.contacts.data));
                i32 newCapacity = targetIsland.contacts.capacity == 0 ? 8 : 2 * targetIsland.contacts.capacity;
                var newSize = cast(i32, newCapacity * sizeof(*targetIsland.contacts.data));
                targetIsland.contacts.data = b3GrowAlloc(targetIsland.contacts.data, oldSize, newSize);
                targetIsland.contacts.capacity = newCapacity;
            }
            targetIsland.contacts.data[targetIsland.contacts.count++] = *link;
            if !(0 != 0) { break; }
        }
    }
    for i32 i = 0; i < baseJointCount; ++i {
        b3JointLink* link = baseJoints + i;
        b3Joint* joint = world.joints.data + link.jointId;
        b3Body* bodyA = world.bodies.data + link.bodyIdA;
        b3Body* bodyB = world.bodies.data + link.bodyIdB;
        i32 targetIslandId = bodyA.islandId != -1 ? bodyA.islandId : bodyB.islandId;
        b3Island* targetIsland = world.islands.data + targetIslandId;
        joint.islandId = targetIslandId;
        joint.islandIndex = targetIsland.joints.count;
        while true {
            if targetIsland.joints.count >= targetIsland.joints.capacity {
                var oldSize = cast(i32, targetIsland.joints.capacity * sizeof(*targetIsland.joints.data));
                i32 newCapacity = targetIsland.joints.capacity == 0 ? 8 : 2 * targetIsland.joints.capacity;
                var newSize = cast(i32, newCapacity * sizeof(*targetIsland.joints.data));
                targetIsland.joints.data = b3GrowAlloc(targetIsland.joints.data, oldSize, newSize);
                targetIsland.joints.capacity = newCapacity;
            }
            targetIsland.joints.data[targetIsland.joints.count++] = *link;
            if !(0 != 0) { break; }
        }
    }
    b3DestroyIsland(world, baseId);
    b3Free(baseBodyIds, cast(u64, baseBodyCapacity * sizeof(i32)));
    b3Free(baseContacts, cast(u64, baseContactCapacity * sizeof(b3ContactLink)));
    b3Free(baseJoints, cast(u64, baseJointCapacity * sizeof(b3JointLink)));
    b3StackFree(alloc_var, islandIds);
    b3StackFree(alloc_var, componentJointCounts);
    b3StackFree(alloc_var, componentContactCounts);
    b3StackFree(alloc_var, componentBodyCounts);
    b3StackFree(alloc_var, rootMap);
    b3StackFree(alloc_var, jointCounts);
    b3StackFree(alloc_var, contactCounts);
    b3StackFree(alloc_var, parents);
}

// Split an island because some contacts and/or joints have been removed.
// This is called during the constraint solve while islands are not being touched. This uses union find and
// touches a lot of memory, so it can be slow.
// Note: contacts/joints connected to static bodies must belong to an island but don't affect island connectivity
// Note: static bodies are never in an island
// Note: this task interacts with some allocators without locks under the assumption that no other tasks
// are interacting with these data structures.
void b3SplitIslandTask(void* context) {
    u64 ticks = b3GetTicks();
    b3World* world = context;
    b3SplitIsland(world, world.splitIslandId);
    world.splitIslandId = -1;
    world.profile.splitIslands += b3GetMilliseconds(ticks);
}

void b3ValidateIsland(b3World* world, i32 islandId) {
    ignore world;
    ignore islandId;
}

// SPDX-FileCopyrightText: 2025 Erin Catto
