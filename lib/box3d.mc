b3JointId b3CreateRevoluteJoint(b3WorldId worldId, b3RevoluteJointDef* def) {
    b3World* world = b3GetUnlockedWorldFromId(worldId);
    if world == null {
        return b3JointId{};
    }
    b3JointPair pair = b3CreateJoint(world, &def.base, b3_revoluteJoint);
    b3JointSim* joint = pair.jointSim;
    joint.revoluteJoint = b3RevoluteJoint{};
    joint.revoluteJoint.hertz = def.hertz;
    joint.revoluteJoint.dampingRatio = def.dampingRatio;
    joint.revoluteJoint.targetAngle = b3ClampFloat(def.targetAngle, -3.14159265359f, 3.14159265359f);
    f32 lowerAngle = b3MinFloat(def.lowerAngle, def.upperAngle);
    f32 upperAngle = b3MaxFloat(def.lowerAngle, def.upperAngle);
    joint.revoluteJoint.lowerAngle = b3ClampFloat(lowerAngle, -0.99f * 3.14159265359f, 0.99f * 3.14159265359f);
    joint.revoluteJoint.upperAngle = b3ClampFloat(upperAngle, -0.99f * 3.14159265359f, 0.99f * 3.14159265359f);
    joint.revoluteJoint.maxMotorTorque = def.maxMotorTorque;
    joint.revoluteJoint.motorSpeed = def.motorSpeed;
    joint.revoluteJoint.enableSpring = def.enableSpring;
    joint.revoluteJoint.enableLimit = def.enableLimit;
    joint.revoluteJoint.enableMotor = def.enableMotor;
    var jointId = b3JointId{joint.jointId + 1, world.worldId, pair.joint.generation};
    while true {
        if world.recording != null {
            var recCreateArgs = b3RecArgs_CreateRevoluteJoint{worldId, *def};
            b3RecWriteRet_CreateRevoluteJoint(world.recording, &recCreateArgs, jointId);
        }
        if !(0 != 0) { break; }
    }
    return jointId;
}

