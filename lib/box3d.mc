struct b3World {
    b3Stack stack;
    b3BroadPhase broadPhase;
    b3ConstraintGraph constraintGraph;
    b3DynamicArray_b3BlockAllocator manifoldAllocators;
    b3Mutex* manifoldAllocatorMutex;
    b3IdPool bodyIdPool;
    b3DynamicArray_b3Body bodies;
    b3IdPool solverSetIdPool;
    b3DynamicArray_b3SolverSet solverSets;
    b3IdPool jointIdPool;
    b3DynamicArray_b3Joint joints;
    b3IdPool contactIdPool;
    b3DynamicArray_b3Contact contacts;
    b3IdPool islandIdPool;
    b3DynamicArray_b3Island islands;
    b3IdPool shapeIdPool;
    b3DynamicArray_b3Shape shapes;
    void* hullDatabase;
    b3NameCache names;
    b3DynamicArray_b3Sensor sensors;
    b3DynamicArray_b3TaskContext taskContexts;
    b3DynamicArray_b3SensorTaskContext sensorTaskContexts;
    b3DynamicArray_b3BodyMoveEvent bodyMoveEvents;
    b3DynamicArray_b3SensorBeginTouchEvent sensorBeginEvents;
    b3DynamicArray_b3ContactBeginTouchEvent contactBeginEvents;
    b3DynamicArray_b3SensorEndTouchEvent[2] sensorEndEvents;
    b3DynamicArray_b3ContactEndTouchEvent[2] contactEndEvents;
    i32 endEventArrayIndex;
    b3DynamicArray_b3ContactHitEvent contactHitEvents;
    b3DynamicArray_b3JointEvent jointEvents;
    b3BitSet debugBodySet;
    b3BitSet debugJointSet;
    b3BitSet debugContactSet;
    b3BitSet debugIslandSet;
    b3CreateDebugShapeCallback createDebugShape;
    b3DestroyDebugShapeCallback destroyDebugShape;
    void* userDebugShapeContext;
    u64 stepIndex;
    i32 splitIslandId;
    b3Vec3 gravity;
    f32 hitEventThreshold;
    f32 restitutionThreshold;
    f32 maxLinearSpeed;
    f32 contactSpeed;
    f32 contactHertz;
    f32 contactDampingRatio;
    f32 contactRecycleDistance;
    b3FrictionCallback frictionCallback;
    b3RestitutionCallback restitutionCallback;
    u16 generation;
    b3Profile profile;
    i32 satCallCount;
    i32 satCacheHitCount;
    i32[8] manifoldCounts;
    b3Capacity maxCapacity;
    b3PreSolveFcn preSolveFcn;
    void* preSolveContext;
    b3CustomFilterFcn customFilterFcn;
    void* customFilterContext;
    i32 workerCount;
    b3EnqueueTaskCallback enqueueTaskFcn;
    b3FinishTaskCallback finishTaskFcn;
    void* userTaskContext;
    void* userTreeTask;
    b3Scheduler* scheduler;
    void* userData;
    b3Recording* recording;
    f32 inv_h;
    f32 inv_dt;
    i32 activeTaskCount;
    i32 taskCount;
    u16 worldId;
    bool enableSleep;
    bool locked;
    bool enableWarmStarting;
    bool enableContinuous;
    bool enableSpeculative;
    bool inUse;
}

// Magic 'B3RC' in little-endian: bytes B(0x42) 3(0x33) R(0x52) C(0x43)
// Major recording version is bumped when writers change.
// Major version 4 added b3ShapeDef::enableSpeculativeContact
// Minor tracks op-stream additions that keep the 48 byte header shape.
// Minor version 3 added name cache.
// File header, fixed 48 bytes, little-endian. Contains the registry locator so the player
// can load geometry before replaying any ops.
struct b3RecHeader {
    u32 magic;
    u16 versionMajor;
    u16 versionMinor;
    u8 pointerWidth;
    u8 bigEndian;
    u8 validationEnabled;
    u8 reserved;
    f32 lengthScale;
    u32 reserved2;
    u32 reserved3;
    u64 snapshotSize;
    u64 registryOffset;
    u64 registryByteCount;
}

// Growable append-only byte buffer. Doubles on demand. countOnly mode tallies size without
// allocating, used to size a buffer cheaply before a second filling pass.
struct b3RecBuffer {
    u8* data;
    i32 capacity;
    i32 size;
    bool countOnly;
}

// One entry per unique geometry blob. id == index in the entries array.
// hashNext chains entries that share a content hash so dedup stays exact under a hash collision,
// which the keyframe registry depends on to never grow during capture. B3_NULL_INDEX ends the chain.
struct b3GeometryEntry {
    u64 contentHash;
    u32 id;
    b3GeometryKind kind;
    i32 byteCount;
    u8* bytes;
    i32 hashNext;
}

// Growable array of geometry entries. Ids are array indices, so the array is serialized in order.
// dedupMap maps content hash to entry id for O(1) dedup; it is opaque here and owned by recording.c.
struct b3GeometryRegistry {
    b3GeometryEntry* entries;
    i32 count;
    i32 capacity;
    void* dedupMap;
}

// Limit the maximum query name length to make recording simpler. Query names longer than this
// probably indicate a bug in user code.
// Query tag from b3QueryFilter.
// Stored once per key in the trailing block so a tagged query carries only the 8 byte key on the wire.
// Shared by the recorder (accumulate) and the player (load).
struct b3RecTag {
    u64 key;
    u64 id;
    u8[65] queryName;
}

/**
 * @defgroup recording Recording
 * @brief Record and replay world state for debugging.
 * @{
 */
/// Opaque recording handle. Create with b3CreateRecording, destroy with b3DestroyRecording.
struct b3Recording {
    b3RecBuffer buffer;
    i32 recordStart;
    b3Mutex* lock;
    b3GeometryRegistry registry;
    b3RecTag* tags;
    i32 tagCount;
    i32 tagCapacity;
    void* tagMap;
    b3AABB accumulatedBounds;
    bool haveBounds;
}

