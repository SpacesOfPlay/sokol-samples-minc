    }
    i32 endEventArrayIndex = 1 - world.endEventArrayIndex;
    i32 beginCount = world.sensorBeginEvents.count;
    i32 endCount = world.sensorEndEvents[endEventArrayIndex].count;
    var events = b3SensorEvents{
        .beginEvents = world.sensorBeginEvents.data,
        .endEvents = world.sensorEndEvents[endEventArrayIndex].data,
        .beginCount = beginCount,
        .endCount = endCount,
    };
    return events;
}

