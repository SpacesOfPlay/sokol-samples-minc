void b3Joint_SetCollideConnected(b3JointId jointId, bool shouldCollide) {
    b3World* world = b3GetUnlockedWorld(cast(i32, jointId.world0));
    if world == null {
        return;
    }
    while true {
        if world.recording != null {
            var recArgs = b3RecArgs_JointSetCollideConnected{jointId, shouldCollide};
            b3RecWrite_JointSetCollideConnected(world.recording, &recArgs);
        }
        if !(0 != 0) { break; }
    }
    b3Joint* joint = b3GetJointFullId(world, jointId);
    if joint.collideConnected == shouldCollide {
        return;
    }
    joint.collideConnected = shouldCollide;
    b3Body* bodyA = world.bodies.data + joint.edges[0].bodyId;
    b3Body* bodyB = world.bodies.data + joint.edges[1].bodyId;
    if shouldCollide != 0 {
        i32 shapeCountA = bodyA.shapeCount;
        i32 shapeCountB = bodyB.shapeCount;
        i32 shapeId = shapeCountA < shapeCountB ? bodyA.headShapeId : bodyB.headShapeId;
        while shapeId != -1 {
            b3Shape* shape = world.shapes.data + shapeId;
            if shape.proxyKey != -1 {
                b3BufferMove(&world.broadPhase, shape.proxyKey);
            }
            shapeId = shape.nextShapeId;
        }
    } else {
        b3DestroyContactsBetweenBodies(world, bodyA, bodyB);
    }
}

bool b3Joint_GetCollideConnected(b3JointId jointId) {
    b3World* world = b3GetWorld(cast(i32, jointId.world0));
    b3Joint* joint = b3GetJointFullId(world, jointId);
    return joint.collideConnected;
}

