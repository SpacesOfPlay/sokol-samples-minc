/*--------------------------------------------------------------------------------------------------------------------*/
/*                                               Common header section                                                */
/*--------------------------------------------------------------------------------------------------------------------*/
/*--------------------------------------------------------------------------------------------------------------------*/
/*                                                  Prefixed structs                                                  */
/*--------------------------------------------------------------------------------------------------------------------*/
when !(defined(IMPLEMENTATION_MODE)) {
}
/*--------------------------------------------------------------------------------------------------------------------*/
/*                                                Function prototypes                                                 */
/*--------------------------------------------------------------------------------------------------------------------*/
when !(defined(IMPLEMENTATION_MODE)) {

// Erases the key pointed to by itr and returns an iterator to the next key in the table.
// This function must be inlined to ensure that the compiler optimizes away the NAME_fast_forward call if the returned
// iterator is discarded.
private {
b3RecTagLookup_itr b3RecTagLookup_erase_itr(b3RecTagLookup* table, b3RecTagLookup_itr itr) {
    if b3RecTagLookup_erase_itr_raw(table, itr) != 0 {
        return b3RecTagLookup_next(itr);
    }
    return itr;
}
}
}
/*--------------------------------------------------------------------------------------------------------------------*/
/*                                              Function implementations                                              */
/*--------------------------------------------------------------------------------------------------------------------*/
when !(defined(HEADER_MODE)) {
// Default settings.

private {
void b3RecTagLookup_init(b3RecTagLookup* table) {
    table.key_count = 0;
    table.buckets_mask = 0x0000000000000000;
    table.buckets = null;
    table.metadata = &vt_empty_placeholder_metadatum;
}

// For efficiency, especially in the case of a small table, the buckets array and metadata share the same dynamic memory
// allocation:
//   +-----------------------------+-----+----------------+--------+
//   |           Buckets           | Pad |    Metadata    | Excess |
//   +-----------------------------+-----+----------------+--------+
// Any allocated metadata array requires four excess elements to ensure that iteration functions, which read four
// metadata at a time, never read beyond the end of it.
// This function returns the offset of the beginning of the metadata, i.e. the size of the buckets array plus the
// (usually zero) padding.
// It assumes that the bucket count is not zero.
u64 b3RecTagLookup_metadata_offset(b3RecTagLookup* table) {
    return ((table.buckets_mask + 1) * cast(u64, sizeof(b3RecTagLookup_bucket)) + cast(u64, sizeof(u16)) - 1) / cast(u64, sizeof(u16)) * cast(u64, sizeof(u16));
}

// Returns the total allocation size, including the buckets array, padding, metadata, and excess metadata.
// As above, this function assumes that the bucket count is not zero.
u64 b3RecTagLookup_total_alloc_size(b3RecTagLookup* table) {
    return b3RecTagLookup_metadata_offset(table) + (table.buckets_mask + 1 + 4) * cast(u64, sizeof(u16));
}

bool b3RecTagLookup_init_clone(b3RecTagLookup* table, b3RecTagLookup* source) {
    table.key_count = source.key_count;
    table.buckets_mask = source.buckets_mask;
    if source.buckets_mask == 0 {
        table.metadata = &vt_empty_placeholder_metadatum;
        table.buckets = null;
        return true;
    }
    void* allocation = b3Alloc(b3RecTagLookup_total_alloc_size(table));
    if allocation == null {
        return false;
    }
    table.buckets = cast(b3RecTagLookup_bucket*, allocation);
    table.metadata = cast(u16*, cast(u8*, allocation) + b3RecTagLookup_metadata_offset(table));
    memcpy(allocation, source.buckets, b3RecTagLookup_total_alloc_size(table));
    return true;
}

u64 b3RecTagLookup_size(b3RecTagLookup* table) {
    return table.key_count;
}

u64 b3RecTagLookup_bucket_count(b3RecTagLookup* table) {
    return table.buckets_mask + cast(u64, cast(bool, table.buckets_mask));
}

bool b3RecTagLookup_is_end(b3RecTagLookup_itr itr) {
    return itr.metadatum == itr.metadata_end;
}

// Finds the earliest empty bucket in which a key belonging to home_bucket can be placed, assuming that home_bucket
// is already occupied.
// The reason to begin the search at home_bucket, rather than the end of the existing chain, is that keys deleted from
// other chains might have freed up buckets that could fall in this chain before the final key.
// Returns true if an empty bucket within the range of the displacement limit was found, in which case the final two
// pointer arguments contain the index of the empty bucket and its quadratic displacement from home_bucket.
bool b3RecTagLookup_find_first_empty(b3RecTagLookup* table, u64 home_bucket, u64* empty, u16* displacement) {
    *displacement = 1;
    u64 linear_dispacement = 1;
    while true {
        *empty = home_bucket + linear_dispacement & table.buckets_mask;
        if table.metadata[*empty] == 0x0000 {
            return true;
        }
        if ++*displacement == 0x07FF {
            return false;
        }
        linear_dispacement += *displacement;
    }
}

// Finds the key in the chain beginning in home_bucket after which to link a new key with displacement_to_empty
// quadratic displacement and returns the index of the bucket containing that key.
// Although the new key could simply be linked to the end of the chain, keeping the chain ordered by displacement
// theoretically improves cache locality during lookups.
u64 b3RecTagLookup_find_insert_location_in_chain(b3RecTagLookup* table, u64 home_bucket, u16 displacement_to_empty) {
    u64 candidate = home_bucket;
    while true {
        u16 displacement = table.metadata[candidate] & 0x07FF;
        if displacement > displacement_to_empty {
            return candidate;
        }
        candidate = home_bucket + vt_quadratic(displacement) & table.buckets_mask;
    }
}

// Frees up a bucket occupied by a key not belonging there so that a new key belonging there can be placed there as the
// beginning of a new chain.
// This requires:
// * Finding the previous key in the chain to which the occupying key belongs by rehashing it and then traversing the
//   chain.
// * Disconnecting the key from the chain.
// * Finding the appropriate empty bucket to which to move the key.
// * Moving the key (and value) data to the empty bucket.
// * Re-linking the key to the chain.
// Returns true if the eviction succeeded, or false if no empty bucket to which to evict the occupying key could be
// found within the displacement limit.
bool b3RecTagLookup_evict(b3RecTagLookup* table, u64 bucket) {
    u64 home_bucket = vt_hash_integer(table.buckets[bucket].key) & table.buckets_mask;
    u64 prev = home_bucket;
    while true {
        u64 next = home_bucket + vt_quadratic(table.metadata[prev] & 0x07FF) & table.buckets_mask;
        if next == bucket {
            break;
        }
        prev = next;
    }
    table.metadata[prev] = cast(u16, table.metadata[prev] & ~0x07FF | table.metadata[bucket] & 0x07FF);
    u64 empty;
    u16 displacement;
    if b3RecTagLookup_find_first_empty(table, home_bucket, &empty, &displacement) == 0 {
        return false;
    }
    prev = b3RecTagLookup_find_insert_location_in_chain(table, home_bucket, displacement);
    table.buckets[empty] = table.buckets[bucket];
    table.metadata[empty] = table.metadata[bucket] & 0xF000 | table.metadata[prev] & 0x07FF;
    table.metadata[prev] = cast(u16, table.metadata[prev] & ~0x07FF | displacement);
    return true;
}

// Returns an end iterator, i.e. any iterator for which .metadatum == .metadata_end.
// This function just cleans up the library code in functions that return an end iterator as a failure indicator.
b3RecTagLookup_itr b3RecTagLookup_end_itr() {
    b3RecTagLookup_itr itr;
    return itr;
}

// Inserts a key, optionally replacing the existing key if it already exists.
// There are two main cases that must be handled:
// * If the key's home bucket is empty or occupied by a key that does not belong there, then the key is inserted there,
//   evicting the occupying key if there is one.
// * Otherwise, the chain of keys beginning at the home bucket is (if unique is false) traversed in search of a matching
//   key.
//   If none is found, then the new key is inserted at the earliest available bucket, per quadratic probing from the
//   home bucket, and then linked to the chain in a manner that maintains its quadratic order.
// The unique argument tells the function whether to skip searching for the key before inserting it (on rehashing, this
// step is unnecessary).
// The replace argument tells the function whether to replace an existing key.
// If replace is true, the function returns an iterator to the inserted key, or an end iterator if the key was not
// inserted because of the maximum load factor or displacement limit constraints.
// If replace is false, then the return value is as described above, except that if the key already exists, the function
// returns an iterator to the existing key.
b3RecTagLookup_itr b3RecTagLookup_insert_raw(b3RecTagLookup* table, u64 key, u32* val, bool unique, bool replace) {
    u64 hash = vt_hash_integer(key);
    u16 hashfrag = vt_hashfrag(hash);
    u64 home_bucket = hash & table.buckets_mask;
    if (table.metadata[home_bucket] & 0x0800) == 0 {
        if cast(f64, table.key_count + 1) > cast(f64, b3RecTagLookup_bucket_count(table)) * 0.9 || table.metadata[home_bucket] != 0x0000 && !b3RecTagLookup_evict(table, home_bucket) {
            return b3RecTagLookup_end_itr();
        }
        table.buckets[home_bucket].key = key;
        table.buckets[home_bucket].val = *val;
        table.metadata[home_bucket] = hashfrag | 0x0800 | 0x07FF;
        ++table.key_count;
        var itr = b3RecTagLookup_itr{
            table.buckets + home_bucket, table.metadata + home_bucket,
            table.metadata + table.buckets_mask + 1, home_bucket,
        };
        return itr;
    }
    if unique == 0 {
        u64 bucket = home_bucket;
        while true {
            if (table.metadata[bucket] & 0xF000) == hashfrag && vt_cmpr_integer(table.buckets[bucket].key, key) {
                if replace != 0 {
                    table.buckets[bucket].key = key;
                    table.buckets[bucket].val = *val;
                }
                var itr = b3RecTagLookup_itr{
                    table.buckets + bucket, table.metadata + bucket,
                    table.metadata + table.buckets_mask + 1, home_bucket,
                };
                return itr;
            }
            u16 displacement = table.metadata[bucket] & 0x07FF;
            if displacement == 0x07FF {
                break;
            }
            bucket = home_bucket + vt_quadratic(displacement) & table.buckets_mask;
        }
    }
    u64 empty;
    u16 displacement;
    if cast(f64, table.key_count + 1) > cast(f64, b3RecTagLookup_bucket_count(table)) * 0.9 || !b3RecTagLookup_find_first_empty(table, home_bucket, &empty, &displacement) {
        return b3RecTagLookup_end_itr();
    }
    u64 prev = b3RecTagLookup_find_insert_location_in_chain(table, home_bucket, displacement);
    table.buckets[empty].key = key;
    table.buckets[empty].val = *val;
    table.metadata[empty] = hashfrag | table.metadata[prev] & 0x07FF;
    table.metadata[prev] = cast(u16, table.metadata[prev] & ~0x07FF | displacement);
    ++table.key_count;
    var itr = b3RecTagLookup_itr{
        table.buckets + empty, table.metadata + empty, table.metadata + table.buckets_mask + 1,
        home_bucket,
    };
    return itr;
}

// Resizes the bucket array.
// This function assumes that bucket_count is a power of two and large enough to accommodate all keys without violating
// the maximum load factor.
// Returns false in the case of allocation failure.
// As this function is called very rarely in _insert and _get_or_insert, ideally it should not be inlined into those
// functions.
// In testing, the no-inline approach showed a performance benefit when inserting existing keys (i.e. replacing).
bool b3RecTagLookup_rehash(b3RecTagLookup* table, u64 bucket_count) {
    while true {
        var new_table = b3RecTagLookup{0, bucket_count - 1, null, null};
        void* allocation = b3Alloc(b3RecTagLookup_total_alloc_size(&new_table));
        if allocation == null {
            return false;
        }
        new_table.buckets = cast(b3RecTagLookup_bucket*, allocation);
        new_table.metadata = cast(u16*, cast(u8*, allocation) + b3RecTagLookup_metadata_offset(&new_table));
        memset(new_table.metadata, 0x00, (bucket_count + 4) * cast(u64, sizeof(u16)));
        new_table.metadata[bucket_count] = 0x01;
        for u64 bucket = 0; bucket < b3RecTagLookup_bucket_count(table); ++bucket {
            if table.metadata[bucket] != 0x0000 {
                b3RecTagLookup_itr itr = b3RecTagLookup_insert_raw(&new_table, table.buckets[bucket].key, &table.buckets[bucket].val, true, false);
                if b3RecTagLookup_is_end(itr) != 0 {
                    break;
                }
            }
        }
        if new_table.key_count < table.key_count {
            b3Free(new_table.buckets, b3RecTagLookup_total_alloc_size(&new_table));
            bucket_count *= 2;
            continue;
        }
        if table.buckets_mask != 0 {
            b3Free(table.buckets, b3RecTagLookup_total_alloc_size(table));
        }
        *table = new_table;
        return true;
    }
}

// Inserts a key, replacing the existing key if it already exists.
// This function wraps insert_raw in a loop that handles growing and rehashing the table if a new key cannot be inserted
// because of the maximum load factor or displacement limit constraints.
// Returns an iterator to the inserted key, or an end iterator in the case of allocation failure.
b3RecTagLookup_itr b3RecTagLookup_insert(b3RecTagLookup* table, u64 key, u32 val) {
    while true {
        b3RecTagLookup_itr itr = b3RecTagLookup_insert_raw(table, key, &val, false, true);
        if !b3RecTagLookup_is_end(itr) || !b3RecTagLookup_rehash(table, table.buckets_mask != 0 ? b3RecTagLookup_bucket_count(table) * 2 : 8) {
            return itr;
        }
    }
}

// Same as NAME_insert, except that if the key already exists, no insertion occurs and the function returns an iterator
// to the existing key.
b3RecTagLookup_itr b3RecTagLookup_get_or_insert(b3RecTagLookup* table, u64 key, u32 val) {
    while true {
        b3RecTagLookup_itr itr = b3RecTagLookup_insert_raw(table, key, &val, false, false);
        if !b3RecTagLookup_is_end(itr) || !b3RecTagLookup_rehash(table, table.buckets_mask != 0 ? b3RecTagLookup_bucket_count(table) * 2 : 8) {
            return itr;
        }
    }
}

// Returns an iterator pointing to the specified key, or an end iterator if the key does not exist.
b3RecTagLookup_itr b3RecTagLookup_get(b3RecTagLookup* table, u64 key) {
    u64 hash = vt_hash_integer(key);
    u64 home_bucket = hash & table.buckets_mask;
    if (table.metadata[home_bucket] & 0x0800) == 0 {
        return b3RecTagLookup_end_itr();
    }
    u16 hashfrag = vt_hashfrag(hash);
    u64 bucket = home_bucket;
    while true {
        if (table.metadata[bucket] & 0xF000) == hashfrag && vt_cmpr_integer(table.buckets[bucket].key, key) {
            var itr = b3RecTagLookup_itr{
                table.buckets + bucket, table.metadata + bucket,
                table.metadata + table.buckets_mask + 1, home_bucket,
            };
            return itr;
        }
        u16 displacement = table.metadata[bucket] & 0x07FF;
        if displacement == 0x07FF {
            return b3RecTagLookup_end_itr();
        }
        bucket = home_bucket + vt_quadratic(displacement) & table.buckets_mask;
    }
}

// Erases the key pointed to by the specified iterator.
// The erasure always occurs at the end of the chain to which the key belongs.
// If the key to be erased is not the last in the chain, it is swapped with the last so that erasure occurs at the end.
// This helps keep a chain's keys close to their home bucket for the sake of cache locality.
// Returns true if, in the case of iteration from first to end, NAME_next should now be called on the iterator to find
// the next key.
// This return value is necessary because at the iterator location, the erasure could result in an empty bucket, a
// bucket containing a moved key already visited during the iteration, or a bucket containing a moved key not yet
// visited.
bool b3RecTagLookup_erase_itr_raw(b3RecTagLookup* table, b3RecTagLookup_itr itr) {
    --table.key_count;
    var itr_bucket = cast(u64, cast(i64, itr.metadatum - table.metadata));
    if table.metadata[itr_bucket] & 0x0800 && (table.metadata[itr_bucket] & 0x07FF) == 0x07FF {
        table.metadata[itr_bucket] = 0x0000;
        return true;
    }
    if itr.home_bucket == SIZE_MAX {
        if (table.metadata[itr_bucket] & 0x0800) != 0 {
            itr.home_bucket = itr_bucket;
        } else {
            itr.home_bucket = vt_hash_integer(table.buckets[itr_bucket].key) & table.buckets_mask;
        }
    }
    if (table.metadata[itr_bucket] & 0x07FF) == 0x07FF {
        u64 bucket = itr.home_bucket;
        while true {
            u16 displacement = table.metadata[bucket] & 0x07FF;
            u64 next = itr.home_bucket + vt_quadratic(displacement) & table.buckets_mask;
            if next == itr_bucket {
                table.metadata[bucket] |= 0x07FF;
                table.metadata[itr_bucket] = 0x0000;
                return true;
            }
            bucket = next;
        }
    }
    u64 bucket = itr_bucket;
    while true {
        u64 prev = bucket;
        bucket = itr.home_bucket + vt_quadratic(table.metadata[bucket] & 0x07FF) & table.buckets_mask;
        if (table.metadata[bucket] & 0x07FF) == 0x07FF {
            table.buckets[itr_bucket] = table.buckets[bucket];
            table.metadata[itr_bucket] = cast(u16, table.metadata[itr_bucket] & ~0xF000 | table.metadata[bucket] & 0xF000);
            table.metadata[prev] |= 0x07FF;
            table.metadata[bucket] = 0x0000;
            if bucket > itr_bucket {
                return false;
            }
            return true;
        }
    }
}

// Erases the specified key, if it exists.
// Returns true if a key was erased.
bool b3RecTagLookup_erase(b3RecTagLookup* table, u64 key) {
    b3RecTagLookup_itr itr = b3RecTagLookup_get(table, key);
    if b3RecTagLookup_is_end(itr) != 0 {
        return false;
    }
    b3RecTagLookup_erase_itr_raw(table, itr);
    return true;
}

// Finds the first occupied bucket at or after the bucket pointed to by itr.
// This function scans four buckets at a time, ideally using intrinsics.
void b3RecTagLookup_fast_forward(b3RecTagLookup_itr* itr) {
    while true {
        u64 metadata;
        memcpy(&metadata, itr.metadatum, sizeof(u64));
        if metadata != 0 {
            i32 offset = vt_first_nonzero_uint16(metadata);
            itr.data += offset;
            itr.metadatum += offset;
            itr.home_bucket = SIZE_MAX;
            return;
        }
        itr.data += 4;
        itr.metadatum += 4;
    }
}

b3RecTagLookup_itr b3RecTagLookup_next(b3RecTagLookup_itr itr) {
    ++itr.data;
    ++itr.metadatum;
    b3RecTagLookup_fast_forward(&itr);
    return itr;
}

// Returns the minimum bucket count required to accommodate a certain number of keys, which is governed by the maximum
// load factor.
u64 b3RecTagLookup_min_bucket_count_for_size(u64 size) {
    if size == 0 {
        return 0;
    }
    u64 bucket_count = 8;
    while cast(f64, size) > cast(f64, bucket_count) * 0.9 {
        bucket_count *= 2;
    }
    return bucket_count;
}

bool b3RecTagLookup_reserve(b3RecTagLookup* table, u64 size) {
    u64 bucket_count = b3RecTagLookup_min_bucket_count_for_size(size);
    if bucket_count <= b3RecTagLookup_bucket_count(table) {
        return true;
    }
    return b3RecTagLookup_rehash(table, bucket_count);
}

bool b3RecTagLookup_shrink(b3RecTagLookup* table) {
    u64 bucket_count = b3RecTagLookup_min_bucket_count_for_size(table.key_count);
    if bucket_count == b3RecTagLookup_bucket_count(table) {
        return true;
    }
    if bucket_count == 0 {
        b3Free(table.buckets, b3RecTagLookup_total_alloc_size(table));
        table.buckets_mask = 0x0000000000000000;
        table.metadata = &vt_empty_placeholder_metadatum;
        return true;
    }
    return b3RecTagLookup_rehash(table, bucket_count);
}

b3RecTagLookup_itr b3RecTagLookup_first(b3RecTagLookup* table) {
    if table.key_count == 0 {
        return b3RecTagLookup_end_itr();
    }
    var itr = b3RecTagLookup_itr{
        table.buckets, table.metadata, table.metadata + table.buckets_mask + 1, SIZE_MAX,
    };
    b3RecTagLookup_fast_forward(&itr);
    return itr;
}

void b3RecTagLookup_clear(b3RecTagLookup* table) {
    if table.key_count == 0 {
        return;
    }
    for u64 i = 0; i < b3RecTagLookup_bucket_count(table); ++i {
        if table.metadata[i] != 0x0000 {
        }
        table.metadata[i] = 0x0000;
    }
    table.key_count = 0;
}

void b3RecTagLookup_cleanup(b3RecTagLookup* table) {
    if table.buckets_mask == 0 {
        return;
    }
    when defined(KEY_DTOR_FN) || defined(VAL_DTOR_FN) {
        b3RecTagLookup_clear(table);
    }
    b3Free(table.buckets, b3RecTagLookup_total_alloc_size(table));
    b3RecTagLookup_init(table);
}
}
}

// Read the optional query-tag table trailing the geometry entries: u32 tagCount then per tag
// { u64 key, u64 id, u16 len, name bytes }. A recording written before the tag table leaves rp at
// dataEnd, so nothing loads. Bounds-checked; tagCount reflects only the tags that fully fit, so a
// truncated tail loads what it can and reports the real count.
private {
void b3RecLoadTags(b3RecReader* rdr, u8* rp, u8* dataEnd) {
    b3RecReader sub;
    sub.data = rp;
    sub.size = cast(i32, cast(i64, dataEnd - rp));
    sub.ok = true;
    u32 count = b3RecR_U32(&sub);
    if sub.ok == false || count == 0 {
        return;
    }
    if cast(u64, count) > cast(u64, sub.size - sub.cursor) / 18 {
        return;
    }
    var tags = cast(b3RecTag*, b3Alloc(cast(u64, count) * cast(u64, sizeof(b3RecTag))));
    memset(tags, 0, cast(u64, count) * cast(u64, sizeof(b3RecTag)));
    var map = cast(b3RecTagLookup*, b3Alloc(cast(u64, sizeof(b3RecTagLookup))));
    b3RecTagLookup_init(map);
    u32 loaded = 0;
    for u32 i = 0; i < count; ++i {
        u64 key = b3RecR_U64(&sub);
        u64 id = b3RecR_U64(&sub);
        u16 len = b3RecR_U16(&sub);
        if sub.ok == false {
            break;
        }
        if len == 0xFFFF {
            len = 0;
        }
        if cast(i64, sub.cursor) + cast(i64, len) > cast(i64, sub.size) {
            break;
        }
        i32 n = len > 64 ? 64 : cast(i32, len);
        tags[loaded].key = key;
        tags[loaded].id = id;
        if n > 0 {
            memcpy(tags[loaded].queryName, sub.data + sub.cursor, cast(u64, n));
        }
        tags[loaded].queryName[n] = 0;
        sub.cursor += cast(i32, len);
        b3RecTagLookup_insert(map, key, loaded);
        loaded += 1;
    }
    rdr.tags = tags;
    rdr.tagCount = cast(i32, loaded);
    rdr.tagCapacity = cast(i32, count);
    rdr.tagMap = map;
}

// Load the trailing registry block and fill rdr->slots/slotCount, then the optional tag table.
// Returns true on success. On failure sets rdr->ok = false and returns false.
bool b3RecLoadSlots(b3RecReader* rdr, void* data, i32 size, u64 registryOffset, u64 registryByteCount) {
    if registryOffset == 0 || registryByteCount == 0 {
        rdr.slots = null;
        rdr.slotCount = 0;
        return true;
    }
    var regStart = cast(i32, registryOffset);
    i32 regEnd = regStart + cast(i32, registryByteCount);
    if regEnd > size {
        printf("b3ReplayFile: registry block out of bounds\n");
        return false;
    }
    if regStart + 4 > size {
        printf("b3ReplayFile: registry too small\n");
        return false;
    }
    u8* dataEnd = cast(u8*, data) + regEnd;
    u8* rp = cast(u8*, data) + regStart;
    u32 count = cast(u32, rp[0]) | cast(u32, rp[1]) << 8 | cast(u32, rp[2]) << 16 | cast(u32, rp[3]) << 24;
    rp += 4;
    if count == 0 {
        rdr.slots = null;
        rdr.slotCount = 0;
        b3RecLoadTags(rdr, rp, dataEnd);
        return true;
    }
    if rp > dataEnd || cast(u64, count) > cast(u64, cast(i64, dataEnd - rp)) / 5 {
        printf("b3ReplayFile: registry count out of range\n");
        return false;
    }
    var slots = cast(b3RegistrySlot*, b3Alloc(cast(u64, count) * cast(u64, sizeof(b3RegistrySlot))));
    memset(slots, 0, cast(u64, count) * cast(u64, sizeof(b3RegistrySlot)));
    for u32 i = 0; i < count; ++i {
        if rp + 5 > dataEnd {
            printf("b3ReplayFile: registry truncated at entry %u\n", i);
            for u32 j = 0; j < i; ++j {
                if slots[j].bytes != null {
                    b3Free(slots[j].bytes, cast(u64, slots[j].byteCount));
                }
            }
            b3Free(slots, cast(u64, count) * cast(u64, sizeof(b3RegistrySlot)));
            return false;
        }
        u8 kind = rp[0];
        u32 byteCount = cast(u32, rp[1]) | cast(u32, rp[2]) << 8 | cast(u32, rp[3]) << 16 | cast(u32, rp[4]) << 24;
        rp += 5;
        if rp + byteCount > dataEnd {
            printf("b3ReplayFile: registry entry %u bytes out of bounds\n", i);
            for u32 j = 0; j < i; ++j {
                if slots[j].bytes != null {
                    b3Free(slots[j].bytes, cast(u64, slots[j].byteCount));
                }
            }
            b3Free(slots, cast(u64, count) * cast(u64, sizeof(b3RegistrySlot)));
            return false;
        }
        var bytes = cast(u8*, b3Alloc(byteCount > 0 ? cast(u64, byteCount) : 1));
        if byteCount > 0 {
            memcpy(bytes, rp, cast(u64, byteCount));
        }
        rp += byteCount;
        slots[i].kind = cast(b3GeometryKind, kind);
        slots[i].byteCount = cast(i32, byteCount);
        slots[i].bytes = bytes;
        slots[i].live = null;
    }
    rdr.slots = slots;
    rdr.slotCount = cast(i32, count);
    b3RecLoadTags(rdr, rp, dataEnd);
    return true;
}

// Free slots loaded by b3RecLoadSlots.
void b3RecFreeSlots(b3RegistrySlot* slots, i32 slotCount) {
    if slots == null {
        return;
    }
    for i32 i = 0; i < slotCount; ++i {
        b3RegistrySlot* slot = slots + i;
        if slot.live != null {
            switch slot.kind {
                case b3_geometryCompound: {
                    b3Free(slot.live, cast(u64, slot.byteCount));
                }
                default: {
                }
            }
        }
        if slot.bytes != null {
            b3Free(slot.bytes, slot.byteCount > 0 ? cast(u64, slot.byteCount) : 1);
        }
    }
    b3Free(slots, cast(u64, slotCount) * cast(u64, sizeof(b3RegistrySlot)));
}

// Walk the op stream once without dispatching: count Step ops and grab the first step's tuning.
void b3RecScanFile(b3RecPlayer* player) {
    u8* data = player.data;
    i32 size = player.registryEnd;
    i32 cursor = player.headerEnd;
    i32 frameCount = 0;
    bool gotStep = false;
    while cursor + 4 <= size {
        u8 opcode = data[cursor];
        u32 payloadSize = cast(u32, data[cursor + 1]) | cast(u32, data[cursor + 2]) << 8 | cast(u32, data[cursor + 3]) << 16;
        i32 payloadStart = cursor + 4;
        if payloadStart + cast(i32, payloadSize) > size {
            break;
        }
        if cast(i32, opcode) == b3_recOpStep {
            frameCount += 1;
            if !gotStep && payloadSize >= 12 {
                u32 dtBits = cast(u32, data[payloadStart + 4]) | cast(u32, data[payloadStart + 5]) << 8 | cast(u32, data[payloadStart + 6]) << 16 | cast(u32, data[payloadStart + 7]) << 24;
                memcpy(&player.recordedDt, &dtBits, cast(u64, 4));
                player.recordedSubStepCount = cast(i32, cast(u32, data[payloadStart + 8]) | cast(u32, data[payloadStart + 9]) << 8 | cast(u32, data[payloadStart + 10]) << 16 | cast(u32, data[payloadStart + 11]) << 24);
                gotStep = true;
            }
        } else if opcode == 0xF2 && payloadSize >= cast(u32, sizeof(b3AABB)) {
            memcpy(&player.bounds, data + payloadStart, cast(u64, sizeof(b3AABB)));
        }
        cursor = payloadStart + cast(i32, payloadSize);
    }
    player.frameCount = frameCount;
}

// Free one keyframe's heap.
void b3FreeKeyframe(b3RecKeyframe* kf) {
    if kf.image != null {
        b3Free(kf.image, cast(u64, kf.imageCapacity));
    }
    if kf.bodyIds != null {
        b3Free(kf.bodyIds, cast(u64, kf.bodyIdCount) * cast(u64, sizeof(b3BodyId)));
    }
}

// Pre-populate keyframeRec's registry to mirror rdr.slots so geometry ids stay stable during
// b3SerializeWorld. Each slot becomes one entry with id == slot index, even byte-identical slots that
// a hash collision left undeduplicated in an already-recorded file. b3SerializeWorld then resolves a
// live blob back to a valid slot index via the registry's exact dedup, so capture never grows it.
void b3RecSeedKeyframeRegistry(b3RecPlayer* player) {
    b3GeometryRegistry* reg = &player.keyframeRec.registry;
    for i32 i = 0; i < player.rdr.slotCount; ++i {
        b3RegistrySlot* slot = player.rdr.slots + i;
        i32 n = slot.byteCount > 0 ? slot.byteCount : 1;
        var copy = cast(u8*, b3Alloc(cast(u64, n)));
        if slot.byteCount > 0 {
            memcpy(copy, slot.bytes, cast(u64, slot.byteCount));
        }
        u64 h = b3Hash64Blob(slot.bytes, slot.byteCount);
        u32 id = b3AppendGeometry(reg, slot.kind, h, copy, slot.byteCount);
        ignore id;
    }
}

// Capture a restore-point keyframe for the just-completed frame. rdr.cursor already points to
// the next frame's Step op.
void b3RecCaptureKeyframe(b3RecPlayer* player) {
    b3World* world = b3GetWorldFromId(player.rdr.replayWorldId);
    b3RecBuffer buf;
    i32 regCountBefore = player.keyframeRec.registry.count;
    ignore regCountBefore;
    b3SerializeWorld(world, &buf, player.keyframeRec);
    u64 bodyBytes = cast(u64, player.bodyIdCount) * cast(u64, sizeof(b3BodyId));
    u64 newBytes = cast(u64, buf.capacity) + bodyBytes;
    while player.keyframeCount > 0 && player.keyframeBytes + newBytes > player.keyframeBudget {
        player.keyframeInterval *= 2;
        i32 kept = 0;
        u64 keptBytes = 0;
        for i32 i = 0; i < player.keyframeCount; ++i {
            b3RecKeyframe* kf = player.keyframes + i;
            if kf.frame % player.keyframeInterval == 0 {
                player.keyframes[kept] = *kf;
                keptBytes += cast(u64, kf.imageCapacity) + cast(u64, kf.bodyIdCount) * cast(u64, sizeof(b3BodyId));
                kept += 1;
            } else {
                b3FreeKeyframe(kf);
            }
        }
        bool progress = kept < player.keyframeCount;
        player.keyframeCount = kept;
        player.keyframeBytes = keptBytes;
        if progress == 0 {
            break;
        }
    }
    if player.keyframeCount >= player.keyframeCapacity {
        i32 newCap = player.keyframeCapacity < 8 ? 8 : player.keyframeCapacity * 2;
        player.keyframes = cast(b3RecKeyframe*, b3GrowAlloc(player.keyframes, player.keyframeCapacity * cast(i32, sizeof(b3RecKeyframe)), newCap * cast(i32, sizeof(b3RecKeyframe))));
        player.keyframeCapacity = newCap;
    }
    b3RecKeyframe* kf = player.keyframes + player.keyframeCount;
    kf.image = buf.data;
    kf.imageSize = buf.size;
    kf.imageCapacity = buf.capacity;
    kf.frame = player.frame;
    kf.cursor = player.rdr.cursor;
    kf.divergeFrame = player.divergeFrame;
    kf.diverged = player.rdr.diverged;
    kf.bodyIdCount = player.bodyIdCount;
    kf.bodyIds = null;
    if bodyBytes > 0 {
        kf.bodyIds = cast(b3BodyId*, b3Alloc(bodyBytes));
        memcpy(kf.bodyIds, player.bodyIds, bodyBytes);
    }
    player.keyframeBytes += newBytes;
    player.keyframeCount += 1;
    player.lastKeyframeFrame = player.frame;
}

// Restore the world in-place from a keyframe image.
void b3RecPlayerRestoreKeyframe(b3RecPlayer* player, b3RecKeyframe* kf) {
    b3World* world = b3GetWorldFromId(player.rdr.replayWorldId);
    if b3DeserializeIntoShell(kf.image, kf.imageSize, world, &player.rdr) == false {
        player.rdr.ok = false;
        return;
    }
    player.rdr.cursor = kf.cursor;
    player.rdr.ok = true;
    player.rdr.diverged = kf.diverged;
    player.frame = kf.frame;
    player.divergeFrame = kf.divergeFrame;
    player.atEnd = false;
    player.atPreStep = false;
    b3RecGrow(cast(void**, &player.bodyIds), &player.bodyIdCap, kf.bodyIdCount, 0, cast(i32, sizeof(b3BodyId)));
    player.bodyIdCount = kf.bodyIdCount;
    if kf.bodyIdCount > 0 {
        memcpy(player.bodyIds, kf.bodyIds, cast(u64, kf.bodyIdCount) * cast(u64, sizeof(b3BodyId)));
    }
}

// Create a replay world carrying the host debug-shape callbacks. Every world the player
// stands up funnels through here so the sample renderer can draw replayed shapes.
b3WorldId b3RecPlayerCreateWorld(b3RecPlayer* player) {
    b3WorldDef worldDef = b3DefaultWorldDef();
    worldDef.createDebugShape = player.createDebugShape;
    worldDef.destroyDebugShape = player.destroyDebugShape;
    worldDef.userDebugShapeContext = player.debugShapeContext;
    worldDef.workerCount = cast(u32, b3MaxInt(1, player.recordedWorkerCount));
    return b3CreateWorld(&worldDef);
}
}

b3RecPlayer* b3RecPlayer_Create(void* data, i32 size, i32 workerCount) {
    if data == null || size < cast(i32, sizeof(b3RecHeader)) {
        printf("b3RecPlayer_Create: recording too small\n");
        return null;
    }
    noinit b3RecHeader hdr;
    memcpy(&hdr, data, cast(u64, sizeof(hdr)));
    if hdr.magic != 0x43523342 {
        printf("b3RecPlayer_Create: bad magic 0x%08X\n", hdr.magic);
        return null;
    }
    if hdr.versionMajor != 4 {
        printf("b3RecPlayer_Create: version mismatch %u.%u vs %u.%u\n", hdr.versionMajor, hdr.versionMinor, 4, 3);
        return null;
    }
    if hdr.pointerWidth != cast(u8, sizeof(void*)) {
        printf("b3RecPlayer_Create: pointer width mismatch %u vs %u\n", hdr.pointerWidth, cast(u32, sizeof(void*)));
        return null;
    }
    if hdr.bigEndian != 0 {
        printf("b3RecPlayer_Create: big-endian recording not supported\n");
        return null;
    }
    if hdr.snapshotSize == 0 {
        printf("b3RecPlayer_Create: missing snapshot seed\n");
        return null;
    }
    u64 headerEnd64 = cast(u64, sizeof(b3RecHeader)) + hdr.snapshotSize;
    u64 registryEnd64 = hdr.registryOffset != 0 ? hdr.registryOffset : cast(u64, size);
    if headerEnd64 < cast(u64, sizeof(b3RecHeader)) || headerEnd64 > registryEnd64 || registryEnd64 > cast(u64, size) {
        printf("b3RecPlayer_Create: corrupt offsets\n");
        return null;
    }
    var headerEnd = cast(i32, headerEnd64);
    var registryEnd = cast(i32, registryEnd64);
    u8* copy = b3Alloc(cast(u64, size));
    memcpy(copy, data, cast(u64, size));
    b3RecPlayer* player = b3Alloc(cast(u64, sizeof(b3RecPlayer)));
    memset(player, 0, cast(u64, sizeof(b3RecPlayer)));
    player.data = copy;
    player.size = size;
    player.headerEnd = headerEnd;
    player.registryEnd = registryEnd;
    player.lengthScale = hdr.lengthScale;
    player.previousLengthScale = b3GetLengthUnitsPerMeter();
    player.frame = 0;
    player.frameCount = 0;
    player.recordedDt = 0.0f;
    player.recordedSubStepCount = 0;
    player.recordedWorkerCount = workerCount;
    player.atEnd = false;
    player.atPreStep = false;
    player.divergeFrame = -1;
    player.keyframeMinInterval = 16;
    player.keyframeInterval = 16;
    player.keyframeBudget = cast(u64, 512) * 1024 * 1024;
    player.lastKeyframeFrame = 0;
    if hdr.lengthScale > 0.0f {
        b3SetLengthUnitsPerMeter(hdr.lengthScale);
    }
    b3RecScanFile(player);
    b3WorldId worldId = b3RecPlayerCreateWorld(player);
    player.rdr.data = copy;
    player.rdr.size = size;
    player.rdr.cursor = headerEnd;
    player.rdr.replayWorldId = worldId;
    player.rdr.ok = true;
    player.rdr.diverged = false;
    player.rdr.owner = player;
    if b3RecLoadSlots(&player.rdr, copy, size, hdr.registryOffset, hdr.registryByteCount) == 0 {
        b3DestroyWorld(worldId);
        b3Free(copy, cast(u64, size));
        b3Free(player, cast(u64, sizeof(b3RecPlayer)));
        return null;
    }
    {
        var snapStart = cast(i32, sizeof(b3RecHeader));
        var snapSize = cast(i32, hdr.snapshotSize);
        b3World* replayWorld = b3GetWorldFromId(worldId);
        if b3DeserializeIntoShell(copy + snapStart, snapSize, replayWorld, &player.rdr) == false {
            printf("b3RecPlayer_Create: snapshot deserialization failed\n");
            b3DestroyWorld(worldId);
            b3RecFreeSlots(player.rdr.slots, player.rdr.slotCount);
            if player.rdr.tags != null {
                b3Free(player.rdr.tags, cast(u64, player.rdr.tagCapacity) * cast(u64, sizeof(b3RecTag)));
            }
            if player.rdr.tagMap != null {
                b3RecTagLookup_cleanup(cast(b3RecTagLookup*, player.rdr.tagMap));
                b3Free(player.rdr.tagMap, cast(u64, sizeof(b3RecTagLookup)));
            }
            b3Free(copy, cast(u64, size));
            b3Free(player, cast(u64, sizeof(b3RecPlayer)));
            return null;
        }
        player.rdr.cursor = headerEnd;
        player.frame0Image = copy + snapStart;
        player.frame0Size = snapSize;
    }
    b3RecSeedFrame0BodyIds(player);
    player.keyframeRec = b3CreateRecording(0);
    b3RecSeedKeyframeRegistry(player);
    return player;
}

void b3RecPlayer_Destroy(b3RecPlayer* player) {
    if player == null {
        return;
    }
    if b3World_IsValid(player.rdr.replayWorldId) != 0 {
        b3DestroyWorld(player.rdr.replayWorldId);
    }
    b3RecFreeSlots(player.rdr.slots, player.rdr.slotCount);
    if player.rdr.matScratch != null {
        b3Free(player.rdr.matScratch, cast(u64, player.rdr.matScratchCap) * cast(u64, sizeof(b3SurfaceMaterial)));
    }
    if player.rdr.proxyScratch != null {
        b3Free(player.rdr.proxyScratch, cast(u64, player.rdr.proxyScratchCap) * cast(u64, sizeof(b3Vec3)));
    }
    if player.rdr.hits != null {
        b3Free(player.rdr.hits, cast(u64, player.rdr.hitCap) * cast(u64, sizeof(b3RecRecordedHit)));
    }
    if player.rdr.tags != null {
        b3Free(player.rdr.tags, cast(u64, player.rdr.tagCapacity) * cast(u64, sizeof(b3RecTag)));
    }
    if player.rdr.tagMap != null {
        b3RecTagLookup_cleanup(cast(b3RecTagLookup*, player.rdr.tagMap));
        b3Free(player.rdr.tagMap, cast(u64, sizeof(b3RecTagLookup)));
    }
    if player.frameQueries != null {
        b3Free(player.frameQueries, cast(u64, player.frameQueryCap) * cast(u64, sizeof(b3RecDrawQuery)));
    }
    if player.frameHits != null {
        b3Free(player.frameHits, cast(u64, player.frameHitCap) * cast(u64, sizeof(b3RecRecordedHit)));
    }
    for i32 i = 0; i < player.keyframeCount; ++i {
        b3FreeKeyframe(player.keyframes + i);
    }
    if player.keyframes != null {
        b3Free(player.keyframes, cast(u64, player.keyframeCapacity) * cast(u64, sizeof(b3RecKeyframe)));
    }
    if player.keyframeRec != null {
        b3DestroyRecording(player.keyframeRec);
    }
    if player.bodyIds != null {
        b3Free(player.bodyIds, cast(u64, player.bodyIdCap) * cast(u64, sizeof(b3BodyId)));
    }
    if player.frame0BodyIds != null {
        b3Free(player.frame0BodyIds, cast(u64, player.frame0BodyIdCount) * cast(u64, sizeof(b3BodyId)));
    }
    b3Free(player.data, cast(u64, player.size));
    b3SetLengthUnitsPerMeter(player.previousLengthScale);
    b3Free(player, cast(u64, sizeof(b3RecPlayer)));
}

bool b3RecPlayer_StepFrame(b3RecPlayer* player) {
    player.atPreStep = false;
    if player.atEnd != 0 {
        return false;
    }
    player.frameQueryCount = 0;
    player.frameHitCount = 0;
    bool stepped = false;
    while true {
        if player.rdr.cursor >= player.registryEnd || !player.rdr.ok {
            player.atEnd = true;
            return stepped;
        }
        if stepped && cast(i32, player.rdr.data[player.rdr.cursor]) != b3_recOpStateHash {
            if player.frame > player.lastKeyframeFrame && player.frame % player.keyframeInterval == 0 {
                b3RecCaptureKeyframe(player);
            }
            return true;
        }
        i32 op = b3RecDispatchOne(&player.rdr);
        if op < 0 {
            player.atEnd = true;
            return stepped;
        }
        if op == b3_recOpDestroyWorld {
            player.atEnd = true;
            return stepped;
        }
        if op == b3_recOpStep {
            player.frame += 1;
            stepped = true;
        } else if op == b3_recOpStateHash {
            if player.divergeFrame < 0 && player.rdr.diverged {
                player.divergeFrame = player.frame;
            }
        }
    }
}

void b3RecPlayer_SubStepFrame(b3RecPlayer* player) {
    if player.atEnd != 0 {
        return;
    }
    if player.atPreStep == false {
        player.frameQueryCount = 0;
        player.frameHitCount = 0;
    }
    bool stepped = false;
    bool haveCreateBodyOp = false;
    while true {
        if player.rdr.cursor >= player.registryEnd || !player.rdr.ok {
            player.atEnd = true;
            player.atPreStep = false;
            return;
        }
        u8 currentOpCode = player.rdr.data[player.rdr.cursor];
        if stepped && cast(i32, currentOpCode) != b3_recOpStateHash {
            if player.frame > player.lastKeyframeFrame && player.frame % player.keyframeInterval == 0 {
                b3RecCaptureKeyframe(player);
            }
            return;
        }
        if player.atPreStep == false && haveCreateBodyOp == true && cast(i32, currentOpCode) == b3_recOpStep {
            player.atPreStep = true;
            return;
        }
        i32 op = b3RecDispatchOne(&player.rdr);
        if op < 0 {
            player.atEnd = true;
            player.atPreStep = false;
            return;
        }
        if op == b3_recOpDestroyWorld {
            player.atEnd = true;
            player.atPreStep = false;
            return;
        }
        if op == b3_recOpCreateBody {
            haveCreateBodyOp = true;
        }
        if op == b3_recOpStep {
            player.atPreStep = false;
            player.frame += 1;
            stepped = true;
        } else if op == b3_recOpStateHash {
            if player.divergeFrame < 0 && player.rdr.diverged {
                player.divergeFrame = player.frame;
            }
        }
    }
}

void b3RecPlayer_Restart(b3RecPlayer* player) {
    b3World* world = b3GetWorldFromId(player.rdr.replayWorldId);
    if b3DeserializeIntoShell(player.frame0Image, player.frame0Size, world, &player.rdr) == false {
        player.rdr.ok = false;
        return;
    }
    player.rdr.cursor = player.headerEnd;
    player.rdr.ok = true;
    player.rdr.diverged = false;
    player.frame = 0;
    player.divergeFrame = -1;
    player.atEnd = false;
    player.atPreStep = false;
    player.frameQueryCount = 0;
    player.frameHitCount = 0;
    b3RecGrow(cast(void**, &player.bodyIds), &player.bodyIdCap, player.frame0BodyIdCount, 0, cast(i32, sizeof(b3BodyId)));
    player.bodyIdCount = player.frame0BodyIdCount;
    if player.frame0BodyIdCount > 0 {
        memcpy(player.bodyIds, player.frame0BodyIds, cast(u64, player.frame0BodyIdCount) * cast(u64, sizeof(b3BodyId)));
    }
}

void b3RecPlayer_SeekFrame(b3RecPlayer* player, i32 targetFrame) {
    if player == null {
        return;
    }
    player.atPreStep = false;
    if targetFrame < 0 {
        targetFrame = 0;
    }
    b3RecKeyframe* best = null;
    for i32 i = 0; i < player.keyframeCount; ++i {
        b3RecKeyframe* kf = player.keyframes + i;
        if kf.frame < targetFrame && (best == null || kf.frame > best.frame) {
            best = kf;
        }
    }
    if targetFrame < player.frame {
        if best != null {
            b3RecPlayerRestoreKeyframe(player, best);
        } else {
            b3RecPlayer_Restart(player);
        }
    } else if best != null && best.frame > player.frame {
        b3RecPlayerRestoreKeyframe(player, best);
    }
    while player.frame < targetFrame && b3RecPlayer_StepFrame(player) {
    }
}

b3WorldId b3RecPlayer_GetWorldId(b3RecPlayer* player) {
    return player != null ? player.rdr.replayWorldId : b3_nullWorldId;
}

i32 b3RecPlayer_GetFrame(b3RecPlayer* player) {
    return player != null ? player.frame : 0;
}

i32 b3RecPlayer_GetFrameCount(b3RecPlayer* player) {
    return player != null ? player.frameCount : 0;
}

bool b3RecPlayer_IsAtEnd(b3RecPlayer* player) {
    return player != null ? player.atEnd : true;
}

bool b3RecPlayer_IsAtPreStep(b3RecPlayer* player) {
    return player != null ? player.atPreStep : false;
}

bool b3RecPlayer_HasDiverged(b3RecPlayer* player) {
    return player != null ? player.rdr.diverged : false;
}

b3RecPlayerInfo b3RecPlayer_GetInfo(b3RecPlayer* player) {
    b3RecPlayerInfo info;
    if player != null {
        info.frameCount = player.frameCount;
        info.workerCount = player.recordedWorkerCount;
        info.timeStep = player.recordedDt;
        info.subStepCount = player.recordedSubStepCount;
        info.lengthScale = player.lengthScale;
        info.bounds = player.bounds;
    }
    return info;
}

i32 b3RecPlayer_GetDivergeFrame(b3RecPlayer* player) {
    return player != null ? player.divergeFrame : -1;
}

void b3RecPlayer_SetWorkerCount(b3RecPlayer* player, i32 count) {
    if player == null {
        return;
    }
    player.recordedWorkerCount = b3ClampInt(count, 1, 32);
    if b3World_IsValid(player.rdr.replayWorldId) != 0 {
        b3World_SetWorkerCount(player.rdr.replayWorldId, player.recordedWorkerCount);
    }
}

void b3RecPlayer_SetKeyframePolicy(b3RecPlayer* player, u64 budgetBytes, i32 minIntervalFrames) {
    if player == null {
        return;
    }
    if budgetBytes > 0 {
        player.keyframeBudget = budgetBytes;
    }
    if minIntervalFrames > 0 {
        player.keyframeMinInterval = minIntervalFrames;
    }
    for i32 i = 0; i < player.keyframeCount; ++i {
        b3FreeKeyframe(player.keyframes + i);
    }
    player.keyframeCount = 0;
    player.keyframeBytes = 0;
    player.keyframeInterval = player.keyframeMinInterval;
    player.lastKeyframeFrame = 0;
}

u64 b3RecPlayer_GetKeyframeBudget(b3RecPlayer* player) {
    return player != null ? player.keyframeBudget : 0;
}

i32 b3RecPlayer_GetKeyframeMinInterval(b3RecPlayer* player) {
    return player != null ? player.keyframeMinInterval : 0;
}

i32 b3RecPlayer_GetKeyframeInterval(b3RecPlayer* player) {
    return player != null ? player.keyframeInterval : 0;
}

u64 b3RecPlayer_GetKeyframeBytes(b3RecPlayer* player) {
    return player != null ? player.keyframeBytes : 0;
}

i32 b3RecPlayer_GetBodyCount(b3RecPlayer* player) {
    return player != null ? player.bodyIdCount : 0;
}

b3BodyId b3RecPlayer_GetBodyId(b3RecPlayer* player, i32 index) {
    if player == null || index < 0 || index >= player.bodyIdCount {
        return b3_nullBodyId;
    }
    return player.bodyIds[index];
}

// A selected query draws in one reserved color so it stands out when every query is drawn at once.
private {
b3HexColor b3RecQuerySelColor(bool selected, b3HexColor base) {
    return selected != 0 ? b3_colorPlum : base;
}

// Highlight each reported overlap shape by its AABB. Skip any destroyed since the query, per the
// b3Shape_GetAABB contract that overlap results may contain stale shapes.
void b3RecDrawHitBounds(b3RecPlayer* player, b3RecDrawQuery* q, b3DebugDraw* draw, b3HexColor color) {
    if draw.DrawBoundsFcn == null {
        return;
    }
    for i32 hi = q.hitStart; hi < q.hitStart + q.hitCount; ++hi {
        b3ShapeId id = player.frameHits[hi].id;
        if b3Shape_IsValid(id) == false {
            continue;
        }
        draw.DrawBoundsFcn(b3Shape_GetAABB(id), color, draw.context);
    }
}

// Draw a recorded shape proxy at basePos. A lone point with no radius draws a fat point, a lone point
// with a radius draws a translucent sphere, and a multi-point cloud draws its points. Capsule and hull
// proxies are rare and fall through to the point cloud for now.
void b3RecDrawProxy(b3DebugDraw* draw, b3Pos basePos, b3RecDrawQuery* q, b3HexColor color) {
    if q.proxyCount == 1 {
        b3Pos p = b3OffsetPos(basePos, q.proxyPoints[0]);
        if q.proxyRadius > 0.0f {
            if draw.DrawSphereFcn != null {
                draw.DrawSphereFcn(p, q.proxyRadius, color, 0.5f, draw.context);
            }
        } else if draw.DrawPointFcn != null {
            draw.DrawPointFcn(p, 10.0f, color, draw.context);
        }
    } else if q.proxyCount == 2 && q.proxyRadius > 0.0f {
        if draw.DrawCapsuleFcn != null {
            b3Pos p1 = b3OffsetPos(basePos, q.proxyPoints[0]);
            b3Pos p2 = b3OffsetPos(basePos, q.proxyPoints[1]);
            draw.DrawCapsuleFcn(p1, p2, q.proxyRadius, color, 0.5f, draw.context);
        }
    } else if q.proxyCount >= 2 && draw.DrawPointFcn {
        for i32 i = 0; i < q.proxyCount; ++i {
            draw.DrawPointFcn(b3OffsetPos(basePos, q.proxyPoints[i]), 6.0f, color, draw.context);
        }
    }
}
}

void b3RecPlayer_DrawFrameQueries(b3RecPlayer* player, b3DebugDraw* draw, i32 queryIndex, i32 selectedIndex) {
    if player == null || draw == null {
        return;
    }
    for i32 qi = 0; qi < player.frameQueryCount; ++qi {
        if queryIndex >= 0 && qi != queryIndex {
            continue;
        }
        b3RecDrawQuery* q = &player.frameQueries[qi];
        bool selected = qi == selectedIndex;
        switch q.kind {
            case B3_RECQ_CAST_RAY, B3_RECQ_CAST_RAY_CLOSEST: {
                {
                    b3Pos origin = q.origin;
                    b3Pos end = b3OffsetPos(origin, q.translation);
                    if draw.DrawSegmentFcn != null {
                        draw.DrawSegmentFcn(origin, end, b3RecQuerySelColor(selected, b3_colorYellow), draw.context);
                    }
                    for i32 hi = q.hitStart; hi < q.hitStart + q.hitCount; ++hi {
                        b3RecRecordedHit* h = &player.frameHits[hi];
                        if draw.DrawPointFcn != null {
                            draw.DrawPointFcn(h.point, 4.0f, b3RecQuerySelColor(selected, b3_colorYellow), draw.context);
                        }
                        if draw.DrawSegmentFcn != null {
                            draw.DrawSegmentFcn(h.point, b3OffsetPos(h.point, b3MulSV(0.2f, h.normal)), b3RecQuerySelColor(selected, b3_colorYellowGreen), draw.context);
                        }
                    }
                    break case;
                }
            }
            case B3_RECQ_CAST_SHAPE: {
                {
                    if draw.DrawSegmentFcn != null {
                        draw.DrawSegmentFcn(q.origin, b3OffsetPos(q.origin, q.translation), b3RecQuerySelColor(selected, b3_colorSkyBlue), draw.context);
                    }
                    b3RecDrawProxy(draw, q.origin, q, b3RecQuerySelColor(selected, b3_colorLightGreen));
                    for i32 hi = q.hitStart; hi < q.hitStart + q.hitCount; ++hi {
                        b3RecRecordedHit* h = &player.frameHits[hi];
                        if draw.DrawPointFcn != null {
                            draw.DrawPointFcn(h.point, 4.0f, b3RecQuerySelColor(selected, b3_colorSkyBlue), draw.context);
                        }
                        if draw.DrawSegmentFcn != null {
                            draw.DrawSegmentFcn(h.point, b3OffsetPos(h.point, b3MulSV(0.2f, h.normal)), b3RecQuerySelColor(selected, b3_colorLightSkyBlue), draw.context);
                        }
                        if draw.DrawSphereFcn != null {
                            b3Pos p = b3OffsetPos(q.origin, b3MulSV(h.fraction, q.translation));
                            b3RecDrawProxy(draw, p, q, b3RecQuerySelColor(selected, b3_colorSkyBlue));
                        }
                    }
                    break case;
                }
            }
            case B3_RECQ_CAST_MOVER: {
                {
                    b3Pos c1 = b3OffsetPos(q.origin, q.mover.center1);
                    b3Pos c2 = b3OffsetPos(q.origin, q.mover.center2);
                    b3HexColor c = b3_colorLightSkyBlue;
                    if draw.DrawCapsuleFcn != null {
                        draw.DrawCapsuleFcn(c1, c2, q.mover.radius, b3RecQuerySelColor(selected, c), 0.6f, draw.context);
                        if q.castFraction > 0.01f {
                            b3Vec3 d = b3MulSV(q.castFraction, q.translation);
                            c1 = b3OffsetPos(c1, d);
                            c2 = b3OffsetPos(c2, d);
                            draw.DrawCapsuleFcn(c1, c2, q.mover.radius, c, 0.3f, draw.context);
                        }
                    }
                    break case;
                }
            }
            case B3_RECQ_COLLIDE_MOVER: {
                {
                    b3Pos c1 = b3OffsetPos(q.origin, q.mover.center1);
                    b3Pos c2 = b3OffsetPos(q.origin, q.mover.center2);
                    b3HexColor c = b3_colorTan;
                    if draw.DrawCapsuleFcn != null {
                        draw.DrawCapsuleFcn(c1, c2, q.mover.radius, b3RecQuerySelColor(selected, c), 0.6f, draw.context);
                    }
                    for i32 hi = q.hitStart; hi < q.hitStart + q.hitCount; ++hi {
                        b3RecRecordedHit* h = &player.frameHits[hi];
                        b3Pos point = b3OffsetPos(q.origin, h.plane.point);
                        if draw.DrawSegmentFcn != null {
                            draw.DrawSegmentFcn(point, b3OffsetPos(point, b3MulSV(0.2f, h.plane.plane.normal)), b3RecQuerySelColor(selected, b3_colorOrange), draw.context);
                        }
                    }
                    break case;
                }
            }
            case B3_RECQ_OVERLAP_AABB: {
                {
                    if draw.DrawBoundsFcn != null {
                        draw.DrawBoundsFcn(q.aabb, b3RecQuerySelColor(selected, b3_colorLimeGreen), draw.context);
                    }
                    b3RecDrawHitBounds(player, q, draw, b3RecQuerySelColor(selected, b3_colorMagenta));
                    break case;
                }
            }
            case B3_RECQ_OVERLAP_SHAPE: {
                {
                    b3RecDrawProxy(draw, q.origin, q, b3RecQuerySelColor(selected, b3_colorLimeGreen));
                    b3RecDrawHitBounds(player, q, draw, b3RecQuerySelColor(selected, b3_colorMagenta));
                    break case;
                }
            }
            default: {
            }
        }
        if selected && q.key != 0 && draw.DrawStringFcn != null {
            u8* name = null;
            u64 id = 0;
            if player.rdr.tagMap != null {
                b3RecTagLookup_itr it = b3RecTagLookup_get(cast(b3RecTagLookup*, player.rdr.tagMap), q.key);
                if b3RecTagLookup_is_end(it) == false {
                    b3RecTag* tag = &player.rdr.tags[it.data.val];
                    name = tag.queryName;
                    id = tag.id;
                }
            }
            noinit u8[64] label;
            if name != null && name[0] != 0 && id != 0 {
                snprintf(label, sizeof(label), "%.40s (%llu)", name, id);
            } else if name != null && name[0] != 0 {
                snprintf(label, sizeof(label), "%.40s", name);
            } else {
                snprintf(label, sizeof(label), "#%llu", id);
            }
            b3Pos labelPos = q.origin;
            if q.kind == B3_RECQ_OVERLAP_AABB {
                labelPos = b3ToPos(b3AABB_Center(q.aabb));
            } else if q.kind == B3_RECQ_CAST_MOVER || q.kind == B3_RECQ_COLLIDE_MOVER {
                b3Pos c1 = b3OffsetPos(q.origin, q.mover.center1);
                b3Pos c2 = b3OffsetPos(q.origin, q.mover.center2);
                b3Vec3 dir = b3Normalize(b3SubPos(c2, c1));
                labelPos = b3OffsetPos(c2, b3MulSV(1.25f * q.mover.radius, dir));
            }
            draw.DrawStringFcn(labelPos, label, b3_colorWhite, draw.context);
        }
    }
}
// The internal b3RecQueryKind values match the public b3RecQueryType, so the kind copies across as a
// plain cast. Pin the first and last kinds to catch enum drift.

i32 b3RecPlayer_GetFrameQueryCount(b3RecPlayer* player) {
    return player != null ? player.frameQueryCount : 0;
}

b3RecQueryInfo b3RecPlayer_GetFrameQuery(b3RecPlayer* player, i32 index) {
    b3RecQueryInfo info;
    if player == null || index < 0 || index >= player.frameQueryCount {
        return info;
    }
    b3RecDrawQuery* q = &player.frameQueries[index];
    info.type = cast(b3RecQueryType, q.kind);
    info.filter = q.filter;
    info.aabb = q.aabb;
    info.origin = q.origin;
    info.translation = q.translation;
    info.hitCount = q.hitCount;
    info.key = q.key;
    info.id = 0;
    info.name = null;
    if q.key != 0 && player.rdr.tagMap != null {
        b3RecTagLookup_itr it = b3RecTagLookup_get(cast(b3RecTagLookup*, player.rdr.tagMap), q.key);
        if b3RecTagLookup_is_end(it) == false {
            b3RecTag* tag = &player.rdr.tags[it.data.val];
            info.id = tag.id;
            info.name = tag.queryName[0] != 0 ? tag.queryName : null;
        }
    }
    return info;
}

b3RecQueryHit b3RecPlayer_GetFrameQueryHit(b3RecPlayer* player, i32 queryIndex, i32 hitIndex) {
    b3RecQueryHit hit;
    if player == null || queryIndex < 0 || queryIndex >= player.frameQueryCount {
        return hit;
    }
    b3RecDrawQuery* q = &player.frameQueries[queryIndex];
    if hitIndex < 0 || hitIndex >= q.hitCount {
        return hit;
    }
    b3RecRecordedHit* h = &player.frameHits[q.hitStart + hitIndex];
    hit.shape = h.id;
    hit.point = h.point;
    hit.normal = h.normal;
    hit.fraction = h.fraction;
    return hit;
}

void b3RecPlayer_SetDebugShapeCallbacks(b3RecPlayer* player, b3CreateDebugShapeCallback createDebugShape, b3DestroyDebugShapeCallback destroyDebugShape, void* context) {
    if player == null {
        return;
    }
    player.createDebugShape = createDebugShape;
    player.destroyDebugShape = destroyDebugShape;
    player.debugShapeContext = context;
    if b3World_IsValid(player.rdr.replayWorldId) != 0 {
        b3DestroyWorld(player.rdr.replayWorldId);
    }
    player.rdr.replayWorldId = b3RecPlayerCreateWorld(player);
    player.rdr.cursor = player.headerEnd;
    player.rdr.ok = true;
    player.rdr.diverged = false;
    player.frame = 0;
    player.divergeFrame = -1;
    player.atEnd = false;
    b3World* world = b3GetWorldFromId(player.rdr.replayWorldId);
    if b3DeserializeIntoShell(player.frame0Image, player.frame0Size, world, &player.rdr) == false {
        player.rdr.ok = false;
        return;
    }
    player.rdr.cursor = player.headerEnd;
    b3RecSeedFrame0BodyIds(player);
}

// SPDX-FileCopyrightText: 2025 Erin Catto
// SPDX-License-Identifier: MIT
// needed for dll export
// Point-to-point linear constraint
// C = pB - pA
// Cdot = vB - vA
//      = vB + cross(wB, rB) - vA - cross(wA, rA)
// Cdot = J * v
// J = [-E -skew(rA) E skew(rB) ]
//
// K = J * invM * JT
//   = [(1/mA + 1/mB) * E - skew(rA) * invIA * skew(rA) - skew(rB) * invIB * skew(rB)]
// Perpendicularity constraint
// frameA = qA * localFrameA
// frameB = qB * localFrameB
// qRel = conj(frameA) * frameB
// C = [qRel.x; qRel.y]
// qRelDot = 0.5 * conj(frameA) * (wB - wA) * frameB
// Cdot = [qRelDot.x, qRelDot.y]
// Pulling out wB and wA
// sr = qRel.s
// vr = qRel.v
// Jx = 0.5 * rotate(frameA, sr * ex + cross(vr, ex))
// Jy = 0.5 * rotate(frameA, sr * ey + cross(vr, ey))
// Motor constraint
// Cdot = wB - wA
// J = [0 0 -E 0 0 E]
// K = invIA + invIB
void b3RevoluteJoint_EnableLimit(b3JointId jointId, bool enableLimit) {
    b3World* world = b3GetWorld(cast(i32, jointId.world0));
    while true {
        if world.recording != null {
            var recArgs = b3RecArgs_RevoluteJointEnableLimit{jointId, enableLimit};
            b3RecWrite_RevoluteJointEnableLimit(world.recording, &recArgs);
        }
        if !(0 != 0) { break; }
    }
    b3JointSim* base = b3GetJointSimCheckType(jointId, b3_revoluteJoint);
    if enableLimit != base.revoluteJoint.enableLimit {
        base.revoluteJoint.lowerImpulse = 0.0f;
        base.revoluteJoint.upperImpulse = 0.0f;
    }
    base.revoluteJoint.enableLimit = enableLimit;
}

bool b3RevoluteJoint_IsLimitEnabled(b3JointId jointId) {
    b3JointSim* base = b3GetJointSimCheckType(jointId, b3_revoluteJoint);
    return base.revoluteJoint.enableLimit;
}

f32 b3RevoluteJoint_GetLowerLimit(b3JointId jointId) {
    b3JointSim* base = b3GetJointSimCheckType(jointId, b3_revoluteJoint);
    return base.revoluteJoint.lowerAngle;
}

f32 b3RevoluteJoint_GetUpperLimit(b3JointId jointId) {
    b3JointSim* base = b3GetJointSimCheckType(jointId, b3_revoluteJoint);
    return base.revoluteJoint.upperAngle;
}

void b3RevoluteJoint_SetLimits(b3JointId jointId, f32 lowerLimitRadians, f32 upperLimitRadians) {
    b3World* world = b3GetWorld(cast(i32, jointId.world0));
    while true {
        if world.recording != null {
            var recArgs = b3RecArgs_RevoluteJointSetLimits{jointId, lowerLimitRadians, upperLimitRadians};
            b3RecWrite_RevoluteJointSetLimits(world.recording, &recArgs);
        }
        if !(0 != 0) { break; }
    }
    f32 lowerAngle = b3MinFloat(lowerLimitRadians, upperLimitRadians);
    f32 upperAngle = b3MaxFloat(lowerLimitRadians, upperLimitRadians);
    b3JointSim* base = b3GetJointSimCheckType(jointId, b3_revoluteJoint);
    base.revoluteJoint.lowerAngle = b3ClampFloat(lowerAngle, -0.99f * 3.14159265359f, 0.99f * 3.14159265359f);
    base.revoluteJoint.upperAngle = b3ClampFloat(upperAngle, -0.99f * 3.14159265359f, 0.99f * 3.14159265359f);
}

f32 b3RevoluteJoint_GetAngle(b3JointId jointId) {
    b3World* world = b3GetWorld(cast(i32, jointId.world0));
    b3JointSim* base = b3GetJointSimCheckType(jointId, b3_revoluteJoint);
    b3WorldTransform transformA = b3GetBodyTransform(world, base.bodyIdA);
    b3WorldTransform transformB = b3GetBodyTransform(world, base.bodyIdB);
    b3Quat quatA = b3MulQuat(transformA.q, base.localFrameA.q);
    b3Quat quatB = b3MulQuat(transformB.q, base.localFrameB.q);
    if b3DotQuat(quatA, quatB) < 0.0f {
        quatB = b3NegateQuat(quatB);
    }
    b3Quat relQ = b3InvMulQuat(quatA, quatB);
    return b3GetTwistAngle(relQ);
}

