// needed for dll export
void b3DistanceJoint_SetLength(b3JointId jointId, f32 length) {
    b3World* world = b3GetWorld(cast(i32, jointId.world0));
    while true {
        if world.recording != null {
            var recArgs = b3RecArgs_DistanceJointSetLength{jointId, length};
            b3RecWrite_DistanceJointSetLength(world.recording, &recArgs);
        }
        if !(0 != 0) { break; }
    }
    b3JointSim* base = b3GetJointSimCheckType(jointId, b3_distanceJoint);
    b3DistanceJoint* joint = &base.distanceJoint;
    joint.length = b3ClampFloat(length, 0.005f * b3GetLengthUnitsPerMeter(), 100000.0f * b3GetLengthUnitsPerMeter());
    joint.impulse = 0.0f;
    joint.lowerImpulse = 0.0f;
    joint.upperImpulse = 0.0f;
}

f32 b3DistanceJoint_GetLength(b3JointId jointId) {
    b3JointSim* base = b3GetJointSimCheckType(jointId, b3_distanceJoint);
    b3DistanceJoint* joint = &base.distanceJoint;
    return joint.length;
}

void b3DistanceJoint_EnableLimit(b3JointId jointId, bool enableLimit) {
    b3World* world = b3GetWorld(cast(i32, jointId.world0));
    while true {
        if world.recording != null {
            var recArgs = b3RecArgs_DistanceJointEnableLimit{jointId, enableLimit};
            b3RecWrite_DistanceJointEnableLimit(world.recording, &recArgs);
        }
        if !(0 != 0) { break; }
    }
    b3JointSim* base = b3GetJointSimCheckType(jointId, b3_distanceJoint);
    b3DistanceJoint* joint = &base.distanceJoint;
    joint.enableLimit = enableLimit;
}

bool b3DistanceJoint_IsLimitEnabled(b3JointId jointId) {
    b3JointSim* joint = b3GetJointSimCheckType(jointId, b3_distanceJoint);
    return joint.distanceJoint.enableLimit;
}

void b3DistanceJoint_SetLengthRange(b3JointId jointId, f32 minLength, f32 maxLength) {
    b3World* world = b3GetWorld(cast(i32, jointId.world0));
    while true {
        if world.recording != null {
            var recArgs = b3RecArgs_DistanceJointSetLengthRange{jointId, minLength, maxLength};
            b3RecWrite_DistanceJointSetLengthRange(world.recording, &recArgs);
        }
        if !(0 != 0) { break; }
    }
    b3JointSim* base = b3GetJointSimCheckType(jointId, b3_distanceJoint);
    b3DistanceJoint* joint = &base.distanceJoint;
    minLength = b3ClampFloat(minLength, 0.005f * b3GetLengthUnitsPerMeter(), 100000.0f * b3GetLengthUnitsPerMeter());
    maxLength = b3ClampFloat(maxLength, 0.005f * b3GetLengthUnitsPerMeter(), 100000.0f * b3GetLengthUnitsPerMeter());
    joint.minLength = b3MinFloat(minLength, maxLength);
    joint.maxLength = b3MaxFloat(minLength, maxLength);
    joint.impulse = 0.0f;
    joint.lowerImpulse = 0.0f;
    joint.upperImpulse = 0.0f;
}

f32 b3DistanceJoint_GetMinLength(b3JointId jointId) {
    b3JointSim* base = b3GetJointSimCheckType(jointId, b3_distanceJoint);
    b3DistanceJoint* joint = &base.distanceJoint;
    return joint.minLength;
}

f32 b3DistanceJoint_GetMaxLength(b3JointId jointId) {
    b3JointSim* base = b3GetJointSimCheckType(jointId, b3_distanceJoint);
    b3DistanceJoint* joint = &base.distanceJoint;
    return joint.maxLength;
}

f32 b3DistanceJoint_GetCurrentLength(b3JointId jointId) {
    b3JointSim* base = b3GetJointSimCheckType(jointId, b3_distanceJoint);
    b3World* world = b3GetUnlockedWorld(cast(i32, jointId.world0));
    if world == null {
        return 0.0f;
    }
    b3WorldTransform transformA = b3GetBodyTransform(world, base.bodyIdA);
    b3WorldTransform transformB = b3GetBodyTransform(world, base.bodyIdB);
    b3Pos pA = b3TransformWorldPoint(transformA, base.localFrameA.p);
    b3Pos pB = b3TransformWorldPoint(transformB, base.localFrameB.p);
    b3Vec3 d = b3SubPos(pB, pA);
    f32 length = b3Length(d);
    return length;
}

void b3DistanceJoint_EnableSpring(b3JointId jointId, bool enableSpring) {
    b3World* world = b3GetWorld(cast(i32, jointId.world0));
