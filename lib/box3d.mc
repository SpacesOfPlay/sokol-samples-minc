    b3World_CastShape(rdr.replayWorldId, a.origin, &a.proxy, a.translation, a.filter, cast(b3CastResultFcn, b3RecReplayCastTrampoline), &rc);
    if rc.cursor != cast(i32, n) {
        rdr.diverged = true;
    }
