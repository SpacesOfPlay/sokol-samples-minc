}

// SPDX-FileCopyrightText: 2025 Erin Catto
// SPDX-License-Identifier: MIT
struct b3ManifoldConstraintPoint {
    b3Vec3 rA;
    b3Vec3 rB;
    f32 baseSeparation;
    f32 relativeVelocity;
    f32 normalImpulse;
    f32 totalNormalImpulse;
    f32 normalMass;
    f32 leverArm;
}

struct b3ManifoldConstraint {
    b3ManifoldConstraintPoint[4] points;
    i32 pointCount;
    b3Vec3 normal;
    b3Vec3 tangent1;
    b3Vec3 tangent2;
    b3Vec3 centerA;
    b3Vec3 centerB;
    f32 twistMass;
    f32 twistImpulse;
    b3Matrix2 tangentMass;
    b3Vec2 frictionImpulse;
    b3Vec3 rollingImpulse;
    f32 tangentVelocity1;
    f32 tangentVelocity2;
}

struct b3ContactConstraint {
    b3ManifoldConstraint* constraints;
    b3Contact* contact;
    i32 indexA;
    i32 indexB;
    f32 invMassA;
    f32 invMassB;
    b3Matrix3 invIA;
    b3Matrix3 invIB;
    b3Softness softness;
    b3Matrix3 rollingMass;
    f32 friction;
    f32 restitution;
    f32 rollingResistance;
    i32 manifoldCount;
}

unsafe_union b3128 {
    b3V32 v;
    f32[4] f;
}

// Wide vec2
struct b3Vec2W {
    b3FloatW x;
    b3FloatW y;
}

// Wide vec3
struct b3Vec3W {
    b3FloatW X;
    b3FloatW Y;
    b3FloatW Z;
}

// Wide quaternion
struct b3QuatW {
    b3Vec3W V;
    b3FloatW S;
}

// Wide symmetric matrix2
struct b3SymMatrix2W {
    b3FloatW cxx;
    b3FloatW cxy;
    b3FloatW cyy;
}

// Wide symmetric matrix3
struct b3SymMatrix3W {
    b3FloatW cxx;
    b3FloatW cxy;
    b3FloatW cxz;
    b3FloatW cyy;
    b3FloatW cyz;
    b3FloatW czz;
}

// Soft contact constraints with sub-stepping support
// Uses fixed anchors for Jacobians for better behavior on rolling shapes (circles & capsules)
// http://mmacklin.com/smallsteps.pdf
// https://box2d.org/files/ErinCatto_SoftConstraints_GDC2011.pdf
struct b3ContactConstraintPointWide {
    b3Vec3W anchorAs;
    b3Vec3W anchorBs;
    b3FloatW baseSeparations;
    b3FloatW normalImpulses;
    b3FloatW totalNormalImpulses;
    b3FloatW normalMasses;
    b3FloatW leverArms;
    b3FloatW relativeVelocities;
}

// Solves four points
struct b3ContactConstraintWide {
    i32[4] indexA;
    i32[4] indexB;
    i32[4] pointCounts;
    b3FloatW invMassA;
    b3FloatW invMassB;
    b3SymMatrix3W invIA;
    b3SymMatrix3W invIB;
    b3Vec3W normal;
    b3Vec3W tangent1;
    b3Vec3W tangent2;
    b3Vec3W centerA;
    b3Vec3W centerB;
    b3FloatW twistMass;
    b3FloatW twistImpulse;
    b3SymMatrix2W tangentMass;
    b3Vec2W frictionImpulse;
    b3SymMatrix3W rollingMass;
    b3Vec3W rollingImpulse;
    b3FloatW friction;
    b3FloatW rollingResistance;
    b3FloatW tangentVelocity1;
    b3FloatW tangentVelocity2;
    b3FloatW biasRate;
    b3FloatW massScale;
    b3FloatW impulseScale;
    b3FloatW restitution;
    b3Manifold*[4] manifolds;
    b3ContactConstraintPointWide[4] points;
}

// wide version of b3BodyState
struct b3BodyStateW {
    b3Vec3W v;
    b3Vec3W w;
    b3Vec3W dp;
    b3QuatW dq;
}

struct b3SeparationFunction {
    b3ShapeProxy* proxyA;
    b3ShapeProxy* proxyB;
