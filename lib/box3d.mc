type errno_t = i32;
// transminc: file-scope constants (b3Vec3_zero and friends). Overridable
// so a single-translation-unit build can export them; defaults to
// upstream's `static const`, which every multi-TU build needs.
// C++ macros
// transminc: overridable so a single-translation-unit build can give
// the inline math API external linkage (an embedder importing Box3D
// as a module needs it). Defaults to upstream's `static inline`.
/// Used for C literals like (b3Vec3){1.0f, 2.0f, 3.0f} where C++ requires b3Vec3{1.0f, 2.0f, 3.0f}
// clang-format on
/**
 * @defgroup base Base
 * Base functionality
 * @{
 */
/// This is used to indicate null for interfaces that work with indices instead of pointers
/// Prototype for user allocation function.
///	@param size the allocation size in bytes
///	@param alignment the required alignment, guaranteed to be a power of 2
type b3AllocFcn = fn(i32, i32): void*;
/// Prototype for user free function.
///	@param mem the memory previously allocated through `b3AllocFcn`
type b3FreeFcn = fn(void*): void;
/// Prototype for the user assert callback. Return 0 to skip the debugger break.
type b3AssertFcn = fn(u8*, u8*, i32): i32;
/// Prototype for user log callback. Used to log warnings.
type b3LogFcn = fn(u8*): void;
/// In single precision mode these types are the same.
type b3Pos = b3Vec3;
/// In single precision mode these types are the same.
type b3WorldTransform = b3Transform;
/// Task interface
/// This is the prototype for a Box3D task. Your task system is expected to run this callback on a worker thread,
/// exactly once per enqueue, passing back the same taskContext pointer supplied to b3EnqueueTaskCallback.
/// @ingroup world
type b3TaskCallback = fn(void*): void;
/// These functions can be provided to Box3D to invoke a task system.
/// Returns a pointer to the user's task object. May be nullptr. A nullptr indicates to Box3D that the work was executed
/// serially within the callback and there is no need to call b3FinishTaskCallback. Otherwise the returned
/// value must be non-null will be passed to b3FinishTaskCallback as the userTask.
/// @param task the Box3D task to be called by the scheduler
/// @param taskContext the Box3D context object that the scheduler must pass to the task
/// @param userContext the scheduler context object that is opaque to Box3D
/// @param taskName the Box3D task name that the scheduler can use for diagnostics
/// @ingroup world
type b3EnqueueTaskCallback = fn(b3TaskCallback, void*, void*, u8*): void*;
/// Finishes a user task object that wraps a Box3D task. This must block until the task has completed.
/// The step blocks here on the tasks it spawned, so b3World_Step holds its stack across every
/// fork/join. Drive it from a thread you can dedicate to the step, or from a fiber this callback can
/// park to free the underlying thread. In a job system that cannot park a job's stack, do not call
/// b3World_Step from inside a job: a job that blocks on its own sub-jobs without yielding its thread
/// can deadlock. The in-tree scheduler instead runs other pending tasks on the waiting thread.
/// @ingroup world
type b3FinishTaskCallback = fn(void*, void*): void;
/// The user needs to be able to create debug draw shapes for multi-pass rendering to work efficiently.
/// These user shapes are created and destroyed via callback so they can be bound to shape lifetime and scaling updates.
/// @ingroup debug_draw
type b3CreateDebugShapeCallback = fn(b3DebugShape*, void*): void*;
type b3DestroyDebugShapeCallback = fn(void*, void*): void;
/// Optional friction mixing callback. This intentionally provides no context objects because this is called
/// from a worker thread.
/// @warning This function should not attempt to modify Box3D state or user application state.
/// @ingroup world
type b3FrictionCallback = fn(f32, u64, f32, u64): f32;
/// Optional restitution mixing callback. This intentionally provides no context objects because this is called
/// from a worker thread.
/// @warning This function should not attempt to modify Box3D state or user application state.
/// @ingroup world
type b3RestitutionCallback = fn(f32, u64, f32, u64): f32;
/// Prototype for a contact filter callback.
/// This is called when a contact pair is considered for collision. This allows you to
/// perform custom logic to prevent collision between shapes. This is only called if
/// one of the two shapes has custom filtering enabled. @see b3ShapeDef.
/// Notes:
/// - this function must be thread-safe
/// - this is only called if one of the two shapes has enabled custom filtering
/// - this is called only for awake dynamic bodies
/// Return false if you want to disable the collision
/// @warning Do not attempt to modify the world inside this callback
/// @ingroup world
type b3CustomFilterFcn = fn(b3ShapeId, b3ShapeId, void*): bool;
/// Prototype for a pre-solve callback.
/// This is called after a contact is updated. This allows you to inspect a
/// collision before it goes to the solver.
/// Notes:
/// - this function must be thread-safe
/// - this is only called if the shape has enabled pre-solve events
/// - this may be called for awake dynamic bodies and sensors
/// - this is not called for sensors
/// Return false if you want to disable the contact this step
/// This has limited information because it is used during CCD which does not have the
/// full contact manifold.
/// @warning Do not attempt to modify the world inside this callback
/// @ingroup world
type b3PreSolveFcn = fn(b3ShapeId, b3ShapeId, b3Pos, b3Vec3, void*): bool;
/// Prototype callback for overlap queries.
/// Called for each shape found in the query.
/// @see b3World_OverlapAABB
/// @return false to terminate the query.
/// @ingroup world
type b3OverlapResultFcn = fn(b3ShapeId, void*): bool;
/// Prototype callback for ray casts.
/// Called for each shape found in the query. You control how the ray cast
/// proceeds by returning a float:
/// return -1: ignore this shape and continue
/// return 0: terminate the ray cast
/// return fraction: clip the ray to this point
/// return 1: don't clip the ray and continue
/// @param shapeId the shape hit by the ray
/// @param point the point of initial intersection
/// @param normal the normal vector at the point of intersection
/// @param fraction the fraction along the ray at the point of intersection
/// @param userMaterialId the shape or triangle surface type
/// @param triangleIndex the triangle index for mesh or height field shapes or -1 for other shape types
/// @param childIndex the child shape index for compound shapes
/// @param context the user context
/// @return -1 to filter, 0 to terminate, fraction to clip the ray for closest hit, 1 to continue
/// @see b3World_CastRay
/// @ingroup world
type b3CastResultFcn = fn(b3ShapeId, b3Pos, b3Vec3, f32, u64, i32, i32, void*): f32;
/// Same type in single precision.
type b3WorldCastOutput = b3CastOutput;
/// This function receives proxies found in the AABB query.
/// @return true if the query should continue
type b3TreeQueryCallbackFcn = fn(i32, u64, void*): bool;
/// This function receives the minimum distance squared so far and proxy to check in the closest query.
/// @return minimum distance squared to user objects in the proxy
type b3TreeQueryClosestCallbackFcn = fn(f32, i32, u64, void*): f32;
/// This function receives clipped AABB cast input for a proxy. The function returns the new cast
/// fraction.
/// - return a value of 0 to terminate the cast
/// - return a value less than input->maxFraction to clip the cast
/// - return a value of input->maxFraction to continue the cast without clipping
type b3TreeBoxCastCallbackFcn = fn(b3BoxCastInput*, i32, u64, void*): f32;
/// This function receives clipped ray cast input for a proxy. The function
/// returns the new ray fraction.
/// - return a value of 0 to terminate the ray cast
/// - return a value less than input->maxFraction to clip the ray
/// - return a value of input->maxFraction to continue the ray cast without clipping
type b3TreeRayCastCallbackFcn = fn(b3RayCastInput*, i32, u64, void*): f32;
/// Used to collect collision planes for character movers.
/// Return true to continue gathering planes.
type b3PlaneResultFcn = fn(b3ShapeId, b3PlaneResult*, i32, void*): bool;
/// Used to filter shapes for shape casting character movers.
/// Return true to accept the collision
type b3MoverFilterFcn = fn(b3ShapeId, void*): bool;
/// Callback for compound overlap queries.
type b3CompoundQueryFcn = fn(b3CompoundData*, i32, void*): bool;
type b3ThreadFunction = fn(void*): void;
/// Query callback.
type b3MeshQueryFcn = fn(b3Vec3, b3Vec3, b3Vec3, i32, void*): bool;
// C type aliases per TAG, used in the X-macro codegen arg structs
type b3RecCType_BOOL = bool;
type b3RecCType_I32 = i32;
type b3RecCType_U8 = u8;
type b3RecCType_U16 = u16;
type b3RecCType_U32 = u32;
type b3RecCType_U64 = u64;
type b3RecCType_F32 = f32;
type b3RecCType_F64 = f64;
type b3RecCType_VEC3 = b3Vec3;
type b3RecCType_QUAT = b3Quat;
type b3RecCType_TRANSFORM = b3Transform;
type b3RecCType_POSITION = b3Pos;
type b3RecCType_WORLDXF = b3WorldTransform;
type b3RecCType_MATRIX3 = b3Matrix3;
type b3RecCType_AABB = b3AABB;
type b3RecCType_SPHERE = b3Sphere;
type b3RecCType_CAPSULE = b3Capsule;
type b3RecCType_QUERYFILTER = b3QueryFilter;
type b3RecCType_SHAPEPROXY = b3ShapeProxy;
// Geometry reference: a plain u32 id into the trailing registry
type b3RecCType_GEOMID = u32;
type b3RecCType_FILTER = b3Filter;
type b3RecCType_MATERIAL = b3SurfaceMaterial;
type b3RecCType_MASSDATA = b3MassData;
type b3RecCType_LOCKS = b3MotionLocks;
type b3RecCType_STR = u8*;
type b3RecCType_WORLDID = b3WorldId;
type b3RecCType_BODYID = b3BodyId;
type b3RecCType_SHAPEID = b3ShapeId;
type b3RecCType_JOINTID = b3JointId;
type b3RecCType_BODYDEF = b3BodyDef;
type b3RecCType_SHAPEDEF = b3ShapeDef;
type b3RecCType_EXPLOSIONDEF = b3ExplosionDef;
type b3RecCType_PARALLELJOINTDEF = b3ParallelJointDef;
type b3RecCType_DISTANCEJOINTDEF = b3DistanceJointDef;
type b3RecCType_FILTERJOINTDEF = b3FilterJointDef;
type b3RecCType_MOTORJOINTDEF = b3MotorJointDef;
type b3RecCType_PRISMATICJOINTDEF = b3PrismaticJointDef;
type b3RecCType_REVOLUTEJOINTDEF = b3RevoluteJointDef;
type b3RecCType_SPHERICALJOINTDEF = b3SphericalJointDef;
type b3RecCType_WELDJOINTDEF = b3WeldJointDef;
type b3RecCType_WHEELJOINTDEF = b3WheelJointDef;
// Callback invoked by b3ParallelFor to process a range of items. May be called
// multiple times per worker: work is divided into blocks that workers claim
// atomically, so a worker that finishes early picks up the next unclaimed
// block instead of sitting idle. workerIndex is the worker identity and is
// stable across all invocations from the same worker, so it is safe to use as
// an index into per-worker state (e.g. world->taskContexts.data + workerIndex).
type b3ParallelForCallback = fn(i32, i32, i32, void*): void;
