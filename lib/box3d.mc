        if world.recording != null {
            var recArgs = b3RecArgs_WheelJointEnableSteeringLimit{jointId, flag};
            b3RecWrite_WheelJointEnableSteeringLimit(world.recording, &recArgs);
        }
        if !(0 != 0) { break; }
    }
    b3JointSim* joint = b3GetJointSimCheckType(jointId, b3_wheelJoint);
    if joint.wheelJoint.enableSteeringLimit != flag {
        joint.wheelJoint.lowerSteeringImpulse = 0.0f;
        joint.wheelJoint.upperSteeringImpulse = 0.0f;
        joint.wheelJoint.enableSteeringLimit = flag;
    }
}

bool b3WheelJoint_IsSteeringLimitEnabled(b3JointId jointId) {
    b3JointSim* joint = b3GetJointSimCheckType(jointId, b3_wheelJoint);
    return joint.wheelJoint.enableSteeringLimit;
}

f32 b3WheelJoint_GetLowerSteeringLimit(b3JointId jointId) {
    b3JointSim* joint = b3GetJointSimCheckType(jointId, b3_wheelJoint);
    return joint.wheelJoint.lowerSteeringLimit;
}

f32 b3WheelJoint_GetUpperSteeringLimit(b3JointId jointId) {
    b3JointSim* joint = b3GetJointSimCheckType(jointId, b3_wheelJoint);
    return joint.wheelJoint.upperSteeringLimit;
}

void b3WheelJoint_SetSteeringLimits(b3JointId jointId, f32 lowerRadians, f32 upperRadians) {
    b3World* world = b3GetWorld(cast(i32, jointId.world0));
    while true {
        if world.recording != null {
            var recArgs = b3RecArgs_WheelJointSetSteeringLimits{jointId, lowerRadians, upperRadians};
            b3RecWrite_WheelJointSetSteeringLimits(world.recording, &recArgs);
        }
        if !(0 != 0) { break; }
    }
    b3JointSim* joint = b3GetJointSimCheckType(jointId, b3_wheelJoint);
    joint.wheelJoint.lowerSteeringLimit = lowerRadians;
    joint.wheelJoint.upperSteeringLimit = upperRadians;
}

void b3WheelJoint_SetTargetSteeringAngle(b3JointId jointId, f32 radians) {
    b3World* world = b3GetWorld(cast(i32, jointId.world0));
    while true {
        if world.recording != null {
            var recArgs = b3RecArgs_WheelJointSetTargetSteeringAngle{jointId, radians};
            b3RecWrite_WheelJointSetTargetSteeringAngle(world.recording, &recArgs);
        }
        if !(0 != 0) { break; }
    }
    b3JointSim* joint = b3GetJointSimCheckType(jointId, b3_wheelJoint);
    joint.wheelJoint.targetSteeringAngle = radians;
}

f32 b3WheelJoint_GetTargetSteeringAngle(b3JointId jointId) {
    b3JointSim* joint = b3GetJointSimCheckType(jointId, b3_wheelJoint);
    return joint.wheelJoint.targetSteeringAngle;
}

f32 b3WheelJoint_GetSpinSpeed(b3JointId jointId) {
    b3World* world = b3GetWorld(cast(i32, jointId.world0));
    b3JointSim* base = b3GetJointSimCheckType(jointId, b3_wheelJoint);
    i32 idA = base.bodyIdA;
    i32 idB = base.bodyIdB;
    b3Body* bodyA = world.bodies.data + idA;
    b3Body* bodyB = world.bodies.data + idB;
    b3SolverSet* setB = world.solverSets.data + bodyB.setIndex;
    i32 localIndexB = bodyB.localIndex;
    b3BodySim* bodySimB = setB.bodySims.data + localIndexB;
    b3Quat quatB = b3MulQuat(bodySimB.transform.q, base.localFrameB.q);
    b3Vec3 spinAxis = b3RotateVector(quatB, b3Vec3_axisZ);
    b3Vec3 wA = b3Vec3_zero;
    b3BodyState* stateA = b3GetBodyState(world, bodyA);
    if stateA != null {
        wA = stateA.angularVelocity;
    }
    b3Vec3 wB = b3Vec3_zero;
    b3BodyState* stateB = b3GetBodyState(world, bodyB);
    if stateB != null {
        wB = stateB.angularVelocity;
    }
    f32 speed = b3Dot(b3Sub(wB, wA), spinAxis);
    return speed;
}

f32 b3WheelJoint_GetSpinTorque(b3JointId jointId) {
    b3World* world = b3GetWorld(cast(i32, jointId.world0));
    b3JointSim* joint = b3GetJointSimCheckType(jointId, b3_wheelJoint);
    return world.inv_h * joint.wheelJoint.spinImpulse;
}

f32 b3WheelJoint_GetSteeringAngle(b3JointId jointId) {
    b3World* world = b3GetWorld(cast(i32, jointId.world0));
    b3JointSim* base = b3GetJointSimCheckType(jointId, b3_wheelJoint);
    i32 idA = base.bodyIdA;
    i32 idB = base.bodyIdB;
    b3Body* bodyA = world.bodies.data + idA;
    b3Body* bodyB = world.bodies.data + idB;
    b3SolverSet* setA = world.solverSets.data + bodyA.setIndex;
    b3SolverSet* setB = world.solverSets.data + bodyB.setIndex;
    i32 localIndexA = bodyA.localIndex;
    i32 localIndexB = bodyB.localIndex;
    b3BodySim* bodySimA = setA.bodySims.data + localIndexA;
    b3BodySim* bodySimB = setB.bodySims.data + localIndexB;
    b3Quat quatA = b3MulQuat(bodySimA.transform.q, base.localFrameA.q);
    b3Quat quatB = b3MulQuat(bodySimB.transform.q, base.localFrameB.q);
    b3Matrix3 matrixA = b3MakeMatrixFromQuat(quatA);
    b3Matrix3 matrixB = b3MakeMatrixFromQuat(quatB);
    f32 cs = b3Dot(matrixB.cz, matrixA.cz);
    f32 ss = -b3Dot(matrixB.cz, matrixA.cy);
    return b3Atan2(ss, cs);
}

f32 b3WheelJoint_GetSteeringTorque(b3JointId jointId) {
    b3World* world = b3GetWorld(cast(i32, jointId.world0));
    b3JointSim* joint = b3GetJointSimCheckType(jointId, b3_wheelJoint);
    return world.inv_h * joint.wheelJoint.steeringSpringImpulse;
}

b3Vec3 b3GetWheelJointForce(b3World* world, b3JointSim* base) {
    b3WorldTransform transformA = b3GetBodyTransform(world, base.bodyIdA);
    b3WheelJoint* joint = &base.wheelJoint;
    var impulse = b3Vec3{
        joint.linearImpulse.x, joint.linearImpulse.y,
        joint.lowerSuspensionLimit + joint.upperSuspensionImpulse + joint.suspensionSpringImpulse,
    };
    b3Vec3 force = b3MulSV(world.inv_h, impulse);
    force = b3RotateVector(base.localFrameA.q, force);
    force = b3RotateVector(transformA.q, force);
    return force;
}

b3Vec3 b3GetWheelJointTorque(b3World* world, b3JointSim* base) {
    i32 idA = base.bodyIdA;
    b3Body* bodyA = world.bodies.data + idA;
    b3SolverSet* setA = world.solverSets.data + bodyA.setIndex;
    i32 localIndexA = bodyA.localIndex;
    b3BodySim* bodySimA = setA.bodySims.data + localIndexA;
    b3Quat qA = b3MulQuat(bodySimA.transform.q, base.localFrameA.q);
    b3Matrix3 matrixA = b3MakeMatrixFromQuat(qA);
    return b3MulSV(world.inv_h * base.wheelJoint.spinImpulse, matrixA.cz);
}

// See constraints.pdf
void b3PrepareWheelJoint(b3JointSim* base, b3StepContext* context) {
    i32 idA = base.bodyIdA;
    i32 idB = base.bodyIdB;
    b3World* world = context.world;
    b3Body* bodyA = world.bodies.data + idA;
    b3Body* bodyB = world.bodies.data + idB;
    b3SolverSet* setA = world.solverSets.data + bodyA.setIndex;
    b3SolverSet* setB = world.solverSets.data + bodyB.setIndex;
    i32 localIndexA = bodyA.localIndex;
    i32 localIndexB = bodyB.localIndex;
    b3BodySim* bodySimA = setA.bodySims.data + localIndexA;
    b3BodySim* bodySimB = setB.bodySims.data + localIndexB;
    base.invMassA = bodySimA.invMass;
    base.invMassB = bodySimB.invMass;
    base.invIA = bodySimA.invInertiaWorld;
    base.invIB = bodySimB.invInertiaWorld;
    b3Matrix3 invInertiaSum = b3AddMM(base.invIA, base.invIB);
    base.fixedRotation = b3Det(invInertiaSum) < 1000.0f * FLT_MIN;
    b3WheelJoint* joint = &base.wheelJoint;
    joint.indexA = bodyA.setIndex == b3_awakeSet ? localIndexA : -1;
    joint.indexB = bodyB.setIndex == b3_awakeSet ? localIndexB : -1;
    joint.frameA.q = b3MulQuat(bodySimA.transform.q, base.localFrameA.q);
    joint.frameA.p = b3RotateVector(bodySimA.transform.q, b3Sub(base.localFrameA.p, bodySimA.localCenter));
    joint.frameB.q = b3MulQuat(bodySimB.transform.q, base.localFrameB.q);
    joint.frameB.p = b3RotateVector(bodySimB.transform.q, b3Sub(base.localFrameB.p, bodySimB.localCenter));
    joint.deltaCenter = b3SubPos(bodySimB.center, bodySimA.center);
    b3Vec3 rA = joint.frameA.p;
    b3Vec3 rB = joint.frameB.p;
    b3Matrix3 matrixA = b3MakeMatrixFromQuat(joint.frameA.q);
    b3Matrix3 matrixB = b3MakeMatrixFromQuat(joint.frameB.q);
    {
        b3Vec3 suspensionAxis = matrixA.cx;
        b3Vec3 rAn = b3Cross(rA, suspensionAxis);
        b3Vec3 rBn = b3Cross(rB, suspensionAxis);
        f32 k = base.invMassA + base.invMassB + b3Dot(rAn, b3MulMV(base.invIA, rAn)) + b3Dot(rBn, b3MulMV(base.invIB, rBn));
        joint.suspensionMass = k > 0.0f ? 1.0f / k : 0.0f;
    }
    joint.suspensionSoftness = b3MakeSoft(joint.suspensionHertz, joint.suspensionDampingRatio, context.h);
    joint.steeringSoftness = b3MakeSoft(joint.steeringHertz, joint.steeringDampingRatio, context.h);
    {
        b3Vec3 spinAxis = matrixB.cz;
        f32 k = b3Dot(spinAxis, b3MulMV(invInertiaSum, spinAxis));
        joint.spinMass = k > 0.0f ? 1.0f / k : 0.0f;
    }
    {
        f32 cs = b3Dot(matrixB.cz, matrixA.cz);
        f32 ss = -b3Dot(matrixB.cz, matrixA.cy);
        f32 den = cs * cs + ss * ss;
        den = den > 0.0f ? 1.0f / den : 0.0f;
        b3Vec3 steeringAxis = b3MulSV(den, b3Cross(matrixB.cz, b3Sub(b3MulSV(-cs, matrixA.cy), b3MulSV(ss, matrixA.cz))));
        f32 k = b3Dot(steeringAxis, b3MulMV(invInertiaSum, steeringAxis));
        joint.steeringMass = k > 0.0f ? 1.0f / k : 0.0f;
    }
    if context.enableWarmStarting == false {
        joint.linearImpulse = b3Vec2{0.0f, 0.0f};
        joint.angularImpulse = b3Vec2{0.0f, 0.0f};
        joint.spinImpulse = 0.0f;
        joint.suspensionSpringImpulse = 0.0f;
        joint.lowerSuspensionImpulse = 0.0f;
        joint.upperSuspensionImpulse = 0.0f;
        joint.steeringSpringImpulse = 0.0f;
        joint.lowerSteeringImpulse = 0.0f;
        joint.upperSteeringImpulse = 0.0f;
    }
}

void b3WarmStartWheelJoint(b3JointSim* base, b3StepContext* context) {
    f32 mA = base.invMassA;
    f32 mB = base.invMassB;
    b3Matrix3 iA = base.invIA;
    b3Matrix3 iB = base.invIB;
    b3BodyState dummyState = b3_identityBodyState;
    b3WheelJoint* joint = &base.wheelJoint;
    b3BodyState* stateA = joint.indexA == -1 ? &dummyState : context.states + joint.indexA;
    b3BodyState* stateB = joint.indexB == -1 ? &dummyState : context.states + joint.indexB;
    b3Vec3 rA = b3RotateVector(stateA.deltaRotation, joint.frameA.p);
    b3Vec3 rB = b3RotateVector(stateB.deltaRotation, joint.frameB.p);
    b3Vec3 d = b3Add(b3Add(b3Sub(stateB.deltaPosition, stateA.deltaPosition), joint.deltaCenter), b3Sub(rB, rA));
    b3Quat quatA = b3MulQuat(stateA.deltaRotation, joint.frameA.q);
    b3Quat quatB = b3MulQuat(stateB.deltaRotation, joint.frameB.q);
    if b3DotQuat(quatA, quatB) < 0.0f {
        quatB = b3NegateQuat(quatB);
    }
    b3Matrix3 matrixA = b3MakeMatrixFromQuat(quatA);
    b3Matrix3 matrixB = b3MakeMatrixFromQuat(quatB);
    b3Vec3 sAx = b3Cross(b3Add(d, rA), matrixA.cx);
    b3Vec3 sBx = b3Cross(rB, matrixA.cx);
    b3Vec3 sAy = b3Cross(b3Add(d, rA), matrixA.cy);
    b3Vec3 sBy = b3Cross(rB, matrixA.cy);
    b3Vec3 sAz = b3Cross(b3Add(d, rA), matrixA.cz);
    b3Vec3 sBz = b3Cross(rB, matrixA.cz);
    f32 suspensionImpulse = joint.suspensionSpringImpulse + joint.lowerSuspensionImpulse - joint.upperSuspensionImpulse;
    f32 linearImpulseY = joint.linearImpulse.x;
    f32 linearImpulseZ = joint.linearImpulse.y;
    f32 angularImpulseX = joint.angularImpulse.x;
    f32 angularImpulseY = joint.angularImpulse.y;
    b3Vec3 linearImpulse = b3Blend3(suspensionImpulse, matrixA.cx, linearImpulseY, matrixA.cy, linearImpulseZ, matrixA.cz);
    b3Vec3 angularImpulseA = b3Blend3(suspensionImpulse, sAx, linearImpulseY, sAy, linearImpulseZ, sAz);
    b3Vec3 angularImpulseB = b3Blend3(suspensionImpulse, sBx, linearImpulseY, sBy, linearImpulseZ, sBz);
    b3Vec3 angularImpulse = b3MulSV(joint.spinImpulse, matrixA.cz);
    b3Vec3 spinAxis = matrixB.cz;
    if joint.enableSteering != 0 {
        f32 cs = b3Dot(matrixB.cz, matrixA.cz);
        f32 ss = -b3Dot(matrixB.cz, matrixA.cy);
        f32 den = cs * cs + ss * ss;
        den = den > 0.0f ? 1.0f / den : 0.0f;
        b3Vec3 steeringAxis = b3MulSV(den, b3Cross(matrixB.cz, b3Sub(b3MulSV(-cs, matrixA.cy), b3MulSV(ss, matrixA.cz))));
        b3Vec3 perpAxis = b3Cross(spinAxis, matrixA.cx);
        f32 steeringImpulse = joint.steeringSpringImpulse + joint.lowerSteeringImpulse - joint.upperSteeringImpulse;
        angularImpulse = b3Blend3(angularImpulseX, perpAxis, joint.spinImpulse, spinAxis, steeringImpulse, steeringAxis);
    } else {
        b3Quat relQ = b3InvMulQuat(quatA, quatB);
        b3Vec3 perpAxisX = b3MulSV(0.5f, b3RotateVector(quatA, b3Add(b3MulSV(relQ.s, b3Vec3_axisX), b3Cross(relQ.v, b3Vec3_axisX))));
        b3Vec3 perpAxisY = b3MulSV(0.5f, b3RotateVector(quatA, b3Add(b3MulSV(relQ.s, b3Vec3_axisY), b3Cross(relQ.v, b3Vec3_axisY))));
        angularImpulse = b3Add(angularImpulse, b3Blend3(angularImpulseX, perpAxisX, angularImpulseY, perpAxisY, joint.spinImpulse, spinAxis));
    }
    if (stateA.flags & cast(u32, b3_dynamicFlag)) != 0 {
        stateA.linearVelocity = b3MulSub(stateA.linearVelocity, mA, linearImpulse);
        stateA.angularVelocity = b3Sub(stateA.angularVelocity, b3MulMV(iA, b3Add(angularImpulseA, angularImpulse)));
    }
    if (stateB.flags & cast(u32, b3_dynamicFlag)) != 0 {
        stateB.linearVelocity = b3MulAdd(stateB.linearVelocity, mB, linearImpulse);
        stateB.angularVelocity = b3Add(stateB.angularVelocity, b3MulMV(iB, b3Add(angularImpulseB, angularImpulse)));
    }
}

void b3SolveWheelJoint(b3JointSim* base, b3StepContext* context, bool useBias) {
    f32 mA = base.invMassA;
    f32 mB = base.invMassB;
    b3Matrix3 iA = base.invIA;
    b3Matrix3 iB = base.invIB;
    b3BodyState dummyState = b3_identityBodyState;
    b3WheelJoint* joint = &base.wheelJoint;
    b3BodyState* stateA = joint.indexA == -1 ? &dummyState : context.states + joint.indexA;
    b3BodyState* stateB = joint.indexB == -1 ? &dummyState : context.states + joint.indexB;
    b3Vec3 vA = stateA.linearVelocity;
    b3Vec3 wA = stateA.angularVelocity;
    b3Vec3 vB = stateB.linearVelocity;
    b3Vec3 wB = stateB.angularVelocity;
    bool fixedRotation = base.fixedRotation;
    b3Vec3 rA = b3RotateVector(stateA.deltaRotation, joint.frameA.p);
    b3Vec3 rB = b3RotateVector(stateB.deltaRotation, joint.frameB.p);
    b3Quat quatA = b3MulQuat(stateA.deltaRotation, joint.frameA.q);
    b3Quat quatB = b3MulQuat(stateB.deltaRotation, joint.frameB.q);
    if b3DotQuat(quatA, quatB) < 0.0f {
        quatB = b3NegateQuat(quatB);
    }
    b3Quat relQ = b3InvMulQuat(quatA, quatB);
    b3Matrix3 matrixA = b3MakeMatrixFromQuat(quatA);
    b3Matrix3 matrixB = b3MakeMatrixFromQuat(quatB);
    b3Vec3 d = b3Add(b3Add(b3Sub(stateB.deltaPosition, stateA.deltaPosition), joint.deltaCenter), b3Sub(rB, rA));
    b3Vec3 sAx = b3Cross(b3Add(d, rA), matrixA.cx);
    b3Vec3 sBx = b3Cross(rB, matrixA.cx);
    b3Vec3 sAy = b3Cross(b3Add(d, rA), matrixA.cy);
    b3Vec3 sBy = b3Cross(rB, matrixA.cy);
    b3Vec3 sAz = b3Cross(b3Add(d, rA), matrixA.cz);
    b3Vec3 sBz = b3Cross(rB, matrixA.cz);
    f32 translation = b3Dot(matrixA.cx, d);
    f32 cs = b3Dot(matrixB.cz, matrixA.cz);
    f32 ss = -b3Dot(matrixB.cz, matrixA.cy);
    f32 den = cs * cs + ss * ss;
    den = den > 0.0f ? 1.0f / den : 0.0f;
    b3Vec3 steeringAxis = b3MulSV(den, b3Cross(matrixB.cz, b3Sub(b3MulSV(-cs, matrixA.cy), b3MulSV(ss, matrixA.cz))));
    if joint.enableSpinMotor && fixedRotation == false {
        b3Vec3 spinAxis = matrixB.cz;
        f32 cdot = b3Dot(b3Sub(wB, wA), spinAxis) - joint.spinSpeed;
        f32 impulse = -joint.spinMass * cdot;
        f32 oldImpulse = joint.spinImpulse;
        f32 maxImpulse = context.h * joint.maxSpinTorque;
        joint.spinImpulse = b3ClampFloat(joint.spinImpulse + impulse, -maxImpulse, maxImpulse);
        impulse = joint.spinImpulse - oldImpulse;
        wA = b3Sub(wA, b3MulMV(iA, b3MulSV(impulse, spinAxis)));
        wB = b3Add(wB, b3MulMV(iB, b3MulSV(impulse, spinAxis)));
    }
    if joint.enableSuspensionSpring != 0 {
        f32 c = translation;
        f32 bias = joint.suspensionSoftness.biasRate * c;
        f32 massScale = joint.suspensionSoftness.massScale;
        f32 impulseScale = joint.suspensionSoftness.impulseScale;
        f32 cdot = b3Dot(matrixA.cx, b3Sub(vB, vA)) + b3Dot(sBx, wB) - b3Dot(sAx, wA);
        f32 impulse = -massScale * joint.suspensionMass * (cdot + bias) - impulseScale * joint.suspensionSpringImpulse;
        joint.suspensionSpringImpulse += impulse;
        b3Vec3 linearImpulse = b3MulSV(impulse, matrixA.cx);
        b3Vec3 angularImpulseA = b3MulSV(impulse, sAx);
        b3Vec3 angularImpulseB = b3MulSV(impulse, sBx);
        vA = b3MulSub(vA, mA, linearImpulse);
        wA = b3Sub(wA, b3MulMV(iA, angularImpulseA));
        vB = b3MulAdd(vB, mB, linearImpulse);
        wB = b3Add(wB, b3MulMV(iB, angularImpulseB));
    }
    if joint.enableSteering && fixedRotation == false {
        f32 steeringAngle = b3Atan2(ss, cs);
        {
            f32 c = steeringAngle - joint.targetSteeringAngle;
            f32 bias = joint.steeringSoftness.biasRate * c;
            f32 massScale = joint.steeringSoftness.massScale;
            f32 impulseScale = joint.steeringSoftness.impulseScale;
            f32 cdot = b3Dot(steeringAxis, b3Sub(wB, wA));
            f32 oldImpulse = joint.steeringSpringImpulse;
            f32 impulse = -massScale * joint.steeringMass * (cdot + bias) - impulseScale * oldImpulse;
            f32 maxImpulse = context.h * joint.maxSteeringTorque;
            joint.steeringSpringImpulse = b3ClampFloat(oldImpulse + impulse, -maxImpulse, maxImpulse);
            impulse = joint.steeringSpringImpulse - oldImpulse;
            wA = b3Sub(wA, b3MulMV(iA, b3MulSV(impulse, steeringAxis)));
            wB = b3Add(wB, b3MulMV(iB, b3MulSV(impulse, steeringAxis)));
        }
        if joint.enableSteeringLimit != 0 {
            {
                f32 c = steeringAngle - joint.lowerSteeringLimit;
                f32 bias = 0.0f;
                f32 massScale = 1.0f;
                f32 impulseScale = 0.0f;
                if c > 0.0f {
                    bias = c * context.inv_h;
                } else if useBias != 0 {
                    bias = base.constraintSoftness.biasRate * c;
                    massScale = base.constraintSoftness.massScale;
                    impulseScale = base.constraintSoftness.impulseScale;
                }
                f32 cdot = b3Dot(steeringAxis, b3Sub(wB, wA));
                f32 oldImpulse = joint.lowerSteeringImpulse;
                f32 impulse = -massScale * joint.steeringMass * (cdot + bias) - impulseScale * oldImpulse;
                joint.lowerSteeringImpulse = b3MaxFloat(oldImpulse + impulse, 0.0f);
                impulse = joint.lowerSteeringImpulse - oldImpulse;
                wA = b3Sub(wA, b3MulMV(iA, b3MulSV(impulse, steeringAxis)));
                wB = b3Add(wB, b3MulMV(iB, b3MulSV(impulse, steeringAxis)));
            }
            {
                f32 c = joint.upperSteeringLimit - steeringAngle;
                f32 bias = 0.0f;
                f32 massScale = 1.0f;
                f32 impulseScale = 0.0f;
                if c > 0.0f {
                    bias = c * context.inv_h;
                } else if useBias != 0 {
                    bias = base.constraintSoftness.biasRate * c;
                    massScale = base.constraintSoftness.massScale;
                    impulseScale = base.constraintSoftness.impulseScale;
                }
                f32 cdot = b3Dot(steeringAxis, b3Sub(wA, wB));
                f32 oldImpulse = joint.upperSteeringImpulse;
                f32 impulse = -massScale * joint.steeringMass * (cdot + bias) - impulseScale * oldImpulse;
                joint.upperSteeringImpulse = b3MaxFloat(oldImpulse + impulse, 0.0f);
                impulse = joint.upperSteeringImpulse - oldImpulse;
                wA = b3Add(wA, b3MulMV(iA, b3MulSV(impulse, steeringAxis)));
                wB = b3Sub(wB, b3MulMV(iB, b3MulSV(impulse, steeringAxis)));
            }
        }
    }
    if joint.enableSuspensionLimit != 0 {
        {
            f32 c = translation - joint.lowerSuspensionLimit;
            f32 bias = 0.0f;
            f32 massScale = 1.0f;
            f32 impulseScale = 0.0f;
            if c > 0.0f {
                bias = c * context.inv_h;
            } else if useBias != 0 {
                bias = base.constraintSoftness.biasRate * c;
                massScale = base.constraintSoftness.massScale;
                impulseScale = base.constraintSoftness.impulseScale;
            }
            f32 cdot = b3Dot(matrixA.cx, b3Sub(vB, vA)) + b3Dot(sBx, wB) - b3Dot(sAx, wA);
            f32 impulse = -massScale * joint.suspensionMass * (cdot + bias) - impulseScale * joint.lowerSuspensionImpulse;
            f32 oldImpulse = joint.lowerSuspensionImpulse;
            joint.lowerSuspensionImpulse = b3MaxFloat(oldImpulse + impulse, 0.0f);
            impulse = joint.lowerSuspensionImpulse - oldImpulse;
            b3Vec3 linearImpulse = b3MulSV(impulse, matrixA.cx);
            b3Vec3 angularImpulseA = b3MulSV(impulse, sAx);
            b3Vec3 angularImpulseB = b3MulSV(impulse, sBx);
            vA = b3MulSub(vA, mA, linearImpulse);
            wA = b3Sub(wA, b3MulMV(iA, angularImpulseA));
            vB = b3MulAdd(vB, mB, linearImpulse);
            wB = b3Add(wB, b3MulMV(iB, angularImpulseB));
        }
        {
            f32 c = joint.upperSuspensionLimit - translation;
            f32 bias = 0.0f;
            f32 massScale = 1.0f;
            f32 impulseScale = 0.0f;
            if c > 0.0f {
                bias = c * context.inv_h;
            } else if useBias != 0 {
                bias = base.constraintSoftness.biasRate * c;
                massScale = base.constraintSoftness.massScale;
                impulseScale = base.constraintSoftness.impulseScale;
            }
            f32 cdot = b3Dot(matrixA.cx, b3Sub(vA, vB)) + b3Dot(sAx, wA) - b3Dot(sBx, wB);
            f32 impulse = -massScale * joint.suspensionMass * (cdot + bias) - impulseScale * joint.upperSuspensionImpulse;
            f32 oldImpulse = joint.upperSuspensionImpulse;
            joint.upperSuspensionImpulse = b3MaxFloat(oldImpulse + impulse, 0.0f);
            impulse = joint.upperSuspensionImpulse - oldImpulse;
            b3Vec3 linearImpulse = b3MulSV(impulse, matrixA.cx);
            b3Vec3 angularImpulseA = b3MulSV(impulse, sAx);
            b3Vec3 angularImpulseB = b3MulSV(impulse, sBx);
            vA = b3MulAdd(vA, mA, linearImpulse);
            wA = b3Add(wA, b3MulMV(iA, angularImpulseA));
            vB = b3MulSub(vB, mB, linearImpulse);
            wB = b3Sub(wB, b3MulMV(iB, angularImpulseB));
        }
    }
    if fixedRotation == false {
        if joint.enableSteering == true {
            f32 bias = 0.0f;
            f32 massScale = 1.0f;
            f32 impulseScale = 0.0f;
            if useBias != 0 {
                f32 c = b3Dot(matrixA.cx, matrixB.cz);
                bias = base.constraintSoftness.biasRate * c;
                massScale = base.constraintSoftness.massScale;
                impulseScale = base.constraintSoftness.impulseScale;
            }
            b3Vec3 u = b3Cross(matrixB.cz, matrixA.cx);
            f32 cdot = b3Dot(b3Sub(wB, wA), u);
            b3Matrix3 invInertiaSum = b3AddMM(iA, iB);
            f32 k = b3Dot(u, b3MulMV(invInertiaSum, u));
            f32 perpMass = k > 0.0f ? 1.0f / k : 0.0f;
            f32 deltaImpulse = -massScale * perpMass * (cdot + bias) - impulseScale * joint.angularImpulse.x;
            joint.angularImpulse.x += deltaImpulse;
            wA = b3MulSub(wA, deltaImpulse, b3MulMV(iA, u));
            wB = b3MulAdd(wB, deltaImpulse, b3MulMV(iB, u));
        } else {
            var bias = b3Vec2{0.0f, 0.0f};
            f32 massScale = 1.0f;
            f32 impulseScale = 0.0f;
            if useBias != 0 {
                var c = b3Vec2{relQ.v.x, relQ.v.y};
                bias = b3Vec2{
                    base.constraintSoftness.biasRate * c.x, base.constraintSoftness.biasRate * c.y,
                };
                massScale = base.constraintSoftness.massScale;
                impulseScale = base.constraintSoftness.impulseScale;
            }
            b3Vec3 perpAxisX = b3MulSV(0.5f, b3RotateVector(quatA, b3Add(b3MulSV(relQ.s, b3Vec3_axisX), b3Cross(relQ.v, b3Vec3_axisX))));
            b3Vec3 perpAxisY = b3MulSV(0.5f, b3RotateVector(quatA, b3Add(b3MulSV(relQ.s, b3Vec3_axisY), b3Cross(relQ.v, b3Vec3_axisY))));
            b3Matrix3 invInertiaSum = b3AddMM(iA, iB);
            f32 kxx = b3Dot(perpAxisX, b3MulMV(invInertiaSum, perpAxisX));
            f32 kyy = b3Dot(perpAxisY, b3MulMV(invInertiaSum, perpAxisY));
            f32 kxy = b3Dot(perpAxisX, b3MulMV(invInertiaSum, perpAxisY));
            var k = b3Matrix2{b3Vec2{kxx, kxy}, b3Vec2{kxy, kyy}};
            b3Vec3 wRel = b3Sub(wB, wA);
            var cdot = b3Vec2{b3Dot(wRel, perpAxisX), b3Dot(wRel, perpAxisY)};
            b3Vec2 oldImpulse = joint.angularImpulse;
            var cdotPlusBias = b3Vec2{cdot.x + bias.x, cdot.y + bias.y};
            b3Vec2 sol = b3Solve2(k, cdotPlusBias);
            var deltaImpulse = b3Vec2{
                -massScale * sol.x - impulseScale * oldImpulse.x,
                -massScale * sol.y - impulseScale * oldImpulse.y,
            };
            joint.angularImpulse = b3Vec2{
                oldImpulse.x + deltaImpulse.x, oldImpulse.y + deltaImpulse.y,
            };
            b3Vec3 angularImpulse = b3Blend2(deltaImpulse.x, perpAxisX, deltaImpulse.y, perpAxisY);
            wA = b3Sub(wA, b3MulMV(iA, angularImpulse));
            wB = b3Add(wB, b3MulMV(iB, angularImpulse));
        }
    }
    {
        b3Vec3 perpY = matrixA.cy;
        b3Vec3 perpZ = matrixA.cz;
        var bias = b3Vec2{0.0f, 0.0f};
        f32 massScale = 1.0f;
        f32 impulseScale = 0.0f;
        if useBias != 0 {
            var c = b3Vec2{b3Dot(perpY, d), b3Dot(perpZ, d)};
            bias = b3Vec2{
                base.constraintSoftness.biasRate * c.x, base.constraintSoftness.biasRate * c.y,
            };
            massScale = base.constraintSoftness.massScale;
            impulseScale = base.constraintSoftness.impulseScale;
        }
        b3Vec3 vRel = b3Sub(b3Sub(b3Add(vB, b3Cross(wB, rB)), vA), b3Cross(wA, b3Add(rA, d)));
        var cdot = b3Vec2{b3Dot(perpY, vRel), b3Dot(perpZ, vRel)};
        f32 kyy = mA + mB + b3Dot(sAy, b3MulMV(iA, sAy)) + b3Dot(sBy, b3MulMV(iB, sBy));
        f32 kyz = b3Dot(sAy, b3MulMV(iA, sAz)) + b3Dot(sBy, b3MulMV(iB, sBz));
        f32 kzz = mA + mB + b3Dot(sAz, b3MulMV(iA, sAz)) + b3Dot(sBz, b3MulMV(iB, sBz));
        var k = b3Matrix2{b3Vec2{kyy, kyz}, b3Vec2{kyz, kzz}};
        b3Vec2 oldImpulse = joint.linearImpulse;
        var cdotPlusBias = b3Vec2{cdot.x + bias.x, cdot.y + bias.y};
        b3Vec2 sol = b3Solve2(k, cdotPlusBias);
        var deltaImpulse = b3Vec2{
            -massScale * sol.x - impulseScale * oldImpulse.x,
            -massScale * sol.y - impulseScale * oldImpulse.y,
        };
        joint.linearImpulse = b3Vec2{oldImpulse.x + deltaImpulse.x, oldImpulse.y + deltaImpulse.y};
        b3Vec3 linearImpulse = b3Blend2(deltaImpulse.x, perpY, deltaImpulse.y, perpZ);
        vA = b3MulSub(vA, mA, linearImpulse);
        wA = b3Sub(wA, b3MulMV(iA, b3Blend2(deltaImpulse.x, sAy, deltaImpulse.y, sAz)));
        vB = b3MulAdd(vB, mB, linearImpulse);
        wB = b3Add(wB, b3MulMV(iB, b3Blend2(deltaImpulse.x, sBy, deltaImpulse.y, sBz)));
    }
    if (stateA.flags & cast(u32, b3_dynamicFlag)) != 0 {
        stateA.linearVelocity = vA;
        stateA.angularVelocity = wA;
    }
    if (stateB.flags & cast(u32, b3_dynamicFlag)) != 0 {
        stateB.linearVelocity = vB;
        stateB.angularVelocity = wB;
    }
}

void b3DrawWheelJoint(b3DebugDraw* draw, b3JointSim* base, b3WorldTransform transformA, b3WorldTransform transformB, f32 scale) {
    b3WheelJoint* joint = &base.wheelJoint;
    b3WorldTransform frameA = b3MulWorldTransforms(transformA, base.localFrameA);
    b3WorldTransform frameB = b3MulWorldTransforms(transformB, base.localFrameB);
    b3Matrix3 matrixA = b3MakeMatrixFromQuat(frameA.q);
    b3Matrix3 matrixB = b3MakeMatrixFromQuat(frameB.q);
    draw.DrawSegmentFcn(frameA.p, frameB.p, b3_colorBlue, draw.context);
    if joint.enableSuspensionLimit != 0 {
        b3Pos lower = b3OffsetPos(frameA.p, b3MulSV(joint.lowerSuspensionLimit, matrixA.cx));
        b3Pos upper = b3OffsetPos(frameA.p, b3MulSV(joint.upperSuspensionLimit, matrixA.cx));
        b3Vec3 perp = matrixA.cy;
        draw.DrawSegmentFcn(lower, upper, b3_colorGray, draw.context);
        draw.DrawSegmentFcn(b3OffsetPos(lower, b3MulSV(-0.1f * scale, perp)), b3OffsetPos(lower, b3MulSV(0.1f * scale, perp)), b3_colorGreen, draw.context);
        draw.DrawSegmentFcn(b3OffsetPos(upper, b3MulSV(-0.1f * scale, perp)), b3OffsetPos(upper, b3MulSV(0.1f * scale, perp)), b3_colorRed, draw.context);
    } else {
        draw.DrawSegmentFcn(b3OffsetPos(frameA.p, b3MulSV(-1.0f * scale, matrixA.cx)), b3OffsetPos(frameA.p, b3MulSV(1.0f * scale, matrixA.cx)), b3_colorGray, draw.context);
    }
    if joint.enableSteering && joint.enableSteeringLimit {
        var frame = b3WorldTransform{.p = frameB.p, .q = frameA.q};
        f32 radius = 0.5f * scale;
        i32 sliceCount = 16;
        f32 lower = joint.lowerSteeringLimit;
        f32 upper = joint.upperSteeringLimit;
        b3CosSin cs = b3ComputeCosSin(lower);
        b3Pos vertex1 = b3TransformWorldPoint(frame, b3Vec3{0.0f, -radius * cs.sine, radius * cs.cosine});
        for i32 index = 0; index < sliceCount; ++index {
            f32 t2 = (cast(f32, index) + 1.0f) / cast(f32, sliceCount);
            f32 phi = b3LerpFloat(lower, upper, t2);
            cs = b3ComputeCosSin(phi);
            b3Pos vertex2 = b3TransformWorldPoint(frame, b3Vec3{0.0f, -radius * cs.sine, radius * cs.cosine});
            if index == 0 {
                draw.DrawSegmentFcn(frame.p, vertex1, b3_colorCyan, draw.context);
            }
            if index == sliceCount - 1 {
                draw.DrawSegmentFcn(vertex2, frame.p, b3_colorCyan, draw.context);
            }
            draw.DrawSegmentFcn(vertex1, vertex2, b3_colorCyan, draw.context);
            vertex1 = vertex2;
        }
    }
    draw.DrawSegmentFcn(b3OffsetPos(frameB.p, b3MulSV(-0.5f * scale, matrixB.cz)), b3OffsetPos(frameB.p, b3MulSV(0.5f * scale, matrixB.cz)), b3_colorMagenta, draw.context);
    draw.DrawPointFcn(frameA.p, 5.0f, b3_colorGray, draw.context);
    draw.DrawPointFcn(frameB.p, 5.0f, b3_colorDimGray, draw.context);
}

// SPDX-FileCopyrightText: 2026 Erin Catto
// SPDX-License-Identifier: MIT
// Snapshot image magic 'BNS3' and version
// Layout hash over all POD-copied structs + key constants.
// Changing a struct size updates this, catching ABI drift early.
private {
u32 b3ComputeLayoutHash() {
    u32 h = 2166136261;
    h ^= cast(u32, sizeof(b3Body));
    h *= 16777619;
    h ^= cast(u32, sizeof(b3BodySim));
    h *= 16777619;
    h ^= cast(u32, sizeof(b3BodyState));
    h *= 16777619;
    h ^= cast(u32, sizeof(b3Shape));
    h *= 16777619;
    h ^= cast(u32, sizeof(b3Contact));
    h *= 16777619;
    h ^= cast(u32, sizeof(b3Manifold));
    h *= 16777619;
    h ^= cast(u32, sizeof(b3Joint));
    h *= 16777619;
    h ^= cast(u32, sizeof(b3JointSim));
    h *= 16777619;
    h ^= cast(u32, sizeof(b3Island));
    h *= 16777619;
    h ^= cast(u32, sizeof(b3IslandSim));
    h *= 16777619;
    h ^= cast(u32, sizeof(b3ContactLink));
    h *= 16777619;
    h ^= cast(u32, sizeof(b3JointLink));
    h *= 16777619;
    h ^= cast(u32, sizeof(b3Sensor));
    h *= 16777619;
    h ^= cast(u32, sizeof(b3Visitor));
    h *= 16777619;
    h ^= cast(u32, sizeof(b3SolverSet));
    h *= 16777619;
    h ^= cast(u32, sizeof(b3GraphColor));
    h *= 16777619;
    h ^= cast(u32, sizeof(b3DynamicTree));
    h *= 16777619;
    h ^= cast(u32, sizeof(b3TreeNode));
    h *= 16777619;
    h ^= cast(u32, sizeof(b3SetItem));
    h *= 16777619;
    h ^= cast(u32, sizeof(b3IdPool));
    h *= 16777619;
    h ^= cast(u32, sizeof(b3SurfaceMaterial));
    h *= 16777619;
    h ^= cast(u32, sizeof(b3ContactSpec));
    h *= 16777619;
    h ^= cast(u32, sizeof(b3TriangleCache));
    h *= 16777619;
    h ^= cast(u32, 24);
    h *= 16777619;
    h ^= cast(u32, b3_bodyTypeCount);
    h *= 16777619;
    h ^= cast(u32, sizeof(void*));
    h *= 16777619;
    return h;
}

void b3SnapRCheck(b3SnapReader* r, i32 need) {
    if need < 0 || cast(i64, r.cursor) + cast(i64, need) > cast(i64, r.size) {
        r.ok = false;
    }
}

void b3SnapR_Bytes(b3SnapReader* r, void* dst, i32 n) {
    b3SnapRCheck(r, n);
    if r.ok == 0 {
        return;
    }
    memcpy(dst, r.data + r.cursor, cast(u64, n));
    r.cursor += n;
}

i32 b3SnapR_I32(b3SnapReader* r) {
    i32 v = 0;
    b3SnapR_Bytes(r, &v, 4);
    return v;
}

u32 b3SnapR_U32(b3SnapReader* r) {
    u32 v = 0;
    b3SnapR_Bytes(r, &v, 4);
    return v;
}

void b3SnapW_I32(b3RecBuffer* buf, i32 v) {
    var w = v;
    b3RecBufAppend(buf, &w, 4);
}

void b3SnapW_U32(b3RecBuffer* buf, u32 v) {
    b3RecBufAppend(buf, &v, 4);
}

void b3SnapW_Bytes(b3RecBuffer* buf, void* src, i32 n) {
    b3RecBufAppend(buf, src, n);
}

// Bounds check before allocating from image
bool b3SnapCheckCount(b3SnapReader* r, i32 count, i32 memSize, i32 minStreamBytes) {
    if count < 0 || memSize < 0 || minStreamBytes < 0 {
        return false;
    }
    if memSize > 0 && count > 0x7FFFFFFF / memSize {
        return false;
    }
    i64 remaining = cast(i64, r.size) - cast(i64, r.cursor);
    return cast(i64, count) * cast(i64, minStreamBytes) <= remaining;
}

// POD array: count + raw bytes
// Id pool: nextIndex + freeArray
void b3SerIdPool(b3RecBuffer* buf, b3IdPool* pool) {
    b3SnapW_I32(buf, pool.nextIndex);
    while true {
        b3SnapW_I32(buf, pool.freeArray.count);
        if pool.freeArray.count > 0 {
            b3SnapW_Bytes(buf, pool.freeArray.data, pool.freeArray.count * cast(i32, sizeof(*pool.freeArray.data)));
        }
        if !(0 != 0) { break; }
    }
}

void b3DesIdPool(b3SnapReader* r, b3IdPool* pool) {
    pool.nextIndex = b3SnapR_I32(r);
    while true {
        i32 cnt = b3SnapR_I32(r);
        var elemSize = cast(i32, sizeof(*pool.freeArray.data));
        if r.ok && b3SnapCheckCount(r, cnt, elemSize, elemSize) == false {
            r.ok = false;
        }
        if r.ok && cnt > 0 {
            while true {
                while true {
                    if pool.freeArray.capacity < cnt {
                        var oldSize = cast(i32, pool.freeArray.capacity * sizeof(*pool.freeArray.data));
                        var newSize = cast(i32, cnt * sizeof(*pool.freeArray.data));
                        pool.freeArray.data = b3GrowAlloc(pool.freeArray.data, oldSize, newSize);
                        pool.freeArray.capacity = cnt;
                    }
                    if !(0 != 0) { break; }
                }
                pool.freeArray.count = cnt;
                if !(0 != 0) { break; }
            }
            b3SnapR_Bytes(r, pool.freeArray.data, cnt * elemSize);
        } else if r.ok != 0 {
            pool.freeArray.count = 0;
        }
        if !(0 != 0) { break; }
    }
}

// BitSet: blockCount + raw words
void b3SerBitSet(b3RecBuffer* buf, b3BitSet* bs) {
    b3SnapW_U32(buf, bs.blockCount);
    if bs.blockCount > 0 {
        b3SnapW_Bytes(buf, bs.bits, cast(i32, bs.blockCount * sizeof(u64)));
    }
}

void b3DesBitSet(b3SnapReader* r, b3BitSet* bs) {
    u32 blockCount = b3SnapR_U32(r);
    if r.ok && b3SnapCheckCount(r, cast(i32, blockCount), cast(i32, sizeof(u64)), cast(i32, sizeof(u64))) == false {
        r.ok = false;
    }
    b3DestroyBitSet(bs);
    if r.ok == 0 {
        return;
    }
    u32 blockCapacity = blockCount > 0 ? blockCount : 1;
    bs.bits = cast(u64*, b3Alloc(cast(u64, blockCapacity * sizeof(u64))));
    memset(bs.bits, 0, cast(u64, blockCapacity * sizeof(u64)));
    bs.blockCapacity = blockCapacity;
    bs.blockCount = blockCount;
    if blockCount > 0 {
        b3SnapR_Bytes(r, bs.bits, cast(i32, blockCount * sizeof(u64)));
    }
}

// HashSet: capacity + count + raw items (probe order depends on layout)
void b3SerHashSet(b3RecBuffer* buf, b3HashSet* hs) {
    b3SnapW_U32(buf, hs.capacity);
    b3SnapW_U32(buf, hs.count);
    if hs.capacity > 0 {
        b3SnapW_Bytes(buf, hs.items, cast(i32, hs.capacity * sizeof(b3SetItem)));
    }
}

void b3DesHashSet(b3SnapReader* r, b3HashSet* hs) {
    u32 cap = b3SnapR_U32(r);
    u32 cnt = b3SnapR_U32(r);
    bool valid = b3SnapCheckCount(r, cast(i32, cap), cast(i32, sizeof(b3SetItem)), cast(i32, sizeof(b3SetItem))) && (cap & cap - 1) == 0 && cnt <= cap;
    if r.ok && valid == false && (cap != 0 || cnt != 0) {
        r.ok = false;
    }
    b3DestroySet(hs);
    if r.ok == 0 {
        return;
    }
    if cap > 0 {
        hs.items = cast(b3SetItem*, b3Alloc(cast(u64, cap * sizeof(b3SetItem))));
        hs.capacity = cap;
        hs.count = cnt;
        b3SnapR_Bytes(r, hs.items, cast(i32, cap * sizeof(b3SetItem)));
    } else {
        hs.items = null;
        hs.capacity = 0;
        hs.count = 0;
    }
}

// DynamicTree: version, scalars, full nodeCapacity nodes (rebuild scratch excluded)
void b3SerTree(b3RecBuffer* buf, b3DynamicTree* tree) {
    b3SnapW_Bytes(buf, &tree.version, cast(i32, sizeof(u64)));
    b3SnapW_I32(buf, tree.root);
    b3SnapW_I32(buf, tree.nodeCount);
    b3SnapW_I32(buf, tree.nodeCapacity);
    b3SnapW_I32(buf, tree.freeList);
    b3SnapW_I32(buf, tree.proxyCount);
    if tree.nodeCapacity > 0 {
        b3SnapW_Bytes(buf, tree.nodes, tree.nodeCapacity * cast(i32, sizeof(b3TreeNode)));
    }
}

void b3DesTree(b3SnapReader* r, b3DynamicTree* tree) {
    u64 version;
    b3SnapR_Bytes(r, &version, cast(i32, sizeof(u64)));
    i32 root = b3SnapR_I32(r);
    i32 nodeCount = b3SnapR_I32(r);
    i32 nodeCapacity = b3SnapR_I32(r);
    i32 freeList = b3SnapR_I32(r);
    i32 proxyCount = b3SnapR_I32(r);
    if r.ok && b3SnapCheckCount(r, nodeCapacity, cast(i32, sizeof(b3TreeNode)), cast(i32, sizeof(b3TreeNode))) == false {
        r.ok = false;
    }
    b3Free(tree.nodes, cast(u64, tree.nodeCapacity * cast(i32, sizeof(b3TreeNode))));
    b3Free(tree.leafIndices, cast(u64, tree.rebuildCapacity * cast(i32, sizeof(i32))));
    b3Free(tree.leafBoxes, cast(u64, tree.rebuildCapacity * cast(i32, sizeof(b3AABB))));
    b3Free(tree.leafCenters, cast(u64, tree.rebuildCapacity * cast(i32, sizeof(b3Vec3))));
    b3Free(tree.binIndices, cast(u64, tree.rebuildCapacity * cast(i32, sizeof(i32))));
    tree.nodes = null;
    tree.leafIndices = null;
    tree.leafBoxes = null;
    tree.leafCenters = null;
    tree.binIndices = null;
    tree.nodeCapacity = 0;
    tree.rebuildCapacity = 0;
    if r.ok == 0 {
        return;
    }
    tree.version = version;
    tree.root = root;
    tree.nodeCount = nodeCount;
    tree.nodeCapacity = nodeCapacity;
    tree.freeList = freeList;
    tree.proxyCount = proxyCount;
    if nodeCapacity > 0 {
        tree.nodes = cast(b3TreeNode*, b3Alloc(cast(u64, nodeCapacity * cast(i32, sizeof(b3TreeNode)))));
        b3SnapR_Bytes(r, tree.nodes, nodeCapacity * cast(i32, sizeof(b3TreeNode)));
    }
}

// Solver set: setIndex + 4 arrays (note: contactIndices is int array, not contactSims)
void b3SerSolverSet(b3RecBuffer* buf, b3SolverSet* set) {
    b3SnapW_I32(buf, set.setIndex);
    while true {
        b3SnapW_I32(buf, set.bodySims.count);
        if set.bodySims.count > 0 {
            b3SnapW_Bytes(buf, set.bodySims.data, set.bodySims.count * cast(i32, sizeof(*set.bodySims.data)));
        }
        if !(0 != 0) { break; }
    }
    while true {
        b3SnapW_I32(buf, set.bodyStates.count);
        if set.bodyStates.count > 0 {
            b3SnapW_Bytes(buf, set.bodyStates.data, set.bodyStates.count * cast(i32, sizeof(*set.bodyStates.data)));
        }
        if !(0 != 0) { break; }
    }
    while true {
        b3SnapW_I32(buf, set.jointSims.count);
        if set.jointSims.count > 0 {
            b3SnapW_Bytes(buf, set.jointSims.data, set.jointSims.count * cast(i32, sizeof(*set.jointSims.data)));
        }
        if !(0 != 0) { break; }
    }
    while true {
        b3SnapW_I32(buf, set.contactIndices.count);
        if set.contactIndices.count > 0 {
            b3SnapW_Bytes(buf, set.contactIndices.data, set.contactIndices.count * cast(i32, sizeof(*set.contactIndices.data)));
        }
        if !(0 != 0) { break; }
    }
    while true {
        b3SnapW_I32(buf, set.islandSims.count);
        if set.islandSims.count > 0 {
            b3SnapW_Bytes(buf, set.islandSims.data, set.islandSims.count * cast(i32, sizeof(*set.islandSims.data)));
        }
        if !(0 != 0) { break; }
    }
}

void b3DesSolverSet(b3SnapReader* r, b3SolverSet* set) {
    set.setIndex = b3SnapR_I32(r);
    while true {
        i32 cnt = b3SnapR_I32(r);
        var elemSize = cast(i32, sizeof(*set.bodySims.data));
        if r.ok && b3SnapCheckCount(r, cnt, elemSize, elemSize) == false {
            r.ok = false;
        }
        if r.ok && cnt > 0 {
            while true {
                while true {
                    if set.bodySims.capacity < cnt {
                        var oldSize = cast(i32, set.bodySims.capacity * sizeof(*set.bodySims.data));
                        var newSize = cast(i32, cnt * sizeof(*set.bodySims.data));
                        set.bodySims.data = b3GrowAlloc(set.bodySims.data, oldSize, newSize);
                        set.bodySims.capacity = cnt;
                    }
                    if !(0 != 0) { break; }
                }
                set.bodySims.count = cnt;
                if !(0 != 0) { break; }
            }
            b3SnapR_Bytes(r, set.bodySims.data, cnt * elemSize);
        } else if r.ok != 0 {
            set.bodySims.count = 0;
        }
        if !(0 != 0) { break; }
    }
    while true {
        i32 cnt = b3SnapR_I32(r);
        var elemSize = cast(i32, sizeof(*set.bodyStates.data));
        if r.ok && b3SnapCheckCount(r, cnt, elemSize, elemSize) == false {
            r.ok = false;
        }
        if r.ok && cnt > 0 {
            while true {
                while true {
                    if set.bodyStates.capacity < cnt {
                        var oldSize = cast(i32, set.bodyStates.capacity * sizeof(*set.bodyStates.data));
                        var newSize = cast(i32, cnt * sizeof(*set.bodyStates.data));
                        set.bodyStates.data = b3GrowAlloc(set.bodyStates.data, oldSize, newSize);
                        set.bodyStates.capacity = cnt;
                    }
                    if !(0 != 0) { break; }
                }
                set.bodyStates.count = cnt;
                if !(0 != 0) { break; }
            }
            b3SnapR_Bytes(r, set.bodyStates.data, cnt * elemSize);
        } else if r.ok != 0 {
            set.bodyStates.count = 0;
        }
        if !(0 != 0) { break; }
    }
    while true {
        i32 cnt = b3SnapR_I32(r);
        var elemSize = cast(i32, sizeof(*set.jointSims.data));
        if r.ok && b3SnapCheckCount(r, cnt, elemSize, elemSize) == false {
            r.ok = false;
        }
        if r.ok && cnt > 0 {
            while true {
                while true {
                    if set.jointSims.capacity < cnt {
                        var oldSize = cast(i32, set.jointSims.capacity * sizeof(*set.jointSims.data));
                        var newSize = cast(i32, cnt * sizeof(*set.jointSims.data));
                        set.jointSims.data = b3GrowAlloc(set.jointSims.data, oldSize, newSize);
                        set.jointSims.capacity = cnt;
                    }
                    if !(0 != 0) { break; }
                }
                set.jointSims.count = cnt;
                if !(0 != 0) { break; }
            }
            b3SnapR_Bytes(r, set.jointSims.data, cnt * elemSize);
        } else if r.ok != 0 {
            set.jointSims.count = 0;
        }
        if !(0 != 0) { break; }
    }
    while true {
        i32 cnt = b3SnapR_I32(r);
        var elemSize = cast(i32, sizeof(*set.contactIndices.data));
        if r.ok && b3SnapCheckCount(r, cnt, elemSize, elemSize) == false {
            r.ok = false;
        }
        if r.ok && cnt > 0 {
            while true {
                while true {
                    if set.contactIndices.capacity < cnt {
                        var oldSize = cast(i32, set.contactIndices.capacity * sizeof(*set.contactIndices.data));
                        var newSize = cast(i32, cnt * sizeof(*set.contactIndices.data));
                        set.contactIndices.data = b3GrowAlloc(set.contactIndices.data, oldSize, newSize);
                        set.contactIndices.capacity = cnt;
                    }
                    if !(0 != 0) { break; }
                }
                set.contactIndices.count = cnt;
                if !(0 != 0) { break; }
            }
            b3SnapR_Bytes(r, set.contactIndices.data, cnt * elemSize);
        } else if r.ok != 0 {
            set.contactIndices.count = 0;
        }
        if !(0 != 0) { break; }
    }
    while true {
        i32 cnt = b3SnapR_I32(r);
        var elemSize = cast(i32, sizeof(*set.islandSims.data));
        if r.ok && b3SnapCheckCount(r, cnt, elemSize, elemSize) == false {
            r.ok = false;
        }
        if r.ok && cnt > 0 {
            while true {
                while true {
                    if set.islandSims.capacity < cnt {
                        var oldSize = cast(i32, set.islandSims.capacity * sizeof(*set.islandSims.data));
                        var newSize = cast(i32, cnt * sizeof(*set.islandSims.data));
                        set.islandSims.data = b3GrowAlloc(set.islandSims.data, oldSize, newSize);
                        set.islandSims.capacity = cnt;
                    }
                    if !(0 != 0) { break; }
                }
                set.islandSims.count = cnt;
                if !(0 != 0) { break; }
            }
            b3SnapR_Bytes(r, set.islandSims.data, cnt * elemSize);
        } else if r.ok != 0 {
            set.islandSims.count = 0;
        }
        if !(0 != 0) { break; }
    }
}

void b3SerNames(b3RecBuffer* buf, b3NameCache* cache) {
    b3SnapW_I32(buf, cache.entries.count);
    i32 count = cache.entries.count;
    for i32 i = 0; i < count; ++i {
        b3NameEntry* entry = cache.entries.data + i;
        b3SnapW_U32(buf, entry.hash);
        b3SnapW_I32(buf, entry.length);
        b3RecBufAppend(buf, entry.name, entry.length);
    }
}

void b3DesNames(b3SnapReader* r, b3NameCache* cache) {
    i32 count = b3SnapR_I32(r);
    if r.ok && b3SnapCheckCount(r, count, cast(i32, sizeof(b3NameEntry)), 8) == false {
        r.ok = false;
    }
    if r.ok == false {
        return;
    }
    while true {
        if cache.entries.capacity < count {
            var oldSize = cast(i32, cache.entries.capacity * sizeof(*cache.entries.data));
            var newSize = cast(i32, count * sizeof(*cache.entries.data));
            cache.entries.data = b3GrowAlloc(cache.entries.data, oldSize, newSize);
            cache.entries.capacity = count;
        }
        if !(0 != 0) { break; }
    }
    for i32 i = 0; i < count; ++i {
        u32 hash = b3SnapR_U32(r);
        i32 length = b3SnapR_I32(r);
        if r.ok == false || length < 0 || length > r.size - r.cursor {
            r.ok = false;
            return;
        }
        u8* name = b3Alloc(cast(u64, length + 1));
        b3SnapR_Bytes(r, name, length);
        name[length] = 0;
        b3LoadName(cache, hash, name, length);
    }
}

// Graph color: bodySet (non-overflow only) + jointSims + convexContacts + contacts
void b3SerGraphColor(b3RecBuffer* buf, b3GraphColor* color, bool isOverflow) {
    if isOverflow == 0 {
        b3SerBitSet(buf, &color.bodySet);
    }
    while true {
        b3SnapW_I32(buf, color.jointSims.count);
        if color.jointSims.count > 0 {
            b3SnapW_Bytes(buf, color.jointSims.data, color.jointSims.count * cast(i32, sizeof(*color.jointSims.data)));
        }
        if !(0 != 0) { break; }
    }
    while true {
        b3SnapW_I32(buf, color.convexContacts.count);
        if color.convexContacts.count > 0 {
            b3SnapW_Bytes(buf, color.convexContacts.data, color.convexContacts.count * cast(i32, sizeof(*color.convexContacts.data)));
        }
        if !(0 != 0) { break; }
    }
    while true {
        b3SnapW_I32(buf, color.contacts.count);
        if color.contacts.count > 0 {
            b3SnapW_Bytes(buf, color.contacts.data, color.contacts.count * cast(i32, sizeof(*color.contacts.data)));
        }
        if !(0 != 0) { break; }
    }
}

void b3DesGraphColor(b3SnapReader* r, b3GraphColor* color, bool isOverflow) {
    if isOverflow == 0 {
        b3DesBitSet(r, &color.bodySet);
    }
    while true {
        i32 cnt = b3SnapR_I32(r);
        var elemSize = cast(i32, sizeof(*color.jointSims.data));
        if r.ok && b3SnapCheckCount(r, cnt, elemSize, elemSize) == false {
            r.ok = false;
        }
        if r.ok && cnt > 0 {
            while true {
                while true {
                    if color.jointSims.capacity < cnt {
                        var oldSize = cast(i32, color.jointSims.capacity * sizeof(*color.jointSims.data));
                        var newSize = cast(i32, cnt * sizeof(*color.jointSims.data));
                        color.jointSims.data = b3GrowAlloc(color.jointSims.data, oldSize, newSize);
                        color.jointSims.capacity = cnt;
                    }
                    if !(0 != 0) { break; }
                }
                color.jointSims.count = cnt;
                if !(0 != 0) { break; }
            }
            b3SnapR_Bytes(r, color.jointSims.data, cnt * elemSize);
        } else if r.ok != 0 {
            color.jointSims.count = 0;
        }
        if !(0 != 0) { break; }
    }
    while true {
        i32 cnt = b3SnapR_I32(r);
        var elemSize = cast(i32, sizeof(*color.convexContacts.data));
        if r.ok && b3SnapCheckCount(r, cnt, elemSize, elemSize) == false {
            r.ok = false;
        }
        if r.ok && cnt > 0 {
            while true {
                while true {
                    if color.convexContacts.capacity < cnt {
                        var oldSize = cast(i32, color.convexContacts.capacity * sizeof(*color.convexContacts.data));
                        var newSize = cast(i32, cnt * sizeof(*color.convexContacts.data));
                        color.convexContacts.data = b3GrowAlloc(color.convexContacts.data, oldSize, newSize);
                        color.convexContacts.capacity = cnt;
                    }
                    if !(0 != 0) { break; }
                }
                color.convexContacts.count = cnt;
                if !(0 != 0) { break; }
            }
            b3SnapR_Bytes(r, color.convexContacts.data, cnt * elemSize);
        } else if r.ok != 0 {
            color.convexContacts.count = 0;
        }
        if !(0 != 0) { break; }
    }
    while true {
        i32 cnt = b3SnapR_I32(r);
        var elemSize = cast(i32, sizeof(*color.contacts.data));
        if r.ok && b3SnapCheckCount(r, cnt, elemSize, elemSize) == false {
            r.ok = false;
        }
        if r.ok && cnt > 0 {
            while true {
                while true {
                    if color.contacts.capacity < cnt {
                        var oldSize = cast(i32, color.contacts.capacity * sizeof(*color.contacts.data));
                        var newSize = cast(i32, cnt * sizeof(*color.contacts.data));
                        color.contacts.data = b3GrowAlloc(color.contacts.data, oldSize, newSize);
                        color.contacts.capacity = cnt;
                    }
                    if !(0 != 0) { break; }
                }
                color.contacts.count = cnt;
                if !(0 != 0) { break; }
            }
            b3SnapR_Bytes(r, color.contacts.data, cnt * elemSize);
        } else if r.ok != 0 {
            color.contacts.count = 0;
        }
        if !(0 != 0) { break; }
    }
}

// World simulation scalars (never host/callback/worker state)
void b3SerWorldConfig(b3RecBuffer* buf, b3World* world) {
    b3SnapW_Bytes(buf, &world.gravity, cast(i32, sizeof(b3Vec3)));
    b3SnapW_Bytes(buf, &world.hitEventThreshold, cast(i32, sizeof(f32)));
    b3SnapW_Bytes(buf, &world.restitutionThreshold, cast(i32, sizeof(f32)));
    b3SnapW_Bytes(buf, &world.maxLinearSpeed, cast(i32, sizeof(f32)));
    b3SnapW_Bytes(buf, &world.contactSpeed, cast(i32, sizeof(f32)));
    b3SnapW_Bytes(buf, &world.contactHertz, cast(i32, sizeof(f32)));
    b3SnapW_Bytes(buf, &world.contactDampingRatio, cast(i32, sizeof(f32)));
    b3SnapW_Bytes(buf, &world.contactRecycleDistance, cast(i32, sizeof(f32)));
    b3SnapW_Bytes(buf, &world.stepIndex, cast(i32, sizeof(u64)));
    b3SnapW_I32(buf, world.splitIslandId);
    b3SnapW_Bytes(buf, &world.inv_h, cast(i32, sizeof(f32)));
    b3SnapW_Bytes(buf, &world.inv_dt, cast(i32, sizeof(f32)));
    b3SnapW_I32(buf, world.endEventArrayIndex);
    b3SnapW_Bytes(buf, &world.maxCapacity, cast(i32, sizeof(b3Capacity)));
    u8 flags = 0;
    flags |= cast(u8, world.enableSleep != 0 ? 0x01 : 0);
    flags |= cast(u8, world.enableWarmStarting != 0 ? 0x02 : 0);
    flags |= cast(u8, world.enableContinuous != 0 ? 0x04 : 0);
    flags |= cast(u8, world.enableSpeculative != 0 ? 0x08 : 0);
    b3RecBufAppend(buf, &flags, 1);
}

void b3DesWorldConfig(b3SnapReader* r, b3World* world) {
    b3SnapR_Bytes(r, &world.gravity, cast(i32, sizeof(b3Vec3)));
    b3SnapR_Bytes(r, &world.hitEventThreshold, cast(i32, sizeof(f32)));
    b3SnapR_Bytes(r, &world.restitutionThreshold, cast(i32, sizeof(f32)));
    b3SnapR_Bytes(r, &world.maxLinearSpeed, cast(i32, sizeof(f32)));
    b3SnapR_Bytes(r, &world.contactSpeed, cast(i32, sizeof(f32)));
    b3SnapR_Bytes(r, &world.contactHertz, cast(i32, sizeof(f32)));
    b3SnapR_Bytes(r, &world.contactDampingRatio, cast(i32, sizeof(f32)));
    b3SnapR_Bytes(r, &world.contactRecycleDistance, cast(i32, sizeof(f32)));
    b3SnapR_Bytes(r, &world.stepIndex, cast(i32, sizeof(u64)));
    world.splitIslandId = b3SnapR_I32(r);
    b3SnapR_Bytes(r, &world.inv_h, cast(i32, sizeof(f32)));
    b3SnapR_Bytes(r, &world.inv_dt, cast(i32, sizeof(f32)));
    world.endEventArrayIndex = b3SnapR_I32(r);
    b3SnapR_Bytes(r, &world.maxCapacity, cast(i32, sizeof(b3Capacity)));
    u8 flags = 0;
    b3SnapR_Bytes(r, &flags, 1);
    world.enableSleep = (flags & 0x01) != 0;
    world.enableWarmStarting = (flags & 0x02) != 0;
    world.enableContinuous = (flags & 0x04) != 0;
    world.enableSpeculative = (flags & 0x08) != 0;
}

// Shapes carry pointer fields: materials, userData, userShape, and the geometry union.
// Serialize the POD scalars with pointers nulled, then the owned materials array, then geometry.
// A single material lives inline in the struct image.
// Hull/mesh/heightField/compound are interned into the recording registry; sphere/capsule inline.
void b3SerShapes(b3RecBuffer* buf, b3World* world, b3Recording* rec) {
    i32 count = world.shapes.count;
    b3SnapW_I32(buf, count);
    for i32 i = 0; i < count; ++i {
        b3Shape shape = world.shapes.data[i];
        bool isLive = shape.id == i;
        shape.materials = null;
        shape.userData = null;
        shape.userShape = null;
        if isLive == 0 {
            memset(&shape.capsule, 0, cast(u64, sizeof(shape.capsule)));
        }
        b3SnapW_Bytes(buf, &shape, cast(i32, sizeof(b3Shape)));
        if isLive == 0 {
            b3SnapW_I32(buf, 0);
            b3SnapW_I32(buf, -1);
            continue;
        }
        b3Shape* src = world.shapes.data + i;
        if src.materials != null {
            b3SnapW_I32(buf, src.materialCount);
            b3SnapW_Bytes(buf, src.materials, src.materialCount * cast(i32, sizeof(b3SurfaceMaterial)));
        } else {
            b3SnapW_I32(buf, 0);
        }
        switch src.type {
            case b3_sphereShape: {
                b3SnapW_I32(buf, b3_sphereShape);
                b3SnapW_Bytes(buf, &src.sphere, cast(i32, sizeof(b3Sphere)));
            }
            case b3_capsuleShape: {
                b3SnapW_I32(buf, b3_capsuleShape);
                b3SnapW_Bytes(buf, &src.capsule, cast(i32, sizeof(b3Capsule)));
            }
            case b3_hullShape: {
                {
                    b3SnapW_I32(buf, b3_hullShape);
                    u32 gid = b3RecInternHull(rec, src.hull);
                    b3SnapW_U32(buf, gid);
                    break case;
                }
            }
            case b3_meshShape: {
                {
                    b3SnapW_I32(buf, b3_meshShape);
                    u32 gid = b3RecInternMesh(rec, src.mesh.data);
                    b3SnapW_U32(buf, gid);
                    b3SnapW_Bytes(buf, &src.mesh.scale, cast(i32, sizeof(b3Vec3)));
                    break case;
                }
            }
            case b3_heightShape: {
                {
                    b3SnapW_I32(buf, b3_heightShape);
                    u32 gid = b3RecInternHeightField(rec, src.heightField);
                    b3SnapW_U32(buf, gid);
                    break case;
                }
            }
            case b3_compoundShape: {
                {
                    b3SnapW_I32(buf, b3_compoundShape);
                    u32 gid = b3RecInternCompound(rec, src.compound);
                    b3SnapW_U32(buf, gid);
                    break case;
                }
            }
            default: {
                b3SnapW_I32(buf, -1);
            }
        }
    }
}

void b3DesShapes(b3SnapReader* r, b3World* world, b3RecReader* rdr) {
    i32 count = b3SnapR_I32(r);
    if r.ok && b3SnapCheckCount(r, count, cast(i32, sizeof(b3Shape)), cast(i32, sizeof(b3Shape))) == false {
        r.ok = false;
    }
    if r.ok == 0 {
        return;
    }
    i32 oldShapeCount = world.shapes.count;
    void** savedUserShape = null;
    u16* savedGeneration = null;
    if oldShapeCount > 0 {
        savedUserShape = cast(void**, b3Alloc(cast(u64, oldShapeCount) * cast(u64, sizeof(void*))));
        savedGeneration = cast(u16*, b3Alloc(cast(u64, oldShapeCount) * cast(u64, sizeof(u16))));
        for i32 i = 0; i < oldShapeCount; ++i {
            b3Shape* old = world.shapes.data + i;
            bool oldLive = old.id == i;
            savedUserShape[i] = oldLive != 0 ? old.userShape : null;
            savedGeneration[i] = old.generation;
        }
    }
    while true {
        while true {
            if world.shapes.capacity < count {
                var oldSize = cast(i32, world.shapes.capacity * sizeof(*world.shapes.data));
                var newSize = cast(i32, count * sizeof(*world.shapes.data));
                world.shapes.data = b3GrowAlloc(world.shapes.data, oldSize, newSize);
                world.shapes.capacity = count;
            }
            if !(0 != 0) { break; }
        }
        world.shapes.count = count;
        if !(0 != 0) { break; }
    }
    memset(world.shapes.data, 0, cast(u64, count) * cast(u64, sizeof(b3Shape)));
    for i32 i = 0; i < count && r.ok; ++i {
        b3Shape* dst = world.shapes.data + i;
        b3SnapR_Bytes(r, dst, cast(i32, sizeof(b3Shape)));
        dst.materials = null;
        dst.userData = null;
        dst.userShape = null;
        memset(&dst.capsule, 0, cast(u64, sizeof(dst.capsule)));
        bool isLive = dst.id == i;
        if isLive && i < oldShapeCount && savedUserShape != null && savedUserShape[i] != null && savedGeneration[i] == dst.generation {
            dst.userShape = savedUserShape[i];
            savedUserShape[i] = null;
        }
        i32 matCount = b3SnapR_I32(r);
        if r.ok == 0 {
            break;
        }
        if isLive == 0 {
            ignore matCount;
            b3SnapR_I32(r);
            continue;
        }
        if matCount > 0 {
            if b3SnapCheckCount(r, matCount, cast(i32, sizeof(b3SurfaceMaterial)), cast(i32, sizeof(b3SurfaceMaterial))) == false {
                r.ok = false;
                break;
            }
            dst.materialCount = matCount;
            dst.materials = cast(b3SurfaceMaterial*, b3Alloc(cast(u64, matCount) * cast(u64, sizeof(b3SurfaceMaterial))));
            b3SnapR_Bytes(r, dst.materials, matCount * cast(i32, sizeof(b3SurfaceMaterial)));
        } else {
            dst.materials = null;
        }
        i32 geoKind = b3SnapR_I32(r);
        switch cast(b3ShapeType, geoKind) {
            case b3_sphereShape: {
                b3SnapR_Bytes(r, &dst.sphere, cast(i32, sizeof(b3Sphere)));
            }
            case b3_capsuleShape: {
                b3SnapR_Bytes(r, &dst.capsule, cast(i32, sizeof(b3Capsule)));
            }
            case b3_hullShape: {
                {
                    u32 gid = b3SnapR_U32(r);
                    if r.ok == 0 {
                        break case;
                    }
                    if rdr == null || gid >= cast(u32, rdr.slotCount) {
                        r.ok = false;
                        break case;
                    }
                    b3RegistrySlot* slot = rdr.slots + gid;
                    dst.hull = b3AddHullToDatabase(world, cast(b3HullData*, slot.bytes));
                    break case;
                }
            }
            case b3_meshShape: {
                {
                    u32 gid = b3SnapR_U32(r);
                    noinit b3Vec3 scale;
                    b3SnapR_Bytes(r, &scale, cast(i32, sizeof(b3Vec3)));
                    if r.ok == 0 {
                        break case;
                    }
                    if rdr == null || gid >= cast(u32, rdr.slotCount) {
                        r.ok = false;
                        break case;
                    }
                    b3RegistrySlot* slot = rdr.slots + gid;
                    dst.mesh.data = cast(b3MeshData*, slot.bytes);
                    dst.mesh.scale = scale;
                    break case;
                }
            }
            case b3_heightShape: {
                {
                    u32 gid = b3SnapR_U32(r);
                    if r.ok == 0 {
                        break case;
                    }
                    if rdr == null || gid >= cast(u32, rdr.slotCount) {
                        r.ok = false;
                        break case;
                    }
                    b3RegistrySlot* slot = rdr.slots + gid;
                    dst.heightField = cast(b3HeightFieldData*, slot.bytes);
                    break case;
                }
            }
            case b3_compoundShape: {
                {
                    u32 gid = b3SnapR_U32(r);
                    if r.ok == 0 {
                        break case;
                    }
                    if rdr == null || gid >= cast(u32, rdr.slotCount) {
                        r.ok = false;
                        break case;
                    }
                    b3RegistrySlot* slot = rdr.slots + gid;
                    if slot.live == null {
                        slot.live = b3Alloc(cast(u64, slot.byteCount));
                        memcpy(slot.live, slot.bytes, cast(u64, slot.byteCount));
                        b3ConvertBytesToCompound(cast(u8*, slot.live), slot.byteCount);
                    }
                    dst.compound = cast(b3CompoundData*, slot.live);
                    break case;
                }
            }
            default: {
                r.ok = false;
            }
        }
    }
    if savedUserShape != null {
        for i32 i = 0; i < oldShapeCount; ++i {
            if savedUserShape[i] != null && world.destroyDebugShape != null {
                world.destroyDebugShape(savedUserShape[i], world.userDebugShapeContext);
            }
        }
        b3Free(savedUserShape, cast(u64, oldShapeCount) * cast(u64, sizeof(void*)));
        b3Free(savedGeneration, cast(u64, oldShapeCount) * cast(u64, sizeof(u16)));
    }
}

// Contact serialization. b3Contact is not fully POD:
// - manifolds: heap array of b3Manifold, allocated via b3AllocateManifolds
// - meshContact.triangleCache: heap b3Array, active when b3_simMeshContact flag is set
// Serialize: raw struct (with nulled manifolds/triangleCache), then manifolds, then triangleCache.
void b3SerContacts(b3RecBuffer* buf, b3World* world) {
    i32 count = world.contacts.count;
    b3SnapW_I32(buf, count);
    for i32 i = 0; i < count; ++i {
        b3Contact* c = world.contacts.data + i;
        bool isLive = c.contactId == i;
        b3Contact copy = *c;
        copy.manifolds = null;
        copy.bodySimIndexA = -1;
        copy.bodySimIndexB = -1;
        if (copy.flags & cast(u32, b3_simMeshContact)) != 0 {
            copy.meshContact.triangleCache.data = null;
            copy.meshContact.triangleCache.count = 0;
            copy.meshContact.triangleCache.capacity = 0;
        }
        b3SnapW_Bytes(buf, &copy, cast(i32, sizeof(b3Contact)));
        if isLive == 0 {
            b3SnapW_I32(buf, 0);
            continue;
        }
        b3SnapW_I32(buf, c.manifoldCount);
        if c.manifoldCount > 0 && c.manifolds != null {
            b3SnapW_Bytes(buf, c.manifolds, c.manifoldCount * cast(i32, sizeof(b3Manifold)));
        }
        if (c.flags & cast(u32, b3_simMeshContact)) != 0 {
            b3SnapW_I32(buf, c.meshContact.triangleCache.count);
            if c.meshContact.triangleCache.count > 0 {
                b3SnapW_Bytes(buf, c.meshContact.triangleCache.data, c.meshContact.triangleCache.count * cast(i32, sizeof(b3TriangleCache)));
            }
        }
    }
}

void b3DesContacts(b3SnapReader* r, b3World* world) {
    i32 count = b3SnapR_I32(r);
    if r.ok && b3SnapCheckCount(r, count, cast(i32, sizeof(b3Contact)), cast(i32, sizeof(b3Contact))) == false {
        r.ok = false;
    }
    if r.ok == 0 {
        return;
    }
    while true {
        while true {
            if world.contacts.capacity < count {
                var oldSize = cast(i32, world.contacts.capacity * sizeof(*world.contacts.data));
                var newSize = cast(i32, count * sizeof(*world.contacts.data));
                world.contacts.data = b3GrowAlloc(world.contacts.data, oldSize, newSize);
                world.contacts.capacity = count;
            }
            if !(0 != 0) { break; }
        }
        world.contacts.count = count;
        if !(0 != 0) { break; }
    }
    memset(world.contacts.data, 0, cast(u64, count) * cast(u64, sizeof(b3Contact)));
    for i32 i = 0; i < count && r.ok; ++i {
        b3Contact* dst = world.contacts.data + i;
        b3SnapR_Bytes(r, dst, cast(i32, sizeof(b3Contact)));
        dst.manifolds = null;
        dst.bodySimIndexA = -1;
        dst.bodySimIndexB = -1;
        if (dst.flags & cast(u32, b3_simMeshContact)) != 0 {
            dst.meshContact.triangleCache.data = null;
            dst.meshContact.triangleCache.count = 0;
            dst.meshContact.triangleCache.capacity = 0;
        }
        bool isLive = dst.contactId == i;
        i32 manifoldCount = b3SnapR_I32(r);
        if r.ok == 0 {
            break;
        }
        if isLive && manifoldCount > 0 {
            if b3SnapCheckCount(r, manifoldCount, cast(i32, sizeof(b3Manifold)), cast(i32, sizeof(b3Manifold))) == false {
                r.ok = false;
                break;
            }
            dst.manifolds = b3AllocateManifolds(world, manifoldCount);
            dst.manifoldCount = manifoldCount;
            b3SnapR_Bytes(r, dst.manifolds, manifoldCount * cast(i32, sizeof(b3Manifold)));
        } else {
            dst.manifolds = null;
            dst.manifoldCount = 0;
        }
        if isLive && dst.flags & cast(u32, b3_simMeshContact) {
            i32 cacheCount = b3SnapR_I32(r);
            if r.ok == 0 {
                break;
            }
            if cacheCount > 0 {
                if b3SnapCheckCount(r, cacheCount, cast(i32, sizeof(b3TriangleCache)), cast(i32, sizeof(b3TriangleCache))) == false {
                    r.ok = false;
                    break;
                }
                while true {
                    while true {
                        if dst.meshContact.triangleCache.capacity < cacheCount {
                            var oldSize = cast(i32, dst.meshContact.triangleCache.capacity * sizeof(*dst.meshContact.triangleCache.data));
                            var newSize = cast(i32, cacheCount * sizeof(*dst.meshContact.triangleCache.data));
                            dst.meshContact.triangleCache.data = b3GrowAlloc(dst.meshContact.triangleCache.data, oldSize, newSize);
                            dst.meshContact.triangleCache.capacity = cacheCount;
                        }
                        if !(0 != 0) { break; }
                    }
                    dst.meshContact.triangleCache.count = cacheCount;
                    if !(0 != 0) { break; }
                }
                b3SnapR_Bytes(r, dst.meshContact.triangleCache.data, cacheCount * cast(i32, sizeof(b3TriangleCache)));
            }
        }
    }
}

// Free per-object heap that b3DeserializeIntoShell will overwrite,
// so restoring over a populated world doesn't leak.
void b3FreeLiveSimElements(b3World* world) {
    for i32 i = 0; i < world.shapes.count; ++i {
        b3Shape* s = world.shapes.data + i;
        if s.id != i {
            continue;
        }
        if s.materials != null {
            b3Free(s.materials, cast(u64, s.materialCount) * cast(u64, sizeof(b3SurfaceMaterial)));
            s.materials = null;
            s.materialCount = 0;
        }
        if s.type == b3_hullShape && s.hull != null {
            b3RemoveHullFromDatabase(world, s.hull);
            s.hull = null;
        }
    }
    for i32 i = 0; i < world.contacts.count; ++i {
        b3Contact* c = world.contacts.data + i;
        if c.contactId == i {
            if c.manifolds != null {
                b3FreeManifolds(world, c.manifolds, c.manifoldCount);
                c.manifolds = null;
                c.manifoldCount = 0;
            }
            if (c.flags & cast(u32, b3_simMeshContact)) != 0 {
                while true {
                    b3Free(c.meshContact.triangleCache.data, cast(u64, c.meshContact.triangleCache.capacity * sizeof(*c.meshContact.triangleCache.data)));
                    c.meshContact.triangleCache.data = null;
                    c.meshContact.triangleCache.count = 0;
                    c.meshContact.triangleCache.capacity = 0;
                    if !(0 != 0) { break; }
                }
            }
        }
    }
    for i32 i = 0; i < world.sensors.count; ++i {
        b3Sensor* sensor = world.sensors.data + i;
        while true {
            b3Free(sensor.hits.data, cast(u64, sensor.hits.capacity * sizeof(*sensor.hits.data)));
            sensor.hits.data = null;
            sensor.hits.count = 0;
            sensor.hits.capacity = 0;
            if !(0 != 0) { break; }
        }
        while true {
            b3Free(sensor.overlaps1.data, cast(u64, sensor.overlaps1.capacity * sizeof(*sensor.overlaps1.data)));
            sensor.overlaps1.data = null;
            sensor.overlaps1.count = 0;
            sensor.overlaps1.capacity = 0;
            if !(0 != 0) { break; }
        }
        while true {
            b3Free(sensor.overlaps2.data, cast(u64, sensor.overlaps2.capacity * sizeof(*sensor.overlaps2.data)));
            sensor.overlaps2.data = null;
            sensor.overlaps2.count = 0;
            sensor.overlaps2.capacity = 0;
            if !(0 != 0) { break; }
        }
    }
    for i32 i = 0; i < world.islands.count; ++i {
        b3Island* island = world.islands.data + i;
        while true {
            b3Free(island.bodies.data, cast(u64, island.bodies.capacity * sizeof(*island.bodies.data)));
            island.bodies.data = null;
            island.bodies.count = 0;
            island.bodies.capacity = 0;
            if !(0 != 0) { break; }
        }
        while true {
            b3Free(island.contacts.data, cast(u64, island.contacts.capacity * sizeof(*island.contacts.data)));
            island.contacts.data = null;
            island.contacts.count = 0;
            island.contacts.capacity = 0;
            if !(0 != 0) { break; }
        }
        while true {
            b3Free(island.joints.data, cast(u64, island.joints.capacity * sizeof(*island.joints.data)));
            island.joints.data = null;
            island.joints.count = 0;
            island.joints.capacity = 0;
            if !(0 != 0) { break; }
        }
    }
}
}

i32 b3SerializeWorld(b3World* world, b3RecBuffer* buf, b3Recording* rec) {
    i32 startSize = buf.size;
    noinit b3SnapHeader hdr;
    hdr.magic = 0x33534E42;
    hdr.version = 2;
    hdr.layoutHash = b3ComputeLayoutHash();
    hdr.flags = cast(u32, 0 != 0 ? 0x1 : 0);
    b3SnapW_Bytes(buf, &hdr, cast(i32, sizeof(hdr)));
    b3SerWorldConfig(buf, world);
    b3SerIdPool(buf, &world.bodyIdPool);
    b3SerIdPool(buf, &world.shapeIdPool);
    b3SerIdPool(buf, &world.contactIdPool);
    b3SerIdPool(buf, &world.jointIdPool);
    b3SerIdPool(buf, &world.islandIdPool);
    b3SerIdPool(buf, &world.solverSetIdPool);
    i32 setCount = world.solverSets.count;
    b3SnapW_I32(buf, setCount);
    for i32 i = 0; i < setCount; ++i {
        b3SerSolverSet(buf, world.solverSets.data + i);
    }
    {
        i32 bodyCount = world.bodies.count;
        b3SnapW_I32(buf, bodyCount);
        for i32 i = 0; i < bodyCount; ++i {
            b3Body elem = world.bodies.data[i];
            elem.userData = null;
            b3SnapW_Bytes(buf, &elem, cast(i32, sizeof(b3Body)));
        }
    }
    b3SerShapes(buf, world, rec);
    b3SerContacts(buf, world);
    {
        i32 jointCount = world.joints.count;
        b3SnapW_I32(buf, jointCount);
        for i32 i = 0; i < jointCount; ++i {
            b3Joint elem = world.joints.data[i];
            elem.userData = null;
            b3SnapW_Bytes(buf, &elem, cast(i32, sizeof(b3Joint)));
        }
    }
    {
        i32 sensorCount = world.sensors.count;
        b3SnapW_I32(buf, sensorCount);
        for i32 i = 0; i < sensorCount; ++i {
            b3Sensor* s = world.sensors.data + i;
            b3SnapW_I32(buf, s.shapeId);
            while true {
                b3SnapW_I32(buf, s.hits.count);
                if s.hits.count > 0 {
                    b3SnapW_Bytes(buf, s.hits.data, s.hits.count * cast(i32, sizeof(*s.hits.data)));
                }
                if !(0 != 0) { break; }
            }
            while true {
                b3SnapW_I32(buf, s.overlaps1.count);
                if s.overlaps1.count > 0 {
                    b3SnapW_Bytes(buf, s.overlaps1.data, s.overlaps1.count * cast(i32, sizeof(*s.overlaps1.data)));
                }
                if !(0 != 0) { break; }
            }
            while true {
                b3SnapW_I32(buf, s.overlaps2.count);
                if s.overlaps2.count > 0 {
                    b3SnapW_Bytes(buf, s.overlaps2.data, s.overlaps2.count * cast(i32, sizeof(*s.overlaps2.data)));
                }
                if !(0 != 0) { break; }
            }
        }
    }
    {
        i32 islandCount = world.islands.count;
        b3SnapW_I32(buf, islandCount);
        for i32 i = 0; i < islandCount; ++i {
            b3Island* island = world.islands.data + i;
            b3SnapW_I32(buf, island.setIndex);
            b3SnapW_I32(buf, island.localIndex);
            b3SnapW_I32(buf, island.islandId);
            b3SnapW_I32(buf, island.constraintRemoveCount);
            while true {
                b3SnapW_I32(buf, island.bodies.count);
                if island.bodies.count > 0 {
                    b3SnapW_Bytes(buf, island.bodies.data, island.bodies.count * cast(i32, sizeof(*island.bodies.data)));
                }
                if !(0 != 0) { break; }
            }
            while true {
                b3SnapW_I32(buf, island.contacts.count);
                if island.contacts.count > 0 {
                    b3SnapW_Bytes(buf, island.contacts.data, island.contacts.count * cast(i32, sizeof(*island.contacts.data)));
                }
                if !(0 != 0) { break; }
            }
            while true {
                b3SnapW_I32(buf, island.joints.count);
                if island.joints.count > 0 {
                    b3SnapW_Bytes(buf, island.joints.data, island.joints.count * cast(i32, sizeof(*island.joints.data)));
                }
                if !(0 != 0) { break; }
            }
        }
    }
    b3BroadPhase* bp = &world.broadPhase;
    for i32 t = 0; t < b3_bodyTypeCount; ++t {
        b3SerTree(buf, &bp.trees[t]);
    }
    for i32 t = 0; t < b3_bodyTypeCount; ++t {
        b3SerBitSet(buf, &bp.movedProxies[t]);
    }
    while true {
        b3SnapW_I32(buf, bp.moveArray.count);
        if bp.moveArray.count > 0 {
            b3SnapW_Bytes(buf, bp.moveArray.data, bp.moveArray.count * cast(i32, sizeof(*bp.moveArray.data)));
        }
        if !(0 != 0) { break; }
    }
    b3SerHashSet(buf, &bp.pairSet);
    b3ConstraintGraph* graph = &world.constraintGraph;
    for i32 c = 0; c < 24; ++c {
        b3SerGraphColor(buf, &graph.colors[c], c == 24 - 1);
    }
    b3SerNames(buf, &world.names);
    return buf.size - startSize;
}

bool b3DeserializeIntoShell(u8* data, i32 size, b3World* world, b3RecReader* rdr) {
    if data == null || size < cast(i32, sizeof(b3SnapHeader)) {
        return false;
    }
    noinit b3SnapHeader hdr;
    memcpy(&hdr, data, cast(u64, sizeof(hdr)));
    if hdr.magic != 0x33534E42 || hdr.version != 2 {
        printf("b3DeserializeIntoShell: bad magic/version\n");
        return false;
    }
    bool imageDouble = (hdr.flags & 0x2) != 0;
    bool buildDouble = false;
    if imageDouble != buildDouble {
        printf("b3DeserializeIntoShell: precision mismatch\n");
        return false;
    }
    if hdr.layoutHash != b3ComputeLayoutHash() {
        printf("b3DeserializeIntoShell: layout hash mismatch\n");
        return false;
    }
    noinit b3SnapReader readerStorage;
    b3SnapReader* r = &readerStorage;
    r.data = data;
    r.cursor = cast(i32, sizeof(b3SnapHeader));
    r.size = size;
    r.ok = true;
    b3FreeLiveSimElements(world);
    b3DesWorldConfig(r, world);
    b3DesIdPool(r, &world.bodyIdPool);
    b3DesIdPool(r, &world.shapeIdPool);
    b3DesIdPool(r, &world.contactIdPool);
    b3DesIdPool(r, &world.jointIdPool);
    b3DesIdPool(r, &world.islandIdPool);
    b3DesIdPool(r, &world.solverSetIdPool);
    for i32 i = 0; i < world.solverSets.count; ++i {
        b3SolverSet* set = world.solverSets.data + i;
        while true {
            b3Free(set.bodySims.data, cast(u64, set.bodySims.capacity * sizeof(*set.bodySims.data)));
            set.bodySims.data = null;
            set.bodySims.count = 0;
            set.bodySims.capacity = 0;
            if !(0 != 0) { break; }
        }
        while true {
            b3Free(set.bodyStates.data, cast(u64, set.bodyStates.capacity * sizeof(*set.bodyStates.data)));
            set.bodyStates.data = null;
            set.bodyStates.count = 0;
            set.bodyStates.capacity = 0;
            if !(0 != 0) { break; }
        }
        while true {
            b3Free(set.jointSims.data, cast(u64, set.jointSims.capacity * sizeof(*set.jointSims.data)));
            set.jointSims.data = null;
            set.jointSims.count = 0;
            set.jointSims.capacity = 0;
            if !(0 != 0) { break; }
        }
        while true {
            b3Free(set.contactIndices.data, cast(u64, set.contactIndices.capacity * sizeof(*set.contactIndices.data)));
            set.contactIndices.data = null;
            set.contactIndices.count = 0;
            set.contactIndices.capacity = 0;
            if !(0 != 0) { break; }
        }
        while true {
            b3Free(set.islandSims.data, cast(u64, set.islandSims.capacity * sizeof(*set.islandSims.data)));
            set.islandSims.data = null;
            set.islandSims.count = 0;
            set.islandSims.capacity = 0;
            if !(0 != 0) { break; }
        }
    }
    i32 setCount = b3SnapR_I32(r);
    if r.ok && b3SnapCheckCount(r, setCount, cast(i32, sizeof(b3SolverSet)), 6 * cast(i32, sizeof(i32))) == false {
        r.ok = false;
    }
    if r.ok != 0 {
        while true {
            while true {
                if world.solverSets.capacity < setCount {
                    var oldSize = cast(i32, world.solverSets.capacity * sizeof(*world.solverSets.data));
                    var newSize = cast(i32, setCount * sizeof(*world.solverSets.data));
                    world.solverSets.data = b3GrowAlloc(world.solverSets.data, oldSize, newSize);
                    world.solverSets.capacity = setCount;
                }
                if !(0 != 0) { break; }
            }
            world.solverSets.count = setCount;
            if !(0 != 0) { break; }
        }
        memset(world.solverSets.data, 0, cast(u64, setCount) * cast(u64, sizeof(b3SolverSet)));
        for i32 i = 0; i < setCount; ++i {
            b3DesSolverSet(r, world.solverSets.data + i);
        }
    }
    if r.ok == 0 {
        return false;
    }
    {
        i32 bodyCount = b3SnapR_I32(r);
        if r.ok && b3SnapCheckCount(r, bodyCount, cast(i32, sizeof(b3Body)), cast(i32, sizeof(b3Body))) == false {
            r.ok = false;
        }
        if r.ok != 0 {
            while true {
                while true {
                    if world.bodies.capacity < bodyCount {
                        var oldSize = cast(i32, world.bodies.capacity * sizeof(*world.bodies.data));
                        var newSize = cast(i32, bodyCount * sizeof(*world.bodies.data));
                        world.bodies.data = b3GrowAlloc(world.bodies.data, oldSize, newSize);
                        world.bodies.capacity = bodyCount;
                    }
                    if !(0 != 0) { break; }
                }
                world.bodies.count = bodyCount;
                if !(0 != 0) { break; }
            }
            for i32 i = 0; i < bodyCount; ++i {
                b3SnapR_Bytes(r, world.bodies.data + i, cast(i32, sizeof(b3Body)));
                world.bodies.data[i].userData = null;
            }
        }
    }
    if r.ok == 0 {
        return false;
    }
    b3DesShapes(r, world, rdr);
    if r.ok == 0 {
        return false;
    }
    b3DesContacts(r, world);
    if r.ok == 0 {
        return false;
    }
    {
        i32 jointCount = b3SnapR_I32(r);
        if r.ok && b3SnapCheckCount(r, jointCount, cast(i32, sizeof(b3Joint)), cast(i32, sizeof(b3Joint))) == false {
            r.ok = false;
        }
        if r.ok != 0 {
            while true {
                while true {
                    if world.joints.capacity < jointCount {
                        var oldSize = cast(i32, world.joints.capacity * sizeof(*world.joints.data));
                        var newSize = cast(i32, jointCount * sizeof(*world.joints.data));
                        world.joints.data = b3GrowAlloc(world.joints.data, oldSize, newSize);
                        world.joints.capacity = jointCount;
                    }
                    if !(0 != 0) { break; }
                }
                world.joints.count = jointCount;
                if !(0 != 0) { break; }
            }
            for i32 i = 0; i < jointCount; ++i {
                b3SnapR_Bytes(r, world.joints.data + i, cast(i32, sizeof(b3Joint)));
                world.joints.data[i].userData = null;
            }
        }
    }
    {
        while true {
            b3Free(world.sensors.data, cast(u64, world.sensors.capacity * sizeof(*world.sensors.data)));
            world.sensors.data = null;
            world.sensors.count = 0;
            world.sensors.capacity = 0;
            if !(0 != 0) { break; }
        }
        while true {
            world.sensors.data = null;
            world.sensors.count = 0;
            world.sensors.capacity = 0;
            if !(0 != 0) { break; }
        }
        i32 sensorCount = b3SnapR_I32(r);
        if r.ok && b3SnapCheckCount(r, sensorCount, cast(i32, sizeof(b3Sensor)), 4 * cast(i32, sizeof(i32))) == false {
            r.ok = false;
        }
        if r.ok != 0 {
            while true {
                while true {
                    if world.sensors.capacity < sensorCount {
                        var oldSize = cast(i32, world.sensors.capacity * sizeof(*world.sensors.data));
                        var newSize = cast(i32, sensorCount * sizeof(*world.sensors.data));
                        world.sensors.data = b3GrowAlloc(world.sensors.data, oldSize, newSize);
                        world.sensors.capacity = sensorCount;
                    }
                    if !(0 != 0) { break; }
                }
                world.sensors.count = sensorCount;
                if !(0 != 0) { break; }
            }
            memset(world.sensors.data, 0, cast(u64, sensorCount) * cast(u64, sizeof(b3Sensor)));
        }
        for i32 i = 0; i < sensorCount && r.ok; ++i {
            b3Sensor* s = world.sensors.data + i;
            s.shapeId = b3SnapR_I32(r);
            while true {
                s.hits.data = null;
                s.hits.count = 0;
                s.hits.capacity = 0;
                if !(0 != 0) { break; }
            }
            while true {
                s.overlaps1.data = null;
                s.overlaps1.count = 0;
                s.overlaps1.capacity = 0;
                if !(0 != 0) { break; }
            }
            while true {
                s.overlaps2.data = null;
                s.overlaps2.count = 0;
                s.overlaps2.capacity = 0;
                if !(0 != 0) { break; }
            }
            while true {
                i32 cnt = b3SnapR_I32(r);
                var elemSize = cast(i32, sizeof(*s.hits.data));
                if r.ok && b3SnapCheckCount(r, cnt, elemSize, elemSize) == false {
                    r.ok = false;
                }
                if r.ok && cnt > 0 {
                    while true {
                        while true {
                            if s.hits.capacity < cnt {
                                var oldSize = cast(i32, s.hits.capacity * sizeof(*s.hits.data));
                                var newSize = cast(i32, cnt * sizeof(*s.hits.data));
                                s.hits.data = b3GrowAlloc(s.hits.data, oldSize, newSize);
                                s.hits.capacity = cnt;
                            }
                            if !(0 != 0) { break; }
                        }
                        s.hits.count = cnt;
                        if !(0 != 0) { break; }
                    }
                    b3SnapR_Bytes(r, s.hits.data, cnt * elemSize);
                } else if r.ok != 0 {
                    s.hits.count = 0;
                }
                if !(0 != 0) { break; }
            }
            while true {
                i32 cnt = b3SnapR_I32(r);
                var elemSize = cast(i32, sizeof(*s.overlaps1.data));
                if r.ok && b3SnapCheckCount(r, cnt, elemSize, elemSize) == false {
                    r.ok = false;
                }
                if r.ok && cnt > 0 {
                    while true {
                        while true {
                            if s.overlaps1.capacity < cnt {
                                var oldSize = cast(i32, s.overlaps1.capacity * sizeof(*s.overlaps1.data));
                                var newSize = cast(i32, cnt * sizeof(*s.overlaps1.data));
                                s.overlaps1.data = b3GrowAlloc(s.overlaps1.data, oldSize, newSize);
                                s.overlaps1.capacity = cnt;
                            }
                            if !(0 != 0) { break; }
                        }
                        s.overlaps1.count = cnt;
                        if !(0 != 0) { break; }
                    }
                    b3SnapR_Bytes(r, s.overlaps1.data, cnt * elemSize);
                } else if r.ok != 0 {
                    s.overlaps1.count = 0;
                }
                if !(0 != 0) { break; }
            }
            while true {
                i32 cnt = b3SnapR_I32(r);
                var elemSize = cast(i32, sizeof(*s.overlaps2.data));
                if r.ok && b3SnapCheckCount(r, cnt, elemSize, elemSize) == false {
                    r.ok = false;
                }
                if r.ok && cnt > 0 {
                    while true {
                        while true {
                            if s.overlaps2.capacity < cnt {
                                var oldSize = cast(i32, s.overlaps2.capacity * sizeof(*s.overlaps2.data));
                                var newSize = cast(i32, cnt * sizeof(*s.overlaps2.data));
                                s.overlaps2.data = b3GrowAlloc(s.overlaps2.data, oldSize, newSize);
                                s.overlaps2.capacity = cnt;
                            }
                            if !(0 != 0) { break; }
                        }
                        s.overlaps2.count = cnt;
                        if !(0 != 0) { break; }
                    }
                    b3SnapR_Bytes(r, s.overlaps2.data, cnt * elemSize);
                } else if r.ok != 0 {
                    s.overlaps2.count = 0;
                }
                if !(0 != 0) { break; }
            }
        }
    }
    {
        while true {
            b3Free(world.islands.data, cast(u64, world.islands.capacity * sizeof(*world.islands.data)));
            world.islands.data = null;
            world.islands.count = 0;
            world.islands.capacity = 0;
            if !(0 != 0) { break; }
        }
        while true {
            world.islands.data = null;
            world.islands.count = 0;
            world.islands.capacity = 0;
            if !(0 != 0) { break; }
        }
        i32 islandCount = b3SnapR_I32(r);
        if r.ok && b3SnapCheckCount(r, islandCount, cast(i32, sizeof(b3Island)), 7 * cast(i32, sizeof(i32))) == false {
            r.ok = false;
        }
        if r.ok != 0 {
            while true {
                while true {
                    if world.islands.capacity < islandCount {
                        var oldSize = cast(i32, world.islands.capacity * sizeof(*world.islands.data));
                        var newSize = cast(i32, islandCount * sizeof(*world.islands.data));
                        world.islands.data = b3GrowAlloc(world.islands.data, oldSize, newSize);
                        world.islands.capacity = islandCount;
                    }
                    if !(0 != 0) { break; }
                }
                world.islands.count = islandCount;
                if !(0 != 0) { break; }
            }
            memset(world.islands.data, 0, cast(u64, islandCount) * cast(u64, sizeof(b3Island)));
        }
        for i32 i = 0; i < islandCount && r.ok; ++i {
            b3Island* island = world.islands.data + i;
            island.setIndex = b3SnapR_I32(r);
            island.localIndex = b3SnapR_I32(r);
            island.islandId = b3SnapR_I32(r);
            island.constraintRemoveCount = b3SnapR_I32(r);
            while true {
                island.bodies.data = null;
                island.bodies.count = 0;
                island.bodies.capacity = 0;
                if !(0 != 0) { break; }
            }
            while true {
                island.contacts.data = null;
                island.contacts.count = 0;
                island.contacts.capacity = 0;
                if !(0 != 0) { break; }
            }
            while true {
                island.joints.data = null;
                island.joints.count = 0;
                island.joints.capacity = 0;
                if !(0 != 0) { break; }
            }
            while true {
                i32 cnt = b3SnapR_I32(r);
                var elemSize = cast(i32, sizeof(*island.bodies.data));
                if r.ok && b3SnapCheckCount(r, cnt, elemSize, elemSize) == false {
                    r.ok = false;
                }
                if r.ok && cnt > 0 {
                    while true {
                        while true {
                            if island.bodies.capacity < cnt {
                                var oldSize = cast(i32, island.bodies.capacity * sizeof(*island.bodies.data));
                                var newSize = cast(i32, cnt * sizeof(*island.bodies.data));
                                island.bodies.data = b3GrowAlloc(island.bodies.data, oldSize, newSize);
                                island.bodies.capacity = cnt;
                            }
                            if !(0 != 0) { break; }
                        }
                        island.bodies.count = cnt;
                        if !(0 != 0) { break; }
                    }
                    b3SnapR_Bytes(r, island.bodies.data, cnt * elemSize);
                } else if r.ok != 0 {
                    island.bodies.count = 0;
                }
                if !(0 != 0) { break; }
            }
            while true {
                i32 cnt = b3SnapR_I32(r);
                var elemSize = cast(i32, sizeof(*island.contacts.data));
                if r.ok && b3SnapCheckCount(r, cnt, elemSize, elemSize) == false {
                    r.ok = false;
                }
                if r.ok && cnt > 0 {
                    while true {
                        while true {
                            if island.contacts.capacity < cnt {
                                var oldSize = cast(i32, island.contacts.capacity * sizeof(*island.contacts.data));
                                var newSize = cast(i32, cnt * sizeof(*island.contacts.data));
                                island.contacts.data = b3GrowAlloc(island.contacts.data, oldSize, newSize);
                                island.contacts.capacity = cnt;
                            }
                            if !(0 != 0) { break; }
                        }
                        island.contacts.count = cnt;
                        if !(0 != 0) { break; }
                    }
                    b3SnapR_Bytes(r, island.contacts.data, cnt * elemSize);
                } else if r.ok != 0 {
                    island.contacts.count = 0;
                }
                if !(0 != 0) { break; }
            }
            while true {
                i32 cnt = b3SnapR_I32(r);
                var elemSize = cast(i32, sizeof(*island.joints.data));
                if r.ok && b3SnapCheckCount(r, cnt, elemSize, elemSize) == false {
                    r.ok = false;
                }
                if r.ok && cnt > 0 {
                    while true {
                        while true {
                            if island.joints.capacity < cnt {
                                var oldSize = cast(i32, island.joints.capacity * sizeof(*island.joints.data));
                                var newSize = cast(i32, cnt * sizeof(*island.joints.data));
                                island.joints.data = b3GrowAlloc(island.joints.data, oldSize, newSize);
                                island.joints.capacity = cnt;
                            }
                            if !(0 != 0) { break; }
                        }
                        island.joints.count = cnt;
                        if !(0 != 0) { break; }
                    }
                    b3SnapR_Bytes(r, island.joints.data, cnt * elemSize);
                } else if r.ok != 0 {
                    island.joints.count = 0;
                }
                if !(0 != 0) { break; }
            }
        }
    }
    {
        b3BroadPhase* bp = &world.broadPhase;
        for i32 t = 0; t < b3_bodyTypeCount; ++t {
            b3DesTree(r, &bp.trees[t]);
        }
        for i32 t = 0; t < b3_bodyTypeCount; ++t {
            b3DesBitSet(r, &bp.movedProxies[t]);
        }
        while true {
            b3Free(bp.moveArray.data, cast(u64, bp.moveArray.capacity * sizeof(*bp.moveArray.data)));
            bp.moveArray.data = null;
            bp.moveArray.count = 0;
            bp.moveArray.capacity = 0;
            if !(0 != 0) { break; }
        }
        while true {
            bp.moveArray.data = null;
            bp.moveArray.count = 0;
            bp.moveArray.capacity = 0;
            if !(0 != 0) { break; }
        }
        while true {
            i32 cnt = b3SnapR_I32(r);
            var elemSize = cast(i32, sizeof(*bp.moveArray.data));
            if r.ok && b3SnapCheckCount(r, cnt, elemSize, elemSize) == false {
                r.ok = false;
            }
            if r.ok && cnt > 0 {
                while true {
                    while true {
                        if bp.moveArray.capacity < cnt {
                            var oldSize = cast(i32, bp.moveArray.capacity * sizeof(*bp.moveArray.data));
                            var newSize = cast(i32, cnt * sizeof(*bp.moveArray.data));
                            bp.moveArray.data = b3GrowAlloc(bp.moveArray.data, oldSize, newSize);
                            bp.moveArray.capacity = cnt;
                        }
                        if !(0 != 0) { break; }
                    }
                    bp.moveArray.count = cnt;
                    if !(0 != 0) { break; }
                }
                b3SnapR_Bytes(r, bp.moveArray.data, cnt * elemSize);
            } else if r.ok != 0 {
                bp.moveArray.count = 0;
            }
            if !(0 != 0) { break; }
        }
        b3DesHashSet(r, &bp.pairSet);
    }
    {
        b3ConstraintGraph* graph = &world.constraintGraph;
        for i32 c = 0; c < 24; ++c {
            b3DesGraphColor(r, &graph.colors[c], c == 24 - 1);
        }
    }
    b3DesNames(r, &world.names);
    return r.ok;
}
private { bool b3RefreshCache__s_once = false; }
