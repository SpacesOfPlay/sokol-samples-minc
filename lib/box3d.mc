}

struct b3SchedulerTask {
    b3TaskCallback callback;
    void* taskContext;
    b3AtomicInt status;
}

struct b3SchedulerWorkerContext {
    b3Scheduler* scheduler;
    i32 threadIndex;
}

struct b3Scheduler {
    b3Thread*[32] threads;
    b3SchedulerWorkerContext[32] workerContexts;
    i32 workerCount;
    i32 threadCount;
    b3SchedulerTask[256] tasks;
    b3AtomicInt nextSlot;
