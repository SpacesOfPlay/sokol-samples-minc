                if rdr.ok != 0 {
                    b3RecDispatch_QueryCastRayClosest(&a, rdr);
                }
                break case;
            }
        }
        case 0xED: {
            {
                b3RecArgs_QueryCastMover a;
                a.world = b3RecR_WORLDID(rdr);
                a.origin = b3RecR_POSITION(rdr);
                a.mover = b3RecR_CAPSULE(rdr);
