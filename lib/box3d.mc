    b3World* world = b3GetUnlockedWorldFromId(worldId);
    if world == null {
        return;
    }
    b3StopRecordingInternal(world);
}

void b3World_DumpMemoryStats(b3WorldId worldId) {
    b3World* world = b3GetUnlockedWorldFromId(worldId);
    if world == null {
        return;
    }
    u64 total = 0;
    i32 bodyIdBytes = b3GetIdBytes(&world.bodyIdPool);
    i32 solverSetIdBytes = b3GetIdBytes(&world.solverSetIdPool);
    i32 jointIdBytes = b3GetIdBytes(&world.jointIdPool);
    i32 contactIdBytes = b3GetIdBytes(&world.contactIdPool);
    i32 islandIdBytes = b3GetIdBytes(&world.islandIdPool);
    i32 shapeIdBytes = b3GetIdBytes(&world.shapeIdPool);
    total += cast(u64, bodyIdBytes) + cast(u64, solverSetIdBytes) + cast(u64, jointIdBytes) + cast(u64, contactIdBytes) + cast(u64, islandIdBytes) + cast(u64, shapeIdBytes);
    b3Log("id pools");
    b3Log("body ids: %d", bodyIdBytes);
    b3Log("solver set ids: %d", solverSetIdBytes);
    b3Log("joint ids: %d", jointIdBytes);
    b3Log("contact ids: %d", contactIdBytes);
    b3Log("island ids: %d", islandIdBytes);
    b3Log("shape ids: %d", shapeIdBytes);
    i32 islandLinkBytes = 0;
    for i32 i = 0; i < world.islands.count; ++i {
        b3Island* island = world.islands.data + i;
        islandLinkBytes += island.bodies.capacity * cast(i32, sizeof(*island.bodies.data));
        islandLinkBytes += island.contacts.capacity * cast(i32, sizeof(*island.contacts.data));
        islandLinkBytes += island.joints.capacity * cast(i32, sizeof(*island.joints.data));
    }
    i32 bodyArrayBytes = world.bodies.capacity * cast(i32, sizeof(*world.bodies.data));
    i32 solverSetArrayBytes = world.solverSets.capacity * cast(i32, sizeof(*world.solverSets.data));
    i32 jointArrayBytes = world.joints.capacity * cast(i32, sizeof(*world.joints.data));
    i32 contactArrayBytes = world.contacts.capacity * cast(i32, sizeof(*world.contacts.data));
    i32 islandArrayBytes = world.islands.capacity * cast(i32, sizeof(*world.islands.data));
    i32 shapeArrayBytes = world.shapes.capacity * cast(i32, sizeof(*world.shapes.data));
    i32 sensorArrayBytes = world.sensors.capacity * cast(i32, sizeof(*world.sensors.data));
    total += cast(u64, bodyArrayBytes) + cast(u64, solverSetArrayBytes) + cast(u64, jointArrayBytes) + cast(u64, contactArrayBytes) + cast(u64, islandArrayBytes) + cast(u64, islandLinkBytes) + cast(u64, shapeArrayBytes) + cast(u64, sensorArrayBytes);
    b3Log("world arrays");
    b3Log("bodies: %d", bodyArrayBytes);
    b3Log("solver sets: %d", solverSetArrayBytes);
    b3Log("joints: %d", jointArrayBytes);
    b3Log("contacts: %d", contactArrayBytes);
    b3Log("islands: %d", islandArrayBytes);
    b3Log("island links: %d", islandLinkBytes);
    b3Log("shapes: %d", shapeArrayBytes);
    b3Log("sensors: %d", sensorArrayBytes);
    i32 sensorOverlapBytes = 0;
    for i32 i = 0; i < world.sensors.count; ++i {
        b3Sensor* sensor = world.sensors.data + i;
        sensorOverlapBytes += sensor.hits.capacity * cast(i32, sizeof(*sensor.hits.data));
        sensorOverlapBytes += sensor.overlaps1.capacity * cast(i32, sizeof(*sensor.overlaps1.data));
        sensorOverlapBytes += sensor.overlaps2.capacity * cast(i32, sizeof(*sensor.overlaps2.data));
    }
    total += cast(u64, sensorOverlapBytes);
    b3Log("owned arrays");
    b3Log("sensor overlaps: %d", sensorOverlapBytes);
    b3HullMap* hullDatabase = world.hullDatabase;
    var hullCount = cast(i32, b3HullMap_size(hullDatabase));
    var hullBucketCount = cast(i32, b3HullMap_bucket_count(hullDatabase));
    u64 hullMapBytes = b3HullMapByteCount(hullDatabase);
    u64 hullDataBytes = 0;
    for b3HullMap_itr itr = b3HullMap_first(hullDatabase); b3HullMap_is_end(itr) == false; itr = b3HullMap_next(itr) {
        hullDataBytes += cast(u64, itr.data.key.byteCount);
    }
    total += hullMapBytes + hullDataBytes;
    b3Log("hulls");
    b3Log("database: %d (%d, %d)", cast(i32, hullMapBytes), hullCount, hullBucketCount);
    b3Log("hull data: %d", cast(i32, hullDataBytes));
    i32 staticTreeBytes = b3DynamicTree_GetByteCount(world.broadPhase.trees + b3_staticBody);
    i32 kinematicTreeBytes = b3DynamicTree_GetByteCount(world.broadPhase.trees + b3_kinematicBody);
    i32 dynamicTreeBytes = b3DynamicTree_GetByteCount(world.broadPhase.trees + b3_dynamicBody);
    i32 movedBytes = 0;
    for i32 i = 0; i < b3_bodyTypeCount; ++i {
        movedBytes += b3GetBitSetBytes(&world.broadPhase.movedProxies[i]);
    }
    i32 moveArrayBytes = world.broadPhase.moveArray.capacity * cast(i32, sizeof(*world.broadPhase.moveArray.data));
    b3HashSet* pairSet = &world.broadPhase.pairSet;
    i32 pairSetBytes = b3GetHashSetBytes(pairSet);
    total += cast(u64, staticTreeBytes) + cast(u64, kinematicTreeBytes) + cast(u64, dynamicTreeBytes) + cast(u64, movedBytes) + cast(u64, moveArrayBytes) + cast(u64, pairSetBytes);
    b3Log("broad-phase");
    b3Log("static tree: %d", staticTreeBytes);
    b3Log("kinematic tree: %d", kinematicTreeBytes);
    b3Log("dynamic tree: %d", dynamicTreeBytes);
    b3Log("movedProxies: %d", movedBytes);
    b3Log("moveArray: %d", moveArrayBytes);
    b3Log("pairSet: %d (%d, %d)", pairSetBytes, pairSet.count, pairSet.capacity);
    i32 manifoldArrayBytes = world.manifoldAllocators.capacity * cast(i32, sizeof(*world.manifoldAllocators.data));
    i32 manifoldBlockBytes = 0;
    for i32 i = 0; i < world.manifoldAllocators.count; ++i {
        b3BlockAllocator* allocator = world.manifoldAllocators.data + i;
        manifoldBlockBytes += allocator.blocks.capacity * cast(i32, sizeof(*allocator.blocks.data));
        manifoldBlockBytes += allocator.blocks.count * (1 << 8) * allocator.elementSize;
    }
    total += cast(u64, manifoldArrayBytes) + cast(u64, manifoldBlockBytes);
    b3Log("manifold allocators");
    b3Log("allocator array: %d", manifoldArrayBytes);
    b3Log("blocks: %d", manifoldBlockBytes);
    i32 bodySimCapacity = 0;
    i32 bodyStateCapacity = 0;
    i32 jointSimCapacity = 0;
    i32 contactIndexCapacity = 0;
    i32 islandSimCapacity = 0;
    i32 solverSetCapacity = world.solverSets.count;
    for i32 i = 0; i < solverSetCapacity; ++i {
        b3SolverSet* set = world.solverSets.data + i;
        if set.setIndex == -1 {
            continue;
        }
        bodySimCapacity += set.bodySims.capacity;
        bodyStateCapacity += set.bodyStates.capacity;
        jointSimCapacity += set.jointSims.capacity;
        contactIndexCapacity += set.contactIndices.capacity;
        islandSimCapacity += set.islandSims.capacity;
    }
    i32 setBodySimBytes = bodySimCapacity * cast(i32, sizeof(b3BodySim));
    i32 setBodyStateBytes = bodyStateCapacity * cast(i32, sizeof(b3BodyState));
    i32 setJointSimBytes = jointSimCapacity * cast(i32, sizeof(b3JointSim));
    i32 setContactSimBytes = contactIndexCapacity * cast(i32, sizeof(i32));
    i32 setIslandSimBytes = islandSimCapacity * cast(i32, sizeof(b3IslandSim));
    total += cast(u64, setBodySimBytes) + cast(u64, setBodyStateBytes) + cast(u64, setJointSimBytes) + cast(u64, setContactSimBytes) + cast(u64, setIslandSimBytes);
    b3Log("solver sets");
    b3Log("body sim: %d", setBodySimBytes);
    b3Log("body state: %d", setBodyStateBytes);
    b3Log("joint sim: %d", setJointSimBytes);
    b3Log("contact sim: %d", setContactSimBytes);
    b3Log("island sim: %d", setIslandSimBytes);
    i32 bodyBitSetBytes = 0;
    i32 graphContactBytes = 0;
    i32 graphJointSimBytes = 0;
    for i32 i = 0; i < 24; ++i {
        b3GraphColor* c = world.constraintGraph.colors + i;
        bodyBitSetBytes += b3GetBitSetBytes(&c.bodySet);
        graphContactBytes += c.convexContacts.capacity * cast(i32, sizeof(*c.convexContacts.data)) + c.contacts.capacity * cast(i32, sizeof(*c.contacts.data));
        graphJointSimBytes += c.jointSims.capacity * cast(i32, sizeof(*c.jointSims.data));
    }
    total += cast(u64, bodyBitSetBytes) + cast(u64, graphJointSimBytes) + cast(u64, graphContactBytes);
    b3Log("constraint graph");
    b3Log("body bit sets: %d", bodyBitSetBytes);
    b3Log("joint sim: %d", graphJointSimBytes);
    b3Log("contact sim: %d", graphContactBytes);
    i32 taskContextBytes = world.taskContexts.capacity * cast(i32, sizeof(*world.taskContexts.data));
    for i32 i = 0; i < world.taskContexts.count; ++i {
        b3TaskContext* taskContext = world.taskContexts.data + i;
        taskContextBytes += taskContext.sensorHits.capacity * cast(i32, sizeof(*taskContext.sensorHits.data));
        taskContextBytes += b3GetBitSetBytes(&taskContext.contactStateBitSet);
        taskContextBytes += b3GetBitSetBytes(&taskContext.jointStateBitSet);
        taskContextBytes += b3GetBitSetBytes(&taskContext.hitEventBitSet);
        taskContextBytes += b3GetBitSetBytes(&taskContext.enlargedSimBitSet);
        taskContextBytes += b3GetBitSetBytes(&taskContext.awakeIslandBitSet);
    }
    i32 sensorTaskContextBytes = world.sensorTaskContexts.capacity * cast(i32, sizeof(*world.sensorTaskContexts.data));
    for i32 i = 0; i < world.sensorTaskContexts.count; ++i {
        b3SensorTaskContext* taskContext = world.sensorTaskContexts.data + i;
        sensorTaskContextBytes += b3GetBitSetBytes(&taskContext.eventBits);
    }
    total += cast(u64, taskContextBytes) + cast(u64, sensorTaskContextBytes);
    b3Log("task contexts");
    b3Log("worker: %d", taskContextBytes);
    b3Log("sensor: %d", sensorTaskContextBytes);
    i32 eventBytes = 0;
    eventBytes += world.bodyMoveEvents.capacity * cast(i32, sizeof(*world.bodyMoveEvents.data));
    eventBytes += world.sensorBeginEvents.capacity * cast(i32, sizeof(*world.sensorBeginEvents.data));
    eventBytes += world.contactBeginEvents.capacity * cast(i32, sizeof(*world.contactBeginEvents.data));
    eventBytes += world.sensorEndEvents[0].capacity * cast(i32, sizeof(*world.sensorEndEvents[0].data));
    eventBytes += world.sensorEndEvents[1].capacity * cast(i32, sizeof(*world.sensorEndEvents[1].data));
    eventBytes += world.contactEndEvents[0].capacity * cast(i32, sizeof(*world.contactEndEvents[0].data));
    eventBytes += world.contactEndEvents[1].capacity * cast(i32, sizeof(*world.contactEndEvents[1].data));
    eventBytes += world.contactHitEvents.capacity * cast(i32, sizeof(*world.contactHitEvents.data));
    eventBytes += world.jointEvents.capacity * cast(i32, sizeof(*world.jointEvents.data));
    total += cast(u64, eventBytes);
    b3Log("events: %d", eventBytes);
    i32 debugBytes = 0;
    debugBytes += b3GetBitSetBytes(&world.debugBodySet);
    debugBytes += b3GetBitSetBytes(&world.debugJointSet);
    debugBytes += b3GetBitSetBytes(&world.debugContactSet);
    debugBytes += b3GetBitSetBytes(&world.debugIslandSet);
    total += cast(u64, debugBytes);
    b3Log("debug draw: %d", debugBytes);
    total += cast(u64, world.stack.capacity);
    b3Log("stack allocator: %d", world.stack.capacity);
    b3Log("total: %u KB", cast(u32, total / 1024));
}

private {
bool TreeQueryCallback(i32 proxyId, u64 userData, void* context) {
    ignore proxyId;
    var shapeId = cast(i32, userData);
    var worldContext = cast(WorldQueryContext*, context);
    b3World* world = worldContext.world;
    b3Shape* shape = world.shapes.data + shapeId;
    b3Filter shapeFilter = shape.filter;
    b3QueryFilter queryFilter = worldContext.filter;
    if b3ShouldQueryCollide(&shapeFilter, &queryFilter) == false {
        return true;
    }
    var id = b3ShapeId{shapeId + 1, world.worldId, shape.generation};
    bool result = worldContext.fcn(id, worldContext.userContext);
    return result;
}
}

b3TreeStats b3World_OverlapAABB(b3WorldId worldId, b3AABB aabb, b3QueryFilter filter, b3OverlapResultFcn fcn, void* context) {
    b3TreeStats treeStats;
    b3World* world = b3GetUnlockedWorldFromId(worldId);
    if world == null {
        return treeStats;
    }
    b3RecQueryWriter recWriter;
    if world.recording != null {
        b3RecQueryBegin(&recWriter, context, filter.id, filter.name);
        recWriter.userFcn.overlapFcn = fcn;
        b3RecW_WORLDID(&recWriter.buf, worldId);
        b3RecW_AABB(&recWriter.buf, aabb);
        b3RecW_QUERYFILTER(&recWriter.buf, filter);
        recWriter.countOffset = b3RecReserveU32(&recWriter.buf);
        fcn = b3RecOverlapTrampoline;
        context = &recWriter;
    }
    var worldContext = WorldQueryContext{world, fcn, filter, context};
    for i32 i = 0; i < b3_bodyTypeCount; ++i {
        b3TreeStats treeResult = b3DynamicTree_Query(world.broadPhase.trees + i, aabb, filter.maskBits, false, cast(b3TreeQueryCallbackFcn, TreeQueryCallback), &worldContext);
        treeStats.nodeVisits += treeResult.nodeVisits;
        treeStats.leafVisits += treeResult.leafVisits;
    }
    if world.recording != null {
        b3RecPatchU32(&recWriter.buf, recWriter.countOffset, recWriter.hitCount);
        b3RecW_TREESTATS(&recWriter.buf, treeStats);
        b3RecQueryCommit(world.recording, cast(u8, b3_recOpQueryOverlapAABB), &recWriter);
    }
    return treeStats;
}

private {
bool b3TreeOverlapCallback(i32 proxyId, u64 userData, void* context) {
    ignore proxyId;
    var shapeId = cast(i32, userData);
    var worldContext = cast(WorldOverlapContext*, context);
    b3World* world = worldContext.world;
    b3Shape* shape = world.shapes.data + shapeId;
    b3Filter shapeFilter = shape.filter;
    b3QueryFilter queryFilter = worldContext.filter;
    if b3ShouldQueryCollide(&shapeFilter, &queryFilter) == false {
        return true;
    }
    b3Body* body = world.bodies.data + shape.bodyId;
    b3Transform transform = b3ToRelativeTransform(b3GetBodyTransformQuick(world, body), worldContext.origin);
    bool overlapping = b3OverlapShape(shape, transform, &worldContext.proxy);
    if overlapping == false {
        return true;
    }
    var id = b3ShapeId{shape.id + 1, world.worldId, shape.generation};
    bool result = worldContext.fcn(id, worldContext.userContext);
    return result;
}
}

b3TreeStats b3World_OverlapShape(b3WorldId worldId, b3Pos origin, b3ShapeProxy* proxy, b3QueryFilter filter, b3OverlapResultFcn fcn, void* context) {
    b3TreeStats treeStats;
    b3World* world = b3GetUnlockedWorldFromId(worldId);
    if world == null {
        return treeStats;
    }
    b3RecQueryWriter recWriter;
    if world.recording != null {
        b3RecQueryBegin(&recWriter, context, filter.id, filter.name);
        recWriter.userFcn.overlapFcn = fcn;
        b3RecW_WORLDID(&recWriter.buf, worldId);
        b3RecW_POSITION(&recWriter.buf, origin);
        b3RecW_SHAPEPROXY(&recWriter.buf, *proxy);
        b3RecW_QUERYFILTER(&recWriter.buf, filter);
        recWriter.countOffset = b3RecReserveU32(&recWriter.buf);
        fcn = b3RecOverlapTrampoline;
        context = &recWriter;
    }
    b3AABB aabb = b3OffsetAABB(b3MakeAABB(proxy.points, proxy.count, proxy.radius), origin);
    var worldContext = WorldOverlapContext{world, fcn, filter, *proxy, origin, context};
    for i32 i = 0; i < b3_bodyTypeCount; ++i {
        b3TreeStats treeResult = b3DynamicTree_Query(world.broadPhase.trees + i, aabb, filter.maskBits, false, cast(b3TreeQueryCallbackFcn, b3TreeOverlapCallback), &worldContext);
        treeStats.nodeVisits += treeResult.nodeVisits;
        treeStats.leafVisits += treeResult.leafVisits;
    }
    if world.recording != null {
        b3RecPatchU32(&recWriter.buf, recWriter.countOffset, recWriter.hitCount);
        b3RecW_TREESTATS(&recWriter.buf, treeStats);
        b3RecQueryCommit(world.recording, cast(u8, b3_recOpQueryOverlapShape), &recWriter);
    }
    return treeStats;
}

private {
bool TreeCollideCallback(i32 proxyId, u64 userData, void* context) {
    ignore proxyId;
    var shapeId = cast(i32, userData);
    var worldContext = cast(WorldMoverContext*, context);
    b3World* world = worldContext.world;
    b3Shape* shape = world.shapes.data + shapeId;
    b3Filter shapeFilter = shape.filter;
    b3QueryFilter queryFilter = worldContext.filter;
    if b3ShouldQueryCollide(&shapeFilter, &queryFilter) == false {
        return true;
    }
    b3Body* body = world.bodies.data + shape.bodyId;
    b3WorldTransform bodyTransform = b3GetBodyTransformQuick(world, body);
    b3Transform transform = b3ToRelativeTransform(bodyTransform, worldContext.origin);
    noinit b3PlaneResult[64] buffer;
    i32 count = b3CollideMover(buffer, 64, shape, transform, &worldContext.mover);
    if count > 0 {
        var id = b3ShapeId{shape.id + 1, world.worldId, shape.generation};
        return worldContext.fcn(id, buffer, count, worldContext.userContext);
    }
    return true;
}
}

// It is tempting to use a shape proxy for the mover, but this makes handling deep overlap difficult and the generality may
// not be worth it.
void b3World_CollideMover(b3WorldId worldId, b3Pos origin, b3Capsule* mover, b3QueryFilter filter, b3PlaneResultFcn fcn, void* context) {
    b3World* world = b3GetUnlockedWorldFromId(worldId);
    if world == null {
        return;
    }
    b3RecQueryWriter recWriter;
    if world.recording != null {
        b3RecQueryBegin(&recWriter, context, filter.id, filter.name);
        recWriter.userFcn.planeFcn = fcn;
        b3RecW_WORLDID(&recWriter.buf, worldId);
        b3RecW_POSITION(&recWriter.buf, origin);
        b3RecW_CAPSULE(&recWriter.buf, *mover);
        b3RecW_QUERYFILTER(&recWriter.buf, filter);
        recWriter.countOffset = b3RecReserveU32(&recWriter.buf);
        fcn = b3RecPlaneTrampoline;
        context = &recWriter;
    }
    var r = b3Vec3{mover.radius, mover.radius, mover.radius};
    noinit b3AABB relBox;
    relBox.lowerBound = b3Sub(b3Min(mover.center1, mover.center2), r);
    relBox.upperBound = b3Add(b3Max(mover.center1, mover.center2), r);
    b3AABB aabb = b3OffsetAABB(relBox, origin);
    var worldContext = WorldMoverContext{world, fcn, filter, *mover, origin, context};
    for i32 i = 0; i < b3_bodyTypeCount; ++i {
        b3DynamicTree_Query(world.broadPhase.trees + i, aabb, filter.maskBits, false, cast(b3TreeQueryCallbackFcn, TreeCollideCallback), &worldContext);
    }
    if world.recording != null {
        b3RecPatchU32(&recWriter.buf, recWriter.countOffset, recWriter.hitCount);
        b3RecQueryCommit(world.recording, cast(u8, b3_recOpQueryCollideMover), &recWriter);
    }
}

private {
f32 RayCastCallback(b3RayCastInput* input, i32 proxyId, u64 userData, void* context) {
    ignore proxyId;
    var shapeId = cast(i32, userData);
    var worldContext = cast(WorldRayCastContext*, context);
    b3World* world = worldContext.world;
    b3Shape* shape = world.shapes.data + shapeId;
    b3Filter shapeFilter = shape.filter;
    b3QueryFilter queryFilter = worldContext.filter;
    if b3ShouldQueryCollide(&shapeFilter, &queryFilter) == false {
        return input.maxFraction;
    }
    b3Body* body = world.bodies.data + shape.bodyId;
    b3WorldTransform bodyTransform = b3GetBodyTransformQuick(world, body);
    b3Transform transform = b3ToRelativeTransform(bodyTransform, worldContext.origin);
    b3RayCastInput localInput = *input;
    localInput.origin = b3Vec3_zero;
    b3CastOutput output = b3RayCastShape(shape, transform, &localInput);
    if output.hit != 0 {
        var id = b3ShapeId{shapeId + 1, world.worldId, shape.generation};
        b3Pos point = b3OffsetPos(worldContext.origin, output.point);
        i32 materialIndex = b3ClampInt(output.materialIndex, 0, shape.materialCount - 1);
        u64 userMaterialId = b3GetShapeMaterials(shape)[materialIndex].userMaterialId;
        i32 triangleIndex = output.triangleIndex;
        i32 childIndex = output.childIndex;
        f32 fraction = worldContext.fcn(id, point, output.normal, output.fraction, userMaterialId, triangleIndex, childIndex, worldContext.userContext);
        if 0.0f <= fraction && fraction <= 1.0f {
            worldContext.fraction = fraction;
        }
        return fraction;
    }
    return input.maxFraction;
}
}

b3TreeStats b3World_CastRay(b3WorldId worldId, b3Pos origin, b3Vec3 translation, b3QueryFilter filter, b3CastResultFcn fcn, void* context) {
    b3TreeStats treeStats;
    b3World* world = b3GetUnlockedWorldFromId(worldId);
    if world == null {
        return treeStats;
    }
    b3RecQueryWriter recWriter;
    if world.recording != null {
        b3RecQueryBegin(&recWriter, context, filter.id, filter.name);
        recWriter.userFcn.castFcn = fcn;
        b3RecW_WORLDID(&recWriter.buf, worldId);
        b3RecW_POSITION(&recWriter.buf, origin);
        b3RecW_VEC3(&recWriter.buf, translation);
        b3RecW_QUERYFILTER(&recWriter.buf, filter);
        recWriter.countOffset = b3RecReserveU32(&recWriter.buf);
        fcn = b3RecCastTrampoline;
        context = &recWriter;
    }
    var input = b3RayCastInput{b3ToVec3(origin), translation, 1.0f};
    var worldContext = WorldRayCastContext{world, fcn, filter, 1.0f, origin, context};
    for i32 i = 0; i < b3_bodyTypeCount; ++i {
        b3TreeStats treeResult = b3DynamicTree_RayCast(world.broadPhase.trees + i, &input, filter.maskBits, false, cast(b3TreeRayCastCallbackFcn, RayCastCallback), &worldContext);
        treeStats.nodeVisits += treeResult.nodeVisits;
        treeStats.leafVisits += treeResult.leafVisits;
        if worldContext.fraction == 0.0f {
            break;
        }
        input.maxFraction = worldContext.fraction;
    }
    if world.recording != null {
        b3RecPatchU32(&recWriter.buf, recWriter.countOffset, recWriter.hitCount);
        b3RecW_TREESTATS(&recWriter.buf, treeStats);
        b3RecQueryCommit(world.recording, cast(u8, b3_recOpQueryCastRay), &recWriter);
    }
    return treeStats;
}

// This callback finds the closest hit. This is the most common callback used in games.
private {
f32 b3RayCastClosestFcn(b3ShapeId shapeId, b3Pos point, b3Vec3 normal, f32 fraction, u64 userMaterialId, i32 triangleIndex, i32 childIndex, void* context) {
    if fraction == 0.0f {
        return -1.0f;
    }
    var rayResult = cast(b3RayResult*, context);
    rayResult.shapeId = shapeId;
    rayResult.point = point;
    rayResult.normal = normal;
    rayResult.fraction = fraction;
    rayResult.userMaterialId = userMaterialId;
    rayResult.triangleIndex = triangleIndex;
    rayResult.childIndex = childIndex;
    rayResult.hit = true;
    return fraction;
}
}

b3RayResult b3World_CastRayClosest(b3WorldId worldId, b3Pos origin, b3Vec3 translation, b3QueryFilter filter) {
    b3RayResult result;
    b3World* world = b3GetUnlockedWorldFromId(worldId);
    if world == null {
        return result;
    }
    var input = b3RayCastInput{b3ToVec3(origin), translation, 1.0f};
    var worldContext = WorldRayCastContext{
        .world = world,
        .fcn = b3RayCastClosestFcn,
        .filter = filter,
        .fraction = 1.0f,
        .origin = origin,
        .userContext = &result,
    };
    for i32 i = 0; i < b3_bodyTypeCount; ++i {
        b3TreeStats treeResult = b3DynamicTree_RayCast(world.broadPhase.trees + i, &input, filter.maskBits, false, cast(b3TreeRayCastCallbackFcn, RayCastCallback), &worldContext);
        result.nodeVisits += treeResult.nodeVisits;
        result.leafVisits += treeResult.leafVisits;
        if worldContext.fraction == 0.0f {
            break;
        }
        input.maxFraction = worldContext.fraction;
    }
    if world.recording != null {
        b3RecQueryWriter recWriter;
        b3RecQueryBegin(&recWriter, null, filter.id, filter.name);
        b3RecW_WORLDID(&recWriter.buf, worldId);
        b3RecW_POSITION(&recWriter.buf, origin);
        b3RecW_VEC3(&recWriter.buf, translation);
        b3RecW_QUERYFILTER(&recWriter.buf, filter);
        b3RecW_RAYRESULT(&recWriter.buf, result);
        b3RecQueryCommit(world.recording, cast(u8, b3_recOpQueryCastRayClosest), &recWriter);
    }
    return result;
}

private {
f32 b3ShapeCastCallback(b3BoxCastInput* input, i32 proxyId, u64 userData, void* context) {
    ignore proxyId;
    var shapeId = cast(i32, userData);
    var worldContext = cast(WorldShapeCastContext*, context);
    b3World* world = worldContext.world;
    b3Shape* shape = world.shapes.data + shapeId;
    b3Filter shapeFilter = shape.filter;
    b3QueryFilter queryFilter = worldContext.filter;
    if b3ShouldQueryCollide(&shapeFilter, &queryFilter) == false {
        return input.maxFraction;
    }
    b3ShapeCastInput localInput = worldContext.input;
    localInput.maxFraction = input.maxFraction;
    b3Body* body = world.bodies.data + shape.bodyId;
    b3Transform transform = b3ToRelativeTransform(b3GetBodyTransformQuick(world, body), worldContext.origin);
    b3CastOutput output = b3ShapeCastShape(shape, transform, &localInput);
    if output.hit != 0 {
        var id = b3ShapeId{shapeId + 1, world.worldId, shape.generation};
        i32 materialIndex = b3ClampInt(output.materialIndex, 0, shape.materialCount - 1);
        u64 userMaterialId = b3GetShapeMaterials(shape)[materialIndex].userMaterialId;
        i32 triangleIndex = output.triangleIndex;
        i32 childIndex = output.childIndex;
        f32 fraction = worldContext.fcn(id, b3OffsetPos(worldContext.origin, output.point), output.normal, output.fraction, userMaterialId, triangleIndex, childIndex, worldContext.userContext);
        if 0.0f <= fraction && fraction <= 1.0f {
            worldContext.fraction = fraction;
        }
        return fraction;
    }
    return input.maxFraction;
}
}

b3TreeStats b3World_CastShape(b3WorldId worldId, b3Pos origin, b3ShapeProxy* proxy, b3Vec3 translation, b3QueryFilter filter, b3CastResultFcn fcn, void* context) {
    b3TreeStats treeStats;
    b3World* world = b3GetUnlockedWorldFromId(worldId);
    if world == null {
        return treeStats;
    }
    b3RecQueryWriter recWriter;
    if world.recording != null {
        b3RecQueryBegin(&recWriter, context, filter.id, filter.name);
        recWriter.userFcn.castFcn = fcn;
        b3RecW_WORLDID(&recWriter.buf, worldId);
        b3RecW_POSITION(&recWriter.buf, origin);
        b3RecW_SHAPEPROXY(&recWriter.buf, *proxy);
        b3RecW_VEC3(&recWriter.buf, translation);
        b3RecW_QUERYFILTER(&recWriter.buf, filter);
        recWriter.countOffset = b3RecReserveU32(&recWriter.buf);
        fcn = b3RecCastTrampoline;
        context = &recWriter;
    }
    WorldShapeCastContext worldContext;
    worldContext.world = world;
    worldContext.fcn = fcn;
    worldContext.filter = filter;
    worldContext.fraction = 1.0f;
    worldContext.origin = origin;
    worldContext.input.proxy = *proxy;
    worldContext.input.translation = translation;
    worldContext.input.maxFraction = 1.0f;
    worldContext.input.canEncroach = false;
    worldContext.userContext = context;
    b3AABB localBox = b3MakeAABB(proxy.points, proxy.count, proxy.radius);
    var treeInput = b3BoxCastInput{b3OffsetAABB(localBox, origin), translation, 1.0f};
    for i32 i = 0; i < b3_bodyTypeCount; ++i {
        b3TreeStats treeResult = b3DynamicTree_BoxCast(world.broadPhase.trees + i, &treeInput, filter.maskBits, false, cast(b3TreeBoxCastCallbackFcn, b3ShapeCastCallback), &worldContext);
        treeStats.nodeVisits += treeResult.nodeVisits;
        treeStats.leafVisits += treeResult.leafVisits;
        if worldContext.fraction == 0.0f {
            break;
        }
        treeInput.maxFraction = worldContext.fraction;
    }
    if world.recording != null {
        b3RecPatchU32(&recWriter.buf, recWriter.countOffset, recWriter.hitCount);
        b3RecW_TREESTATS(&recWriter.buf, treeStats);
        b3RecQueryCommit(world.recording, cast(u8, b3_recOpQueryCastShape), &recWriter);
    }
    return treeStats;
}

private {
f32 MoverCastCallback(b3BoxCastInput* input, i32 proxyId, u64 userData, void* context) {
    ignore proxyId;
    var shapeId = cast(i32, userData);
    var worldContext = cast(WorldMoverCastContext*, context);
    b3World* world = worldContext.world;
    b3Shape* shape = world.shapes.data + shapeId;
    b3Filter shapeFilter = shape.filter;
    b3QueryFilter queryFilter = worldContext.filter;
    if b3ShouldQueryCollide(&shapeFilter, &queryFilter) == false {
        return worldContext.fraction;
    }
    if worldContext.fcn != null {
        var id = b3ShapeId{shapeId + 1, world.worldId, shape.generation};
        bool shouldCollide = worldContext.fcn(id, worldContext.userContext);
        if shouldCollide == false {
            return worldContext.fraction;
        }
    }
    b3ShapeCastInput localInput = worldContext.input;
    localInput.maxFraction = input.maxFraction;
    b3Body* body = world.bodies.data + shape.bodyId;
    b3Transform transform = b3ToRelativeTransform(b3GetBodyTransformQuick(world, body), worldContext.origin);
    b3CastOutput output = b3ShapeCastShape(shape, transform, &localInput);
    if output.fraction == 0.0f {
        return worldContext.fraction;
    }
    worldContext.fraction = output.fraction;
    return output.fraction;
}
}

f32 b3World_CastMover(b3WorldId worldId, b3Pos origin, b3Capsule* mover, b3Vec3 translation, b3QueryFilter filter, b3MoverFilterFcn fcn, void* context) {
    b3World* world = b3GetUnlockedWorldFromId(worldId);
    if world == null {
        return 1.0f;
    }
    b3RecQueryWriter recWriter;
    if world.recording != null {
        b3RecQueryBegin(&recWriter, context, filter.id, filter.name);
        recWriter.userFcn.moverFilterFcn = fcn;
        b3RecW_WORLDID(&recWriter.buf, worldId);
        b3RecW_POSITION(&recWriter.buf, origin);
        b3RecW_CAPSULE(&recWriter.buf, *mover);
        b3RecW_VEC3(&recWriter.buf, translation);
        b3RecW_QUERYFILTER(&recWriter.buf, filter);
        recWriter.countOffset = b3RecReserveU32(&recWriter.buf);
        fcn = b3RecOverlapTrampoline;
        context = &recWriter;
    }
    var worldContext = WorldMoverCastContext{
        .world = world,
        .fcn = fcn,
        .filter = filter,
        .fraction = 1.0f,
        .origin = origin,
        .userContext = context,
    };
    worldContext.input.proxy = b3ShapeProxy{&mover.center1, 2, mover.radius};
    worldContext.input.translation = translation;
    worldContext.input.maxFraction = 1.0f;
    worldContext.input.canEncroach = mover.radius > 0.0f;
    b3Vec3[2] centers = {mover.center1, mover.center2};
    var treeInput = b3BoxCastInput{
        b3OffsetAABB(b3MakeAABB(centers, 2, mover.radius), origin), translation, 1.0f,
    };
    for i32 i = 0; i < b3_bodyTypeCount; ++i {
        b3DynamicTree_BoxCast(world.broadPhase.trees + i, &treeInput, filter.maskBits, false, cast(b3TreeBoxCastCallbackFcn, MoverCastCallback), &worldContext);
        if worldContext.fraction == 0.0f {
            break;
        }
        treeInput.maxFraction = worldContext.fraction;
    }
    if world.recording != null {
        b3RecPatchU32(&recWriter.buf, recWriter.countOffset, recWriter.hitCount);
        b3RecW_F32(&recWriter.buf, worldContext.fraction);
        b3RecQueryCommit(world.recording, cast(u8, b3_recOpQueryCastMover), &recWriter);
    }
    return worldContext.fraction;
}

