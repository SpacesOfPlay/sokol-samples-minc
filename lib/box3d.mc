void b3Body_SetGravityScale(b3BodyId bodyId, f32 gravityScale) {
    b3World* world = b3GetUnlockedWorld(cast(i32, bodyId.world0));
    if world == null {
        return;
    }
    while true {
        if world.recording != null {
            var recArgs = b3RecArgs_BodySetGravityScale{bodyId, gravityScale};
            b3RecWrite_BodySetGravityScale(world.recording, &recArgs);
        }
        if !(0 != 0) { break; }
    }
    b3Body* body = b3GetBodyFullId(world, bodyId);
    b3BodySim* bodySim = b3GetBodySim(world, body);
    bodySim.gravityScale = gravityScale;
}

f32 b3Body_GetGravityScale(b3BodyId bodyId) {
    b3World* world = b3GetWorld(cast(i32, bodyId.world0));
    b3Body* body = b3GetBodyFullId(world, bodyId);
    b3BodySim* bodySim = b3GetBodySim(world, body);
    return bodySim.gravityScale;
}

bool b3Body_IsAwake(b3BodyId bodyId) {
    b3World* world = b3GetWorld(cast(i32, bodyId.world0));
    b3Body* body = b3GetBodyFullId(world, bodyId);
    return body.setIndex == b3_awakeSet;
}

void b3Body_SetAwake(b3BodyId bodyId, bool awake) {
    b3World* world = b3GetUnlockedWorld(cast(i32, bodyId.world0));
    if world == null {
        return;
    }
    while true {
        if world.recording != null {
            var recArgs = b3RecArgs_BodySetAwake{bodyId, awake};
            b3RecWrite_BodySetAwake(world.recording, &recArgs);
        }
        if !(0 != 0) { break; }
    }
    world.locked = true;
    b3Body* body = b3GetBodyFullId(world, bodyId);
    if awake && body.setIndex >= b3_firstSleepingSet {
        b3WakeBody(world, body);
    } else if awake == false && body.setIndex == b3_awakeSet {
        b3Island* island = world.islands.data + body.islandId;
        if island.constraintRemoveCount > 0 {
            b3SplitIsland(world, body.islandId);
        }
        b3TrySleepIsland(world, body.islandId);
    }
    world.locked = false;
}

bool b3Body_IsEnabled(b3BodyId bodyId) {
    b3World* world = b3GetWorld(cast(i32, bodyId.world0));
    b3Body* body = b3GetBodyFullId(world, bodyId);
    return body.setIndex != b3_disabledSet;
}

bool b3Body_IsSleepEnabled(b3BodyId bodyId) {
    b3World* world = b3GetWorld(cast(i32, bodyId.world0));
    b3Body* body = b3GetBodyFullId(world, bodyId);
    return (body.flags & cast(u32, b3_enableSleep)) == cast(u32, b3_enableSleep);
}

void b3Body_SetSleepThreshold(b3BodyId bodyId, f32 sleepThreshold) {
    b3World* world = b3GetWorld(cast(i32, bodyId.world0));
    while true {
        if world.recording != null {
            var recArgs = b3RecArgs_BodySetSleepThreshold{bodyId, sleepThreshold};
            b3RecWrite_BodySetSleepThreshold(world.recording, &recArgs);
        }
        if !(0 != 0) { break; }
    }
    b3Body* body = b3GetBodyFullId(world, bodyId);
    body.sleepThreshold = sleepThreshold;
}

f32 b3Body_GetSleepThreshold(b3BodyId bodyId) {
    b3World* world = b3GetWorld(cast(i32, bodyId.world0));
    b3Body* body = b3GetBodyFullId(world, bodyId);
    return body.sleepThreshold;
}

void b3Body_EnableSleep(b3BodyId bodyId, bool enableSleep) {
    b3World* world = b3GetUnlockedWorld(cast(i32, bodyId.world0));
    if world == null {
        return;
    }
    while true {
        if world.recording != null {
            var recArgs = b3RecArgs_BodyEnableSleep{bodyId, enableSleep};
            b3RecWrite_BodyEnableSleep(world.recording, &recArgs);
        }
        if !(0 != 0) { break; }
    }
    b3Body* body = b3GetBodyFullId(world, bodyId);
    bool flag = (body.flags & cast(u32, b3_enableSleep)) == cast(u32, b3_enableSleep);
    if enableSleep == flag {
        return;
    }
    world.locked = true;
    body.flags = enableSleep != 0 ? body.flags | cast(u32, b3_enableSleep) : body.flags & cast(u32, ~b3_enableSleep);
    b3SyncBodyFlags(world, body);
    if enableSleep == false {
        b3WakeBody(world, body);
    }
    world.locked = false;
}

// Disabling a body requires a lot of detailed bookkeeping, but it is a valuable feature.
// The most challenging aspect that joints may connect to bodies that are not disabled.
void b3Body_Disable(b3BodyId bodyId) {
    b3World* world = b3GetUnlockedWorld(cast(i32, bodyId.world0));
    if world == null {
        return;
    }
    while true {
        if world.recording != null {
            var recArgs = b3RecArgs_BodyDisable{bodyId};
            b3RecWrite_BodyDisable(world.recording, &recArgs);
        }
        if !(0 != 0) { break; }
    }
    world.locked = true;
    b3Body* body = b3GetBodyFullId(world, bodyId);
    if body.setIndex == b3_disabledSet {
        world.locked = false;
        return;
    }
    bool wakeBodies = true;
    b3DestroyBodyContacts(world, body, wakeBodies);
    b3SolverSet* set = world.solverSets.data + body.setIndex;
    b3SolverSet* disabledSet = world.solverSets.data + b3_disabledSet;
    i32 jointKey = body.headJointKey;
    while jointKey != -1 {
        i32 jointId = jointKey >> 1;
        i32 edgeIndex = jointKey & 1;
        b3Joint* joint = world.joints.data + jointId;
        jointKey = joint.edges[edgeIndex].nextKey;
        if joint.setIndex == b3_disabledSet {
            continue;
        }
        b3UnlinkJoint(world, joint);
        b3SolverSet* jointSet = world.solverSets.data + joint.setIndex;
        b3TransferJoint(world, disabledSet, jointSet, joint);
    }
    i32 shapeId = body.headShapeId;
    while shapeId != -1 {
        b3Shape* shape = world.shapes.data + shapeId;
        shapeId = shape.nextShapeId;
        b3DestroyShapeProxy(shape, &world.broadPhase);
    }
    b3RemoveBodyFromIsland(world, body);
    b3TransferBody(world, disabledSet, set, body);
    b3ValidateConnectivity(world);
    b3ValidateSolverSets(world);
    world.locked = false;
}

void b3Body_Enable(b3BodyId bodyId) {
    b3World* world = b3GetUnlockedWorld(cast(i32, bodyId.world0));
    if world == null {
        return;
    }
    while true {
        if world.recording != null {
            var recArgs = b3RecArgs_BodyEnable{bodyId};
            b3RecWrite_BodyEnable(world.recording, &recArgs);
        }
        if !(0 != 0) { break; }
    }
    b3Body* body = b3GetBodyFullId(world, bodyId);
    if body.setIndex != b3_disabledSet {
        return;
    }
    b3SolverSet* disabledSet = world.solverSets.data + b3_disabledSet;
    i32 setId = body.type == b3_staticBody ? b3_staticSet : b3_awakeSet;
    b3SolverSet* targetSet = world.solverSets.data + setId;
    b3TransferBody(world, targetSet, disabledSet, body);
    b3WorldTransform transform = b3GetBodyTransformQuick(world, body);
    b3BodyType proxyType = body.type;
    bool forcePairCreation = true;
    i32 shapeId = body.headShapeId;
    while shapeId != -1 {
        b3Shape* shape = world.shapes.data + shapeId;
        shapeId = shape.nextShapeId;
        b3CreateShapeProxy(shape, &world.broadPhase, proxyType, transform, forcePairCreation);
    }
    if setId != b3_staticSet {
        b3CreateIslandForBody(world, setId, body);
    }
    i32 jointKey = body.headJointKey;
    while jointKey != -1 {
        i32 jointId = jointKey >> 1;
        i32 edgeIndex = jointKey & 1;
        b3Joint* joint = world.joints.data + jointId;
        jointKey = joint.edges[edgeIndex].nextKey;
        b3Body* bodyA = world.bodies.data + joint.edges[0].bodyId;
        b3Body* bodyB = world.bodies.data + joint.edges[1].bodyId;
        if bodyA.setIndex == b3_disabledSet || bodyB.setIndex == b3_disabledSet {
            continue;
        }
        i32 jointSetId;
        if bodyA.setIndex == b3_staticSet && bodyB.setIndex == b3_staticSet {
            jointSetId = b3_staticSet;
        } else if bodyA.setIndex == b3_staticSet {
            jointSetId = bodyB.setIndex;
        } else {
            jointSetId = bodyA.setIndex;
        }
        b3SolverSet* jointSet = world.solverSets.data + jointSetId;
        b3TransferJoint(world, jointSet, disabledSet, joint);
        if jointSetId != b3_staticSet {
            b3LinkJoint(world, joint);
        }
    }
    b3ValidateSolverSets(world);
}

void b3Body_SetMotionLocks(b3BodyId bodyId, b3MotionLocks locks) {
    b3World* world = b3GetUnlockedWorld(cast(i32, bodyId.world0));
    if world == null {
        return;
    }
    while true {
        if world.recording != null {
            var recArgs = b3RecArgs_BodySetMotionLocks{bodyId, locks};
            b3RecWrite_BodySetMotionLocks(world.recording, &recArgs);
        }
        if !(0 != 0) { break; }
    }
    u32 newLocks = 0;
    newLocks |= cast(u32, locks.linearX != 0 ? b3_lockLinearX : 0);
    newLocks |= cast(u32, locks.linearY != 0 ? b3_lockLinearY : 0);
    newLocks |= cast(u32, locks.linearZ != 0 ? b3_lockLinearZ : 0);
    newLocks |= cast(u32, locks.angularX != 0 ? b3_lockAngularX : 0);
    newLocks |= cast(u32, locks.angularY != 0 ? b3_lockAngularY : 0);
    newLocks |= cast(u32, locks.angularZ != 0 ? b3_lockAngularZ : 0);
    b3Body* body = b3GetBodyFullId(world, bodyId);
    if (body.flags & cast(u32, b3_allLocks)) == newLocks {
        return;
    }
    bool fixedRotation1 = (body.flags & cast(u32, b3_fixedRotation)) == cast(u32, b3_fixedRotation);
    bool fixedRotation2 = (newLocks & cast(u32, b3_fixedRotation)) == cast(u32, b3_fixedRotation);
    body.flags &= cast(u32, ~b3_allLocks);
    body.flags |= newLocks;
    b3SyncBodyFlags(world, body);
    b3BodyState* state = b3GetBodyState(world, body);
    if state != null {
        if locks.linearX != 0 {
            state.linearVelocity.x = 0.0f;
        }
        if locks.linearY != 0 {
            state.linearVelocity.y = 0.0f;
        }
        if locks.linearZ != 0 {
            state.linearVelocity.z = 0.0f;
        }
        if locks.angularX != 0 {
            state.angularVelocity.x = 0.0f;
        }
        if locks.angularY != 0 {
            state.angularVelocity.y = 0.0f;
        }
        if locks.angularZ != 0 {
            state.angularVelocity.z = 0.0f;
        }
    }
    if fixedRotation1 != fixedRotation2 {
        b3UpdateBodyMassData(world, body);
    }
}

b3MotionLocks b3Body_GetMotionLocks(b3BodyId bodyId) {
    b3World* world = b3GetWorld(cast(i32, bodyId.world0));
    b3Body* body = b3GetBodyFullId(world, bodyId);
    noinit b3MotionLocks locks;
    locks.linearX = (body.flags & cast(u32, b3_lockLinearX)) != 0;
    locks.linearY = (body.flags & cast(u32, b3_lockLinearY)) != 0;
    locks.linearZ = (body.flags & cast(u32, b3_lockLinearZ)) != 0;
    locks.angularX = (body.flags & cast(u32, b3_lockAngularX)) != 0;
    locks.angularY = (body.flags & cast(u32, b3_lockAngularY)) != 0;
    locks.angularZ = (body.flags & cast(u32, b3_lockAngularZ)) != 0;
    return locks;
}

void b3Body_SetBullet(b3BodyId bodyId, bool flag) {
    b3World* world = b3GetUnlockedWorld(cast(i32, bodyId.world0));
    if world == null {
        return;
    }
    while true {
        if world.recording != null {
            var recArgs = b3RecArgs_BodySetBullet{bodyId, flag};
            b3RecWrite_BodySetBullet(world.recording, &recArgs);
        }
        if !(0 != 0) { break; }
    }
    var newFlag = cast(u32, flag != 0 ? b3_isBullet : 0);
    b3Body* body = b3GetBodyFullId(world, bodyId);
    if (body.flags & cast(u32, b3_isBullet)) == newFlag {
        return;
    }
    body.flags &= cast(u32, ~b3_isBullet);
    body.flags |= newFlag;
    b3SyncBodyFlags(world, body);
}

bool b3Body_IsBullet(b3BodyId bodyId) {
    b3World* world = b3GetWorld(cast(i32, bodyId.world0));
    b3Body* body = b3GetBodyFullId(world, bodyId);
    return (body.flags & cast(u32, b3_isBullet)) != 0;
}

