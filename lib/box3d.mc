struct ExplosionContext {
    b3World* world;
    b3Pos position;
    f32 radius;
    f32 falloff;
    f32 impulsePerArea;
}

// A single recorded callback hit, used both as reader scratch during a query replay and as the
// per-frame draw store. For collide-mover, one hit is one plane, with planeCount and userReturnB
// replicated across a shape's planes so the replay walker can re-group and compare per shape.
struct b3RecRecordedHit {
    b3ShapeId id;
    b3Pos point;
    b3Vec3 normal;
    f32 fraction;
    u64 userMaterialId;
    i32 triangleIndex;
    i32 childIndex;
    b3PlaneResult plane;
    i32 planeCount;
    f32 userReturnF;
    bool userReturnB;
}

// Per-frame draw record for one query call. Self-contained (no aliased pointers) so the player's
// frameQueries array can grow with a plain memcpy. Geometry is origin relative except the overlap
// AABB, which is world space in 3D.
struct b3RecDrawQuery {
    i32 kind;
    u64 key;
    b3QueryFilter filter;
    b3AABB aabb;
    b3Vec3[64] proxyPoints;
    i32 proxyCount;
    f32 proxyRadius;
    b3Capsule mover;
    b3Pos origin;
    b3Vec3 translation;
    f32 castFraction;
    b3RayResult rayResult;
    b3ShapeId shape;
    i32 hitStart;
    i32 hitCount;
}

// One slot in the preloaded geometry registry. Loaded from the trailing block before any
// ops run; live pointer built lazily on first shape create that references the id.
struct b3RegistrySlot {
    b3GeometryKind kind;
    i32 byteCount;
    u8* bytes;
    void* live;
}

// This is used to simplify the scratch buffer lifetime. Names longer than this probably
// indicate a bug.
// Reader state threaded through the replay loop and all dispatch functions
struct b3RecReader {
    u8* data;
    i32 size;
    i32 cursor;
    b3WorldId replayWorldId;
    bool ok;
    bool diverged;
    b3RecPlayer* owner;
    b3SurfaceMaterial* matScratch;
    i32 matScratchCap;
    __arr_u8_257[4] stringBuffers;
    i32 nextString;
    b3RegistrySlot* slots;
    i32 slotCount;
    b3RecTag* tags;
    i32 tagCount;
    i32 tagCapacity;
    void* tagMap;
    u64 pendingQueryKey;
    b3RecRecordedHit* hits;
    i32 hitCap;
    b3Vec3* proxyScratch;
    i32 proxyScratchCap;
}

// Stored snapshot for fast backward seek.
struct b3RecKeyframe {
    u8* image;
    i32 imageSize;
    i32 imageCapacity;
    i32 frame;
    i32 cursor;
    i32 divergeFrame;
    bool diverged;
    b3BodyId* bodyIds;
    i32 bodyIdCount;
}

struct b3RecPlayer {
    u8* data;
    i32 size;
    i32 headerEnd;
    i32 registryEnd;
    f32 lengthScale;
    f32 previousLengthScale;
    i32 frame;
    i32 frameCount;
    f32 recordedDt;
    i32 recordedSubStepCount;
    i32 recordedWorkerCount;
    b3AABB bounds;
    bool atEnd;
    bool atPreStep;
    i32 divergeFrame;
    b3BodyId* bodyIds;
    i32 bodyIdCount;
    i32 bodyIdCap;
    b3BodyId* frame0BodyIds;
    i32 frame0BodyIdCount;
    b3RecDrawQuery* frameQueries;
    i32 frameQueryCount;
    i32 frameQueryCap;
    b3RecRecordedHit* frameHits;
    i32 frameHitCount;
    i32 frameHitCap;
    b3CreateDebugShapeCallback createDebugShape;
    b3DestroyDebugShapeCallback destroyDebugShape;
    void* debugShapeContext;
    b3RecReader rdr;
    u8* frame0Image;
    i32 frame0Size;
    b3RecKeyframe* keyframes;
    i32 keyframeCount;
    i32 keyframeCapacity;
    u64 keyframeBudget;
    u64 keyframeBytes;
    i32 keyframeMinInterval;
    i32 keyframeInterval;
    i32 lastKeyframeFrame;
    b3Recording* keyframeRec;
}

struct b3GeometryHashMap_bucket {
