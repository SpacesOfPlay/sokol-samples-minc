/*--------------------------------------------------------------------------------------------------------------------*/
/*                                               Common header section                                                */
/*--------------------------------------------------------------------------------------------------------------------*/
/*--------------------------------------------------------------------------------------------------------------------*/
/*                                                  Prefixed structs                                                  */
/*--------------------------------------------------------------------------------------------------------------------*/
when !(defined(IMPLEMENTATION_MODE)) {
}
/*--------------------------------------------------------------------------------------------------------------------*/
/*                                                Function prototypes                                                 */
/*--------------------------------------------------------------------------------------------------------------------*/
when !(defined(IMPLEMENTATION_MODE)) {

// Erases the key pointed to by itr and returns an iterator to the next key in the table.
// This function must be inlined to ensure that the compiler optimizes away the NAME_fast_forward call if the returned
// iterator is discarded.
private {
b3NameMap_itr b3NameMap_erase_itr(b3NameMap* table, b3NameMap_itr itr) {
    if b3NameMap_erase_itr_raw(table, itr) != 0 {
        return b3NameMap_next(itr);
    }
    return itr;
}
}
}
/*--------------------------------------------------------------------------------------------------------------------*/
/*                                              Function implementations                                              */
/*--------------------------------------------------------------------------------------------------------------------*/
when !(defined(HEADER_MODE)) {
// Default settings.

private {
void b3NameMap_init(b3NameMap* table) {
    table.key_count = 0;
    table.buckets_mask = 0x0000000000000000;
    table.buckets = null;
    table.metadata = &vt_empty_placeholder_metadatum;
}

// For efficiency, especially in the case of a small table, the buckets array and metadata share the same dynamic memory
// allocation:
//   +-----------------------------+-----+----------------+--------+
//   |           Buckets           | Pad |    Metadata    | Excess |
//   +-----------------------------+-----+----------------+--------+
// Any allocated metadata array requires four excess elements to ensure that iteration functions, which read four
// metadata at a time, never read beyond the end of it.
// This function returns the offset of the beginning of the metadata, i.e. the size of the buckets array plus the
// (usually zero) padding.
// It assumes that the bucket count is not zero.
u64 b3NameMap_metadata_offset(b3NameMap* table) {
    return ((table.buckets_mask + 1) * cast(u64, sizeof(b3NameMap_bucket)) + cast(u64, sizeof(u16)) - 1) / cast(u64, sizeof(u16)) * cast(u64, sizeof(u16));
}

// Returns the total allocation size, including the buckets array, padding, metadata, and excess metadata.
// As above, this function assumes that the bucket count is not zero.
u64 b3NameMap_total_alloc_size(b3NameMap* table) {
    return b3NameMap_metadata_offset(table) + (table.buckets_mask + 1 + 4) * cast(u64, sizeof(u16));
}

bool b3NameMap_init_clone(b3NameMap* table, b3NameMap* source) {
    table.key_count = source.key_count;
    table.buckets_mask = source.buckets_mask;
    if source.buckets_mask == 0 {
        table.metadata = &vt_empty_placeholder_metadatum;
        table.buckets = null;
        return true;
    }
    void* allocation = b3Alloc(b3NameMap_total_alloc_size(table));
    if allocation == null {
        return false;
    }
    table.buckets = cast(b3NameMap_bucket*, allocation);
    table.metadata = cast(u16*, cast(u8*, allocation) + b3NameMap_metadata_offset(table));
    memcpy(allocation, source.buckets, b3NameMap_total_alloc_size(table));
    return true;
}

u64 b3NameMap_size(b3NameMap* table) {
    return table.key_count;
}

u64 b3NameMap_bucket_count(b3NameMap* table) {
    return table.buckets_mask + cast(u64, cast(bool, table.buckets_mask));
}

bool b3NameMap_is_end(b3NameMap_itr itr) {
    return itr.metadatum == itr.metadata_end;
}

// Finds the earliest empty bucket in which a key belonging to home_bucket can be placed, assuming that home_bucket
// is already occupied.
// The reason to begin the search at home_bucket, rather than the end of the existing chain, is that keys deleted from
// other chains might have freed up buckets that could fall in this chain before the final key.
// Returns true if an empty bucket within the range of the displacement limit was found, in which case the final two
// pointer arguments contain the index of the empty bucket and its quadratic displacement from home_bucket.
bool b3NameMap_find_first_empty(b3NameMap* table, u64 home_bucket, u64* empty, u16* displacement) {
    *displacement = 1;
    u64 linear_dispacement = 1;
    while true {
        *empty = home_bucket + linear_dispacement & table.buckets_mask;
        if table.metadata[*empty] == 0x0000 {
            return true;
        }
        if ++*displacement == 0x07FF {
            return false;
        }
        linear_dispacement += *displacement;
    }
}

// Finds the key in the chain beginning in home_bucket after which to link a new key with displacement_to_empty
// quadratic displacement and returns the index of the bucket containing that key.
// Although the new key could simply be linked to the end of the chain, keeping the chain ordered by displacement
// theoretically improves cache locality during lookups.
u64 b3NameMap_find_insert_location_in_chain(b3NameMap* table, u64 home_bucket, u16 displacement_to_empty) {
    u64 candidate = home_bucket;
    while true {
        u16 displacement = table.metadata[candidate] & 0x07FF;
        if displacement > displacement_to_empty {
            return candidate;
        }
        candidate = home_bucket + vt_quadratic(displacement) & table.buckets_mask;
    }
}

// Frees up a bucket occupied by a key not belonging there so that a new key belonging there can be placed there as the
// beginning of a new chain.
// This requires:
// * Finding the previous key in the chain to which the occupying key belongs by rehashing it and then traversing the
//   chain.
// * Disconnecting the key from the chain.
// * Finding the appropriate empty bucket to which to move the key.
// * Moving the key (and value) data to the empty bucket.
// * Re-linking the key to the chain.
// Returns true if the eviction succeeded, or false if no empty bucket to which to evict the occupying key could be
// found within the displacement limit.
bool b3NameMap_evict(b3NameMap* table, u64 bucket) {
    u64 home_bucket = vt_hash_integer(table.buckets[bucket].key) & table.buckets_mask;
    u64 prev = home_bucket;
    while true {
        u64 next = home_bucket + vt_quadratic(table.metadata[prev] & 0x07FF) & table.buckets_mask;
        if next == bucket {
            break;
        }
        prev = next;
    }
    table.metadata[prev] = cast(u16, table.metadata[prev] & ~0x07FF | table.metadata[bucket] & 0x07FF);
    u64 empty;
    u16 displacement;
    if b3NameMap_find_first_empty(table, home_bucket, &empty, &displacement) == 0 {
        return false;
    }
    prev = b3NameMap_find_insert_location_in_chain(table, home_bucket, displacement);
    table.buckets[empty] = table.buckets[bucket];
    table.metadata[empty] = table.metadata[bucket] & 0xF000 | table.metadata[prev] & 0x07FF;
    table.metadata[prev] = cast(u16, table.metadata[prev] & ~0x07FF | displacement);
    return true;
}

// Returns an end iterator, i.e. any iterator for which .metadatum == .metadata_end.
// This function just cleans up the library code in functions that return an end iterator as a failure indicator.
b3NameMap_itr b3NameMap_end_itr() {
    b3NameMap_itr itr;
    return itr;
}

// Inserts a key, optionally replacing the existing key if it already exists.
// There are two main cases that must be handled:
// * If the key's home bucket is empty or occupied by a key that does not belong there, then the key is inserted there,
//   evicting the occupying key if there is one.
// * Otherwise, the chain of keys beginning at the home bucket is (if unique is false) traversed in search of a matching
//   key.
//   If none is found, then the new key is inserted at the earliest available bucket, per quadratic probing from the
//   home bucket, and then linked to the chain in a manner that maintains its quadratic order.
// The unique argument tells the function whether to skip searching for the key before inserting it (on rehashing, this
// step is unnecessary).
// The replace argument tells the function whether to replace an existing key.
// If replace is true, the function returns an iterator to the inserted key, or an end iterator if the key was not
// inserted because of the maximum load factor or displacement limit constraints.
// If replace is false, then the return value is as described above, except that if the key already exists, the function
// returns an iterator to the existing key.
b3NameMap_itr b3NameMap_insert_raw(b3NameMap* table, u32 key, i32* val, bool unique, bool replace) {
    u64 hash = vt_hash_integer(key);
    u16 hashfrag = vt_hashfrag(hash);
    u64 home_bucket = hash & table.buckets_mask;
    if (table.metadata[home_bucket] & 0x0800) == 0 {
        if cast(f64, table.key_count + 1) > cast(f64, b3NameMap_bucket_count(table)) * 0.9 || table.metadata[home_bucket] != 0x0000 && !b3NameMap_evict(table, home_bucket) {
            return b3NameMap_end_itr();
        }
        table.buckets[home_bucket].key = key;
        table.buckets[home_bucket].val = *val;
        table.metadata[home_bucket] = hashfrag | 0x0800 | 0x07FF;
        ++table.key_count;
        var itr = b3NameMap_itr{
            table.buckets + home_bucket, table.metadata + home_bucket,
            table.metadata + table.buckets_mask + 1, home_bucket,
        };
        return itr;
    }
    if unique == 0 {
        u64 bucket = home_bucket;
        while true {
            if (table.metadata[bucket] & 0xF000) == hashfrag && vt_cmpr_integer(table.buckets[bucket].key, key) {
                if replace != 0 {
                    table.buckets[bucket].key = key;
                    table.buckets[bucket].val = *val;
                }
                var itr = b3NameMap_itr{
                    table.buckets + bucket, table.metadata + bucket,
                    table.metadata + table.buckets_mask + 1, home_bucket,
                };
                return itr;
            }
            u16 displacement = table.metadata[bucket] & 0x07FF;
            if displacement == 0x07FF {
                break;
            }
            bucket = home_bucket + vt_quadratic(displacement) & table.buckets_mask;
        }
    }
    u64 empty;
    u16 displacement;
    if cast(f64, table.key_count + 1) > cast(f64, b3NameMap_bucket_count(table)) * 0.9 || !b3NameMap_find_first_empty(table, home_bucket, &empty, &displacement) {
        return b3NameMap_end_itr();
    }
    u64 prev = b3NameMap_find_insert_location_in_chain(table, home_bucket, displacement);
    table.buckets[empty].key = key;
    table.buckets[empty].val = *val;
    table.metadata[empty] = hashfrag | table.metadata[prev] & 0x07FF;
    table.metadata[prev] = cast(u16, table.metadata[prev] & ~0x07FF | displacement);
    ++table.key_count;
    var itr = b3NameMap_itr{
        table.buckets + empty, table.metadata + empty, table.metadata + table.buckets_mask + 1,
        home_bucket,
    };
    return itr;
}

// Resizes the bucket array.
// This function assumes that bucket_count is a power of two and large enough to accommodate all keys without violating
// the maximum load factor.
// Returns false in the case of allocation failure.
// As this function is called very rarely in _insert and _get_or_insert, ideally it should not be inlined into those
// functions.
// In testing, the no-inline approach showed a performance benefit when inserting existing keys (i.e. replacing).
bool b3NameMap_rehash(b3NameMap* table, u64 bucket_count) {
    while true {
        var new_table = b3NameMap{0, bucket_count - 1, null, null};
        void* allocation = b3Alloc(b3NameMap_total_alloc_size(&new_table));
        if allocation == null {
            return false;
        }
        new_table.buckets = cast(b3NameMap_bucket*, allocation);
        new_table.metadata = cast(u16*, cast(u8*, allocation) + b3NameMap_metadata_offset(&new_table));
        memset(new_table.metadata, 0x00, (bucket_count + 4) * cast(u64, sizeof(u16)));
        new_table.metadata[bucket_count] = 0x01;
        for u64 bucket = 0; bucket < b3NameMap_bucket_count(table); ++bucket {
            if table.metadata[bucket] != 0x0000 {
                b3NameMap_itr itr = b3NameMap_insert_raw(&new_table, table.buckets[bucket].key, &table.buckets[bucket].val, true, false);
                if b3NameMap_is_end(itr) != 0 {
                    break;
                }
            }
        }
        if new_table.key_count < table.key_count {
            b3Free(new_table.buckets, b3NameMap_total_alloc_size(&new_table));
            bucket_count *= 2;
            continue;
        }
        if table.buckets_mask != 0 {
            b3Free(table.buckets, b3NameMap_total_alloc_size(table));
        }
        *table = new_table;
        return true;
    }
}

// Inserts a key, replacing the existing key if it already exists.
// This function wraps insert_raw in a loop that handles growing and rehashing the table if a new key cannot be inserted
// because of the maximum load factor or displacement limit constraints.
// Returns an iterator to the inserted key, or an end iterator in the case of allocation failure.
b3NameMap_itr b3NameMap_insert(b3NameMap* table, u32 key, i32 val) {
    while true {
        b3NameMap_itr itr = b3NameMap_insert_raw(table, key, &val, false, true);
        if !b3NameMap_is_end(itr) || !b3NameMap_rehash(table, table.buckets_mask != 0 ? b3NameMap_bucket_count(table) * 2 : 8) {
            return itr;
        }
    }
}

// Same as NAME_insert, except that if the key already exists, no insertion occurs and the function returns an iterator
// to the existing key.
b3NameMap_itr b3NameMap_get_or_insert(b3NameMap* table, u32 key, i32 val) {
    while true {
        b3NameMap_itr itr = b3NameMap_insert_raw(table, key, &val, false, false);
        if !b3NameMap_is_end(itr) || !b3NameMap_rehash(table, table.buckets_mask != 0 ? b3NameMap_bucket_count(table) * 2 : 8) {
            return itr;
        }
    }
}

// Returns an iterator pointing to the specified key, or an end iterator if the key does not exist.
b3NameMap_itr b3NameMap_get(b3NameMap* table, u32 key) {
    u64 hash = vt_hash_integer(key);
    u64 home_bucket = hash & table.buckets_mask;
    if (table.metadata[home_bucket] & 0x0800) == 0 {
        return b3NameMap_end_itr();
    }
    u16 hashfrag = vt_hashfrag(hash);
    u64 bucket = home_bucket;
    while true {
        if (table.metadata[bucket] & 0xF000) == hashfrag && vt_cmpr_integer(table.buckets[bucket].key, key) {
            var itr = b3NameMap_itr{
                table.buckets + bucket, table.metadata + bucket,
                table.metadata + table.buckets_mask + 1, home_bucket,
            };
            return itr;
        }
        u16 displacement = table.metadata[bucket] & 0x07FF;
        if displacement == 0x07FF {
            return b3NameMap_end_itr();
        }
        bucket = home_bucket + vt_quadratic(displacement) & table.buckets_mask;
    }
}

// Erases the key pointed to by the specified iterator.
// The erasure always occurs at the end of the chain to which the key belongs.
// If the key to be erased is not the last in the chain, it is swapped with the last so that erasure occurs at the end.
// This helps keep a chain's keys close to their home bucket for the sake of cache locality.
// Returns true if, in the case of iteration from first to end, NAME_next should now be called on the iterator to find
// the next key.
// This return value is necessary because at the iterator location, the erasure could result in an empty bucket, a
// bucket containing a moved key already visited during the iteration, or a bucket containing a moved key not yet
// visited.
bool b3NameMap_erase_itr_raw(b3NameMap* table, b3NameMap_itr itr) {
    --table.key_count;
    var itr_bucket = cast(u64, cast(i64, itr.metadatum - table.metadata));
    if table.metadata[itr_bucket] & 0x0800 && (table.metadata[itr_bucket] & 0x07FF) == 0x07FF {
        table.metadata[itr_bucket] = 0x0000;
        return true;
    }
    if itr.home_bucket == SIZE_MAX {
        if (table.metadata[itr_bucket] & 0x0800) != 0 {
            itr.home_bucket = itr_bucket;
        } else {
            itr.home_bucket = vt_hash_integer(table.buckets[itr_bucket].key) & table.buckets_mask;
        }
    }
    if (table.metadata[itr_bucket] & 0x07FF) == 0x07FF {
        u64 bucket = itr.home_bucket;
        while true {
            u16 displacement = table.metadata[bucket] & 0x07FF;
            u64 next = itr.home_bucket + vt_quadratic(displacement) & table.buckets_mask;
            if next == itr_bucket {
                table.metadata[bucket] |= 0x07FF;
                table.metadata[itr_bucket] = 0x0000;
                return true;
            }
            bucket = next;
        }
    }
    u64 bucket = itr_bucket;
    while true {
        u64 prev = bucket;
        bucket = itr.home_bucket + vt_quadratic(table.metadata[bucket] & 0x07FF) & table.buckets_mask;
        if (table.metadata[bucket] & 0x07FF) == 0x07FF {
            table.buckets[itr_bucket] = table.buckets[bucket];
            table.metadata[itr_bucket] = cast(u16, table.metadata[itr_bucket] & ~0xF000 | table.metadata[bucket] & 0xF000);
            table.metadata[prev] |= 0x07FF;
            table.metadata[bucket] = 0x0000;
            if bucket > itr_bucket {
                return false;
            }
            return true;
        }
    }
}

// Erases the specified key, if it exists.
// Returns true if a key was erased.
bool b3NameMap_erase(b3NameMap* table, u32 key) {
    b3NameMap_itr itr = b3NameMap_get(table, key);
    if b3NameMap_is_end(itr) != 0 {
        return false;
    }
    b3NameMap_erase_itr_raw(table, itr);
    return true;
}

// Finds the first occupied bucket at or after the bucket pointed to by itr.
// This function scans four buckets at a time, ideally using intrinsics.
void b3NameMap_fast_forward(b3NameMap_itr* itr) {
    while true {
        u64 metadata;
        memcpy(&metadata, itr.metadatum, sizeof(u64));
        if metadata != 0 {
            i32 offset = vt_first_nonzero_uint16(metadata);
            itr.data += offset;
            itr.metadatum += offset;
            itr.home_bucket = SIZE_MAX;
            return;
        }
        itr.data += 4;
        itr.metadatum += 4;
    }
}

b3NameMap_itr b3NameMap_next(b3NameMap_itr itr) {
    ++itr.data;
    ++itr.metadatum;
    b3NameMap_fast_forward(&itr);
    return itr;
}

// Returns the minimum bucket count required to accommodate a certain number of keys, which is governed by the maximum
// load factor.
u64 b3NameMap_min_bucket_count_for_size(u64 size) {
    if size == 0 {
        return 0;
    }
    u64 bucket_count = 8;
    while cast(f64, size) > cast(f64, bucket_count) * 0.9 {
        bucket_count *= 2;
    }
    return bucket_count;
}

bool b3NameMap_reserve(b3NameMap* table, u64 size) {
    u64 bucket_count = b3NameMap_min_bucket_count_for_size(size);
    if bucket_count <= b3NameMap_bucket_count(table) {
        return true;
    }
    return b3NameMap_rehash(table, bucket_count);
}

bool b3NameMap_shrink(b3NameMap* table) {
    u64 bucket_count = b3NameMap_min_bucket_count_for_size(table.key_count);
    if bucket_count == b3NameMap_bucket_count(table) {
        return true;
    }
    if bucket_count == 0 {
        b3Free(table.buckets, b3NameMap_total_alloc_size(table));
        table.buckets_mask = 0x0000000000000000;
        table.metadata = &vt_empty_placeholder_metadatum;
        return true;
    }
    return b3NameMap_rehash(table, bucket_count);
}

b3NameMap_itr b3NameMap_first(b3NameMap* table) {
    if table.key_count == 0 {
        return b3NameMap_end_itr();
    }
    var itr = b3NameMap_itr{
        table.buckets, table.metadata, table.metadata + table.buckets_mask + 1, SIZE_MAX,
    };
    b3NameMap_fast_forward(&itr);
    return itr;
}

void b3NameMap_clear(b3NameMap* table) {
    if table.key_count == 0 {
        return;
    }
    for u64 i = 0; i < b3NameMap_bucket_count(table); ++i {
        if table.metadata[i] != 0x0000 {
        }
        table.metadata[i] = 0x0000;
    }
    table.key_count = 0;
}

void b3NameMap_cleanup(b3NameMap* table) {
    if table.buckets_mask == 0 {
        return;
    }
    when defined(KEY_DTOR_FN) || defined(VAL_DTOR_FN) {
        b3NameMap_clear(table);
    }
    b3Free(table.buckets, b3NameMap_total_alloc_size(table));
    b3NameMap_init(table);
}
}
}

// This is designed to hash small strings and while avoiding collisions
// for a 32-bit hash.
// Note: changing this will break recordings
u32 b3Hash32(void* data, u64 length) {
    u8* p = data;
    u32 h = 0x811c9dc5;
    for u64 i = 0; i < length; ++i {
        h ^= p[i];
        h *= 0x01000193;
    }
    h ^= h >> 16;
    h *= 0x85ebca6b;
    h ^= h >> 13;
    h *= 0xc2b2ae35;
    h ^= h >> 16;
    return h;
}

b3NameCache b3CreateNameCache() {
    b3NameCache cache;
    while true {
        cache.entries.data = null;
        cache.entries.count = 0;
        cache.entries.capacity = 0;
        if !(0 != 0) { break; }
    }
    b3NameMap* map = b3Alloc(cast(u64, sizeof(b3NameMap)));
    b3NameMap_init(map);
    cache.map = map;
    return cache;
}

void b3DestroyNameCache(b3NameCache* cache) {
    i32 count = cache.entries.count;
    for i32 i = 0; i < count; ++i {
        b3NameEntry* entry = cache.entries.data + i;
        b3Free(entry.name, cast(u64, entry.length + 1));
    }
    while true {
        b3Free(cache.entries.data, cast(u64, cache.entries.capacity * sizeof(*cache.entries.data)));
        cache.entries.data = null;
        cache.entries.count = 0;
        cache.entries.capacity = 0;
        if !(0 != 0) { break; }
    }
    b3NameMap_cleanup(cast(b3NameMap*, cache.map));
    b3Free(cache.map, cast(u64, sizeof(b3NameMap)));
}

u32 b3AddName(b3NameCache* cache, u8* name) {
    if name == null || name[0] == 0 {
        return 0;
    }
    u64 length = strlen(name);
    u32 id = b3Hash32(name, length);
    id = cast(u32, id == 0 ? 1 : id);
    b3NameMap* map = cache.map;
    b3NameMap_itr itr = b3NameMap_get(map, id);
    if b3NameMap_is_end(itr) == false {
        if strcmp(cache.entries.data[itr.data.val].name, name) != 0 {
            b3Log("Hash collision on %s", name);
        }
        return id;
    }
    u8* clone = b3Alloc(length + 1);
    memcpy(clone, name, length + 1);
    i32 index = cache.entries.count;
    var entry = b3NameEntry{.hash = id, .name = clone, .length = cast(i32, length)};
    while true {
        if cache.entries.count >= cache.entries.capacity {
            var oldSize = cast(i32, cache.entries.capacity * sizeof(*cache.entries.data));
            i32 newCapacity = cache.entries.capacity == 0 ? 8 : 2 * cache.entries.capacity;
            var newSize = cast(i32, newCapacity * sizeof(*cache.entries.data));
            cache.entries.data = b3GrowAlloc(cache.entries.data, oldSize, newSize);
            cache.entries.capacity = newCapacity;
        }
        cache.entries.data[cache.entries.count++] = entry;
        if !(0 != 0) { break; }
    }
    b3NameMap_insert(map, id, index);
    return id;
}

u8* b3FindName(b3NameCache* cache, u32 id) {
    b3NameMap* map = cache.map;
    b3NameMap_itr itr = b3NameMap_get(map, id);
    if b3NameMap_is_end(itr) == false {
        i32 index = itr.data.val;
        b3NameEntry* entry = cache.entries.data + index;
        return entry.name;
    }
    return null;
}

void b3LoadName(b3NameCache* cache, u32 id, u8* name, i32 length) {
    if name == null {
        return;
    }
    if name[0] == 0 || id == 0 {
        b3Free(name, cast(u64, length + 1));
        return;
    }
    b3NameMap* map = cache.map;
    b3NameMap_itr itr = b3NameMap_get(map, id);
    if b3NameMap_is_end(itr) == false {
        b3Free(name, cast(u64, length + 1));
        return;
    }
    i32 index = cache.entries.count;
    var entry = b3NameEntry{.hash = id, .name = name, .length = length};
    while true {
        if cache.entries.count >= cache.entries.capacity {
            var oldSize = cast(i32, cache.entries.capacity * sizeof(*cache.entries.data));
            i32 newCapacity = cache.entries.capacity == 0 ? 8 : 2 * cache.entries.capacity;
            var newSize = cast(i32, newCapacity * sizeof(*cache.entries.data));
            cache.entries.data = b3GrowAlloc(cache.entries.data, oldSize, newSize);
            cache.entries.capacity = newCapacity;
        }
        cache.entries.data[cache.entries.count++] = entry;
        if !(0 != 0) { break; }
    }
    b3NameMap_insert(map, id, index);
}

private {
void b3ParallelForTrampoline(void* taskContext) {
    var task = cast(b3ParallelForTask*, taskContext);
    b3ParallelForShared* shared = task.shared;
    i32 workerIndex = task.workerIndex;
    void* context = shared.context;
    b3ParallelForCallback callback = shared.callback;
    i32 blockCount = shared.blockCount;
    i32 blockSize = shared.blockSize;
    i32 itemCount = shared.itemCount;
    while true {
        i32 blockIndex = b3AtomicFetchAddInt(&shared.nextBlock, 1);
        if blockIndex >= blockCount {
            break;
        }
        i32 start = blockIndex * blockSize;
        i32 end = start + blockSize;
        if end > itemCount {
            end = itemCount;
        }
        callback(start, end, workerIndex, context);
    }
}
}

void b3ParallelFor(b3World* world, b3ParallelForCallback callback, i32 itemCount, i32 minRange, void* context, u8* name) {
    if itemCount <= 0 {
        return;
    }
    i32 workerCount = world.workerCount;
    i32 blocksPerWorker = 32;
    i32 maxBlockCount = blocksPerWorker * workerCount;
    i32 blockSize;
    i32 blockCount;
    if itemCount <= minRange * maxBlockCount {
        blockSize = minRange;
        blockCount = (itemCount + blockSize - 1) / blockSize;
    } else {
        blockSize = (itemCount + maxBlockCount - 1) / maxBlockCount;
        blockCount = (itemCount + blockSize - 1) / blockSize;
    }
    i32 taskCount = workerCount < blockCount ? workerCount : blockCount;
    noinit b3ParallelForShared shared;
    shared.blockCount = blockCount;
    shared.blockSize = blockSize;
    shared.itemCount = itemCount;
    shared.callback = callback;
    shared.context = context;
    b3AtomicStoreInt(&shared.nextBlock, 0);
    noinit b3ParallelForTask[32] tasks;
    noinit void*[32] handles;
    for i32 i = 0; i < taskCount; ++i {
        tasks[i].shared = &shared;
        tasks[i].workerIndex = i;
        if world.taskCount < 256 {
            handles[i] = world.enqueueTaskFcn(&b3ParallelForTrampoline, tasks + i, world.userTaskContext, name);
            world.taskCount += 1;
        } else {
            handles[i] = null;
            b3ParallelForTrampoline(tasks + i);
        }
    }
    for i32 i = 0; i < taskCount; ++i {
        if handles[i] != null {
            world.finishTaskFcn(handles[i], world.userTaskContext);
        }
    }
}

// SPDX-FileCopyrightText: 2025 Erin Catto
// SPDX-License-Identifier: MIT
// needed for dll export
void b3ParallelJoint_SetSpringHertz(b3JointId jointId, f32 hertz) {
    b3World* world = b3GetWorld(cast(i32, jointId.world0));
    while true {
        if world.recording != null {
            var recArgs = b3RecArgs_ParallelJointSetSpringHertz{jointId, hertz};
            b3RecWrite_ParallelJointSetSpringHertz(world.recording, &recArgs);
        }
        if !(0 != 0) { break; }
    }
    b3JointSim* base = b3GetJointSimCheckType(jointId, b3_parallelJoint);
    base.parallelJoint.hertz = hertz;
}

f32 b3ParallelJoint_GetSpringHertz(b3JointId jointId) {
    b3JointSim* base = b3GetJointSimCheckType(jointId, b3_parallelJoint);
    return base.parallelJoint.hertz;
}

void b3ParallelJoint_SetSpringDampingRatio(b3JointId jointId, f32 dampingRatio) {
    b3World* world = b3GetWorld(cast(i32, jointId.world0));
    while true {
        if world.recording != null {
            var recArgs = b3RecArgs_ParallelJointSetSpringDampingRatio{jointId, dampingRatio};
            b3RecWrite_ParallelJointSetSpringDampingRatio(world.recording, &recArgs);
        }
        if !(0 != 0) { break; }
    }
    b3JointSim* base = b3GetJointSimCheckType(jointId, b3_parallelJoint);
    base.parallelJoint.dampingRatio = dampingRatio;
}

f32 b3ParallelJoint_GetSpringDampingRatio(b3JointId jointId) {
    b3JointSim* base = b3GetJointSimCheckType(jointId, b3_parallelJoint);
    return base.parallelJoint.dampingRatio;
}

void b3ParallelJoint_SetMaxTorque(b3JointId jointId, f32 maxForce) {
    b3World* world = b3GetWorld(cast(i32, jointId.world0));
    while true {
        if world.recording != null {
            var recArgs = b3RecArgs_ParallelJointSetMaxTorque{jointId, maxForce};
            b3RecWrite_ParallelJointSetMaxTorque(world.recording, &recArgs);
        }
        if !(0 != 0) { break; }
    }
    b3JointSim* base = b3GetJointSimCheckType(jointId, b3_parallelJoint);
    base.parallelJoint.maxTorque = maxForce;
}

f32 b3ParallelJoint_GetMaxTorque(b3JointId jointId) {
    b3JointSim* base = b3GetJointSimCheckType(jointId, b3_parallelJoint);
    return base.parallelJoint.maxTorque;
}

b3Vec3 b3GetParallelJointTorque(b3World* world, b3JointSim* base) {
    b3ParallelJoint* joint = &base.parallelJoint;
    b3Quat relQ = b3InvMulQuat(joint.quatA, joint.quatB);
    joint.perpAxisX = b3MulSV(0.5f, b3RotateVector(joint.quatA, b3Add(b3MulSV(relQ.s, b3Vec3_axisX), b3Cross(relQ.v, b3Vec3_axisX))));
    joint.perpAxisY = b3MulSV(0.5f, b3RotateVector(joint.quatA, b3Add(b3MulSV(relQ.s, b3Vec3_axisY), b3Cross(relQ.v, b3Vec3_axisY))));
    b3Vec3 angularImpulse = b3Blend2(joint.perpImpulse.x, joint.perpAxisX, joint.perpImpulse.y, joint.perpAxisY);
    b3Vec3 torque = b3MulSV(world.inv_h, angularImpulse);
    return torque;
}

void b3PrepareParallelJoint(b3JointSim* base, b3StepContext* context) {
    b3World* world = context.world;
    b3Body* bodyA = world.bodies.data + base.bodyIdA;
    b3Body* bodyB = world.bodies.data + base.bodyIdB;
    b3SolverSet* setA = world.solverSets.data + bodyA.setIndex;
    b3SolverSet* setB = world.solverSets.data + bodyB.setIndex;
    i32 localIndexA = bodyA.localIndex;
    i32 localIndexB = bodyB.localIndex;
    b3BodySim* bodySimA = setA.bodySims.data + localIndexA;
    b3BodySim* bodySimB = setB.bodySims.data + localIndexB;
    base.invMassA = bodySimA.invMass;
    base.invMassB = bodySimB.invMass;
    base.invIA = bodySimA.invInertiaWorld;
    base.invIB = bodySimB.invInertiaWorld;
    b3Matrix3 invInertiaSum = b3AddMM(base.invIA, base.invIB);
    base.fixedRotation = b3Det(invInertiaSum) < 1000.0f * FLT_MIN;
    b3ParallelJoint* joint = &base.parallelJoint;
    joint.indexA = bodyA.setIndex == b3_awakeSet ? localIndexA : -1;
    joint.indexB = bodyB.setIndex == b3_awakeSet ? localIndexB : -1;
    joint.quatA = b3MulQuat(bodySimA.transform.q, base.localFrameA.q);
    joint.quatB = b3MulQuat(bodySimB.transform.q, base.localFrameB.q);
    b3Quat relQ = b3InvMulQuat(joint.quatA, joint.quatB);
    {
        joint.perpAxisX = b3MulSV(0.5f, b3RotateVector(joint.quatA, b3Add(b3MulSV(relQ.s, b3Vec3_axisX), b3Cross(relQ.v, b3Vec3_axisX))));
        joint.perpAxisY = b3MulSV(0.5f, b3RotateVector(joint.quatA, b3Add(b3MulSV(relQ.s, b3Vec3_axisY), b3Cross(relQ.v, b3Vec3_axisY))));
    }
    joint.softness = b3MakeSoft(joint.hertz, joint.dampingRatio, context.h);
    if context.enableWarmStarting == false {
        joint.perpImpulse = b3Vec2{0.0f, 0.0f};
    }
}

void b3WarmStartParallelJoint(b3JointSim* base, b3StepContext* context) {
    b3Matrix3 iA = base.invIA;
    b3Matrix3 iB = base.invIB;
    b3BodyState dummyState = b3_identityBodyState;
    b3ParallelJoint* joint = &base.parallelJoint;
    b3BodyState* stateA = joint.indexA == -1 ? &dummyState : context.states + joint.indexA;
    b3BodyState* stateB = joint.indexB == -1 ? &dummyState : context.states + joint.indexB;
    b3Vec3 wA = stateA.angularVelocity;
    b3Vec3 wB = stateB.angularVelocity;
    b3Vec3 angularImpulse = b3Blend2(joint.perpImpulse.x, joint.perpAxisX, joint.perpImpulse.y, joint.perpAxisY);
    wA = b3Sub(wA, b3MulMV(iA, angularImpulse));
    wB = b3Add(wB, b3MulMV(iB, angularImpulse));
    if (stateA.flags & cast(u32, b3_dynamicFlag)) != 0 {
        stateA.angularVelocity = wA;
    }
    if (stateB.flags & cast(u32, b3_dynamicFlag)) != 0 {
        stateB.angularVelocity = wB;
    }
}

void b3SolveParallelJoint(b3JointSim* base, b3StepContext* context) {
    b3Matrix3 iA = base.invIA;
    b3Matrix3 iB = base.invIB;
    b3BodyState dummyState = b3_identityBodyState;
    b3ParallelJoint* joint = &base.parallelJoint;
    b3BodyState* stateA = joint.indexA == -1 ? &dummyState : context.states + joint.indexA;
    b3BodyState* stateB = joint.indexB == -1 ? &dummyState : context.states + joint.indexB;
    b3Vec3 wA = stateA.angularVelocity;
    b3Vec3 wB = stateB.angularVelocity;
    bool fixedRotation = base.fixedRotation;
    b3Quat quatA = b3MulQuat(stateA.deltaRotation, joint.quatA);
    b3Quat quatB = b3MulQuat(stateB.deltaRotation, joint.quatB);
    if b3DotQuat(quatA, quatB) < 0.0f {
        quatB = b3NegateQuat(quatB);
    }
    b3Quat relQ = b3InvMulQuat(quatA, quatB);
    if fixedRotation == false && joint.maxTorque > 0.0f {
        var c = b3Vec2{relQ.v.x, relQ.v.y};
        var bias = b3Vec2{joint.softness.biasRate * c.x, joint.softness.biasRate * c.y};
        f32 massScale = joint.softness.massScale;
        f32 impulseScale = joint.softness.impulseScale;
        b3Vec3 perpAxisX = b3MulSV(0.5f, b3RotateVector(quatA, b3Add(b3MulSV(relQ.s, b3Vec3_axisX), b3Cross(relQ.v, b3Vec3_axisX))));
        b3Vec3 perpAxisY = b3MulSV(0.5f, b3RotateVector(quatA, b3Add(b3MulSV(relQ.s, b3Vec3_axisY), b3Cross(relQ.v, b3Vec3_axisY))));
        joint.perpAxisX = perpAxisX;
        joint.perpAxisY = perpAxisY;
        b3Matrix3 invInertiaSum = b3AddMM(iA, iB);
        f32 kxx = b3Dot(perpAxisX, b3MulMV(invInertiaSum, perpAxisX));
        f32 kyy = b3Dot(perpAxisY, b3MulMV(invInertiaSum, perpAxisY));
        f32 kxy = b3Dot(perpAxisX, b3MulMV(invInertiaSum, perpAxisY));
        var k = b3Matrix2{b3Vec2{kxx, kxy}, b3Vec2{kxy, kyy}};
        b3Vec3 wRel = b3Sub(wB, wA);
        var cdot = b3Vec2{b3Dot(wRel, perpAxisX), b3Dot(wRel, perpAxisY)};
        f32 maxImpulse = context.h * joint.maxTorque;
        b3Vec2 oldImpulse = joint.perpImpulse;
        var cdotPlusBias = b3Vec2{cdot.x + bias.x, cdot.y + bias.y};
        b3Vec2 sol = b3Solve2(k, cdotPlusBias);
        var deltaImpulse = b3Vec2{
            -massScale * sol.x - impulseScale * oldImpulse.x,
            -massScale * sol.y - impulseScale * oldImpulse.y,
        };
        joint.perpImpulse = b3Vec2{oldImpulse.x + deltaImpulse.x, oldImpulse.y + deltaImpulse.y};
        if b3LengthSquared2(joint.perpImpulse) > maxImpulse * maxImpulse {
            f32 s = maxImpulse / b3Length2(joint.perpImpulse);
            joint.perpImpulse = b3Vec2{s * joint.perpImpulse.x, s * joint.perpImpulse.y};
        }
        deltaImpulse = b3Sub2(joint.perpImpulse, oldImpulse);
        b3Vec3 angularImpulse = b3Blend2(deltaImpulse.x, perpAxisX, deltaImpulse.y, perpAxisY);
        wA = b3Sub(wA, b3MulMV(iA, angularImpulse));
        wB = b3Add(wB, b3MulMV(iB, angularImpulse));
    }
    if (stateA.flags & cast(u32, b3_dynamicFlag)) != 0 {
        stateA.angularVelocity = wA;
    }
    if (stateB.flags & cast(u32, b3_dynamicFlag)) != 0 {
        stateB.angularVelocity = wB;
    }
}

void b3DrawParallelJoint(b3DebugDraw* draw, b3JointSim* base, b3WorldTransform transformA, b3WorldTransform transformB, f32 scale) {
    f32 length = 0.1f * scale;
    b3WorldTransform frameA = b3MulWorldTransforms(transformA, base.localFrameA);
    draw.DrawSegmentFcn(frameA.p, b3OffsetPos(frameA.p, b3MulSV(length, b3RotateVector(frameA.q, b3Vec3_axisZ))), b3_colorGreen, draw.context);
    b3WorldTransform frameB = b3MulWorldTransforms(transformB, base.localFrameB);
    draw.DrawSegmentFcn(frameB.p, b3OffsetPos(frameB.p, b3MulSV(length, b3RotateVector(frameB.q, b3Vec3_axisZ))), b3_colorBlue, draw.context);
}

// SPDX-FileCopyrightText: 2025 Erin Catto
// SPDX-License-Identifier: MIT
// https://en.wikipedia.org/wiki/Find_first_set
private {
u32 b3CTZ32(u32 block) {
    u32 index;
    _BitScanForward(&index, block);
    return index;
}

// This function doesn't need to be fast, so using the Ivy Bridge fallback.
u32 b3CLZ32(u32 value) {
    u32 index;
    if _BitScanReverse(&index, value) != 0 {
        return 31 - index;
    } else {
        return 32;
    }
}

u32 b3CTZ64(u64 block) {
    u32 index;
    _BitScanForward64(&index, block);
    return index;
}

i32 b3PopCount64(u64 block) {
    return cast(i32, __popcnt64(block));
}

bool b3IsPowerOf2(i32 x) {
    return (x & x - 1) == 0;
}

i32 b3BoundingPowerOf2(i32 x) {
    if x <= 1 {
        return 1;
    }
    return 32 - cast(i32, b3CLZ32(cast(u32, x) - 1));
}

i32 b3RoundUpPowerOf2(i32 x) {
    if x <= 1 {
        return 1;
    }
    return 1 << 32 - cast(i32, b3CLZ32(cast(u32, x) - 1));
}

i32 b3LowerPowerOf2Exponent(i32 x) {
    var clz = cast(i32, b3CLZ32(cast(u32, x)));
    return 31 - clz;
}
}
b3World[128] b3_worlds;
b3AtomicInt b3_worldCount;
i32 b3_maxWorldCount;

b3HullData* b3AddHullToDatabase(b3World* world, b3HullData* src) {
    b3HullMap* database = world.hullDatabase;
    b3HullMap_itr itr = b3HullMap_get(database, src);
    if b3HullMap_is_end(itr) == false {
        itr.data.val += 1;
        return itr.data.key;
    }
    b3HullData* owned = b3CloneHull(src);
    b3HullMap_insert(database, owned, 1);
    return owned;
}

b3HullData* b3AddOwnedHullToDatabase(b3World* world, b3HullData* owned) {
    b3HullMap* database = world.hullDatabase;
    b3HullMap_itr itr = b3HullMap_get(database, owned);
    if b3HullMap_is_end(itr) == false {
        itr.data.val += 1;
        b3DestroyHull(owned);
        return itr.data.key;
    }
    b3HullMap_insert(database, owned, 1);
    return owned;
}

void b3RemoveHullFromDatabase(b3World* world, b3HullData* data) {
    b3HullMap* database = world.hullDatabase;
    b3HullMap_itr itr = b3HullMap_get(database, data);
    if --itr.data.val == 0 {
        var owned = itr.data.key;
        b3HullMap_erase_itr(database, itr);
        b3DestroyHull(owned);
    }
}

b3World* b3GetUnlockedWorldFromId(b3WorldId id) {
    b3World* world = b3_worlds + (id.index1 - 1);
    if world.locked != 0 {
        return null;
    }
    return world;
}

b3World* b3GetWorldFromId(b3WorldId id) {
    b3World* world = b3_worlds + (id.index1 - 1);
    return world;
}

b3World* b3GetWorld(i32 index) {
    b3World* world = b3_worlds + index;
    return world;
}

b3World* b3GetUnlockedWorld(i32 index) {
    b3World* world = b3_worlds + index;
    if world.locked != 0 {
        return null;
    }
    return world;
}

private {
void* b3DefaultAddTaskFcn(b3TaskCallback task, void* taskContext, void* userContext, u8* name) {
    ignore userContext;
    ignore name;
    task(taskContext);
    return null;
}

void b3DefaultFinishTaskFcn(void* userTask, void* userContext) {
    ignore userTask;
    ignore userContext;
}

f32 b3DefaultFrictionCallback(f32 frictionA, u64 materialA, f32 frictionB, u64 materialB) {
    ignore materialA;
    ignore materialB;
    return cast(f32, sqrtf(frictionA * frictionB));
}

f32 b3DefaultRestitutionCallback(f32 restitutionA, u64 materialA, f32 restitutionB, u64 materialB) {
    ignore materialA;
    ignore materialB;
    return b3MaxFloat(restitutionA, restitutionB);
}

void b3CreateWorkerContexts(b3World* world) {
    while true {
        while true {
            if world.taskContexts.capacity < world.workerCount {
                var oldSize = cast(i32, world.taskContexts.capacity * sizeof(*world.taskContexts.data));
                var newSize = cast(i32, world.workerCount * sizeof(*world.taskContexts.data));
                world.taskContexts.data = b3GrowAlloc(world.taskContexts.data, oldSize, newSize);
                world.taskContexts.capacity = world.workerCount;
            }
            if !(0 != 0) { break; }
        }
        world.taskContexts.count = world.workerCount;
        if !(0 != 0) { break; }
    }
    while true {
        if world.taskContexts.capacity > 0 {
            memset(world.taskContexts.data, 0, cast(u64, world.taskContexts.capacity * sizeof(*world.taskContexts.data)));
        }
        if !(0 != 0) { break; }
    }
    while true {
        while true {
            if world.sensorTaskContexts.capacity < world.workerCount {
                var oldSize = cast(i32, world.sensorTaskContexts.capacity * sizeof(*world.sensorTaskContexts.data));
                var newSize = cast(i32, world.workerCount * sizeof(*world.sensorTaskContexts.data));
                world.sensorTaskContexts.data = b3GrowAlloc(world.sensorTaskContexts.data, oldSize, newSize);
                world.sensorTaskContexts.capacity = world.workerCount;
            }
            if !(0 != 0) { break; }
        }
        world.sensorTaskContexts.count = world.workerCount;
        if !(0 != 0) { break; }
    }
    while true {
        if world.sensorTaskContexts.capacity > 0 {
            memset(world.sensorTaskContexts.data, 0, cast(u64, world.sensorTaskContexts.capacity * sizeof(*world.sensorTaskContexts.data)));
        }
        if !(0 != 0) { break; }
    }
    for i32 i = 0; i < world.workerCount; ++i {
        world.taskContexts.data[i].arena = b3CreateArena(128 * 1024);
        while true {
            if world.taskContexts.data[i].sensorHits.capacity < 8 {
                var oldSize = cast(i32, world.taskContexts.data[i].sensorHits.capacity * sizeof(*world.taskContexts.data[i].sensorHits.data));
                var newSize = cast(i32, 8 * sizeof(*world.taskContexts.data[i].sensorHits.data));
                world.taskContexts.data[i].sensorHits.data = b3GrowAlloc(world.taskContexts.data[i].sensorHits.data, oldSize, newSize);
                world.taskContexts.data[i].sensorHits.capacity = 8;
            }
            if !(0 != 0) { break; }
        }
        world.taskContexts.data[i].contactStateBitSet = b3CreateBitSet(1024);
        world.taskContexts.data[i].hitEventBitSet = b3CreateBitSet(1024);
        world.taskContexts.data[i].hasHitEvents = false;
        world.taskContexts.data[i].jointStateBitSet = b3CreateBitSet(1024);
        world.taskContexts.data[i].enlargedSimBitSet = b3CreateBitSet(256);
        world.taskContexts.data[i].awakeIslandBitSet = b3CreateBitSet(256);
        world.taskContexts.data[i].splitIslandId = -1;
        world.sensorTaskContexts.data[i].eventBits = b3CreateBitSet(128);
    }
}

void b3DestroyWorkerContexts(b3World* world) {
    for i32 i = 0; i < world.workerCount; ++i {
        b3DestroyArena(&world.taskContexts.data[i].arena);
        while true {
            b3Free(world.taskContexts.data[i].sensorHits.data, cast(u64, world.taskContexts.data[i].sensorHits.capacity * sizeof(*world.taskContexts.data[i].sensorHits.data)));
            world.taskContexts.data[i].sensorHits.data = null;
            world.taskContexts.data[i].sensorHits.count = 0;
            world.taskContexts.data[i].sensorHits.capacity = 0;
            if !(0 != 0) { break; }
        }
        b3DestroyBitSet(&world.taskContexts.data[i].contactStateBitSet);
        b3DestroyBitSet(&world.taskContexts.data[i].hitEventBitSet);
        b3DestroyBitSet(&world.taskContexts.data[i].jointStateBitSet);
        b3DestroyBitSet(&world.taskContexts.data[i].enlargedSimBitSet);
        b3DestroyBitSet(&world.taskContexts.data[i].awakeIslandBitSet);
        b3DestroyBitSet(&world.sensorTaskContexts.data[i].eventBits);
    }
    while true {
        b3Free(world.taskContexts.data, cast(u64, world.taskContexts.capacity * sizeof(*world.taskContexts.data)));
        world.taskContexts.data = null;
        world.taskContexts.count = 0;
        world.taskContexts.capacity = 0;
        if !(0 != 0) { break; }
    }
    while true {
        b3Free(world.sensorTaskContexts.data, cast(u64, world.sensorTaskContexts.capacity * sizeof(*world.sensorTaskContexts.data)));
        world.sensorTaskContexts.data = null;
        world.sensorTaskContexts.count = 0;
        world.sensorTaskContexts.capacity = 0;
        if !(0 != 0) { break; }
    }
}
}

b3WorldId b3CreateWorld(b3WorldDef* def) {
    i32 worldId = -1;
    for i32 i = 0; i < 128; ++i {
        if b3_worlds[i].inUse == false {
            worldId = i;
            break;
        }
    }
    if worldId == -1 {
        b3Log("B3_MAX_WORLDS of %d exceeded!!!", 128);
        return b3WorldId{};
    }
    i32 oldCount = b3AtomicFetchAddInt(&b3_worldCount, 1);
    b3_maxWorldCount = b3MaxInt(b3_maxWorldCount, oldCount + 1);
    b3InitializeContactRegisters();
    b3World* world = b3_worlds + worldId;
    u16 revision = world.generation;
    memset(world, 0, cast(u64, sizeof(b3World)));
    world.worldId = cast(u16, worldId);
    world.generation = revision;
    world.inUse = true;
    world.stack = b3CreateStack(2048);
    while true {
        if world.manifoldAllocators.capacity < 16 {
            var oldSize = cast(i32, world.manifoldAllocators.capacity * sizeof(*world.manifoldAllocators.data));
            var newSize = cast(i32, 16 * sizeof(*world.manifoldAllocators.data));
            world.manifoldAllocators.data = b3GrowAlloc(world.manifoldAllocators.data, oldSize, newSize);
            world.manifoldAllocators.capacity = 16;
        }
        if !(0 != 0) { break; }
    }
    world.manifoldAllocatorMutex = b3CreateMutex();
    b3CreateBroadPhase(&world.broadPhase, &def.capacity);
    b3CreateGraph(&world.constraintGraph, 16);
    world.bodyIdPool = b3CreateIdPool();
    i32 bodyCapacity = b3MaxInt(16, def.capacity.staticBodyCount + def.capacity.dynamicBodyCount);
    while true {
        if world.bodies.capacity < bodyCapacity {
            var oldSize = cast(i32, world.bodies.capacity * sizeof(*world.bodies.data));
            var newSize = cast(i32, bodyCapacity * sizeof(*world.bodies.data));
            world.bodies.data = b3GrowAlloc(world.bodies.data, oldSize, newSize);
            world.bodies.capacity = bodyCapacity;
        }
        if !(0 != 0) { break; }
    }
    while true {
        if world.solverSets.capacity < 8 {
            var oldSize = cast(i32, world.solverSets.capacity * sizeof(*world.solverSets.data));
            var newSize = cast(i32, 8 * sizeof(*world.solverSets.data));
            world.solverSets.data = b3GrowAlloc(world.solverSets.data, oldSize, newSize);
            world.solverSets.capacity = 8;
        }
        if !(0 != 0) { break; }
    }
    world.solverSetIdPool = b3CreateIdPool();
    b3SolverSet set;
    set.setIndex = b3AllocId(&world.solverSetIdPool);
    while true {
        if world.solverSets.count >= world.solverSets.capacity {
            var oldSize = cast(i32, world.solverSets.capacity * sizeof(*world.solverSets.data));
            i32 newCapacity = world.solverSets.capacity == 0 ? 8 : 2 * world.solverSets.capacity;
            var newSize = cast(i32, newCapacity * sizeof(*world.solverSets.data));
            world.solverSets.data = b3GrowAlloc(world.solverSets.data, oldSize, newSize);
            world.solverSets.capacity = newCapacity;
        }
        world.solverSets.data[world.solverSets.count++] = set;
        if !(0 != 0) { break; }
    }
    while true {
        if world.solverSets.data[b3_staticSet].bodySims.capacity < b3MaxInt(16, def.capacity.staticBodyCount) {
            var oldSize = cast(i32, world.solverSets.data[b3_staticSet].bodySims.capacity * sizeof(*world.solverSets.data[b3_staticSet].bodySims.data));
            var newSize = cast(i32, b3MaxInt(16, def.capacity.staticBodyCount) * sizeof(*world.solverSets.data[b3_staticSet].bodySims.data));
            world.solverSets.data[b3_staticSet].bodySims.data = b3GrowAlloc(world.solverSets.data[b3_staticSet].bodySims.data, oldSize, newSize);
            world.solverSets.data[b3_staticSet].bodySims.capacity = b3MaxInt(16, def.capacity.staticBodyCount);
        }
        if !(0 != 0) { break; }
    }
    set.setIndex = b3AllocId(&world.solverSetIdPool);
    while true {
        if world.solverSets.count >= world.solverSets.capacity {
            var oldSize = cast(i32, world.solverSets.capacity * sizeof(*world.solverSets.data));
            i32 newCapacity = world.solverSets.capacity == 0 ? 8 : 2 * world.solverSets.capacity;
            var newSize = cast(i32, newCapacity * sizeof(*world.solverSets.data));
            world.solverSets.data = b3GrowAlloc(world.solverSets.data, oldSize, newSize);
            world.solverSets.capacity = newCapacity;
        }
        world.solverSets.data[world.solverSets.count++] = set;
        if !(0 != 0) { break; }
    }
    set.setIndex = b3AllocId(&world.solverSetIdPool);
    while true {
        if world.solverSets.count >= world.solverSets.capacity {
            var oldSize = cast(i32, world.solverSets.capacity * sizeof(*world.solverSets.data));
            i32 newCapacity = world.solverSets.capacity == 0 ? 8 : 2 * world.solverSets.capacity;
            var newSize = cast(i32, newCapacity * sizeof(*world.solverSets.data));
            world.solverSets.data = b3GrowAlloc(world.solverSets.data, oldSize, newSize);
            world.solverSets.capacity = newCapacity;
        }
        world.solverSets.data[world.solverSets.count++] = set;
        if !(0 != 0) { break; }
    }
    while true {
        if world.solverSets.data[b3_awakeSet].bodySims.capacity < b3MaxInt(16, def.capacity.dynamicBodyCount) {
            var oldSize = cast(i32, world.solverSets.data[b3_awakeSet].bodySims.capacity * sizeof(*world.solverSets.data[b3_awakeSet].bodySims.data));
            var newSize = cast(i32, b3MaxInt(16, def.capacity.dynamicBodyCount) * sizeof(*world.solverSets.data[b3_awakeSet].bodySims.data));
            world.solverSets.data[b3_awakeSet].bodySims.data = b3GrowAlloc(world.solverSets.data[b3_awakeSet].bodySims.data, oldSize, newSize);
            world.solverSets.data[b3_awakeSet].bodySims.capacity = b3MaxInt(16, def.capacity.dynamicBodyCount);
        }
        if !(0 != 0) { break; }
    }
    while true {
        if world.solverSets.data[b3_awakeSet].bodyStates.capacity < b3MaxInt(16, def.capacity.dynamicBodyCount) {
            var oldSize = cast(i32, world.solverSets.data[b3_awakeSet].bodyStates.capacity * sizeof(*world.solverSets.data[b3_awakeSet].bodyStates.data));
            var newSize = cast(i32, b3MaxInt(16, def.capacity.dynamicBodyCount) * sizeof(*world.solverSets.data[b3_awakeSet].bodyStates.data));
            world.solverSets.data[b3_awakeSet].bodyStates.data = b3GrowAlloc(world.solverSets.data[b3_awakeSet].bodyStates.data, oldSize, newSize);
            world.solverSets.data[b3_awakeSet].bodyStates.capacity = b3MaxInt(16, def.capacity.dynamicBodyCount);
        }
        if !(0 != 0) { break; }
    }
    while true {
        if world.solverSets.data[b3_awakeSet].contactIndices.capacity < b3MaxInt(16, def.capacity.contactCount) {
            var oldSize = cast(i32, world.solverSets.data[b3_awakeSet].contactIndices.capacity * sizeof(*world.solverSets.data[b3_awakeSet].contactIndices.data));
            var newSize = cast(i32, b3MaxInt(16, def.capacity.contactCount) * sizeof(*world.solverSets.data[b3_awakeSet].contactIndices.data));
            world.solverSets.data[b3_awakeSet].contactIndices.data = b3GrowAlloc(world.solverSets.data[b3_awakeSet].contactIndices.data, oldSize, newSize);
            world.solverSets.data[b3_awakeSet].contactIndices.capacity = b3MaxInt(16, def.capacity.contactCount);
        }
        if !(0 != 0) { break; }
    }
    world.shapeIdPool = b3CreateIdPool();
    i32 shapeCapacity = b3MaxInt(16, def.capacity.staticShapeCount + def.capacity.dynamicShapeCount);
    while true {
        if world.shapes.capacity < shapeCapacity {
            var oldSize = cast(i32, world.shapes.capacity * sizeof(*world.shapes.data));
            var newSize = cast(i32, shapeCapacity * sizeof(*world.shapes.data));
            world.shapes.data = b3GrowAlloc(world.shapes.data, oldSize, newSize);
            world.shapes.capacity = shapeCapacity;
        }
        if !(0 != 0) { break; }
    }
    world.hullDatabase = b3Alloc(cast(u64, sizeof(b3HullMap)));
    b3HullMap_init(world.hullDatabase);
    world.names = b3CreateNameCache();
    world.contactIdPool = b3CreateIdPool();
    while true {
        if world.contacts.capacity < b3MaxInt(16, def.capacity.contactCount) {
            var oldSize = cast(i32, world.contacts.capacity * sizeof(*world.contacts.data));
            var newSize = cast(i32, b3MaxInt(16, def.capacity.contactCount) * sizeof(*world.contacts.data));
            world.contacts.data = b3GrowAlloc(world.contacts.data, oldSize, newSize);
            world.contacts.capacity = b3MaxInt(16, def.capacity.contactCount);
        }
        if !(0 != 0) { break; }
    }
    world.jointIdPool = b3CreateIdPool();
    while true {
        if world.joints.capacity < 16 {
            var oldSize = cast(i32, world.joints.capacity * sizeof(*world.joints.data));
            var newSize = cast(i32, 16 * sizeof(*world.joints.data));
            world.joints.data = b3GrowAlloc(world.joints.data, oldSize, newSize);
            world.joints.capacity = 16;
        }
        if !(0 != 0) { break; }
    }
    world.islandIdPool = b3CreateIdPool();
    while true {
        if world.islands.capacity < b3MaxInt(16, def.capacity.dynamicBodyCount) {
            var oldSize = cast(i32, world.islands.capacity * sizeof(*world.islands.data));
            var newSize = cast(i32, b3MaxInt(16, def.capacity.dynamicBodyCount) * sizeof(*world.islands.data));
            world.islands.data = b3GrowAlloc(world.islands.data, oldSize, newSize);
            world.islands.capacity = b3MaxInt(16, def.capacity.dynamicBodyCount);
        }
        if !(0 != 0) { break; }
    }
    while true {
        if world.sensors.capacity < 4 {
            var oldSize = cast(i32, world.sensors.capacity * sizeof(*world.sensors.data));
            var newSize = cast(i32, 4 * sizeof(*world.sensors.data));
            world.sensors.data = b3GrowAlloc(world.sensors.data, oldSize, newSize);
            world.sensors.capacity = 4;
        }
        if !(0 != 0) { break; }
    }
    while true {
        if world.bodyMoveEvents.capacity < 4 {
            var oldSize = cast(i32, world.bodyMoveEvents.capacity * sizeof(*world.bodyMoveEvents.data));
            var newSize = cast(i32, 4 * sizeof(*world.bodyMoveEvents.data));
            world.bodyMoveEvents.data = b3GrowAlloc(world.bodyMoveEvents.data, oldSize, newSize);
            world.bodyMoveEvents.capacity = 4;
        }
        if !(0 != 0) { break; }
    }
    while true {
        if world.sensorBeginEvents.capacity < 4 {
            var oldSize = cast(i32, world.sensorBeginEvents.capacity * sizeof(*world.sensorBeginEvents.data));
            var newSize = cast(i32, 4 * sizeof(*world.sensorBeginEvents.data));
            world.sensorBeginEvents.data = b3GrowAlloc(world.sensorBeginEvents.data, oldSize, newSize);
            world.sensorBeginEvents.capacity = 4;
        }
        if !(0 != 0) { break; }
    }
    while true {
        if world.sensorEndEvents[0].capacity < 4 {
            var oldSize = cast(i32, world.sensorEndEvents[0].capacity * sizeof(*world.sensorEndEvents[0].data));
            var newSize = cast(i32, 4 * sizeof(*world.sensorEndEvents[0].data));
            world.sensorEndEvents[0].data = b3GrowAlloc(world.sensorEndEvents[0].data, oldSize, newSize);
            world.sensorEndEvents[0].capacity = 4;
        }
        if !(0 != 0) { break; }
    }
    while true {
        if world.sensorEndEvents[1].capacity < 4 {
            var oldSize = cast(i32, world.sensorEndEvents[1].capacity * sizeof(*world.sensorEndEvents[1].data));
            var newSize = cast(i32, 4 * sizeof(*world.sensorEndEvents[1].data));
            world.sensorEndEvents[1].data = b3GrowAlloc(world.sensorEndEvents[1].data, oldSize, newSize);
            world.sensorEndEvents[1].capacity = 4;
        }
        if !(0 != 0) { break; }
    }
    while true {
        if world.contactBeginEvents.capacity < 4 {
            var oldSize = cast(i32, world.contactBeginEvents.capacity * sizeof(*world.contactBeginEvents.data));
            var newSize = cast(i32, 4 * sizeof(*world.contactBeginEvents.data));
            world.contactBeginEvents.data = b3GrowAlloc(world.contactBeginEvents.data, oldSize, newSize);
            world.contactBeginEvents.capacity = 4;
        }
        if !(0 != 0) { break; }
    }
    while true {
        if world.contactEndEvents[0].capacity < 4 {
            var oldSize = cast(i32, world.contactEndEvents[0].capacity * sizeof(*world.contactEndEvents[0].data));
            var newSize = cast(i32, 4 * sizeof(*world.contactEndEvents[0].data));
            world.contactEndEvents[0].data = b3GrowAlloc(world.contactEndEvents[0].data, oldSize, newSize);
            world.contactEndEvents[0].capacity = 4;
        }
        if !(0 != 0) { break; }
    }
    while true {
        if world.contactEndEvents[1].capacity < 4 {
            var oldSize = cast(i32, world.contactEndEvents[1].capacity * sizeof(*world.contactEndEvents[1].data));
            var newSize = cast(i32, 4 * sizeof(*world.contactEndEvents[1].data));
            world.contactEndEvents[1].data = b3GrowAlloc(world.contactEndEvents[1].data, oldSize, newSize);
            world.contactEndEvents[1].capacity = 4;
        }
        if !(0 != 0) { break; }
    }
    while true {
        if world.contactHitEvents.capacity < 4 {
            var oldSize = cast(i32, world.contactHitEvents.capacity * sizeof(*world.contactHitEvents.data));
            var newSize = cast(i32, 4 * sizeof(*world.contactHitEvents.data));
            world.contactHitEvents.data = b3GrowAlloc(world.contactHitEvents.data, oldSize, newSize);
            world.contactHitEvents.capacity = 4;
        }
        if !(0 != 0) { break; }
    }
    while true {
        if world.jointEvents.capacity < 4 {
            var oldSize = cast(i32, world.jointEvents.capacity * sizeof(*world.jointEvents.data));
            var newSize = cast(i32, 4 * sizeof(*world.jointEvents.data));
            world.jointEvents.data = b3GrowAlloc(world.jointEvents.data, oldSize, newSize);
            world.jointEvents.capacity = 4;
        }
        if !(0 != 0) { break; }
    }
    world.endEventArrayIndex = 0;
    world.stepIndex = 0;
    world.splitIslandId = -1;
    world.activeTaskCount = 0;
    world.taskCount = 0;
    world.gravity = def.gravity;
    world.hitEventThreshold = def.hitEventThreshold;
    world.restitutionThreshold = def.restitutionThreshold;
    world.maxLinearSpeed = def.maximumLinearSpeed;
    world.contactSpeed = def.contactSpeed;
    world.contactHertz = def.contactHertz;
    world.contactDampingRatio = def.contactDampingRatio;
    world.contactRecycleDistance = 10.0f * (0.005f * b3GetLengthUnitsPerMeter());
    if def.frictionCallback == null {
        world.frictionCallback = b3DefaultFrictionCallback;
    } else {
        world.frictionCallback = def.frictionCallback;
    }
    if def.restitutionCallback == null {
        world.restitutionCallback = b3DefaultRestitutionCallback;
    } else {
        world.restitutionCallback = def.restitutionCallback;
    }
    world.enableSleep = def.enableSleep;
    world.locked = false;
    world.enableWarmStarting = true;
    world.enableContinuous = def.enableContinuous;
    world.enableSpeculative = true;
    world.userTreeTask = null;
    world.userData = def.userData;
    if def.workerCount > 0 && def.enqueueTask != null && def.finishTask != null {
        world.workerCount = b3MinInt(cast(i32, def.workerCount), 32);
        world.enqueueTaskFcn = def.enqueueTask;
        world.finishTaskFcn = def.finishTask;
        world.userTaskContext = def.userTaskContext;
        world.scheduler = null;
    } else if def.workerCount > 1 {
        world.workerCount = b3MinInt(cast(i32, def.workerCount), 32);
        world.scheduler = b3CreateScheduler(world.workerCount);
        world.enqueueTaskFcn = b3SchedulerEnqueueTask;
        world.finishTaskFcn = b3SchedulerFinishTask;
        world.userTaskContext = world.scheduler;
    } else {
        world.workerCount = 1;
        world.enqueueTaskFcn = b3DefaultAddTaskFcn;
        world.finishTaskFcn = b3DefaultFinishTaskFcn;
        world.userTaskContext = null;
        world.scheduler = null;
    }
    b3CreateWorkerContexts(world);
    world.debugBodySet = b3CreateBitSet(256);
    world.debugJointSet = b3CreateBitSet(256);
    world.debugContactSet = b3CreateBitSet(256);
    world.debugIslandSet = b3CreateBitSet(256);
    world.createDebugShape = def.createDebugShape;
    world.destroyDebugShape = def.destroyDebugShape;
    world.userDebugShapeContext = def.userDebugShapeContext;
    return b3WorldId{cast(u16, worldId + 1), world.generation};
}

void b3DestroyWorld(b3WorldId worldId) {
    b3AtomicFetchAddInt(&b3_worldCount, -1);
    b3World* world = b3GetUnlockedWorldFromId(worldId);
    if world == null {
        return;
    }
    world.locked = true;
    b3StopRecordingInternal(world);
    if world.scheduler != null {
        b3DestroyScheduler(world.scheduler);
        world.scheduler = null;
    }
    b3DestroyBitSet(&world.debugBodySet);
    b3DestroyBitSet(&world.debugJointSet);
    b3DestroyBitSet(&world.debugContactSet);
    b3DestroyBitSet(&world.debugIslandSet);
    b3DestroyWorkerContexts(world);
    while true {
        b3Free(world.bodyMoveEvents.data, cast(u64, world.bodyMoveEvents.capacity * sizeof(*world.bodyMoveEvents.data)));
        world.bodyMoveEvents.data = null;
        world.bodyMoveEvents.count = 0;
        world.bodyMoveEvents.capacity = 0;
        if !(0 != 0) { break; }
    }
    while true {
        b3Free(world.sensorBeginEvents.data, cast(u64, world.sensorBeginEvents.capacity * sizeof(*world.sensorBeginEvents.data)));
        world.sensorBeginEvents.data = null;
        world.sensorBeginEvents.count = 0;
        world.sensorBeginEvents.capacity = 0;
        if !(0 != 0) { break; }
    }
    while true {
        b3Free(world.sensorEndEvents[0].data, cast(u64, world.sensorEndEvents[0].capacity * sizeof(*world.sensorEndEvents[0].data)));
        world.sensorEndEvents[0].data = null;
        world.sensorEndEvents[0].count = 0;
        world.sensorEndEvents[0].capacity = 0;
        if !(0 != 0) { break; }
    }
    while true {
        b3Free(world.sensorEndEvents[1].data, cast(u64, world.sensorEndEvents[1].capacity * sizeof(*world.sensorEndEvents[1].data)));
        world.sensorEndEvents[1].data = null;
        world.sensorEndEvents[1].count = 0;
        world.sensorEndEvents[1].capacity = 0;
        if !(0 != 0) { break; }
    }
    while true {
        b3Free(world.contactBeginEvents.data, cast(u64, world.contactBeginEvents.capacity * sizeof(*world.contactBeginEvents.data)));
        world.contactBeginEvents.data = null;
        world.contactBeginEvents.count = 0;
        world.contactBeginEvents.capacity = 0;
        if !(0 != 0) { break; }
    }
    while true {
        b3Free(world.contactEndEvents[0].data, cast(u64, world.contactEndEvents[0].capacity * sizeof(*world.contactEndEvents[0].data)));
        world.contactEndEvents[0].data = null;
        world.contactEndEvents[0].count = 0;
        world.contactEndEvents[0].capacity = 0;
        if !(0 != 0) { break; }
    }
    while true {
        b3Free(world.contactEndEvents[1].data, cast(u64, world.contactEndEvents[1].capacity * sizeof(*world.contactEndEvents[1].data)));
        world.contactEndEvents[1].data = null;
        world.contactEndEvents[1].count = 0;
        world.contactEndEvents[1].capacity = 0;
        if !(0 != 0) { break; }
    }
    while true {
        b3Free(world.contactHitEvents.data, cast(u64, world.contactHitEvents.capacity * sizeof(*world.contactHitEvents.data)));
        world.contactHitEvents.data = null;
        world.contactHitEvents.count = 0;
        world.contactHitEvents.capacity = 0;
        if !(0 != 0) { break; }
    }
    while true {
        b3Free(world.jointEvents.data, cast(u64, world.jointEvents.capacity * sizeof(*world.jointEvents.data)));
        world.jointEvents.data = null;
        world.jointEvents.count = 0;
        world.jointEvents.capacity = 0;
        if !(0 != 0) { break; }
    }
    i32 sensorCount = world.sensors.count;
    for i32 i = 0; i < sensorCount; ++i {
        while true {
            b3Free(world.sensors.data[i].hits.data, cast(u64, world.sensors.data[i].hits.capacity * sizeof(*world.sensors.data[i].hits.data)));
            world.sensors.data[i].hits.data = null;
            world.sensors.data[i].hits.count = 0;
            world.sensors.data[i].hits.capacity = 0;
            if !(0 != 0) { break; }
        }
        while true {
            b3Free(world.sensors.data[i].overlaps1.data, cast(u64, world.sensors.data[i].overlaps1.capacity * sizeof(*world.sensors.data[i].overlaps1.data)));
            world.sensors.data[i].overlaps1.data = null;
            world.sensors.data[i].overlaps1.count = 0;
            world.sensors.data[i].overlaps1.capacity = 0;
            if !(0 != 0) { break; }
        }
        while true {
            b3Free(world.sensors.data[i].overlaps2.data, cast(u64, world.sensors.data[i].overlaps2.capacity * sizeof(*world.sensors.data[i].overlaps2.data)));
            world.sensors.data[i].overlaps2.data = null;
            world.sensors.data[i].overlaps2.count = 0;
            world.sensors.data[i].overlaps2.capacity = 0;
            if !(0 != 0) { break; }
        }
    }
    while true {
        b3Free(world.sensors.data, cast(u64, world.sensors.capacity * sizeof(*world.sensors.data)));
        world.sensors.data = null;
        world.sensors.count = 0;
        world.sensors.capacity = 0;
        if !(0 != 0) { break; }
    }
    while true {
        b3Free(world.bodies.data, cast(u64, world.bodies.capacity * sizeof(*world.bodies.data)));
        world.bodies.data = null;
        world.bodies.count = 0;
        world.bodies.capacity = 0;
        if !(0 != 0) { break; }
    }
    i32 shapeCapacity = world.shapes.count;
    b3Shape* shapes = world.shapes.data;
    for i32 i = 0; i < shapeCapacity; ++i {
        b3Shape* shape = shapes + i;
        if shape.id != -1 {
            b3DestroyShapeAllocations(world, shapes + i);
        }
    }
    i32 contactCapacity = world.contacts.count;
    b3Contact* contacts = world.contacts.data;
    for i32 i = 0; i < contactCapacity; ++i {
        b3Contact* contact = contacts + i;
        if contact.contactId != -1 {
            if (contact.flags & cast(u32, b3_simMeshContact)) != 0 {
                while true {
                    b3Free(contact.meshContact.triangleCache.data, cast(u64, contact.meshContact.triangleCache.capacity * sizeof(*contact.meshContact.triangleCache.data)));
                    contact.meshContact.triangleCache.data = null;
                    contact.meshContact.triangleCache.count = 0;
                    contact.meshContact.triangleCache.capacity = 0;
                    if !(0 != 0) { break; }
                }
            }
        }
    }
    b3HullMap_cleanup(world.hullDatabase);
    b3Free(world.hullDatabase, cast(u64, sizeof(b3HullMap)));
    world.hullDatabase = null;
    b3DestroyNameCache(&world.names);
    while true {
        b3Free(world.shapes.data, cast(u64, world.shapes.capacity * sizeof(*world.shapes.data)));
        world.shapes.data = null;
        world.shapes.count = 0;
        world.shapes.capacity = 0;
        if !(0 != 0) { break; }
    }
    while true {
        b3Free(world.contacts.data, cast(u64, world.contacts.capacity * sizeof(*world.contacts.data)));
        world.contacts.data = null;
        world.contacts.count = 0;
        world.contacts.capacity = 0;
        if !(0 != 0) { break; }
    }
    while true {
        b3Free(world.joints.data, cast(u64, world.joints.capacity * sizeof(*world.joints.data)));
        world.joints.data = null;
        world.joints.count = 0;
        world.joints.capacity = 0;
        if !(0 != 0) { break; }
    }
    for i32 i = 0; i < world.islands.count; ++i {
        while true {
            b3Free(world.islands.data[i].bodies.data, cast(u64, world.islands.data[i].bodies.capacity * sizeof(*world.islands.data[i].bodies.data)));
            world.islands.data[i].bodies.data = null;
            world.islands.data[i].bodies.count = 0;
            world.islands.data[i].bodies.capacity = 0;
            if !(0 != 0) { break; }
        }
        while true {
            b3Free(world.islands.data[i].contacts.data, cast(u64, world.islands.data[i].contacts.capacity * sizeof(*world.islands.data[i].contacts.data)));
            world.islands.data[i].contacts.data = null;
            world.islands.data[i].contacts.count = 0;
            world.islands.data[i].contacts.capacity = 0;
            if !(0 != 0) { break; }
        }
        while true {
            b3Free(world.islands.data[i].joints.data, cast(u64, world.islands.data[i].joints.capacity * sizeof(*world.islands.data[i].joints.data)));
            world.islands.data[i].joints.data = null;
            world.islands.data[i].joints.count = 0;
            world.islands.data[i].joints.capacity = 0;
            if !(0 != 0) { break; }
        }
    }
    while true {
        b3Free(world.islands.data, cast(u64, world.islands.capacity * sizeof(*world.islands.data)));
        world.islands.data = null;
        world.islands.count = 0;
        world.islands.capacity = 0;
        if !(0 != 0) { break; }
    }
    i32 setCapacity = world.solverSets.count;
    for i32 i = 0; i < setCapacity; ++i {
        b3SolverSet* set = world.solverSets.data + i;
        if set.setIndex != -1 {
            b3DestroySolverSet(world, i);
        }
    }
    while true {
        b3Free(world.solverSets.data, cast(u64, world.solverSets.capacity * sizeof(*world.solverSets.data)));
        world.solverSets.data = null;
        world.solverSets.count = 0;
        world.solverSets.capacity = 0;
        if !(0 != 0) { break; }
    }
    b3DestroyGraph(&world.constraintGraph);
    b3DestroyBroadPhase(&world.broadPhase);
    b3DestroyIdPool(&world.bodyIdPool);
    b3DestroyIdPool(&world.shapeIdPool);
    b3DestroyIdPool(&world.contactIdPool);
    b3DestroyIdPool(&world.jointIdPool);
    b3DestroyIdPool(&world.islandIdPool);
    b3DestroyIdPool(&world.solverSetIdPool);
    for i32 i = 0; i < world.manifoldAllocators.count; ++i {
        b3DestroyBlockAllocator(world.manifoldAllocators.data + i);
    }
    while true {
        b3Free(world.manifoldAllocators.data, cast(u64, world.manifoldAllocators.capacity * sizeof(*world.manifoldAllocators.data)));
        world.manifoldAllocators.data = null;
        world.manifoldAllocators.count = 0;
        world.manifoldAllocators.capacity = 0;
        if !(0 != 0) { break; }
    }
    b3DestroyMutex(world.manifoldAllocatorMutex);
    b3DestroyStack(&world.stack);
    u16 generation = world.generation;
    memset(world, 0, cast(u64, sizeof(b3World)));
    world.generation = cast(u16, generation + 1);
}

i32 b3GetWorldCount() {
    return b3AtomicLoadInt(&b3_worldCount);
}

i32 b3GetMaxWorldCount() {
    return b3_maxWorldCount;
}

// Issues T0 prefetches across the cache lines of a b3Contact (216 B / 4 lines).
// Used to hide the random-access latency of contact lookups while we work on an
// earlier index.
private {
void b3PrefetchContact(b3Contact* contact) {
    var p = cast(u8*, contact);
    _mm_prefetch(p, 1);
    _mm_prefetch(p + 64, 1);
    _mm_prefetch(p + 128, 1);
    _mm_prefetch(p + 192, 1);
}

void b3CollideTask(i32 startIndex, i32 endIndex, i32 workerIndex, void* context) {
    var stepContext = cast(b3StepContext*, context);
    b3World* world = stepContext.world;
    b3ConstraintGraph* graph = &world.constraintGraph;
    b3TaskContext* taskContext = world.taskContexts.data + workerIndex;
    i32* contactIndices = stepContext.awakeContactIndices;
    b3Contact* contacts = world.contacts.data;
    b3Shape* shapes = world.shapes.data;
    b3Body* bodies = world.bodies.data;
    b3BodySim* awakeSims = world.solverSets.data[b3_awakeSet].bodySims.data;
    b3BodySim* staticSims = world.solverSets.data[b3_staticSet].bodySims.data;
    f32 recycleDistance = world.contactRecycleDistance;
    f32 speculativeDistance = 4.0f * (0.005f * b3GetLengthUnitsPerMeter());
    f32 recycleDistanceNonTouching = b3MinFloat(recycleDistance, speculativeDistance);
    i32 contactPrefetchDistance = 4;
    i32 prefetchEnd = endIndex - contactPrefetchDistance;
    for i32 i = startIndex; i < endIndex; ++i {
        if i < prefetchEnd {
            b3PrefetchContact(contacts + contactIndices[i + contactPrefetchDistance]);
        }
        i32 contactIndex = contactIndices[i];
        b3Contact* contact = contacts + contactIndex;
        b3Shape* shapeA = shapes + contact.shapeIdA;
        b3Shape* shapeB = shapes + contact.shapeIdB;
        bool overlap = b3AABB_Overlaps(shapeA.fatAABB, shapeB.fatAABB);
        if overlap == false {
            contact.flags |= cast(u32, b3_simDisjoint);
            contact.flags &= cast(u32, ~b3_simTouchingFlag);
            b3SetBit(&taskContext.contactStateBitSet, cast(u32, contactIndex));
            continue;
        }
        b3Body* bodyA = bodies + shapeA.bodyId;
        b3Body* bodyB = bodies + shapeB.bodyId;
        bool isStaticA = bodyA.type == b3_staticBody;
        bool isStaticB = bodyB.type == b3_staticBody;
        bool wasTouching = (contact.flags & cast(u32, b3_simTouchingFlag)) != 0;
        bool isMeshContact = (contact.flags & cast(u32, b3_simMeshContact)) != 0;
        b3BodySim* bodySimA;
        b3BodySim* bodySimB;
        if wasTouching != 0 {
            bodySimA = (isStaticA != 0 ? staticSims : awakeSims) + bodyA.localIndex;
            bodySimB = (isStaticB != 0 ? staticSims : awakeSims) + bodyB.localIndex;
        } else {
            {
                b3SolverSet* set = world.solverSets.data + bodyA.setIndex;
                bodySimA = set.bodySims.data + bodyA.localIndex;
            }
            {
                b3SolverSet* set = world.solverSets.data + bodyB.setIndex;
                bodySimB = set.bodySims.data + bodyB.localIndex;
            }
        }
        b3WorldTransform transformA = bodySimA.transform;
        b3WorldTransform transformB = bodySimB.transform;
        bool isFast = bodySimA.flags & cast(u32, b3_isFast) || bodySimB.flags & cast(u32, b3_isFast);
        contact.bodySimIndexA = isStaticA != 0 ? -1 : bodyA.localIndex;
        contact.bodySimIndexB = isStaticB != 0 ? -1 : bodyB.localIndex;
        f32 recycleTolerance = wasTouching != 0 ? recycleDistance : recycleDistanceNonTouching;
        if (isFast == false || isMeshContact == false) && recycleDistance > 0.0f && contact.flags & cast(u32, b3_relativeTransformValid) && contact.flags & cast(u32, b3_contactRecycleFlag) {
            f32 angleA = b3DotQuat(transformA.q, contact.cachedRotationA);
            f32 angleB = b3DotQuat(transformB.q, contact.cachedRotationB);
            f32 angularDistance = b3MinFloat(angleA * angleA, angleB * angleB);
            b3Transform xf = b3InvMulWorldTransforms(transformA, transformB);
            b3Transform xfc = contact.cachedRelativePose;
            b3Vec3 maxExtentA = isStaticA != 0 ? b3Vec3_zero : bodySimA.maxExtent;
            b3Vec3 maxExtentB = isStaticB != 0 ? b3Vec3_zero : bodySimB.maxExtent;
            b3Vec3 maxExtent = b3Max(maxExtentA, maxExtentB);
            f32 distSquared = b3DistanceSquared(xf.p, xfc.p);
            if angularDistance > 0.99240388f && distSquared < recycleTolerance * recycleTolerance {
                f32 distance = sqrtf(distSquared);
                f32 slack = recycleTolerance - distance;
                b3Quat qr = b3InvMulQuat(xfc.q, xf.q);
                b3Vec3 arc = b3ModifiedCross(b3Abs(qr.v), maxExtent);
                f32 arcSq = 4.0f * b3LengthSquared(arc);
                if arcSq < slack * slack {
                    b3Quat dqA = b3MulQuat(transformA.q, b3Conjugate(contact.cachedRotationA));
                    b3Quat dqB = b3MulQuat(transformB.q, b3Conjugate(contact.cachedRotationB));
                    b3Matrix3 matrixA = b3MakeMatrixFromQuat(dqA);
                    b3Matrix3 matrixB = b3MakeMatrixFromQuat(dqB);
                    b3Vec3 dc = b3SubPos(bodySimB.center, bodySimA.center);
                    i32 manifoldCount = contact.manifoldCount;
                    for i32 manifoldIndex = 0; manifoldIndex < manifoldCount; ++manifoldIndex {
                        b3Manifold* manifold = contact.manifolds + manifoldIndex;
                        b3Vec3 normal = manifold.normal;
                        i32 pointCount = manifold.pointCount;
                        for i32 pointIndex = 0; pointIndex < pointCount; ++pointIndex {
                            b3ManifoldPoint* mp = manifold.points + pointIndex;
                            b3Vec3 rA = b3MulMV(matrixA, mp.anchorA);
                            b3Vec3 rB = b3MulMV(matrixB, mp.anchorB);
                            b3Vec3 dp = b3Add(dc, b3Sub(rB, rA));
                            mp.separation = mp.baseSeparation + b3Dot(dp, normal);
                            mp.persisted = true;
                        }
                    }
                    taskContext.recycledContactCount += 1;
                    i32 bucketIndex = b3MinInt(manifoldCount, 8 - 1);
                    if bucketIndex > 0 {
                        taskContext.manifoldCounts[bucketIndex - 1] += 1;
                    }
                    continue;
                }
            }
        }
        contact.cachedRotationA = transformA.q;
        contact.cachedRotationB = transformB.q;
        contact.cachedRelativePose = b3InvMulWorldTransforms(transformA, transformB);
        contact.flags |= cast(u32, b3_relativeTransformValid);
        bool touching = b3UpdateContact(world, workerIndex, contact, shapeA, bodySimA.localCenter, transformA, shapeB, bodySimB.localCenter, transformB, isFast, taskContext.arena);
        i32 bucketIndex = b3MinInt(contact.manifoldCount, 8 - 1);
        if bucketIndex > 0 {
            taskContext.manifoldCounts[bucketIndex - 1] += 1;
        }
        if touching == true && wasTouching == true && contact.flags & cast(u32, b3_simMeshContact) {
            b3GraphColor* color = graph.colors + contact.colorIndex;
            b3ContactSpec* spec = color.contacts.data + contact.localIndex;
            spec.manifoldCount = cast(u16, contact.manifoldCount);
        }
        if touching == true && wasTouching == false {
            contact.flags |= cast(u32, b3_simStartedTouching);
            b3SetBit(&taskContext.contactStateBitSet, cast(u32, contactIndex));
        } else if touching == false && wasTouching == true {
            contact.flags |= cast(u32, b3_simStoppedTouching);
            b3SetBit(&taskContext.contactStateBitSet, cast(u32, contactIndex));
        }
        for i32 manifoldIndex = 0; manifoldIndex < contact.manifoldCount; ++manifoldIndex {
            b3Manifold* manifold = contact.manifolds + manifoldIndex;
            for i32 pointIndex = 0; pointIndex < manifold.pointCount; ++pointIndex {
                b3ManifoldPoint* mp = manifold.points + pointIndex;
                mp.baseSeparation = mp.separation;
            }
        }
    }
}

void b3AddNonTouchingContact(b3World* world, b3Contact* contact) {
    b3SolverSet* set = world.solverSets.data + b3_awakeSet;
    contact.colorIndex = -1;
    contact.localIndex = set.contactIndices.count;
    contact.bodySimIndexA = -1;
    contact.bodySimIndexB = -1;
    while true {
        if set.contactIndices.count >= set.contactIndices.capacity {
            var oldSize = cast(i32, set.contactIndices.capacity * sizeof(*set.contactIndices.data));
            i32 newCapacity = set.contactIndices.capacity == 0 ? 8 : 2 * set.contactIndices.capacity;
            var newSize = cast(i32, newCapacity * sizeof(*set.contactIndices.data));
            set.contactIndices.data = b3GrowAlloc(set.contactIndices.data, oldSize, newSize);
            set.contactIndices.capacity = newCapacity;
        }
        set.contactIndices.data[set.contactIndices.count++] = contact.contactId;
        if !(0 != 0) { break; }
    }
}

void b3RemoveNonTouchingContact(b3World* world, i32 setIndex, i32 localIndex) {
    b3SolverSet* set = world.solverSets.data + setIndex;
    i32 movedIndex = b3RemoveHelper(set.contactIndices.data, &set.contactIndices.count, localIndex, cast(i32, sizeof(*set.contactIndices.data)));
    if movedIndex != -1 {
        i32 movedContactIndex = set.contactIndices.data[localIndex];
        b3Contact* movedContact = world.contacts.data + movedContactIndex;
        movedContact.localIndex = localIndex;
    }
}

// Narrow-phase collision
void b3Collide(b3StepContext* context) {
    b3World* world = context.world;
    i32 touchingCount = 0;
    b3GraphColor* graphColors = world.constraintGraph.colors;
    for i32 i = 0; i < 24; ++i {
        touchingCount += graphColors[i].convexContacts.count + graphColors[i].contacts.count;
    }
    b3SolverSet* awakeSet = world.solverSets.data + b3_awakeSet;
    i32 nonTouchingCount = awakeSet.contactIndices.count;
    i32 contactCount = touchingCount + nonTouchingCount;
    if contactCount == 0 {
        return;
    }
    var contactIndices = cast(i32*, b3StackAlloc(&world.stack, cast(i32, contactCount * sizeof(i32)), "contact indices"));
    i32 contactIndex = 0;
    for i32 i = 0; i < 24; ++i {
        b3GraphColor* color = graphColors + i;
        i32 count = color.convexContacts.count;
        for i32 j = 0; j < count; ++j {
            contactIndices[contactIndex] = color.convexContacts.data[j];
            contactIndex += 1;
        }
        count = color.contacts.count;
        for i32 j = 0; j < count; ++j {
            contactIndices[contactIndex] = color.contacts.data[j].contactId;
            contactIndex += 1;
        }
    }
    if nonTouchingCount > 0 {
        i32* nonTouchingIndices = awakeSet.contactIndices.data;
        memcpy(contactIndices + touchingCount, nonTouchingIndices, cast(u64, nonTouchingCount * sizeof(i32)));
    }
    context.awakeContactIndices = contactIndices;
    i32 contactIdCapacity = b3GetIdCapacity(&world.contactIdPool);
    for i32 i = 0; i < world.workerCount; ++i {
        b3TaskContext* taskContext = world.taskContexts.data + i;
        b3SetBitCountAndClear(&taskContext.contactStateBitSet, cast(u32, contactIdCapacity));
        taskContext.satCallCount = 0;
        taskContext.satCacheHitCount = 0;
        taskContext.recycledContactCount = 0;
        memset(taskContext.manifoldCounts, 0, cast(u64, sizeof(taskContext.manifoldCounts)));
    }
    i32 minRange = 20;
    b3ParallelFor(world, cast(b3ParallelForCallback, b3CollideTask), contactCount, minRange, context, "collide");
    b3StackFree(&world.stack, contactIndices);
    context.awakeContactIndices = null;
    contactIndices = null;
    i32 satMultiplier = context.dt > 0.0f ? 1 : 0;
    b3BitSet* bitSet = &world.taskContexts.data[0].contactStateBitSet;
    world.satCallCount = satMultiplier * world.taskContexts.data[0].satCallCount;
    world.satCacheHitCount = satMultiplier * world.taskContexts.data[0].satCacheHitCount;
    memcpy(world.manifoldCounts, world.taskContexts.data[0].manifoldCounts, cast(u64, 8 * sizeof(i32)));
    for i32 i = 1; i < world.workerCount; ++i {
        b3InPlaceUnion(bitSet, &world.taskContexts.data[i].contactStateBitSet);
        world.satCallCount += world.taskContexts.data[i].satCallCount;
        world.satCacheHitCount += world.taskContexts.data[i].satCacheHitCount;
        for i32 j = 0; j < 8; ++j {
            world.manifoldCounts[j] += world.taskContexts.data[i].manifoldCounts[j];
        }
    }
    for i32 i = 0; i < world.workerCount; ++i {
        b3ArenaSync(&world.taskContexts.data[i].arena);
    }
    i32 endEventArrayIndex = world.endEventArrayIndex;
    b3Shape* shapes = world.shapes.data;
    u16 worldId = world.worldId;
    for u32 k = 0; k < bitSet.blockCount; ++k {
        u64 bits = bitSet.bits[k];
        while bits != 0 {
            u32 ctz = b3CTZ64(bits);
            var contactId = cast(i32, 64 * k + ctz);
            b3Contact* contact = world.contacts.data + contactId;
            b3Shape* shapeA = shapes + contact.shapeIdA;
            b3Shape* shapeB = shapes + contact.shapeIdB;
            var shapeIdA = b3ShapeId{shapeA.id + 1, worldId, shapeA.generation};
            var shapeIdB = b3ShapeId{shapeB.id + 1, worldId, shapeB.generation};
            var contactFullId = b3ContactId{
                .index1 = contactId + 1,
                .world0 = worldId,
                .padding = 0,
                .generation = contact.generation,
            };
            u32 flags = contact.flags;
            if (flags & cast(u32, b3_simDisjoint)) != 0 {
                b3DestroyContact(world, contact, false);
                contact = null;
            } else if (flags & cast(u32, b3_simStartedTouching)) != 0 {
                if (flags & cast(u32, b3_contactEnableContactEvents)) != 0 {
                    var event = b3ContactBeginTouchEvent{shapeIdA, shapeIdB, contactFullId};
                    while true {
                        if world.contactBeginEvents.count >= world.contactBeginEvents.capacity {
                            var oldSize = cast(i32, world.contactBeginEvents.capacity * sizeof(*world.contactBeginEvents.data));
                            i32 newCapacity = world.contactBeginEvents.capacity == 0 ? 8 : 2 * world.contactBeginEvents.capacity;
                            var newSize = cast(i32, newCapacity * sizeof(*world.contactBeginEvents.data));
                            world.contactBeginEvents.data = b3GrowAlloc(world.contactBeginEvents.data, oldSize, newSize);
                            world.contactBeginEvents.capacity = newCapacity;
                        }
                        world.contactBeginEvents.data[world.contactBeginEvents.count++] = event;
                        if !(0 != 0) { break; }
                    }
                }
                contact.flags &= cast(u32, ~b3_simStartedTouching);
                contact.flags |= cast(u32, b3_contactTouchingFlag);
                b3LinkContact(world, contact);
                i32 oldLocalIndex = contact.localIndex;
                b3AddContactToGraph(world, contact);
                b3RemoveNonTouchingContact(world, b3_awakeSet, oldLocalIndex);
            } else if (flags & cast(u32, b3_simStoppedTouching)) != 0 {
                contact.flags &= cast(u32, ~b3_simStoppedTouching);
                contact.flags &= cast(u32, ~b3_contactTouchingFlag);
                if (contact.flags & cast(u32, b3_contactEnableContactEvents)) != 0 {
                    var event = b3ContactEndTouchEvent{shapeIdA, shapeIdB, contactFullId};
                    while true {
                        if world.contactEndEvents[endEventArrayIndex].count >= world.contactEndEvents[endEventArrayIndex].capacity {
                            var oldSize = cast(i32, world.contactEndEvents[endEventArrayIndex].capacity * sizeof(*world.contactEndEvents[endEventArrayIndex].data));
                            i32 newCapacity = world.contactEndEvents[endEventArrayIndex].capacity == 0 ? 8 : 2 * world.contactEndEvents[endEventArrayIndex].capacity;
                            var newSize = cast(i32, newCapacity * sizeof(*world.contactEndEvents[endEventArrayIndex].data));
                            world.contactEndEvents[endEventArrayIndex].data = b3GrowAlloc(world.contactEndEvents[endEventArrayIndex].data, oldSize, newSize);
                            world.contactEndEvents[endEventArrayIndex].capacity = newCapacity;
                        }
                        world.contactEndEvents[endEventArrayIndex].data[world.contactEndEvents[endEventArrayIndex].count++] = event;
                        if !(0 != 0) { break; }
                    }
                }
                i32 colorIndex = contact.colorIndex;
                i32 localIndex = contact.localIndex;
                b3UnlinkContact(world, contact);
                i32 bodyIdA = contact.edges[0].bodyId;
                i32 bodyIdB = contact.edges[1].bodyId;
                b3AddNonTouchingContact(world, contact);
                bool isMeshContact = (contact.flags & cast(u32, b3_simMeshContact)) != 0;
                b3RemoveContactFromGraph(world, bodyIdA, bodyIdB, colorIndex, localIndex, isMeshContact);
                contact = null;
            }
            bits = bits & bits - 1;
        }
    }
    b3ValidateSolverSets(world);
    b3ValidateContacts(world);
}
}

void b3World_Step(b3WorldId worldId, f32 timeStep, i32 subStepCount) {
    b3World* world = b3GetUnlockedWorldFromId(worldId);
    if world == null {
        return;
    }
    while true {
        if world.recording != null {
            var recArgs = b3RecArgs_Step{worldId, timeStep, subStepCount};
            b3RecWrite_Step(world.recording, &recArgs);
        }
        if !(0 != 0) { break; }
    }
    world.locked = true;
    for i32 i = 0; i < world.workerCount; ++i {
        world.taskContexts.data[i].pointCount = 0;
        world.taskContexts.data[i].lineCount = 0;
    }
    while true {
        world.bodyMoveEvents.count = 0;
        if !(0 != 0) { break; }
    }
    while true {
        world.sensorBeginEvents.count = 0;
        if !(0 != 0) { break; }
    }
    while true {
        world.contactBeginEvents.count = 0;
        if !(0 != 0) { break; }
    }
    while true {
        world.contactHitEvents.count = 0;
        if !(0 != 0) { break; }
    }
    while true {
        world.jointEvents.count = 0;
        if !(0 != 0) { break; }
    }
    world.profile = b3Profile{};
    world.activeTaskCount = 0;
    world.taskCount = 0;
    if world.scheduler != null {
        b3ResetScheduler(world.scheduler);
    }
    u64 stepTicks = b3GetTicks();
    {
        b3Capacity* c = &world.maxCapacity;
        c.staticShapeCount = b3MaxInt(c.staticShapeCount, world.broadPhase.trees[b3_staticBody].proxyCount);
        c.dynamicShapeCount = b3MaxInt(c.dynamicShapeCount, world.broadPhase.trees[b3_dynamicBody].proxyCount);
        i32 staticBodyCount = world.solverSets.data[b3_staticSet].bodySims.count;
        c.staticBodyCount = b3MaxInt(c.staticBodyCount, staticBodyCount);
        i32 totalBodyCount = b3GetIdCount(&world.bodyIdPool);
        c.dynamicBodyCount = b3MaxInt(c.dynamicBodyCount, totalBodyCount - staticBodyCount);
        i32 totalContactCount = b3GetIdCount(&world.contactIdPool);
        c.contactCount = b3MaxInt(c.contactCount, totalContactCount);
    }
    {
        u64 pairTicks = b3GetTicks();
        b3UpdateBroadPhasePairs(world);
        world.profile.pairs = b3GetMilliseconds(pairTicks);
    }
    b3SolverSet* awakeSet = world.solverSets.data + b3_awakeSet;
    b3StepContext context;
    context.world = world;
    context.states = awakeSet.bodyStates.data;
    context.dt = timeStep;
    context.subStepCount = b3MaxInt(1, subStepCount);
    if timeStep > 0.0f {
        context.inv_dt = 1.0f / timeStep;
        context.h = timeStep / cast(f32, context.subStepCount);
        context.inv_h = cast(f32, context.subStepCount) * context.inv_dt;
    } else {
        context.inv_dt = 0.0f;
        context.h = 0.0f;
        context.inv_h = 0.0f;
    }
    world.inv_h = context.inv_h;
    world.inv_dt = context.inv_dt;
    f32 contactHertz = b3MinFloat(world.contactHertz, 0.125f * context.inv_h);
    context.contactSoftness = b3MakeSoft(contactHertz, world.contactDampingRatio, context.h);
    context.staticSoftness = b3MakeSoft(2.0f * contactHertz, 0.5f * world.contactDampingRatio, context.h);
    context.restitutionThreshold = world.restitutionThreshold;
    context.maxLinearVelocity = world.maxLinearSpeed;
    context.enableWarmStarting = world.enableWarmStarting;
    {
        u64 collideTicks = b3GetTicks();
        b3Collide(&context);
        world.profile.collide = b3GetMilliseconds(collideTicks);
    }
    if timeStep > 0.0f {
        u64 solveTicks = b3GetTicks();
        b3Solve(world, &context);
        world.profile.solve = b3GetMilliseconds(solveTicks);
    }
    if world.userTreeTask != null {
        world.finishTaskFcn(world.userTreeTask, world.userTaskContext);
        world.userTreeTask = null;
        world.activeTaskCount -= 1;
    }
    {
        u64 sensorTicks = b3GetTicks();
        b3OverlapSensors(world);
        world.profile.sensors = b3GetMilliseconds(sensorTicks);
    }
    world.profile.step = b3GetMilliseconds(stepTicks);
    b3GrowStack(&world.stack);
    world.endEventArrayIndex = 1 - world.endEventArrayIndex;
    while true {
        world.sensorEndEvents[world.endEventArrayIndex].count = 0;
        if !(0 != 0) { break; }
    }
    while true {
        world.contactEndEvents[world.endEventArrayIndex].count = 0;
        if !(0 != 0) { break; }
    }
    world.locked = false;
    if world.recording != null {
        u64 hash = b3HashWorldState(world);
        var stateHash = b3RecArgs_StateHash{worldId, hash};
        b3RecWrite_StateHash(world.recording, &stateHash);
        b3AABB worldBounds;
        bool haveBounds = false;
        for i32 i = 0; i < b3_bodyTypeCount; ++i {
            b3DynamicTree* tree = world.broadPhase.trees + i;
            if b3DynamicTree_GetProxyCount(tree) == 0 {
                continue;
            }
            b3AABB bounds = b3DynamicTree_GetRootBounds(tree);
            worldBounds = haveBounds != 0 ? b3AABB_Union(worldBounds, bounds) : bounds;
            haveBounds = true;
        }
        if haveBounds != 0 {
            b3RecAccumulateBounds(world.recording, worldBounds);
        }
    }
}

private {
bool DrawQueryCallback(i32 proxyId, u64 userData, void* context) {
    var shapeId = cast(i32, userData);
    ignore proxyId;
    var drawContext = cast(DrawContext*, context);
    b3World* world = drawContext.world;
    b3DebugDraw* draw = drawContext.draw;
    b3Shape* shape = world.shapes.data + shapeId;
    b3SetBit(&world.debugBodySet, cast(u32, shape.bodyId));
    if draw.drawShapes != 0 {
        b3Body* body = world.bodies.data + shape.bodyId;
        b3BodySim* bodySim = b3GetBodySim(world, body);
        b3HexColor color;
        b3SurfaceMaterial* surfaceMaterial = b3GetShapeMaterials(shape);
        if surfaceMaterial[0].customColor != 0 {
            color = cast(b3HexColor, surfaceMaterial[0].customColor);
        } else {
            b3HexColor rgb;
            b3DebugMaterial material = b3_debugMaterialDefault;
            if body.type == b3_dynamicBody && body.mass == 0.0f {
                rgb = b3_colorRed;
            } else if body.setIndex == b3_disabledSet {
                rgb = b3_colorSlateGray;
            } else if shape.sensorIndex != -1 {
                rgb = b3_colorWheat;
            } else if (body.flags & cast(u32, b3_hadTimeOfImpact)) != 0 {
                rgb = b3_colorLime;
            } else if bodySim.flags & cast(u32, b3_isBullet) && body.setIndex == b3_awakeSet {
                rgb = b3_colorTurquoise;
            } else if (body.flags & cast(u32, b3_isSpeedCapped)) != 0 {
                rgb = b3_colorYellow;
            } else if (bodySim.flags & cast(u32, b3_isFast)) != 0 {
                rgb = b3_colorOrange;
                material = b3_debugMaterialGlossy;
            } else if body.type == b3_staticBody {
                rgb = b3_colorDarkGray;
                material = b3_debugMaterialMatte;
            } else if body.type == b3_kinematicBody {
                if body.setIndex == b3_awakeSet {
                    rgb = b3_colorSteelBlue;
                    material = b3_debugMaterialMetallic;
                } else {
                    rgb = b3_colorLightSteelBlue;
                    material = b3_debugMaterialMatte;
                }
            } else if body.setIndex == b3_awakeSet {
                rgb = b3_colorTan;
                material = b3_debugMaterialSoft;
            } else {
                rgb = b3_colorLightSlateGray;
                material = b3_debugMaterialDead;
            }
            color = cast(b3HexColor, b3MakeDebugColor(rgb, material));
        }
        if shape.userShape == null && world.createDebugShape != null {
            b3DebugShape debugShape;
            debugShape.shapeId = b3ShapeId{
                .world0 = world.worldId,
                .index1 = shapeId + 1,
                .generation = shape.generation,
            };
            debugShape.type = shape.type;
            switch shape.type {
                case b3_capsuleShape: {
                    debugShape.capsule = &shape.capsule;
                    shape.userShape = world.createDebugShape(&debugShape, world.userDebugShapeContext);
                }
                case b3_compoundShape: {
                    debugShape.compound = shape.compound;
                    shape.userShape = world.createDebugShape(&debugShape, world.userDebugShapeContext);
                }
                case b3_heightShape: {
                    debugShape.heightField = shape.heightField;
                    shape.userShape = world.createDebugShape(&debugShape, world.userDebugShapeContext);
                }
                case b3_hullShape: {
                    debugShape.hull = shape.hull;
                    shape.userShape = world.createDebugShape(&debugShape, world.userDebugShapeContext);
                }
                case b3_meshShape: {
                    debugShape.mesh = &shape.mesh;
                    shape.userShape = world.createDebugShape(&debugShape, world.userDebugShapeContext);
                }
                case b3_sphereShape: {
                    debugShape.sphere = &shape.sphere;
                    shape.userShape = world.createDebugShape(&debugShape, world.userDebugShapeContext);
                }
                default: {
                }
            }
        }
        if shape.userShape != null {
            draw.DrawShapeFcn(shape.userShape, bodySim.transform, color, draw.context);
        }
    }
    if draw.drawBounds != 0 {
        draw.DrawBoundsFcn(shape.fatAABB, b3_colorGold, draw.context);
    }
    return true;
}
}

void b3World_Draw(b3WorldId worldId, b3DebugDraw* draw, u64 maskBits) {
    b3World* world = b3GetUnlockedWorldFromId(worldId);
    if world == null {
        return;
    }
    f32 lengthScale = b3GetLengthUnitsPerMeter();
    f32 axisScale = 0.3f * lengthScale;
    b3HexColor farColor = b3_colorDarkBlue;
    b3HexColor speculativeColor = b3_colorBlue;
    b3HexColor addColor = b3_colorLimeGreen;
    b3HexColor persistColor = b3_colorLightBlue;
    b3HexColor impulseColor = b3_colorMagenta;
    b3HexColor frictionColor = b3_colorYellow;
    b3HexColor[24] graphColors = {
        b3_colorRed, b3_colorOrange, b3_colorYellow, b3_colorGreen, b3_colorCyan, b3_colorBlue,
        b3_colorViolet, b3_colorPink, b3_colorChocolate, b3_colorGoldenRod, b3_colorCoral,
        b3_colorRosyBrown, b3_colorAqua, b3_colorPeru, b3_colorLime, b3_colorGold, b3_colorPlum,
        b3_colorSnow, b3_colorTeal, b3_colorKhaki, b3_colorSalmon, b3_colorPeachPuff,
        b3_colorHoneyDew, b3_colorBlack,
    };
    i32 bodyCapacity = b3GetIdCapacity(&world.bodyIdPool);
    b3SetBitCountAndClear(&world.debugBodySet, cast(u32, bodyCapacity));
    i32 jointCapacity = b3GetIdCapacity(&world.jointIdPool);
    b3SetBitCountAndClear(&world.debugJointSet, cast(u32, jointCapacity));
    i32 contactCapacity = b3GetIdCapacity(&world.contactIdPool);
    b3SetBitCountAndClear(&world.debugContactSet, cast(u32, contactCapacity));
    i32 islandCapacity = b3GetIdCapacity(&world.islandIdPool);
    b3SetBitCountAndClear(&world.debugIslandSet, cast(u32, islandCapacity));
    var drawContext = DrawContext{world, draw};
    for i32 i = 0; i < b3_bodyTypeCount; ++i {
        b3DynamicTree_Query(world.broadPhase.trees + i, draw.drawingBounds, maskBits, false, cast(b3TreeQueryCallbackFcn, DrawQueryCallback), &drawContext);
    }
    u32 wordCount = world.debugBodySet.blockCount;
    u64* bits = world.debugBodySet.bits;
    for u32 wordIndex = 0; wordIndex < wordCount; ++wordIndex {
        u64 word = bits[wordIndex];
        while word != 0 {
            u32 ctz = b3CTZ64(word);
            var bodyId = cast(i32, 64 * wordIndex + ctz);
            b3Body* body = world.bodies.data + bodyId;
            b3BodySim* bodySim = b3GetBodySim(world, body);
            if draw.drawBodyNames && body.nameId != 0 {
                var offset = b3Vec3{0.05f, 0.05f, 0.05f};
                var transform = b3WorldTransform{bodySim.center, bodySim.transform.q};
                b3Pos p = b3TransformWorldPoint(transform, offset);
                u8* name = b3FindName(&world.names, body.nameId);
                if name != null {
                    draw.DrawStringFcn(p, name, b3_colorOrange, draw.context);
                }
            }
            if draw.drawMass && body.type == b3_dynamicBody {
                var offset = b3Vec3{0.1f, 0.1f, 0.1f};
                var transform = b3WorldTransform{bodySim.center, bodySim.transform.q};
                draw.DrawTransformFcn(transform, draw.context);
                b3Pos p = b3TransformWorldPoint(transform, offset);
                noinit u8[32] buffer;
                snprintf(buffer, 32, "  %.2f", body.mass);
                draw.DrawStringFcn(p, buffer, b3_colorWhite, draw.context);
            }
            if draw.drawSleep != 0 {
                b3BodyState* bodyState = b3GetBodyState(world, body);
                if bodyState != null {
                    b3HexColor[4] colors = {
                        b3_colorBlue, b3_colorSkyBlue, b3_colorOrange, b3_colorRed,
                    };
                    b3HexColor color = b3_colorBlack;
                    if body.sleepThreshold > 0.0f {
                        f32 ratio = body.sleepVelocity / body.sleepThreshold;
                        i32 index = b3ClampInt(cast(i32, ratio), 0, 3);
                        color = colors[index];
                    }
                    b3Pos center = bodySim.center;
                    draw.DrawPointFcn(center, 10.0f, color, draw.context);
                    var offset = b3Vec3{0.1f, 0.1f, 0.1f};
                    b3Pos p = b3OffsetPos(center, offset);
                    noinit u8[32] buffer;
                    snprintf(buffer, 32, "  %.3f", body.sleepVelocity);
                    draw.DrawStringFcn(p, buffer, color, draw.context);
                }
            }
            if draw.drawJoints != 0 {
                i32 jointKey = body.headJointKey;
                while jointKey != -1 {
                    i32 jointId = jointKey >> 1;
                    i32 edgeIndex = jointKey & 1;
                    b3Joint* joint = world.joints.data + jointId;
                    if b3GetBit(&world.debugJointSet, cast(u32, jointId)) == false {
                        b3DrawJoint(draw, world, joint);
                        b3SetBit(&world.debugJointSet, cast(u32, jointId));
                    }
                    jointKey = joint.edges[edgeIndex].nextKey;
                }
            }
            f32 speculativeDistance = 4.0f * (0.005f * b3GetLengthUnitsPerMeter());
            if draw.drawContacts && body.type == b3_dynamicBody && body.setIndex == b3_awakeSet {
                i32 contactKey = body.headContactKey;
                while contactKey != -1 {
                    i32 contactId = contactKey >> 1;
                    i32 edgeIndex = contactKey & 1;
                    b3Contact* contact = world.contacts.data + contactId;
                    contactKey = contact.edges[edgeIndex].nextKey;
                    if contact.setIndex != b3_awakeSet || contact.colorIndex == -1 {
                        continue;
                    }
                    if b3GetBit(&world.debugContactSet, cast(u32, contactId)) == false {
                        b3Body* bodyA = world.bodies.data + contact.edges[0].bodyId;
                        b3BodySim* bodySimA = b3GetBodySim(world, bodyA);
                        b3Body* bodyB = world.bodies.data + contact.edges[1].bodyId;
                        b3BodySim* bodySimB = b3GetBodySim(world, bodyB);
                        for i32 manifoldIndex = 0; manifoldIndex < contact.manifoldCount; ++manifoldIndex {
                            b3Manifold* manifold = contact.manifolds + manifoldIndex;
                            b3Vec3 normal = manifold.normal;
                            b3Pos contactCenter = draw.drawAnchorA != 0 ? bodySimA.center : bodySimB.center;
                            b3Vec3 frictionAnchor = b3Vec3_zero;
                            f32 totalWeight = 0.0f;
                            f32 invTau = 1.0f / (4.0f * (0.005f * b3GetLengthUnitsPerMeter()));
                            b3ManifoldPoint* points = manifold.points;
                            for i32 pointIndex = 0; pointIndex < manifold.pointCount; ++pointIndex {
                                b3ManifoldPoint* mp = points + pointIndex;
                                noinit u8[32] buffer;
                                b3Vec3 anchor = draw.drawAnchorA != 0 ? mp.anchorA : mp.anchorB;
                                b3Pos p = b3OffsetPos(contactCenter, anchor);
                                f32 weight = b3ClampFloat(2.0f - mp.separation * invTau, 1.0e-10f, 1.0f);
                                frictionAnchor = b3MulAdd(frictionAnchor, weight, anchor);
                                totalWeight += weight;
                                if draw.drawContactNormals != 0 {
                                    b3Pos p1 = p;
                                    b3Pos p2 = b3OffsetPos(p1, b3MulSV(axisScale, normal));
                                    draw.DrawSegmentFcn(p1, p2, b3_colorLightGray, draw.context);
                                    snprintf(buffer, cast(i32, sizeof(buffer) / sizeof(buffer[0])), "   %.2f", 100.0f * mp.separation);
                                    draw.DrawStringFcn(p, buffer, b3_colorWhite, draw.context);
                                } else if draw.drawContactForces != 0 {
                                    f32 inv_dt = world.inv_dt > 0.0f ? world.inv_dt : 60.0f;
                                    f32 force = 0.5f * mp.totalNormalImpulse * inv_dt;
                                    b3Pos p1 = p;
                                    b3Pos p2 = b3OffsetPos(p1, b3MulSV(draw.forceScale * force, normal));
                                    draw.DrawSegmentFcn(p1, p2, impulseColor, draw.context);
                                    snprintf(buffer, cast(i32, sizeof(buffer) / sizeof(buffer[0])), "  %.1f", force);
                                    draw.DrawStringFcn(p1, buffer, b3_colorWhite, draw.context);
                                } else if draw.drawContactFeatures != 0 {
                                    snprintf(buffer, cast(i32, sizeof(buffer) / sizeof(buffer[0])), "   %#X", mp.featureId);
                                    draw.DrawStringFcn(p, buffer, b3_colorWhite, draw.context);
                                }
                                if draw.drawGraphColors != 0 {
                                    f32 pointSize = contact.colorIndex == 24 - 1 ? 15.0f : 10.0f;
                                    draw.DrawPointFcn(p, pointSize, graphColors[contact.colorIndex], draw.context);
                                } else if mp.persisted == false {
                                    draw.DrawPointFcn(p, 20.0f, addColor, draw.context);
                                } else if mp.separation > speculativeDistance {
                                    draw.DrawPointFcn(p, 10.0f, farColor, draw.context);
                                } else if mp.separation > 0.0f {
                                    draw.DrawPointFcn(p, 10.0f, speculativeColor, draw.context);
                                } else {
                                    draw.DrawPointFcn(p, 10.0f, persistColor, draw.context);
                                }
                            }
                            if draw.drawContactForces != 0 {
                                f32 inv_dt = world.inv_dt > 0.0f ? world.inv_dt : 60.0f;
                                frictionAnchor = b3MulSV(1.0f / totalWeight, frictionAnchor);
                                b3Pos p1 = b3OffsetPos(contactCenter, frictionAnchor);
                                b3Vec3 frictionForce = b3MulSV(0.5f * inv_dt, manifold.frictionImpulse);
                                b3Pos p2 = b3OffsetPos(p1, b3MulSV(draw.forceScale, frictionForce));
                                draw.DrawSegmentFcn(p1, p2, frictionColor, draw.context);
                                draw.DrawPointFcn(p1, 5.0f, frictionColor, draw.context);
                                p1 = b3OffsetPos(p1, b3MulSV(0.05f * lengthScale, normal));
                                noinit u8[32] buffer;
                                snprintf(buffer, cast(i32, sizeof(buffer) / sizeof(buffer[0])), "%.2f", b3Length(frictionForce));
                                draw.DrawStringFcn(p1, buffer, b3_colorWhite, draw.context);
                            }
                        }
                        b3SetBit(&world.debugContactSet, cast(u32, contactId));
                    }
                    contactKey = contact.edges[edgeIndex].nextKey;
                }
            }
            if draw.drawIslands != 0 {
                i32 islandId = body.islandId;
                if islandId != -1 && b3GetBit(&world.debugIslandSet, cast(u32, islandId)) == false {
                    b3Island* island = world.islands.data + islandId;
                    if island.setIndex == -1 {
                        continue;
                    }
                    i32 shapeCount = 0;
                    var aabb = b3AABB{
                        .lowerBound = b3Vec3{FLT_MAX, FLT_MAX, FLT_MAX},
                        .upperBound = b3Vec3{-FLT_MAX, -FLT_MAX, -FLT_MAX},
                    };
                    for i32 b = 0; b < island.bodies.count; ++b {
                        i32 islandBodyId = island.bodies.data[b];
                        b3Body* islandBody = world.bodies.data + islandBodyId;
                        i32 shapeId = islandBody.headShapeId;
                        while shapeId != -1 {
                            b3Shape* shape = world.shapes.data + shapeId;
                            aabb = b3AABB_Union(aabb, shape.fatAABB);
                            shapeCount += 1;
                            shapeId = shape.nextShapeId;
                        }
                    }
                    if shapeCount > 0 {
                        draw.DrawBoundsFcn(aabb, b3_colorOrangeRed, draw.context);
                    }
                    b3SetBit(&world.debugIslandSet, cast(u32, islandId));
                }
            }
            word = word & word - 1;
        }
    }
    u8[32] buffer;
    f32 lengthUnits = b3GetLengthUnitsPerMeter();
    var offset = b3Vec3{0.002f * lengthUnits, 0.002f * lengthUnits, 0.002f * lengthUnits};
    for i32 i = 0; i < world.workerCount; ++i {
        i32 pointCount = world.taskContexts.data[i].pointCount;
        b3DebugPoint* points = world.taskContexts.data[i].points;
        for i32 j = 0; j < pointCount; ++j {
            b3DebugPoint* point = points + j;
            b3Pos p = point.p;
            draw.DrawPointFcn(p, 5.0f, point.color, draw.context);
            snprintf(buffer, 32, "   %d, %.2f", point.label, point.value);
            b3Pos ps = b3OffsetPos(p, offset);
            draw.DrawStringFcn(ps, buffer, point.color, draw.context);
        }
        i32 lineCount = world.taskContexts.data[i].lineCount;
        b3DebugLine* lines = world.taskContexts.data[i].lines;
        for i32 j = 0; j < lineCount; ++j {
            b3DebugLine* line = lines + j;
            b3Pos p1 = line.p1;
            b3Pos p2 = line.p2;
            draw.DrawSegmentFcn(p1, p2, line.color, draw.context);
            draw.DrawPointFcn(p1, 10.0f, line.color, draw.context);
            snprintf(buffer, 32, "%d", line.label);
            b3Pos ps = b3OffsetPos(p1, offset);
            draw.DrawStringFcn(ps, buffer, line.color, draw.context);
        }
    }
}

b3AABB b3World_GetBounds(b3WorldId worldId) {
    b3World* world = b3GetUnlockedWorldFromId(worldId);
    if world == null {
        return b3AABB{};
    }
    b3AABB worldBounds;
    bool haveBounds = false;
    for i32 i = 0; i < b3_bodyTypeCount; ++i {
        b3DynamicTree* tree = world.broadPhase.trees + i;
        if b3DynamicTree_GetProxyCount(tree) == 0 {
            continue;
        }
        b3AABB bounds = b3DynamicTree_GetRootBounds(world.broadPhase.trees + i);
        if haveBounds != 0 {
            worldBounds = b3AABB_Union(worldBounds, bounds);
        } else {
            worldBounds = bounds;
            haveBounds = true;
        }
    }
    return worldBounds;
}

