void b3DestroyJointInternal(b3World* world, b3Joint* joint, bool wakeBodies) {
    i32 jointId = joint.jointId;
    b3JointEdge* edgeA = joint.edges + 0;
    b3JointEdge* edgeB = joint.edges + 1;
    i32 idA = edgeA.bodyId;
    i32 idB = edgeB.bodyId;
    b3Body* bodyA = world.bodies.data + idA;
    b3Body* bodyB = world.bodies.data + idB;
    if edgeA.prevKey != -1 {
        b3Joint* prevJoint = world.joints.data + (edgeA.prevKey >> 1);
        b3JointEdge* prevEdge = prevJoint.edges + (edgeA.prevKey & 1);
        prevEdge.nextKey = edgeA.nextKey;
    }
    if edgeA.nextKey != -1 {
        b3Joint* nextJoint = world.joints.data + (edgeA.nextKey >> 1);
        b3JointEdge* nextEdge = nextJoint.edges + (edgeA.nextKey & 1);
        nextEdge.prevKey = edgeA.prevKey;
    }
    i32 edgeKeyA = jointId << 1 | 0;
    if bodyA.headJointKey == edgeKeyA {
        bodyA.headJointKey = edgeA.nextKey;
    }
    bodyA.jointCount -= 1;
    if edgeB.prevKey != -1 {
        b3Joint* prevJoint = world.joints.data + (edgeB.prevKey >> 1);
        b3JointEdge* prevEdge = prevJoint.edges + (edgeB.prevKey & 1);
        prevEdge.nextKey = edgeB.nextKey;
    }
    if edgeB.nextKey != -1 {
        b3Joint* nextJoint = world.joints.data + (edgeB.nextKey >> 1);
        b3JointEdge* nextEdge = nextJoint.edges + (edgeB.nextKey & 1);
        nextEdge.prevKey = edgeB.prevKey;
    }
    i32 edgeKeyB = jointId << 1 | 1;
    if bodyB.headJointKey == edgeKeyB {
        bodyB.headJointKey = edgeB.nextKey;
    }
    bodyB.jointCount -= 1;
    if joint.islandId != -1 {
        b3UnlinkJoint(world, joint);
    } else {
    }
    i32 setIndex = joint.setIndex;
    i32 localIndex = joint.localIndex;
    if setIndex == b3_awakeSet {
        b3RemoveJointFromGraph(world, joint.edges[0].bodyId, joint.edges[1].bodyId, joint.colorIndex, localIndex);
    } else {
        b3SolverSet* set = world.solverSets.data + setIndex;
        i32 movedIndex = b3RemoveHelper(set.jointSims.data, &set.jointSims.count, localIndex, cast(i32, sizeof(*set.jointSims.data)));
        if movedIndex != -1 {
            b3JointSim* movedJointSim = set.jointSims.data + localIndex;
            i32 movedId = movedJointSim.jointId;
            b3Joint* movedJoint = world.joints.data + movedId;
            movedJoint.localIndex = localIndex;
        }
    }
    joint.setIndex = -1;
    joint.localIndex = -1;
    joint.colorIndex = -1;
    joint.jointId = -1;
    b3FreeId(&world.jointIdPool, jointId);
    if wakeBodies != 0 {
        b3WakeBody(world, bodyA);
        b3WakeBody(world, bodyB);
    }
    b3ValidateSolverSets(world);
}

void b3DestroyJoint(b3JointId jointId, bool wakeAttached) {
    b3World* world = b3GetWorld(cast(i32, jointId.world0));
    if world == null {
        return;
    }
    while true {
        if world.recording != null {
            var recArgs = b3RecArgs_DestroyJoint{jointId, wakeAttached};
            b3RecWrite_DestroyJoint(world.recording, &recArgs);
        }
        if !(0 != 0) { break; }
    }
    b3Joint* joint = b3GetJointFullId(world, jointId);
    b3DestroyJointInternal(world, joint, wakeAttached);
}

