/*--------------------------------------------------------------------------------------------------------------------*/
/*                                               Common header section                                                */
/*--------------------------------------------------------------------------------------------------------------------*/
/*--------------------------------------------------------------------------------------------------------------------*/
/*                                                  Prefixed structs                                                  */
/*--------------------------------------------------------------------------------------------------------------------*/
when !(defined(IMPLEMENTATION_MODE)) {
}
/*--------------------------------------------------------------------------------------------------------------------*/
/*                                                Function prototypes                                                 */
/*--------------------------------------------------------------------------------------------------------------------*/
when !(defined(IMPLEMENTATION_MODE)) {

// Erases the key pointed to by itr and returns an iterator to the next key in the table.
// This function must be inlined to ensure that the compiler optimizes away the NAME_fast_forward call if the returned
// iterator is discarded.
private {
b3RecTagMap_itr b3RecTagMap_erase_itr(b3RecTagMap* table, b3RecTagMap_itr itr) {
    if b3RecTagMap_erase_itr_raw(table, itr) != 0 {
        return b3RecTagMap_next(itr);
    }
    return itr;
}
}
}
/*--------------------------------------------------------------------------------------------------------------------*/
/*                                              Function implementations                                              */
/*--------------------------------------------------------------------------------------------------------------------*/
when !(defined(HEADER_MODE)) {
// Default settings.

private {
void b3RecTagMap_init(b3RecTagMap* table) {
    table.key_count = 0;
    table.buckets_mask = 0x0000000000000000;
    table.buckets = null;
    table.metadata = &vt_empty_placeholder_metadatum;
}

// For efficiency, especially in the case of a small table, the buckets array and metadata share the same dynamic memory
// allocation:
//   +-----------------------------+-----+----------------+--------+
//   |           Buckets           | Pad |    Metadata    | Excess |
//   +-----------------------------+-----+----------------+--------+
// Any allocated metadata array requires four excess elements to ensure that iteration functions, which read four
// metadata at a time, never read beyond the end of it.
// This function returns the offset of the beginning of the metadata, i.e. the size of the buckets array plus the
// (usually zero) padding.
// It assumes that the bucket count is not zero.
u64 b3RecTagMap_metadata_offset(b3RecTagMap* table) {
    return ((table.buckets_mask + 1) * cast(u64, sizeof(b3RecTagMap_bucket)) + cast(u64, sizeof(u16)) - 1) / cast(u64, sizeof(u16)) * cast(u64, sizeof(u16));
}

// Returns the total allocation size, including the buckets array, padding, metadata, and excess metadata.
// As above, this function assumes that the bucket count is not zero.
u64 b3RecTagMap_total_alloc_size(b3RecTagMap* table) {
    return b3RecTagMap_metadata_offset(table) + (table.buckets_mask + 1 + 4) * cast(u64, sizeof(u16));
}

bool b3RecTagMap_init_clone(b3RecTagMap* table, b3RecTagMap* source) {
    table.key_count = source.key_count;
    table.buckets_mask = source.buckets_mask;
    if source.buckets_mask == 0 {
        table.metadata = &vt_empty_placeholder_metadatum;
        table.buckets = null;
        return true;
    }
    void* allocation = b3Alloc(b3RecTagMap_total_alloc_size(table));
    if allocation == null {
        return false;
    }
    table.buckets = cast(b3RecTagMap_bucket*, allocation);
    table.metadata = cast(u16*, cast(u8*, allocation) + b3RecTagMap_metadata_offset(table));
    memcpy(allocation, source.buckets, b3RecTagMap_total_alloc_size(table));
    return true;
}

u64 b3RecTagMap_size(b3RecTagMap* table) {
    return table.key_count;
}

u64 b3RecTagMap_bucket_count(b3RecTagMap* table) {
    return table.buckets_mask + cast(u64, cast(bool, table.buckets_mask));
}

bool b3RecTagMap_is_end(b3RecTagMap_itr itr) {
    return itr.metadatum == itr.metadata_end;
}

// Finds the earliest empty bucket in which a key belonging to home_bucket can be placed, assuming that home_bucket
// is already occupied.
// The reason to begin the search at home_bucket, rather than the end of the existing chain, is that keys deleted from
// other chains might have freed up buckets that could fall in this chain before the final key.
// Returns true if an empty bucket within the range of the displacement limit was found, in which case the final two
// pointer arguments contain the index of the empty bucket and its quadratic displacement from home_bucket.
bool b3RecTagMap_find_first_empty(b3RecTagMap* table, u64 home_bucket, u64* empty, u16* displacement) {
    *displacement = 1;
    u64 linear_dispacement = 1;
    while true {
        *empty = home_bucket + linear_dispacement & table.buckets_mask;
        if table.metadata[*empty] == 0x0000 {
            return true;
        }
        if ++*displacement == 0x07FF {
            return false;
        }
        linear_dispacement += *displacement;
    }
}

// Finds the key in the chain beginning in home_bucket after which to link a new key with displacement_to_empty
// quadratic displacement and returns the index of the bucket containing that key.
// Although the new key could simply be linked to the end of the chain, keeping the chain ordered by displacement
// theoretically improves cache locality during lookups.
u64 b3RecTagMap_find_insert_location_in_chain(b3RecTagMap* table, u64 home_bucket, u16 displacement_to_empty) {
    u64 candidate = home_bucket;
    while true {
        u16 displacement = table.metadata[candidate] & 0x07FF;
        if displacement > displacement_to_empty {
            return candidate;
        }
        candidate = home_bucket + vt_quadratic(displacement) & table.buckets_mask;
    }
}

// Frees up a bucket occupied by a key not belonging there so that a new key belonging there can be placed there as the
// beginning of a new chain.
// This requires:
// * Finding the previous key in the chain to which the occupying key belongs by rehashing it and then traversing the
//   chain.
// * Disconnecting the key from the chain.
// * Finding the appropriate empty bucket to which to move the key.
// * Moving the key (and value) data to the empty bucket.
// * Re-linking the key to the chain.
// Returns true if the eviction succeeded, or false if no empty bucket to which to evict the occupying key could be
// found within the displacement limit.
bool b3RecTagMap_evict(b3RecTagMap* table, u64 bucket) {
    u64 home_bucket = vt_hash_integer(table.buckets[bucket].key) & table.buckets_mask;
    u64 prev = home_bucket;
    while true {
        u64 next = home_bucket + vt_quadratic(table.metadata[prev] & 0x07FF) & table.buckets_mask;
        if next == bucket {
            break;
        }
        prev = next;
    }
    table.metadata[prev] = cast(u16, table.metadata[prev] & ~0x07FF | table.metadata[bucket] & 0x07FF);
    u64 empty;
    u16 displacement;
    if b3RecTagMap_find_first_empty(table, home_bucket, &empty, &displacement) == 0 {
        return false;
    }
    prev = b3RecTagMap_find_insert_location_in_chain(table, home_bucket, displacement);
    table.buckets[empty] = table.buckets[bucket];
    table.metadata[empty] = table.metadata[bucket] & 0xF000 | table.metadata[prev] & 0x07FF;
    table.metadata[prev] = cast(u16, table.metadata[prev] & ~0x07FF | displacement);
    return true;
}

// Returns an end iterator, i.e. any iterator for which .metadatum == .metadata_end.
// This function just cleans up the library code in functions that return an end iterator as a failure indicator.
b3RecTagMap_itr b3RecTagMap_end_itr() {
    b3RecTagMap_itr itr;
    return itr;
}

// Inserts a key, optionally replacing the existing key if it already exists.
// There are two main cases that must be handled:
// * If the key's home bucket is empty or occupied by a key that does not belong there, then the key is inserted there,
//   evicting the occupying key if there is one.
// * Otherwise, the chain of keys beginning at the home bucket is (if unique is false) traversed in search of a matching
//   key.
//   If none is found, then the new key is inserted at the earliest available bucket, per quadratic probing from the
//   home bucket, and then linked to the chain in a manner that maintains its quadratic order.
// The unique argument tells the function whether to skip searching for the key before inserting it (on rehashing, this
// step is unnecessary).
// The replace argument tells the function whether to replace an existing key.
// If replace is true, the function returns an iterator to the inserted key, or an end iterator if the key was not
// inserted because of the maximum load factor or displacement limit constraints.
// If replace is false, then the return value is as described above, except that if the key already exists, the function
// returns an iterator to the existing key.
b3RecTagMap_itr b3RecTagMap_insert_raw(b3RecTagMap* table, u64 key, u32* val, bool unique, bool replace) {
    u64 hash = vt_hash_integer(key);
    u16 hashfrag = vt_hashfrag(hash);
    u64 home_bucket = hash & table.buckets_mask;
    if (table.metadata[home_bucket] & 0x0800) == 0 {
        if cast(f64, table.key_count + 1) > cast(f64, b3RecTagMap_bucket_count(table)) * 0.9 || table.metadata[home_bucket] != 0x0000 && !b3RecTagMap_evict(table, home_bucket) {
            return b3RecTagMap_end_itr();
        }
        table.buckets[home_bucket].key = key;
        table.buckets[home_bucket].val = *val;
        table.metadata[home_bucket] = hashfrag | 0x0800 | 0x07FF;
        ++table.key_count;
        var itr = b3RecTagMap_itr{
            table.buckets + home_bucket, table.metadata + home_bucket,
            table.metadata + table.buckets_mask + 1, home_bucket,
        };
        return itr;
    }
    if unique == 0 {
        u64 bucket = home_bucket;
        while true {
            if (table.metadata[bucket] & 0xF000) == hashfrag && vt_cmpr_integer(table.buckets[bucket].key, key) {
                if replace != 0 {
                    table.buckets[bucket].key = key;
                    table.buckets[bucket].val = *val;
                }
                var itr = b3RecTagMap_itr{
                    table.buckets + bucket, table.metadata + bucket,
                    table.metadata + table.buckets_mask + 1, home_bucket,
                };
                return itr;
            }
            u16 displacement = table.metadata[bucket] & 0x07FF;
            if displacement == 0x07FF {
                break;
            }
            bucket = home_bucket + vt_quadratic(displacement) & table.buckets_mask;
        }
    }
    u64 empty;
    u16 displacement;
    if cast(f64, table.key_count + 1) > cast(f64, b3RecTagMap_bucket_count(table)) * 0.9 || !b3RecTagMap_find_first_empty(table, home_bucket, &empty, &displacement) {
        return b3RecTagMap_end_itr();
    }
    u64 prev = b3RecTagMap_find_insert_location_in_chain(table, home_bucket, displacement);
    table.buckets[empty].key = key;
    table.buckets[empty].val = *val;
    table.metadata[empty] = hashfrag | table.metadata[prev] & 0x07FF;
    table.metadata[prev] = cast(u16, table.metadata[prev] & ~0x07FF | displacement);
    ++table.key_count;
    var itr = b3RecTagMap_itr{
        table.buckets + empty, table.metadata + empty, table.metadata + table.buckets_mask + 1,
        home_bucket,
    };
    return itr;
}

// Resizes the bucket array.
// This function assumes that bucket_count is a power of two and large enough to accommodate all keys without violating
// the maximum load factor.
// Returns false in the case of allocation failure.
// As this function is called very rarely in _insert and _get_or_insert, ideally it should not be inlined into those
// functions.
// In testing, the no-inline approach showed a performance benefit when inserting existing keys (i.e. replacing).
bool b3RecTagMap_rehash(b3RecTagMap* table, u64 bucket_count) {
    while true {
        var new_table = b3RecTagMap{0, bucket_count - 1, null, null};
        void* allocation = b3Alloc(b3RecTagMap_total_alloc_size(&new_table));
        if allocation == null {
            return false;
        }
        new_table.buckets = cast(b3RecTagMap_bucket*, allocation);
        new_table.metadata = cast(u16*, cast(u8*, allocation) + b3RecTagMap_metadata_offset(&new_table));
        memset(new_table.metadata, 0x00, (bucket_count + 4) * cast(u64, sizeof(u16)));
        new_table.metadata[bucket_count] = 0x01;
        for u64 bucket = 0; bucket < b3RecTagMap_bucket_count(table); ++bucket {
            if table.metadata[bucket] != 0x0000 {
                b3RecTagMap_itr itr = b3RecTagMap_insert_raw(&new_table, table.buckets[bucket].key, &table.buckets[bucket].val, true, false);
                if b3RecTagMap_is_end(itr) != 0 {
                    break;
                }
            }
        }
        if new_table.key_count < table.key_count {
            b3Free(new_table.buckets, b3RecTagMap_total_alloc_size(&new_table));
            bucket_count *= 2;
            continue;
        }
        if table.buckets_mask != 0 {
            b3Free(table.buckets, b3RecTagMap_total_alloc_size(table));
        }
        *table = new_table;
        return true;
    }
}

// Inserts a key, replacing the existing key if it already exists.
// This function wraps insert_raw in a loop that handles growing and rehashing the table if a new key cannot be inserted
// because of the maximum load factor or displacement limit constraints.
// Returns an iterator to the inserted key, or an end iterator in the case of allocation failure.
b3RecTagMap_itr b3RecTagMap_insert(b3RecTagMap* table, u64 key, u32 val) {
    while true {
        b3RecTagMap_itr itr = b3RecTagMap_insert_raw(table, key, &val, false, true);
        if !b3RecTagMap_is_end(itr) || !b3RecTagMap_rehash(table, table.buckets_mask != 0 ? b3RecTagMap_bucket_count(table) * 2 : 8) {
            return itr;
        }
    }
}

// Same as NAME_insert, except that if the key already exists, no insertion occurs and the function returns an iterator
// to the existing key.
b3RecTagMap_itr b3RecTagMap_get_or_insert(b3RecTagMap* table, u64 key, u32 val) {
    while true {
        b3RecTagMap_itr itr = b3RecTagMap_insert_raw(table, key, &val, false, false);
        if !b3RecTagMap_is_end(itr) || !b3RecTagMap_rehash(table, table.buckets_mask != 0 ? b3RecTagMap_bucket_count(table) * 2 : 8) {
            return itr;
        }
    }
}

// Returns an iterator pointing to the specified key, or an end iterator if the key does not exist.
b3RecTagMap_itr b3RecTagMap_get(b3RecTagMap* table, u64 key) {
    u64 hash = vt_hash_integer(key);
    u64 home_bucket = hash & table.buckets_mask;
    if (table.metadata[home_bucket] & 0x0800) == 0 {
        return b3RecTagMap_end_itr();
    }
    u16 hashfrag = vt_hashfrag(hash);
    u64 bucket = home_bucket;
    while true {
        if (table.metadata[bucket] & 0xF000) == hashfrag && vt_cmpr_integer(table.buckets[bucket].key, key) {
            var itr = b3RecTagMap_itr{
                table.buckets + bucket, table.metadata + bucket,
                table.metadata + table.buckets_mask + 1, home_bucket,
            };
            return itr;
        }
        u16 displacement = table.metadata[bucket] & 0x07FF;
        if displacement == 0x07FF {
            return b3RecTagMap_end_itr();
        }
        bucket = home_bucket + vt_quadratic(displacement) & table.buckets_mask;
    }
}

// Erases the key pointed to by the specified iterator.
// The erasure always occurs at the end of the chain to which the key belongs.
// If the key to be erased is not the last in the chain, it is swapped with the last so that erasure occurs at the end.
// This helps keep a chain's keys close to their home bucket for the sake of cache locality.
// Returns true if, in the case of iteration from first to end, NAME_next should now be called on the iterator to find
// the next key.
// This return value is necessary because at the iterator location, the erasure could result in an empty bucket, a
// bucket containing a moved key already visited during the iteration, or a bucket containing a moved key not yet
// visited.
bool b3RecTagMap_erase_itr_raw(b3RecTagMap* table, b3RecTagMap_itr itr) {
    --table.key_count;
    var itr_bucket = cast(u64, cast(i64, itr.metadatum - table.metadata));
    if table.metadata[itr_bucket] & 0x0800 && (table.metadata[itr_bucket] & 0x07FF) == 0x07FF {
        table.metadata[itr_bucket] = 0x0000;
        return true;
    }
    if itr.home_bucket == SIZE_MAX {
        if (table.metadata[itr_bucket] & 0x0800) != 0 {
            itr.home_bucket = itr_bucket;
        } else {
            itr.home_bucket = vt_hash_integer(table.buckets[itr_bucket].key) & table.buckets_mask;
        }
    }
    if (table.metadata[itr_bucket] & 0x07FF) == 0x07FF {
        u64 bucket = itr.home_bucket;
        while true {
            u16 displacement = table.metadata[bucket] & 0x07FF;
            u64 next = itr.home_bucket + vt_quadratic(displacement) & table.buckets_mask;
            if next == itr_bucket {
                table.metadata[bucket] |= 0x07FF;
                table.metadata[itr_bucket] = 0x0000;
                return true;
            }
            bucket = next;
        }
    }
    u64 bucket = itr_bucket;
    while true {
        u64 prev = bucket;
        bucket = itr.home_bucket + vt_quadratic(table.metadata[bucket] & 0x07FF) & table.buckets_mask;
        if (table.metadata[bucket] & 0x07FF) == 0x07FF {
            table.buckets[itr_bucket] = table.buckets[bucket];
            table.metadata[itr_bucket] = cast(u16, table.metadata[itr_bucket] & ~0xF000 | table.metadata[bucket] & 0xF000);
            table.metadata[prev] |= 0x07FF;
            table.metadata[bucket] = 0x0000;
            if bucket > itr_bucket {
                return false;
            }
            return true;
        }
    }
}

// Erases the specified key, if it exists.
// Returns true if a key was erased.
bool b3RecTagMap_erase(b3RecTagMap* table, u64 key) {
    b3RecTagMap_itr itr = b3RecTagMap_get(table, key);
    if b3RecTagMap_is_end(itr) != 0 {
        return false;
    }
    b3RecTagMap_erase_itr_raw(table, itr);
    return true;
}

// Finds the first occupied bucket at or after the bucket pointed to by itr.
// This function scans four buckets at a time, ideally using intrinsics.
void b3RecTagMap_fast_forward(b3RecTagMap_itr* itr) {
    while true {
        u64 metadata;
        memcpy(&metadata, itr.metadatum, sizeof(u64));
        if metadata != 0 {
            i32 offset = vt_first_nonzero_uint16(metadata);
            itr.data += offset;
            itr.metadatum += offset;
            itr.home_bucket = SIZE_MAX;
            return;
        }
        itr.data += 4;
        itr.metadatum += 4;
    }
}

b3RecTagMap_itr b3RecTagMap_next(b3RecTagMap_itr itr) {
    ++itr.data;
    ++itr.metadatum;
    b3RecTagMap_fast_forward(&itr);
    return itr;
}

// Returns the minimum bucket count required to accommodate a certain number of keys, which is governed by the maximum
// load factor.
u64 b3RecTagMap_min_bucket_count_for_size(u64 size) {
    if size == 0 {
        return 0;
    }
    u64 bucket_count = 8;
    while cast(f64, size) > cast(f64, bucket_count) * 0.9 {
        bucket_count *= 2;
    }
    return bucket_count;
}

bool b3RecTagMap_reserve(b3RecTagMap* table, u64 size) {
    u64 bucket_count = b3RecTagMap_min_bucket_count_for_size(size);
    if bucket_count <= b3RecTagMap_bucket_count(table) {
        return true;
    }
    return b3RecTagMap_rehash(table, bucket_count);
}

bool b3RecTagMap_shrink(b3RecTagMap* table) {
    u64 bucket_count = b3RecTagMap_min_bucket_count_for_size(table.key_count);
    if bucket_count == b3RecTagMap_bucket_count(table) {
        return true;
    }
    if bucket_count == 0 {
        b3Free(table.buckets, b3RecTagMap_total_alloc_size(table));
        table.buckets_mask = 0x0000000000000000;
        table.metadata = &vt_empty_placeholder_metadatum;
        return true;
    }
    return b3RecTagMap_rehash(table, bucket_count);
}

b3RecTagMap_itr b3RecTagMap_first(b3RecTagMap* table) {
    if table.key_count == 0 {
        return b3RecTagMap_end_itr();
    }
    var itr = b3RecTagMap_itr{
        table.buckets, table.metadata, table.metadata + table.buckets_mask + 1, SIZE_MAX,
    };
    b3RecTagMap_fast_forward(&itr);
    return itr;
}

void b3RecTagMap_clear(b3RecTagMap* table) {
    if table.key_count == 0 {
        return;
    }
    for u64 i = 0; i < b3RecTagMap_bucket_count(table); ++i {
        if table.metadata[i] != 0x0000 {
        }
        table.metadata[i] = 0x0000;
    }
    table.key_count = 0;
}

void b3RecTagMap_cleanup(b3RecTagMap* table) {
    if table.buckets_mask == 0 {
        return;
    }
    when defined(KEY_DTOR_FN) || defined(VAL_DTOR_FN) {
        b3RecTagMap_clear(table);
    }
    b3Free(table.buckets, b3RecTagMap_total_alloc_size(table));
    b3RecTagMap_init(table);
}
}
}

// Append a fresh entry and splice it onto the front of its hash chain. The map value is the chain head.
private {
u32 b3RegistryPush(b3GeometryRegistry* reg, b3GeometryHashMap* map, b3GeometryHashMap_itr itr, bool hashPresent, b3GeometryKind kind, u64 contentHash, u8* bytes, i32 byteCount) {
    if reg.count >= reg.capacity {
        i32 newCap = reg.capacity < 8 ? 8 : reg.capacity * 2;
        reg.entries = cast(b3GeometryEntry*, b3GrowAlloc(reg.entries, reg.capacity * cast(i32, sizeof(b3GeometryEntry)), newCap * cast(i32, sizeof(b3GeometryEntry))));
        reg.capacity = newCap;
    }
    var id = cast(u32, reg.count);
    b3GeometryEntry* entry = reg.entries + reg.count;
    entry.contentHash = contentHash;
    entry.id = id;
    entry.kind = kind;
    entry.byteCount = byteCount;
    entry.bytes = bytes;
    entry.hashNext = hashPresent != 0 ? cast(i32, itr.data.val) : -1;
    reg.count++;
    if hashPresent != 0 {
        itr.data.val = id;
    } else {
        b3GeometryHashMap_insert(map, contentHash, id);
    }
    return id;
}

b3GeometryHashMap* b3RegistryMap(b3GeometryRegistry* reg) {
    if reg.dedupMap == null {
        var fresh = cast(b3GeometryHashMap*, b3Alloc(cast(u64, sizeof(b3GeometryHashMap))));
        b3GeometryHashMap_init(fresh);
        reg.dedupMap = fresh;
    }
    return cast(b3GeometryHashMap*, reg.dedupMap);
}
}

u32 b3InternGeometry(b3GeometryRegistry* reg, b3GeometryKind kind, u64 contentHash, u8* bytes, i32 byteCount) {
    b3GeometryHashMap* map = b3RegistryMap(reg);
    b3GeometryHashMap_itr itr = b3GeometryHashMap_get(map, contentHash);
    bool hashPresent = b3GeometryHashMap_is_end(itr) == false;
    if hashPresent != 0 {
        for i32 idx = cast(i32, itr.data.val); idx != -1; idx = reg.entries[idx].hashNext {
            b3GeometryEntry* e = reg.entries + idx;
            if e.byteCount == byteCount && memcmp(e.bytes, bytes, cast(u64, byteCount)) == 0 {
                b3Free(bytes, cast(u64, byteCount));
                return e.id;
            }
        }
    }
    return b3RegistryPush(reg, map, itr, hashPresent, kind, contentHash, bytes, byteCount);
}

u32 b3AppendGeometry(b3GeometryRegistry* reg, b3GeometryKind kind, u64 contentHash, u8* bytes, i32 byteCount) {
    b3GeometryHashMap* map = b3RegistryMap(reg);
    b3GeometryHashMap_itr itr = b3GeometryHashMap_get(map, contentHash);
    bool hashPresent = b3GeometryHashMap_is_end(itr) == false;
    return b3RegistryPush(reg, map, itr, hashPresent, kind, contentHash, bytes, byteCount);
}

void b3FreeRegistry(b3GeometryRegistry* reg) {
    for i32 i = 0; i < reg.count; ++i {
        b3Free(reg.entries[i].bytes, cast(u64, reg.entries[i].byteCount));
    }
    if reg.entries != null {
        b3Free(reg.entries, cast(u64, reg.capacity * cast(i32, sizeof(b3GeometryEntry))));
    }
    if reg.dedupMap != null {
        b3GeometryHashMap_cleanup(cast(b3GeometryHashMap*, reg.dedupMap));
        b3Free(reg.dedupMap, cast(u64, sizeof(b3GeometryHashMap)));
    }
    reg.entries = null;
    reg.count = 0;
    reg.capacity = 0;
    reg.dedupMap = null;
}

u64 b3HashQueryTag(u64 id, u8* name) {
    u64 h = -3750763034362895579;
    for i32 i = 0; i < 8; ++i {
        h = (h ^ id >> cast(u64, 8 * i) & 0xFF) * 1099511628211;
    }
    if name != null {
        for i32 i = 0; name[i] != 0; ++i {
            h = (h ^ cast(u8, name[i])) * 1099511628211;
        }
    }
    return h != 0 ? h : 1;
}

private {
b3RecTagMap* b3RecTags(b3Recording* rec) {
    if rec.tagMap == null {
        b3RecTagMap* fresh = b3Alloc(cast(u64, sizeof(b3RecTagMap)));
        b3RecTagMap_init(fresh);
        rec.tagMap = fresh;
    }
    return rec.tagMap;
}
}

void b3RecInternTag(b3Recording* rec, u64 key, u64 id, u8* name) {
    b3RecTagMap* map = b3RecTags(rec);
    if b3RecTagMap_is_end(b3RecTagMap_get(map, key)) == false {
        return;
    }
    if rec.tagCount == rec.tagCapacity {
        i32 newCap = rec.tagCapacity == 0 ? 8 : 2 * rec.tagCapacity;
        rec.tags = b3GrowAlloc(rec.tags, rec.tagCapacity * cast(i32, sizeof(b3RecTag)), newCap * cast(i32, sizeof(b3RecTag)));
        rec.tagCapacity = newCap;
    }
    var index = cast(u32, rec.tagCount);
    b3RecTag* tag = &rec.tags[rec.tagCount++];
    tag.key = key;
    tag.id = id;
    i32 n = 0;
    while name != null && name[n] != 0 && n < 64 {
        tag.queryName[n] = name[n];
        n++;
    }
    tag.queryName[n] = 0;
    b3RecTagMap_insert(map, key, index);
}

// Write the trailing registry block: u32 entryCount then per-entry { u8 kind, u32 byteCount, bytes },
// followed by the query-tag table { u32 tagCount, per-tag uu64 id, STR name }. A reader built before
// the tag table stops after the geometry entries and ignores the trailing tag bytes.
void b3RecWriteRegistry(b3Recording* rec) {
    b3RecW_U32(&rec.buffer, cast(u32, rec.registry.count));
    for i32 i = 0; i < rec.registry.count; ++i {
        b3GeometryEntry* e = rec.registry.entries + i;
        b3RecW_U8(&rec.buffer, cast(u8, e.kind));
        b3RecW_U32(&rec.buffer, cast(u32, e.byteCount));
        b3RecBufAppend(&rec.buffer, e.bytes, e.byteCount);
    }
    b3RecW_U32(&rec.buffer, cast(u32, rec.tagCount));
    for i32 i = 0; i < rec.tagCount; ++i {
        b3RecW_U64(&rec.buffer, rec.tags[i].key);
        b3RecW_U64(&rec.buffer, rec.tags[i].id);
        b3RecW_STR(&rec.buffer, rec.tags[i].queryName);
    }
}

// Lifecycle
b3Recording* b3CreateRecording(i32 byteCapacity) {
    var rec = cast(b3Recording*, b3Alloc(cast(u64, sizeof(b3Recording))));
    *rec = b3Recording{};
    i32 initCap = byteCapacity > 0 ? byteCapacity : 65536;
    rec.buffer.data = cast(u8*, b3Alloc(cast(u64, initCap)));
    rec.buffer.capacity = initCap;
    rec.buffer.size = 0;
    rec.lock = b3CreateMutex();
    return rec;
}

void b3DestroyRecording(b3Recording* recording) {
    if recording == null {
        return;
    }
    b3RecBufFree(&recording.buffer);
    b3FreeRegistry(&recording.registry);
    if recording.tags != null {
        b3Free(recording.tags, cast(u64, recording.tagCapacity) * cast(u64, sizeof(b3RecTag)));
    }
    if recording.tagMap != null {
        b3RecTagMap_cleanup(cast(b3RecTagMap*, recording.tagMap));
        b3Free(recording.tagMap, cast(u64, sizeof(b3RecTagMap)));
    }
    b3DestroyMutex(recording.lock);
    b3Free(recording, cast(u64, sizeof(b3Recording)));
}

u8* b3Recording_GetData(b3Recording* recording) {
    return recording.buffer.data;
}

i32 b3Recording_GetSize(b3Recording* recording) {
    return recording.buffer.size;
}

void b3RecAccumulateBounds(b3Recording* rec, b3AABB bounds) {
    rec.accumulatedBounds = rec.haveBounds != 0 ? b3AABB_Union(rec.accumulatedBounds, bounds) : bounds;
    rec.haveBounds = true;
}

void b3StartRecordingIntoBuffer(b3World* world, b3Recording* recording) {
    recording.buffer.size = 0;
    recording.recordStart = 0;
    recording.haveBounds = false;
    b3FreeRegistry(&recording.registry);
    if recording.tags != null {
        b3Free(recording.tags, cast(u64, recording.tagCapacity) * cast(u64, sizeof(b3RecTag)));
        recording.tags = null;
    }
    if recording.tagMap != null {
        b3RecTagMap_cleanup(cast(b3RecTagMap*, recording.tagMap));
        b3Free(recording.tagMap, cast(u64, sizeof(b3RecTagMap)));
        recording.tagMap = null;
    }
    recording.tagCount = 0;
    recording.tagCapacity = 0;
    b3RecHeader hdr;
    hdr.magic = 0x43523342;
    hdr.versionMajor = 4;
    hdr.versionMinor = 3;
    hdr.pointerWidth = cast(u8, sizeof(void*));
    hdr.bigEndian = 0;
    hdr.validationEnabled = cast(u8, 0 != 0 ? 1 : 0);
    hdr.lengthScale = b3GetLengthUnitsPerMeter();
    hdr.registryOffset = 0;
    hdr.registryByteCount = 0;
    world.recording = recording;
    b3RecBuffer snapBuf;
    b3SerializeWorld(world, &snapBuf, recording);
    hdr.snapshotSize = cast(u64, snapBuf.size);
    b3RecBufAppend(&recording.buffer, &hdr, cast(i32, sizeof(hdr)));
    b3RecBufAppend(&recording.buffer, snapBuf.data, snapBuf.size);
    b3RecBufFree(&snapBuf);
    var worldId = b3WorldId{cast(u16, world.worldId + 1), world.generation};
    var stateHash = b3RecArgs_StateHash{worldId, b3HashWorldState(world)};
    b3RecWrite_StateHash(recording, &stateHash);
}

void b3StopRecordingInternal(b3World* world) {
    if world.recording == null {
        return;
    }
    b3Recording* rec = world.recording;
    world.recording = null;
    b3RecArgs_RecordingBounds rb;
    if rec.haveBounds != 0 {
        rb.bounds = rec.accumulatedBounds;
    }
    b3RecWrite_RecordingBounds(rec, &rb);
    var wid = b3WorldId{cast(u16, world.worldId + 1), world.generation};
    var a = b3RecArgs_DestroyWorld{wid};
    b3RecWrite_DestroyWorld(rec, &a);
    i32 registryOffset = rec.buffer.size;
    b3RecWriteRegistry(rec);
    i32 registryByteCount = rec.buffer.size - registryOffset;
    u8* hdrBytes = rec.buffer.data;
    var regOff = cast(u64, registryOffset);
    var regSz = cast(u64, registryByteCount);
    u8* pOff = hdrBytes + cast(u32, &cast(b3RecHeader*, 0).registryOffset);
    u8* pSz = hdrBytes + cast(u32, &cast(b3RecHeader*, 0).registryByteCount);
    for i32 i = 0; i < 8; ++i {
        pOff[i] = cast(u8, regOff >> cast(u64, 8 * i));
        pSz[i] = cast(u8, regSz >> cast(u64, 8 * i));
    }
}

// Convenience file I/O
bool b3SaveRecordingToFile(b3Recording* recording, u8* path) {
    if recording == null || path == null {
        return false;
    }
    void* f = __b3_fopen(path, "wb");
    if f == null {
        return false;
    }
    u64 written = __b3_fwrite(recording.buffer.data, 1, cast(u64, recording.buffer.size), f);
    __b3_fclose(f);
    return cast(i32, written) == recording.buffer.size;
}

b3Recording* b3LoadRecordingFromFile(u8* path) {
    if path == null {
        return null;
    }
    void* f = __b3_fopen(path, "rb");
    if f == null {
        return null;
    }
    if __b3_fseek(f, 0, SEEK_END) != 0 {
        __b3_fclose(f);
        return null;
    }
    i32 fileSize = __b3_ftell(f);
    if fileSize < cast(i32, sizeof(b3RecHeader)) || fileSize > 2147483647 {
        __b3_fclose(f);
        return null;
    }
    __b3_fseek(f, 0, SEEK_SET);
    b3Recording* rec = b3CreateRecording(fileSize);
    u64 readSize = __b3_fread(rec.buffer.data, 1, cast(u64, fileSize), f);
    __b3_fclose(f);
    if cast(i32, readSize) != fileSize {
        b3DestroyRecording(rec);
        return null;
    }
    noinit b3RecHeader hdr;
    memcpy(&hdr, rec.buffer.data, cast(u64, sizeof(hdr)));
    if hdr.magic != 0x43523342 {
        b3DestroyRecording(rec);
        return null;
    }
    rec.buffer.size = fileSize;
    return rec;
}

// Geometry interning helpers
u32 b3RecInternHull(b3Recording* rec, b3HullData* hull) {
    i32 byteCount = hull.byteCount;
    var bytes = cast(u8*, b3Alloc(cast(u64, byteCount)));
    memcpy(bytes, hull, cast(u64, byteCount));
    u64 h = b3Hash64Blob(bytes, byteCount);
    return b3InternGeometry(&rec.registry, b3_geometryHull, h, bytes, byteCount);
}

u32 b3RecInternMesh(b3Recording* rec, b3MeshData* mesh) {
    i32 byteCount = mesh.byteCount;
    var bytes = cast(u8*, b3Alloc(cast(u64, byteCount)));
    memcpy(bytes, mesh, cast(u64, byteCount));
    u64 h = b3Hash64Blob(bytes, byteCount);
    return b3InternGeometry(&rec.registry, b3_geometryMesh, h, bytes, byteCount);
}

u32 b3RecInternHeightField(b3Recording* rec, b3HeightFieldData* hf) {
    i32 byteCount = hf.byteCount;
    var bytes = cast(u8*, b3Alloc(cast(u64, byteCount)));
    memcpy(bytes, hf, cast(u64, byteCount));
    u64 h = b3Hash64Blob(bytes, byteCount);
    return b3InternGeometry(&rec.registry, b3_geometryHeightField, h, bytes, byteCount);
}

u32 b3RecInternCompound(b3Recording* rec, b3CompoundData* compound) {
    i32 byteCount = compound.byteCount;
    var bytes = cast(u8*, b3Alloc(cast(u64, byteCount)));
    memcpy(bytes, compound, cast(u64, byteCount));
    cast(b3CompoundData*, bytes).tree.nodes = null;
    u64 h = b3Hash64Blob(bytes, byteCount);
    return b3InternGeometry(&rec.registry, b3_geometryCompound, h, bytes, byteCount);
}

u64 b3HashWorldState(b3World* world) {
    u64 hash = -3750763034362895579;
    u64 prime = 1099511628211;
    i32 bodyCount = world.bodies.count;
    for i32 i = 0; i < bodyCount; ++i {
        b3Body* body = world.bodies.data + i;
        if body.id != i {
            continue;
        }
        b3BodySim* sim = b3GetBodySim(world, body);
        u32 bits;
        hash = b3FnvMixPosition(hash, sim.transform.p);
        memcpy(&bits, &sim.transform.q.v.x, cast(u64, 4));
        hash = (hash ^ cast(u64, bits)) * prime;
        memcpy(&bits, &sim.transform.q.v.y, cast(u64, 4));
        hash = (hash ^ cast(u64, bits)) * prime;
        memcpy(&bits, &sim.transform.q.v.z, cast(u64, 4));
        hash = (hash ^ cast(u64, bits)) * prime;
        memcpy(&bits, &sim.transform.q.s, cast(u64, 4));
        hash = (hash ^ cast(u64, bits)) * prime;
        b3BodyState* state = b3GetBodyState(world, body);
        if state != null {
            memcpy(&bits, &state.linearVelocity.x, cast(u64, 4));
            hash = (hash ^ cast(u64, bits)) * prime;
            memcpy(&bits, &state.linearVelocity.y, cast(u64, 4));
            hash = (hash ^ cast(u64, bits)) * prime;
            memcpy(&bits, &state.linearVelocity.z, cast(u64, 4));
            hash = (hash ^ cast(u64, bits)) * prime;
            memcpy(&bits, &state.angularVelocity.x, cast(u64, 4));
            hash = (hash ^ cast(u64, bits)) * prime;
            memcpy(&bits, &state.angularVelocity.y, cast(u64, 4));
            hash = (hash ^ cast(u64, bits)) * prime;
            memcpy(&bits, &state.angularVelocity.z, cast(u64, 4));
            hash = (hash ^ cast(u64, bits)) * prime;
        }
    }
    return hash;
}

// SPDX-FileCopyrightText: 2026 Erin Catto
// SPDX-License-Identifier: MIT
// Read primitives
private {
void b3RecRdrCheck(b3RecReader* rdr, i32 size) {
    if size < 0 || cast(i64, rdr.cursor) + cast(i64, size) > cast(i64, rdr.size) {
        rdr.ok = false;
    }
}

void b3RecRdrBlob(b3RecReader* rdr, void* out, i32 size) {
    b3RecRdrCheck(rdr, size);
    if rdr.ok == 0 {
        memset(out, 0, cast(u64, size));
        return;
    }
    memcpy(out, rdr.data + rdr.cursor, cast(u64, size));
    rdr.cursor += size;
}
}

u8 b3RecR_U8(b3RecReader* rdr) {
    b3RecRdrCheck(rdr, 1);
    if rdr.ok == 0 {
        return 0;
    }
    return rdr.data[rdr.cursor++];
}

u16 b3RecR_U16(b3RecReader* rdr) {
    b3RecRdrCheck(rdr, 2);
    if rdr.ok == 0 {
        return 0;
    }
    var v = cast(u16, cast(u16, rdr.data[rdr.cursor]) | cast(u16, rdr.data[rdr.cursor + 1]) << 8);
    rdr.cursor += 2;
    return v;
}

u32 b3RecR_U24(b3RecReader* rdr) {
    b3RecRdrCheck(rdr, 3);
    if rdr.ok == 0 {
        return 0;
    }
    u32 v = cast(u32, rdr.data[rdr.cursor]) | cast(u32, rdr.data[rdr.cursor + 1]) << 8 | cast(u32, rdr.data[rdr.cursor + 2]) << 16;
    rdr.cursor += 3;
    return v;
}

u32 b3RecR_U32(b3RecReader* rdr) {
    b3RecRdrCheck(rdr, 4);
    if rdr.ok == 0 {
        return 0;
    }
    u32 v = cast(u32, rdr.data[rdr.cursor]) | cast(u32, rdr.data[rdr.cursor + 1]) << 8 | cast(u32, rdr.data[rdr.cursor + 2]) << 16 | cast(u32, rdr.data[rdr.cursor + 3]) << 24;
    rdr.cursor += 4;
    return v;
}

u64 b3RecR_U64(b3RecReader* rdr) {
    b3RecRdrCheck(rdr, 8);
    if rdr.ok == 0 {
        return 0;
    }
    u64 v = cast(u64, rdr.data[rdr.cursor]) | cast(u64, rdr.data[rdr.cursor + 1]) << 8 | cast(u64, rdr.data[rdr.cursor + 2]) << 16 | cast(u64, rdr.data[rdr.cursor + 3]) << 24 | cast(u64, rdr.data[rdr.cursor + 4]) << 32 | cast(u64, rdr.data[rdr.cursor + 5]) << 40 | cast(u64, rdr.data[rdr.cursor + 6]) << 48 | cast(u64, rdr.data[rdr.cursor + 7]) << 56;
    rdr.cursor += 8;
    return v;
}

i32 b3RecR_I32(b3RecReader* rdr) {
    return cast(i32, b3RecR_U32(rdr));
}

f32 b3RecR_F32(b3RecReader* rdr) {
    u32 bits = b3RecR_U32(rdr);
    f32 v;
    memcpy(&v, &bits, cast(u64, 4));
    return v;
}

f64 b3RecR_F64(b3RecReader* rdr) {
    u64 bits = b3RecR_U64(rdr);
    f64 v;
    memcpy(&v, &bits, cast(u64, 8));
    return v;
}

bool b3RecR_BOOL(b3RecReader* rdr) {
    return b3RecR_U8(rdr) != 0;
}

b3Vec3 b3RecR_VEC3(b3RecReader* rdr) {
    noinit b3Vec3 v;
    v.x = b3RecR_F32(rdr);
    v.y = b3RecR_F32(rdr);
    v.z = b3RecR_F32(rdr);
    return v;
}

b3Quat b3RecR_QUAT(b3RecReader* rdr) {
    noinit b3Quat q;
    q.v.x = b3RecR_F32(rdr);
    q.v.y = b3RecR_F32(rdr);
    q.v.z = b3RecR_F32(rdr);
    q.s = b3RecR_F32(rdr);
    return q;
}

b3Transform b3RecR_TRANSFORM(b3RecReader* rdr) {
    noinit b3Transform t;
    t.p = b3RecR_VEC3(rdr);
    t.q = b3RecR_QUAT(rdr);
    return t;
}

b3Pos b3RecR_POSITION(b3RecReader* rdr) {
    noinit b3Pos p;
    p.x = b3RecR_F32(rdr);
    p.y = b3RecR_F32(rdr);
    p.z = b3RecR_F32(rdr);
    return p;
}

b3WorldTransform b3RecR_WORLDXF(b3RecReader* rdr) {
    noinit b3WorldTransform t;
    t.p = b3RecR_POSITION(rdr);
    t.q = b3RecR_QUAT(rdr);
    return t;
}

b3Matrix3 b3RecR_MATRIX3(b3RecReader* rdr) {
    noinit b3Matrix3 m;
    m.cx = b3RecR_VEC3(rdr);
    m.cy = b3RecR_VEC3(rdr);
    m.cz = b3RecR_VEC3(rdr);
    return m;
}

b3AABB b3RecR_AABB(b3RecReader* rdr) {
    noinit b3AABB v;
    v.lowerBound = b3RecR_VEC3(rdr);
    v.upperBound = b3RecR_VEC3(rdr);
    return v;
}

b3QueryFilter b3RecR_QUERYFILTER(b3RecReader* rdr) {
    b3QueryFilter f = b3DefaultQueryFilter();
    f.categoryBits = b3RecR_U64(rdr);
    f.maskBits = b3RecR_U64(rdr);
    return f;
}

// Reserve reader scratch for a count taken from an untrusted file. Every recorded element
// consumes at least one byte, so a valid count can never exceed the bytes left in the file.
// Reject anything larger (or negative, or that would overflow the byte size) by failing the read
// rather than allocating wildly. A grow keeps the old contents so callers can accumulate across
// reserves, as the collide-mover dispatcher does one shape group at a time.
private {
bool b3RecReserveScratch(b3RecReader* rdr, void** data, i32* cap, i32 need, i32 elemSize) {
    i32 remaining = rdr.size - rdr.cursor;
    if need < 0 || remaining < 0 || need > remaining || need > 2147483647 / elemSize {
        rdr.ok = false;
        return false;
    }
    if need <= *cap {
        return true;
    }
    i32 newCap = need <= 2147483647 / elemSize - 8 ? need + 8 : need;
    void* grown = b3Alloc(cast(u64, newCap) * cast(u64, elemSize));
    if *data != null {
        memcpy(grown, *data, cast(u64, *cap) * cast(u64, elemSize));
        b3Free(*data, cast(u64, *cap) * cast(u64, elemSize));
    }
    *data = grown;
    *cap = newCap;
    return true;
}
}

// Variable length, mirrors b3RecW_SHAPEPROXY: count, count points, radius. The decoded proxy borrows
// the reader's scratch for its point cloud, valid until the next proxy read.
b3ShapeProxy b3RecR_SHAPEPROXY(b3RecReader* rdr) {
    b3ShapeProxy p;
    i32 count = b3RecR_I32(rdr);
    if count < 0 {
        count = 0;
    }
    if count > 64 {
        count = 64;
    }
    if count > 0 && b3RecReserveScratch(rdr, cast(void**, &rdr.proxyScratch), &rdr.proxyScratchCap, count, cast(i32, sizeof(b3Vec3))) {
        for i32 i = 0; i < count; ++i {
            rdr.proxyScratch[i] = b3RecR_VEC3(rdr);
        }
        p.points = rdr.proxyScratch;
        p.count = count;
    }
    p.radius = b3RecR_F32(rdr);
    return p;
}

b3TreeStats b3RecR_TREESTATS(b3RecReader* rdr) {
    noinit b3TreeStats v;
    v.nodeVisits = b3RecR_I32(rdr);
    v.leafVisits = b3RecR_I32(rdr);
    return v;
}

b3RayResult b3RecR_RAYRESULT(b3RecReader* rdr) {
    b3RayResult v;
    v.shapeId = b3RecR_SHAPEID(rdr);
    v.point = b3RecR_POSITION(rdr);
    v.normal = b3RecR_VEC3(rdr);
    v.userMaterialId = b3RecR_U64(rdr);
    v.fraction = b3RecR_F32(rdr);
    v.triangleIndex = b3RecR_I32(rdr);
    v.childIndex = b3RecR_I32(rdr);
    v.hit = b3RecR_BOOL(rdr);
    return v;
}

b3PlaneResult b3RecR_PLANERESULT(b3RecReader* rdr) {
    noinit b3PlaneResult v;
    v.plane.normal = b3RecR_VEC3(rdr);
    v.plane.offset = b3RecR_F32(rdr);
    v.point = b3RecR_VEC3(rdr);
    return v;
}

b3WorldId b3RecR_WORLDID(b3RecReader* rdr) {
    return b3LoadWorldId(b3RecR_U32(rdr));
}

b3BodyId b3RecR_BODYID(b3RecReader* rdr) {
    return b3LoadBodyId(b3RecR_U64(rdr));
}

b3ShapeId b3RecR_SHAPEID(b3RecReader* rdr) {
    return b3LoadShapeId(b3RecR_U64(rdr));
}

b3JointId b3RecR_JOINTID(b3RecReader* rdr) {
    return b3LoadJointId(b3RecR_U64(rdr));
}

b3Sphere b3RecR_SPHERE(b3RecReader* rdr) {
    noinit b3Sphere s;
    b3RecRdrBlob(rdr, &s, cast(i32, sizeof(s)));
    return s;
}

b3Capsule b3RecR_CAPSULE(b3RecReader* rdr) {
    noinit b3Capsule c;
    b3RecRdrBlob(rdr, &c, cast(i32, sizeof(c)));
    return c;
}

u32 b3RecR_GEOMID(b3RecReader* rdr) {
    return b3RecR_U32(rdr);
}

b3Filter b3RecR_FILTER(b3RecReader* rdr) {
    noinit b3Filter f;
    f.categoryBits = b3RecR_U64(rdr);
    f.maskBits = b3RecR_U64(rdr);
    f.groupIndex = b3RecR_I32(rdr);
    return f;
}

b3SurfaceMaterial b3RecR_MATERIAL(b3RecReader* rdr) {
    b3SurfaceMaterial m = b3DefaultSurfaceMaterial();
    m.friction = b3RecR_F32(rdr);
    m.restitution = b3RecR_F32(rdr);
    m.rollingResistance = b3RecR_F32(rdr);
    m.tangentVelocity = b3RecR_VEC3(rdr);
    m.userMaterialId = b3RecR_U64(rdr);
    m.customColor = b3RecR_U32(rdr);
    return m;
}

b3MassData b3RecR_MASSDATA(b3RecReader* rdr) {
    noinit b3MassData md;
    md.mass = b3RecR_F32(rdr);
    md.center = b3RecR_VEC3(rdr);
    md.inertia = b3RecR_MATRIX3(rdr);
    return md;
}

b3MotionLocks b3RecR_LOCKS(b3RecReader* rdr) {
    noinit b3MotionLocks locks;
    locks.linearX = b3RecR_BOOL(rdr);
    locks.linearY = b3RecR_BOOL(rdr);
    locks.linearZ = b3RecR_BOOL(rdr);
    locks.angularX = b3RecR_BOOL(rdr);
    locks.angularY = b3RecR_BOOL(rdr);
    locks.angularZ = b3RecR_BOOL(rdr);
    return locks;
}

// Rotating set of static string buffers, valid until the next 4 STR reads.
u8* b3RecR_STR(b3RecReader* rdr) {
    u8* buf = rdr.stringBuffers[rdr.nextString];
    rdr.nextString = rdr.nextString + 1 & 3;
    u16 len = b3RecR_U16(rdr);
    if len == 0xFFFF {
        return null;
    }
    var n = cast(i32, len);
    if n > 256 {
        n = 256;
    }
    b3RecRdrCheck(rdr, cast(i32, len));
    if rdr.ok && n > 0 {
        memcpy(buf, rdr.data + rdr.cursor, cast(u64, n));
    }
    rdr.cursor += cast(i32, len);
    buf[n] = 0;
    return buf;
}

// Def readers: start from b3Default*Def() then overlay each serialized field
// in the exact order the writer produced them.
b3ExplosionDef b3RecR_EXPLOSIONDEF(b3RecReader* rdr) {
    b3ExplosionDef def = b3DefaultExplosionDef();
    def.maskBits = b3RecR_U64(rdr);
    def.position = b3RecR_POSITION(rdr);
    def.radius = b3RecR_F32(rdr);
    def.falloff = b3RecR_F32(rdr);
    def.impulsePerArea = b3RecR_F32(rdr);
    return def;
}

b3BodyDef b3RecR_BODYDEF(b3RecReader* rdr) {
    b3BodyDef def = b3DefaultBodyDef();
    def.type = cast(b3BodyType, b3RecR_I32(rdr));
    def.position = b3RecR_POSITION(rdr);
    def.rotation = b3RecR_QUAT(rdr);
    def.linearVelocity = b3RecR_VEC3(rdr);
    def.angularVelocity = b3RecR_VEC3(rdr);
    def.linearDamping = b3RecR_F32(rdr);
    def.angularDamping = b3RecR_F32(rdr);
    def.gravityScale = b3RecR_F32(rdr);
    def.sleepThreshold = b3RecR_F32(rdr);
    def.name = b3RecR_STR(rdr);
    ignore b3RecR_U64(rdr);
    def.motionLocks = b3RecR_LOCKS(rdr);
    def.enableSleep = b3RecR_BOOL(rdr);
    def.isAwake = b3RecR_BOOL(rdr);
    def.isBullet = b3RecR_BOOL(rdr);
    def.isEnabled = b3RecR_BOOL(rdr);
    def.allowFastRotation = b3RecR_BOOL(rdr);
    def.enableContactRecycling = b3RecR_BOOL(rdr);
    def.userData = null;
    return def;
}

b3ShapeDef b3RecR_SHAPEDEF(b3RecReader* rdr) {
    b3ShapeDef def = b3DefaultShapeDef();
    def.name = b3RecR_STR(rdr);
    ignore b3RecR_U64(rdr);
    i32 matCount = b3RecR_I32(rdr);
    if matCount < 0 {
        matCount = 0;
    }
    if matCount > 0 && b3RecReserveScratch(rdr, cast(void**, &rdr.matScratch), &rdr.matScratchCap, matCount, cast(i32, sizeof(b3SurfaceMaterial))) {
        for i32 i = 0; i < matCount; ++i {
            rdr.matScratch[i] = b3RecR_MATERIAL(rdr);
        }
        def.materials = rdr.matScratch;
        def.materialCount = matCount;
    } else {
        for i32 i = 0; i < matCount; ++i {
            ignore b3RecR_MATERIAL(rdr);
        }
        def.materials = null;
        def.materialCount = 0;
    }
    def.baseMaterial = b3RecR_MATERIAL(rdr);
    def.density = b3RecR_F32(rdr);
    def.explosionScale = b3RecR_F32(rdr);
    def.filter = b3RecR_FILTER(rdr);
    def.enableCustomFiltering = b3RecR_BOOL(rdr);
    def.isSensor = b3RecR_BOOL(rdr);
    def.enableSensorEvents = b3RecR_BOOL(rdr);
    def.enableContactEvents = b3RecR_BOOL(rdr);
    def.enableHitEvents = b3RecR_BOOL(rdr);
    def.enablePreSolveEvents = b3RecR_BOOL(rdr);
    def.invokeContactCreation = b3RecR_BOOL(rdr);
    def.updateBodyMass = b3RecR_BOOL(rdr);
    def.enableSpeculativeContact = b3RecR_BOOL(rdr);
    def.userData = null;
    return def;
}

// Shared base for all joint defs. Body ids come in with recorded world0; callers remap them.
private {
void b3RecR_JointBase(b3RecReader* rdr, b3JointDef* base) {
    ignore b3RecR_U64(rdr);
    base.bodyIdA = b3RecR_BODYID(rdr);
    base.bodyIdB = b3RecR_BODYID(rdr);
    base.localFrameA = b3RecR_TRANSFORM(rdr);
    base.localFrameB = b3RecR_TRANSFORM(rdr);
    base.forceThreshold = b3RecR_F32(rdr);
    base.torqueThreshold = b3RecR_F32(rdr);
    base.constraintHertz = b3RecR_F32(rdr);
    base.constraintDampingRatio = b3RecR_F32(rdr);
    base.drawScale = b3RecR_F32(rdr);
    base.collideConnected = b3RecR_BOOL(rdr);
    base.userData = null;
}
}

b3ParallelJointDef b3RecR_PARALLELJOINTDEF(b3RecReader* rdr) {
    b3ParallelJointDef def = b3DefaultParallelJointDef();
    b3RecR_JointBase(rdr, &def.base);
    def.hertz = b3RecR_F32(rdr);
    def.dampingRatio = b3RecR_F32(rdr);
    def.maxTorque = b3RecR_F32(rdr);
    return def;
}

b3DistanceJointDef b3RecR_DISTANCEJOINTDEF(b3RecReader* rdr) {
    b3DistanceJointDef def = b3DefaultDistanceJointDef();
    b3RecR_JointBase(rdr, &def.base);
    def.length = b3RecR_F32(rdr);
    def.enableSpring = b3RecR_BOOL(rdr);
    def.lowerSpringForce = b3RecR_F32(rdr);
    def.upperSpringForce = b3RecR_F32(rdr);
    def.hertz = b3RecR_F32(rdr);
    def.dampingRatio = b3RecR_F32(rdr);
    def.enableLimit = b3RecR_BOOL(rdr);
    def.minLength = b3RecR_F32(rdr);
    def.maxLength = b3RecR_F32(rdr);
    def.enableMotor = b3RecR_BOOL(rdr);
    def.maxMotorForce = b3RecR_F32(rdr);
    def.motorSpeed = b3RecR_F32(rdr);
    return def;
}

b3FilterJointDef b3RecR_FILTERJOINTDEF(b3RecReader* rdr) {
    b3FilterJointDef def = b3DefaultFilterJointDef();
    b3RecR_JointBase(rdr, &def.base);
    return def;
}

b3MotorJointDef b3RecR_MOTORJOINTDEF(b3RecReader* rdr) {
    b3MotorJointDef def = b3DefaultMotorJointDef();
    b3RecR_JointBase(rdr, &def.base);
    def.linearVelocity = b3RecR_VEC3(rdr);
    def.maxVelocityForce = b3RecR_F32(rdr);
    def.angularVelocity = b3RecR_VEC3(rdr);
    def.maxVelocityTorque = b3RecR_F32(rdr);
    def.linearHertz = b3RecR_F32(rdr);
    def.linearDampingRatio = b3RecR_F32(rdr);
    def.maxSpringForce = b3RecR_F32(rdr);
    def.angularHertz = b3RecR_F32(rdr);
    def.angularDampingRatio = b3RecR_F32(rdr);
    def.maxSpringTorque = b3RecR_F32(rdr);
    return def;
}

b3PrismaticJointDef b3RecR_PRISMATICJOINTDEF(b3RecReader* rdr) {
    b3PrismaticJointDef def = b3DefaultPrismaticJointDef();
