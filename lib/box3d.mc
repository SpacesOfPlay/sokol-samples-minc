/*--------------------------------------------------------------------------------------------------------------------*/
/*                                               Common header section                                                */
/*--------------------------------------------------------------------------------------------------------------------*/
/*--------------------------------------------------------------------------------------------------------------------*/
/*                                                  Prefixed structs                                                  */
/*--------------------------------------------------------------------------------------------------------------------*/
when !(defined(IMPLEMENTATION_MODE)) {
}
/*--------------------------------------------------------------------------------------------------------------------*/
/*                                                Function prototypes                                                 */
/*--------------------------------------------------------------------------------------------------------------------*/
when !(defined(IMPLEMENTATION_MODE)) {

// Erases the key pointed to by itr and returns an iterator to the next key in the table.
// This function must be inlined to ensure that the compiler optimizes away the NAME_fast_forward call if the returned
// iterator is discarded.
private {
b3EdgeMap_itr b3EdgeMap_erase_itr(b3EdgeMap* table, b3EdgeMap_itr itr) {
    if b3EdgeMap_erase_itr_raw(table, itr) != 0 {
        return b3EdgeMap_next(itr);
    }
    return itr;
}
}
}
/*--------------------------------------------------------------------------------------------------------------------*/
/*                                              Function implementations                                              */
/*--------------------------------------------------------------------------------------------------------------------*/
when !(defined(HEADER_MODE)) {
// Default settings.

private {
void b3EdgeMap_init(b3EdgeMap* table) {
    table.key_count = 0;
    table.buckets_mask = 0x0000000000000000;
    table.buckets = null;
    table.metadata = &vt_empty_placeholder_metadatum;
}

// For efficiency, especially in the case of a small table, the buckets array and metadata share the same dynamic memory
// allocation:
//   +-----------------------------+-----+----------------+--------+
//   |           Buckets           | Pad |    Metadata    | Excess |
//   +-----------------------------+-----+----------------+--------+
// Any allocated metadata array requires four excess elements to ensure that iteration functions, which read four
// metadata at a time, never read beyond the end of it.
// This function returns the offset of the beginning of the metadata, i.e. the size of the buckets array plus the
// (usually zero) padding.
// It assumes that the bucket count is not zero.
u64 b3EdgeMap_metadata_offset(b3EdgeMap* table) {
    return ((table.buckets_mask + 1) * cast(u64, sizeof(b3EdgeMap_bucket)) + cast(u64, sizeof(u16)) - 1) / cast(u64, sizeof(u16)) * cast(u64, sizeof(u16));
}

// Returns the total allocation size, including the buckets array, padding, metadata, and excess metadata.
// As above, this function assumes that the bucket count is not zero.
u64 b3EdgeMap_total_alloc_size(b3EdgeMap* table) {
    return b3EdgeMap_metadata_offset(table) + (table.buckets_mask + 1 + 4) * cast(u64, sizeof(u16));
}

bool b3EdgeMap_init_clone(b3EdgeMap* table, b3EdgeMap* source) {
    table.key_count = source.key_count;
    table.buckets_mask = source.buckets_mask;
    if source.buckets_mask == 0 {
        table.metadata = &vt_empty_placeholder_metadatum;
        table.buckets = null;
        return true;
    }
    void* allocation = b3Alloc(b3EdgeMap_total_alloc_size(table));
    if allocation == null {
        return false;
    }
    table.buckets = cast(b3EdgeMap_bucket*, allocation);
    table.metadata = cast(u16*, cast(u8*, allocation) + b3EdgeMap_metadata_offset(table));
    memcpy(allocation, source.buckets, b3EdgeMap_total_alloc_size(table));
    return true;
}

u64 b3EdgeMap_size(b3EdgeMap* table) {
    return table.key_count;
}

u64 b3EdgeMap_bucket_count(b3EdgeMap* table) {
    return table.buckets_mask + cast(u64, cast(bool, table.buckets_mask));
}

bool b3EdgeMap_is_end(b3EdgeMap_itr itr) {
    return itr.metadatum == itr.metadata_end;
}

// Finds the earliest empty bucket in which a key belonging to home_bucket can be placed, assuming that home_bucket
// is already occupied.
// The reason to begin the search at home_bucket, rather than the end of the existing chain, is that keys deleted from
// other chains might have freed up buckets that could fall in this chain before the final key.
// Returns true if an empty bucket within the range of the displacement limit was found, in which case the final two
// pointer arguments contain the index of the empty bucket and its quadratic displacement from home_bucket.
bool b3EdgeMap_find_first_empty(b3EdgeMap* table, u64 home_bucket, u64* empty, u16* displacement) {
    *displacement = 1;
    u64 linear_dispacement = 1;
    while true {
        *empty = home_bucket + linear_dispacement & table.buckets_mask;
        if table.metadata[*empty] == 0x0000 {
            return true;
        }
        if ++*displacement == 0x07FF {
            return false;
        }
        linear_dispacement += *displacement;
    }
}

// Finds the key in the chain beginning in home_bucket after which to link a new key with displacement_to_empty
// quadratic displacement and returns the index of the bucket containing that key.
// Although the new key could simply be linked to the end of the chain, keeping the chain ordered by displacement
// theoretically improves cache locality during lookups.
u64 b3EdgeMap_find_insert_location_in_chain(b3EdgeMap* table, u64 home_bucket, u16 displacement_to_empty) {
    u64 candidate = home_bucket;
    while true {
        u16 displacement = table.metadata[candidate] & 0x07FF;
        if displacement > displacement_to_empty {
            return candidate;
        }
        candidate = home_bucket + vt_quadratic(displacement) & table.buckets_mask;
    }
}

// Frees up a bucket occupied by a key not belonging there so that a new key belonging there can be placed there as the
// beginning of a new chain.
// This requires:
// * Finding the previous key in the chain to which the occupying key belongs by rehashing it and then traversing the
//   chain.
// * Disconnecting the key from the chain.
// * Finding the appropriate empty bucket to which to move the key.
// * Moving the key (and value) data to the empty bucket.
// * Re-linking the key to the chain.
// Returns true if the eviction succeeded, or false if no empty bucket to which to evict the occupying key could be
// found within the displacement limit.
bool b3EdgeMap_evict(b3EdgeMap* table, u64 bucket) {
    u64 home_bucket = vt_hash_integer(table.buckets[bucket].key) & table.buckets_mask;
    u64 prev = home_bucket;
    while true {
        u64 next = home_bucket + vt_quadratic(table.metadata[prev] & 0x07FF) & table.buckets_mask;
        if next == bucket {
            break;
        }
        prev = next;
    }
    table.metadata[prev] = cast(u16, table.metadata[prev] & ~0x07FF | table.metadata[bucket] & 0x07FF);
    u64 empty;
    u16 displacement;
    if b3EdgeMap_find_first_empty(table, home_bucket, &empty, &displacement) == 0 {
        return false;
    }
    prev = b3EdgeMap_find_insert_location_in_chain(table, home_bucket, displacement);
    table.buckets[empty] = table.buckets[bucket];
    table.metadata[empty] = table.metadata[bucket] & 0xF000 | table.metadata[prev] & 0x07FF;
    table.metadata[prev] = cast(u16, table.metadata[prev] & ~0x07FF | displacement);
    return true;
}

// Returns an end iterator, i.e. any iterator for which .metadatum == .metadata_end.
// This function just cleans up the library code in functions that return an end iterator as a failure indicator.
b3EdgeMap_itr b3EdgeMap_end_itr() {
    b3EdgeMap_itr itr;
    return itr;
}

// Inserts a key, optionally replacing the existing key if it already exists.
// There are two main cases that must be handled:
// * If the key's home bucket is empty or occupied by a key that does not belong there, then the key is inserted there,
//   evicting the occupying key if there is one.
// * Otherwise, the chain of keys beginning at the home bucket is (if unique is false) traversed in search of a matching
//   key.
//   If none is found, then the new key is inserted at the earliest available bucket, per quadratic probing from the
//   home bucket, and then linked to the chain in a manner that maintains its quadratic order.
// The unique argument tells the function whether to skip searching for the key before inserting it (on rehashing, this
// step is unnecessary).
// The replace argument tells the function whether to replace an existing key.
// If replace is true, the function returns an iterator to the inserted key, or an end iterator if the key was not
// inserted because of the maximum load factor or displacement limit constraints.
// If replace is false, then the return value is as described above, except that if the key already exists, the function
// returns an iterator to the existing key.
b3EdgeMap_itr b3EdgeMap_insert_raw(b3EdgeMap* table, u64 key, i32* val, bool unique, bool replace) {
    u64 hash = vt_hash_integer(key);
    u16 hashfrag = vt_hashfrag(hash);
    u64 home_bucket = hash & table.buckets_mask;
    if (table.metadata[home_bucket] & 0x0800) == 0 {
        if cast(f64, table.key_count + 1) > cast(f64, b3EdgeMap_bucket_count(table)) * 0.9 || table.metadata[home_bucket] != 0x0000 && !b3EdgeMap_evict(table, home_bucket) {
            return b3EdgeMap_end_itr();
        }
        table.buckets[home_bucket].key = key;
        table.buckets[home_bucket].val = *val;
        table.metadata[home_bucket] = hashfrag | 0x0800 | 0x07FF;
        ++table.key_count;
        var itr = b3EdgeMap_itr{
            table.buckets + home_bucket, table.metadata + home_bucket,
            table.metadata + table.buckets_mask + 1, home_bucket,
        };
        return itr;
    }
    if unique == 0 {
        u64 bucket = home_bucket;
        while true {
            if (table.metadata[bucket] & 0xF000) == hashfrag && vt_cmpr_integer(table.buckets[bucket].key, key) {
                if replace != 0 {
                    table.buckets[bucket].key = key;
                    table.buckets[bucket].val = *val;
                }
                var itr = b3EdgeMap_itr{
                    table.buckets + bucket, table.metadata + bucket,
                    table.metadata + table.buckets_mask + 1, home_bucket,
                };
                return itr;
            }
            u16 displacement = table.metadata[bucket] & 0x07FF;
            if displacement == 0x07FF {
                break;
            }
            bucket = home_bucket + vt_quadratic(displacement) & table.buckets_mask;
        }
    }
    u64 empty;
    u16 displacement;
    if cast(f64, table.key_count + 1) > cast(f64, b3EdgeMap_bucket_count(table)) * 0.9 || !b3EdgeMap_find_first_empty(table, home_bucket, &empty, &displacement) {
        return b3EdgeMap_end_itr();
    }
    u64 prev = b3EdgeMap_find_insert_location_in_chain(table, home_bucket, displacement);
    table.buckets[empty].key = key;
    table.buckets[empty].val = *val;
    table.metadata[empty] = hashfrag | table.metadata[prev] & 0x07FF;
    table.metadata[prev] = cast(u16, table.metadata[prev] & ~0x07FF | displacement);
    ++table.key_count;
    var itr = b3EdgeMap_itr{
        table.buckets + empty, table.metadata + empty, table.metadata + table.buckets_mask + 1,
        home_bucket,
    };
    return itr;
}

// Resizes the bucket array.
// This function assumes that bucket_count is a power of two and large enough to accommodate all keys without violating
// the maximum load factor.
// Returns false in the case of allocation failure.
// As this function is called very rarely in _insert and _get_or_insert, ideally it should not be inlined into those
// functions.
// In testing, the no-inline approach showed a performance benefit when inserting existing keys (i.e. replacing).
bool b3EdgeMap_rehash(b3EdgeMap* table, u64 bucket_count) {
    while true {
        var new_table = b3EdgeMap{0, bucket_count - 1, null, null};
        void* allocation = b3Alloc(b3EdgeMap_total_alloc_size(&new_table));
        if allocation == null {
            return false;
        }
        new_table.buckets = cast(b3EdgeMap_bucket*, allocation);
        new_table.metadata = cast(u16*, cast(u8*, allocation) + b3EdgeMap_metadata_offset(&new_table));
        memset(new_table.metadata, 0x00, (bucket_count + 4) * cast(u64, sizeof(u16)));
        new_table.metadata[bucket_count] = 0x01;
        for u64 bucket = 0; bucket < b3EdgeMap_bucket_count(table); ++bucket {
            if table.metadata[bucket] != 0x0000 {
                b3EdgeMap_itr itr = b3EdgeMap_insert_raw(&new_table, table.buckets[bucket].key, &table.buckets[bucket].val, true, false);
                if b3EdgeMap_is_end(itr) != 0 {
                    break;
                }
            }
        }
        if new_table.key_count < table.key_count {
            b3Free(new_table.buckets, b3EdgeMap_total_alloc_size(&new_table));
            bucket_count *= 2;
            continue;
        }
        if table.buckets_mask != 0 {
            b3Free(table.buckets, b3EdgeMap_total_alloc_size(table));
        }
        *table = new_table;
        return true;
    }
}

// Inserts a key, replacing the existing key if it already exists.
// This function wraps insert_raw in a loop that handles growing and rehashing the table if a new key cannot be inserted
// because of the maximum load factor or displacement limit constraints.
// Returns an iterator to the inserted key, or an end iterator in the case of allocation failure.
b3EdgeMap_itr b3EdgeMap_insert(b3EdgeMap* table, u64 key, i32 val) {
    while true {
        b3EdgeMap_itr itr = b3EdgeMap_insert_raw(table, key, &val, false, true);
        if !b3EdgeMap_is_end(itr) || !b3EdgeMap_rehash(table, table.buckets_mask != 0 ? b3EdgeMap_bucket_count(table) * 2 : 8) {
            return itr;
        }
    }
}

// Same as NAME_insert, except that if the key already exists, no insertion occurs and the function returns an iterator
// to the existing key.
b3EdgeMap_itr b3EdgeMap_get_or_insert(b3EdgeMap* table, u64 key, i32 val) {
    while true {
        b3EdgeMap_itr itr = b3EdgeMap_insert_raw(table, key, &val, false, false);
        if !b3EdgeMap_is_end(itr) || !b3EdgeMap_rehash(table, table.buckets_mask != 0 ? b3EdgeMap_bucket_count(table) * 2 : 8) {
            return itr;
        }
    }
}

// Returns an iterator pointing to the specified key, or an end iterator if the key does not exist.
b3EdgeMap_itr b3EdgeMap_get(b3EdgeMap* table, u64 key) {
    u64 hash = vt_hash_integer(key);
    u64 home_bucket = hash & table.buckets_mask;
    if (table.metadata[home_bucket] & 0x0800) == 0 {
        return b3EdgeMap_end_itr();
    }
    u16 hashfrag = vt_hashfrag(hash);
    u64 bucket = home_bucket;
    while true {
        if (table.metadata[bucket] & 0xF000) == hashfrag && vt_cmpr_integer(table.buckets[bucket].key, key) {
            var itr = b3EdgeMap_itr{
                table.buckets + bucket, table.metadata + bucket,
                table.metadata + table.buckets_mask + 1, home_bucket,
            };
            return itr;
        }
        u16 displacement = table.metadata[bucket] & 0x07FF;
        if displacement == 0x07FF {
            return b3EdgeMap_end_itr();
        }
        bucket = home_bucket + vt_quadratic(displacement) & table.buckets_mask;
    }
}

// Erases the key pointed to by the specified iterator.
// The erasure always occurs at the end of the chain to which the key belongs.
// If the key to be erased is not the last in the chain, it is swapped with the last so that erasure occurs at the end.
// This helps keep a chain's keys close to their home bucket for the sake of cache locality.
// Returns true if, in the case of iteration from first to end, NAME_next should now be called on the iterator to find
// the next key.
// This return value is necessary because at the iterator location, the erasure could result in an empty bucket, a
// bucket containing a moved key already visited during the iteration, or a bucket containing a moved key not yet
// visited.
bool b3EdgeMap_erase_itr_raw(b3EdgeMap* table, b3EdgeMap_itr itr) {
    --table.key_count;
    var itr_bucket = cast(u64, cast(i64, itr.metadatum - table.metadata));
    if table.metadata[itr_bucket] & 0x0800 && (table.metadata[itr_bucket] & 0x07FF) == 0x07FF {
        table.metadata[itr_bucket] = 0x0000;
        return true;
    }
    if itr.home_bucket == SIZE_MAX {
        if (table.metadata[itr_bucket] & 0x0800) != 0 {
            itr.home_bucket = itr_bucket;
        } else {
            itr.home_bucket = vt_hash_integer(table.buckets[itr_bucket].key) & table.buckets_mask;
        }
    }
    if (table.metadata[itr_bucket] & 0x07FF) == 0x07FF {
        u64 bucket = itr.home_bucket;
        while true {
            u16 displacement = table.metadata[bucket] & 0x07FF;
            u64 next = itr.home_bucket + vt_quadratic(displacement) & table.buckets_mask;
            if next == itr_bucket {
                table.metadata[bucket] |= 0x07FF;
                table.metadata[itr_bucket] = 0x0000;
                return true;
            }
            bucket = next;
        }
    }
    u64 bucket = itr_bucket;
    while true {
        u64 prev = bucket;
        bucket = itr.home_bucket + vt_quadratic(table.metadata[bucket] & 0x07FF) & table.buckets_mask;
        if (table.metadata[bucket] & 0x07FF) == 0x07FF {
            table.buckets[itr_bucket] = table.buckets[bucket];
            table.metadata[itr_bucket] = cast(u16, table.metadata[itr_bucket] & ~0xF000 | table.metadata[bucket] & 0xF000);
            table.metadata[prev] |= 0x07FF;
            table.metadata[bucket] = 0x0000;
            if bucket > itr_bucket {
                return false;
            }
            return true;
        }
    }
}

// Erases the specified key, if it exists.
// Returns true if a key was erased.
bool b3EdgeMap_erase(b3EdgeMap* table, u64 key) {
    b3EdgeMap_itr itr = b3EdgeMap_get(table, key);
    if b3EdgeMap_is_end(itr) != 0 {
        return false;
    }
    b3EdgeMap_erase_itr_raw(table, itr);
    return true;
}

// Finds the first occupied bucket at or after the bucket pointed to by itr.
// This function scans four buckets at a time, ideally using intrinsics.
void b3EdgeMap_fast_forward(b3EdgeMap_itr* itr) {
    while true {
        u64 metadata;
        memcpy(&metadata, itr.metadatum, sizeof(u64));
        if metadata != 0 {
            i32 offset = vt_first_nonzero_uint16(metadata);
            itr.data += offset;
            itr.metadatum += offset;
            itr.home_bucket = SIZE_MAX;
            return;
        }
        itr.data += 4;
        itr.metadatum += 4;
    }
}

b3EdgeMap_itr b3EdgeMap_next(b3EdgeMap_itr itr) {
    ++itr.data;
    ++itr.metadatum;
    b3EdgeMap_fast_forward(&itr);
    return itr;
}

// Returns the minimum bucket count required to accommodate a certain number of keys, which is governed by the maximum
// load factor.
u64 b3EdgeMap_min_bucket_count_for_size(u64 size) {
    if size == 0 {
        return 0;
    }
    u64 bucket_count = 8;
    while cast(f64, size) > cast(f64, bucket_count) * 0.9 {
        bucket_count *= 2;
    }
    return bucket_count;
}

bool b3EdgeMap_reserve(b3EdgeMap* table, u64 size) {
    u64 bucket_count = b3EdgeMap_min_bucket_count_for_size(size);
    if bucket_count <= b3EdgeMap_bucket_count(table) {
        return true;
    }
    return b3EdgeMap_rehash(table, bucket_count);
}

bool b3EdgeMap_shrink(b3EdgeMap* table) {
    u64 bucket_count = b3EdgeMap_min_bucket_count_for_size(table.key_count);
    if bucket_count == b3EdgeMap_bucket_count(table) {
        return true;
    }
    if bucket_count == 0 {
        b3Free(table.buckets, b3EdgeMap_total_alloc_size(table));
        table.buckets_mask = 0x0000000000000000;
        table.metadata = &vt_empty_placeholder_metadatum;
        return true;
    }
    return b3EdgeMap_rehash(table, bucket_count);
}

b3EdgeMap_itr b3EdgeMap_first(b3EdgeMap* table) {
    if table.key_count == 0 {
        return b3EdgeMap_end_itr();
    }
    var itr = b3EdgeMap_itr{
        table.buckets, table.metadata, table.metadata + table.buckets_mask + 1, SIZE_MAX,
    };
    b3EdgeMap_fast_forward(&itr);
    return itr;
}

void b3EdgeMap_clear(b3EdgeMap* table) {
    if table.key_count == 0 {
        return;
    }
    for u64 i = 0; i < b3EdgeMap_bucket_count(table); ++i {
        if table.metadata[i] != 0x0000 {
        }
        table.metadata[i] = 0x0000;
    }
    table.key_count = 0;
}

void b3EdgeMap_cleanup(b3EdgeMap* table) {
    if table.buckets_mask == 0 {
        return;
    }
    when defined(KEY_DTOR_FN) || defined(VAL_DTOR_FN) {
        b3EdgeMap_clear(table);
    }
    b3Free(table.buckets, b3EdgeMap_total_alloc_size(table));
    b3EdgeMap_init(table);
}
}
}

// Results for MeshCreationBenchmark
// eastl::hash_map : 4.9703 ms and 5.1445ms with FastHash function
// std::unordered_map : 4.8755 ms and 4.4780ms with FastHash function
// verstable : 3.3968 ms with default FastHash
// no edge identification : 1.7396 ms
private {
void b3IdentifyEdges(b3MeshData* mesh) {
    b3MeshTriangle* triangles = b3GetMeshTrianglesWrite(mesh);
    b3Vec3* vertices = b3GetMeshVertices(mesh);
    u8* flags = b3GetMeshFlagsWrite(mesh);
    i32 triangleCount = mesh.triangleCount;
    i32 edgeCount = 3 * triangleCount;
    var edges = cast(b3MeshEdge*, b3Alloc(cast(u64, edgeCount * sizeof(b3MeshEdge))));
    var normals = cast(b3Vec3*, b3Alloc(cast(u64, triangleCount * sizeof(b3Vec3))));
    for i32 i = 0; i < triangleCount; ++i {
        b3MeshTriangle* triangle = triangles + i;
        i32 i1 = triangle.index1;
        i32 i2 = triangle.index2;
        i32 i3 = triangle.index3;
        edges[3 * i + 0].vertex1 = b3MinInt(i1, i2);
        edges[3 * i + 0].vertex2 = b3MaxInt(i1, i2);
        edges[3 * i + 0].triangle1 = i;
        edges[3 * i + 0].triangle2 = -1;
        edges[3 * i + 0].triangleEdgeIndex1 = 0;
        edges[3 * i + 0].triangleEdgeIndex2 = 0xFF;
        edges[3 * i + 0].triangleCount = 1;
        edges[3 * i + 1].vertex1 = b3MinInt(i2, i3);
        edges[3 * i + 1].vertex2 = b3MaxInt(i2, i3);
        edges[3 * i + 1].triangle1 = i;
        edges[3 * i + 1].triangle2 = -1;
        edges[3 * i + 1].triangleEdgeIndex1 = 1;
        edges[3 * i + 1].triangleEdgeIndex2 = 0xFF;
        edges[3 * i + 1].triangleCount = 1;
        edges[3 * i + 2].vertex1 = b3MinInt(i3, i1);
        edges[3 * i + 2].vertex2 = b3MaxInt(i3, i1);
        edges[3 * i + 2].triangle1 = i;
        edges[3 * i + 2].triangle2 = -1;
        edges[3 * i + 2].triangleEdgeIndex1 = 2;
        edges[3 * i + 2].triangleEdgeIndex2 = 0xFF;
        edges[3 * i + 2].triangleCount = 1;
        b3Vec3 v1 = vertices[i1];
        b3Vec3 v2 = vertices[i2];
        b3Vec3 v3 = vertices[i3];
        b3Vec3 e1 = b3Sub(v2, v1);
        b3Vec3 e2 = b3Sub(v3, v1);
        b3Vec3 n = b3Cross(e1, e2);
        normals[i] = b3Normalize(n);
    }
    noinit b3EdgeMap map;
    b3EdgeMap_init(&map);
    b3EdgeMap_reserve(&map, cast(u64, edgeCount));
    u64 key = cast(u64, edges[0].vertex1) << 32 | cast(u64, edges[0].vertex2);
    b3EdgeMap_insert(&map, key, 0);
    for i32 i = 1; i < edgeCount; ++i {
        b3MeshEdge* edge = edges + i;
        key = cast(u64, edge.vertex1) << 32 | cast(u64, edge.vertex2);
        b3EdgeMap_itr itr = b3EdgeMap_get(&map, key);
        if b3EdgeMap_is_end(itr) != 0 {
            b3EdgeMap_insert(&map, key, i);
        } else {
            i32 otherIndex = itr.data.val;
            b3MeshEdge* base = edges + otherIndex;
            if base.triangleCount == 1 {
                base.triangle2 = edge.triangle1;
                base.triangleEdgeIndex2 = edge.triangleEdgeIndex1;
            }
            base.triangleCount += 1;
        }
    }
    b3EdgeMap_cleanup(&map);
    for i32 i = 0; i < edgeCount; ++i {
        b3MeshEdge* edge = edges + i;
        if edge.triangleCount != 2 {
            continue;
        }
        b3MeshTriangle* triangle1 = triangles + edge.triangle1;
        b3MeshTriangle* triangle2 = triangles + edge.triangle2;
        u8* flag1 = flags + edge.triangle1;
        u8* flag2 = flags + edge.triangle2;
        i32 j1 = triangle2.index1;
        i32 j2 = triangle2.index2;
        i32 j3 = triangle2.index3;
        i32 opposite = -1;
        switch edge.triangleEdgeIndex2 {
            case 0: {
                opposite = j3;
            }
            case 1: {
                opposite = j1;
            }
            case 2: {
                opposite = j2;
            }
            default: {
            }
        }
        i32 i1 = triangle1.index1;
        i32 i2 = triangle1.index2;
        i32 i3 = triangle1.index3;
        b3Vec3 v1 = vertices[i1];
        b3Vec3 v2 = vertices[i2];
        b3Vec3 v3 = vertices[i3];
        b3Vec3 p = vertices[opposite];
        f32 cos5Deg = 0.9962f;
        f32 signedVolume = b3SignedVolume(v1, v2, v3, p);
        b3Vec3 n1 = normals[edge.triangle1];
        b3Vec3 n2 = normals[edge.triangle2];
        f32 cosAngle = b3Dot(n1, n2);
        if signedVolume > 0.0f || cosAngle > cos5Deg {
            i32[3] edgeFlags = {b3_concaveEdge1, b3_concaveEdge2, b3_concaveEdge3};
            *flag1 |= cast(u8, edgeFlags[edge.triangleEdgeIndex1]);
            *flag2 |= cast(u8, edgeFlags[edge.triangleEdgeIndex2]);
        }
        if signedVolume < 0.0f || cosAngle > cos5Deg {
            i32[3] edgeFlags = {
                b3_inverseConcaveEdge1, b3_inverseConcaveEdge2, b3_inverseConcaveEdge3,
            };
            *flag1 |= cast(u8, edgeFlags[edge.triangleEdgeIndex1]);
            *flag2 |= cast(u8, edgeFlags[edge.triangleEdgeIndex2]);
        }
    }
    b3Free(normals, cast(u64, triangleCount * sizeof(b3Vec3)));
    b3Free(edges, cast(u64, edgeCount * sizeof(b3MeshEdge)));
}
}

b3MeshData* b3CreateGridMesh(i32 xCount, i32 zCount, f32 cellWidth, i32 materialCount, bool identifyEdges) {
    i32 vertexCount = (xCount + 1) * (zCount + 1);
    b3DynamicArray_b3Vec3 vertices;
    while true {
        while true {
            if vertices.capacity < vertexCount {
                var oldSize = cast(i32, vertices.capacity * sizeof(*vertices.data));
                var newSize = cast(i32, vertexCount * sizeof(*vertices.data));
                vertices.data = b3GrowAlloc(vertices.data, oldSize, newSize);
                vertices.capacity = vertexCount;
            }
            if !(0 != 0) { break; }
        }
        vertices.count = vertexCount;
        if !(0 != 0) { break; }
    }
    i32 index = 0;
    f32 xWidth = cellWidth * cast(f32, xCount);
    f32 zWidth = cellWidth * cast(f32, zCount);
    f32 x = -0.5f * xWidth;
    for i32 ix = 0; ix <= xCount; ++ix {
        f32 z = -0.5f * zWidth;
        for i32 iz = 0; iz <= zCount; ++iz {
            vertices.data[index] = b3Vec3{x, 0.0f, z};
            z += cellWidth;
            index += 1;
        }
        x += cellWidth;
    }
    i32 triangleCount = 2 * xCount * zCount;
    b3DynamicArray_int indices;
    while true {
        while true {
            if indices.capacity < 3 * triangleCount {
                var oldSize = cast(i32, indices.capacity * sizeof(*indices.data));
                var newSize = cast(i32, 3 * triangleCount * sizeof(*indices.data));
                indices.data = b3GrowAlloc(indices.data, oldSize, newSize);
                indices.capacity = 3 * triangleCount;
            }
            if !(0 != 0) { break; }
        }
        indices.count = 3 * triangleCount;
        if !(0 != 0) { break; }
    }
    b3DynamicArray_uint8_t materialIndices;
    while true {
        while true {
            if materialIndices.capacity < triangleCount {
                var oldSize = cast(i32, materialIndices.capacity * sizeof(*materialIndices.data));
                var newSize = cast(i32, triangleCount * sizeof(*materialIndices.data));
                materialIndices.data = b3GrowAlloc(materialIndices.data, oldSize, newSize);
                materialIndices.capacity = triangleCount;
            }
            if !(0 != 0) { break; }
        }
        materialIndices.count = triangleCount;
        if !(0 != 0) { break; }
    }
    i32 materialIndex = 0;
    index = 0;
    for i32 ix = 0; ix < xCount; ++ix {
        for i32 iz = 0; iz < zCount; ++iz {
            i32 index1 = iz + (zCount + 1) * ix;
            i32 index2 = index1 + 1;
            i32 index3 = index2 + (zCount + 1);
            i32 index4 = index3 - 1;
            indices.data[index + 0] = index1;
            indices.data[index + 1] = index2;
            indices.data[index + 2] = index3;
            indices.data[index + 3] = index3;
            indices.data[index + 4] = index4;
            indices.data[index + 5] = index1;
            if materialCount > 0 {
                materialIndices.data[2 * materialIndex + 0] = cast(u8, materialIndex % materialCount);
                materialIndices.data[2 * materialIndex + 1] = cast(u8, materialIndex % materialCount);
            }
            materialIndex += 1;
            index += 6;
        }
    }
    b3MeshDef def;
    def.vertexCount = vertices.count;
    def.vertices = vertices.data;
    def.triangleCount = indices.count / 3;
    def.indices = indices.data;
    def.materialIndices = materialCount > 0 ? materialIndices.data : null;
    def.useMedianSplit = true;
    def.identifyEdges = identifyEdges;
    b3MeshData* meshData = b3CreateMesh(&def, null, 0);
    while true {
        b3Free(indices.data, cast(u64, indices.capacity * sizeof(*indices.data)));
        indices.data = null;
        indices.count = 0;
        indices.capacity = 0;
        if !(0 != 0) { break; }
    }
    while true {
        b3Free(vertices.data, cast(u64, vertices.capacity * sizeof(*vertices.data)));
        vertices.data = null;
        vertices.count = 0;
        vertices.capacity = 0;
        if !(0 != 0) { break; }
    }
    while true {
        b3Free(materialIndices.data, cast(u64, materialIndices.capacity * sizeof(*materialIndices.data)));
        materialIndices.data = null;
        materialIndices.count = 0;
        materialIndices.capacity = 0;
        if !(0 != 0) { break; }
    }
    return meshData;
}

b3MeshData* b3CreateWaveMesh(i32 xCount, i32 zCount, f32 cellWidth, f32 amplitude, f32 rowFrequency, f32 columnFrequency) {
    i32 vertexCount = (xCount + 1) * (zCount + 1);
    b3DynamicArray_b3Vec3 vertices;
    while true {
        while true {
            if vertices.capacity < vertexCount {
                var oldSize = cast(i32, vertices.capacity * sizeof(*vertices.data));
                var newSize = cast(i32, vertexCount * sizeof(*vertices.data));
                vertices.data = b3GrowAlloc(vertices.data, oldSize, newSize);
                vertices.capacity = vertexCount;
            }
            if !(0 != 0) { break; }
        }
        vertices.count = vertexCount;
        if !(0 != 0) { break; }
    }
    i32 index = 0;
    f32 xWidth = cellWidth * cast(f32, xCount);
    f32 zWidth = cellWidth * cast(f32, zCount);
    f32 omegaZ = 2.0f * 3.14159265359f * rowFrequency * cellWidth;
    f32 omegaX = 2.0f * 3.14159265359f * columnFrequency * cellWidth;
    f32 x = -0.5f * xWidth;
    b3CosSin cs;
    for i32 ix = 0; ix <= xCount; ++ix {
        cs = b3ComputeCosSin(omegaX * cast(f32, ix));
        f32 rowHeight = cs.sine;
        f32 z = -0.5f * zWidth;
        for i32 iz = 0; iz <= zCount; ++iz {
            cs = b3ComputeCosSin(omegaZ * cast(f32, iz));
            f32 columnHeight = cs.sine;
            f32 y = amplitude * rowHeight * columnHeight;
            vertices.data[index] = b3Vec3{x, y, z};
            z += cellWidth;
            index += 1;
        }
        x += cellWidth;
    }
    i32 triangleCount = 2 * xCount * zCount;
    b3DynamicArray_int indices;
    while true {
        while true {
            if indices.capacity < 3 * triangleCount {
                var oldSize = cast(i32, indices.capacity * sizeof(*indices.data));
                var newSize = cast(i32, 3 * triangleCount * sizeof(*indices.data));
                indices.data = b3GrowAlloc(indices.data, oldSize, newSize);
                indices.capacity = 3 * triangleCount;
            }
            if !(0 != 0) { break; }
        }
        indices.count = 3 * triangleCount;
        if !(0 != 0) { break; }
    }
    index = 0;
    for i32 ix = 0; ix < xCount; ++ix {
        for i32 iz = 0; iz < zCount; ++iz {
            i32 index1 = iz + (zCount + 1) * ix;
            i32 index2 = index1 + 1;
            i32 index3 = index2 + (zCount + 1);
            i32 index4 = index3 - 1;
            indices.data[index + 0] = index1;
            indices.data[index + 1] = index2;
            indices.data[index + 2] = index3;
            indices.data[index + 3] = index3;
            indices.data[index + 4] = index4;
            indices.data[index + 5] = index1;
            index += 6;
        }
    }
    b3MeshDef def;
    def.vertexCount = vertices.count;
    def.vertices = vertices.data;
    def.triangleCount = indices.count / 3;
    def.indices = indices.data;
    def.useMedianSplit = true;
    def.identifyEdges = true;
    b3MeshData* meshData = b3CreateMesh(&def, null, 0);
    while true {
        b3Free(indices.data, cast(u64, indices.capacity * sizeof(*indices.data)));
        indices.data = null;
        indices.count = 0;
        indices.capacity = 0;
        if !(0 != 0) { break; }
    }
    while true {
        b3Free(vertices.data, cast(u64, vertices.capacity * sizeof(*vertices.data)));
        vertices.data = null;
        vertices.count = 0;
        vertices.capacity = 0;
        if !(0 != 0) { break; }
    }
    return meshData;
}

b3MeshData* b3CreateTorusMesh(i32 radialResolution, i32 tubularResolution, f32 radius, f32 thickness) {
    b3DynamicArray_b3Vec3 vertices;
    for i32 radialIndex = 0; radialIndex < radialResolution; radialIndex++ {
        for i32 tubularIndex = 0; tubularIndex < tubularResolution; tubularIndex++ {
            f32 u = cast(f32, tubularIndex) / cast(f32, tubularResolution) * 6.283185307f;
            f32 v = cast(f32, radialIndex) / cast(f32, radialResolution) * 6.283185307f;
            f32 x = (radius + thickness * b3Cos(v)) * b3Cos(u);
            f32 y = (radius + thickness * b3Cos(v)) * b3Sin(u);
            f32 z = thickness * b3Sin(v);
            var vertex = b3Vec3{x, y, z};
            while true {
                if vertices.count >= vertices.capacity {
                    var oldSize = cast(i32, vertices.capacity * sizeof(*vertices.data));
                    i32 newCapacity = vertices.capacity == 0 ? 8 : 2 * vertices.capacity;
                    var newSize = cast(i32, newCapacity * sizeof(*vertices.data));
                    vertices.data = b3GrowAlloc(vertices.data, oldSize, newSize);
                    vertices.capacity = newCapacity;
                }
                vertices.data[vertices.count++] = vertex;
                if !(0 != 0) { break; }
            }
        }
    }
    b3DynamicArray_int indices;
    for i32 radialIndex1 = 0; radialIndex1 < radialResolution; radialIndex1++ {
        i32 radialIndex2 = (radialIndex1 + 1) % radialResolution;
        for i32 tubularIndex1 = 0; tubularIndex1 < tubularResolution; tubularIndex1++ {
            i32 tubularIndex2 = (tubularIndex1 + 1) % tubularResolution;
            i32 index1 = radialIndex1 * tubularResolution + tubularIndex1;
            i32 index2 = radialIndex1 * tubularResolution + tubularIndex2;
            i32 index3 = radialIndex2 * tubularResolution + tubularIndex2;
            i32 index4 = radialIndex2 * tubularResolution + tubularIndex1;
            while true {
                if indices.count >= indices.capacity {
                    var oldSize = cast(i32, indices.capacity * sizeof(*indices.data));
                    i32 newCapacity = indices.capacity == 0 ? 8 : 2 * indices.capacity;
                    var newSize = cast(i32, newCapacity * sizeof(*indices.data));
                    indices.data = b3GrowAlloc(indices.data, oldSize, newSize);
                    indices.capacity = newCapacity;
                }
                indices.data[indices.count++] = index1;
                if !(0 != 0) { break; }
            }
            while true {
                if indices.count >= indices.capacity {
                    var oldSize = cast(i32, indices.capacity * sizeof(*indices.data));
                    i32 newCapacity = indices.capacity == 0 ? 8 : 2 * indices.capacity;
                    var newSize = cast(i32, newCapacity * sizeof(*indices.data));
                    indices.data = b3GrowAlloc(indices.data, oldSize, newSize);
                    indices.capacity = newCapacity;
                }
                indices.data[indices.count++] = index2;
                if !(0 != 0) { break; }
            }
            while true {
                if indices.count >= indices.capacity {
                    var oldSize = cast(i32, indices.capacity * sizeof(*indices.data));
                    i32 newCapacity = indices.capacity == 0 ? 8 : 2 * indices.capacity;
                    var newSize = cast(i32, newCapacity * sizeof(*indices.data));
                    indices.data = b3GrowAlloc(indices.data, oldSize, newSize);
                    indices.capacity = newCapacity;
                }
                indices.data[indices.count++] = index3;
                if !(0 != 0) { break; }
            }
            while true {
                if indices.count >= indices.capacity {
                    var oldSize = cast(i32, indices.capacity * sizeof(*indices.data));
                    i32 newCapacity = indices.capacity == 0 ? 8 : 2 * indices.capacity;
                    var newSize = cast(i32, newCapacity * sizeof(*indices.data));
                    indices.data = b3GrowAlloc(indices.data, oldSize, newSize);
                    indices.capacity = newCapacity;
                }
                indices.data[indices.count++] = index3;
                if !(0 != 0) { break; }
            }
            while true {
                if indices.count >= indices.capacity {
                    var oldSize = cast(i32, indices.capacity * sizeof(*indices.data));
                    i32 newCapacity = indices.capacity == 0 ? 8 : 2 * indices.capacity;
                    var newSize = cast(i32, newCapacity * sizeof(*indices.data));
                    indices.data = b3GrowAlloc(indices.data, oldSize, newSize);
                    indices.capacity = newCapacity;
                }
                indices.data[indices.count++] = index4;
                if !(0 != 0) { break; }
            }
            while true {
                if indices.count >= indices.capacity {
                    var oldSize = cast(i32, indices.capacity * sizeof(*indices.data));
                    i32 newCapacity = indices.capacity == 0 ? 8 : 2 * indices.capacity;
                    var newSize = cast(i32, newCapacity * sizeof(*indices.data));
                    indices.data = b3GrowAlloc(indices.data, oldSize, newSize);
                    indices.capacity = newCapacity;
                }
                indices.data[indices.count++] = index1;
                if !(0 != 0) { break; }
            }
        }
    }
    b3MeshDef def;
    def.vertexCount = vertices.count;
    def.vertices = vertices.data;
    def.triangleCount = indices.count / 3;
    def.indices = indices.data;
    def.useMedianSplit = false;
    def.identifyEdges = true;
    b3MeshData* meshData = b3CreateMesh(&def, null, 0);
    while true {
        b3Free(vertices.data, cast(u64, vertices.capacity * sizeof(*vertices.data)));
        vertices.data = null;
        vertices.count = 0;
        vertices.capacity = 0;
        if !(0 != 0) { break; }
    }
    while true {
        b3Free(indices.data, cast(u64, indices.capacity * sizeof(*indices.data)));
        indices.data = null;
        indices.count = 0;
        indices.capacity = 0;
        if !(0 != 0) { break; }
    }
    return meshData;
}

b3MeshData* b3CreateBoxMesh(b3Vec3 center, b3Vec3 extent, bool identifyEdges) {
    f32 x = extent.x;
    f32 y = extent.y;
    f32 z = extent.z;
    b3Vec3[8] vertices = {
        b3Vec3{x, y, z},
        b3Vec3{-x, y, z},
        b3Vec3{-x, -y, z},
        b3Vec3{x, -y, z},
        b3Vec3{x, y, -z},
        b3Vec3{-x, y, -z},
        b3Vec3{-x, -y, -z},
        b3Vec3{x, -y, -z},
    };
    for i32 i = 0; i < 8; ++i {
        vertices[i] = b3Add(vertices[i], center);
    }
    i32[36] indices = {
        0, 1, 3, 1, 2, 3, 0, 4, 1, 1, 4, 5, 0, 3, 7, 4, 0, 7, 4, 7, 5, 6, 5, 7, 1, 5, 2, 6, 2, 5, 3,
        2, 7, 6, 7, 2,
    };
    b3MeshDef def;
    def.vertexCount = 8;
    def.vertices = vertices;
    def.triangleCount = 12;
    def.indices = indices;
    def.useMedianSplit = false;
    def.identifyEdges = identifyEdges;
    return b3CreateMesh(&def, null, 0);
}

b3MeshData* b3CreateHollowBoxMesh(b3Vec3 center, b3Vec3 extent) {
    f32 x = extent.x;
    f32 y = extent.y;
    f32 z = extent.z;
    b3Vec3[8] vertices = {
        b3Vec3{x, y, z},
        b3Vec3{-x, y, z},
        b3Vec3{-x, -y, z},
        b3Vec3{x, -y, z},
        b3Vec3{x, y, -z},
        b3Vec3{-x, y, -z},
        b3Vec3{-x, -y, -z},
        b3Vec3{x, -y, -z},
    };
    for i32 i = 0; i < 8; ++i {
        vertices[i] = b3Add(vertices[i], center);
    }
    i32[36] indices = {
        3, 1, 0, 3, 2, 1, 1, 4, 0, 5, 4, 1, 7, 3, 0, 7, 0, 4, 5, 7, 4, 7, 5, 6, 2, 5, 1, 5, 2, 6, 7,
        2, 3, 2, 7, 6,
    };
    b3MeshDef def;
    def.vertexCount = 8;
    def.vertices = vertices;
    def.triangleCount = 12;
    def.indices = indices;
    def.useMedianSplit = false;
    def.identifyEdges = true;
    return b3CreateMesh(&def, null, 0);
}

b3MeshData* b3CreatePlatformMesh(b3Vec3 center, f32 height, f32 topWidth, f32 bottomWidth) {
    f32 hb = 0.5f * bottomWidth;
    f32 ht = 0.5f * topWidth;
    f32 hy = 0.5f * height;
    b3Vec3[8] vertices = {
        b3Vec3{ht, hy, ht},
        b3Vec3{-ht, hy, ht},
        b3Vec3{-hb, -hy, hb},
        b3Vec3{hb, -hy, hb},
        b3Vec3{ht, hy, -ht},
        b3Vec3{-ht, hy, -ht},
        b3Vec3{-hb, -hy, -hb},
        b3Vec3{hb, -hy, -hb},
    };
    for i32 i = 0; i < 8; ++i {
        vertices[i] = b3Add(vertices[i], center);
    }
    i32[36] indices = {
        0, 1, 3, 1, 2, 3, 0, 4, 1, 1, 4, 5, 0, 3, 7, 4, 0, 7, 4, 7, 5, 6, 5, 7, 1, 5, 2, 6, 2, 5, 3,
        2, 7, 6, 7, 2,
    };
    b3MeshDef def;
    def.vertexCount = 8;
    def.vertices = vertices;
    def.triangleCount = 12;
    def.indices = indices;
    def.useMedianSplit = true;
    def.identifyEdges = true;
    return b3CreateMesh(&def, null, 0);
}

// todo this should fail if the mesh has a height greater than B3_MESH_STACK_SIZE
b3MeshData* b3CreateMesh(b3MeshDef* def, i32* degenerateTriangleIndices, i32 degenerateCapacity) {
    if def.vertexCount < 3 || def.vertices == null || def.triangleCount <= 0 || def.indices == null {
        return null;
    }
    i32 triangleCount = def.triangleCount;
    if triangleCount == 0 {
        return null;
    }
    i32 vertexCount = def.vertexCount;
    b3AABB meshBounds = B3_BOUNDS3_EMPTY;
    noinit b3DynamicArray_int indices;
    while true {
        indices.data = 3 * triangleCount > 0 ? b3GrowAlloc(null, 0, cast(i32, 3 * triangleCount * sizeof(*indices.data))) : null;
        indices.count = 0;
        indices.capacity = 3 * triangleCount;
        if !(0 != 0) { break; }
    }
    noinit b3DynamicArray_b3Vec3 vertices;
    while true {
        vertices.data = vertexCount > 0 ? b3GrowAlloc(null, 0, cast(i32, vertexCount * sizeof(*vertices.data))) : null;
        vertices.count = 0;
        vertices.capacity = vertexCount;
        if !(0 != 0) { break; }
    }
    if def.weldVertices && def.weldTolerance > 0.0f {
        while true {
            while true {
                if vertices.capacity < vertexCount {
                    var oldSize = cast(i32, vertices.capacity * sizeof(*vertices.data));
                    var newSize = cast(i32, vertexCount * sizeof(*vertices.data));
                    vertices.data = b3GrowAlloc(vertices.data, oldSize, newSize);
                    vertices.capacity = vertexCount;
                }
                if !(0 != 0) { break; }
            }
            vertices.count = vertexCount;
            if !(0 != 0) { break; }
        }
        while true {
            while true {
                if indices.capacity < 3 * triangleCount {
                    var oldSize = cast(i32, indices.capacity * sizeof(*indices.data));
                    var newSize = cast(i32, 3 * triangleCount * sizeof(*indices.data));
                    indices.data = b3GrowAlloc(indices.data, oldSize, newSize);
                    indices.capacity = 3 * triangleCount;
                }
                if !(0 != 0) { break; }
            }
            indices.count = 3 * triangleCount;
            if !(0 != 0) { break; }
        }
        var data = b3WeldData{
            .srcVertices = def.vertices,
            .srcIndices = def.indices,
            .dstVertices = vertices.data,
            .dstIndices = indices.data,
            .vertexCount = vertexCount,
            .indexCount = 3 * triangleCount,
        };
        vertices.count = b3WeldVertices(&data, def.weldTolerance);
        vertexCount = vertices.count;
    } else {
        while true {
            i32 _n = vertexCount;
            if vertices.count + _n > vertices.capacity {
                i32 req = vertices.count + _n;
                i32 newCapacity = req > 2 ? req + (req >> 1) : 8;
                var oldSize = cast(i32, vertices.capacity * sizeof(*vertices.data));
                var newSize = cast(i32, newCapacity * sizeof(*vertices.data));
                vertices.data = b3GrowAlloc(vertices.data, oldSize, newSize);
                vertices.capacity = newCapacity;
            }
            memcpy(vertices.data + vertices.count, def.vertices, cast(u64, _n * sizeof(*vertices.data)));
            vertices.count += _n;
            if !(0 != 0) { break; }
        }
        while true {
            i32 _n = 3 * triangleCount;
            if indices.count + _n > indices.capacity {
                i32 req = indices.count + _n;
                i32 newCapacity = req > 2 ? req + (req >> 1) : 8;
                var oldSize = cast(i32, indices.capacity * sizeof(*indices.data));
                var newSize = cast(i32, newCapacity * sizeof(*indices.data));
                indices.data = b3GrowAlloc(indices.data, oldSize, newSize);
                indices.capacity = newCapacity;
            }
            memcpy(indices.data + indices.count, def.indices, cast(u64, _n * sizeof(*indices.data)));
            indices.count += _n;
            if !(0 != 0) { break; }
        }
    }
    noinit b3DynamicArray_b3Primitive primitives;
    while true {
        primitives.data = triangleCount > 0 ? b3GrowAlloc(null, 0, cast(i32, triangleCount * sizeof(*primitives.data))) : null;
        primitives.count = 0;
        primitives.capacity = triangleCount;
        if !(0 != 0) { break; }
    }
    i32 degenerateCount = 0;
    f32 minArea = 0.01f * (0.005f * b3GetLengthUnitsPerMeter()) * (0.005f * b3GetLengthUnitsPerMeter());
    f32 surfaceArea = 0.0f;
    i32 materialCount = 1;
    for i32 index = 0; index < triangleCount; ++index {
        i32 index1 = indices.data[3 * index + 0];
        i32 index2 = indices.data[3 * index + 1];
        i32 index3 = indices.data[3 * index + 2];
        b3Vec3 vertex1 = vertices.data[index1];
        b3Vec3 vertex2 = vertices.data[index2];
        b3Vec3 vertex3 = vertices.data[index3];
        b3Vec3 normal = b3Cross(b3Sub(vertex2, vertex1), b3Sub(vertex3, vertex1));
        f32 area = 0.5f * b3Length(normal);
        if area < minArea {
            if index1 != index2 && index1 != index3 && index2 != index3 {
                degenerateCount += 1;
                if degenerateTriangleIndices != null && degenerateCount < degenerateCapacity {
                    degenerateTriangleIndices[degenerateCount - 1] = index;
                }
            }
            continue;
        }
        surfaceArea += area;
        var box = b3AABB{
            b3Min(vertex1, b3Min(vertex2, vertex3)), b3Max(vertex1, b3Max(vertex2, vertex3)),
        };
        b3Vec3 center = b3AABB_Center(box);
        var primitive = b3Primitive{.aabb = box, .center = center, .triangleIndex = index};
        while true {
            if primitives.count >= primitives.capacity {
                var oldSize = cast(i32, primitives.capacity * sizeof(*primitives.data));
                i32 newCapacity = primitives.capacity == 0 ? 8 : 2 * primitives.capacity;
                var newSize = cast(i32, newCapacity * sizeof(*primitives.data));
                primitives.data = b3GrowAlloc(primitives.data, oldSize, newSize);
                primitives.capacity = newCapacity;
            }
            primitives.data[primitives.count++] = primitive;
            if !(0 != 0) { break; }
        }
        if def.materialIndices != null {
            materialCount = b3MaxInt(materialCount, cast(i32, def.materialIndices[index] + 1));
        }
        meshBounds = b3AABB_Union(meshBounds, box);
    }
    triangleCount = primitives.count;
    if b3IsSaneAABB(meshBounds) == false {
        while true {
            b3Free(primitives.data, cast(u64, primitives.capacity * sizeof(*primitives.data)));
            primitives.data = null;
            primitives.count = 0;
            primitives.capacity = 0;
            if !(0 != 0) { break; }
        }
        return null;
    }
    noinit b3DynamicArray_b3MeshNode tempNodes;
    while true {
        tempNodes.data = 2 * triangleCount - 1 > 0 ? b3GrowAlloc(null, 0, cast(i32, (2 * triangleCount - 1) * sizeof(*tempNodes.data))) : null;
        tempNodes.count = 0;
        tempNodes.capacity = 2 * triangleCount - 1;
        if !(0 != 0) { break; }
    }
    i32 treeHeight = 0;
    b3BuildRecursive(&tempNodes, triangleCount, primitives.data, primitives.data, def.useMedianSplit, &treeHeight);
    u64 byteCount = b3AlignUp8(cast(u64, sizeof(b3MeshData)));
    var nodeOffset = cast(i32, byteCount);
    byteCount += b3AlignUp8(cast(u64, tempNodes.count * sizeof(b3MeshNode)));
    var vertexOffset = cast(i32, byteCount);
    byteCount += b3AlignUp8(cast(u64, vertexCount * sizeof(b3Vec3)));
    var triangleOffset = cast(i32, byteCount);
    byteCount += b3AlignUp8(cast(u64, triangleCount * sizeof(b3MeshTriangle)));
    var materialIndicesOffset = cast(i32, byteCount);
    byteCount += b3AlignUp8(cast(u64, triangleCount * sizeof(u8)));
    var flagsOffset = cast(i32, byteCount);
    byteCount += b3AlignUp8(cast(u64, triangleCount * sizeof(u8)));
    b3MeshData* mesh = b3Alloc(byteCount);
    memset(mesh, 0, byteCount);
    mesh.version = 0xABD11AB62A6E886D;
    mesh.byteCount = cast(i32, byteCount);
    mesh.bounds = meshBounds;
    mesh.surfaceArea = surfaceArea;
    mesh.nodeCount = tempNodes.count;
    mesh.treeHeight = treeHeight;
    mesh.vertexCount = vertexCount;
    mesh.triangleCount = triangleCount;
    mesh.degenerateCount = degenerateCount;
    mesh.nodeOffset = nodeOffset;
    mesh.vertexOffset = vertexOffset;
    mesh.triangleOffset = triangleOffset;
    mesh.materialOffset = materialIndicesOffset;
    mesh.materialCount = materialCount;
    mesh.flagsOffset = flagsOffset;
    b3MeshNode* nodes = b3GetMeshNodesWrite(mesh);
    b3MeshTriangle* triangles = b3GetMeshTrianglesWrite(mesh);
    b3Vec3* meshVertices = b3GetMeshVerticesWrite(mesh);
    u8* materialIndices = b3GetMeshMaterialIndicesWrite(mesh);
    u8* flags = b3GetMeshFlagsWrite(mesh);
    memcpy(nodes, tempNodes.data, cast(u64, tempNodes.count * sizeof(b3MeshNode)));
    memcpy(meshVertices, vertices.data, cast(u64, vertexCount * sizeof(b3Vec3)));
    for i32 index = 0; index < triangleCount; ++index {
        b3Primitive primitive = primitives.data[index];
        triangles[index].index1 = indices.data[3 * primitive.triangleIndex + 0];
        triangles[index].index2 = indices.data[3 * primitive.triangleIndex + 1];
        triangles[index].index3 = indices.data[3 * primitive.triangleIndex + 2];
        flags[index] = 0;
        if def.materialIndices != null {
            u8 materialIndex = def.materialIndices[primitive.triangleIndex];
            materialIndices[index] = materialIndex;
        }
    }
    bool success = b3SortMeshTriangles(mesh);
    if success == false {
        while true {
            b3Free(tempNodes.data, cast(u64, tempNodes.capacity * sizeof(*tempNodes.data)));
            tempNodes.data = null;
            tempNodes.count = 0;
            tempNodes.capacity = 0;
            if !(0 != 0) { break; }
        }
        while true {
            b3Free(primitives.data, cast(u64, primitives.capacity * sizeof(*primitives.data)));
            primitives.data = null;
            primitives.count = 0;
            primitives.capacity = 0;
            if !(0 != 0) { break; }
        }
        return null;
    }
    if def.identifyEdges != 0 {
        b3IdentifyEdges(mesh);
    }
    while true {
        b3Free(tempNodes.data, cast(u64, tempNodes.capacity * sizeof(*tempNodes.data)));
        tempNodes.data = null;
        tempNodes.count = 0;
        tempNodes.capacity = 0;
        if !(0 != 0) { break; }
    }
    while true {
        b3Free(primitives.data, cast(u64, primitives.capacity * sizeof(*primitives.data)));
        primitives.data = null;
        primitives.count = 0;
        primitives.capacity = 0;
        if !(0 != 0) { break; }
    }
    while true {
        b3Free(indices.data, cast(u64, indices.capacity * sizeof(*indices.data)));
        indices.data = null;
        indices.count = 0;
        indices.capacity = 0;
        if !(0 != 0) { break; }
    }
    while true {
        b3Free(vertices.data, cast(u64, vertices.capacity * sizeof(*vertices.data)));
        vertices.data = null;
        vertices.count = 0;
        vertices.capacity = 0;
        if !(0 != 0) { break; }
    }
    mesh.hash = 0;
    mesh.hash = b3NonZeroHash(b3Hash(5381, cast(u8*, mesh), mesh.byteCount));
    return mesh;
}

void b3DestroyMesh(b3MeshData* mesh) {
    b3Free(mesh, cast(u64, mesh.byteCount));
}

bool b3OverlapMesh(b3Mesh* shape, b3Transform shapeTransform, b3ShapeProxy* proxy) {
    b3SimplexCache cache;
    noinit b3Vec3[64] buffer;
    b3ShapeProxy localProxy = b3MakeLocalProxy(proxy, shapeTransform, buffer);
    b3AABB aabb = b3ComputeProxyAABB(&localProxy);
    b3Vec3 meshScale = shape.scale;
    b3V32 scale = b3LoadV(&meshScale.x);
    b3V32 invScale = b3DivV(b3_oneV, scale);
    b3V32 temp1 = b3MulV(invScale, b3LoadV(&aabb.lowerBound.x));
    b3V32 temp2 = b3MulV(invScale, b3LoadV(&aabb.upperBound.x));
    b3V32 invScaledBoundsMin = b3MinV(temp1, temp2);
    b3V32 invScaledBoundsMax = b3MaxV(temp1, temp2);
    b3V32 invScaledBoundsCenter = b3MulV(b3_halfV, b3AddV(invScaledBoundsMin, invScaledBoundsMax));
    b3V32 invScaledBoundsExtent = b3SubV(invScaledBoundsMax, invScaledBoundsCenter);
    noinit b3DistanceInput input;
    input.proxyB = localProxy;
    input.transform = b3Transform_identity;
    input.useRadii = true;
    i32 count = 0;
    noinit b3MeshNode*[256] stack;
    b3MeshNode* node = b3GetRoot(shape.data);
    b3MeshTriangle* triangles = b3GetMeshTriangles(shape.data);
    b3Vec3* vertices = b3GetMeshVertices(shape.data);
    while true {
        b3V32 nodeMin = b3LoadV(&node.lowerBound.x);
        b3V32 nodeMax = b3LoadV(&node.upperBound.x);
        if b3TestBoundsOverlap(nodeMin, nodeMax, invScaledBoundsMin, invScaledBoundsMax) != 0 {
            if mesh__b3IsLeaf(node) != 0 {
                var triangleCount = cast(i32, node.data.asLeaf.triangleCount);
                var triangleOffset = cast(i32, node.triangleOffset);
                for i32 index = 0; index < triangleCount; ++index {
                    i32 triangleIndex = triangleOffset + index;
                    b3MeshTriangle triangle = triangles[triangleIndex];
                    b3Vec3 vertex1 = vertices[triangle.index1];
                    b3Vec3 vertex2 = vertices[triangle.index2];
                    b3Vec3 vertex3 = vertices[triangle.index3];
                    b3V32 v1 = b3LoadV(&vertex1.x);
                    b3V32 v2 = b3LoadV(&vertex2.x);
                    b3V32 v3 = b3LoadV(&vertex3.x);
                    if b3TestBoundsTriangleOverlap(invScaledBoundsCenter, invScaledBoundsExtent, v1, v2, v3) != 0 {
                        b3Vec3[3] triangleVertices = {
                            b3Mul(meshScale, vertex1), b3Mul(meshScale, vertex2),
                            b3Mul(meshScale, vertex3),
                        };
                        input.proxyA = b3ShapeProxy{triangleVertices, 3, 0.0f};
                        cache.count = 0;
                        b3DistanceOutput output = b3ShapeDistance(&input, &cache, null, 0);
                        f32 tolerance = 0.1f * (0.005f * b3GetLengthUnitsPerMeter());
                        if output.distance < tolerance {
                            return true;
                        }
                    }
                }
            } else {
                stack[count++] = b3GetRightChild(node);
                node = b3GetLeftChild(node);
                continue;
            }
        }
        if count == 0 {
            break;
        }
        node = stack[--count];
    }
    return false;
}

b3AABB b3ComputeMeshAABB(b3MeshData* shape, b3Transform transform, b3Vec3 scale) {
    b3Vec3 scaledLower = b3Mul(scale, shape.bounds.lowerBound);
    b3Vec3 scaledUpper = b3Mul(scale, shape.bounds.upperBound);
    var bounds = b3AABB{b3Min(scaledLower, scaledUpper), b3Max(scaledLower, scaledUpper)};
    return b3AABB_Transform(transform, bounds);
}

b3CastOutput b3RayCastMesh(b3Mesh* mesh, b3RayCastInput* input) {
    b3MeshData* data = mesh.data;
    b3Vec3 meshScale = mesh.scale;
    b3CastOutput bestOutput;
    bestOutput.fraction = input.maxFraction;
    bestOutput.triangleIndex = -1;
    b3V32 lambda = b3SplatV(input.maxFraction);
    b3V32 rayStart = b3LoadV(&input.origin.x);
    b3V32 rayDelta = b3LoadV(&input.translation.x);
    b3V32 scale = b3LoadV(&meshScale.x);
    b3V32 invScale = b3DivV(b3_oneV, scale);
    bool clockwise = meshScale.x * meshScale.y * meshScale.z < 0.0f;
    b3V32 invScaledRayStart = b3MulV(invScale, rayStart);
    b3V32 invScaledRayDelta = b3MulV(invScale, rayDelta);
    b3V32 invScaledRayEnd = b3AddV(invScaledRayStart, b3MulV(lambda, invScaledRayDelta));
    b3V32 invScaledRayMin = b3MinV(invScaledRayStart, invScaledRayEnd);
    b3V32 invScaledRayMax = b3MaxV(invScaledRayStart, invScaledRayEnd);
    i32 count = 0;
    noinit b3MeshNode*[256] stack;
    b3MeshNode* node = b3GetRoot(data);
    b3MeshTriangle* triangles = b3GetMeshTriangles(data);
    b3Vec3* vertices = b3GetMeshVertices(data);
    u8* materialIndices = b3GetMeshMaterialIndices(data);
    while true {
        b3V32 nodeMin = b3LoadV(&node.lowerBound.x);
        b3V32 nodeMax = b3LoadV(&node.upperBound.x);
        if b3TestBoundsOverlap(nodeMin, nodeMax, invScaledRayMin, invScaledRayMax) && b3TestBoundsRayOverlap(nodeMin, nodeMax, invScaledRayStart, invScaledRayDelta) {
            if mesh__b3IsLeaf(node) != 0 {
                var triangleCount = cast(i32, node.data.asLeaf.triangleCount);
                var triangleOffset = cast(i32, node.triangleOffset);
                for i32 index = 0; index < triangleCount; ++index {
                    i32 triangleIndex = triangleOffset + index;
                    b3MeshTriangle triangle = triangles[triangleIndex];
                    b3Vec3 vertex1 = b3Mul(meshScale, vertices[triangle.index1]);
                    noinit b3Vec3 vertex2;
                    noinit b3Vec3 vertex3;
                    if clockwise != 0 {
                        vertex2 = b3Mul(meshScale, vertices[triangle.index3]);
                        vertex3 = b3Mul(meshScale, vertices[triangle.index2]);
                    } else {
                        vertex2 = b3Mul(meshScale, vertices[triangle.index2]);
                        vertex3 = b3Mul(meshScale, vertices[triangle.index3]);
                    }
                    b3V32 v1 = b3LoadV(&vertex1.x);
                    b3V32 v2 = b3LoadV(&vertex2.x);
                    b3V32 v3 = b3LoadV(&vertex3.x);
                    f32 alpha = b3IntersectRayTriangle(rayStart, rayDelta, v1, v2, v3);
                    if alpha < bestOutput.fraction {
                        b3Vec3 edge1 = b3Sub(vertex2, vertex1);
                        b3Vec3 edge2 = b3Sub(vertex3, vertex1);
                        bestOutput.normal = b3Normalize(b3Cross(edge1, edge2));
                        bestOutput.point = b3Add(input.origin, b3MulSV(alpha, input.translation));
                        bestOutput.fraction = alpha;
                        bestOutput.triangleIndex = triangleIndex;
                        bestOutput.materialIndex = cast(i32, materialIndices[triangleIndex]);
                        bestOutput.hit = true;
                        lambda = b3SplatV(alpha);
                        invScaledRayEnd = b3AddV(invScaledRayStart, b3MulV(lambda, invScaledRayDelta));
                        invScaledRayMin = b3MinV(invScaledRayStart, invScaledRayEnd);
                        invScaledRayMax = b3MaxV(invScaledRayStart, invScaledRayEnd);
                    }
                }
            } else {
                var axis = cast(i32, node.data.asNode.axis);
                if b3GetV(invScaledRayDelta, axis) > 0.0f {
                    stack[count++] = b3GetRightChild(node);
                    node = b3GetLeftChild(node);
                } else {
                    stack[count++] = b3GetLeftChild(node);
                    node = b3GetRightChild(node);
                }
                continue;
            }
        }
        if count == 0 {
            break;
        }
        node = stack[--count];
    }
    return bestOutput;
}

b3CastOutput b3ShapeCastMesh(b3Mesh* mesh, b3ShapeCastInput* input) {
    b3MeshData* data = mesh.data;
    b3Vec3 meshScale = mesh.scale;
    b3CastOutput bestOutput;
    bestOutput.fraction = input.maxFraction;
    bestOutput.triangleIndex = -1;
    b3V32 lambda = b3SplatV(input.maxFraction);
    b3AABB shapeBounds = b3MakeAABB(input.proxy.points, input.proxy.count, input.proxy.radius);
    b3Vec3 center = b3AABB_Center(shapeBounds);
    b3Vec3 extents = b3AABB_Extents(shapeBounds);
    b3V32 shapeExtent = b3LoadV(&extents.x);
    b3V32 rayStart = b3LoadV(&center.x);
    b3V32 rayDelta = b3LoadV(&input.translation.x);
    b3V32 rayEnd = b3AddV(rayStart, b3MulV(lambda, rayDelta));
    b3V32 rayMin = b3MinV(rayStart, rayEnd);
    b3V32 rayMax = b3MaxV(rayStart, rayEnd);
    b3V32 scale = b3LoadV(&meshScale.x);
    b3V32 invScale = b3DivV(b3_oneV, scale);
    b3V32 absInvScale = b3AbsV(invScale);
    bool clockwise = meshScale.x * meshScale.y * meshScale.z < 0.0f;
    b3V32 invScaledRayStart = b3MulV(invScale, rayStart);
    b3V32 invScaledRayDelta = b3MulV(invScale, rayDelta);
    b3V32 invScaledRayEnd = b3AddV(invScaledRayStart, b3MulV(lambda, invScaledRayDelta));
    b3V32 invScaledRayMin = b3MinV(invScaledRayStart, invScaledRayEnd);
    b3V32 invScaledRayMax = b3MaxV(invScaledRayStart, invScaledRayEnd);
    b3V32 invScaledShapeExtent = b3MulV(absInvScale, shapeExtent);
    i32 count = 0;
    noinit b3MeshNode*[256] stack;
    b3MeshNode* node = b3GetRoot(data);
    b3MeshTriangle* triangles = b3GetMeshTriangles(data);
    b3Vec3* vertices = b3GetMeshVertices(data);
    u8* materialIndices = b3GetMeshMaterialIndices(data);
    while true {
        b3V32 nodeMin = b3SubV(b3LoadV(&node.lowerBound.x), invScaledShapeExtent);
        b3V32 nodeMax = b3AddV(b3LoadV(&node.upperBound.x), invScaledShapeExtent);
        if b3TestBoundsOverlap(nodeMin, nodeMax, invScaledRayMin, invScaledRayMax) && b3TestBoundsRayOverlap(nodeMin, nodeMax, invScaledRayStart, invScaledRayDelta) {
            if mesh__b3IsLeaf(node) != 0 {
                var triangleCount = cast(i32, node.data.asLeaf.triangleCount);
                var triangleOffset = cast(i32, node.triangleOffset);
                for i32 index = 0; index < triangleCount; ++index {
                    i32 triangleIndex = triangleOffset + index;
                    b3MeshTriangle triangle = triangles[triangleIndex];
                    b3Vec3 vertex1 = b3Mul(meshScale, vertices[triangle.index1]);
                    noinit b3Vec3 vertex2;
                    noinit b3Vec3 vertex3;
                    if clockwise != 0 {
                        vertex2 = b3Mul(meshScale, vertices[triangle.index3]);
                        vertex3 = b3Mul(meshScale, vertices[triangle.index2]);
                    } else {
                        vertex2 = b3Mul(meshScale, vertices[triangle.index2]);
                        vertex3 = b3Mul(meshScale, vertices[triangle.index3]);
                    }
                    b3V32 v1 = b3LoadV(&vertex1.x);
                    b3V32 v2 = b3LoadV(&vertex2.x);
                    b3V32 v3 = b3LoadV(&vertex3.x);
                    b3V32 triangleMin = b3SubV(b3MinV(v1, b3MinV(v2, v3)), shapeExtent);
                    b3V32 triangleMax = b3AddV(b3MaxV(v1, b3MaxV(v2, v3)), shapeExtent);
                    if b3TestBoundsOverlap(triangleMin, triangleMax, rayMin, rayMax) != 0 {
                        b3Vec3 origin = vertex1;
                        b3Vec3[3] triangleVertices = {
                            b3Vec3_zero, b3Sub(vertex2, origin), b3Sub(vertex3, origin),
                        };
                        var shiftedOrigin = b3Transform{b3Neg(origin), b3Quat_identity};
                        noinit b3ShapeCastPairInput pairInput;
                        pairInput.proxyA = b3ShapeProxy{triangleVertices, 3, 0.0f};
                        pairInput.proxyB = input.proxy;
                        pairInput.transform = shiftedOrigin;
                        pairInput.maxFraction = bestOutput.fraction;
                        pairInput.translationB = input.translation;
                        pairInput.canEncroach = input.canEncroach;
                        b3CastOutput pairOutput = b3ShapeCast(&pairInput);
                        if pairOutput.hit != 0 {
                            pairOutput.point = b3Add(pairOutput.point, origin);
                            bestOutput = pairOutput;
                            bestOutput.triangleIndex = triangleIndex;
                            bestOutput.materialIndex = cast(i32, materialIndices[triangleIndex]);
                            lambda = b3SplatV(pairOutput.fraction);
                            rayEnd = b3AddV(rayStart, b3MulV(lambda, rayDelta));
                            rayMin = b3MinV(rayStart, rayEnd);
                            rayMax = b3MaxV(rayStart, rayEnd);
                            invScaledRayEnd = b3AddV(invScaledRayStart, b3MulV(lambda, invScaledRayDelta));
                            invScaledRayMin = b3MinV(invScaledRayStart, invScaledRayEnd);
                            invScaledRayMax = b3MaxV(invScaledRayStart, invScaledRayEnd);
                        }
                    }
                }
            } else {
                var axis = cast(i32, node.data.asNode.axis);
                if b3GetV(invScaledRayDelta, axis) > 0.0f {
                    stack[count++] = b3GetRightChild(node);
                    node = b3GetLeftChild(node);
                } else {
                    stack[count++] = b3GetLeftChild(node);
                    node = b3GetRightChild(node);
                }
                continue;
            }
        }
        if count == 0 {
            break;
        }
        node = stack[--count];
    }
    return bestOutput;
}

b3Triangle b3GetMeshTriangle(b3Mesh* mesh, i32 triangleIndex) {
    b3MeshTriangle* triangles = b3GetMeshTriangles(mesh.data);
    u8* flags = b3GetMeshFlags(mesh.data);
    b3Vec3* vertices = b3GetMeshVertices(mesh.data);
    noinit b3Triangle result;
    b3MeshTriangle triangle = triangles[triangleIndex];
    u8 triangleFlags = flags[triangleIndex];
    b3Vec3 scale = mesh.scale;
    result.vertices[0] = b3Mul(scale, vertices[triangle.index1]);
    result.i1 = triangle.index1;
    if scale.x * scale.y * scale.z < 0.0f {
        result.vertices[1] = b3Mul(scale, vertices[triangle.index3]);
        result.vertices[2] = b3Mul(scale, vertices[triangle.index2]);
        result.i2 = triangle.index3;
        result.i3 = triangle.index2;
        result.flags = 0;
        result.flags |= (triangleFlags & b3_inverseConcaveEdge1) != 0 ? b3_concaveEdge1 : 0;
        result.flags |= (triangleFlags & b3_inverseConcaveEdge2) != 0 ? b3_concaveEdge2 : 0;
        result.flags |= (triangleFlags & b3_inverseConcaveEdge3) != 0 ? b3_concaveEdge3 : 0;
    } else {
        result.vertices[1] = b3Mul(scale, vertices[triangle.index2]);
        result.vertices[2] = b3Mul(scale, vertices[triangle.index3]);
        result.i2 = triangle.index2;
        result.i3 = triangle.index3;
        result.flags = cast(i32, triangleFlags);
    }
    return result;
}

i32 b3CollideMoverAndMesh(b3PlaneResult* planes, i32 capacity, b3Mesh* shape, b3Capsule* mover) {
    if capacity == 0 {
        return 0;
    }
    b3DistanceInput distanceInput;
    distanceInput.proxyB = b3ShapeProxy{&mover.center1, 2, 0.0f};
    distanceInput.transform = b3Transform_identity;
    distanceInput.useRadii = false;
    b3SimplexCache cache;
    f32 radius = mover.radius;
    b3V32 center1 = b3LoadV(&mover.center1.x);
    b3V32 center2 = b3LoadV(&mover.center2.x);
    b3V32 r = b3SplatV(radius);
    b3V32 boundsMin = b3SubV(b3MinV(center1, center2), r);
    b3V32 boundsMax = b3AddV(b3MaxV(center1, center2), r);
    b3Vec3 meshScale = shape.scale;
    b3V32 scale = b3LoadV(&meshScale.x);
    b3V32 invScale = b3DivV(b3_oneV, scale);
    b3V32 temp1 = b3MulV(invScale, boundsMin);
    b3V32 temp2 = b3MulV(invScale, boundsMax);
    b3V32 invScaledBoundsMin = b3MinV(temp1, temp2);
    b3V32 invScaledBoundsMax = b3MaxV(temp1, temp2);
    b3V32 invScaledBoundsCenter = b3MulV(b3_halfV, b3AddV(invScaledBoundsMin, invScaledBoundsMax));
    b3V32 invScaledBoundsExtent = b3SubV(invScaledBoundsMax, invScaledBoundsCenter);
    i32 count = 0;
    noinit b3MeshNode*[256] stack;
    b3MeshNode* node = b3GetRoot(shape.data);
    b3MeshTriangle* triangles = b3GetMeshTriangles(shape.data);
    b3Vec3* vertices = b3GetMeshVertices(shape.data);
    i32 planeCount = 0;
    while planeCount < capacity {
        b3V32 nodeMin = b3LoadV(&node.lowerBound.x);
        b3V32 nodeMax = b3LoadV(&node.upperBound.x);
        if b3TestBoundsOverlap(nodeMin, nodeMax, invScaledBoundsMin, invScaledBoundsMax) != 0 {
            if mesh__b3IsLeaf(node) != 0 {
                var triangleCount = cast(i32, node.data.asLeaf.triangleCount);
                var triangleOffset = cast(i32, node.triangleOffset);
                for i32 index = 0; index < triangleCount; ++index {
                    i32 triangleIndex = triangleOffset + index;
                    b3MeshTriangle triangle = triangles[triangleIndex];
                    b3Vec3 vertex1 = vertices[triangle.index1];
                    b3Vec3 vertex2 = vertices[triangle.index2];
                    b3Vec3 vertex3 = vertices[triangle.index3];
                    b3V32 v1 = b3LoadV(&vertex1.x);
                    b3V32 v2 = b3LoadV(&vertex2.x);
                    b3V32 v3 = b3LoadV(&vertex3.x);
                    if b3TestBoundsTriangleOverlap(invScaledBoundsCenter, invScaledBoundsExtent, v1, v2, v3) != 0 {
                        b3Vec3[3] triangleVertices = {
                            b3Mul(meshScale, vertex1), b3Mul(meshScale, vertex2),
                            b3Mul(meshScale, vertex3),
                        };
                        distanceInput.proxyA = b3ShapeProxy{triangleVertices, 3, 0.0f};
                        cache.count = 0;
                        b3DistanceOutput distanceOutput = b3ShapeDistance(&distanceInput, &cache, null, 0);
                        if distanceOutput.distance == 0.0f {
                        } else if distanceOutput.distance <= mover.radius {
                            var plane = b3Plane{
                                distanceOutput.normal, mover.radius - distanceOutput.distance,
                            };
                            planes[planeCount] = b3PlaneResult{plane, distanceOutput.pointA};
                            planeCount += 1;
                            if planeCount == capacity {
                                return planeCount;
                            }
                        }
                    }
                }
            } else {
                stack[count++] = b3GetRightChild(node);
                node = b3GetLeftChild(node);
                continue;
            }
        }
        if count == 0 {
            break;
        }
        node = stack[--count];
    }
    return planeCount;
}

void b3QueryMesh(b3Mesh* mesh, b3AABB bounds, b3MeshQueryFcn fcn, void* context) {
    b3Vec3 meshScale = mesh.scale;
    bool clockwise = meshScale.x * meshScale.y * meshScale.z > 0.0f;
    b3V32 scale = b3LoadV(&meshScale.x);
    b3V32 invScale = b3DivV(b3_oneV, scale);
    b3V32 temp1 = b3MulV(invScale, b3LoadV(&bounds.lowerBound.x));
    b3V32 temp2 = b3MulV(invScale, b3LoadV(&bounds.upperBound.x));
    b3V32 invScaledBoundsMin = b3MinV(temp1, temp2);
    b3V32 invScaledBoundsMax = b3MaxV(temp1, temp2);
    b3V32 invScaledBoundsCenter = b3MulV(b3_halfV, b3AddV(invScaledBoundsMin, invScaledBoundsMax));
    b3V32 invScaledBoundsExtent = b3SubV(invScaledBoundsMax, invScaledBoundsCenter);
    b3MeshData* data = mesh.data;
    i32 count = 0;
    noinit b3MeshNode*[256] stack;
    b3MeshNode* node = b3GetRoot(data);
    b3MeshTriangle* triangles = b3GetMeshTriangles(data);
    b3Vec3* vertices = b3GetMeshVertices(data);
    while true {
        b3V32 nodeMin = b3LoadV(&node.lowerBound.x);
        b3V32 nodeMax = b3LoadV(&node.upperBound.x);
        if b3TestBoundsOverlap(nodeMin, nodeMax, invScaledBoundsMin, invScaledBoundsMax) != 0 {
            if mesh__b3IsLeaf(node) != 0 {
                var triangleCount = cast(i32, node.data.asLeaf.triangleCount);
                var triangleOffset = cast(i32, node.triangleOffset);
                for i32 index = 0; index < triangleCount; ++index {
                    i32 triangleIndex = triangleOffset + index;
                    b3MeshTriangle triangle = triangles[triangleIndex];
                    b3Vec3 vertex1 = vertices[triangle.index1];
                    b3Vec3 vertex2 = vertices[triangle.index2];
                    b3Vec3 vertex3 = vertices[triangle.index3];
                    b3V32 v1 = b3LoadV(&vertex1.x);
                    b3V32 v2 = b3LoadV(&vertex2.x);
                    b3V32 v3 = b3LoadV(&vertex3.x);
                    if b3TestBoundsTriangleOverlap(invScaledBoundsCenter, invScaledBoundsExtent, v1, v2, v3) != 0 {
                        b3Vec3 a = b3Mul(meshScale, vertex1);
                        noinit b3Vec3 b;
                        noinit b3Vec3 c;
                        if clockwise != 0 {
                            b = b3Mul(meshScale, vertex2);
                            c = b3Mul(meshScale, vertex3);
                        } else {
                            b = b3Mul(meshScale, vertex3);
                            c = b3Mul(meshScale, vertex2);
                        }
                        bool result = fcn(a, b, c, triangleIndex, context) != 0;
                        if result == false {
                            return;
                        }
                    }
                }
            } else {
                stack[count++] = b3GetRightChild(node);
                node = b3GetLeftChild(node);
                continue;
            }
        }
        if count == 0 {
            break;
        }
        node = stack[--count];
    }
}

private {
bool b3CollectTriangleIndicesCallback(b3Vec3 a, b3Vec3 b, b3Vec3 c, i32 triangleIndex, void* context) {
    ignore a;
    ignore b;
    ignore c;
    var triangleContext = cast(b3TriangleQueryContext*, context);
    if triangleContext.count == triangleContext.capacity {
        return false;
    }
    triangleContext.indices[triangleContext.count] = triangleIndex;
    triangleContext.count += 1;
    return triangleContext.count < triangleContext.capacity;
}

i32 b3QueryMeshTriangles(i32* indices, i32 capacity, b3Mesh* mesh, b3AABB bounds) {
    var context = b3TriangleQueryContext{.indices = indices, .capacity = capacity, .count = 0};
    b3QueryMesh(mesh, bounds, cast(b3MeshQueryFcn, b3CollectTriangleIndicesCallback), &context);
    return context.count;
}

i32 b3QueryHeightFieldTriangles(i32* indices, i32 capacity, b3HeightFieldData* heightField, b3AABB bounds) {
    var context = b3TriangleQueryContext{.indices = indices, .capacity = capacity, .count = 0};
    b3QueryHeightField(heightField, bounds, cast(b3MeshQueryFcn, b3CollectTriangleIndicesCallback), &context);
    return context.count;
}

void b3RefreshCache(b3Contact* contact, b3Shape* shapeA, b3WorldTransform xfA, b3AABB* bounds) {
    b3MeshContact* meshContact = &contact.meshContact;
    if b3AABB_Contains(meshContact.queryBounds, *bounds) != 0 {
        if shapeA.type == b3_meshShape {
            for i32 i = 0; i < contact.meshContact.triangleCache.count; ++i {
            }
        }
        return;
    }
    f32 radius = 0.05f * b3GetLengthUnitsPerMeter() + 4.0f * (0.005f * b3GetLengthUnitsPerMeter());
    var extension = b3Vec3{radius, radius, radius};
    meshContact.queryBounds.lowerBound = b3Sub(bounds.lowerBound, extension);
    meshContact.queryBounds.upperBound = b3Add(bounds.upperBound, extension);
    i32 triangleCapacity = 256;
    noinit i32[256] triangleIndices;
    b3Transform meshTransform = b3ToRelativeTransform(xfA, b3Pos_zero);
    b3AABB localBounds = b3AABB_Transform(b3InvertTransform(meshTransform), meshContact.queryBounds);
    i32 triangleCount;
    if shapeA.type == b3_meshShape {
        triangleCount = b3QueryMeshTriangles(triangleIndices, triangleCapacity, &shapeA.mesh, localBounds);
    } else {
        triangleCount = b3QueryHeightFieldTriangles(triangleIndices, triangleCapacity, shapeA.heightField, localBounds);
    }
    if triangleCount == triangleCapacity {
        if b3RefreshCache__s_once == false {
            b3Log("WARNING: complex mesh detected, triangle buffer capacity of %d reached", triangleCapacity);
            b3RefreshCache__s_once = true;
        }
    }
    noinit b3ContactCache[256] contactCache;
    i32 index2 = 0;
    for i32 index1 = 0; index1 < triangleCount; ++index1 {
        contactCache[index1] = b3ContactCache{};
        while index2 < contact.meshContact.triangleCache.count && contact.meshContact.triangleCache.data[index2].triangleIndex < triangleIndices[index1] {
            index2 += 1;
        }
        if index2 < contact.meshContact.triangleCache.count && contact.meshContact.triangleCache.data[index2].triangleIndex == triangleIndices[index1] {
            contactCache[index1] = contact.meshContact.triangleCache.data[index2].cache;
        }
    }
    while true {
        while true {
            if contact.meshContact.triangleCache.capacity < triangleCount {
                var oldSize = cast(i32, contact.meshContact.triangleCache.capacity * sizeof(*contact.meshContact.triangleCache.data));
                var newSize = cast(i32, triangleCount * sizeof(*contact.meshContact.triangleCache.data));
                contact.meshContact.triangleCache.data = b3GrowAlloc(contact.meshContact.triangleCache.data, oldSize, newSize);
                contact.meshContact.triangleCache.capacity = triangleCount;
            }
            if !(0 != 0) { break; }
        }
        contact.meshContact.triangleCache.count = triangleCount;
        if !(0 != 0) { break; }
    }
    for i32 i = 0; i < triangleCount; ++i {
        contact.meshContact.triangleCache.data[i] = b3TriangleCache{triangleIndices[i], contactCache[i]};
        if shapeA.type == b3_meshShape {
        }
    }
}

bool b3AddEdge(b3FoundEdges* edges, i32 vertex1, i32 vertex2) {
    var i1 = cast(u64, b3MinInt(vertex1, vertex2));
    var i2 = cast(u64, b3MaxInt(vertex1, vertex2));
    u64 key = i1 << 32 | i2;
    i32 count = edges.count;
    for i32 i = 0; i < count; ++i {
        if edges.keys[i] == key {
            return false;
        }
    }
    if count == 64 {
        return true;
    }
    edges.keys[count] = key;
    edges.count += 1;
    return true;
}

bool b3FindEdge(b3FoundEdges* edges, i32 vertex1, i32 vertex2) {
    var i1 = cast(u64, b3MinInt(vertex1, vertex2));
    var i2 = cast(u64, b3MaxInt(vertex1, vertex2));
    u64 key = i1 << 32 | i2;
    i32 count = edges.count;
    for i32 i = 0; i < count; ++i {
        if edges.keys[i] == key {
            return true;
        }
    }
    return false;
}

bool b3AddVertex(b3FoundVertices* vertices, i32 vertex) {
    i32 key = vertex;
    i32 count = vertices.count;
    for i32 i = 0; i < count; ++i {
        if vertices.keys[i] == key {
            return false;
        }
    }
    if count == 64 {
        return true;
    }
    vertices.keys[count] = key;
    vertices.count += 1;
    return true;
}

// Returns true if (score, separation) should replace (bestScore, bestSeparation).
bool b3IsBetterCullCandidate(f32 score, f32 separation, f32 bestScore, f32 bestSeparation, f32 scoreTol, f32 separationTol) {
    if score > bestScore + scoreTol {
        return true;
    }
    if score < bestScore - scoreTol {
        return false;
    }
    return separation < bestSeparation - separationTol;
}

i32 b3CullPoints(b3Point2D* points, i32 count) {
    if count <= 1 {
        return count;
    }
    f32 tol = 0.25f * (0.005f * b3GetLengthUnitsPerMeter());
    f32 tolSqr = tol * tol;
    f32 separationTol = 0.005f * b3GetLengthUnitsPerMeter();
    noinit b3Point2D[4] finalPoints;
    i32 count1 = count;
    f32 bestScore = 0.0f;
    f32 bestSeparation = FLT_MAX;
    i32 bestIndex1 = -1;
    i32 bestIndex2 = -1;
    for i32 i = 0; i < count1; ++i {
        b3Vec2 p1 = points[i].p;
        for i32 j = i + 1; j < count1; ++j {
            f32 score = b3DistanceSquared2(p1, points[j].p);
            f32 separation = points[i].separation + points[j].separation;
            if b3IsBetterCullCandidate(score, separation, bestScore, bestSeparation, tolSqr, separationTol) != 0 {
                bestIndex1 = i;
                bestIndex2 = j;
                bestScore = score;
                bestSeparation = separation;
            }
        }
    }
    if bestScore < tolSqr {
        i32 deepestIndex = 0;
        for i32 i = 1; i < count1; ++i {
            if points[i].separation < points[deepestIndex].separation {
                deepestIndex = i;
            }
        }
        if deepestIndex != 0 {
            points[0] = points[deepestIndex];
        }
        return 1;
    }
    finalPoints[0] = points[bestIndex1];
    finalPoints[1] = points[bestIndex2];
    points[bestIndex2] = points[count1 - 1];
    points[bestIndex1] = points[count1 - 2];
    count1 -= 2;
    if count1 == 0 {
        points[0] = finalPoints[0];
        points[1] = finalPoints[1];
        return 2;
    }
    b3Vec2 a = finalPoints[0].p;
    b3Vec2 b = finalPoints[1].p;
    b3Vec2 ba = b3Sub2(b, a);
    bestScore = 0.0f;
    bestSeparation = FLT_MAX;
    i32 bestIndex = -1;
    f32 bestSignedArea = 0.0f;
    for i32 i = 0; i < count1; ++i {
        b3Vec2 p = points[i].p;
        f32 signedArea = b3Cross2(ba, b3Sub2(p, a));
        f32 score = b3AbsFloat(signedArea);
        if b3IsBetterCullCandidate(score, points[i].separation, bestScore, bestSeparation, tolSqr, separationTol) != 0 {
            bestSignedArea = signedArea;
            bestScore = score;
            bestSeparation = points[i].separation;
            bestIndex = i;
        }
    }
    if bestIndex == -1 {
        points[0] = finalPoints[0];
        points[1] = finalPoints[1];
        return 2;
    }
    finalPoints[2] = points[bestIndex];
    if count1 == 1 {
        points[0] = finalPoints[0];
        points[1] = finalPoints[1];
        points[2] = finalPoints[2];
        return 3;
    }
    points[bestIndex] = points[count1 - 1];
    count1 -= 1;
    b3Vec2 c = finalPoints[2].p;
    if bestSignedArea < 0.0f {
        while true {
            noinit u8[sizeof(b)] B3_SWAP_TEMP;
            memcpy(B3_SWAP_TEMP, &b, cast(u64, sizeof(b)));
            memcpy(&b, &c, cast(u64, sizeof(b)));
            memcpy(&c, B3_SWAP_TEMP, cast(u64, sizeof(b)));
            if !(0 != 0) { break; }
        }
        ba = b3Sub2(b, a);
    }
    b3Vec2 cb = b3Sub2(c, b);
    b3Vec2 ac = b3Sub2(a, c);
    bestScore = 0.0f;
    bestSeparation = FLT_MAX;
    bestIndex = -1;
    for i32 i = 0; i < count1; ++i {
        b3Vec2 p = points[i].p;
        f32 u1 = b3Cross2(b3Sub2(p, a), ba);
        f32 u2 = b3Cross2(b3Sub2(p, b), cb);
        f32 u3 = b3Cross2(b3Sub2(p, c), ac);
        f32 score = b3MaxFloat(u1, b3MaxFloat(u2, u3));
        if b3IsBetterCullCandidate(score, points[i].separation, bestScore, bestSeparation, tolSqr, separationTol) != 0 {
            bestScore = score;
            bestSeparation = points[i].separation;
            bestIndex = i;
        }
    }
    if bestIndex == -1 {
        points[0] = finalPoints[0];
        points[1] = finalPoints[1];
        points[2] = finalPoints[2];
        return 3;
    }
    finalPoints[3] = points[bestIndex];
    points[0] = finalPoints[0];
    points[1] = finalPoints[1];
    points[2] = finalPoints[2];
    points[3] = finalPoints[3];
    return 4;
}

i32 b3ReduceCluster(b3LocalManifoldPoint* points, i32 count1, b3Vec3 normal, b3Arena arena) {
    i32 targetCount = 1;
    if count1 <= targetCount {
        return count1;
    }
    b3Point2D* pts = b3Bump(&arena, cast(i32, count1 * sizeof(b3Point2D)));
    b3Vec3 u = b3Perp(normal);
    b3Vec3 v = b3Cross(normal, u);
    b3Vec3 origin = points[0].point;
    for i32 i = 0; i < count1; ++i {
        b3Vec3 d = b3Sub(points[i].point, origin);
        pts[i].p = b3Vec2{b3Dot(d, u), b3Dot(d, v)};
        pts[i].separation = points[i].separation;
        pts[i].originalIndex = i;
    }
    i32 count2 = b3CullPoints(pts, count1);
    noinit b3LocalManifoldPoint[4] finalPoints;
    for i32 i = 0; i < count2; ++i {
        i32 index = pts[i].originalIndex;
        finalPoints[i] = points[index];
    }
    memcpy(points, finalPoints, cast(u64, count2 * sizeof(b3LocalManifoldPoint)));
    return count2;
}
}

bool b3ComputeMeshManifolds(b3World* world, i32 workerIndex, b3Contact* contact, b3Shape* shapeA, i32* materialMap, b3WorldTransform xfA, b3Shape* shapeB, b3WorldTransform xfB, bool isFast, b3Arena arena) {
    ignore workerIndex;
    ignore isFast;
    ignore materialMap;
    b3TaskContext* context = world.taskContexts.data + workerIndex;
    b3RefreshCache(contact, shapeA, xfA, &shapeB.aabb);
    b3MeshContact* meshContact = &contact.meshContact;
    i32 triangleCount = meshContact.triangleCache.count;
    b3LocalManifold** acceptedManifolds = b3Bump(&arena, cast(i32, triangleCount * sizeof(b3LocalManifold*)));
    i32 acceptedManifoldCount = 0;
    b3LocalManifold** tentativeManifolds = b3Bump(&arena, cast(i32, triangleCount * sizeof(b3LocalManifold*)));
    i32 tentativeManifoldCount = 0;
    b3TentativeTriangle* tentativeTriangles = b3Bump(&arena, cast(i32, triangleCount * sizeof(b3TentativeTriangle)));
    i32 tentativeTriangleCount = 0;
    noinit b3FoundEdges foundEdges;
    noinit b3FoundVertices foundVertices;
    foundEdges.count = 0;
    foundVertices.count = 0;
    b3Transform transformAtoB = b3InvMulWorldTransforms(xfB, xfA);
    b3Matrix3 relativeMatrix = b3MakeMatrixFromQuat(transformAtoB.q);
    f32 linearSlop = 0.005f * b3GetLengthUnitsPerMeter();
    f32 restOffset = 1.0f * (0.005f * b3GetLengthUnitsPerMeter());
    bool enableSpeculative = (contact.flags & cast(u32, b3_enableSpeculativePoints)) != 0;
    i32 pointBufferCapacity = 32 * triangleCount;
    b3LocalManifoldPoint* pointBuffer = b3Bump(&arena, cast(i32, pointBufferCapacity * sizeof(b3LocalManifoldPoint)));
    i32 totalPointCount = 0;
    b3LocalManifold* manifoldBuffer = b3Bump(&arena, cast(i32, triangleCount * sizeof(b3LocalManifold)));
    i32 manifoldCount = 0;
    b3TriangleCache* triangleCaches = meshContact.triangleCache.data;
    b3HullData* hullB = shapeB.type == b3_hullShape ? shapeB.hull : null;
    for i32 index = 0; index < triangleCount && totalPointCount + 3 < pointBufferCapacity; ++index {
        i32 triangleIndex = triangleCaches[index].triangleIndex;
        noinit b3Triangle triangle;
        if shapeA.type == b3_meshShape {
            triangle = b3GetMeshTriangle(&shapeA.mesh, triangleIndex);
        } else {
            triangle = b3GetHeightFieldTriangle(shapeA.heightField, triangleIndex);
        }
        noinit b3Vec3[3] vertices;
        vertices[0] = b3Add(b3MulMV(relativeMatrix, triangle.vertices[0]), transformAtoB.p);
        vertices[1] = b3Add(b3MulMV(relativeMatrix, triangle.vertices[1]), transformAtoB.p);
        vertices[2] = b3Add(b3MulMV(relativeMatrix, triangle.vertices[2]), transformAtoB.p);
        b3ContactCache* cache = &triangleCaches[index].cache;
        i32 pointCapacity = pointBufferCapacity - totalPointCount;
        b3LocalManifold* manifold = manifoldBuffer + manifoldCount;
        manifold.points = pointBuffer + totalPointCount;
        manifold.pointCount = 0;
        manifold.triangleFlags = triangle.flags;
        manifold.feature = b3_featureNone;
        switch shapeB.type {
            case b3_capsuleShape: {
                b3CollideTriangleAndCapsule(manifold, pointCapacity, vertices, &shapeB.capsule, &cache.simplexCache);
            }
            case b3_hullShape: {
                if isFast && cast(i32, cache.satCache.type) == b3_edgePairAxis {
                    cache.satCache = b3SATCache{};
                }
                b3CollideTriangleAndHull(manifold, pointCapacity, vertices[0], vertices[1], vertices[2], triangle.flags, hullB, &cache.satCache, enableSpeculative);
                context.satCallCount += 1;
                context.satCacheHitCount += cast(i32, cache.satCache.hit);
            }
            case b3_sphereShape: {
                b3CollideTriangleAndSphere(manifold, pointCapacity, vertices, &shapeB.sphere);
            }
            default: {
                return false;
            }
        }
        i32 manifoldPointCount = manifold.pointCount;
        if manifoldPointCount > 0 {
            manifoldCount += 1;
            totalPointCount += manifoldPointCount;
            manifold.triangleIndex = triangleIndex;
            manifold.triangleNormal = b3MakeNormalFromPoints(vertices[0], vertices[1], vertices[2]);
            manifold.i1 = triangle.i1;
            manifold.i2 = triangle.i2;
            manifold.i3 = triangle.i3;
            if manifold.feature == b3_featureTriangleFace || 0 {
                ignore b3AddEdge(&foundEdges, triangle.i1, triangle.i2);
                ignore b3AddEdge(&foundEdges, triangle.i2, triangle.i3);
                ignore b3AddEdge(&foundEdges, triangle.i3, triangle.i1);
                ignore b3AddVertex(&foundVertices, triangle.i1);
                ignore b3AddVertex(&foundVertices, triangle.i2);
                ignore b3AddVertex(&foundVertices, triangle.i3);
                acceptedManifolds[acceptedManifoldCount++] = manifold;
            } else if manifold.feature == b3_featureHullFace {
                f32 cosNormalAngle = b3Dot(manifold.triangleNormal, manifold.normal);
                if cosNormalAngle > 0.5f {
                    ignore b3AddEdge(&foundEdges, triangle.i1, triangle.i2);
                    ignore b3AddEdge(&foundEdges, triangle.i2, triangle.i3);
                    ignore b3AddEdge(&foundEdges, triangle.i3, triangle.i1);
                    ignore b3AddVertex(&foundVertices, triangle.i1);
                    ignore b3AddVertex(&foundVertices, triangle.i2);
                    ignore b3AddVertex(&foundVertices, triangle.i3);
                    acceptedManifolds[acceptedManifoldCount++] = manifold;
                } else {
                    f32 minSeparation = manifold.points[0].separation;
                    for i32 i = 1; i < manifoldPointCount; ++i {
                        minSeparation = b3MinFloat(minSeparation, manifold.points[i].separation);
                    }
                    if minSeparation < -2.0f * linearSlop {
                        ignore b3AddEdge(&foundEdges, triangle.i1, triangle.i2);
                        ignore b3AddEdge(&foundEdges, triangle.i2, triangle.i3);
                        ignore b3AddEdge(&foundEdges, triangle.i3, triangle.i1);
                        ignore b3AddVertex(&foundVertices, triangle.i1);
                        ignore b3AddVertex(&foundVertices, triangle.i2);
                        ignore b3AddVertex(&foundVertices, triangle.i3);
                        acceptedManifolds[acceptedManifoldCount++] = manifold;
                    } else {
                        var tentativeTriangle = b3TentativeTriangle{
                            .squaredDistance = manifold.squaredDistance,
                            .index = tentativeManifoldCount,
                        };
                        tentativeTriangles[tentativeTriangleCount++] = tentativeTriangle;
                        tentativeManifolds[tentativeManifoldCount++] = manifold;
                    }
                }
            } else {
                var tentativeTriangle = b3TentativeTriangle{
                    .squaredDistance = manifold.squaredDistance,
                    .index = tentativeManifoldCount,
                };
                tentativeTriangles[tentativeTriangleCount++] = tentativeTriangle;
                tentativeManifolds[tentativeManifoldCount++] = manifold;
            }
        }
    }
    if shapeB.type == b3_sphereShape {
        {
            while true {
                if tentativeTriangleCount > 1 {
                    while true {
                        u32 q_l = 0;
                        var q_r = cast(u32, tentativeTriangleCount - 1);
                        u32 q_sp = 0;
                        noinit q_st_t[sizeof(u32) > 4 && sizeof(tentativeTriangleCount) > 4 ? 48 : 32] q_st;
                        while 1 != 0 {
                            if q_r - q_l + 1 >= 16 {
                                u32 q_i;
                                u32 q_j;
                                while true {
                                    u32 q_m = q_l + (q_r - q_l >> 1);
                                    while true {
                                        if tentativeTriangles[cast(i32, q_m)].squaredDistance < tentativeTriangles[cast(i32, q_l) + 1].squaredDistance {
                                            if tentativeTriangles[cast(i32, q_r)].squaredDistance < tentativeTriangles[cast(i32, q_m)].squaredDistance {
                                                while true {
                                                    b3TentativeTriangle tmp = tentativeTriangles[cast(i32, q_l) + 1];
                                                    tentativeTriangles[cast(i32, q_l) + 1] = tentativeTriangles[cast(i32, q_r)];
                                                    tentativeTriangles[cast(i32, q_r)] = tmp;
                                                    if !(0 != 0) { break; }
                                                }
                                            } else {
                                                while true {
                                                    b3TentativeTriangle tmp = tentativeTriangles[cast(i32, q_l) + 1];
                                                    tentativeTriangles[cast(i32, q_l) + 1] = tentativeTriangles[cast(i32, q_m)];
                                                    tentativeTriangles[cast(i32, q_m)] = tmp;
                                                    if !(0 != 0) { break; }
                                                }
                                                if tentativeTriangles[cast(i32, q_r)].squaredDistance < tentativeTriangles[cast(i32, q_m)].squaredDistance {
                                                    while true {
                                                        b3TentativeTriangle tmp = tentativeTriangles[cast(i32, q_m)];
                                                        tentativeTriangles[cast(i32, q_m)] = tentativeTriangles[cast(i32, q_r)];
                                                        tentativeTriangles[cast(i32, q_r)] = tmp;
                                                        if !(0 != 0) { break; }
                                                    }
                                                }
                                            }
                                        } else if tentativeTriangles[cast(i32, q_r)].squaredDistance < tentativeTriangles[cast(i32, q_m)].squaredDistance {
                                            while true {
                                                b3TentativeTriangle tmp = tentativeTriangles[cast(i32, q_m)];
                                                tentativeTriangles[cast(i32, q_m)] = tentativeTriangles[cast(i32, q_r)];
                                                tentativeTriangles[cast(i32, q_r)] = tmp;
                                                if !(0 != 0) { break; }
                                            }
                                            if tentativeTriangles[cast(i32, q_m)].squaredDistance < tentativeTriangles[cast(i32, q_l) + 1].squaredDistance {
                                                while true {
                                                    b3TentativeTriangle tmp = tentativeTriangles[cast(i32, q_l) + 1];
                                                    tentativeTriangles[cast(i32, q_l) + 1] = tentativeTriangles[cast(i32, q_m)];
                                                    tentativeTriangles[cast(i32, q_m)] = tmp;
                                                    if !(0 != 0) { break; }
                                                }
                                            }
                                        }
                                        if !(0 != 0) { break; }
                                    }
                                    while true {
                                        b3TentativeTriangle tmp = tentativeTriangles[cast(i32, q_l)];
                                        tentativeTriangles[cast(i32, q_l)] = tentativeTriangles[cast(i32, q_m)];
                                        tentativeTriangles[cast(i32, q_m)] = tmp;
                                        if !(0 != 0) { break; }
                                    }
                                    q_i = q_l + 1;
                                    q_j = q_r;
                                    while 1 != 0 {
                                        while true {
                                            q_i++;
                                            if !(tentativeTriangles[cast(i32, q_i)].squaredDistance < tentativeTriangles[cast(i32, q_l)].squaredDistance) { break; }
                                        }
                                        while true {
                                            q_j--;
                                            if !(tentativeTriangles[cast(i32, q_l)].squaredDistance < tentativeTriangles[cast(i32, q_j)].squaredDistance) { break; }
                                        }
                                        if q_i >= q_j {
                                            break;
                                        }
                                        while true {
                                            b3TentativeTriangle tmp = tentativeTriangles[cast(i32, q_i)];
                                            tentativeTriangles[cast(i32, q_i)] = tentativeTriangles[cast(i32, q_j)];
                                            tentativeTriangles[cast(i32, q_j)] = tmp;
                                            if !(0 != 0) { break; }
                                        }
                                    }
                                    q_i = q_j + 1;
                                    while true {
                                        b3TentativeTriangle tmp = tentativeTriangles[cast(i32, q_l)];
                                        tentativeTriangles[cast(i32, q_l)] = tentativeTriangles[cast(i32, q_j)];
                                        tentativeTriangles[cast(i32, q_j)] = tmp;
                                        if !(0 != 0) { break; }
                                    }
                                    q_j--;
                                    if !(0 != 0) { break; }
                                }
                                if q_j - q_l >= q_r - q_i {
                                    while true {
                                        if q_i == q_r {
                                            q_l = q_l;
                                            q_r = q_j;
                                        } else {
                                            q_st[q_sp].q_l = q_l;
                                            q_st[q_sp].q_r = q_j;
                                            q_sp++;
                                            q_l = q_i;
                                            q_r = q_r;
                                        }
                                        if !(0 != 0) { break; }
                                    }
                                } else {
                                    while true {
                                        if q_l == q_j {
                                            q_l = q_i;
                                            q_r = q_r;
                                        } else {
                                            q_st[q_sp].q_l = q_i;
                                            q_st[q_sp].q_r = q_r;
                                            q_sp++;
                                            q_l = q_l;
                                            q_r = q_j;
                                        }
                                        if !(0 != 0) { break; }
                                    }
                                }
                            } else {
                                while true {
                                    u32 q_i;
                                    u32 q_j;
                                    for q_i = q_l + 1; q_i <= q_r; q_i++ {
                                        for q_j = q_i; q_j > q_l && tentativeTriangles[cast(i32, q_j)].squaredDistance < tentativeTriangles[cast(i32, q_j) - 1].squaredDistance; q_j-- {
                                            while true {
                                                b3TentativeTriangle tmp = tentativeTriangles[cast(i32, q_j)];
                                                tentativeTriangles[cast(i32, q_j)] = tentativeTriangles[cast(i32, q_j) - 1];
                                                tentativeTriangles[cast(i32, q_j) - 1] = tmp;
                                                if !(0 != 0) { break; }
                                            }
                                        }
                                    }
                                    if !(0 != 0) { break; }
                                }
                                if q_sp == 0 {
                                    break;
                                }
                                q_sp--;
                                q_l = q_st[q_sp].q_l;
                                q_r = q_st[q_sp].q_r;
                            }
                        }
                        if !(0 != 0) { break; }
                    }
                }
                if !(0 != 0) { break; }
            }
        }
        for i32 i = 0; i < tentativeTriangleCount; ++i {
            b3LocalManifold* m = tentativeManifolds[tentativeTriangles[i].index];
            bool addedEdge1 = b3AddEdge(&foundEdges, m.i1, m.i2);
            bool addedEdge2 = b3AddEdge(&foundEdges, m.i2, m.i3);
            bool addedEdge3 = b3AddEdge(&foundEdges, m.i3, m.i1);
            bool addedVertex1 = b3AddVertex(&foundVertices, m.i1);
            bool addedVertex2 = b3AddVertex(&foundVertices, m.i2);
            bool addedVertex3 = b3AddVertex(&foundVertices, m.i3);
            b3TriangleFeature feature = m.feature;
            bool shouldCollide = false;
            switch feature {
                case b3_featureNone, b3_featureTriangleFace: {
                }
                case b3_featureEdge1: {
                    shouldCollide = addedEdge1;
                }
                case b3_featureEdge2: {
                    shouldCollide = addedEdge2;
                }
                case b3_featureEdge3: {
                    shouldCollide = addedEdge3;
                }
                case b3_featureVertex1: {
                    shouldCollide = addedVertex1;
                }
                case b3_featureVertex2: {
                    shouldCollide = addedVertex2;
                }
                case b3_featureVertex3: {
                    shouldCollide = addedVertex3;
                }
                default: {
                }
            }
            if shouldCollide == true {
                acceptedManifolds[acceptedManifoldCount++] = m;
            }
        }
    } else {
        for i32 i = 0; i < tentativeManifoldCount; ++i {
            b3LocalManifold* m = tentativeManifolds[i];
            i32 triangleFlags = m.triangleFlags;
            if (triangleFlags & b3_allFlatEdges) == b3_allFlatEdges {
                continue;
            }
            if (triangleFlags & b3_flatEdge1) == b3_flatEdge1 {
                if b3FindEdge(&foundEdges, m.i1, m.i2) != 0 {
                    continue;
                }
            }
            if (triangleFlags & b3_flatEdge2) == b3_flatEdge2 {
                if b3FindEdge(&foundEdges, m.i2, m.i3) != 0 {
                    continue;
                }
            }
            if (triangleFlags & b3_flatEdge3) == b3_flatEdge3 {
                if b3FindEdge(&foundEdges, m.i3, m.i1) != 0 {
                    continue;
                }
            }
            acceptedManifolds[acceptedManifoldCount++] = m;
        }
    }
    if acceptedManifoldCount == 0 {
        if contact.manifoldCount > 0 {
            b3FreeManifolds(world, contact.manifolds, contact.manifoldCount);
            contact.manifolds = null;
            contact.manifoldCount = 0;
        }
        return false;
    }
    b3Cluster* clusters = b3Bump(&arena, cast(i32, acceptedManifoldCount * sizeof(b3Cluster)));
    i32* clusterMemberships = b3Bump(&arena, cast(i32, acceptedManifoldCount * sizeof(i32)));
    f32 clusterThreshold = 0.996f;
    i32 clusterCount = 0;
    i32 clusterPointCount = 0;
    for i32 i = 0; i < acceptedManifoldCount; ++i {
        clusterMemberships[i] = -1;
        b3LocalManifold* manifold = acceptedManifolds[i];
        clusterPointCount += manifold.pointCount;
        bool allowClustering = true;
        b3Vec3 manifoldNormal = manifold.normal;
        b3Vec3 triangleNormal = manifold.triangleNormal;
        i32 clusterIndex = -1;
        for i32 j = 0; j < clusterCount && allowClustering; ++j {
            f32 cosManifoldAngle = b3Dot(clusters[j].manifoldNormal, manifoldNormal);
            f32 cosTriangleAngle = b3Dot(clusters[j].triangleNormal, triangleNormal);
            if cosManifoldAngle <= clusterThreshold || cosTriangleAngle <= clusterThreshold {
                continue;
            }
            clusterIndex = j;
            break;
        }
        if clusterIndex != -1 {
            clusterMemberships[i] = clusterIndex;
            clusters[clusterIndex].pointCapacity += manifold.pointCount;
        } else {
            clusters[clusterCount].manifoldNormal = manifoldNormal;
            clusters[clusterCount].triangleNormal = triangleNormal;
            clusters[clusterCount].pointCapacity = manifold.pointCount;
            clusterMemberships[i] = clusterCount;
            clusterCount += 1;
        }
    }
    if clusterPointCount == 0 {
        return false;
    }
    b3LocalManifoldPoint* clusterPoints = b3Bump(&arena, cast(i32, clusterPointCount * sizeof(b3LocalManifoldPoint)));
    i32 pointOffset = 0;
    for i32 i = 0; i < clusterCount; ++i {
        b3Cluster* cluster = clusters + i;
        cluster.points = clusterPoints + pointOffset;
        cluster.pointCount = 0;
        pointOffset += cluster.pointCapacity;
    }
    for i32 i = 0; i < acceptedManifoldCount; ++i {
        i32 clusterIndex = clusterMemberships[i];
        if clusterIndex == -1 {
            continue;
        }
        b3LocalManifold* am = acceptedManifolds[i];
        b3Cluster* cm = clusters + clusterIndex;
        for i32 j = 0; j < am.pointCount; ++j {
            b3LocalManifoldPoint* ap = am.points + j;
            b3LocalManifoldPoint* cp = cm.points + cm.pointCount;
            cp.triangleIndex = am.triangleIndex;
            cp.point = ap.point;
            cp.separation = ap.separation;
            cp.pair = ap.pair;
            cm.pointCount += 1;
        }
    }
    for i32 i = 0; i < clusterCount; ++i {
        b3Cluster* cm = clusters + i;
        i32 reducedCount = b3ReduceCluster(cm.points, cm.pointCount, cm.triangleNormal, arena);
        cm.pointCount = reducedCount;
    }
    i32 oldManifoldCount = contact.manifoldCount;
    b3Manifold* oldManifolds = null;
    if oldManifoldCount > 0 {
        oldManifolds = b3Bump(&arena, cast(i32, oldManifoldCount * sizeof(b3Manifold)));
        memcpy(oldManifolds, contact.manifolds, cast(u64, oldManifoldCount * sizeof(b3Manifold)));
    }
    if oldManifoldCount != clusterCount {
        b3FreeManifolds(world, contact.manifolds, contact.manifoldCount);
        contact.manifolds = b3AllocateManifolds(world, clusterCount);
        contact.manifoldCount = cast(i32, cast(u16, clusterCount));
    } else {
        memset(contact.manifolds, 0, cast(u64, contact.manifoldCount * sizeof(b3Manifold)));
    }
    bool* consumed = null;
    if oldManifoldCount > 0 {
        consumed = b3Bump(&arena, cast(i32, oldManifoldCount * sizeof(bool)));
        memset(consumed, 0, cast(u64, oldManifoldCount * sizeof(bool)));
    }
    b3Matrix3 matrixB = b3MakeMatrixFromQuat(xfB.q);
    b3Vec3 offsetA = b3SubPos(xfB.p, xfA.p);
    f32 normalMatchTolerance = 0.995f;
    for i32 i = 0; i < clusterCount; ++i {
        b3Cluster* cm = clusters + i;
        i32 pointCount = cm.pointCount;
        b3Manifold* manifold = contact.manifolds + i;
        manifold.pointCount = pointCount;
        manifold.normal = b3MulMV(matrixB, cm.manifoldNormal);
        b3Vec3 clusterNormal = b3MulMV(matrixB, cm.manifoldNormal);
        f32 bestDot = normalMatchTolerance;
        i32 bestIndex = -1;
        for i32 j = 0; j < oldManifoldCount; ++j {
            if consumed[j] == true {
                continue;
            }
            f32 dot = b3Dot(oldManifolds[j].normal, clusterNormal);
            if dot > bestDot {
                bestIndex = j;
                bestDot = dot;
            }
        }
        b3Manifold* matchedManifold = null;
        if bestIndex != -1 {
            matchedManifold = oldManifolds + bestIndex;
            manifold.frictionImpulse = matchedManifold.frictionImpulse;
            manifold.rollingImpulse = matchedManifold.rollingImpulse;
            manifold.twistImpulse = matchedManifold.twistImpulse;
            consumed[bestIndex] = true;
        }
        for i32 j = 0; j < pointCount; ++j {
            b3LocalManifoldPoint* source = cm.points + j;
            b3ManifoldPoint* target = manifold.points + j;
            target.anchorB = b3MulMV(matrixB, source.point);
            target.anchorA = b3Add(target.anchorB, offsetA);
            target.separation = source.separation - restOffset;
            target.featureId = b3MakeFeatureId(source.pair);
            target.triangleIndex = source.triangleIndex;
            if matchedManifold != null {
                i32 oldPointCount = matchedManifold.pointCount;
                for i32 k = 0; k < oldPointCount; ++k {
                    b3ManifoldPoint* oldPt = matchedManifold.points + k;
                    if target.featureId == oldPt.featureId && target.triangleIndex == oldPt.triangleIndex {
                        target.normalImpulse = oldPt.normalImpulse;
                        target.persisted = true;
                        oldPt.triangleIndex = -1;
                        break;
                    }
                }
            }
        }
    }
    b3SurfaceMaterial* materialsA = b3GetShapeMaterials(shapeA);
    b3SurfaceMaterial* materialB = b3GetShapeMaterials(shapeB);
    b3Vec3 tangentVelocityA = b3Vec3_zero;
    if shapeA.materialCount > 0 {
        f32 friction = 0.0f;
        f32 restitution = 0.0f;
        f32 sampleCount = 0.0f;
        u8* materialIndices;
        if shapeA.type == b3_meshShape {
            materialIndices = b3GetMeshMaterialIndices(shapeA.mesh.data);
        } else {
            materialIndices = b3GetHeightFieldMaterialIndices(shapeA.heightField);
        }
        for i32 i = 0; i < clusterCount; ++i {
            b3Manifold* manifold = contact.manifolds + i;
            i32 pointCount = manifold.pointCount;
            for i32 j = 0; j < pointCount; ++j {
                i32 triangleIndex = manifold.points[j].triangleIndex;
                i32 materialIndex;
                if shapeA.type == b3_meshShape {
                    materialIndex = cast(i32, materialIndices[triangleIndex]);
                    if materialMap != null {
                        materialIndex = materialMap[materialIndex];
                    }
                } else {
                    materialIndex = cast(i32, materialIndices[triangleIndex >> 1]);
                }
                materialIndex = b3ClampInt(materialIndex, 0, shapeA.materialCount - 1);
                b3SurfaceMaterial material = materialsA[materialIndex];
                friction += world.frictionCallback(material.friction, material.userMaterialId, materialB.friction, materialB.userMaterialId);
                restitution += world.restitutionCallback(material.restitution, material.userMaterialId, materialB.restitution, materialB.userMaterialId);
                tangentVelocityA = b3Add(tangentVelocityA, material.tangentVelocity);
                sampleCount += 1.0f;
            }
        }
        if sampleCount > 0.0f {
            f32 invCount = 1.0f / sampleCount;
            contact.friction = invCount * friction;
            contact.restitution = invCount * restitution;
            tangentVelocityA = b3MulSV(invCount, tangentVelocityA);
        }
    } else {
        contact.friction = world.frictionCallback(materialsA[0].friction, materialsA[0].userMaterialId, materialB.friction, materialB.userMaterialId);
        contact.restitution = world.restitutionCallback(materialsA[0].restitution, materialsA[0].userMaterialId, materialB.restitution, materialB.userMaterialId);
        tangentVelocityA = materialsA[0].tangentVelocity;
    }
    tangentVelocityA = b3RotateVector(xfA.q, tangentVelocityA);
    f32 radiusB = 0.0f;
    if shapeB.type == b3_sphereShape {
        radiusB = shapeB.sphere.radius;
    } else if shapeB.type == b3_capsuleShape {
        radiusB = shapeB.capsule.radius;
    } else if shapeB.type == b3_hullShape {
        radiusB = shapeB.hull.innerRadius;
    }
    contact.rollingResistance = materialB.rollingResistance * radiusB;
    b3Vec3 tangentVelocityB = b3RotateVector(xfB.q, materialB.tangentVelocity);
    contact.tangentVelocity = b3Sub(tangentVelocityA, tangentVelocityB);
    return true;
}

