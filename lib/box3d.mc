// Geometry content hashes reserve zero to mean unhashed
private {
u32 b3NonZeroHash(u32 hash) {
    return hash != 0 ? hash : 1;
}
}

/// Get proxy user data
u64 b3DynamicTree_GetUserData(b3DynamicTree* tree, i32 proxyId) {
    return tree.nodes[proxyId].userData;
}

/// Get the AABB of a proxy
b3AABB b3DynamicTree_GetAABB(b3DynamicTree* tree, i32 proxyId) {
    return tree.nodes[proxyId].aabb;
}

/**@}*/
// tree
/**
 * @addtogroup hull
 * @{
 */
/// Get read only hull vertices.
b3HullVertex* b3GetHullVertices(b3HullData* hull) {
    if hull.vertexOffset == 0 {
        return null;
    }
    return cast(b3HullVertex*, cast(i64, hull) + hull.vertexOffset);
}

/// Get read only hull points.
b3Vec3* b3GetHullPoints(b3HullData* hull) {
    if hull.pointOffset == 0 {
        return null;
    }
    return cast(b3Vec3*, cast(i64, hull) + hull.pointOffset);
}

/// Get read only hull half edges.
b3HullHalfEdge* b3GetHullEdges(b3HullData* hull) {
    if hull.edgeOffset == 0 {
        return null;
    }
    return cast(b3HullHalfEdge*, cast(i64, hull) + hull.edgeOffset);
}

/// Get read only hull planes.
b3Plane* b3GetHullPlanes(b3HullData* hull) {
    if hull.planeOffset == 0 {
        return null;
    }
    return cast(b3Plane*, cast(i64, hull) + hull.planeOffset);
}

/// Get read only hull faces.
b3HullFace* b3GetHullFaces(b3HullData* hull) {
    if hull.faceOffset == 0 {
        return null;
    }
    return cast(b3HullFace*, cast(i64, hull) + hull.faceOffset);
}

/// Get read only SOA vertices. This is an array of vertices with all x values,
/// y values, and z values as separate arrays. The array lengths are padded to
/// a multiple of 4. The padded values are repeats of the first value.
f32* b3GetHullSoaVertices(b3HullData* hull) {
    if hull.soaVertexOffset == 0 {
        return null;
    }
    return cast(f32*, cast(i64, hull) + hull.soaVertexOffset);
}

/// Get read only SOA unit normal vectors. This is an array of normals with all x values,
/// y values, and z values as separate arrays. The array lengths are padded to
/// a multiple of 4. The padded values are repeats of the first value.
f32* b3GetHullSoaNormals(b3HullData* hull) {
    if hull.soaNormalOffset == 0 {
        return null;
    }
    return cast(f32*, cast(i64, hull) + hull.soaNormalOffset);
}

