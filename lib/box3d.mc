// SPDX-License-Identifier: MIT
// wide float holds 4 numbers
type b3FloatW = float4;
// wide float holds 4 numbers
type b3V32 = float4;
when !(defined(IMPLEMENTATION_MODE)) {
}
when !(defined(IMPLEMENTATION_MODE)) {
}
when !(defined(IMPLEMENTATION_MODE)) {
}
// SPDX-FileCopyrightText: 2026 Erin Catto
// SPDX-License-Identifier: MIT
type b3TaskCallback = fn(void*): void;
when !(defined(IMPLEMENTATION_MODE)) {
}
when !(defined(IMPLEMENTATION_MODE)) {
}
when !(defined(IMPLEMENTATION_MODE)) {
}
type __arr_u8_257 = u8[257];
type __arr_b3ContactRegister_6 = b3ContactRegister[6];
/// Version numbering scheme.
/// See https://semver.org/
struct b3Version {
    i32 major;
    i32 minor;
    i32 revision;
}

// SPDX-FileCopyrightText: 2026 Erin Catto
// SPDX-License-Identifier: MIT
// Note: this file should be stand-alone
/**
 * @defgroup id Ids
 * These ids serve as handles to internal Box3D objects.
 * These should be considered opaque data and passed by value.
 * Include this header if you need the id types and not the whole Box3D API.
 * All ids are considered null if initialized to zero.
 *
 * For example in C++:
 *
 * @code{.cxx}
 * b3WorldId worldId = {};
 * @endcode
 *
 * Or in C:
 *
 * @code{.c}
 * b3WorldId worldId = {0};
 * @endcode
 *
 * These are both considered null.
 *
 * @warning Do not use the internals of these ids. They are subject to change. Ids should be treated as opaque objects.
 * @warning You should use ids to access objects in Box3D. Do not access files within the src folder. Such usage is unsupported.
 * @{
 */
/// World id references a world instance. This should be treated as an opaque handle.
struct b3WorldId {
    u16 index1;
    u16 generation;
}

/// Body id references a body instance. This should be treated as an opaque handle.
struct b3BodyId {
    i32 index1;
    u16 world0;
    u16 generation;
}

/// Shape id references a shape instance. This should be treated as an opaque handle.
struct b3ShapeId {
    i32 index1;
    u16 world0;
    u16 generation;
}

/// Joint id references a joint instance. This should be treated as an opaque handle.
struct b3JointId {
    i32 index1;
    u16 world0;
    u16 generation;
}

/// Contact id references a contact instance. This should be treated as an opaque handle.
struct b3ContactId {
    i32 index1;
    u16 world0;
    i16 padding;
    u32 generation;
}

// SPDX-FileCopyrightText: 2025 Erin Catto
// SPDX-License-Identifier: MIT
// for sqrtf and remainderf
/**
 * @defgroup math Math
 * @brief Vector math types and functions
 * @{
 */
/// https://en.wikipedia.org/wiki/Pi
/// Convenience macro to convert from degrees to radians.
/// Convenience macro to convert from radians to degrees.
/// Minimum scale used for scaling collision meshes, etc.
/// A 2D vector.
struct b3Vec2 {
    f32 x;
    f32 y;
}

/// A 3D vector.
struct b3Vec3 {
    f32 x;
    f32 y;
    f32 z;
}

/// Cosine and sine pair.
/// This uses a custom implementation designed for cross-platform determinism.
struct b3CosSin {
    f32 cosine;
    f32 sine;
}

/// A quaternion.
struct b3Quat {
    b3Vec3 v;
    f32 s;
}

/// A rigid transform.
struct b3Transform {
    b3Vec3 p;
    b3Quat q;
}

/// A 3x3 matrix.
struct b3Matrix3 {
    b3Vec3 cx;
    b3Vec3 cy;
    b3Vec3 cz;
}

/// Axis aligned bounding box.
struct b3AABB {
    b3Vec3 lowerBound;
    b3Vec3 upperBound;
}

/// A plane.
/// separation = dot(normal, point) - offset
struct b3Plane {
    b3Vec3 normal;
    f32 offset;
}

/// The closest points between to segments or infinite lines.
struct b3SegmentDistanceResult {
    b3Vec3 point1;
    f32 fraction1;
    b3Vec3 point2;
    f32 fraction2;
}

/// Optional world capacities that can be use to avoid run-time allocations
/// @ingroup world
struct b3Capacity {
    i32 staticShapeCount;
    i32 dynamicShapeCount;
    i32 staticBodyCount;
    i32 dynamicBodyCount;
    i32 contactCount;
}

/// World definition used to create a simulation world. Must be initialized using b3DefaultWorldDef.
/// @ingroup world
struct b3WorldDef {
    b3Vec3 gravity;
    f32 restitutionThreshold;
    f32 hitEventThreshold;
    f32 contactHertz;
    f32 contactDampingRatio;
    f32 contactSpeed;
    f32 maximumLinearSpeed;
    b3FrictionCallback frictionCallback;
    b3RestitutionCallback restitutionCallback;
    bool enableSleep;
    bool enableContinuous;
    u32 workerCount;
    b3EnqueueTaskCallback enqueueTask;
    b3FinishTaskCallback finishTask;
    void* userTaskContext;
    void* userData;
    b3CreateDebugShapeCallback createDebugShape;
    b3DestroyDebugShapeCallback destroyDebugShape;
    void* userDebugShapeContext;
    b3Capacity capacity;
    i32 internalValue;
}

/// Motion locks to restrict the body movement
/// @ingroup body
struct b3MotionLocks {
    bool linearX;
    bool linearY;
    bool linearZ;
    bool angularX;
    bool angularY;
    bool angularZ;
}

/// A body definition holds all the data needed to construct a rigid body.
/// You can safely re-use body definitions. Shapes are added to a body after construction.
/// Body definitions are temporary objects used to bundle creation parameters.
/// Must be initialized using b3DefaultBodyDef().
/// @ingroup body
struct b3BodyDef {
    b3BodyType type;
    b3Pos position;
    b3Quat rotation;
    b3Vec3 linearVelocity;
    b3Vec3 angularVelocity;
    f32 linearDamping;
    f32 angularDamping;
    f32 gravityScale;
    f32 sleepThreshold;
    u8* name;
    void* userData;
    b3MotionLocks motionLocks;
    bool enableSleep;
    bool isAwake;
    bool isBullet;
    bool isEnabled;
    bool allowFastRotation;
    bool enableContactRecycling;
    i32 internalValue;
}

/// This is used to filter collision on shapes. It affects shape-vs-shape collision
/// and shape-versus-query collision (such as b3World_CastRay).
/// @ingroup shape
struct b3Filter {
    u64 categoryBits;
    u64 maskBits;
    i32 groupIndex;
}

/// Material properties supported per triangle on meshes and height fields
/// @ingroup shape
struct b3SurfaceMaterial {
    f32 friction;
    f32 restitution;
    f32 rollingResistance;
    b3Vec3 tangentVelocity;
    u64 userMaterialId;
    u32 customColor;
    u32 padding;
}

/// Used to create a shape
/// @ingroup shape
struct b3ShapeDef {
    u8* name;
    void* userData;
    b3SurfaceMaterial* materials;
    i32 materialCount;
    b3SurfaceMaterial baseMaterial;
    f32 density;
    f32 explosionScale;
    b3Filter filter;
    bool enableCustomFiltering;
    bool isSensor;
    bool enableSensorEvents;
    bool enableContactEvents;
    bool enableHitEvents;
    bool enablePreSolveEvents;
    bool invokeContactCreation;
    bool updateBodyMass;
    bool enableSpeculativeContact;
    i32 internalValue;
}

//! @cond
/// Profiling data. Times are in milliseconds.
/// @ingroup world
struct b3Profile {
    f32 step;
    f32 pairs;
    f32 collide;
    f32 solve;
    f32 solverSetup;
    f32 constraints;
    f32 prepareConstraints;
    f32 integrateVelocities;
    f32 warmStart;
    f32 solveImpulses;
    f32 integratePositions;
    f32 relaxImpulses;
    f32 applyRestitution;
    f32 storeImpulses;
    f32 splitIslands;
    f32 transforms;
    f32 sensorHits;
    f32 jointEvents;
    f32 hitEvents;
    f32 refit;
    f32 bullets;
    f32 sleepIslands;
    f32 sensors;
}

/// Counters that give details of the simulation size.
/// @ingroup world
struct b3Counters {
    i32 bodyCount;
    i32 shapeCount;
    i32 contactCount;
    i32 jointCount;
    i32 islandCount;
    i32 stackUsed;
    i32 arenaCapacity;
    i32 staticTreeHeight;
    i32 treeHeight;
    i32 satCallCount;
    i32 satCacheHitCount;
    i32 byteCount;
    i32 taskCount;
    i32[24] colorCounts;
    i32[8] manifoldCounts;
    i32 awakeContactCount;
    i32 recycledContactCount;
    i32 distanceIterations;
    i32 pushBackIterations;
    i32 rootIterations;
}

/// Base joint definition used by all joint types. The local frames are measured from the
/// body's origin rather than the center of mass because:
/// 1. You might not know where the center of mass will be.
/// 2. If you add/remove shapes from a body and recompute the mass, the joints will be broken.
/// @ingroup joint
struct b3JointDef {
    void* userData;
    b3BodyId bodyIdA;
    b3BodyId bodyIdB;
    b3Transform localFrameA;
    b3Transform localFrameB;
    f32 forceThreshold;
    f32 torqueThreshold;
    f32 constraintHertz;
    f32 constraintDampingRatio;
    f32 drawScale;
    bool collideConnected;
    i32 internalValue;
}

/// Distance joint definition.
/// Connects a point on body A with a point on body B by a segment.
/// Useful for ropes and springs.
/// @ingroup distance_joint
struct b3DistanceJointDef {
    b3JointDef base;
    f32 length;
    bool enableSpring;
    f32 lowerSpringForce;
    f32 upperSpringForce;
    f32 hertz;
    f32 dampingRatio;
    bool enableLimit;
    f32 minLength;
    f32 maxLength;
    bool enableMotor;
    f32 maxMotorForce;
    f32 motorSpeed;
}

/// A motor joint is used to control the relative position and velocity between two bodies.
/// @ingroup motor_joint
struct b3MotorJointDef {
    b3JointDef base;
    b3Vec3 linearVelocity;
    f32 maxVelocityForce;
    b3Vec3 angularVelocity;
    f32 maxVelocityTorque;
    f32 linearHertz;
    f32 linearDampingRatio;
    f32 maxSpringForce;
    f32 angularHertz;
    f32 angularDampingRatio;
    f32 maxSpringTorque;
}

/// A filter joint is used to disable collision between two specific bodies.
/// @ingroup filter_joint
struct b3FilterJointDef {
    b3JointDef base;
}

/// Parallel joint definition. Constrains the angle between axis z in body A and axis z in body B
/// using a spring. Useful to keep a body upright.
/// @ingroup parallel_joint
struct b3ParallelJointDef {
    b3JointDef base;
    f32 hertz;
    f32 dampingRatio;
    f32 maxTorque;
}

/// Prismatic joint definition. Body B may slide along the x-axis in local frame A.
/// Body B cannot rotate relative to body A. The joint translation is zero when the
/// local frame origins coincide in world space.
/// @ingroup prismatic_joint
struct b3PrismaticJointDef {
    b3JointDef base;
    bool enableSpring;
    f32 hertz;
    f32 dampingRatio;
    f32 targetTranslation;
    bool enableLimit;
    f32 lowerTranslation;
    f32 upperTranslation;
    bool enableMotor;
    f32 maxMotorForce;
    f32 motorSpeed;
}

/// Revolute joint definition. A point on body B is fixed to a point on body A.
/// Allows relative rotation about the z-axis.
/// @ingroup revolute_joint
struct b3RevoluteJointDef {
    b3JointDef base;
    f32 targetAngle;
    bool enableSpring;
    f32 hertz;
    f32 dampingRatio;
    bool enableLimit;
    f32 lowerAngle;
    f32 upperAngle;
    bool enableMotor;
    f32 maxMotorTorque;
    f32 motorSpeed;
}

/// Spherical joint definition. A point on body B is fixed to a point on body A.
/// Allows rotation about the shared point.
/// @ingroup spherical_joint
struct b3SphericalJointDef {
    b3JointDef base;
    bool enableSpring;
    f32 hertz;
    f32 dampingRatio;
    b3Quat targetRotation;
    bool enableConeLimit;
    f32 coneAngle;
    bool enableTwistLimit;
    f32 lowerTwistAngle;
    f32 upperTwistAngle;
    bool enableMotor;
    f32 maxMotorTorque;
    b3Vec3 motorVelocity;
}

/// Weld joint definition
/// Connects two bodies together rigidly. This constraint provides springs to mimic
/// soft-body simulation.
/// @note The approximate solver in Box3D cannot hold many bodies together rigidly
/// @ingroup weld_joint
struct b3WeldJointDef {
    b3JointDef base;
    f32 linearHertz;
    f32 angularHertz;
    f32 linearDampingRatio;
    f32 angularDampingRatio;
}

/// Wheel joint definition
/// Body A is the chassis and body B is the wheel.
/// The wheel rotates around the local z-axis in frame B.
/// The wheel translates along the local x-axis in frame A.
/// The wheel can optionally steer along the x-axis in frame A.
/// @ingroup wheel_joint
struct b3WheelJointDef {
    b3JointDef base;
    bool enableSuspensionSpring;
    f32 suspensionHertz;
    f32 suspensionDampingRatio;
    bool enableSuspensionLimit;
    f32 lowerSuspensionLimit;
    f32 upperSuspensionLimit;
    bool enableSpinMotor;
    f32 maxSpinTorque;
    f32 spinSpeed;
    bool enableSteering;
    f32 steeringHertz;
    f32 steeringDampingRatio;
    f32 targetSteeringAngle;
    f32 maxSteeringTorque;
    bool enableSteeringLimit;
    f32 lowerSteeringLimit;
    f32 upperSteeringLimit;
}

/// The explosion definition is used to configure options for explosions. Explosions
/// consider shape geometry when computing the impulse.
/// @ingroup world
struct b3ExplosionDef {
    u64 maskBits;
    b3Pos position;
    f32 radius;
    f32 falloff;
    f32 impulsePerArea;
}

/**
 * @defgroup event Events
 * World event types.
 *
 * Events are used to collect events that occur during the world time step. These events
 * are then available to query after the time step is complete. This is preferable to callbacks
 * because Box3D uses multithreaded simulation.
 *
 * Also when events occur in the simulation step it may be problematic to modify the world, which is
 * often what applications want to do when events occur.
 *
 * With event arrays, you can scan the events in a loop and modify the world. However, you need to be careful
 * that some event data may become invalid. There are several samples that show how to do this safely.
 *
 * @{
 */
/// A begin-touch event is generated when a shape starts to overlap a sensor shape.
struct b3SensorBeginTouchEvent {
    b3ShapeId sensorShapeId;
    b3ShapeId visitorShapeId;
}

/// An end touch event is generated when a shape stops overlapping a sensor shape.
///	These include things like setting the transform, destroying a body or shape, or changing
///	a filter. You will also get an end event if the sensor or visitor are destroyed.
///	Therefore you should always confirm the shape id is valid using b3Shape_IsValid.
struct b3SensorEndTouchEvent {
    b3ShapeId sensorShapeId;
    b3ShapeId visitorShapeId;
}

/// Sensor events are buffered in the world and are available
///	as begin/end overlap event arrays after the time step is complete.
///	Note: these may become invalid if bodies and/or shapes are destroyed
struct b3SensorEvents {
    b3SensorBeginTouchEvent* beginEvents;
    b3SensorEndTouchEvent* endEvents;
    i32 beginCount;
    i32 endCount;
}

/// A begin-touch event is generated when two shapes begin touching.
struct b3ContactBeginTouchEvent {
    b3ShapeId shapeIdA;
    b3ShapeId shapeIdB;
    b3ContactId contactId;
}

/// An end touch event is generated when two shapes stop touching.
///	You will get an end event if you do anything that destroys contacts previous to the last
///	world step. These include things like setting the transform, destroying a body
///	or shape, or changing a filter or body type.
struct b3ContactEndTouchEvent {
    b3ShapeId shapeIdA;
    b3ShapeId shapeIdB;
    b3ContactId contactId;
}

/// A hit touch event is generated when two shapes collide with a speed faster than the hit speed threshold.
/// This may be reported for speculative contacts that have a confirmed impulse.
struct b3ContactHitEvent {
    b3ShapeId shapeIdA;
    b3ShapeId shapeIdB;
    b3ContactId contactId;
    b3Pos point;
    b3Vec3 normal;
    f32 approachSpeed;
    u64 userMaterialIdA;
    u64 userMaterialIdB;
}

/// Contact events are buffered in the world and are available
///	as event arrays after the time step is complete.
///	Note: these may become invalid if bodies and/or shapes are destroyed
struct b3ContactEvents {
    b3ContactBeginTouchEvent* beginEvents;
    b3ContactEndTouchEvent* endEvents;
    b3ContactHitEvent* hitEvents;
    i32 beginCount;
    i32 endCount;
    i32 hitCount;
}

/// Body move events triggered when a body moves.
/// Triggered when a body moves due to simulation. Not reported for bodies moved by the user.
/// This also has a flag to indicate that the body went to sleep so the application can also
/// sleep that actor/entity/object associated with the body.
/// On the other hand if the flag does not indicate the body went to sleep then the application
/// can treat the actor/entity/object associated with the body as awake.
/// This is an efficient way for an application to update game object transforms rather than
/// calling functions such as b3Body_GetTransform() because this data is delivered as a contiguous array
/// and it is only populated with bodies that have moved.
/// @note If sleeping is disabled all dynamic and kinematic bodies will trigger move events.
struct b3BodyMoveEvent {
    void* userData;
    b3WorldTransform transform;
    b3BodyId bodyId;
    bool fellAsleep;
}

/// Body events are buffered in the world and are available
///	as event arrays after the time step is complete.
///	Note: this data becomes invalid if bodies are destroyed
struct b3BodyEvents {
    b3BodyMoveEvent* moveEvents;
    i32 moveCount;
}

/// Joint events report joints that are awake and have a force and/or torque exceeding the threshold
/// The observed forces and torques are not returned for efficiency reasons.
struct b3JointEvent {
    b3JointId jointId;
    void* userData;
}

/// Joint events are buffered in the world and are available
/// as event arrays after the time step is complete.
/// Note: this data becomes invalid if joints are destroyed
struct b3JointEvents {
    b3JointEvent* jointEvents;
    i32 count;
}

/// The contact data for two shapes. By convention the manifold normal points
/// from shape A to shape B.
/// @see b3Shape_GetContactData() and b3Body_GetContactData()
struct b3ContactData {
    b3ContactId contactId;
    b3ShapeId shapeIdA;
    b3ShapeId shapeIdB;
    b3Manifold* manifolds;
    i32 manifoldCount;
}

/**@}*/
// event
/**
 * @defgroup query Query
 * @brief Query types and functions
 *
 * Queries include ray casts, shapes casts, overlap, distance, and time of impact.
 * @{
 */
/// The query filter is used to filter collisions between queries and shapes. For example,
/// you may want a ray-cast representing a projectile to hit players and the static environment
/// but not debris.
struct b3QueryFilter {
    u64 categoryBits;
    u64 maskBits;
    u64 id;
    u8* name;
}

/// Low level ray cast input data.
struct b3RayCastInput {
    b3Vec3 origin;
    b3Vec3 translation;
    f32 maxFraction;
}

/// Result from b3World_RayCastClosest.
struct b3RayResult {
    b3ShapeId shapeId;
    b3Pos point;
    b3Vec3 normal;
    u64 userMaterialId;
    f32 fraction;
    i32 triangleIndex;
    i32 childIndex;
    i32 nodeVisits;
    i32 leafVisits;
    bool hit;
}

/// A shape proxy is used by the GJK algorithm. It can represent a convex shape.
struct b3ShapeProxy {
    b3Vec3* points;
    i32 count;
    f32 radius;
}

/// Low level shape cast input in generic form. This allows casting an arbitrary point
/// cloud wrap with a radius. For example, a sphere is a single point with a non-zero radius.
/// A capsule is two points with a non-zero radius. A box is four points with a zero radius.
struct b3ShapeCastInput {
    b3ShapeProxy proxy;
    b3Vec3 translation;
    f32 maxFraction;
    bool canEncroach;
}

/// Input for sweeping an AABB through a dynamic tree. The box is in the tree's world float frame.
/// The caller folds the cast shape radius and any world origin into the box, so the tree traversal
/// stays a conservative box sweep and the precise narrow phase happens per shape in the callback.
struct b3BoxCastInput {
    b3AABB box;
    b3Vec3 translation;
    f32 maxFraction;
}

/// Low level ray cast or shape-cast output data.
struct b3CastOutput {
    b3Vec3 normal;
    b3Vec3 point;
    f32 fraction;
    i32 iterations;
    i32 triangleIndex;
    i32 childIndex;
    i32 materialIndex;
    bool hit;
}

/// Body cast result for ray and shape casts.
struct b3BodyCastResult {
    b3ShapeId shapeId;
    b3Pos point;
    b3Vec3 normal;
    f32 fraction;
    i32 triangleIndex;
    u64 userMaterialId;
    i32 iterations;
    bool hit;
}

/// Used to warm start the GJK simplex. If you call this function multiple times with nearby
/// transforms this might improve performance. Otherwise you can zero initialize this.
/// The distance cache must be initialized to zero on the first call.
/// Users should generally just zero initialize this structure for each call.
struct b3SimplexCache {
    f32 metric;
    u16 count;
    u8[4] indexA;
    u8[4] indexB;
}

/// Input parameters for b3ShapeCast
struct b3ShapeCastPairInput {
    b3ShapeProxy proxyA;
    b3ShapeProxy proxyB;
    b3Transform transform;
    b3Vec3 translationB;
    f32 maxFraction;
    bool canEncroach;
}

/// Input for b3ShapeDistance
struct b3DistanceInput {
    b3ShapeProxy proxyA;
    b3ShapeProxy proxyB;
    b3Transform transform;
    bool useRadii;
}

/// Output for b3ShapeDistance
struct b3DistanceOutput {
    b3Vec3 pointA;
    b3Vec3 pointB;
    b3Vec3 normal;
    f32 distance;
    i32 iterations;
    i32 simplexCount;
}

/// Simplex vertex for debugging the GJK algorithm
struct b3SimplexVertex {
    b3Vec3 wA;
    b3Vec3 wB;
    b3Vec3 w;
    f32 a;
    i32 indexA;
    i32 indexB;
}

/// Simplex from the GJK algorithm
struct b3Simplex {
    b3SimplexVertex[4] vertices;
    i32 count;
}

/// This describes the motion of a body/shape for TOI computation. Shapes are defined with respect to the body origin,
/// which may not coincide with the center of mass. However, to support dynamics we must interpolate the center of mass
/// position.
struct b3Sweep {
    b3Vec3 localCenter;
    b3Vec3 c1;
    b3Vec3 c2;
    b3Quat q1;
    b3Quat q2;
}

/// Time of impact input
struct b3TOIInput {
    b3ShapeProxy proxyA;
    b3ShapeProxy proxyB;
    b3Sweep sweepA;
    b3Sweep sweepB;
    f32 maxFraction;
}

/// Time of impact output
struct b3TOIOutput {
    b3TOIState state;
    b3Vec3 point;
    b3Vec3 normal;
    f32 fraction;
    f32 distance;
    i32 distanceIterations;
    i32 pushBackIterations;
    i32 rootIterations;
    bool usedFallback;
}

/// Tree node child indices. For internal usage.
struct b3TreeNodeChildren {
    i32 child1;
    i32 child2;
}

/// A node in the dynamic tree. This is private data placed here for performance reasons.
/// todo test padding to 64 bytes to avoid straddling cache lines
struct b3TreeNode {
    b3AABB aabb;
    u64 categoryBits;
    unsafe_union {
        b3TreeNodeChildren children;
        u64 userData;
    };
    unsafe_union {
        i32 parent;
        i32 next;
    };
    u16 height;
    u16 flags;
}

/// Dynamic tree version for compatibility testing.
/// The dynamic tree structure. This should be considered private data.
/// It is placed here for performance reasons.
struct b3DynamicTree {
    u64 version;
    b3TreeNode* nodes;
    i32 root;
    i32 nodeCount;
    i32 nodeCapacity;
    i32 proxyCount;
    i32 freeList;
    i32* leafIndices;
    b3AABB* leafBoxes;
    b3Vec3* leafCenters;
    i32* binIndices;
    i32 rebuildCapacity;
}

/// These are performance results returned by dynamic tree queries.
struct b3TreeStats {
    i32 nodeVisits;
    i32 leafVisits;
}

/**@}*/
// tree
/**
 * @defgroup character Character Mover
 * Character movement solver
 * @{
 */
/// The plane between a character mover and a shape
struct b3PlaneResult {
    b3Plane plane;
    b3Vec3 point;
}

/// These are collision planes that can be fed to b3SolvePlanes. Normally
/// this is assembled by the user from plane results in b3PlaneResult.
struct b3CollisionPlane {
    b3Plane plane;
    f32 pushLimit;
    f32 push;
    bool clipVelocity;
}

/// Result returned by b3SolvePlanes.
struct b3PlaneSolverResult {
    b3Vec3 delta;
    i32 iterationCount;
}

/// Body plane result for movers.
struct b3BodyPlaneResult {
    b3ShapeId shapeId;
    b3PlaneResult result;
}

/**@}*/
// mover
/**
 * @defgroup geometry Geometry
 * @brief Geometry types and algorithms
 *
 * Definitions of spheres, capsules, hulls, meshes, height fields, and compounds.
 * @{
 */
/// This holds the mass data computed for a shape.
struct b3MassData {
    f32 mass;
    b3Vec3 center;
    b3Matrix3 inertia;
}

/**
 * @defgroup sphere Sphere
 * @brief Sphere primitive
 * @{
 */
/// A solid sphere
struct b3Sphere {
    b3Vec3 center;
    f32 radius;
}

/**@}*/
// sphere
/**
 * @defgroup capsule Capsule
 * @brief Capsule primitive
 * @{
 */
/// A solid capsule can be viewed as two hemispheres connected
/// by a rectangle.
struct b3Capsule {
    b3Vec3 center1;
    b3Vec3 center2;
    f32 radius;
}

/**@}*/
// capsule
/**
 * @defgroup hull Convex Hull
 * @brief Convex hull primitive
 * @{
 */
/// A hull vertex. Identified by a half-edge with this vertex as its tail.
struct b3HullVertex {
    u8 edge;
}

/// Half-edge for hull data structure
struct b3HullHalfEdge {
    u8 next;
    u8 twin;
    u8 origin;
    u8 face;
}

/// A hull face. Hulls use a half-edge data structure, so a face
/// can be determined from a single half-edge index.
struct b3HullFace {
    u8 edge;
}

/// 64-bit hull version. Useful for validating serialized data.
/// A convex hull.
/// @note This data structure has data hanging off the end and cannot be directly copied.
struct b3HullData {
    u64 version;
    i32 byteCount;
    u32 hash;
    b3AABB aabb;
    f32 surfaceArea;
    f32 volume;
    f32 innerRadius;
    b3Vec3 center;
    b3Matrix3 centralInertia;
    i32 vertexCount;
    i32 vertexOffset;
    i32 pointOffset;
    i32 edgeCount;
    i32 edgeOffset;
    i32 faceCount;
    i32 planeOffset;
    i32 faceOffset;
    i32 soaVertexOffset;
    i32 soaNormalOffset;
    i32 padding;
}

/// Efficient box hull
struct b3BoxHull {
    b3HullData base;
    b3HullVertex[8] boxVertices;
    b3Vec3[8] boxPoints;
    b3HullHalfEdge[24] boxEdges;
    b3Plane[6] boxPlanes;
    b3HullFace[6] boxFaces;
    u8[10] padding;
    f32[8] vx;
    f32[8] vy;
    f32[8] vz;
    f32[8] nx;
    f32[8] ny;
    f32[8] nz;
}

/**@}*/
// hull
/**
 * @defgroup mesh Triangle Mesh
 * @brief Triangle mesh collision shape
 * @{
 */
/// This is used to create a re-usable collision mesh.
struct b3MeshDef {
    b3Vec3* vertices;
    i32* indices;
    u8* materialIndices;
    f32 weldTolerance;
    i32 vertexCount;
    i32 triangleCount;
    bool weldVertices;
    bool useMedianSplit;
    bool identifyEdges;
}

/// A mesh triangle.
struct b3MeshTriangle {
    i32 index1;
    i32 index2;
    i32 index3;
}

/// A mesh BVH node.
struct b3MeshNode {
    b3Vec3 lowerBound;
    unsafe_union {
        struct {
            u32 axis;
            u32 childOffset;
        } asNode;
        struct {
            u32 type;
            u32 triangleCount;
        } asLeaf;
    } data;
    b3Vec3 upperBound;
    u32 triangleOffset;
}

/// This is a sorted triangle collision bounding volume hierarchy.
/// @note This struct has data hanging off the end and cannot be directly copied.
struct b3MeshData {
    u64 version;
    i32 byteCount;
    u32 hash;
    b3AABB bounds;
    f32 surfaceArea;
    i32 treeHeight;
    i32 degenerateCount;
    i32 nodeOffset;
    i32 nodeCount;
    i32 vertexOffset;
    i32 vertexCount;
    i32 triangleOffset;
    i32 triangleCount;
    i32 materialOffset;
    i32 materialCount;
    i32 flagsOffset;
}

/// This allows mesh data to be re-used with different scales.
struct b3Mesh {
    b3MeshData* data;
    b3Vec3 scale;
}

/**@}*/
// mesh
/**
 * @defgroup height_field Height Field
 * @brief Height field collision shape
 * @{
 */
/// Data used to create a height field
struct b3HeightFieldDef {
    f32* heights;
    u8* materialIndices;
    b3Vec3 scale;
    i32 countX;
    i32 countZ;
    f32 globalMinimumHeight;
    f32 globalMaximumHeight;
    bool clockwiseWinding;
}

/// This material index is used to designate holes in a height field.
/// 64-bit height-field version. Useful for validating serialized data.
/// A height field with compressed storage.
/// @note This data structure has data hanging off the end and cannot be directly copied.
struct b3HeightFieldData {
    u64 version;
    i32 byteCount;
    u32 hash;
    b3AABB aabb;
    f32 minHeight;
    f32 maxHeight;
    f32 heightScale;
    b3Vec3 scale;
    i32 columnCount;
    i32 rowCount;
    i32 heightsOffset;
    i32 materialOffset;
    i32 flagsOffset;
    bool clockwise;
    u8[3] padding;
}

/**@}*/
// height_field
/**
 * @defgroup compound Compound
 * @brief Compound collision shape
 * @{
 */
/// Definition for a capsule in a compound shape.
struct b3CompoundCapsuleDef {
    b3Capsule capsule;
    b3SurfaceMaterial material;
}

/// Definition for a convex hull in a compound shape.
struct b3CompoundHullDef {
    b3HullData* hull;
    b3Transform transform;
    b3SurfaceMaterial material;
}

/// Definition for a triangle mesh in a compound shape.
struct b3CompoundMeshDef {
    b3MeshData* meshData;
    b3Transform transform;
    b3Vec3 scale;
    b3SurfaceMaterial* materials;
    i32 materialCount;
}

/// Definition for a sphere in a compound shape.
struct b3CompoundSphereDef {
    b3Sphere sphere;
    b3SurfaceMaterial material;
}

/// Definition for creating a compound shape. All this data is fully cloned
/// into the run-time compound shape.
struct b3CompoundDef {
    b3CompoundCapsuleDef* capsules;
    i32 capsuleCount;
    b3CompoundHullDef* hulls;
    i32 hullCount;
    b3CompoundMeshDef* meshes;
    i32 meshCount;
    b3CompoundSphereDef* spheres;
    i32 sphereCount;
}

/// The baked compound version depends on the tree, mesh, and hull versions.
/// Meshes used in compounds have limited space for materials. If you have
/// a mesh with many materials, you can use it outside of the compound.
/// The data for a baked compound shape. This is a potentially large yet highly optimized
/// data structure. It can contain thousands of child shapes, yet at runtime it populates
/// into the world as a single shape in the runtime broad-phase.
/// This data structure has data living off the end and must be accessed using offsets.
/// Accessors are provided for user relevant data.
/// Note: you don't need to use this to create runtime compounds. For runtime compounds you can
/// add multiple shapes to a body using the regular shape creation functions.
struct b3CompoundData {
    u64 version;
    i32 byteCount;
    i32 nodeOffset;
    b3DynamicTree tree;
    i32 materialOffset;
    i32 materialCount;
    i32 capsuleOffset;
    i32 capsuleCount;
    i32 hullOffset;
    i32 hullCount;
    i32 sharedHullCount;
    i32 meshOffset;
    i32 meshCount;
    i32 sharedMeshCount;
    i32 sphereOffset;
    i32 sphereCount;
}

/// A capsule that lives in a compound.
struct b3CompoundCapsule {
    b3Capsule capsule;
    i32 materialIndex;
}

/// A hull that lives in a compound.
struct b3CompoundHull {
    b3HullData* hull;
    b3Transform transform;
    i32 materialIndex;
}

/// A mesh with non-uniform scale that lives in a compound.
struct b3CompoundMesh {
    b3MeshData* meshData;
    b3Transform transform;
    b3Vec3 scale;
    i32[4] materialIndices;
}

/// A sphere that lives in a compound.
struct b3CompoundSphere {
    b3Sphere sphere;
    i32 materialIndex;
}

/// Child shape of a compound
struct b3ChildShape {
    unsafe_union {
        b3Capsule capsule;
        b3HullData* hull;
        b3Mesh mesh;
        b3Sphere sphere;
    };
    b3Transform transform;
    i32[4] materialIndices;
    b3ShapeType type;
}

/**@}*/
// compound
/**@}*/
// geometry
/**
 * @defgroup collision Shape Collision
 * Collide pairs of shapes.
 * @{
 */
/// A manifold point is a contact point belonging to a contact manifold.
/// It holds details related to the geometry and dynamics of the contact points.
/// Box3D uses speculative collision so some contact points may be separated.
/// You may use the maxNormalImpulse to determine if there was an interaction during
/// the time step.
struct b3ManifoldPoint {
    b3Vec3 anchorA;
    b3Vec3 anchorB;
    f32 separation;
    f32 baseSeparation;
    f32 normalImpulse;
    f32 totalNormalImpulse;
    f32 normalVelocity;
    u32 featureId;
    i32 triangleIndex;
    bool persisted;
}

/// A contact manifold describes the contact points between colliding shapes.
/// @note Box3D uses speculative collision so some contact points may be separated.
struct b3Manifold {
    b3ManifoldPoint[4] points;
    b3Vec3 normal;
    f32 twistImpulse;
    b3Vec3 frictionImpulse;
    b3Vec3 rollingImpulse;
    i32 pointCount;
}

/// Separating axis test cache. Provides temporal acceleration of collision routines.
struct b3SATCache {
    f32 separation;
    u8 type;
    u8 indexA;
    u8 indexB;
    u8 hit;
}

/// Contact points are always the result of two edges intersecting.
/// It can be two edges of the same shape, which is just a shape vertex.
/// Or a contact point can be the result of two edges crossing from different shapes.
/// This is designed to support hull versus hull, but it is adapted to work
/// with all shape types. The feature pair is used to identify contact points
/// for temporal coherence and warm starting.
struct b3FeaturePair {
    u8 owner1;
    u8 index1;
    u8 owner2;
    u8 index2;
}

/// A local manifold point and normal in frame A.
struct b3LocalManifoldPoint {
    b3Vec3 point;
    f32 separation;
    b3FeaturePair pair;
    i32 triangleIndex;
}

/// A local manifold with no dynamic information. Used by b3Collide functions.
struct b3LocalManifold {
    b3Vec3 normal;
    b3Vec3 triangleNormal;
    b3LocalManifoldPoint* points;
    i32 pointCount;
    i32 triangleIndex;
    i32 i1;
    i32 i2;
    i32 i3;
    f32 squaredDistance;
    b3TriangleFeature feature;
    i32 triangleFlags;
}

/// This is sent to the user for debug shape creation. The user should know the type in case they have
/// custom sphere or capsule rendering.
struct b3DebugShape {
    b3ShapeId shapeId;
    b3ShapeType type;
    unsafe_union {
        b3Capsule* capsule;
        b3CompoundData* compound;
        b3HeightFieldData* heightField;
        b3HullData* hull;
        b3Mesh* mesh;
        b3Sphere* sphere;
    };
}

/// This struct is passed to b3World_Draw to draw a debug view of the simulation world.
/// Callbacks receive world coordinates. In large world mode the translation is double precision so
/// it stays accurate far from the origin. Shift into your own camera frame inside the callbacks.
struct b3DebugDraw {
    fn(void*, b3WorldTransform, b3HexColor, void*): void DrawShapeFcn;
    fn(b3Pos, b3Pos, b3HexColor, void*): void DrawSegmentFcn;
    fn(b3WorldTransform, void*): void DrawTransformFcn;
    fn(b3Pos, f32, b3HexColor, void*): void DrawPointFcn;
    fn(b3Pos, f32, b3HexColor, f32, void*): void DrawSphereFcn;
    fn(b3Pos, b3Pos, f32, b3HexColor, f32, void*): void DrawCapsuleFcn;
    fn(b3AABB, b3HexColor, void*): void DrawBoundsFcn;
    fn(b3Vec3, b3WorldTransform, b3HexColor, void*): void DrawBoxFcn;
    fn(b3Pos, u8*, b3HexColor, void*): void DrawStringFcn;
    b3AABB drawingBounds;
    f32 forceScale;
    f32 jointScale;
    bool drawShapes;
    bool drawJoints;
    bool drawJointExtras;
    bool drawBounds;
    bool drawMass;
    bool drawSleep;
    bool drawBodyNames;
    bool drawContacts;
    bool drawAnchorA;
    bool drawGraphColors;
    bool drawContactFeatures;
    bool drawContactNormals;
    bool drawContactForces;
    bool drawIslands;
    void* context;
}

// Define compiler
/// Tracy profiler instrumentation
/// https://github.com/wolfpld/tracy
// clang-format on
struct b3AtomicInt {
    i32 value;
}

struct b3AtomicU32 {
    u32 value;
}

struct b3Matrix2 {
    b3Vec2 cx;
    b3Vec2 cy;
}

struct b3Triangle {
    b3Vec3[3] vertices;
    i32 i1;
    i32 i2;
    i32 i3;
    i32 flags;
}

struct b3TrianglePoint {
    b3Vec3 point;
    b3TriangleFeature feature;
}

struct b3ShapeExtent {
    f32 minExtent;
    b3Vec3 maxExtent;
}

struct b3DynamicArray_int {
    i32* data;
    i32 count;
    i32 capacity;
}

struct b3StackEntry {
    u8* data;
    u8* name;
    i32 size;
    bool usedMalloc;
}

// This is a stack-like arena allocator used for fast per step allocations.
// You must nest allocate/free pairs. The code will B3_ASSERT
// if you try to interleave multiple allocate/free pairs.
// This allocator uses the heap if space is insufficient.
// I could remove the need to free entries individually.
struct b3Stack {
    u8* memory;
    i32 capacity;
    i32 index;
    i32 allocation;
    i32 maxAllocation;
    b3StackEntry[32] entries;
    i32 entryCount;
}

// Heap-allocated fallback block tracked when an arena bump overflows.
struct b3OverflowBlock {
    u8* data;
    i32 size;
}

struct b3DynamicArray_b3OverflowBlock {
    b3OverflowBlock* data;
    i32 count;
    i32 capacity;
}

// Shared, heap-allocated state co-owned by every copy of a b3Arena.
// b3Arena is passed by value so its bump pointer auto-restores on
// function return, but overflow tracking and watermarks must persist
// across copies -- hence this pointer-shared block.
struct b3ArenaSharedState {
    b3DynamicArray_b3OverflowBlock overflows;
    i32 maxIndex;
    i32 overflowBytes;
    i32 peakDemand;
}

struct b3Arena {
    u8* memory;
    i32 capacity;
    i32 index;
    b3ArenaSharedState* shared;
}

// SPDX-FileCopyrightText: 2025 Erin Catto
// SPDX-License-Identifier: MIT
// Bit set provides fast operations on large arrays of bits.
struct b3BitSet {
    u64* bits;
    u32 blockCapacity;
    u32 blockCount;
}

// SPDX-FileCopyrightText: 2026 Erin Catto
// SPDX-License-Identifier: MIT
struct b3Block {
    u8* memory;
}

struct b3DynamicArray_b3Block {
    b3Block* data;
    i32 count;
    i32 capacity;
}

struct b3BlockAllocator {
    b3DynamicArray_b3Block blocks;
    void* freeList;
    i32 elementSize;
    i32 nextIndex;
    i32 allocationCount;
}

// SPDX-FileCopyrightText: 2025 Erin Catto
// SPDX-License-Identifier: MIT
struct b3Body {
    void* userData;
    i32 setIndex;
    i32 localIndex;
    i32 headContactKey;
    i32 contactCount;
    i32 headShapeId;
    i32 shapeCount;
    i32 headChainId;
    i32 headJointKey;
    i32 jointCount;
    i32 islandId;
    i32 islandIndex;
    f32 sleepThreshold;
    f32 sleepTime;
    f32 sleepVelocity;
    f32 mass;
    b3Matrix3 inertia;
    i32 bodyMoveIndex;
    i32 id;
    u32 flags;
    u32 nameId;
    b3BodyType type;
    u16 generation;
}

// Body State
// The body state is designed for fast conversion to and from SIMD via scatter-gather.
// Only awake dynamic and kinematic bodies have a body state.
// This is used in the performance critical constraint solver
//
// The solver operates on the body state. The body state array does not hold static bodies. Static bodies are shared
// across worker threads. It would be okay to read their states, but writing to them would cause cache thrashing across
// workers, even if the values don't change.
// This causes some trouble when computing anchors. I rotate joint anchors using the body rotation every sub-step. For static
// bodies the anchor doesn't rotate. Body A or B could be static and this can lead to lots of branching. This branching
// should be minimized.
//
// Solution 1:
// Use delta rotations. This means anchors need to be prepared in world space. The delta rotation for static bodies will be
// identity using a dummy state. Base separation and angles need to be computed. Manifolds will be behind a frame, but that
// is probably best if bodies move fast.
//
// Solution 2:
// Use full rotation. The anchors for static bodies will be in world space while the anchors for dynamic bodies will be in local
// space. Potentially confusing and bug prone.
//
// Note:
// I rotate joint anchors each sub-step but not contact anchors. Joint stability improves a lot by rotating joint anchors
// according to substep progress. Contacts have reduced stability when anchors are rotated during substeps, especially for
// round shapes.
//
// 56 bytes
// todo_erin measure perf padding to 64 bytes
struct b3BodyState {
    b3Vec3 linearVelocity;
    b3Vec3 angularVelocity;
    b3Vec3 deltaPosition;
    b3Quat deltaRotation;
    u32 flags;
}

// SPDX-FileCopyrightText: 2025 Erin Catto
// SPDX-License-Identifier: MIT
// Solver work is partitioned into fixed-size blocks that worker threads claim
// in parallel via atomic CAS on a per-block syncIndex. The descriptor (b3SolverBlock)
// and the atomic counter sit in a wrapping b3SyncBlock so the CAS-winner can
// pass the descriptor by value into stage tasks without aliasing the atomic
// memory other threads are CAS-writing. Three properties of this design
// matter for performance:
//
// 1. Distributed contention. Per-block atomic syncIndex avoids the cache line stampede
//    that a single shared fetch_add counter would cause. Once a worker
//    settles into a block range, its CAS targets live in its own L1.
//
// 2. Monotonic syncIndex across iterations. Iterative stages (warm start,
//    solve, relax) reuse the same block array every sub-step iteration.
//    syncIndex grows each iteration; workers CAS (prev, prev+1), so the
//    main thread never touches any per-block state between iterations.
//    Non-iterative stages simply use syncIndex 1.
//
// 3. L2 affinity across iterations. Each worker picks a start offset from
//    its workerIndex, then scans forward and (after wrap) backward:
//
//      blocks:   [0] [1] [2] [3] [4] [5] [6] [7]
//                 ^           ^           ^   ^
//                 W0          W1          W2  W3   <- start offsets
//
//    W0 claims 0,1,2,3 (forward), W1 claims 4,5, etc. Under balanced load
//    each worker re-hits the same block range every iteration, keeping that
//    range's hot data resident in its L2. A failed CAS means a neighbour
//    already claimed the block, so the stealing worker stops -- preserving
//    locality under mild imbalance while still draining the queue.
//
// A graph color stage lays out joint blocks first, then contact blocks:
//
//      stage->blocks ->
//        +------+------+------+------+------+------+------+
//        |  J0  |  J1  |  J2  |  C0  |  C1  |  C2  |  C3  |
//        +------+------+------+------+------+------+------+
//        <-- graphJointBlocks --><---- graphContactBlocks ---->
//
// Each block carries its type so the dispatcher routes J-blocks to the joint
// solver and C-blocks to the SIMD contact solver; both kinds run concurrently
// within the stage -- no barrier between them. The type tag lives on the
// block (not the stage) so that mixed-type stages can keep the concurrency.
//
// The solver threading model is inspired by https://github.com/bepu/bepuphysics2
struct b3BodySim {
    b3WorldTransform transform;
    b3Pos center;
    b3Quat rotation0;
    b3Pos center0;
    b3Vec3 localCenter;
    b3Vec3 force;
    b3Vec3 torque;
    f32 invMass;
    b3Matrix3 invInertiaLocal;
    b3Matrix3 invInertiaWorld;
    f32 minExtent;
    b3Vec3 maxExtent;
    f32 linearDamping;
    f32 angularDamping;
    f32 gravityScale;
    i32 bodyId;
    u32 flags;
}

unsafe_union b3ContactCache {
    b3SATCache satCache;
    b3SimplexCache simplexCache;
}

struct b3TriangleCache {
    i32 triangleIndex;
    b3ContactCache cache;
}

struct b3DynamicArray_b3TriangleCache {
    b3TriangleCache* data;
    i32 count;
    i32 capacity;
}

// A contact edge is used to connect bodies and contacts together
// in a contact graph where each body is a node and each contact
// is an edge. A contact edge belongs to a doubly linked list
// maintained in each attached body. Each contact has two contact
// edges, one for each attached body.
struct b3ContactEdge {
    i32 bodyId;
    i32 prevKey;
    i32 nextKey;
}

struct b3MeshContact {
    b3DynamicArray_b3TriangleCache triangleCache;
    b3AABB queryBounds;
}

struct b3ConvexContact {
    b3ContactCache cache;
}

// SPDX-FileCopyrightText: 2025 Erin Catto
// SPDX-License-Identifier: MIT
struct b3Contact {
    i32 setIndex;
    i32 colorIndex;
    i32 localIndex;
    b3ContactEdge[2] edges;
    i32 shapeIdA;
    i32 shapeIdB;
    i32 childIndex;
    i32 islandId;
    i32 islandIndex;
    i32 contactId;
    i32 bodySimIndexA;
    i32 bodySimIndexB;
    u32 flags;
    b3Manifold* manifolds;
    i32 manifoldCount;
    b3Quat cachedRotationA;
    b3Quat cachedRotationB;
    b3Transform cachedRelativePose;
    f32 friction;
    unsafe_union {
        b3ConvexContact convexContact;
        b3MeshContact meshContact;
    };
    f32 restitution;
    f32 rollingResistance;
    b3Vec3 tangentVelocity;
    u32 generation;
}

struct b3ContactSpec {
    i32 contactId;
    i32 manifoldStart;
    u16 manifoldCount;
}

struct b3DynamicArray_b3ContactSpec {
    b3ContactSpec* data;
    i32 count;
    i32 capacity;
}

// SPDX-FileCopyrightText: 2025 Erin Catto
// SPDX-License-Identifier: MIT
struct b3IdPool {
    b3DynamicArray_int freeArray;
    i32 nextIndex;
}

// Cached contact data stored in the island for fast contiguous iteration.
// Avoids touching b3Contact during union-find in b3SplitIsland.
struct b3ContactLink {
    i32 contactId;
    i32 bodyIdA;
    i32 bodyIdB;
}

struct b3DynamicArray_b3ContactLink {
    b3ContactLink* data;
    i32 count;
    i32 capacity;
}

// Cached joint data stored in the island for fast contiguous iteration.
struct b3JointLink {
    i32 jointId;
    i32 bodyIdA;
    i32 bodyIdB;
}

struct b3DynamicArray_b3JointLink {
    b3JointLink* data;
    i32 count;
    i32 capacity;
}

// Deterministic solver
//
// Collide all awake contacts
// Use bit array to emit start/stop touching events in defined order, per thread. Try using contact index, assuming contacts are
// created in a deterministic order. bit-wise OR together bit arrays and issue changes:
// - start touching: merge islands - temporary linked list - mark root island dirty - wake all - largest island is root
// - stop touching: increment constraintRemoveCount
// Persistent island for awake bodies, joints, and contacts.
// Contacts are touching.
// Contacts and joints may connect to static bodies, but static bodies are not in the island.
// https://en.wikipedia.org/wiki/Component_(graph_theory)
// https://en.wikipedia.org/wiki/Dynamic_connectivity
struct b3Island {
    i32 setIndex;
    i32 localIndex;
    i32 islandId;
    i32 constraintRemoveCount;
    b3DynamicArray_int bodies;
    b3DynamicArray_b3ContactLink contacts;
    b3DynamicArray_b3JointLink joints;
}

// This is used to move islands across solver sets
struct b3IslandSim {
    i32 islandId;
}

// Solver block describes a multithreaded unit of work.
struct b3SolverBlock {
    i32 startIndex;
    u16 count;
    u8 blockType;
    u8 colorIndex;
}

// A unit of multithreaded work along with atomic synchronization. The syncIndex grows
// monotonically allowing the solver block to be re-used across sub-steps.
struct b3SyncBlock {
    b3SolverBlock block;
    b3AtomicInt syncIndex;
}

// Each stage must be completed before going to the next stage.
// Non-iterative stages use a stage instance once while iterative stages re-use the same instance each iteration.
struct b3SolverStage {
    b3SyncBlock* blocks;
    b3SolverStageType type;
    i32 blockCount;
    u8 colorIndex;
    b3AtomicInt completionCount;
}

// Constraint softness
struct b3Softness {
    f32 biasRate;
    f32 massScale;
    f32 impulseScale;
}

// Prepare/store run as a flat parallel-for over the whole wide-constraint
// range. Each span maps a slice of that range back to the owning color's
// contacts so workers can decode flat wide-slot indices without touching
// graph state. The spans array has one entry per active color plus a sentinel
// whose start == wideContactCount.
struct b3WidePrepareSpan {
    i32 start;
    i32 count;
    i32* contacts;
}

struct b3ContactPrepareSpan {
    i32 start;
    i32 count;
    b3ContactSpec* contacts;
}

struct b3JointPrepareSpan {
    i32 start;
    i32 count;
    b3JointSim* joints;
}

// Context for a time step. Recreated each time step.
struct b3StepContext {
    f32 dt;
    f32 inv_dt;
    f32 h;
    f32 inv_h;
    i32 subStepCount;
    b3Softness contactSoftness;
    b3Softness staticSoftness;
    f32 restitutionThreshold;
    f32 maxLinearVelocity;
    b3World* world;
    b3ConstraintGraph* graph;
    b3BodyState* states;
    b3BodySim* sims;
    i32* enlargedShapes;
    i32 enlargedShapeCount;
    i32* bulletBodies;
    b3AtomicInt bulletBodyCount;
    i32* awakeContactIndices;
    b3ContactConstraintWide* wideConstraints;
    b3WidePrepareSpan* widePrepareSpans;
    i32 wideContactCount;
    b3ManifoldConstraint* manifoldConstraints;
    b3ContactConstraint* contactConstraints;
    b3ContactPrepareSpan* contactPrepareSpans;
    b3ContactPrepareSpan* overflowSpans;
    b3JointPrepareSpan* jointPrepareSpans;
    i32 activeColorCount;
    i32 workerCount;
    b3SolverStage* stages;
    i32 stageCount;
    bool enableWarmStarting;
    u8[64] padding1;
    b3AtomicU32 atomicSyncBits;
    u8[64] padding2;
    b3AtomicInt mainClaimed;
    u8[64] padding3;
}

/// A joint edge is used to connect bodies and joints together
/// in a joint graph where each body is a node and each joint
/// is an edge. A joint edge belongs to a doubly linked list
/// maintained in each attached body. Each joint has two joint
/// nodes, one for each attached body.
struct b3JointEdge {
    i32 bodyId;
    i32 prevKey;
    i32 nextKey;
}

// Map from b3JointId to b3Joint in the solver sets
struct b3Joint {
    void* userData;
    i32 setIndex;
    i32 colorIndex;
    i32 localIndex;
    b3JointEdge[2] edges;
    i32 jointId;
    i32 islandId;
    i32 islandIndex;
    f32 drawScale;
    b3JointType type;
    u16 generation;
    bool collideConnected;
}

struct b3DistanceJoint {
    f32 length;
    f32 hertz;
    f32 dampingRatio;
    f32 lowerSpringForce;
    f32 upperSpringForce;
    f32 minLength;
    f32 maxLength;
    f32 maxMotorForce;
    f32 motorSpeed;
    f32 impulse;
    f32 lowerImpulse;
    f32 upperImpulse;
    f32 motorImpulse;
    i32 indexA;
    i32 indexB;
    b3Vec3 anchorA;
    b3Vec3 anchorB;
    b3Vec3 deltaCenter;
    b3Softness distanceSoftness;
    f32 axialMass;
    bool enableSpring;
    bool enableLimit;
    bool enableMotor;
}

struct b3MotorJoint {
    b3Vec3 linearVelocity;
    b3Vec3 angularVelocity;
    f32 maxVelocityForce;
    f32 maxVelocityTorque;
    f32 linearHertz;
    f32 linearDampingRatio;
    f32 maxSpringForce;
    f32 angularHertz;
    f32 angularDampingRatio;
    f32 maxSpringTorque;
    b3Vec3 linearVelocityImpulse;
    b3Vec3 angularVelocityImpulse;
    b3Vec3 linearSpringImpulse;
    b3Vec3 angularSpringImpulse;
    b3Softness linearSpring;
    b3Softness angularSpring;
    i32 indexA;
    i32 indexB;
    b3Transform frameA;
    b3Transform frameB;
    b3Vec3 deltaCenter;
    b3Matrix3 angularMass;
}

struct b3ParallelJoint {
    f32 hertz;
    f32 dampingRatio;
    f32 maxTorque;
    b3Vec2 perpImpulse;
    b3Vec3 perpAxisX;
    b3Vec3 perpAxisY;
    b3Quat quatA;
    b3Quat quatB;
    i32 indexA;
    i32 indexB;
    b3Softness softness;
}

struct b3PrismaticJoint {
    b3Vec2 perpImpulse;
    b3Vec3 angularImpulse;
    f32 springImpulse;
    f32 motorImpulse;
    f32 lowerImpulse;
    f32 upperImpulse;
    f32 hertz;
    f32 dampingRatio;
    f32 maxMotorForce;
    f32 motorSpeed;
    f32 targetTranslation;
    f32 lowerTranslation;
    f32 upperTranslation;
    i32 indexA;
    i32 indexB;
    b3Transform frameA;
    b3Transform frameB;
    b3Vec3 jointAxis;
    b3Vec3 perpAxisY;
    b3Vec3 perpAxisZ;
    b3Vec3 deltaCenter;
    f32 deltaAngle;
    b3Matrix3 rotationMass;
    b3Softness springSoftness;
    bool enableSpring;
    bool enableLimit;
    bool enableMotor;
}

struct b3RevoluteJoint {
    b3Vec3 linearImpulse;
    b3Vec2 perpImpulse;
    f32 springImpulse;
    f32 motorImpulse;
    f32 lowerImpulse;
    f32 upperImpulse;
    f32 hertz;
    f32 dampingRatio;
    f32 maxMotorTorque;
    f32 motorSpeed;
    f32 targetAngle;
    f32 lowerAngle;
    f32 upperAngle;
    i32 indexA;
    i32 indexB;
    b3Transform frameA;
    b3Transform frameB;
    b3Vec3 rotationAxisZ;
    b3Vec3 perpAxisX;
    b3Vec3 perpAxisY;
    b3Vec3 deltaCenter;
    f32 deltaAngle;
    f32 axialMass;
    b3Softness springSoftness;
    bool enableSpring;
    bool enableMotor;
    bool enableLimit;
}

struct b3SphericalJoint {
    b3Vec3 linearImpulse;
    b3Vec3 springImpulse;
    b3Vec3 motorImpulse;
    f32 lowerTwistImpulse;
    f32 upperTwistImpulse;
    f32 swingImpulse;
    f32 hertz;
    f32 dampingRatio;
    f32 maxMotorTorque;
    b3Vec3 motorVelocity;
    f32 lowerTwistAngle;
    f32 upperTwistAngle;
    f32 coneAngle;
    b3Quat targetRotation;
    i32 indexA;
    i32 indexB;
    b3Transform frameA;
    b3Transform frameB;
    b3Vec3 deltaCenter;
    b3Vec3 swingAxis;
    b3Vec3 twistJacobian;
    b3Matrix3 rotationMass;
    f32 swingMass;
    f32 twistMass;
    b3Softness springSoftness;
    bool enableSpring;
    bool enableMotor;
    bool enableConeLimit;
    bool enableTwistLimit;
}

struct b3WeldJoint {
    f32 linearHertz;
    f32 linearDampingRatio;
    f32 angularHertz;
    f32 angularDampingRatio;
    b3Softness linearSpring;
    b3Softness angularSpring;
    b3Vec3 linearImpulse;
    b3Vec3 angularImpulse;
    i32 indexA;
    i32 indexB;
    b3Transform frameA;
    b3Transform frameB;
    b3Vec3 deltaCenter;
    b3Matrix3 angularMass;
}

struct b3WheelJoint {
    b3Vec2 linearImpulse;
    b3Vec2 angularImpulse;
    f32 spinImpulse;
    f32 maxSpinTorque;
    f32 spinSpeed;
    f32 suspensionSpringImpulse;
    f32 lowerSuspensionImpulse;
    f32 upperSuspensionImpulse;
    f32 lowerSuspensionLimit;
    f32 upperSuspensionLimit;
    f32 suspensionHertz;
    f32 suspensionDampingRatio;
    f32 steeringSpringImpulse;
    f32 lowerSteeringImpulse;
    f32 upperSteeringImpulse;
    f32 lowerSteeringLimit;
    f32 upperSteeringLimit;
    f32 targetSteeringAngle;
    f32 maxSteeringTorque;
    f32 steeringHertz;
    f32 steeringDampingRatio;
    i32 indexA;
    i32 indexB;
    b3Transform frameA;
    b3Transform frameB;
    b3Vec3 deltaCenter;
    f32 spinMass;
    f32 suspensionMass;
    f32 steeringMass;
    b3Softness suspensionSoftness;
    b3Softness steeringSoftness;
    bool enableSpinMotor;
    bool enableSuspensionSpring;
    bool enableSuspensionLimit;
    bool enableSteering;
    bool enableSteeringLimit;
    bool enableSteeringMotor;
}

/// The base joint class. Joints are used to constraint two bodies together in
/// various fashions. Some joints also feature limits and motors.
struct b3JointSim {
    i32 jointId;
    i32 bodyIdA;
    i32 bodyIdB;
    b3JointType type;
    b3Transform localFrameA;
    b3Transform localFrameB;
    f32 invMassA;
    f32 invMassB;
    b3Matrix3 invIA;
    b3Matrix3 invIB;
    f32 constraintHertz;
    f32 constraintDampingRatio;
    b3Softness constraintSoftness;
    f32 forceThreshold;
    f32 torqueThreshold;
    bool fixedRotation;
    unsafe_union {
        b3DistanceJoint distanceJoint;
        b3MotorJoint motorJoint;
        b3ParallelJoint parallelJoint;
        b3RevoluteJoint revoluteJoint;
        b3SphericalJoint sphericalJoint;
        b3PrismaticJoint prismaticJoint;
        b3WeldJoint weldJoint;
        b3WheelJoint wheelJoint;
    };
}

