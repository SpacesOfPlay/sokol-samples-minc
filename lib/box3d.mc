    i32 splitIndex;
    i32 endIndex;
}

// SPDX-FileCopyrightText: 2026 Erin Catto
// SPDX-License-Identifier: MIT
// Dirk Gregorius contributed portions of this code
// Final hull is index-encoded with uint8_t, so vertex/edge/face counts are capped at UINT8_MAX.
struct b3QHListNode {
    b3QHListNode* prev;
    b3QHListNode* next;
}

struct b3QHVertex {
    b3QHListNode link;
    b3QHFace* conflictFace;
    b3Vec3 position;
    i32 finalIndex;
    bool reachable;
}

struct b3QHHalfEdge {
    b3QHHalfEdge* prev;
    b3QHHalfEdge* next;
    b3QHVertex* origin;
    b3QHFace* face;
    b3QHHalfEdge* twin;
    i32 finalIndex;
}

struct b3QHFace {
    b3QHListNode link;
    b3QHHalfEdge* edge;
    i32 mark;
    f32 area;
    b3Plane plane;
    b3Vec3 centroid;
    f32 maxConflictDistance;
    b3QHVertex conflictListHead;
    b3QHVertex* maxConflict;
    i32 finalIndex;
    bool flipped;
}

// One frame of the iterative horizon DFS. Replaces a recursive call to b3HullBuilder_BuildHorizon.
struct b3HorizonFrame {
    b3QHFace* face;
    b3QHHalfEdge* startEdge;
    b3QHHalfEdge* edge;
    bool started;
}

// All working memory for one hull build, carved from a single b3Alloc block.
struct b3HullBuilder {
    f32 tolerance;
    f32 minRadius;
    f32 minOutside;
    b3Vec3 interiorPoint;
    b3QHVertex orphanedList;
    b3QHVertex vertexList;
    b3QHFace faceList;
    b3QHVertex* vertexBase;
    i32 vertexCapacity;
    i32 vertexCount;
    b3QHHalfEdge* edgeBase;
    i32 edgeCapacity;
    i32 edgeCount;
    b3QHHalfEdge* edgeFreeHead;
    b3QHFace* faceBase;
    i32 faceCapacity;
    i32 faceCount;
    b3QHFace* faceFreeHead;
    b3QHHalfEdge** horizon;
    i32 horizonCapacity;
    i32 horizonCount;
    b3QHFace** cone;
    i32 coneCapacity;
    i32 coneCount;
    b3QHFace** mergedFaces;
    i32 mergedFacesCapacity;
    i32 mergedFacesCount;
    b3HorizonFrame* horizonStack;
    i32 horizonStackCapacity;
    i32 finalVertexCount;
    i32 finalHalfEdgeCount;
    i32 finalFaceCount;
}

struct b3HullWorkSizes {
    i32 N;
    i32 M;
    i32 vertexCapacity;
    i32 edgeCapacity;
    i32 faceCapacity;
    i32 horizonCapacity;
    i32 coneCapacity;
    i32 mergedFacesCapacity;
    i32 horizonStackCapacity;
    u64 totalBytes;
    u64 offsetVertex;
    u64 offsetEdge;
    u64 offsetFace;
    u64 offsetHorizon;
    u64 offsetCone;
    u64 offsetMergedFaces;
    u64 offsetHorizonStack;
    u64 offsetShiftedPoints;
}

struct b3JointPair {
