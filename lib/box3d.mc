bool b3Body_IsContactRecyclingEnabled(b3BodyId bodyId) {
    b3World* world = b3GetWorld(cast(i32, bodyId.world0));
    b3Body* body = b3GetBodyFullId(world, bodyId);
    return (body.flags & cast(u32, b3_bodyEnableContactRecycling)) != 0;
