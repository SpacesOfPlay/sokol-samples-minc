void b3DistanceJoint_EnableMotor(b3JointId jointId, bool enableMotor) {
    b3World* world = b3GetWorld(cast(i32, jointId.world0));
    while true {
        if world.recording != null {
            var recArgs = b3RecArgs_DistanceJointEnableMotor{jointId, enableMotor};
            b3RecWrite_DistanceJointEnableMotor(world.recording, &recArgs);
        }
        if !(0 != 0) { break; }
    }
    b3JointSim* joint = b3GetJointSimCheckType(jointId, b3_distanceJoint);
    if enableMotor != joint.distanceJoint.enableMotor {
        joint.distanceJoint.enableMotor = enableMotor;
        joint.distanceJoint.motorImpulse = 0.0f;
    }
}

bool b3DistanceJoint_IsMotorEnabled(b3JointId jointId) {
    b3JointSim* joint = b3GetJointSimCheckType(jointId, b3_distanceJoint);
    return joint.distanceJoint.enableMotor;
}

void b3DistanceJoint_SetMotorSpeed(b3JointId jointId, f32 motorSpeed) {
    b3World* world = b3GetWorld(cast(i32, jointId.world0));
    while true {
        if world.recording != null {
            var recArgs = b3RecArgs_DistanceJointSetMotorSpeed{jointId, motorSpeed};
            b3RecWrite_DistanceJointSetMotorSpeed(world.recording, &recArgs);
        }
        if !(0 != 0) { break; }
    }
    b3JointSim* joint = b3GetJointSimCheckType(jointId, b3_distanceJoint);
    joint.distanceJoint.motorSpeed = motorSpeed;
}

f32 b3DistanceJoint_GetMotorSpeed(b3JointId jointId) {
    b3JointSim* joint = b3GetJointSimCheckType(jointId, b3_distanceJoint);
    return joint.distanceJoint.motorSpeed;
}

f32 b3DistanceJoint_GetMotorForce(b3JointId jointId) {
    b3World* world = b3GetWorld(cast(i32, jointId.world0));
    b3JointSim* base = b3GetJointSimCheckType(jointId, b3_distanceJoint);
    return world.inv_h * base.distanceJoint.motorImpulse;
}

void b3DistanceJoint_SetMaxMotorForce(b3JointId jointId, f32 force) {
    b3World* world = b3GetWorld(cast(i32, jointId.world0));
    while true {
        if world.recording != null {
            var recArgs = b3RecArgs_DistanceJointSetMaxMotorForce{jointId, force};
            b3RecWrite_DistanceJointSetMaxMotorForce(world.recording, &recArgs);
        }
        if !(0 != 0) { break; }
    }
    b3JointSim* joint = b3GetJointSimCheckType(jointId, b3_distanceJoint);
    joint.distanceJoint.maxMotorForce = force;
}

f32 b3DistanceJoint_GetMaxMotorForce(b3JointId jointId) {
    b3JointSim* joint = b3GetJointSimCheckType(jointId, b3_distanceJoint);
    return joint.distanceJoint.maxMotorForce;
}

b3Vec3 b3GetDistanceJointForce(b3World* world, b3JointSim* base) {
    b3DistanceJoint* joint = &base.distanceJoint;
    b3WorldTransform transformA = b3GetBodyTransform(world, base.bodyIdA);
    b3WorldTransform transformB = b3GetBodyTransform(world, base.bodyIdB);
    b3Pos pA = b3TransformWorldPoint(transformA, base.localFrameA.p);
    b3Pos pB = b3TransformWorldPoint(transformB, base.localFrameB.p);
    b3Vec3 d = b3SubPos(pB, pA);
    b3Vec3 axis = b3Normalize(d);
    f32 force = (joint.impulse + joint.lowerImpulse - joint.upperImpulse + joint.motorImpulse) * world.inv_h;
    return b3MulSV(force, axis);
}

// 1-D constrained system
// m (v2 - v1) = lambda
// v2 + (beta/h) * x1 + gamma * lambda = 0, gamma has units of inverse mass.
// x2 = x1 + h * v2
// 1-D mass-damper-spring system
// m (v2 - v1) + h * d * v2 + h * k *
// C = norm(p2 - p1) - L
// u = (p2 - p1) / norm(p2 - p1)
// Cdot = dot(u, v2 + cross(w2, r2) - v1 - cross(w1, r1))
// J = [-u -cross(r1, u) u cross(r2, u)]
// K = J * invM * JT
//   = invMass1 + invI1 * cross(r1, u)^2 + invMass2 + invI2 * cross(r2, u)^2
void b3PrepareDistanceJoint(b3JointSim* base, b3StepContext* context) {
    i32 idA = base.bodyIdA;
    i32 idB = base.bodyIdB;
    b3World* world = context.world;
    b3Body* bodyA = world.bodies.data + idA;
    b3Body* bodyB = world.bodies.data + idB;
    b3SolverSet* setA = world.solverSets.data + bodyA.setIndex;
    b3SolverSet* setB = world.solverSets.data + bodyB.setIndex;
    i32 localIndexA = bodyA.localIndex;
    i32 localIndexB = bodyB.localIndex;
    b3BodySim* bodySimA = setA.bodySims.data + localIndexA;
    b3BodySim* bodySimB = setB.bodySims.data + localIndexB;
    f32 mA = bodySimA.invMass;
    b3Matrix3 iA = bodySimA.invInertiaWorld;
    f32 mB = bodySimB.invMass;
    b3Matrix3 iB = bodySimB.invInertiaWorld;
    base.invMassA = mA;
    base.invMassB = mB;
    base.invIA = iA;
    base.invIB = iB;
    b3DistanceJoint* joint = &base.distanceJoint;
    joint.indexA = bodyA.setIndex == b3_awakeSet ? localIndexA : -1;
    joint.indexB = bodyB.setIndex == b3_awakeSet ? localIndexB : -1;
    joint.anchorA = b3RotateVector(bodySimA.transform.q, b3Sub(base.localFrameA.p, bodySimA.localCenter));
    joint.anchorB = b3RotateVector(bodySimB.transform.q, b3Sub(base.localFrameB.p, bodySimB.localCenter));
    joint.deltaCenter = b3SubPos(bodySimB.center, bodySimA.center);
    b3Vec3 rA = joint.anchorA;
    b3Vec3 rB = joint.anchorB;
    b3Vec3 separation = b3Add(b3Sub(rB, rA), joint.deltaCenter);
    b3Vec3 axis = b3Normalize(separation);
    b3Vec3 crA = b3Cross(rA, axis);
    b3Vec3 crB = b3Cross(rB, axis);
    f32 k = mA + mB + b3Dot(crA, b3MulMV(iA, crA)) + b3Dot(crB, b3MulMV(iB, crB));
    joint.axialMass = k > 0.0f ? 1.0f / k : 0.0f;
    joint.distanceSoftness = b3MakeSoft(joint.hertz, joint.dampingRatio, context.h);
    if context.enableWarmStarting == false {
        joint.impulse = 0.0f;
        joint.lowerImpulse = 0.0f;
        joint.upperImpulse = 0.0f;
        joint.motorImpulse = 0.0f;
    }
}

void b3WarmStartDistanceJoint(b3JointSim* base, b3StepContext* context) {
    f32 mA = base.invMassA;
    f32 mB = base.invMassB;
    b3Matrix3 iA = base.invIA;
    b3Matrix3 iB = base.invIB;
    b3BodyState dummyState = b3_identityBodyState;
    b3DistanceJoint* joint = &base.distanceJoint;
    b3BodyState* stateA = joint.indexA == -1 ? &dummyState : context.states + joint.indexA;
    b3BodyState* stateB = joint.indexB == -1 ? &dummyState : context.states + joint.indexB;
    b3Vec3 rA = b3RotateVector(stateA.deltaRotation, joint.anchorA);
    b3Vec3 rB = b3RotateVector(stateB.deltaRotation, joint.anchorB);
    b3Vec3 ds = b3Add(b3Sub(stateB.deltaPosition, stateA.deltaPosition), b3Sub(rB, rA));
    b3Vec3 separation = b3Add(joint.deltaCenter, ds);
    b3Vec3 axis = b3Normalize(separation);
    f32 axialImpulse = joint.impulse + joint.lowerImpulse - joint.upperImpulse + joint.motorImpulse;
    b3Vec3 P = b3MulSV(axialImpulse, axis);
    if (stateA.flags & cast(u32, b3_dynamicFlag)) != 0 {
        stateA.linearVelocity = b3MulSub(stateA.linearVelocity, mA, P);
        stateA.angularVelocity = b3Sub(stateA.angularVelocity, b3MulMV(iA, b3Cross(rA, P)));
    }
    if (stateB.flags & cast(u32, b3_dynamicFlag)) != 0 {
        stateB.linearVelocity = b3MulAdd(stateB.linearVelocity, mB, P);
        stateB.angularVelocity = b3Add(stateB.angularVelocity, b3MulMV(iB, b3Cross(rB, P)));
    }
}

void b3SolveDistanceJoint(b3JointSim* base, b3StepContext* context, bool useBias) {
    f32 mA = base.invMassA;
    f32 mB = base.invMassB;
    b3Matrix3 iA = base.invIA;
    b3Matrix3 iB = base.invIB;
    b3BodyState dummyState = b3_identityBodyState;
    b3DistanceJoint* joint = &base.distanceJoint;
    b3BodyState* stateA = joint.indexA == -1 ? &dummyState : context.states + joint.indexA;
    b3BodyState* stateB = joint.indexB == -1 ? &dummyState : context.states + joint.indexB;
    b3Vec3 vA = stateA.linearVelocity;
    b3Vec3 wA = stateA.angularVelocity;
    b3Vec3 vB = stateB.linearVelocity;
    b3Vec3 wB = stateB.angularVelocity;
    b3Vec3 rA = b3RotateVector(stateA.deltaRotation, joint.anchorA);
    b3Vec3 rB = b3RotateVector(stateB.deltaRotation, joint.anchorB);
    b3Vec3 ds = b3Add(b3Sub(stateB.deltaPosition, stateA.deltaPosition), b3Sub(rB, rA));
    b3Vec3 separation = b3Add(joint.deltaCenter, ds);
    f32 length = b3Length(separation);
    b3Vec3 axis = b3Normalize(separation);
    if joint.enableSpring && (joint.minLength < joint.maxLength || joint.enableLimit == false) {
        if joint.hertz > 0.0f {
            b3Vec3 vr = b3Add(b3Sub(vB, vA), b3Sub(b3Cross(wB, rB), b3Cross(wA, rA)));
            f32 Cdot = b3Dot(axis, vr);
            f32 C = length - joint.length;
            f32 bias = joint.distanceSoftness.biasRate * C;
            f32 m = joint.distanceSoftness.massScale * joint.axialMass;
            f32 oldImpulse = joint.impulse;
            f32 impulse = -m * (Cdot + bias) - joint.distanceSoftness.impulseScale * oldImpulse;
            f32 h = context.h;
            joint.impulse = b3ClampFloat(joint.impulse + impulse, joint.lowerSpringForce * h, joint.upperSpringForce * h);
            impulse = joint.impulse - oldImpulse;
            b3Vec3 P = b3MulSV(impulse, axis);
            vA = b3MulSub(vA, mA, P);
            wA = b3Sub(wA, b3MulMV(iA, b3Cross(rA, P)));
            vB = b3MulAdd(vB, mB, P);
            wB = b3Add(wB, b3MulMV(iB, b3Cross(rB, P)));
        }
        if joint.enableLimit != 0 {
            {
                b3Vec3 vr = b3Add(b3Sub(vB, vA), b3Sub(b3Cross(wB, rB), b3Cross(wA, rA)));
                f32 Cdot = b3Dot(axis, vr);
                f32 C = length - joint.minLength;
                f32 bias = 0.0f;
                f32 massCoeff = 1.0f;
                f32 impulseCoeff = 0.0f;
                if C > 0.0f {
                    bias = C * context.inv_h;
                } else if useBias != 0 {
                    bias = base.constraintSoftness.biasRate * C;
                    massCoeff = base.constraintSoftness.massScale;
                    impulseCoeff = base.constraintSoftness.impulseScale;
                }
                f32 impulse = -massCoeff * joint.axialMass * (Cdot + bias) - impulseCoeff * joint.lowerImpulse;
                f32 newImpulse = b3MaxFloat(0.0f, joint.lowerImpulse + impulse);
                impulse = newImpulse - joint.lowerImpulse;
                joint.lowerImpulse = newImpulse;
                b3Vec3 P = b3MulSV(impulse, axis);
                vA = b3MulSub(vA, mA, P);
                wA = b3Sub(wA, b3MulMV(iA, b3Cross(rA, P)));
                vB = b3MulAdd(vB, mB, P);
                wB = b3Add(wB, b3MulMV(iB, b3Cross(rB, P)));
            }
            {
                b3Vec3 vr = b3Add(b3Sub(vA, vB), b3Sub(b3Cross(wA, rA), b3Cross(wB, rB)));
                f32 Cdot = b3Dot(axis, vr);
                f32 C = joint.maxLength - length;
                f32 bias = 0.0f;
                f32 massScale = 1.0f;
                f32 impulseScale = 0.0f;
                if C > 0.0f {
                    bias = C * context.inv_h;
                } else if useBias != 0 {
                    bias = base.constraintSoftness.biasRate * C;
                    massScale = base.constraintSoftness.massScale;
                    impulseScale = base.constraintSoftness.impulseScale;
                }
                f32 impulse = -massScale * joint.axialMass * (Cdot + bias) - impulseScale * joint.upperImpulse;
                f32 newImpulse = b3MaxFloat(0.0f, joint.upperImpulse + impulse);
                impulse = newImpulse - joint.upperImpulse;
                joint.upperImpulse = newImpulse;
                b3Vec3 P = b3MulSV(-impulse, axis);
                vA = b3MulSub(vA, mA, P);
                wA = b3Sub(wA, b3MulMV(iA, b3Cross(rA, P)));
                vB = b3MulAdd(vB, mB, P);
                wB = b3Add(wB, b3MulMV(iB, b3Cross(rB, P)));
            }
        }
        if joint.enableMotor != 0 {
            b3Vec3 vr = b3Add(b3Sub(vB, vA), b3Sub(b3Cross(wB, rB), b3Cross(wA, rA)));
            f32 Cdot = b3Dot(axis, vr);
            f32 impulse = joint.axialMass * (joint.motorSpeed - Cdot);
            f32 oldImpulse = joint.motorImpulse;
            f32 maxImpulse = context.h * joint.maxMotorForce;
            joint.motorImpulse = b3ClampFloat(joint.motorImpulse + impulse, -maxImpulse, maxImpulse);
            impulse = joint.motorImpulse - oldImpulse;
            b3Vec3 P = b3MulSV(impulse, axis);
            vA = b3MulSub(vA, mA, P);
            wA = b3Sub(wA, b3MulMV(iA, b3Cross(rA, P)));
            vB = b3MulAdd(vB, mB, P);
            wB = b3Add(wB, b3MulMV(iB, b3Cross(rB, P)));
        }
    } else {
        b3Vec3 vr = b3Add(b3Sub(vB, vA), b3Sub(b3Cross(wB, rB), b3Cross(wA, rA)));
        f32 Cdot = b3Dot(axis, vr);
        f32 C = length - joint.length;
        f32 bias = 0.0f;
        f32 massScale = 1.0f;
        f32 impulseScale = 0.0f;
        if useBias != 0 {
            bias = base.constraintSoftness.biasRate * C;
            massScale = base.constraintSoftness.massScale;
            impulseScale = base.constraintSoftness.impulseScale;
        }
        f32 impulse = -massScale * joint.axialMass * (Cdot + bias) - impulseScale * joint.impulse;
        joint.impulse += impulse;
        b3Vec3 P = b3MulSV(impulse, axis);
        vA = b3MulSub(vA, mA, P);
        wA = b3Sub(wA, b3MulMV(iA, b3Cross(rA, P)));
        vB = b3MulAdd(vB, mB, P);
        wB = b3Add(wB, b3MulMV(iB, b3Cross(rB, P)));
    }
    if (stateA.flags & cast(u32, b3_dynamicFlag)) != 0 {
        stateA.linearVelocity = vA;
        stateA.angularVelocity = wA;
    }
    if (stateB.flags & cast(u32, b3_dynamicFlag)) != 0 {
        stateB.linearVelocity = vB;
        stateB.angularVelocity = wB;
    }
}

void b3DrawDistanceJoint(b3DebugDraw* draw, b3JointSim* base, b3WorldTransform transformA, b3WorldTransform transformB) {
    b3DistanceJoint* joint = &base.distanceJoint;
    b3Pos pA = b3TransformWorldPoint(transformA, base.localFrameA.p);
    b3Pos pB = b3TransformWorldPoint(transformB, base.localFrameB.p);
    b3Vec3 axis = b3Normalize(b3SubPos(pB, pA));
    if joint.minLength < joint.maxLength && joint.enableLimit {
        b3Pos pMin = b3OffsetPos(pA, b3MulSV(joint.minLength, axis));
        b3Pos pMax = b3OffsetPos(pA, b3MulSV(joint.maxLength, axis));
        if joint.minLength > 0.005f * b3GetLengthUnitsPerMeter() {
            draw.DrawPointFcn(pMin, 6.0f, b3_colorLightGreen, draw.context);
        }
        if joint.maxLength < 100000.0f * b3GetLengthUnitsPerMeter() {
            draw.DrawPointFcn(pMax, 6.0f, b3_colorRed, draw.context);
        }
        if joint.minLength > 0.005f * b3GetLengthUnitsPerMeter() && joint.maxLength < 100000.0f * b3GetLengthUnitsPerMeter() {
            draw.DrawSegmentFcn(pMin, pMax, b3_colorGray, draw.context);
        }
    }
    draw.DrawSegmentFcn(pA, pB, b3_colorWhite, draw.context);
    draw.DrawPointFcn(pA, 4.0f, b3_colorWhite, draw.context);
    draw.DrawPointFcn(pB, 4.0f, b3_colorWhite, draw.context);
    if joint.hertz > 0.0f && joint.enableSpring {
        b3Pos pRest = b3OffsetPos(pA, b3MulSV(joint.length, axis));
        draw.DrawPointFcn(pRest, 4.0f, b3_colorBlue, draw.context);
    }
}
// SPDX-FileCopyrightText: 2025 Erin Catto
// SPDX-License-Identifier: MIT
private {
b3TreeNode b3_defaultTreeNode = b3TreeNode{
    .aabb = b3AABB{b3Vec3{0.0f, 0.0f, 0.0f}, b3Vec3{0.0f, 0.0f, 0.0f}},
    .categoryBits = -1,
    .children = {.child1 = -1, .child2 = -1},
    .parent = -1,
    .height = 0,
    .flags = cast(u16, b3_allocatedNode),
};

bool dynamic_tree__b3IsLeaf(b3TreeNode* node) {
    return (node.flags & b3_leafNode) != 0;
}

bool b3IsAllocated(b3TreeNode* node) {
    return (node.flags & b3_allocatedNode) != 0;
}

u16 b3MaxUInt16(u16 a, u16 b) {
    return a > b ? a : b;
}
}

b3DynamicTree b3DynamicTree_Create(i32 proxyCapacity) {
    i32 capacity = b3MaxInt(proxyCapacity, 16);
    noinit b3DynamicTree tree;
    memset(&tree, 0, cast(u64, sizeof(b3DynamicTree)));
    tree.version = 0x93EDAF889FD30B4A;
    tree.root = -1;
    tree.nodeCapacity = 2 * capacity - 1;
    tree.nodeCount = 0;
    tree.nodes = cast(b3TreeNode*, b3Alloc(cast(u64, tree.nodeCapacity * sizeof(b3TreeNode))));
    memset(tree.nodes, 0, cast(u64, tree.nodeCapacity * sizeof(b3TreeNode)));
    for i32 i = 0; i < tree.nodeCapacity - 1; ++i {
        tree.nodes[i].next = i + 1;
    }
    tree.nodes[tree.nodeCapacity - 1].next = -1;
    tree.freeList = 0;
    tree.proxyCount = 0;
    tree.leafIndices = null;
    tree.leafBoxes = null;
    tree.leafCenters = null;
    tree.binIndices = null;
    tree.rebuildCapacity = 0;
    return tree;
}

void b3DynamicTree_Destroy(b3DynamicTree* tree) {
    b3Free(tree.nodes, cast(u64, tree.nodeCapacity * sizeof(b3TreeNode)));
    b3Free(tree.leafIndices, cast(u64, tree.rebuildCapacity * sizeof(i32)));
    b3Free(tree.leafBoxes, cast(u64, tree.rebuildCapacity * sizeof(b3AABB)));
    b3Free(tree.leafCenters, cast(u64, tree.rebuildCapacity * sizeof(b3Vec3)));
    b3Free(tree.binIndices, cast(u64, tree.rebuildCapacity * sizeof(i32)));
    memset(tree, 0, cast(u64, sizeof(b3DynamicTree)));
}

// Allocate a node from the pool. Grow the pool if necessary.
private {
i32 b3AllocateNode(b3DynamicTree* tree) {
    if tree.freeList == -1 {
        b3TreeNode* oldNodes = tree.nodes;
        i32 oldCapacity = tree.nodeCapacity;
        tree.nodeCapacity += oldCapacity >> 1;
        tree.nodes = cast(b3TreeNode*, b3Alloc(cast(u64, tree.nodeCapacity * sizeof(b3TreeNode))));
        memcpy(tree.nodes, oldNodes, cast(u64, tree.nodeCount * sizeof(b3TreeNode)));
        memset(tree.nodes + tree.nodeCount, 0, cast(u64, (tree.nodeCapacity - tree.nodeCount) * sizeof(b3TreeNode)));
        b3Free(oldNodes, cast(u64, oldCapacity * sizeof(b3TreeNode)));
        for i32 i = tree.nodeCount; i < tree.nodeCapacity - 1; ++i {
            tree.nodes[i].next = i + 1;
        }
        tree.nodes[tree.nodeCapacity - 1].next = -1;
        tree.freeList = tree.nodeCount;
    }
    i32 nodeIndex = tree.freeList;
    b3TreeNode* node = tree.nodes + nodeIndex;
    tree.freeList = node.next;
    *node = b3_defaultTreeNode;
    ++tree.nodeCount;
    return nodeIndex;
}

// Return a node to the pool.
void b3FreeNode(b3DynamicTree* tree, i32 nodeId) {
    tree.nodes[nodeId].next = tree.freeList;
    tree.nodes[nodeId].flags = 0;
    tree.freeList = nodeId;
    --tree.nodeCount;
}

// Greedy algorithm for sibling selection using the SAH
// We have three nodes A-(B,C) and want to add a leaf D, there are three choices.
// 1: make a new parent for A and D : E-(A-(B,C), D)
// 2: associate D with B
//   a: B is a leaf : A-(E-(B,D), C)
//   b: B is an internal node: A-(B{D},C)
// 3: associate D with C
//   a: C is a leaf : A-(B, E-(C,D))
//   b: C is an internal node: A-(B, C{D})
// All of these have a clear cost except when B or C is an internal node. Hence we need to be greedy.
// The cost for cases 1, 2a, and 3a can be computed using the sibling cost formula.
// cost of sibling H = area(union(H, D)) + increased area of ancestors
// Suppose B (or C) is an internal node, then the lowest cost would be one of two cases:
// case1: D becomes a sibling of B
// case2: D becomes a descendant of B along with a new internal node of area(D).
i32 b3FindBestSibling(b3DynamicTree* tree, b3AABB boxD) {
    b3Vec3 centerD = b3AABB_Center(boxD);
    f32 areaD = b3Perimeter(boxD);
    b3TreeNode* nodes = tree.nodes;
    i32 rootIndex = tree.root;
    b3AABB rootBox = nodes[rootIndex].aabb;
    f32 areaBase = b3Perimeter(rootBox);
    f32 directCost = b3Perimeter(b3AABB_Union(rootBox, boxD));
    f32 inheritedCost = 0.0f;
    i32 bestSibling = rootIndex;
    f32 bestCost = directCost;
    i32 index = rootIndex;
    while dynamic_tree__b3IsLeaf(nodes + index) == false {
        i32 child1 = nodes[index].children.child1;
        i32 child2 = nodes[index].children.child2;
        f32 cost = directCost + inheritedCost;
        if cost < bestCost {
            bestSibling = index;
            bestCost = cost;
        }
        inheritedCost += directCost - areaBase;
        bool leaf1 = dynamic_tree__b3IsLeaf(nodes + child1);
        bool leaf2 = dynamic_tree__b3IsLeaf(nodes + child2);
        f32 lowerCost1 = FLT_MAX;
        b3AABB box1 = nodes[child1].aabb;
        f32 directCost1 = b3Perimeter(b3AABB_Union(box1, boxD));
        f32 area1 = 0.0f;
        if leaf1 != 0 {
            f32 cost1 = directCost1 + inheritedCost;
            if cost1 < bestCost {
                bestSibling = child1;
                bestCost = cost1;
            }
        } else {
            area1 = b3Perimeter(box1);
            lowerCost1 = inheritedCost + directCost1 + b3MinFloat(areaD - area1, 0.0f);
        }
        f32 lowerCost2 = FLT_MAX;
        b3AABB box2 = nodes[child2].aabb;
        f32 directCost2 = b3Perimeter(b3AABB_Union(box2, boxD));
        f32 area2 = 0.0f;
        if leaf2 != 0 {
            f32 cost2 = directCost2 + inheritedCost;
            if cost2 < bestCost {
                bestSibling = child2;
                bestCost = cost2;
            }
        } else {
            area2 = b3Perimeter(box2);
            lowerCost2 = inheritedCost + directCost2 + b3MinFloat(areaD - area2, 0.0f);
        }
        if leaf1 && leaf2 {
            break;
        }
        if bestCost <= lowerCost1 && bestCost <= lowerCost2 {
            break;
        }
        if lowerCost1 == lowerCost2 && leaf1 == false {
            b3Vec3 d1 = b3Sub(b3AABB_Center(box1), centerD);
            b3Vec3 d2 = b3Sub(b3AABB_Center(box2), centerD);
            lowerCost1 = b3LengthSquared(d1);
            lowerCost2 = b3LengthSquared(d2);
        }
        if lowerCost1 < lowerCost2 && leaf1 == false {
            index = child1;
            areaBase = area1;
            directCost = directCost1;
        } else {
            index = child2;
            areaBase = area2;
            directCost = directCost2;
        }
    }
    return bestSibling;
}

// Perform a left or right rotation if node A is imbalanced.
// Returns the new root index.
void b3RotateNodes(b3DynamicTree* tree, i32 iA) {
    b3TreeNode* nodes = tree.nodes;
    b3TreeNode* A = nodes + iA;
    if dynamic_tree__b3IsLeaf(A) == true {
        return;
    }
    i32 iB = A.children.child1;
    i32 iC = A.children.child2;
    b3TreeNode* B = nodes + iB;
    b3TreeNode* C = nodes + iC;
    bool isLeafB = dynamic_tree__b3IsLeaf(B);
    bool isLeafC = dynamic_tree__b3IsLeaf(C);
    if isLeafB == true && isLeafC == false {
        i32 iF = C.children.child1;
        i32 iG = C.children.child2;
        b3TreeNode* F = nodes + iF;
        b3TreeNode* G = nodes + iG;
        f32 costBase = b3Perimeter(C.aabb);
        b3AABB aabbBG = b3AABB_Union(B.aabb, G.aabb);
        f32 costBF = b3Perimeter(aabbBG);
        b3AABB aabbBF = b3AABB_Union(B.aabb, F.aabb);
        f32 costBG = b3Perimeter(aabbBF);
        if costBase < costBF && costBase < costBG {
            return;
        }
        if costBF < costBG {
            A.children.child1 = iF;
            C.children.child1 = iB;
            B.parent = iC;
            F.parent = iA;
            C.aabb = aabbBG;
            C.height = cast(u16, 1 + b3MaxUInt16(B.height, G.height));
            A.height = cast(u16, 1 + b3MaxUInt16(C.height, F.height));
            C.categoryBits = B.categoryBits | G.categoryBits;
            A.categoryBits = C.categoryBits | F.categoryBits;
            C.flags |= cast(u16, (B.flags | G.flags) & b3_enlargedNode);
            A.flags |= cast(u16, (C.flags | F.flags) & b3_enlargedNode);
        } else {
            A.children.child1 = iG;
            C.children.child2 = iB;
            B.parent = iC;
            G.parent = iA;
            C.aabb = aabbBF;
            C.height = cast(u16, 1 + b3MaxUInt16(B.height, F.height));
            A.height = cast(u16, 1 + b3MaxUInt16(C.height, G.height));
            C.categoryBits = B.categoryBits | F.categoryBits;
            A.categoryBits = C.categoryBits | G.categoryBits;
            C.flags |= cast(u16, (B.flags | F.flags) & b3_enlargedNode);
            A.flags |= cast(u16, (C.flags | G.flags) & b3_enlargedNode);
        }
    } else if isLeafC == true && isLeafB == false {
        i32 iD = B.children.child1;
        i32 iE = B.children.child2;
        b3TreeNode* D = nodes + iD;
        b3TreeNode* E = nodes + iE;
        f32 costBase = b3Perimeter(B.aabb);
        b3AABB aabbCE = b3AABB_Union(C.aabb, E.aabb);
        f32 costCD = b3Perimeter(aabbCE);
        b3AABB aabbCD = b3AABB_Union(C.aabb, D.aabb);
        f32 costCE = b3Perimeter(aabbCD);
        if costBase < costCD && costBase < costCE {
            return;
        }
        if costCD < costCE {
            A.children.child2 = iD;
            B.children.child1 = iC;
            C.parent = iB;
            D.parent = iA;
            B.aabb = aabbCE;
            B.height = cast(u16, 1 + b3MaxUInt16(C.height, E.height));
            A.height = cast(u16, 1 + b3MaxUInt16(B.height, D.height));
            B.categoryBits = C.categoryBits | E.categoryBits;
            A.categoryBits = B.categoryBits | D.categoryBits;
            B.flags |= cast(u16, (C.flags | E.flags) & b3_enlargedNode);
            A.flags |= cast(u16, (B.flags | D.flags) & b3_enlargedNode);
        } else {
            A.children.child2 = iE;
            B.children.child2 = iC;
            C.parent = iB;
            E.parent = iA;
            B.aabb = aabbCD;
            B.height = cast(u16, 1 + b3MaxUInt16(C.height, D.height));
            A.height = cast(u16, 1 + b3MaxUInt16(B.height, E.height));
            B.categoryBits = C.categoryBits | D.categoryBits;
            A.categoryBits = B.categoryBits | E.categoryBits;
            B.flags |= cast(u16, (C.flags | D.flags) & b3_enlargedNode);
            A.flags |= cast(u16, (B.flags | E.flags) & b3_enlargedNode);
        }
    } else if isLeafB == false && isLeafC == false {
        i32 iD = B.children.child1;
        i32 iE = B.children.child2;
        i32 iF = C.children.child1;
        i32 iG = C.children.child2;
        b3TreeNode* D = nodes + iD;
        b3TreeNode* E = nodes + iE;
        b3TreeNode* F = nodes + iF;
        b3TreeNode* G = nodes + iG;
        f32 areaB = b3Perimeter(B.aabb);
        f32 areaC = b3Perimeter(C.aabb);
        f32 costBase = areaB + areaC;
        b3RotateType bestRotation = b3_rotateNone;
        f32 bestCost = costBase;
        b3AABB aabbBG = b3AABB_Union(B.aabb, G.aabb);
        f32 costBF = areaB + b3Perimeter(aabbBG);
        if costBF < bestCost {
            bestRotation = b3_rotateBF;
            bestCost = costBF;
        }
        b3AABB aabbBF = b3AABB_Union(B.aabb, F.aabb);
        f32 costBG = areaB + b3Perimeter(aabbBF);
        if costBG < bestCost {
            bestRotation = b3_rotateBG;
            bestCost = costBG;
        }
        b3AABB aabbCE = b3AABB_Union(C.aabb, E.aabb);
        f32 costCD = areaC + b3Perimeter(aabbCE);
        if costCD < bestCost {
            bestRotation = b3_rotateCD;
            bestCost = costCD;
        }
        b3AABB aabbCD = b3AABB_Union(C.aabb, D.aabb);
        f32 costCE = areaC + b3Perimeter(aabbCD);
        if costCE < bestCost {
            bestRotation = b3_rotateCE;
        }
        switch bestRotation {
            case b3_rotateNone: {
            }
            case b3_rotateBF: {
                A.children.child1 = iF;
                C.children.child1 = iB;
                B.parent = iC;
                F.parent = iA;
                C.aabb = aabbBG;
                C.height = cast(u16, 1 + b3MaxUInt16(B.height, G.height));
                A.height = cast(u16, 1 + b3MaxUInt16(C.height, F.height));
                C.categoryBits = B.categoryBits | G.categoryBits;
                A.categoryBits = C.categoryBits | F.categoryBits;
                C.flags |= cast(u16, (B.flags | G.flags) & b3_enlargedNode);
                A.flags |= cast(u16, (C.flags | F.flags) & b3_enlargedNode);
            }
            case b3_rotateBG: {
                A.children.child1 = iG;
                C.children.child2 = iB;
                B.parent = iC;
                G.parent = iA;
                C.aabb = aabbBF;
                C.height = cast(u16, 1 + b3MaxUInt16(B.height, F.height));
                A.height = cast(u16, 1 + b3MaxUInt16(C.height, G.height));
                C.categoryBits = B.categoryBits | F.categoryBits;
                A.categoryBits = C.categoryBits | G.categoryBits;
                C.flags |= cast(u16, (B.flags | F.flags) & b3_enlargedNode);
                A.flags |= cast(u16, (C.flags | G.flags) & b3_enlargedNode);
            }
            case b3_rotateCD: {
                A.children.child2 = iD;
                B.children.child1 = iC;
                C.parent = iB;
                D.parent = iA;
                B.aabb = aabbCE;
                B.height = cast(u16, 1 + b3MaxUInt16(C.height, E.height));
                A.height = cast(u16, 1 + b3MaxUInt16(B.height, D.height));
                B.categoryBits = C.categoryBits | E.categoryBits;
                A.categoryBits = B.categoryBits | D.categoryBits;
                B.flags |= cast(u16, (C.flags | E.flags) & b3_enlargedNode);
                A.flags |= cast(u16, (B.flags | D.flags) & b3_enlargedNode);
            }
            case b3_rotateCE: {
                A.children.child2 = iE;
                B.children.child2 = iC;
                C.parent = iB;
                E.parent = iA;
                B.aabb = aabbCD;
                B.height = cast(u16, 1 + b3MaxUInt16(C.height, D.height));
                A.height = cast(u16, 1 + b3MaxUInt16(B.height, E.height));
                B.categoryBits = C.categoryBits | D.categoryBits;
                A.categoryBits = B.categoryBits | E.categoryBits;
                B.flags |= cast(u16, (C.flags | D.flags) & b3_enlargedNode);
                A.flags |= cast(u16, (B.flags | E.flags) & b3_enlargedNode);
            }
            default: {
            }
        }
    }
}

// It would be nicer if the root had zero height but maintaining this would drastically increase
// insertion cost because whole sub-trees would need the height to be updated.
void b3InsertLeaf(b3DynamicTree* tree, i32 leaf, bool shouldRotate) {
    if tree.root == -1 {
        tree.root = leaf;
        tree.nodes[tree.root].parent = -1;
        return;
    }
    b3AABB leafAABB = tree.nodes[leaf].aabb;
    i32 sibling = b3FindBestSibling(tree, leafAABB);
    i32 oldParent = tree.nodes[sibling].parent;
    i32 newParent = b3AllocateNode(tree);
    b3TreeNode* nodes = tree.nodes;
    nodes[newParent].parent = oldParent;
    nodes[newParent].userData = -1;
    nodes[newParent].aabb = b3AABB_Union(leafAABB, nodes[sibling].aabb);
    nodes[newParent].categoryBits = nodes[leaf].categoryBits | nodes[sibling].categoryBits;
    nodes[newParent].height = cast(u16, nodes[sibling].height + 1);
    if oldParent != -1 {
        if nodes[oldParent].children.child1 == sibling {
            nodes[oldParent].children.child1 = newParent;
        } else {
            nodes[oldParent].children.child2 = newParent;
        }
        nodes[newParent].children.child1 = sibling;
        nodes[newParent].children.child2 = leaf;
        nodes[sibling].parent = newParent;
        nodes[leaf].parent = newParent;
    } else {
        nodes[newParent].children.child1 = sibling;
        nodes[newParent].children.child2 = leaf;
        nodes[sibling].parent = newParent;
        nodes[leaf].parent = newParent;
        tree.root = newParent;
    }
    i32 index = nodes[leaf].parent;
    while index != -1 {
        i32 child1 = nodes[index].children.child1;
        i32 child2 = nodes[index].children.child2;
        nodes[index].aabb = b3AABB_Union(nodes[child1].aabb, nodes[child2].aabb);
        nodes[index].categoryBits = nodes[child1].categoryBits | nodes[child2].categoryBits;
        nodes[index].height = cast(u16, 1 + b3MaxUInt16(nodes[child1].height, nodes[child2].height));
        nodes[index].flags |= cast(u16, (nodes[child1].flags | nodes[child2].flags) & b3_enlargedNode);
        if shouldRotate != 0 {
            b3RotateNodes(tree, index);
        }
        index = nodes[index].parent;
    }
}

void b3RemoveLeaf(b3DynamicTree* tree, i32 leaf) {
    if leaf == tree.root {
        tree.root = -1;
        return;
    }
    b3TreeNode* nodes = tree.nodes;
    i32 parent = nodes[leaf].parent;
    i32 grandParent = nodes[parent].parent;
    i32 sibling;
    if nodes[parent].children.child1 == leaf {
        sibling = nodes[parent].children.child2;
    } else {
        sibling = nodes[parent].children.child1;
    }
    if grandParent != -1 {
        if nodes[grandParent].children.child1 == parent {
            nodes[grandParent].children.child1 = sibling;
        } else {
            nodes[grandParent].children.child2 = sibling;
        }
        nodes[sibling].parent = grandParent;
        b3FreeNode(tree, parent);
        i32 index = grandParent;
        while index != -1 {
            b3TreeNode* node = nodes + index;
            b3TreeNode* child1 = nodes + node.children.child1;
            b3TreeNode* child2 = nodes + node.children.child2;
            node.aabb = b3AABB_Union(child1.aabb, child2.aabb);
            node.categoryBits = child1.categoryBits | child2.categoryBits;
            node.height = cast(u16, 1 + b3MaxUInt16(child1.height, child2.height));
            index = node.parent;
        }
    } else {
        tree.root = sibling;
        tree.nodes[sibling].parent = -1;
        b3FreeNode(tree, parent);
    }
}
}

// Create a proxy in the tree as a leaf node. We return the index of the node instead of a pointer so that we can grow
// the node pool.
i32 b3DynamicTree_CreateProxy(b3DynamicTree* tree, b3AABB aabb, u64 categoryBits, u64 userData) {
    i32 proxyId = b3AllocateNode(tree);
    b3TreeNode* node = tree.nodes + proxyId;
    node.aabb = aabb;
    node.userData = userData;
    node.categoryBits = categoryBits;
    node.height = 0;
    node.flags = cast(u16, b3_allocatedNode | b3_leafNode);
    bool shouldRotate = true;
    b3InsertLeaf(tree, proxyId, shouldRotate);
    tree.proxyCount += 1;
    return proxyId;
}

void b3DynamicTree_DestroyProxy(b3DynamicTree* tree, i32 proxyId) {
    b3RemoveLeaf(tree, proxyId);
    b3FreeNode(tree, proxyId);
    tree.proxyCount -= 1;
}

i32 b3DynamicTree_GetProxyCount(b3DynamicTree* tree) {
    return tree.proxyCount;
}

void b3DynamicTree_MoveProxy(b3DynamicTree* tree, i32 proxyId, b3AABB aabb) {
    b3RemoveLeaf(tree, proxyId);
    tree.nodes[proxyId].aabb = aabb;
    bool shouldRotate = false;
    b3InsertLeaf(tree, proxyId, shouldRotate);
}

void b3DynamicTree_EnlargeProxy(b3DynamicTree* tree, i32 proxyId, b3AABB aabb) {
    b3TreeNode* nodes = tree.nodes;
    b3TreeNode* node = nodes + proxyId;
    node.aabb = aabb;
    i32 parentIndex = node.parent;
    while parentIndex != -1 {
        node = nodes + parentIndex;
        bool changed = b3EnlargeAABB(&node.aabb, aabb);
        node.flags |= cast(u16, b3_enlargedNode);
        parentIndex = node.parent;
        if changed == false {
            break;
        }
    }
    while parentIndex != -1 {
        node = nodes + parentIndex;
        if (node.flags & b3_enlargedNode) != 0 {
            break;
        }
        node.flags |= cast(u16, b3_enlargedNode);
        parentIndex = node.parent;
    }
}

void b3DynamicTree_SetCategoryBits(b3DynamicTree* tree, i32 proxyId, u64 categoryBits) {
    b3TreeNode* nodes = tree.nodes;
    nodes[proxyId].categoryBits = categoryBits;
    i32 nodeIndex = nodes[proxyId].parent;
    while nodeIndex != -1 {
        b3TreeNode* node = nodes + nodeIndex;
        i32 child1 = node.children.child1;
        i32 child2 = node.children.child2;
        node.categoryBits = nodes[child1].categoryBits | nodes[child2].categoryBits;
        nodeIndex = node.parent;
    }
}

u64 b3DynamicTree_GetCategoryBits(b3DynamicTree* tree, i32 proxyId) {
    return tree.nodes[proxyId].categoryBits;
}

i32 b3DynamicTree_GetHeight(b3DynamicTree* tree) {
    if tree.root == -1 {
        return 0;
    }
    return cast(i32, tree.nodes[tree.root].height);
}

f32 b3DynamicTree_GetAreaRatio(b3DynamicTree* tree) {
    if tree.root == -1 {
        return 0.0f;
    }
    b3TreeNode* root = tree.nodes + tree.root;
    f32 rootArea = b3Perimeter(root.aabb);
    f32 totalArea = 0.0f;
    for i32 i = 0; i < tree.nodeCapacity; ++i {
        b3TreeNode* node = tree.nodes + i;
        if b3IsAllocated(node) == false || dynamic_tree__b3IsLeaf(node) || i == tree.root {
            continue;
        }
        totalArea += b3Perimeter(node.aabb);
    }
    return totalArea / rootArea;
}

b3AABB b3DynamicTree_GetRootBounds(b3DynamicTree* tree) {
    if tree.root != -1 {
        return tree.nodes[tree.root].aabb;
    }
    var empty = b3AABB{b3Vec3_zero, b3Vec3_zero};
    return empty;
}

void b3DynamicTree_Validate(b3DynamicTree* tree) {
    ignore tree;
}

void b3DynamicTree_ValidateNoEnlarged(b3DynamicTree* tree) {
    ignore tree;
}

i32 b3DynamicTree_GetByteCount(b3DynamicTree* tree) {
    var size = cast(u64, sizeof(b3DynamicTree) + sizeof(b3TreeNode) * tree.nodeCapacity + tree.rebuildCapacity * (sizeof(i32) + sizeof(b3AABB) + sizeof(b3Vec3) + sizeof(i32)));
    return cast(i32, size);
}

b3TreeStats b3DynamicTree_Query(b3DynamicTree* tree, b3AABB aabb, u64 maskBits, bool requireAllBits, b3TreeQueryCallbackFcn callback, void* context) {
    b3TreeStats result;
    if tree.nodeCount == 0 {
        return result;
    }
    noinit i32[1024] stack;
    i32 stackCount = 0;
    stack[stackCount++] = tree.root;
    while stackCount > 0 {
        i32 nodeId = stack[--stackCount];
        if nodeId == -1 {
            continue;
        }
        b3TreeNode* node = tree.nodes + nodeId;
        result.nodeVisits += 1;
        u64 bitMatch = requireAllBits != 0 ? cast(u64, (node.categoryBits & maskBits) == maskBits) : node.categoryBits & maskBits;
        if bitMatch && b3AABB_Overlaps(node.aabb, aabb) {
            if dynamic_tree__b3IsLeaf(node) != 0 {
                bool proceed = callback(nodeId, node.userData, context) != 0;
                result.leafVisits += 1;
                if proceed == false {
                    return result;
                }
            } else {
                if stackCount < 1024 - 1 {
                    stack[stackCount++] = node.children.child1;
                    stack[stackCount++] = node.children.child2;
                }
            }
        }
    }
    return result;
}

private {
f32 b3DistanceToNodeSqr(b3Vec3 point, b3TreeNode* node) {
    b3Vec3 r = b3Sub(point, b3Clamp(point, node.aabb.lowerBound, node.aabb.upperBound));
    return b3Dot(r, r);
}
}

b3TreeStats b3DynamicTree_QueryClosest(b3DynamicTree* tree, b3Vec3 point, u64 maskBits, bool requireAllBits, b3TreeQueryClosestCallbackFcn callback, void* context, f32* minDistanceSqr) {
    b3TreeStats result;
    if tree.nodeCount == 0 {
        return result;
    }
    f32 minSqr = *minDistanceSqr;
    noinit b3QueryClosestItem[1024] stack;
    i32 stackCount = 0;
    f32 rootDistanceSqr = b3DistanceToNodeSqr(point, tree.nodes + tree.root);
    stack[stackCount++] = b3QueryClosestItem{
        .nodeIndex = tree.root,
        .distanceToNodeSqr = rootDistanceSqr,
    };
    while stackCount > 0 {
        b3QueryClosestItem item = stack[--stackCount];
        b3TreeNode* node = tree.nodes + item.nodeIndex;
        result.nodeVisits += 1;
        u64 bitMatch = requireAllBits != 0 ? cast(u64, (node.categoryBits & maskBits) == maskBits) : node.categoryBits & maskBits;
        if bitMatch != 0 {
            if item.distanceToNodeSqr < minSqr {
                if dynamic_tree__b3IsLeaf(node) != 0 {
                    f32 dd = callback(minSqr, item.nodeIndex, node.userData, context);
                    if dd < minSqr {
                        minSqr = dd;
                    }
                    result.leafVisits += 1;
                } else {
                    if stackCount < 1024 - 1 {
                        i32 child1 = node.children.child1;
                        i32 child2 = node.children.child2;
                        var item1 = b3QueryClosestItem{
                            .nodeIndex = child1,
                            .distanceToNodeSqr = b3DistanceToNodeSqr(point, tree.nodes + child1),
                        };
                        var item2 = b3QueryClosestItem{
                            .nodeIndex = child2,
                            .distanceToNodeSqr = b3DistanceToNodeSqr(point, tree.nodes + child2),
                        };
                        if item2.distanceToNodeSqr < item1.distanceToNodeSqr {
                            stack[stackCount++] = item1;
                            stack[stackCount++] = item2;
                        } else {
                            stack[stackCount++] = item2;
                            stack[stackCount++] = item1;
                        }
                    }
                }
            }
        }
    }
    *minDistanceSqr = minSqr;
    return result;
}

b3TreeStats b3DynamicTree_RayCast(b3DynamicTree* tree, b3RayCastInput* input, u64 maskBits, bool requireAllBits, b3TreeRayCastCallbackFcn callback, void* context) {
    b3TreeStats result;
    if tree.nodeCount == 0 {
        return result;
    }
    b3Vec3 p1 = input.origin;
    b3Vec3 d = input.translation;
    b3V32 pv1 = b3LoadV(&p1.x);
    b3V32 dv = b3LoadV(&d.x);
    f32 maxFraction = input.maxFraction;
    b3Vec3 p2 = b3MulAdd(p1, maxFraction, d);
    var segmentAABB = b3AABB{b3Min(p1, p2), b3Max(p1, p2)};
    noinit i32[1024] stack;
    i32 stackCount = 0;
    stack[stackCount++] = tree.root;
    b3TreeNode* nodes = tree.nodes;
    b3RayCastInput subInput = *input;
    while stackCount > 0 {
        i32 nodeId = stack[--stackCount];
        if nodeId == -1 {
            continue;
        }
        b3TreeNode* node = nodes + nodeId;
        result.nodeVisits += 1;
        b3AABB nodeAABB = node.aabb;
        u64 bitMatch = requireAllBits != 0 ? cast(u64, (node.categoryBits & maskBits) == maskBits) : node.categoryBits & maskBits;
        if bitMatch == 0 || b3AABB_Overlaps(nodeAABB, segmentAABB) == false {
            continue;
        }
        b3V32 lower = b3LoadV(&nodeAABB.lowerBound.x);
        b3V32 upper = b3LoadV(&nodeAABB.upperBound.x);
        bool edgeOverlap = b3TestBoundsRayOverlap(lower, upper, pv1, dv);
        if edgeOverlap == false {
            continue;
        }
        if dynamic_tree__b3IsLeaf(node) != 0 {
            subInput.maxFraction = maxFraction;
            f32 value = callback(&subInput, nodeId, node.userData, context);
            result.leafVisits += 1;
            if value == 0.0f {
                return result;
            }
            if 0.0f < value && value <= maxFraction {
                maxFraction = value;
                p2 = b3MulAdd(p1, maxFraction, d);
                segmentAABB.lowerBound = b3Min(p1, p2);
                segmentAABB.upperBound = b3Max(p1, p2);
            }
        } else {
            if stackCount < 1024 - 1 {
                b3Vec3 c1 = b3AABB_Center(nodes[node.children.child1].aabb);
                b3Vec3 c2 = b3AABB_Center(nodes[node.children.child2].aabb);
                if b3DistanceSquared(c1, p1) < b3DistanceSquared(c2, p1) {
                    stack[stackCount++] = node.children.child2;
                    stack[stackCount++] = node.children.child1;
                } else {
                    stack[stackCount++] = node.children.child1;
                    stack[stackCount++] = node.children.child2;
                }
            }
        }
    }
    return result;
}

b3TreeStats b3DynamicTree_BoxCast(b3DynamicTree* tree, b3BoxCastInput* input, u64 maskBits, bool requireAllBits, b3TreeBoxCastCallbackFcn callback, void* context) {
    b3TreeStats stats;
    if tree.nodeCount == 0 {
        return stats;
    }
    b3AABB originAABB = input.box;
    b3Vec3 p1 = b3AABB_Center(originAABB);
    b3Vec3 extension = b3AABB_Extents(originAABB);
    b3Vec3 d = input.translation;
    b3V32 pv1 = b3LoadV(&p1.x);
    b3V32 dv = b3LoadV(&d.x);
    b3V32 ev = b3LoadV(&extension.x);
    f32 maxFraction = input.maxFraction;
    b3Vec3 t = b3MulSV(maxFraction, input.translation);
    var totalAABB = b3AABB{
        b3Min(originAABB.lowerBound, b3Add(originAABB.lowerBound, t)),
        b3Max(originAABB.upperBound, b3Add(originAABB.upperBound, t)),
    };
    b3BoxCastInput subInput = *input;
    b3TreeNode* nodes = tree.nodes;
    noinit i32[1024] stack;
    i32 stackCount = 0;
    stack[stackCount++] = tree.root;
    while stackCount > 0 {
        i32 nodeId = stack[--stackCount];
        if nodeId == -1 {
            continue;
        }
        b3TreeNode* node = nodes + nodeId;
        stats.nodeVisits += 1;
        u64 bitMatch = requireAllBits != 0 ? cast(u64, (node.categoryBits & maskBits) == maskBits) : node.categoryBits & maskBits;
        if bitMatch == 0 || b3AABB_Overlaps(node.aabb, totalAABB) == false {
            continue;
        }
        b3V32 lower = b3SubV(b3LoadV(&node.aabb.lowerBound.x), ev);
        b3V32 upper = b3AddV(b3LoadV(&node.aabb.upperBound.x), ev);
        bool edgeOverlap = b3TestBoundsRayOverlap(lower, upper, pv1, dv);
        if edgeOverlap == false {
            continue;
        }
        if dynamic_tree__b3IsLeaf(node) != 0 {
            subInput.maxFraction = maxFraction;
            f32 value = callback(&subInput, nodeId, node.userData, context);
            stats.leafVisits += 1;
            if value == 0.0f {
                return stats;
            }
            if 0.0f < value && value < maxFraction {
                maxFraction = value;
                t = b3MulSV(maxFraction, input.translation);
                totalAABB.lowerBound = b3Min(originAABB.lowerBound, b3Add(originAABB.lowerBound, t));
                totalAABB.upperBound = b3Max(originAABB.upperBound, b3Add(originAABB.upperBound, t));
            }
        } else {
            if stackCount < 1024 - 1 {
                b3Vec3 c1 = b3AABB_Center(nodes[node.children.child1].aabb);
                b3Vec3 c2 = b3AABB_Center(nodes[node.children.child2].aabb);
                if b3DistanceSquared(c1, p1) < b3DistanceSquared(c2, p1) {
                    stack[stackCount++] = node.children.child2;
                    stack[stackCount++] = node.children.child1;
                } else {
                    stack[stackCount++] = node.children.child1;
                    stack[stackCount++] = node.children.child2;
                }
            }
        }
    }
    return stats;
}

// Median split == 0, Surface area heuristic == 1
// Median split heuristic
private {
i32 b3PartitionMid(i32* indices, b3Vec3* centers, i32 count) {
    if count <= 2 {
        return count / 2;
    }
    b3Vec3 lowerBound = centers[0];
    b3Vec3 upperBound = centers[0];
    for i32 i = 1; i < count; ++i {
        lowerBound = b3Min(lowerBound, centers[i]);
        upperBound = b3Max(upperBound, centers[i]);
    }
    b3Vec3 d = b3Sub(upperBound, lowerBound);
    b3Vec3 c = b3MulSV(0.5f, b3Add(lowerBound, upperBound));
    i32 i1 = 0;
    i32 i2 = count;
    if d.x >= d.y && d.x >= d.z {
        f32 pivot = c.x;
        while i1 < i2 {
            while i1 < i2 && centers[i1].x < pivot {
                i1 += 1;
            }
            while i1 < i2 && centers[i2 - 1].x >= pivot {
                i2 -= 1;
            }
            if i1 < i2 {
                {
                    i32 temp = indices[i1];
                    indices[i1] = indices[i2 - 1];
                    indices[i2 - 1] = temp;
                }
                {
                    b3Vec3 temp = centers[i1];
                    centers[i1] = centers[i2 - 1];
                    centers[i2 - 1] = temp;
                }
                i1 += 1;
                i2 -= 1;
            }
        }
    } else if d.y >= d.z {
        f32 pivot = c.y;
        while i1 < i2 {
            while i1 < i2 && centers[i1].y < pivot {
                i1 += 1;
            }
            while i1 < i2 && centers[i2 - 1].y >= pivot {
                i2 -= 1;
            }
            if i1 < i2 {
                {
                    i32 temp = indices[i1];
                    indices[i1] = indices[i2 - 1];
                    indices[i2 - 1] = temp;
                }
                {
                    b3Vec3 temp = centers[i1];
                    centers[i1] = centers[i2 - 1];
                    centers[i2 - 1] = temp;
                }
                i1 += 1;
                i2 -= 1;
            }
        }
    } else {
        f32 pivot = c.z;
        while i1 < i2 {
            while i1 < i2 && centers[i1].z < pivot {
                i1 += 1;
            }
            while i1 < i2 && centers[i2 - 1].z >= pivot {
                i2 -= 1;
            }
            if i1 < i2 {
                {
                    i32 temp = indices[i1];
                    indices[i1] = indices[i2 - 1];
                    indices[i2 - 1] = temp;
                }
                {
                    b3Vec3 temp = centers[i1];
                    centers[i1] = centers[i2 - 1];
                    centers[i2 - 1] = temp;
                }
                i1 += 1;
                i2 -= 1;
            }
        }
    }
    if i1 > 0 && i1 < count {
        return i1;
    }
    return count / 2;
}

// Returns root node index
i32 b3BuildTree(b3DynamicTree* tree, i32 leafCount) {
    b3TreeNode* nodes = tree.nodes;
    i32* leafIndices = tree.leafIndices;
    if leafCount == 1 {
        nodes[leafIndices[0]].parent = -1;
        return leafIndices[0];
    }
    b3Vec3* leafCenters = tree.leafCenters;
    noinit b3RebuildItem[1024] stack;
    i32 top = 0;
    stack[0].nodeIndex = b3AllocateNode(tree);
    stack[0].childCount = -1;
    stack[0].startIndex = 0;
    stack[0].endIndex = leafCount;
    stack[0].splitIndex = b3PartitionMid(leafIndices, leafCenters, leafCount);
    while true {
        b3RebuildItem* item = stack + top;
        item.childCount += 1;
        if item.childCount == 2 {
            if top == 0 {
                break;
            }
            b3RebuildItem* parentItem = stack + (top - 1);
            b3TreeNode* parentNode = nodes + parentItem.nodeIndex;
            if parentItem.childCount == 0 {
                parentNode.children.child1 = item.nodeIndex;
            } else {
                parentNode.children.child2 = item.nodeIndex;
            }
            b3TreeNode* node = nodes + item.nodeIndex;
            node.parent = parentItem.nodeIndex;
            b3TreeNode* child1 = nodes + node.children.child1;
            b3TreeNode* child2 = nodes + node.children.child2;
            node.aabb = b3AABB_Union(child1.aabb, child2.aabb);
            node.height = cast(u16, 1 + b3MaxUInt16(child1.height, child2.height));
            node.categoryBits = child1.categoryBits | child2.categoryBits;
            top -= 1;
        } else {
            i32 startIndex;
            i32 endIndex;
            if item.childCount == 0 {
                startIndex = item.startIndex;
                endIndex = item.splitIndex;
            } else {
                startIndex = item.splitIndex;
                endIndex = item.endIndex;
            }
            i32 count = endIndex - startIndex;
            if count == 1 {
                i32 childIndex = leafIndices[startIndex];
                b3TreeNode* node = nodes + item.nodeIndex;
                if item.childCount == 0 {
                    node.children.child1 = childIndex;
                } else {
                    node.children.child2 = childIndex;
                }
                b3TreeNode* childNode = nodes + childIndex;
                childNode.parent = item.nodeIndex;
            } else {
                top += 1;
                b3RebuildItem* newItem = stack + top;
                newItem.nodeIndex = b3AllocateNode(tree);
                newItem.childCount = -1;
                newItem.startIndex = startIndex;
                newItem.endIndex = endIndex;
                newItem.splitIndex = b3PartitionMid(leafIndices + startIndex, leafCenters + startIndex, count);
                newItem.splitIndex += startIndex;
            }
        }
    }
    b3TreeNode* rootNode = nodes + stack[0].nodeIndex;
    b3TreeNode* child1 = nodes + rootNode.children.child1;
    b3TreeNode* child2 = nodes + rootNode.children.child2;
    rootNode.aabb = b3AABB_Union(child1.aabb, child2.aabb);
    rootNode.height = cast(u16, 1 + b3MaxUInt16(child1.height, child2.height));
    rootNode.categoryBits = child1.categoryBits | child2.categoryBits;
    return stack[0].nodeIndex;
}
}

// Not safe to access tree during this operation because it may grow
i32 b3DynamicTree_Rebuild(b3DynamicTree* tree, bool fullBuild) {
    i32 proxyCount = tree.proxyCount;
    if proxyCount == 0 {
        return 0;
    }
    if proxyCount > tree.rebuildCapacity {
        i32 newCapacity = proxyCount + proxyCount / 2;
        b3Free(tree.leafIndices, cast(u64, tree.rebuildCapacity * sizeof(i32)));
        tree.leafIndices = cast(i32*, b3Alloc(cast(u64, newCapacity * sizeof(i32))));
        b3Free(tree.leafCenters, cast(u64, tree.rebuildCapacity * sizeof(b3Vec3)));
        tree.leafCenters = cast(b3Vec3*, b3Alloc(cast(u64, newCapacity * sizeof(b3Vec3))));
        tree.rebuildCapacity = newCapacity;
    }
    i32 leafCount = 0;
    noinit i32[1024] stack;
    i32 stackCount = 0;
    i32 nodeIndex = tree.root;
    b3TreeNode* nodes = tree.nodes;
    b3TreeNode* node = nodes + nodeIndex;
    i32* leafIndices = tree.leafIndices;
    b3Vec3* leafCenters = tree.leafCenters;
    while true {
        if dynamic_tree__b3IsLeaf(node) == true || (node.flags & b3_enlargedNode) == 0 && fullBuild == false {
            leafIndices[leafCount] = nodeIndex;
            leafCenters[leafCount] = b3AABB_Center(node.aabb);
            leafCount += 1;
            node.parent = -1;
        } else {
            i32 doomedNodeIndex = nodeIndex;
            nodeIndex = node.children.child1;
            if stackCount < 1024 {
                stack[stackCount++] = node.children.child2;
            }
            node = nodes + nodeIndex;
            b3FreeNode(tree, doomedNodeIndex);
            continue;
        }
        if stackCount == 0 {
            break;
        }
        nodeIndex = stack[--stackCount];
        node = nodes + nodeIndex;
    }
    tree.root = b3BuildTree(tree, leafCount);
    b3DynamicTree_Validate(tree);
    return leafCount;
}

private {
void* b3OpenTreeFile(u8* fileName, u8* mode) {
    void* file = null;
    errno_t e = fopen_s(&file, fileName, mode);
    if e != 0 {
        return null;
    }
    return file;
}
}

void b3DynamicTree_Save(b3DynamicTree* tree, u8* fileName) {
    void* file = b3OpenTreeFile(fileName, "wb");
    if file == null {
        return;
    }
    b3DynamicTree temp = *tree;
    temp.nodes = null;
    temp.leafIndices = null;
    temp.leafBoxes = null;
    temp.leafCenters = null;
    temp.binIndices = null;
    temp.rebuildCapacity = 0;
    __b3_fwrite(&temp, sizeof(b3DynamicTree), 1, file);
    if tree.nodeCapacity > 0 && tree.nodes != null {
        __b3_fwrite(tree.nodes, sizeof(b3TreeNode), tree.nodeCapacity, file);
    }
    __b3_fclose(file);
}

b3DynamicTree b3DynamicTree_Load(u8* fileName, f32 scale) {
    b3DynamicTree tree;
    void* file = b3OpenTreeFile(fileName, "rb");
    if file == null {
        return tree;
    }
    var readCount = cast(i32, __b3_fread(&tree, sizeof(b3DynamicTree), 1, file));
    if readCount != 1 {
        __b3_fclose(file);
        return tree;
    }
    if tree.version != 0x93EDAF889FD30B4A {
        __b3_fclose(file);
        memset(&tree, 0, cast(u64, sizeof(b3DynamicTree)));
        return tree;
    }
    if tree.nodeCapacity > 0 {
        tree.nodes = cast(b3TreeNode*, b3Alloc(cast(u64, tree.nodeCapacity * sizeof(b3TreeNode))));
        readCount = cast(i32, __b3_fread(tree.nodes, sizeof(b3TreeNode), tree.nodeCapacity, file));
        if readCount != tree.nodeCapacity {
            b3Free(tree.nodes, cast(u64, tree.nodeCapacity * sizeof(b3TreeNode)));
            __b3_fclose(file);
            memset(&tree, 0, cast(u64, sizeof(b3DynamicTree)));
            return tree;
        }
        for i32 i = 0; i < tree.nodeCapacity; ++i {
            b3TreeNode* node = tree.nodes + i;
            node.aabb.lowerBound = b3MulSV(scale, node.aabb.lowerBound);
            node.aabb.upperBound = b3MulSV(scale, node.aabb.upperBound);
        }
    } else {
        tree.nodes = null;
    }
    tree.leafIndices = null;
    tree.leafBoxes = null;
    tree.leafCenters = null;
    tree.binIndices = null;
    tree.rebuildCapacity = 0;
    __b3_fclose(file);
    return tree;
}

// SPDX-FileCopyrightText: 2025 Erin Catto
// SPDX-License-Identifier: MIT
/*
	Convention

	index = row * columnCount + column
	height = minHeight + heightScale * compressedHeights[index];

	column = index % columnCount;
	row = index / columnCount;

	x-axis : columns
	z-axis : rows

	00 --- 01 --- 02 --- 03 X
	|  0   |  1   |  2   |
	04 --- 05 --- 06 --- 07
	|  3   |  4   |  5   |
	08 --- 09 --- 10 --- 11
	|  6   |  7   |  8   |
	12 --- 13 --- 14 --- 15
	Z

	The quads exist before the column and row ends: row < rowCount - 1 and column < columnCount - 1
	quadIndex = row * (columnCount - 1) + column

	Quad origin index from quad index (needs row):
	index = quadIndex + row * columnCount

	Triangle index is related to the quad index
	triangleIndex = 2 * quadIndex + (0/1)
	quadIndex = triangleIndex / 2

	Row and column from quad index:
	row = quadIndex / (columnCount - 1)
	column = quadIndex - row * (columnCount - 1)

	The triangle diagonal is fixed.

	triangle0 = {00, 04, 01} -> {11, 21, 12}
	triangle1 = {04, 05, 01} -> {22, 12, 21}

	11      12
	00 ---- 01
	|     / |
	| 0 / 1 | 1
	| /     |
	04 ---- 05
	21     22

	For adjacency we have

	   NA
	   00 ---- 01 ---- 02
	   |     / |     / |
	NA | 0 / 1 | 2 / 3 |
	   | /     | /     |
	   04 ---- 05 ---- 06
	   |     / |     / |
	NA | 6 / 7 | 8 / 9 |
	   | /     | /     |
	   08 ---- 09 ---- 10

	   0: NA, NA, 1
	   1: 0, 6, 2

	Triangle layouts

	   11  3  12
	   1 ----  3
	   |     /
	 1 | 0 / 2
	   | /
	   2
	   21

			  12
			  2
			/ |
		2 / 1 | 1
		/     |
	   3 ---- 1
	   21  3  22
 */
b3HeightFieldData* b3CreateHeightField(b3HeightFieldDef* data) {
    i32 columnCount = data.countX;
    i32 rowCount = data.countZ;
    i32 heightCount = columnCount * rowCount;
    i32 cellCount = (columnCount - 1) * (rowCount - 1);
    i32 triangleCount = 2 * cellCount;
    u64 byteCount = b3AlignUp8(cast(u64, sizeof(b3HeightFieldData)));
    var heightsOffset = cast(i32, byteCount);
    byteCount += b3AlignUp8(cast(u64, heightCount * sizeof(u16)));
    var materialOffset = cast(i32, byteCount);
    byteCount += b3AlignUp8(cast(u64, cellCount * sizeof(u8)));
    var flagsOffset = cast(i32, byteCount);
    byteCount += b3AlignUp8(cast(u64, triangleCount * sizeof(u8)));
    var hf = cast(b3HeightFieldData*, b3Alloc(byteCount));
    memset(hf, 0, byteCount);
    hf.version = 0x8B18CBD138A6BC84;
    hf.byteCount = cast(i32, byteCount);
    hf.scale = data.scale;
    hf.columnCount = columnCount;
    hf.rowCount = rowCount;
    hf.heightsOffset = heightsOffset;
    hf.materialOffset = materialOffset;
    hf.flagsOffset = flagsOffset;
    hf.clockwise = data.clockwiseWinding;
    var compressedHeights = cast(u16*, cast(i64, hf) + heightsOffset);
    var materialIndices = cast(u8*, cast(i64, hf) + materialOffset);
    var flags = cast(u8*, cast(i64, hf) + flagsOffset);
    f32* heights = data.heights;
    hf.minHeight = data.globalMinimumHeight;
    hf.maxHeight = data.globalMaximumHeight;
    f32 height = b3MaxFloat(hf.maxHeight - hf.minHeight, 0.005f * b3GetLengthUnitsPerMeter());
    hf.heightScale = height / 65535.0f;
    f32 lowerHeightBound = hf.maxHeight;
    f32 upperHeightBound = hf.minHeight;
    f32 invHeightScale = 1.0f / hf.heightScale;
    for i32 i = 0; i < heightCount; ++i {
        f32 clampedHeight = b3ClampFloat(heights[i], hf.minHeight, hf.maxHeight);
        f32 scaledHeight = (clampedHeight - hf.minHeight) * invHeightScale;
        compressedHeights[i] = cast(u16, b3MinFloat(scaledHeight, cast(f32, 65535)));
        lowerHeightBound = b3MinFloat(lowerHeightBound, clampedHeight);
        upperHeightBound = b3MaxFloat(upperHeightBound, clampedHeight);
    }
    var decompressedHeights = cast(f32*, b3Alloc(cast(u64, heightCount * sizeof(f32))));
    for i32 i = 0; i < heightCount; ++i {
        decompressedHeights[i] = hf.minHeight + hf.heightScale * cast(f32, compressedHeights[i]);
    }
    heights = decompressedHeights;
    if data.materialIndices != null {
        for i32 i = 0; i < cellCount; ++i {
            materialIndices[i] = data.materialIndices[i];
        }
    } else {
        for i32 i = 0; i < cellCount; ++i {
            materialIndices[i] = 0;
        }
    }
    hf.aabb.lowerBound = b3Vec3{0.0f, hf.scale.y * lowerHeightBound, 0.0f};
    hf.aabb.upperBound = b3Vec3{
        hf.scale.x * cast(f32, hf.columnCount - 1), hf.scale.y * upperHeightBound,
        hf.scale.z * cast(f32, hf.rowCount - 1),
    };
    f32 cos5Deg = 0.9962f;
    b3Vec3 scale = hf.scale;
    i32 triangleIndex = 0;
    for i32 row = 0; row < rowCount - 1; ++row {
        for i32 column = 0; column < columnCount - 1; ++column {
            i32 triangleIndex1 = triangleIndex;
            i32 triangleIndex2 = triangleIndex + 1;
            triangleIndex += 2;
            i32 cellIndex = row * (columnCount - 1) + column;
            if materialIndices[cellIndex] == 0xFF {
                continue;
            }
            i32 flags1 = 0;
            i32 flags2 = 0;
            noinit b3Plane plane1;
            noinit b3Plane plane2;
            noinit b3Vec3 center1;
            noinit b3Vec3 center2;
            i32 index11 = row * columnCount + column;
            i32 index12 = index11 + 1;
            i32 index21 = (row + 1) * columnCount + column;
            i32 index22 = index21 + 1;
            {
                f32 height11 = heights[index11];
                f32 height12 = heights[index12];
                f32 height21 = heights[index21];
                f32 height22 = heights[index22];
                var x1 = cast(f32, column);
                var x2 = cast(f32, column + 1);
                var z1 = cast(f32, row);
                var z2 = cast(f32, row + 1);
                noinit b3Vec3[3] vs0;
                vs0[0] = b3Mul(scale, b3Vec3{x1, height11, z1});
                vs0[1] = b3Mul(scale, b3Vec3{x1, height21, z2});
                vs0[2] = b3Mul(scale, b3Vec3{x2, height12, z1});
                plane1 = b3MakePlaneFromPoints(vs0[0], vs0[1], vs0[2]);
                center1 = b3MulSV(1.0f / 3.0f, b3Add(b3Add(vs0[0], vs0[1]), vs0[2]));
                noinit b3Vec3[3] vs1;
                vs1[0] = b3Mul(scale, b3Vec3{x2, height22, z2});
                vs1[1] = b3Mul(scale, b3Vec3{x2, height12, z1});
                vs1[2] = b3Mul(scale, b3Vec3{x1, height21, z2});
                plane2 = b3MakePlaneFromPoints(vs1[0], vs1[1], vs1[2]);
                center2 = b3MulSV(1.0f / 3.0f, b3Add(b3Add(vs1[0], vs1[1]), vs1[2]));
                f32 separation = b3PlaneSeparation(plane1, vs1[0]);
                f32 cosAngle = b3Dot(plane1.normal, plane2.normal);
                if separation > 0.0f || cosAngle > cos5Deg {
                    flags1 |= b3_concaveEdge2;
                    flags2 |= b3_concaveEdge2;
                }
                if separation < 0.0f || cosAngle > cos5Deg {
                    flags1 |= b3_inverseConcaveEdge2;
                    flags2 |= b3_inverseConcaveEdge2;
                }
            }
            ignore center1;
            ignore center2;
            i32 topCellIndex = (row - 1) * (columnCount - 1) + column;
            if row > 0 && materialIndices[topCellIndex] != 0xFF {
                i32 r = row - 1;
                i32 c = column;
                i32 i11 = r * columnCount + c;
                i32 i12 = i11 + 1;
                i32 i21 = (r + 1) * columnCount + c;
                i32 i22 = i21 + 1;
                f32 h12 = heights[i12];
                f32 h21 = heights[i21];
                f32 h22 = heights[i22];
                var x1 = cast(f32, c);
                var x2 = cast(f32, c + 1);
                var z1 = cast(f32, r);
                var z2 = cast(f32, r + 1);
                noinit b3Vec3[3] vs;
                vs[0] = b3Mul(scale, b3Vec3{x2, h22, z2});
                vs[1] = b3Mul(scale, b3Vec3{x2, h12, z1});
                vs[2] = b3Mul(scale, b3Vec3{x1, h21, z2});
                b3Vec3 n = b3Normalize(b3Cross(b3Sub(vs[1], vs[0]), b3Sub(vs[2], vs[0])));
                f32 separation = b3PlaneSeparation(plane1, vs[1]);
                f32 cosAngle = b3Dot(plane1.normal, n);
                if separation > 0.0f || cosAngle > cos5Deg {
                    flags1 |= b3_concaveEdge3;
                }
                if separation < 0.0f || cosAngle > cos5Deg {
                    flags1 |= b3_inverseConcaveEdge3;
                }
            }
            i32 bottomCellIndex = (row + 1) * (columnCount - 1) + column;
            if row + 1 < rowCount - 1 && materialIndices[bottomCellIndex] != 0xFF {
                i32 r = row + 1;
                i32 c = column;
                i32 i11 = r * columnCount + c;
                i32 i12 = i11 + 1;
                i32 i21 = (r + 1) * columnCount + c;
                f32 h11 = heights[i11];
                f32 h12 = heights[i12];
                f32 h21 = heights[i21];
                var x1 = cast(f32, c);
                var x2 = cast(f32, c + 1);
                var z1 = cast(f32, r);
                var z2 = cast(f32, r + 1);
                noinit b3Vec3[3] vs;
                vs[0] = b3Mul(scale, b3Vec3{x1, h11, z1});
                vs[1] = b3Mul(scale, b3Vec3{x1, h21, z2});
                vs[2] = b3Mul(scale, b3Vec3{x2, h12, z1});
                b3Vec3 n = b3Normalize(b3Cross(b3Sub(vs[1], vs[0]), b3Sub(vs[2], vs[0])));
                f32 separation = b3PlaneSeparation(plane2, vs[1]);
                f32 cosAngle = b3Dot(plane2.normal, n);
                if separation > 0.0f || cosAngle > cos5Deg {
                    flags2 |= b3_concaveEdge3;
                }
                if separation < 0.0f || cosAngle > cos5Deg {
                    flags2 |= b3_inverseConcaveEdge3;
                }
            }
            i32 leftCellIndex = row * (columnCount - 1) + column - 1;
            if column - 1 >= 0 && materialIndices[leftCellIndex] != 0xFF {
                i32 r = row;
                i32 c = column - 1;
                i32 i11 = r * columnCount + c;
                i32 i12 = i11 + 1;
                i32 i21 = (r + 1) * columnCount + c;
                i32 i22 = i21 + 1;
                f32 h12 = heights[i12];
                f32 h21 = heights[i21];
                f32 h22 = heights[i22];
                var x1 = cast(f32, c);
                var x2 = cast(f32, c + 1);
                var z1 = cast(f32, r);
                var z2 = cast(f32, r + 1);
                noinit b3Vec3[3] vs;
                vs[0] = b3Mul(scale, b3Vec3{x2, h22, z2});
                vs[1] = b3Mul(scale, b3Vec3{x2, h12, z1});
                vs[2] = b3Mul(scale, b3Vec3{x1, h21, z2});
                b3Vec3 n = b3Normalize(b3Cross(b3Sub(vs[1], vs[0]), b3Sub(vs[2], vs[0])));
                f32 separation = b3PlaneSeparation(plane1, vs[2]);
                f32 cosAngle = b3Dot(plane1.normal, n);
                if separation > 0.0f || cosAngle > cos5Deg {
                    flags1 |= b3_concaveEdge1;
                }
                if separation < 0.0f || cosAngle > cos5Deg {
                    flags1 |= b3_inverseConcaveEdge1;
                }
            }
            i32 rightCellIndex = row * (columnCount - 1) + column + 1;
            if column + 1 < columnCount - 1 && materialIndices[rightCellIndex] != 0xFF {
                i32 r = row;
                i32 c = column + 1;
                i32 i11 = r * columnCount + c;
                i32 i12 = i11 + 1;
                i32 i21 = (r + 1) * columnCount + c;
                f32 h11 = heights[i11];
                f32 h12 = heights[i12];
                f32 h21 = heights[i21];
                var x1 = cast(f32, c);
                var x2 = cast(f32, c + 1);
                var z1 = cast(f32, r);
                var z2 = cast(f32, r + 1);
                noinit b3Vec3[3] vs;
                vs[0] = b3Mul(scale, b3Vec3{x1, h11, z1});
                vs[1] = b3Mul(scale, b3Vec3{x1, h21, z2});
                vs[2] = b3Mul(scale, b3Vec3{x2, h12, z1});
                b3Vec3 n = b3Normalize(b3Cross(b3Sub(vs[1], vs[0]), b3Sub(vs[2], vs[0])));
                f32 separation = b3PlaneSeparation(plane2, vs[2]);
                f32 cosAngle = b3Dot(plane2.normal, n);
                if separation > 0.0f || cosAngle > cos5Deg {
                    flags2 |= b3_concaveEdge1;
                }
                if separation < 0.0f || cosAngle > cos5Deg {
                    flags2 |= b3_inverseConcaveEdge1;
                }
            }
            flags[triangleIndex1] = cast(u8, flags1);
            flags[triangleIndex2] = cast(u8, flags2);
        }
    }
    b3Free(decompressedHeights, cast(u64, heightCount * sizeof(f32)));
    hf.hash = 0;
    hf.hash = b3NonZeroHash(b3Hash(5381, cast(u8*, hf), hf.byteCount));
    return hf;
}

// Decode the four corner vertices of a height field cell into local space.
// Output order matches the index naming used throughout this file:
// corners[0] = (column, row), corners[1] = (column + 1, row),
// corners[2] = (column, row + 1), corners[3] = (column + 1, row + 1).
private {
void b3GetHeightFieldCellCorners(b3HeightFieldData* hf, i32 row, i32 column, b3Vec3* corners) {
    i32 columnCount = hf.columnCount;
    i32 index11 = row * columnCount + column;
    i32 index12 = index11 + 1;
    i32 index21 = (row + 1) * columnCount + column;
    i32 index22 = index21 + 1;
    f32 minHeight = hf.minHeight;
    f32 heightScale = hf.heightScale;
    u16* heights = b3GetHeightFieldCompressedHeights(hf);
    f32 height11 = minHeight + heightScale * cast(f32, heights[index11]);
    f32 height12 = minHeight + heightScale * cast(f32, heights[index12]);
    f32 height21 = minHeight + heightScale * cast(f32, heights[index21]);
    f32 height22 = minHeight + heightScale * cast(f32, heights[index22]);
    var x1 = cast(f32, column);
    var x2 = cast(f32, column + 1);
    var z1 = cast(f32, row);
    var z2 = cast(f32, row + 1);
    b3Vec3 scale = hf.scale;
    corners[0] = b3Mul(scale, b3Vec3{x1, height11, z1});
    corners[1] = b3Mul(scale, b3Vec3{x2, height12, z1});
    corners[2] = b3Mul(scale, b3Vec3{x1, height21, z2});
    corners[3] = b3Mul(scale, b3Vec3{x2, height22, z2});
}
}

b3Triangle b3GetHeightFieldTriangle(b3HeightFieldData* heightField, i32 triangleIndex) {
    noinit b3Triangle triangle;
    triangle.flags = cast(i32, b3GetHeightFieldFlags(heightField)[triangleIndex]);
    i32 columnCount = heightField.columnCount;
    i32 quadIndex = triangleIndex >> 1;
    i32 row = quadIndex / (columnCount - 1);
    i32 column = quadIndex - row * (columnCount - 1);
    i32 index11 = row * columnCount + column;
    i32 index12 = index11 + 1;
    i32 index21 = (row + 1) * columnCount + column;
    i32 index22 = index21 + 1;
    i32 cellIndex = row * (columnCount - 1) + column;
    ignore cellIndex;
    noinit b3Vec3[4] corners;
    b3GetHeightFieldCellCorners(heightField, row, column, corners);
    if (triangleIndex & 1) == 0 {
        triangle.vertices[0] = corners[0];
        triangle.vertices[1] = corners[2];
        triangle.vertices[2] = corners[1];
        triangle.i1 = index11;
        triangle.i2 = index21;
        triangle.i3 = index12;
    } else {
        triangle.vertices[0] = corners[3];
        triangle.vertices[1] = corners[1];
        triangle.vertices[2] = corners[2];
        triangle.i1 = index22;
        triangle.i2 = index12;
        triangle.i3 = index21;
    }
    if heightField.clockwise != 0 {
        while true {
            noinit u8[sizeof(triangle.vertices[1])] B3_SWAP_TEMP;
            memcpy(B3_SWAP_TEMP, &triangle.vertices[1], cast(u64, sizeof(triangle.vertices[1])));
            memcpy(&triangle.vertices[1], &triangle.vertices[2], cast(u64, sizeof(triangle.vertices[1])));
            memcpy(&triangle.vertices[2], B3_SWAP_TEMP, cast(u64, sizeof(triangle.vertices[1])));
            if !(0 != 0) { break; }
        }
        while true {
            noinit u8[sizeof(triangle.i2)] B3_SWAP_TEMP;
            memcpy(B3_SWAP_TEMP, &triangle.i2, cast(u64, sizeof(triangle.i2)));
            memcpy(&triangle.i2, &triangle.i3, cast(u64, sizeof(triangle.i2)));
            memcpy(&triangle.i3, B3_SWAP_TEMP, cast(u64, sizeof(triangle.i2)));
            if !(0 != 0) { break; }
        }
        i32 flags = triangle.flags;
        i32 edge1Bits = flags & (b3_concaveEdge1 | b3_inverseConcaveEdge1);
        i32 edge3Bits = flags & (b3_concaveEdge3 | b3_inverseConcaveEdge3);
        flags &= ~(b3_concaveEdge1 | b3_concaveEdge3 | b3_inverseConcaveEdge1 | b3_inverseConcaveEdge3);
        flags |= edge1Bits << 2;
        flags |= edge3Bits >> 2;
        triangle.flags = flags;
    }
    return triangle;
}

i32 b3GetHeightFieldMaterial(b3HeightFieldData* heightField, i32 triangleIndex) {
    i32 cellIndex = triangleIndex >> 1;
    return cast(i32, b3GetHeightFieldMaterialIndices(heightField)[cellIndex]);
}

b3AABB b3ComputeHeightFieldAABB(b3HeightFieldData* shape, b3Transform transform) {
    return b3AABB_Transform(transform, shape.aabb);
}

b3CastOutput b3RayCastHeightField(b3HeightFieldData* heightField, b3RayCastInput* input) {
    b3ShapeCastInput shapeCastInput;
    shapeCastInput.proxy = b3ShapeProxy{&input.origin, 1, 0.0f};
    shapeCastInput.translation = input.translation;
    shapeCastInput.maxFraction = input.maxFraction;
    return b3ShapeCastHeightField(heightField, &shapeCastInput);
}

// todo advance cast to the grid border immediately if it starts outside the row/column range
// todo terminate the cast immediately if it leaves the row/column range
b3CastOutput b3ShapeCastHeightField(b3HeightFieldData* heightField, b3ShapeCastInput* input) {
    b3AABB shapeBounds = b3MakeAABB(input.proxy.points, input.proxy.count, input.proxy.radius);
    b3Vec3 shapeTranslation = input.translation;
    b3Vec3 scale = heightField.scale;
    b3Vec3 shapeStart = b3AABB_Center(shapeBounds);
    b3Vec3 shapeDelta = b3MulSV(input.maxFraction, shapeTranslation);
    b3Vec3 shapeEnd = b3Add(shapeStart, shapeDelta);
    b3CastOutput result;
    b3Vec3 shapeExtents = b3AABB_Extents(shapeBounds);
    var margin = b3Vec3{
        0.05f * b3GetLengthUnitsPerMeter(), 0.05f * b3GetLengthUnitsPerMeter(),
        0.05f * b3GetLengthUnitsPerMeter(),
    };
    var combinedBounds = b3AABB{
        b3Sub(b3Sub(heightField.aabb.lowerBound, shapeExtents), margin),
        b3Add(b3Add(heightField.aabb.upperBound, shapeExtents), margin),
    };
    f32 minFraction;
    f32 maxFraction;
    bool intersects = b3RayCastAABB(combinedBounds, shapeStart, shapeEnd, &minFraction, &maxFraction);
    if intersects == false {
        return result;
    }
    b3Vec3 clampedStart = b3MulAdd(shapeStart, minFraction, shapeDelta);
    b3Vec3 clampedDelta = b3MulSV(maxFraction - minFraction, shapeDelta);
    b3Vec3 clampedEnd = b3Add(clampedStart, clampedDelta);
    b3Vec3 centerStart = clampedStart;
    b3Vec3 centerEnd = clampedEnd;
    f32 signX;
    f32 signZ;
    if shapeTranslation.x >= 0.0f {
        clampedStart.x += shapeExtents.x;
        signX = 1.0f;
    } else {
        clampedStart.x -= shapeExtents.x;
        signX = -1.0f;
    }
    if shapeTranslation.z >= 0.0f {
        clampedStart.z += shapeExtents.z;
        signZ = 1.0f;
    } else {
        clampedStart.z -= shapeExtents.z;
        signZ = -1.0f;
    }
    clampedEnd = b3Add(clampedStart, clampedDelta);
    var columnStart = cast(i32, floorf(clampedStart.x / scale.x));
    var columnEnd = cast(i32, floorf(clampedEnd.x / scale.x));
    var rowStart = cast(i32, floorf(clampedStart.z / scale.z));
    var rowEnd = cast(i32, floorf(clampedEnd.z / scale.z));
    b3Vec3 absClampedDelta = b3Abs(clampedDelta);
    f32 deltaAlphaX;
    f32 nextFractionX;
    i32 deltaColumn;
    if columnStart < columnEnd {
        deltaAlphaX = scale.x / absClampedDelta.x;
        nextFractionX = (scale.x * cast(f32, columnStart + 1) - clampedStart.x) / absClampedDelta.x;
        deltaColumn = 1;
    } else if columnEnd < columnStart {
        deltaAlphaX = scale.x / absClampedDelta.x;
        nextFractionX = (clampedStart.x - scale.x * cast(f32, columnStart)) / absClampedDelta.x;
        deltaColumn = -1;
    } else {
        deltaAlphaX = 0.0f;
        nextFractionX = FLT_MAX;
        deltaColumn = 0;
    }
    f32 deltaAlphaZ;
    f32 nextFractionZ;
    i32 deltaRow;
    if rowStart < rowEnd {
        deltaAlphaZ = scale.z / absClampedDelta.z;
        nextFractionZ = (scale.z * cast(f32, rowStart + 1) - clampedStart.z) / absClampedDelta.z;
        deltaRow = 1;
    } else if rowEnd < rowStart {
        deltaAlphaZ = scale.z / absClampedDelta.z;
        nextFractionZ = (clampedStart.z - scale.z * cast(f32, rowStart)) / absClampedDelta.z;
        deltaRow = -1;
    } else {
        deltaAlphaZ = 0.0f;
        nextFractionZ = FLT_MAX;
        deltaRow = 0;
    }
    i32 boxColumnHead = columnStart;
    i32 boxRowHead = rowStart;
    var boxColumnTail = cast(i32, floorf((clampedStart.x - 2.0f * signX * shapeExtents.x) / scale.x));
    var boxRowTail = cast(i32, floorf((clampedStart.z - 2.0f * signZ * shapeExtents.z) / scale.z));
    f32 bestFraction = input.maxFraction;
    f32 gridFractionScale = input.maxFraction * (maxFraction - minFraction);
    f32 gridFractionOffset = input.maxFraction * minFraction;
    i32 rowCount = heightField.rowCount;
    i32 columnCount = heightField.columnCount;
    i32 cellCount = (heightField.rowCount - 1) * (heightField.columnCount - 1);
    ignore cellCount;
    b3ShapeCastPairInput pairInput;
    pairInput.proxyB = input.proxy;
    pairInput.transform = b3Transform_identity;
    pairInput.translationB = input.translation;
    pairInput.canEncroach = input.canEncroach;
    noinit b3AABB castBounds;
    castBounds.lowerBound = b3Sub(b3Min(centerStart, centerEnd), shapeExtents);
    castBounds.upperBound = b3Add(b3Max(centerStart, centerEnd), shapeExtents);
    b3V32 rayOrigin = b3LoadV(&shapeStart.x);
    b3V32 rayTranslation = b3LoadV(&shapeTranslation.x);
    while true {
        i32 column1;
        i32 column2;
        if boxColumnTail < boxColumnHead {
            column1 = boxColumnTail;
            column2 = boxColumnHead;
        } else {
            column1 = boxColumnHead;
            column2 = boxColumnTail;
        }
        i32 row1;
        i32 row2;
        if boxRowTail < boxRowHead {
            row1 = boxRowTail;
            row2 = boxRowHead;
        } else {
            row1 = boxRowHead;
            row2 = boxRowTail;
        }
        for i32 row = row1; row <= row2; ++row {
            if row < 0 || rowCount - 1 <= row {
                continue;
            }
            for i32 column = column1; column <= column2; ++column {
                if column < 0 || columnCount - 1 <= column {
                    continue;
                }
                i32 cellIndex = row * (columnCount - 1) + column;
                u8 materialIndex = b3GetHeightFieldMaterialIndices(heightField)[cellIndex];
                if materialIndex == 0xFF {
                    continue;
                }
                noinit b3Vec3[4] corners;
                b3GetHeightFieldCellCorners(heightField, row, column, corners);
                b3Vec3 point11 = corners[0];
                b3Vec3 point12 = corners[1];
                b3Vec3 point21 = corners[2];
                b3Vec3 point22 = corners[3];
                noinit b3AABB bounds;
                bounds.lowerBound = b3Min(b3Min(point11, point12), b3Min(point21, point22));
                bounds.upperBound = b3Max(b3Max(point11, point12), b3Max(point21, point22));
                if b3AABB_Overlaps(castBounds, bounds) == false {
                    continue;
                }
                i32 quadIndex = row * (columnCount - 1) + column;
                i32 triangleIndex1 = 2 * quadIndex;
                i32 triangleIndex2 = triangleIndex1 + 1;
                if input.proxy.count == 1 && input.proxy.radius == 0.0f {
                    {
                        b3V32 vertex1 = b3LoadV(&point11.x);
                        b3V32 vertex2;
                        b3V32 vertex3;
                        if heightField.clockwise != 0 {
                            vertex2 = b3LoadV(&point12.x);
                            vertex3 = b3LoadV(&point21.x);
                        } else {
                            vertex2 = b3LoadV(&point21.x);
                            vertex3 = b3LoadV(&point12.x);
                        }
                        f32 alpha = b3IntersectRayTriangle(rayOrigin, rayTranslation, vertex1, vertex2, vertex3);
                        if alpha < bestFraction {
                            b3Vec3 edge1 = b3Sub(point21, point11);
                            b3Vec3 edge2 = b3Sub(point12, point11);
                            b3Vec3 normal = heightField.clockwise != 0 ? b3Cross(edge2, edge1) : b3Cross(edge1, edge2);
                            result.point = b3MulAdd(shapeStart, alpha, shapeTranslation);
                            result.normal = b3Normalize(normal);
                            result.fraction = alpha;
                            result.triangleIndex = triangleIndex1;
                            result.materialIndex = cast(i32, materialIndex);
                            result.hit = true;
                            bestFraction = alpha;
                        }
                    }
                    {
                        b3V32 vertex1 = b3LoadV(&point22.x);
                        b3V32 vertex2;
                        b3V32 vertex3;
                        if heightField.clockwise != 0 {
                            vertex2 = b3LoadV(&point21.x);
                            vertex3 = b3LoadV(&point12.x);
                        } else {
                            vertex2 = b3LoadV(&point12.x);
                            vertex3 = b3LoadV(&point21.x);
                        }
                        f32 alpha = b3IntersectRayTriangle(rayOrigin, rayTranslation, vertex1, vertex2, vertex3);
                        if alpha < bestFraction {
                            b3Vec3 edge1 = b3Sub(point22, point21);
                            b3Vec3 edge2 = b3Sub(point12, point21);
                            b3Vec3 normal = heightField.clockwise != 0 ? b3Cross(edge2, edge1) : b3Cross(edge1, edge2);
                            result.point = b3MulAdd(shapeStart, alpha, shapeTranslation);
                            result.normal = b3Normalize(normal);
                            result.fraction = alpha;
                            result.triangleIndex = triangleIndex2;
                            result.materialIndex = cast(i32, materialIndex);
                            result.hit = true;
                            bestFraction = alpha;
                        }
                    }
                } else {
                    {
                        b3Vec3 origin = point11;
                        b3Vec3[3] triangleVertices = {
                            b3Vec3_zero, b3Sub(point21, origin), b3Sub(point12, origin),
                        };
                        pairInput.proxyA = b3ShapeProxy{triangleVertices, 3, 0.0f};
                        pairInput.maxFraction = bestFraction;
                        pairInput.transform.p = b3Neg(origin);
                        b3CastOutput pairOutput = b3ShapeCast(&pairInput);
                        if pairOutput.hit != 0 {
                            bestFraction = pairOutput.fraction;
                            result = pairOutput;
                            result.point = b3Add(result.point, origin);
                            result.triangleIndex = triangleIndex1;
                            result.materialIndex = cast(i32, materialIndex);
                        }
                    }
                    {
                        b3Vec3 origin = point21;
                        b3Vec3[3] triangleVertices = {
                            b3Vec3_zero, b3Sub(point22, origin), b3Sub(point12, origin),
                        };
                        pairInput.proxyA = b3ShapeProxy{triangleVertices, 3, 0.0f};
                        pairInput.maxFraction = bestFraction;
                        pairInput.transform.p = b3Neg(origin);
                        b3CastOutput pairOutput = b3ShapeCast(&pairInput);
                        if pairOutput.hit != 0 {
                            bestFraction = pairOutput.fraction;
                            result = pairOutput;
                            result.point = b3Add(result.point, origin);
                            result.triangleIndex = triangleIndex2;
                            result.materialIndex = cast(i32, materialIndex);
                        }
                    }
                }
            }
        }
        f32 inputFractionX = nextFractionX == FLT_MAX ? FLT_MAX : gridFractionOffset + nextFractionX * gridFractionScale;
        f32 inputFractionZ = nextFractionZ == FLT_MAX ? FLT_MAX : gridFractionOffset + nextFractionZ * gridFractionScale;
        if inputFractionX > bestFraction && inputFractionZ > bestFraction {
            break;
        }
        if nextFractionX <= nextFractionZ {
            if boxColumnHead == columnEnd {
                break;
            }
            boxColumnHead += deltaColumn;
            boxColumnTail = boxColumnHead;
            if shapeExtents.z == 0.0f {
                boxRowTail = boxRowHead;
            } else {
                f32 rowIntercept = clampedStart.z + nextFractionX * clampedDelta.z;
                boxRowTail = cast(i32, floorf((rowIntercept - 2.0f * signZ * shapeExtents.z) / scale.z));
            }
            nextFractionX += deltaAlphaX;
        } else {
            if boxRowHead == rowEnd {
                break;
            }
            boxRowHead += deltaRow;
            boxRowTail = boxRowHead;
            if shapeExtents.x == 0.0f {
                boxColumnTail = boxColumnHead;
            } else {
                f32 columnIntercept = clampedStart.x + nextFractionZ * clampedDelta.x;
                boxColumnTail = cast(i32, floorf((columnIntercept - 2.0f * signX * shapeExtents.x) / scale.x));
            }
            nextFractionZ += deltaAlphaZ;
        }
    }
    return result;
}

bool b3OverlapHeightField(b3HeightFieldData* shape, b3Transform shapeTransform, b3ShapeProxy* proxy) {
    noinit b3Vec3[64] buffer;
    b3ShapeProxy localProxy = b3MakeLocalProxy(proxy, shapeTransform, buffer);
    b3AABB aabb = b3ComputeProxyAABB(&localProxy);
    b3Vec3 scale = shape.scale;
    var minRow = cast(i32, floorf(aabb.lowerBound.z / scale.z));
    var maxRow = cast(i32, floorf(aabb.upperBound.z / scale.z));
    var minCol = cast(i32, floorf(aabb.lowerBound.x / scale.x));
    var maxCol = cast(i32, floorf(aabb.upperBound.x / scale.x));
    b3V32 boundsMin = b3LoadV(&aabb.lowerBound.x);
    b3V32 boundsMax = b3LoadV(&aabb.upperBound.x);
    b3V32 boundsCenter = b3MulV(b3_halfV, b3AddV(boundsMin, boundsMax));
    b3V32 boundsExtent = b3SubV(boundsMax, boundsCenter);
    noinit b3DistanceInput input;
    input.proxyB = localProxy;
    input.transform = b3Transform_identity;
    input.useRadii = true;
    b3SimplexCache cache;
    for i32 row = minRow; row <= maxRow; ++row {
        if row < 0 || shape.rowCount - 1 <= row {
            continue;
        }
        for i32 column = minCol; column <= maxCol; ++column {
            if column < 0 || shape.columnCount - 1 <= column {
                continue;
            }
            i32 cellIndex = row * (shape.columnCount - 1) + column;
            u8 material = b3GetHeightFieldMaterialIndices(shape)[cellIndex];
            if material == 0xFF {
                continue;
            }
            noinit b3Vec3[4] corners;
            b3GetHeightFieldCellCorners(shape, row, column, corners);
            b3Vec3 point11 = corners[0];
            b3Vec3 point12 = corners[1];
            b3Vec3 point21 = corners[2];
            b3Vec3 point22 = corners[3];
            b3V32 v11 = b3LoadV(&point11.x);
            b3V32 v12 = b3LoadV(&point12.x);
            b3V32 v21 = b3LoadV(&point21.x);
            b3V32 v22 = b3LoadV(&point22.x);
            if b3TestBoundsTriangleOverlap(boundsCenter, boundsExtent, v11, v21, v12) != 0 {
                b3Vec3[3] triangleVertices = {point11, point21, point12};
                input.proxyA = b3ShapeProxy{triangleVertices, 3, 0.0f};
                cache.count = 0;
                b3DistanceOutput output = b3ShapeDistance(&input, &cache, null, 0);
                f32 tolerance = 0.1f * (0.005f * b3GetLengthUnitsPerMeter());
                if output.distance < tolerance {
                    return true;
                }
            }
            if b3TestBoundsTriangleOverlap(boundsCenter, boundsExtent, v21, v22, v12) != 0 {
                b3Vec3[3] triangleVertices = {point22, point12, point21};
                input.proxyA = b3ShapeProxy{triangleVertices, 3, 0.0f};
                cache.count = 0;
                b3DistanceOutput output = b3ShapeDistance(&input, &cache, null, 0);
                f32 tolerance = 0.1f * (0.005f * b3GetLengthUnitsPerMeter());
                if output.distance < tolerance {
                    return true;
                }
            }
        }
    }
    return false;
}

void b3QueryHeightField(b3HeightFieldData* heightField, b3AABB bounds, b3MeshQueryFcn fcn, void* context) {
    b3Vec3 scale = heightField.scale;
    var minRow = cast(i32, floorf(bounds.lowerBound.z / scale.z));
    var maxRow = cast(i32, floorf(bounds.upperBound.z / scale.z));
    var minCol = cast(i32, floorf(bounds.lowerBound.x / scale.x));
    var maxCol = cast(i32, floorf(bounds.upperBound.x / scale.x));
    for i32 row = minRow; row <= maxRow; ++row {
        if row < 0 || heightField.rowCount - 1 <= row {
            continue;
        }
        for i32 column = minCol; column <= maxCol; ++column {
            if column < 0 || heightField.columnCount - 1 <= column {
                continue;
            }
            i32 cellIndex = row * (heightField.columnCount - 1) + column;
            u8 material = b3GetHeightFieldMaterialIndices(heightField)[cellIndex];
            if material == 0xFF {
                continue;
            }
            noinit b3Vec3[4] corners;
            b3GetHeightFieldCellCorners(heightField, row, column, corners);
            b3Vec3 point11 = corners[0];
            b3Vec3 point12 = corners[1];
            b3Vec3 point21 = corners[2];
            b3Vec3 point22 = corners[3];
            noinit b3AABB cellBound;
            cellBound.lowerBound = b3Min(b3Min(point11, point12), b3Min(point21, point22));
            cellBound.upperBound = b3Max(b3Max(point11, point12), b3Max(point21, point22));
            if b3AABB_Overlaps(bounds, cellBound) != 0 {
                i32 quadIndex = row * (heightField.columnCount - 1) + column;
                i32 triangleIndex = 2 * quadIndex;
                if heightField.clockwise != 0 {
                    fcn(point11, point12, point21, triangleIndex, context);
                    fcn(point22, point21, point12, triangleIndex + 1, context);
                } else {
                    fcn(point11, point21, point12, triangleIndex, context);
                    fcn(point22, point12, point21, triangleIndex + 1, context);
                }
            }
        }
    }
}

i32 b3CollideMoverAndHeightField(b3PlaneResult* planes, i32 capacity, b3HeightFieldData* shape, b3Capsule* mover) {
    b3DistanceInput distanceInput;
    distanceInput.proxyB = b3ShapeProxy{&mover.center1, 2, 0.0f};
    distanceInput.transform = b3Transform_identity;
    distanceInput.useRadii = false;
    b3SimplexCache cache;
    f32 radius = mover.radius;
    b3V32 center1 = b3LoadV(&mover.center1.x);
    b3V32 center2 = b3LoadV(&mover.center2.x);
    b3V32 r = b3SplatV(radius);
    b3V32 boundsMin = b3SubV(b3MinV(center1, center2), r);
    b3V32 boundsMax = b3AddV(b3MaxV(center1, center2), r);
    b3V32 boundsCenter = b3MulV(b3_halfV, b3AddV(boundsMin, boundsMax));
    b3V32 boundsExtent = b3SubV(boundsMax, boundsCenter);
    f32 localMinX = b3GetXV(boundsMin);
    f32 localMinZ = b3GetZV(boundsMin);
    f32 localMaxX = b3GetXV(boundsMax);
    f32 localMaxZ = b3GetZV(boundsMax);
    b3Vec3 scale = shape.scale;
    var minRow = cast(i32, floorf(localMinZ / scale.z));
    var maxRow = cast(i32, floorf(localMaxZ / scale.z));
    var minCol = cast(i32, floorf(localMinX / scale.x));
    var maxCol = cast(i32, floorf(localMaxX / scale.x));
    i32 planeCount = 0;
    for i32 row = minRow; row <= maxRow; ++row {
        if row < 0 || shape.rowCount - 1 <= row {
            continue;
        }
        for i32 column = minCol; column <= maxCol; ++column {
            if column < 0 || shape.columnCount - 1 <= column {
                continue;
            }
            i32 cellIndex = row * (shape.columnCount - 1) + column;
            u8 material = b3GetHeightFieldMaterialIndices(shape)[cellIndex];
            if material == 0xFF {
                continue;
            }
            noinit b3Vec3[4] corners;
            b3GetHeightFieldCellCorners(shape, row, column, corners);
            b3Vec3 point11 = corners[0];
            b3Vec3 point12 = corners[1];
            b3Vec3 point21 = corners[2];
            b3Vec3 point22 = corners[3];
            b3V32 v11 = b3LoadV(&point11.x);
            b3V32 v12 = b3LoadV(&point12.x);
            b3V32 v21 = b3LoadV(&point21.x);
            b3V32 v22 = b3LoadV(&point22.x);
            if b3TestBoundsTriangleOverlap(boundsCenter, boundsExtent, v11, v21, v12) != 0 {
                b3Vec3[3] triangleVertices = {point11, point21, point12};
                distanceInput.proxyA = b3ShapeProxy{triangleVertices, 3, 0.0f};
                cache.count = 0;
                b3DistanceOutput distanceOutput = b3ShapeDistance(&distanceInput, &cache, null, 0);
                if distanceOutput.distance == 0.0f {
                } else if distanceOutput.distance <= mover.radius {
                    var plane = b3Plane{
                        distanceOutput.normal, mover.radius - distanceOutput.distance,
                    };
                    planes[planeCount] = b3PlaneResult{plane, distanceOutput.pointA};
                    planeCount += 1;
                    if planeCount == capacity {
                        return planeCount;
                    }
                }
            }
            if b3TestBoundsTriangleOverlap(boundsCenter, boundsExtent, v21, v22, v12) != 0 {
                b3Vec3[3] triangleVertices = {point22, point12, point21};
                distanceInput.proxyA = b3ShapeProxy{triangleVertices, 3, 0.0f};
                cache.count = 0;
                b3DistanceOutput distanceOutput = b3ShapeDistance(&distanceInput, &cache, null, 0);
                if distanceOutput.distance == 0.0f {
                } else if distanceOutput.distance <= mover.radius {
                    var plane = b3Plane{
                        distanceOutput.normal, mover.radius - distanceOutput.distance,
                    };
                    planes[planeCount] = b3PlaneResult{plane, distanceOutput.pointA};
                    planeCount += 1;
                    if planeCount == capacity {
                        return planeCount;
                    }
                }
            }
        }
    }
    return planeCount;
}

b3HeightFieldData* b3CreateGrid(i32 rowCount, i32 columnCount, b3Vec3 scale, bool makeHoles) {
    i32 heightCount = rowCount * columnCount;
    var heights = cast(f32*, b3Alloc(cast(u64, heightCount * sizeof(f32))));
    for i32 i = 0; i < rowCount; ++i {
        for i32 j = 0; j < columnCount; ++j {
            i32 k = i * columnCount + j;
            heights[k] = 0.0f;
        }
    }
    i32 cellCount = (rowCount - 1) * (columnCount - 1);
    var materialIndices = cast(u8*, b3Alloc(cast(u64, cellCount * sizeof(u8))));
    for i32 i = 0; i < rowCount - 1; ++i {
        for i32 j = 0; j < columnCount - 1; ++j {
            i32 k = i * (columnCount - 1) + j;
            if makeHoles && k > 0 && k % 16 == 0 {
                materialIndices[k] = 0xFF;
            } else {
                materialIndices[k] = 0;
            }
        }
    }
    b3HeightFieldDef data;
    data.heights = heights;
    data.materialIndices = materialIndices;
    data.scale = scale;
    data.countX = columnCount;
    data.countZ = rowCount;
    data.globalMinimumHeight = -256.0f;
    data.globalMaximumHeight = 256.0f;
    data.clockwiseWinding = false;
    b3HeightFieldData* heightField = b3CreateHeightField(&data);
    b3Free(heights, cast(u64, heightCount * sizeof(f32)));
    b3Free(materialIndices, cast(u64, cellCount * sizeof(u8)));
    return heightField;
}

b3HeightFieldData* b3CreateWave(i32 rowCount, i32 columnCount, b3Vec3 scale, f32 rowFrequency, f32 columnFrequency, bool makeHoles) {
    i32 heightCount = rowCount * columnCount;
    var heights = cast(f32*, b3Alloc(cast(u64, heightCount * sizeof(f32))));
    f32 omegaZ = 2.0f * 3.14159265359f * rowFrequency;
    f32 omegaX = 2.0f * 3.14159265359f * columnFrequency;
    b3CosSin cs;
    for i32 i = 0; i < rowCount; ++i {
        cs = b3ComputeCosSin(omegaZ * cast(f32, i));
        f32 rowHeight = cs.sine;
        for i32 j = 0; j < columnCount; ++j {
            i32 k = i * columnCount + j;
            cs = b3ComputeCosSin(omegaX * cast(f32, j));
            f32 columnHeight = cs.sine;
            heights[k] = rowHeight * columnHeight;
        }
    }
    i32 cellCount = (rowCount - 1) * (columnCount - 1);
    var materialIndices = cast(u8*, b3Alloc(cast(u64, cellCount * sizeof(u8))));
    for i32 i = 0; i < rowCount - 1; ++i {
        for i32 j = 0; j < columnCount - 1; ++j {
            i32 k = i * (columnCount - 1) + j;
            if makeHoles && k > 0 && k % 16 == 0 {
                materialIndices[k] = 0xFF;
            } else {
                materialIndices[k] = 0;
            }
        }
    }
    b3HeightFieldDef data;
    data.heights = heights;
    data.materialIndices = materialIndices;
    data.scale = scale;
    data.countX = columnCount;
    data.countZ = rowCount;
    data.globalMinimumHeight = -256.0f;
    data.globalMaximumHeight = 256.0f;
    data.clockwiseWinding = false;
    b3HeightFieldData* heightField = b3CreateHeightField(&data);
    b3Free(heights, cast(u64, heightCount * sizeof(f32)));
    b3Free(materialIndices, cast(u64, cellCount * sizeof(u8)));
    return heightField;
}

void b3DestroyHeightField(b3HeightFieldData* heightField) {
    b3Free(heightField, cast(u64, heightField.byteCount));
}

void b3DumpHeightData(b3HeightFieldDef* data, u8* fileName) {
    void* file = null;
    errno_t e = fopen_s(&file, fileName, "w");
    if e != 0 {
        return;
    }
    __b3_fprintf(file, "%d %d\n", data.countX, data.countZ);
    __b3_fprintf(file, "%.9f %.9f %.9f\n", data.scale.x, data.scale.y, data.scale.z);
    __b3_fprintf(file, "%.9f %.9f\n", data.globalMinimumHeight, data.globalMaximumHeight);
    __b3_fprintf(file, "%d\n", data.clockwiseWinding);
    i32 heightCount = data.countX * data.countZ;
    for i32 i = 0; i < heightCount; ++i {
        __b3_fprintf(file, "%.9f\n", data.heights[i]);
    }
    i32 materialCount = (data.countX - 1) * (data.countZ - 1);
    for i32 i = 0; i < materialCount; ++i {
        __b3_fprintf(file, "%d\n", data.materialIndices[i]);
    }
    __b3_fclose(file);
}

b3HeightFieldData* b3LoadHeightField(u8* fileName) {
    void* file = null;
    errno_t e = fopen_s(&file, fileName, "r");
    if e != 0 {
        return null;
    }
    b3HeightFieldDef data;
    if fscanf_s(file, "%d %d", &data.countX, &data.countZ) != 2 {
        __b3_fclose(file);
        return null;
    }
    if fscanf_s(file, "%f %f %f", &data.scale.x, &data.scale.y, &data.scale.z) != 3 {
        __b3_fclose(file);
        return null;
    }
    if fscanf_s(file, "%f %f", &data.globalMinimumHeight, &data.globalMaximumHeight) != 2 {
        __b3_fclose(file);
        return null;
    }
    i32 clockwise;
    if fscanf_s(file, "%d", &clockwise) != 1 {
        __b3_fclose(file);
        return null;
    }
    data.clockwiseWinding = clockwise != 0;
    i32 heightCount = data.countX * data.countZ;
    data.heights = cast(f32*, b3Alloc(cast(u64, heightCount * sizeof(f32))));
    for i32 i = 0; i < heightCount; ++i {
        if fscanf_s(file, "%f", &data.heights[i]) != 1 {
            b3Free(data.heights, cast(u64, heightCount * sizeof(f32)));
            __b3_fclose(file);
            return null;
        }
    }
    i32 materialCount = (data.countX - 1) * (data.countZ - 1);
    data.materialIndices = cast(u8*, b3Alloc(cast(u64, materialCount * sizeof(u8))));
    for i32 i = 0; i < materialCount; ++i {
        i32 materialIndex;
        if fscanf_s(file, "%d", &materialIndex) != 1 {
            b3Free(data.heights, cast(u64, heightCount * sizeof(f32)));
            b3Free(data.materialIndices, cast(u64, materialCount * sizeof(u8)));
            __b3_fclose(file);
            return null;
        }
        data.materialIndices[i] = cast(u8, materialIndex);
    }
    __b3_fclose(file);
    b3HeightFieldData* heightField = b3CreateHeightField(&data);
    b3Free(data.heights, cast(u64, heightCount * sizeof(f32)));
    b3Free(data.materialIndices, cast(u64, materialCount * sizeof(u8)));
    return heightField;
}

private {
void b3QHList_Init(b3QHListNode* head) {
    head.prev = head;
    head.next = head;
}

bool b3QHList_Contains(b3QHListNode* node) {
    return node.prev != null && node.next != null;
}

// Insert node before `where`.
void b3QHList_Insert(b3QHListNode* node, b3QHListNode* where) {
    node.prev = where.prev;
    node.next = where;
    node.prev.next = node;
    node.next.prev = node;
}

void b3QHList_Remove(b3QHListNode* node) {
    node.prev.next = node.next;
    node.next.prev = node.prev;
    node.prev = null;
    node.next = null;
}

void b3QHList_PushBack(b3QHListNode* head, b3QHListNode* node) {
    b3QHList_Insert(node, head.prev);
}

b3QHVertex* b3HullBuilder_NewVertex(b3HullBuilder* b, b3Vec3 position) {
    b3QHVertex* vertex = b.vertexBase + b.vertexCount++;
    vertex.link.prev = null;
    vertex.link.next = null;
    vertex.conflictFace = null;
    vertex.position = position;
    vertex.finalIndex = -1;
    vertex.reachable = false;
    return vertex;
}

b3QHHalfEdge* b3HullBuilder_NewEdge(b3HullBuilder* b) {
    b3QHHalfEdge* edge;
    if b.edgeFreeHead != null {
        edge = b.edgeFreeHead;
        b.edgeFreeHead = edge.next;
    } else {
        edge = b.edgeBase + b.edgeCount++;
    }
    edge.finalIndex = -1;
    return edge;
}

void b3HullBuilder_RetireEdge(b3HullBuilder* b, b3QHHalfEdge* edge) {
    edge.next = b.edgeFreeHead;
    b.edgeFreeHead = edge;
}

b3QHFace* b3HullBuilder_NewFace(b3HullBuilder* b, b3QHVertex* v1, b3QHVertex* v2, b3QHVertex* v3) {
    b3QHFace* face;
    if b.faceFreeHead != null {
        face = b.faceFreeHead;
        b.faceFreeHead = cast(b3QHFace*, face.link.next);
    } else {
        face = b.faceBase + b.faceCount++;
    }
    face.link.prev = null;
    face.link.next = null;
    face.maxConflict = null;
    face.maxConflictDistance = 0.0f;
    face.finalIndex = -1;
    b3QHHalfEdge* edge1 = b3HullBuilder_NewEdge(b);
    b3QHHalfEdge* edge2 = b3HullBuilder_NewEdge(b);
    b3QHHalfEdge* edge3 = b3HullBuilder_NewEdge(b);
    b3Vec3 p1 = v1.position;
    b3Vec3 p2 = v2.position;
    b3Vec3 p3 = v3.position;
    noinit b3Plane plane;
    plane.normal = b3Cross(b3Sub(p2, p1), b3Sub(p3, p1));
    f32 length;
    plane.normal = b3GetLengthAndNormalize(&length, plane.normal);
    plane.offset = b3Dot(plane.normal, p1);
    f32 area = 0.5f * length;
    face.edge = edge1;
    face.mark = 0;
    face.area = area;
    face.centroid = b3MulSV(1.0f / 3.0f, b3Add(v1.position, b3Add(v2.position, v3.position)));
    face.plane = plane;
    face.flipped = b3PlaneSeparation(plane, b.interiorPoint) > 0.0f;
    b3QHList_Init(&face.conflictListHead.link);
    edge1.prev = edge3;
    edge1.next = edge2;
    edge1.origin = v1;
    edge1.face = face;
    edge1.twin = null;
    edge2.prev = edge1;
    edge2.next = edge3;
    edge2.origin = v2;
    edge2.face = face;
    edge2.twin = null;
    edge3.prev = edge2;
    edge3.next = edge1;
    edge3.origin = v3;
    edge3.face = face;
    edge3.twin = null;
    return face;
}

// Remove face from faceList if still linked, clear its edge pointer, then push onto faceFreeHead.
// Uses face->link.next as the free-list next pointer (link.prev stays NULL, so b3QHList_Contains
// returns false on a free slot, as required by the retire-guard in ResolveFaces).
void b3HullBuilder_RetireFace(b3HullBuilder* b, b3QHFace* face) {
    if b3QHList_Contains(&face.link) != 0 {
        b3QHList_Remove(&face.link);
    }
    face.edge = null;
    face.link.next = cast(b3QHListNode*, b.faceFreeHead);
    b.faceFreeHead = face;
}

b3AABB b3BuildBounds(i32 vertexCount, b3Vec3* vertices) {
    b3AABB bounds = B3_BOUNDS3_EMPTY;
    for i32 i = 0; i < vertexCount; ++i {
        bounds.lowerBound = b3Min(bounds.lowerBound, vertices[i]);
        bounds.upperBound = b3Max(bounds.upperBound, vertices[i]);
    }
    return bounds;
}

void b3FindFarthestPointsAlongCardinalAxes(i32* index1Out, i32* index2Out, f32 tolerance, i32 vertexCount, b3Vec3* vertexBase) {
    *index1Out = -1;
    *index2Out = -1;
    b3Vec3 v0 = vertexBase[0];
    b3Vec3[3] minPt = {v0, v0, v0};
    b3Vec3[3] maxPt = {v0, v0, v0};
    i32[3] minIndex = {0, 0, 0};
    i32[3] maxIndex = {0, 0, 0};
    for i32 i = 1; i < vertexCount; ++i {
        b3Vec3 v = vertexBase[i];
        if v.x < minPt[0].x {
            minPt[0] = v;
            minIndex[0] = i;
        } else if v.x > maxPt[0].x {
            maxPt[0] = v;
            maxIndex[0] = i;
        }
        if v.y < minPt[1].y {
            minPt[1] = v;
            minIndex[1] = i;
        } else if v.y > maxPt[1].y {
            maxPt[1] = v;
            maxIndex[1] = i;
        }
        if v.z < minPt[2].z {
            minPt[2] = v;
            minIndex[2] = i;
        } else if v.z > maxPt[2].z {
            maxPt[2] = v;
            maxIndex[2] = i;
        }
    }
    noinit b3Vec3 distance;
    distance.x = maxPt[0].x - minPt[0].x;
    distance.y = maxPt[1].y - minPt[1].y;
    distance.z = maxPt[2].z - minPt[2].z;
    f32[3] distanceArray = {distance.x, distance.y, distance.z};
    i32 maxElement = b3MaxElementIndex(distance);
    if distanceArray[maxElement] > 2.0f * tolerance {
        *index1Out = minIndex[maxElement];
        *index2Out = maxIndex[maxElement];
    }
}

i32 b3FindFarthestPointFromLine(i32 index1, i32 index2, f32 tolerance, i32 vertexCount, b3Vec3* vertexBase) {
    b3Vec3 a = vertexBase[index1];
    b3Vec3 b = vertexBase[index2];
    b3Vec3 ab = b3Sub(b, a);
    f32 abLengthSqr = b3Dot(ab, ab);
    f32 invAbLengthSqr = 1.0f / abLengthSqr;
    f32 maxDistanceSqr = 4.0f * tolerance * tolerance;
    i32 maxIndex = -1;
    for i32 i = 0; i < vertexCount; ++i {
        if i == index1 || i == index2 {
            continue;
        }
        b3Vec3 ap = b3Sub(vertexBase[i], a);
        b3Vec3 cross = b3Cross(ap, ab);
        f32 distanceSqr = b3Dot(cross, cross) * invAbLengthSqr;
        if distanceSqr > maxDistanceSqr {
            maxDistanceSqr = distanceSqr;
            maxIndex = i;
        }
    }
    return maxIndex;
}

i32 b3FindFarthestPointFromPlane(i32 index1, i32 index2, i32 index3, f32 tolerance, i32 vertexCount, b3Vec3* vertexBase) {
    b3Vec3 a = vertexBase[index1];
    b3Vec3 b = vertexBase[index2];
    b3Vec3 c = vertexBase[index3];
    b3Plane plane = b3MakePlaneFromPoints(a, b, c);
    f32 maxDistance = 2.0f * tolerance;
    i32 maxIndex = -1;
    for i32 i = 0; i < vertexCount; ++i {
        if i == index1 || i == index2 || i == index3 {
            continue;
        }
        f32 distance = b3AbsFloat(b3PlaneSeparation(plane, vertexBase[i]));
        if distance > maxDistance {
            maxDistance = distance;
            maxIndex = i;
        }
    }
    return maxIndex;
}

bool b3IsEdgeConvex(b3QHHalfEdge* edge, f32 tolerance) {
    f32 distance = b3PlaneSeparation(edge.face.plane, edge.twin.face.centroid);
    return distance < -tolerance;
}

bool b3IsEdgeConcave(b3QHHalfEdge* edge, f32 tolerance) {
    f32 distance = b3PlaneSeparation(edge.face.plane, edge.twin.face.centroid);
    return distance > tolerance;
}

i32 b3VertexCountOfFace(b3QHFace* face) {
    i32 count = 0;
    b3QHHalfEdge* edge = face.edge;
    while true {
        count++;
        edge = edge.next;
        if !(edge != face.edge) { break; }
    }
    return count;
}

void b3LinkFace(b3QHFace* face, i32 index, b3QHHalfEdge* twin) {
    b3QHHalfEdge* edge = face.edge;
    while index-- > 0 {
        edge = edge.next;
    }
    edge.twin = twin;
    twin.twin = edge;
}

void b3LinkFaces(b3QHFace* face1, i32 index1, b3QHFace* face2, i32 index2) {
    b3QHHalfEdge* edge1 = face1.edge;
    while index1-- > 0 {
        edge1 = edge1.next;
    }
    b3QHHalfEdge* edge2 = face2.edge;
    while index2-- > 0 {
        edge2 = edge2.next;
    }
    edge1.twin = edge2;
    edge2.twin = edge1;
}

void b3NewellPlane(b3QHFace* face) {
    i32 count = 0;
    b3Vec3 centroid = b3Vec3_zero;
    b3Vec3 normal = b3Vec3_zero;
    b3QHHalfEdge* edge = face.edge;
    b3Vec3 origin = edge.origin.position;
    while true {
        b3QHHalfEdge* twin = edge.twin;
        b3Vec3 v1 = b3Sub(edge.origin.position, origin);
        b3Vec3 v2 = b3Sub(twin.origin.position, origin);
        count++;
        centroid = b3Add(centroid, v1);
        normal.x += (v1.y - v2.y) * (v1.z + v2.z);
        normal.y += (v1.z - v2.z) * (v1.x + v2.x);
        normal.z += (v1.x - v2.x) * (v1.y + v2.y);
        edge = edge.next;
        if !(edge != face.edge) { break; }
    }
    centroid = b3MulSV(1.0f / cast(f32, count), centroid);
    centroid = b3Add(centroid, origin);
    f32 length = b3Length(normal);
    normal = b3MulSV(1.0f / length, normal);
    face.centroid = centroid;
    face.plane = b3MakePlaneFromNormalAndPoint(normal, centroid);
    face.area = 0.5f * length;
}

void b3HullBuilder_ComputeTolerance(b3HullBuilder* b, i32 pointCount, b3Vec3* points) {
    b3AABB bounds = b3BuildBounds(pointCount, points);
    b3Vec3 maxAbs = b3Max(b3Abs(bounds.lowerBound), b3Abs(bounds.upperBound));
    f32 maxSum = maxAbs.x + maxAbs.y + maxAbs.z;
    f32 maxCoord = b3MaxFloat(maxAbs.x, b3MaxFloat(maxAbs.y, maxAbs.z));
    f32 maxDistance = b3MinFloat(1.7320508079999999f * maxCoord, maxSum);
    f32 tolerance = (3.0f * maxDistance * 1.01f + maxCoord) * FLT_EPSILON;
    b.tolerance = tolerance;
    b.minRadius = 4.0f * b.tolerance;
    b.minOutside = 2.0f * b.minRadius;
}

bool b3HullBuilder_BuildInitialHull(b3HullBuilder* b, i32 pointCount, b3Vec3* points) {
    i32 index1;
    i32 index2;
    b3FindFarthestPointsAlongCardinalAxes(&index1, &index2, b.tolerance, pointCount, points);
    if index1 < 0 || index2 < 0 {
        return false;
    }
    i32 index3 = b3FindFarthestPointFromLine(index1, index2, b.tolerance, pointCount, points);
    if index3 < 0 {
        return false;
    }
    i32 index4 = b3FindFarthestPointFromPlane(index1, index2, index3, b.tolerance, pointCount, points);
    if index4 < 0 {
        return false;
    }
    b3Vec3 v1 = b3Sub(points[index1], points[index4]);
    b3Vec3 v2 = b3Sub(points[index2], points[index4]);
    b3Vec3 v3 = b3Sub(points[index3], points[index4]);
    if b3ScalarTripleProduct(v1, v2, v3) < 0.0f {
        i32 temp = index2;
        index2 = index3;
        index3 = temp;
    }
    b.interiorPoint = b3Vec3_zero;
    b.interiorPoint = b3Add(b.interiorPoint, points[index1]);
    b.interiorPoint = b3Add(b.interiorPoint, points[index2]);
    b.interiorPoint = b3Add(b.interiorPoint, points[index3]);
    b.interiorPoint = b3Add(b.interiorPoint, points[index4]);
    b.interiorPoint = b3MulSV(0.25f, b.interiorPoint);
    b3QHVertex* vertex1 = b3HullBuilder_NewVertex(b, points[index1]);
    b3QHList_PushBack(&b.vertexList.link, &vertex1.link);
    b3QHVertex* vertex2 = b3HullBuilder_NewVertex(b, points[index2]);
    b3QHList_PushBack(&b.vertexList.link, &vertex2.link);
    b3QHVertex* vertex3 = b3HullBuilder_NewVertex(b, points[index3]);
    b3QHList_PushBack(&b.vertexList.link, &vertex3.link);
    b3QHVertex* vertex4 = b3HullBuilder_NewVertex(b, points[index4]);
    b3QHList_PushBack(&b.vertexList.link, &vertex4.link);
    b3QHFace* face1 = b3HullBuilder_NewFace(b, vertex1, vertex2, vertex3);
    b3QHList_PushBack(&b.faceList.link, &face1.link);
    b3QHFace* face2 = b3HullBuilder_NewFace(b, vertex4, vertex2, vertex1);
    b3QHList_PushBack(&b.faceList.link, &face2.link);
    b3QHFace* face3 = b3HullBuilder_NewFace(b, vertex4, vertex3, vertex2);
    b3QHList_PushBack(&b.faceList.link, &face3.link);
    b3QHFace* face4 = b3HullBuilder_NewFace(b, vertex4, vertex1, vertex3);
    b3QHList_PushBack(&b.faceList.link, &face4.link);
    b3LinkFaces(face1, 0, face2, 1);
    b3LinkFaces(face1, 1, face3, 1);
    b3LinkFaces(face1, 2, face4, 1);
    b3LinkFaces(face2, 0, face3, 2);
    b3LinkFaces(face3, 0, face4, 2);
    b3LinkFaces(face4, 0, face2, 2);
    for i32 index = 0; index < pointCount; ++index {
        if index == index1 || index == index2 || index == index3 || index == index4 {
            continue;
        }
        b3Vec3 point = points[index];
        f32 maxDistance = b.minOutside;
        b3QHFace* maxFace = null;
        for b3QHListNode* node = b.faceList.link.next; node != &b.faceList.link; node = node.next {
            var face = cast(b3QHFace*, node);
            f32 distance = b3PlaneSeparation(face.plane, point);
            if distance > maxDistance {
                maxDistance = distance;
                maxFace = face;
            }
        }
        if maxFace != null {
            b3QHVertex* vertex = b3HullBuilder_NewVertex(b, point);
            vertex.conflictFace = maxFace;
            b3QHList_PushBack(&maxFace.conflictListHead.link, &vertex.link);
            if maxDistance > maxFace.maxConflictDistance {
                maxFace.maxConflictDistance = maxDistance;
                maxFace.maxConflict = vertex;
            }
        }
    }
    return true;
}

// Recompute the farthest-conflict cache after a face's plane changes.
// Walks the existing conflict list once; cost is bounded by that list, not the global pool.
void b3HullBuilder_RecacheConflicts(b3QHFace* face, f32 minOutside) {
    b3QHVertex* maxVertex = null;
    f32 maxDistance = minOutside;
    for b3QHListNode* node = face.conflictListHead.link.next; node != &face.conflictListHead.link; node = node.next {
        var vertex = cast(b3QHVertex*, node);
        f32 distance = b3PlaneSeparation(face.plane, vertex.position);
        if distance > maxDistance {
            maxDistance = distance;
            maxVertex = vertex;
        }
    }
    face.maxConflict = maxVertex;
    face.maxConflictDistance = maxDistance;
}

b3QHVertex* b3HullBuilder_NextConflictVertex(b3HullBuilder* b) {
    b3QHVertex* maxVertex = null;
    f32 maxDistance = b.minOutside;
    for b3QHListNode* faceNode = b.faceList.link.next; faceNode != &b.faceList.link; faceNode = faceNode.next {
        var face = cast(b3QHFace*, faceNode);
        if face.maxConflict != null && face.maxConflictDistance > maxDistance {
            maxDistance = face.maxConflictDistance;
            maxVertex = face.maxConflict;
        }
    }
    return maxVertex;
}

// Move every conflict vertex of `face` onto the orphaned list and clear their conflictFace.
void b3HullBuilder_DrainConflictList(b3HullBuilder* b, b3QHFace* face) {
    b3QHListNode* node = face.conflictListHead.link.next;
    while node != &face.conflictListHead.link {
        var orphan = cast(b3QHVertex*, node);
        node = node.next;
        orphan.conflictFace = null;
        b3QHList_Remove(&orphan.link);
        b3QHList_PushBack(&b.orphanedList.link, &orphan.link);
    }
}

// Mark a face for deletion, drain its conflict list, and populate a fresh DFS frame for it.
// `entryEdge` is the half-edge in `face` whose twin lies in the just-deleted parent face, or
// NULL for the seed. The frame skips `entryEdge` on recursive entries (it would be ignored
// anyway since the parent's mark is now DELETE, but skipping saves one iteration).
void b3HullBuilder_EnterHorizonFace(b3HullBuilder* b, b3QHFace* face, b3QHHalfEdge* entryEdge, b3HorizonFrame* frameOut) {
    face.mark = 1;
    b3HullBuilder_DrainConflictList(b, face);
    frameOut.face = face;
    frameOut.started = false;
    if entryEdge != null {
        frameOut.startEdge = entryEdge;
        frameOut.edge = entryEdge.next;
    } else {
        frameOut.startEdge = face.edge;
        frameOut.edge = face.edge;
    }
}

void b3HullBuilder_BuildHorizon(b3HullBuilder* b, b3QHVertex* apex, b3QHFace* seed) {
    b3HorizonFrame* stack = b.horizonStack;
    i32 top = 0;
    b3HullBuilder_EnterHorizonFace(b, seed, null, &stack[top++]);
    while top > 0 {
        b3HorizonFrame* f = &stack[top - 1];
        if f.started && f.edge == f.startEdge {
            top--;
            continue;
        }
        f.started = true;
        b3QHHalfEdge* edge = f.edge;
        b3QHHalfEdge* twin = edge.twin;
        f.edge = edge.next;
        if twin.face.mark != 0 {
            continue;
        }
        f32 distance = b3PlaneSeparation(twin.face.plane, apex.position);
        if distance > b.minRadius {
            b3HullBuilder_EnterHorizonFace(b, twin.face, twin, &stack[top++]);
        } else {
            b.horizon[b.horizonCount++] = edge;
        }
    }
}

void b3HullBuilder_BuildCone(b3HullBuilder* b, b3QHVertex* apex) {
    for i32 i = 0; i < b.horizonCount; ++i {
        b3QHHalfEdge* edge = b.horizon[i];
        b3QHFace* face = b3HullBuilder_NewFace(b, apex, edge.origin, edge.twin.origin);
        b.cone[b.coneCount++] = face;
        b3LinkFace(face, 1, edge.twin);
    }
    b3QHFace* face1 = b.cone[b.coneCount - 1];
    for i32 i = 0; i < b.coneCount; ++i {
        b3QHFace* face2 = b.cone[i];
        b3LinkFaces(face1, 2, face2, 0);
        face1 = face2;
    }
}

// Retire half-edges in the half-open ring range [begin, end) by pushing each onto edgeFreeHead.
// The caller has already detached these edges from the live face ring (rewire happens before
// destroy), so they are unreachable from the live hull.
void b3HullBuilder_DestroyEdges(b3HullBuilder* b, b3QHHalfEdge* begin, b3QHHalfEdge* end) {
    b3QHHalfEdge* edge = begin;
    while edge != end {
        b3QHHalfEdge* next = edge.next;
        b3HullBuilder_RetireEdge(b, edge);
        edge = next;
    }
}

void b3HullBuilder_ConnectEdges(b3HullBuilder* b, b3QHHalfEdge* prev, b3QHHalfEdge* next) {
    if prev.twin.face == next.twin.face {
        if next.face.edge == next {
            next.face.edge = prev;
        }
        b3QHHalfEdge* twin;
        if b3VertexCountOfFace(prev.twin.face) == 3 {
            b3QHHalfEdge* deadEdge0 = prev.twin;
            b3QHHalfEdge* deadEdge1 = next.twin;
            b3QHHalfEdge* deadEdge2 = next.twin.prev;
            twin = deadEdge2.twin;
            b3QHFace* opposingFace = prev.twin.face;
            opposingFace.mark = 1;
            b.mergedFaces[b.mergedFacesCount++] = opposingFace;
            prev.next = next.next;
            prev.next.prev = prev;
            prev.twin = twin;
            twin.twin = prev;
            b3QHList_Remove(&next.origin.link);
            b3HullBuilder_RetireEdge(b, deadEdge0);
            b3HullBuilder_RetireEdge(b, deadEdge1);
            b3HullBuilder_RetireEdge(b, deadEdge2);
        } else {
            twin = next.twin;
            if twin.face.edge == prev.twin {
                twin.face.edge = twin;
            }
            twin.next = prev.twin.next;
            twin.next.prev = twin;
            b3HullBuilder_RetireEdge(b, prev.twin);
            prev.next = next.next;
            prev.next.prev = prev;
            prev.twin = twin;
            twin.twin = prev;
            b3QHList_Remove(&next.origin.link);
        }
        b3NewellPlane(twin.face);
        b3HullBuilder_RecacheConflicts(twin.face, b.minOutside);
    } else {
        prev.next = next;
        next.prev = prev;
    }
}

void b3HullBuilder_AbsorbFaces(b3HullBuilder* b, b3QHFace* face) {
    for i32 i = 0; i < b.mergedFacesCount; ++i {
        b3QHListNode* head = &b.mergedFaces[i].conflictListHead.link;
        b3QHListNode* node = head.next;
        while node != head {
            var vertex = cast(b3QHVertex*, node);
            node = node.next;
            b3QHList_Remove(&vertex.link);
            f32 distance = b3PlaneSeparation(face.plane, vertex.position);
            if distance > b.minOutside {
                b3QHList_PushBack(&face.conflictListHead.link, &vertex.link);
                vertex.conflictFace = face;
                if distance > face.maxConflictDistance {
                    face.maxConflictDistance = distance;
                    face.maxConflict = vertex;
                }
            } else {
                b3QHList_PushBack(&b.orphanedList.link, &vertex.link);
                vertex.conflictFace = null;
            }
        }
        b3HullBuilder_RetireFace(b, b.mergedFaces[i]);
    }
}

void b3HullBuilder_ConnectFaces(b3HullBuilder* b, b3QHHalfEdge* edge) {
    b3QHFace* face = edge.face;
    b3QHHalfEdge* twin = edge.twin;
    b3QHHalfEdge* edgePrev = edge.prev;
    b3QHHalfEdge* edgeNext = edge.next;
    b3QHHalfEdge* twinPrev = twin.prev;
    b3QHHalfEdge* twinNext = twin.next;
    while edgePrev.twin.face == twin.face {
        edgePrev = edgePrev.prev;
        twinNext = twinNext.next;
    }
    while edgeNext.twin.face == twin.face {
        edgeNext = edgeNext.next;
        twinPrev = twinPrev.prev;
    }
    face.edge = edgePrev;
    b.mergedFacesCount = 0;
    b.mergedFaces[b.mergedFacesCount++] = twin.face;
    twin.face.mark = 1;
    twin.face.edge = null;
    for b3QHHalfEdge* absorbed = twinNext; absorbed != twinPrev.next; absorbed = absorbed.next {
        absorbed.face = face;
    }
    b3HullBuilder_DestroyEdges(b, edgePrev.next, edgeNext);
    b3HullBuilder_DestroyEdges(b, twinPrev.next, twinNext);
    b3HullBuilder_ConnectEdges(b, edgePrev, twinNext);
    b3HullBuilder_ConnectEdges(b, twinPrev, edgeNext);
    b3NewellPlane(face);
    b3HullBuilder_RecacheConflicts(face, b.minOutside);
    b3HullBuilder_AbsorbFaces(b, face);
}

bool b3HullBuilder_MergeConcave(b3HullBuilder* b, b3QHFace* face) {
    b3QHHalfEdge* edge = face.edge;
    while true {
        b3QHHalfEdge* twin = edge.twin;
        if b3IsEdgeConcave(edge, b.minRadius) || b3IsEdgeConcave(twin, b.minRadius) {
            b3HullBuilder_ConnectFaces(b, edge);
            return true;
        }
        edge = edge.next;
        if !(edge != face.edge) { break; }
    }
    return false;
}

bool b3HullBuilder_MergeCoplanar(b3HullBuilder* b, b3QHFace* face) {
    b3QHHalfEdge* edge = face.edge;
    while true {
        b3QHHalfEdge* twin = edge.twin;
        if !b3IsEdgeConvex(edge, b.minRadius) || !b3IsEdgeConvex(twin, b.minRadius) {
            b3HullBuilder_ConnectFaces(b, edge);
            return true;
        }
        edge = edge.next;
        if !(edge != face.edge) { break; }
    }
    return false;
}

void b3HullBuilder_MergeFaces(b3HullBuilder* b) {
    for i32 i = 0; i < b.coneCount; ++i {
        b3QHFace* face = b.cone[i];
        if face.mark == 0 && face.flipped {
            face.flipped = false;
            f32 bestArea = 0.0f;
            b3QHHalfEdge* bestEdge = null;
            b3QHHalfEdge* edge = face.edge;
            while true {
                b3QHHalfEdge* twin = edge.twin;
                f32 area = twin.face.area;
                if area > bestArea {
                    bestArea = area;
                    bestEdge = edge;
                }
                edge = edge.next;
                if !(edge != face.edge) { break; }
            }
            b3HullBuilder_ConnectFaces(b, bestEdge);
        }
    }
    for i32 i = 0; i < b.coneCount; ++i {
        b3QHFace* face = b.cone[i];
        if face.mark == 0 {
            while b3HullBuilder_MergeConcave(b, face) != 0 {
            }
        }
    }
    for i32 i = 0; i < b.coneCount; ++i {
        b3QHFace* face = b.cone[i];
        if face.mark == 0 {
            while b3HullBuilder_MergeCoplanar(b, face) != 0 {
            }
        }
    }
}

void b3HullBuilder_ResolveVertices(b3HullBuilder* b) {
    b3QHListNode* node = b.orphanedList.link.next;
    while node != &b.orphanedList.link {
        var vertex = cast(b3QHVertex*, node);
        node = node.next;
        b3QHList_Remove(&vertex.link);
        f32 maxDistance = b.minOutside;
        b3QHFace* maxFace = null;
        for i32 i = 0; i < b.coneCount; ++i {
            if b.cone[i].mark == 0 {
                f32 distance = b3PlaneSeparation(b.cone[i].plane, vertex.position);
                if distance > maxDistance {
                    maxDistance = distance;
                    maxFace = b.cone[i];
                }
            }
        }
        if maxFace != null {
            b3QHList_PushBack(&maxFace.conflictListHead.link, &vertex.link);
            vertex.conflictFace = maxFace;
            if maxDistance > maxFace.maxConflictDistance {
                maxFace.maxConflictDistance = maxDistance;
                maxFace.maxConflict = vertex;
            }
        }
    }
}

void b3HullBuilder_ResolveFaces(b3HullBuilder* b) {
    b3QHListNode* node = b.faceList.link.next;
    while node != &b.faceList.link {
        var face = cast(b3QHFace*, node);
        node = node.next;
        if face.mark == 1 && b3QHList_Contains(&face.link) {
            b3QHList_Remove(&face.link);
        }
    }
    for i32 i = 0; i < b.coneCount; ++i {
        b3QHFace* face = b.cone[i];
        if face.mark == 1 {
            continue;
        }
        b3QHList_PushBack(&b.faceList.link, &face.link);
    }
}

void b3HullBuilder_AddVertexToHull(b3HullBuilder* b, b3QHVertex* vertex) {
    b3QHFace* face = vertex.conflictFace;
    vertex.conflictFace = null;
    b3QHList_Remove(&vertex.link);
    b3QHList_PushBack(&b.vertexList.link, &vertex.link);
    b.horizonCount = 0;
    b3HullBuilder_BuildHorizon(b, vertex, face);
    b.coneCount = 0;
    b3HullBuilder_BuildCone(b, vertex);
    b3HullBuilder_MergeFaces(b);
    b3HullBuilder_ResolveVertices(b);
    b3HullBuilder_ResolveFaces(b);
}

void b3HullBuilder_CleanHull(b3HullBuilder* b, b3Vec3 origin) {
    i32 faceCount = 0;
    i32 halfEdgeCount = 0;
    for b3QHListNode* faceNode = b.faceList.link.next; faceNode != &b.faceList.link; faceNode = faceNode.next {
        var face = cast(b3QHFace*, faceNode);
        b3QHHalfEdge* edge = face.edge;
        while true {
            edge.origin.reachable = true;
            edge = edge.next;
            halfEdgeCount++;
            if !(edge != face.edge) { break; }
        }
        face.plane.offset += b3Dot(face.plane.normal, origin);
        face.centroid = b3Add(face.centroid, origin);
        faceCount++;
    }
    i32 vertexCount = 0;
    b3QHListNode* node = b.vertexList.link.next;
    while node != &b.vertexList.link {
        var vertex = cast(b3QHVertex*, node);
        node = node.next;
        if vertex.reachable == 0 {
            b3QHList_Remove(&vertex.link);
        } else {
            vertex.position = b3Add(vertex.position, origin);
            vertexCount++;
        }
    }
    b.interiorPoint = b3Add(b.interiorPoint, origin);
    b.finalVertexCount = vertexCount;
    b.finalHalfEdgeCount = halfEdgeCount;
    b.finalFaceCount = faceCount;
}

bool b3HullBuilder_HasHull(b3HullBuilder* b) {
    i32 v = b.finalVertexCount;
    i32 e = b.finalHalfEdgeCount / 2;
    i32 f = b.finalFaceCount;
    return v - e + f == 2 && f >= 4;
}

// Build the entire hull. Returns true iff the result satisfies Euler's identity.
bool b3HullBuilder_Construct(b3HullBuilder* b, b3Vec3* points, i32 pointCount, i32 maxVertexCount, b3Vec3 origin, b3Vec3* shiftedPoints) {
    if pointCount < 4 {
        return false;
    }
    for i32 i = 0; i < pointCount; ++i {
        shiftedPoints[i] = b3Sub(points[i], origin);
    }
    b3HullBuilder_ComputeTolerance(b, pointCount, shiftedPoints);
    bool haveInitialHull = b3HullBuilder_BuildInitialHull(b, pointCount, shiftedPoints);
    if haveInitialHull == false {
        return false;
    }
    i32 budget = b3ClampInt(maxVertexCount - 4, 0, 255 - 4);
    b3QHVertex* vertex = b3HullBuilder_NextConflictVertex(b);
    while vertex && budget > 0 {
        b3HullBuilder_AddVertexToHull(b, vertex);
        vertex = b3HullBuilder_NextConflictVertex(b);
        budget -= 1;
    }
    b3HullBuilder_CleanHull(b, origin);
    return b3HullBuilder_HasHull(b);
}

b3HullWorkSizes b3ComputeHullWorkSizes(i32 pointCount, i32 clampedMaxCount) {
    noinit b3HullWorkSizes s;
    s.N = pointCount;
    s.M = clampedMaxCount;
    s.vertexCapacity = pointCount + 4;
    s.edgeCapacity = 24 * s.M - 48;
    if s.edgeCapacity < 48 {
        s.edgeCapacity = 48;
    }
    s.faceCapacity = 5 * s.M - 10;
    if s.faceCapacity < 16 {
        s.faceCapacity = 16;
    }
    s.horizonCapacity = 3 * s.M - 6;
    if s.horizonCapacity < 6 {
        s.horizonCapacity = 6;
    }
    s.coneCapacity = s.horizonCapacity;
    s.mergedFacesCapacity = 2 * s.M - 4;
    if s.mergedFacesCapacity < 4 {
        s.mergedFacesCapacity = 4;
    }
    s.horizonStackCapacity = 2 * s.M - 4;
    if s.horizonStackCapacity < 4 {
        s.horizonStackCapacity = 4;
    }
    u64 offset = 0;
    s.offsetVertex = offset;
    offset = b3AlignUp8(offset + cast(u64, s.vertexCapacity) * cast(u64, sizeof(b3QHVertex)));
    s.offsetEdge = offset;
    offset = b3AlignUp8(offset + cast(u64, s.edgeCapacity) * cast(u64, sizeof(b3QHHalfEdge)));
    s.offsetFace = offset;
    offset = b3AlignUp8(offset + cast(u64, s.faceCapacity) * cast(u64, sizeof(b3QHFace)));
    s.offsetHorizon = offset;
    offset = b3AlignUp8(offset + cast(u64, s.horizonCapacity) * cast(u64, sizeof(b3QHHalfEdge*)));
    s.offsetCone = offset;
    offset = b3AlignUp8(offset + cast(u64, s.coneCapacity) * cast(u64, sizeof(b3QHFace*)));
    s.offsetMergedFaces = offset;
    offset = b3AlignUp8(offset + cast(u64, s.mergedFacesCapacity) * cast(u64, sizeof(b3QHFace*)));
    s.offsetHorizonStack = offset;
    offset = b3AlignUp8(offset + cast(u64, s.horizonStackCapacity) * cast(u64, sizeof(b3HorizonFrame)));
    s.offsetShiftedPoints = offset;
    offset += cast(u64, pointCount) * cast(u64, sizeof(b3Vec3));
    s.totalBytes = offset;
    return s;
}

void b3HullBuilder_Init(b3HullBuilder* b, u8* mem, b3HullWorkSizes* s) {
    memset(b, 0, cast(u64, sizeof(*b)));
    b3QHList_Init(&b.orphanedList.link);
    b3QHList_Init(&b.vertexList.link);
    b3QHList_Init(&b.faceList.link);
    b.vertexBase = cast(b3QHVertex*, mem + s.offsetVertex);
    b.vertexCapacity = s.vertexCapacity;
    b.edgeBase = cast(b3QHHalfEdge*, mem + s.offsetEdge);
    b.edgeCapacity = s.edgeCapacity;
    b.faceBase = cast(b3QHFace*, mem + s.offsetFace);
    b.faceCapacity = s.faceCapacity;
    b.horizon = cast(b3QHHalfEdge**, mem + s.offsetHorizon);
    b.horizonCapacity = s.horizonCapacity;
    b.cone = cast(b3QHFace**, mem + s.offsetCone);
    b.coneCapacity = s.coneCapacity;
    b.mergedFaces = cast(b3QHFace**, mem + s.offsetMergedFaces);
    b.mergedFacesCapacity = s.mergedFacesCapacity;
    b.horizonStack = cast(b3HorizonFrame*, mem + s.offsetHorizonStack);
    b.horizonStackCapacity = s.horizonStackCapacity;
}

b3Vec3* b3GetHullPointsWrite(b3HullData* hull) {
    if hull.pointOffset == 0 {
        return null;
    }
    return cast(b3Vec3*, cast(i64, hull) + hull.pointOffset);
}

b3Plane* b3GetHullPlanesWrite(b3HullData* hull) {
    if hull.planeOffset == 0 {
        return null;
    }
    return cast(b3Plane*, cast(i64, hull) + hull.planeOffset);
}

b3HullVertex* b3GetHullVerticesWrite(b3HullData* hull) {
    if hull.vertexOffset == 0 {
        return null;
    }
    return cast(b3HullVertex*, cast(i64, hull) + hull.vertexOffset);
}

b3HullHalfEdge* b3GetHullEdgesWrite(b3HullData* hull) {
    if hull.edgeOffset == 0 {
        return null;
    }
    return cast(b3HullHalfEdge*, cast(i64, hull) + hull.edgeOffset);
}

f32* b3GetHullSoaVerticesWrite(b3HullData* hull) {
    if hull.soaVertexOffset == 0 {
        return null;
    }
    return cast(f32*, cast(i64, hull) + hull.soaVertexOffset);
}

f32* b3GetHullSoaNormalsWrite(b3HullData* hull) {
    if hull.soaNormalOffset == 0 {
        return null;
    }
    return cast(f32*, cast(i64, hull) + hull.soaNormalOffset);
}
}

i32 b3FindHullSupportVertex(b3HullData* hull, b3Vec3 direction) {
    i32 bestIndex = -1;
    f32 bestDot = -FLT_MAX;
    i32 vertexCount = hull.vertexCount;
    b3Vec3* points = b3GetHullPoints(hull);
    for i32 index = 0; index < vertexCount; ++index {
        f32 dot = b3Dot(direction, points[index]);
        if dot > bestDot {
            bestIndex = index;
            bestDot = dot;
        }
    }
    return bestIndex;
}

i32 b3FindHullSupportFace(b3HullData* hull, b3Vec3 direction) {
    i32 bestIndex = -1;
    f32 bestDot = -FLT_MAX;
    i32 faceCount = hull.faceCount;
    b3Plane* planes = b3GetHullPlanes(hull);
    for i32 index = 0; index < faceCount; ++index {
        f32 dot = b3Dot(planes[index].normal, direction);
        if dot > bestDot {
            bestDot = dot;
            bestIndex = index;
        }
    }
    return bestIndex;
}

bool b3IsValidHull(b3HullData* hull) {
    ignore hull;
    return true;
}

b3HullData* b3CreateCylinder(f32 height, f32 radius, f32 yOffset, i32 sides) {
    i32 pointCount = 2 * sides;
    var points = cast(b3Vec3*, b3Alloc(cast(u64, pointCount * sizeof(b3Vec3))));
    f32 alpha = 0.0f;
    f32 deltaAlpha = 2.0f * 3.14159265359f / cast(f32, sides);
    for i32 index = 0; index < sides; ++index {
        f32 sinAlpha = b3Sin(alpha);
        f32 cosAlpha = b3Cos(alpha);
        points[2 * index + 0] = b3Vec3{radius * cosAlpha, yOffset, radius * sinAlpha};
        points[2 * index + 1] = b3Vec3{radius * cosAlpha, yOffset + height, radius * sinAlpha};
        alpha += deltaAlpha;
    }
    b3HullData* hull = b3CreateHull(points, pointCount, pointCount);
    b3Free(points, cast(u64, pointCount * sizeof(b3Vec3)));
    return hull;
}

b3HullData* b3CreateCone(f32 height, f32 radius1, f32 radius2, i32 slices) {
    i32 pointCount = 2 * slices;
    var points = cast(b3Vec3*, b3Alloc(cast(u64, pointCount * sizeof(b3Vec3))));
    f32 alpha = 0.0f;
    f32 deltaAlpha = 2.0f * 3.14159265359f / cast(f32, slices);
    for i32 index = 0; index < slices; ++index {
        f32 sinAlpha = b3Sin(alpha);
        f32 cosAlpha = b3Cos(alpha);
        points[2 * index + 0] = b3Vec3{radius1 * cosAlpha, 0.0f, radius1 * sinAlpha};
        points[2 * index + 1] = b3Vec3{radius2 * cosAlpha, height, radius2 * sinAlpha};
        alpha += deltaAlpha;
    }
    b3HullData* hull = b3CreateHull(points, pointCount, pointCount);
    b3Free(points, cast(u64, pointCount * sizeof(b3Vec3)));
    return hull;
}

b3HullData* b3CreateRock(f32 radius) {
    i32 pointCount = 10;
    f32 phi = (1.0f + cast(f32, sqrtf(5.0f))) / 2.0f;
    noinit b3Vec3[10] points;
    f32 theta = 2.0f * 3.14159265359f / phi;
    var cs = b3CosSin{1.0f, 0.0f};
    b3CosSin deltaCS = b3ComputeCosSin(theta);
    for i32 i = 0; i < pointCount; ++i {
        f32 z = 1.0f - (2.0f * cast(f32, i) + 1.0f) / cast(f32, pointCount);
        f32 radius_XY = sqrtf(1.0f - z * z);
        points[i].x = radius * radius_XY * cs.cosine;
        points[i].y = radius * radius_XY * cs.sine;
        points[i].z = radius * z;
        b3CosSin cs0 = cs;
        cs.cosine = deltaCS.cosine * cs0.cosine - deltaCS.sine * cs0.sine;
        cs.sine = deltaCS.sine * cs0.cosine + deltaCS.cosine * cs0.sine;
    }
    return b3CreateHull(points, pointCount, pointCount);
}

private {
void b3UpdateHullBounds(b3HullData* hull) {
    b3Vec3* points = b3GetHullPoints(hull);
    i32 vertexCount = hull.vertexCount;
    noinit b3AABB bounds;
    bounds.lowerBound = points[0];
    bounds.upperBound = points[0];
    for i32 i = 1; i < vertexCount; ++i {
        b3Vec3 p = points[i];
        bounds.lowerBound = b3Min(bounds.lowerBound, p);
        bounds.upperBound = b3Max(bounds.upperBound, p);
    }
    hull.aabb = bounds;
}

// M. Kallay - "Computing the Moment of Inertia of a Solid Defined by a Triangle Mesh"
bool b3UpdateHullBulkProperties(b3HullData* hull) {
    b3Vec3* points = b3GetHullPoints(hull);
    b3HullFace* faces = b3GetHullFaces(hull);
    b3HullHalfEdge* edges = b3GetHullEdges(hull);
    b3Plane* planes = b3GetHullPlanes(hull);
    f32 area = 0.0f;
    f32 volume = 0.0f;
    b3Vec3 center = b3Vec3_zero;
    b3Vec3 origin = points[0];
    f32 xx = 0.0f;
    f32 xy = 0.0f;
    f32 yy = 0.0f;
    f32 xz = 0.0f;
    f32 zz = 0.0f;
    f32 yz = 0.0f;
    i32 faceCount = hull.faceCount;
    for i32 faceIndex = 0; faceIndex < faceCount; ++faceIndex {
        b3HullFace* face = faces + faceIndex;
        b3HullHalfEdge* edge1 = edges + face.edge;
        b3HullHalfEdge* edge2 = edges + edge1.next;
        b3HullHalfEdge* edge3 = edges + edge2.next;
        b3Vec3 v1 = b3Sub(points[edge1.origin], origin);
        while true {
            b3Vec3 v2 = b3Sub(points[edge2.origin], origin);
            b3Vec3 v3 = b3Sub(points[edge3.origin], origin);
            area += b3Length(b3Cross(b3Sub(v2, v1), b3Sub(v3, v1)));
            f32 det = b3ScalarTripleProduct(v1, v2, v3);
            volume += det;
            b3Vec3 v4 = b3Add(v1, b3Add(v2, v3));
            center = b3Add(center, b3MulSV(det, v4));
            xx += det * (v1.x * v1.x + v2.x * v2.x + v3.x * v3.x + v4.x * v4.x);
            yy += det * (v1.y * v1.y + v2.y * v2.y + v3.y * v3.y + v4.y * v4.y);
            zz += det * (v1.z * v1.z + v2.z * v2.z + v3.z * v3.z + v4.z * v4.z);
            xy += det * (v1.x * v1.y + v2.x * v2.y + v3.x * v3.y + v4.x * v4.y);
            xz += det * (v1.x * v1.z + v2.x * v2.z + v3.x * v3.z + v4.x * v4.z);
            yz += det * (v1.y * v1.z + v2.y * v2.z + v3.y * v3.z + v4.y * v4.z);
            edge2 = edge3;
            edge3 = edges + edge3.next;
            if !(edge1 != edge3) { break; }
        }
    }
    b3Vec3 localCenter = volume > 0.0f ? b3MulSV(0.25f / volume, center) : b3Vec3_zero;
    center = b3Add(localCenter, origin);
    f32 radius = FLT_MAX;
    for i32 faceIndex = 0; faceIndex < faceCount; ++faceIndex {
        b3Plane plane = planes[faceIndex];
        f32 distance = b3PlaneSeparation(plane, center);
        radius = b3MinFloat(radius, -distance);
    }
    noinit b3Matrix3 inertia;
    inertia.cx.x = yy + zz;
    inertia.cy.x = -xy;
    inertia.cz.x = -xz;
    inertia.cx.y = -xy;
    inertia.cy.y = xx + zz;
    inertia.cz.y = -yz;
    inertia.cx.z = -xz;
    inertia.cy.z = -yz;
    inertia.cz.z = xx + yy;
    f32 mass = volume / 6.0f;
    b3Matrix3 centralInertia = b3MulSM(1.0f / 120.0f, inertia);
    centralInertia = b3SubMM(centralInertia, b3Steiner(mass, localCenter));
    hull.center = center;
    hull.centralInertia = centralInertia;
    hull.volume = mass;
    hull.surfaceArea = 0.5f * area;
    hull.innerRadius = radius;
    if mass <= 0.0f {
        return false;
    }
    if volume <= 0.0f {
        return false;
    }
    if area <= 0.0f {
        return false;
    }
    if radius <= 0.0f {
        return false;
    }
    return true;
}
}

b3HullData* b3CreateHull(b3Vec3* points, i32 pointCount, i32 maxVertexCount) {
    if pointCount < 4 {
        return null;
    }
    b3Vec3 origin = points[0];
    i32 clampedMaxCount = b3ClampInt(maxVertexCount, 4, 128);
    b3HullWorkSizes sizes = b3ComputeHullWorkSizes(pointCount, clampedMaxCount);
    u8* work = b3Alloc(sizes.totalBytes);
    noinit b3HullBuilder builder;
    b3HullBuilder_Init(&builder, work, &sizes);
    var shiftedPoints = cast(b3Vec3*, work + sizes.offsetShiftedPoints);
    bool ok = b3HullBuilder_Construct(&builder, points, pointCount, clampedMaxCount, origin, shiftedPoints);
    if ok == false {
        b3Free(work, sizes.totalBytes);
        return null;
    }
    if builder.finalVertexCount >= 128 {
        b3Log("hull final vertex count of %d exceeds limit of %d", builder.finalVertexCount, 128);
        b3Free(work, sizes.totalBytes);
        return null;
    }
    if builder.finalFaceCount >= 128 {
        b3Log("hull final face count of %d exceeds limit of %d", builder.finalFaceCount, 128);
        b3Free(work, sizes.totalBytes);
        return null;
    }
    i32 maxHalfEdgeCount = 2 * 128;
    if builder.finalHalfEdgeCount >= maxHalfEdgeCount {
        b3Log("hull final half edge count of %d exceeds limit of %d", builder.finalHalfEdgeCount, maxHalfEdgeCount);
        b3Free(work, sizes.totalBytes);
        return null;
    }
    noinit b3QHVertex*[255] tempVertices;
    i32 vertexCount = 0;
    for b3QHListNode* node = builder.vertexList.link.next; node != &builder.vertexList.link; node = node.next {
        var vertex = cast(b3QHVertex*, node);
        vertex.finalIndex = vertexCount;
        tempVertices[vertexCount++] = vertex;
    }
    noinit b3QHFace*[255] tempFaces;
    noinit b3QHHalfEdge*[255] tempEdges;
    i32 faceCount = 0;
    i32 edgeCount = 0;
    for b3QHListNode* faceNode = builder.faceList.link.next; faceNode != &builder.faceList.link; faceNode = faceNode.next {
        var face = cast(b3QHFace*, faceNode);
        face.finalIndex = faceCount;
        tempFaces[faceCount++] = face;
        b3QHHalfEdge* edge = face.edge;
        while true {
            if edge.finalIndex < 0 {
                edge.finalIndex = edgeCount;
                tempEdges[edgeCount++] = edge;
                edge.twin.finalIndex = edgeCount;
                tempEdges[edgeCount++] = edge.twin;
            }
            edge = edge.next;
            if !(edge != face.edge) { break; }
        }
    }
    i32 soaVertexCount = vertexCount + 3 & ~3;
    i32 soaNormalCount = faceCount + 3 & ~3;
    u64 byteCount = b3AlignUp8(cast(u64, sizeof(b3HullData)));
    var vertexOffset = cast(i32, byteCount);
    byteCount += b3AlignUp8(cast(u64, vertexCount * cast(i32, sizeof(b3HullVertex))));
    var pointOffset = cast(i32, byteCount);
    byteCount += b3AlignUp8(cast(u64, vertexCount * cast(i32, sizeof(b3Vec3))));
    var edgeOffset = cast(i32, byteCount);
    byteCount += b3AlignUp8(cast(u64, edgeCount * cast(i32, sizeof(b3HullHalfEdge))));
    var planeOffset = cast(i32, byteCount);
    byteCount += b3AlignUp8(cast(u64, faceCount * cast(i32, sizeof(b3Plane))));
    var faceOffset = cast(i32, byteCount);
    byteCount += b3AlignUp8(cast(u64, faceCount * cast(i32, sizeof(b3HullFace))));
    var soaVertexOffset = cast(i32, byteCount);
    byteCount += b3AlignUp8(cast(u64, 3 * soaVertexCount * cast(i32, sizeof(f32))));
    var soaNormalOffset = cast(i32, byteCount);
    byteCount += b3AlignUp8(cast(u64, 3 * soaNormalCount * cast(i32, sizeof(f32))));
    b3HullData* hull = b3Alloc(byteCount);
    memset(hull, 0, byteCount);
    hull.version = 0xDA5150191B994C01;
    hull.vertexOffset = vertexOffset;
    hull.pointOffset = pointOffset;
    hull.edgeOffset = edgeOffset;
    hull.planeOffset = planeOffset;
    hull.faceOffset = faceOffset;
    hull.soaVertexOffset = soaVertexOffset;
    hull.soaNormalOffset = soaNormalOffset;
    hull.vertexCount = vertexCount;
    hull.edgeCount = edgeCount;
    hull.faceCount = faceCount;
    hull.byteCount = cast(i32, byteCount);
    b3HullVertex* vertices = b3GetHullVerticesWrite(hull);
    b3HullHalfEdge* edges = b3GetHullEdgesWrite(hull);
    var faces = cast(b3HullFace*, cast(i64, hull) + hull.faceOffset);
    b3Vec3* finalPoints = b3GetHullPointsWrite(hull);
    b3Plane* planes = b3GetHullPlanesWrite(hull);
    f32* soaVertices = b3GetHullSoaVerticesWrite(hull);
    f32* soaNormals = b3GetHullSoaNormalsWrite(hull);
    f32* vx = soaVertices;
    f32* vy = vx + soaVertexCount;
    f32* vz = vy + soaVertexCount;
    for i32 index = 0; index < vertexCount; ++index {
        vertices[index].edge = 0;
        b3Vec3 p = tempVertices[index].position;
        finalPoints[index] = p;
        vx[index] = p.x;
        vy[index] = p.y;
        vz[index] = p.z;
    }
    for i32 index = vertexCount; index < soaVertexCount; ++index {
        vx[index] = vx[0];
        vy[index] = vy[0];
        vz[index] = vz[0];
    }
    for i32 index = 0; index < edgeCount; ++index {
        b3QHHalfEdge* edge = tempEdges[index];
        edges[index].next = cast(u8, edge.next.finalIndex);
        edges[index].twin = cast(u8, edge.twin.finalIndex);
        edges[index].face = cast(u8, edge.face.finalIndex);
        edges[index].origin = cast(u8, edge.origin.finalIndex);
        vertices[edge.origin.finalIndex].edge = cast(u8, index);
    }
    f32* nx = soaNormals;
    f32* ny = nx + soaNormalCount;
    f32* nz = ny + soaNormalCount;
    for i32 index = 0; index < faceCount; ++index {
        b3QHFace* face = tempFaces[index];
        faces[index].edge = cast(u8, face.edge.finalIndex);
        planes[index] = face.plane;
        b3Vec3 n = face.plane.normal;
        nx[index] = n.x;
        ny[index] = n.y;
        nz[index] = n.z;
    }
    for i32 index = faceCount; index < soaNormalCount; ++index {
        nx[index] = 0.0f;
        ny[index] = 0.0f;
        nz[index] = 0.0f;
    }
    b3Free(work, sizes.totalBytes);
    b3UpdateHullBounds(hull);
    bool success = b3UpdateHullBulkProperties(hull);
    if success == false {
        b3DestroyHull(hull);
        return null;
    }
    if b3IsValidHull(hull) == false {
        b3DestroyHull(hull);
        return null;
    }
    hull.hash = 0;
    hull.hash = b3NonZeroHash(b3Hash(5381, cast(u8*, hull), hull.byteCount));
    return hull;
}

b3HullData* b3CloneHull(b3HullData* hull) {
    if hull == null || b3IsValidHull(hull) == false {
        return null;
    }
    var clone = cast(b3HullData*, b3Alloc(cast(u64, hull.byteCount)));
    memcpy(clone, hull, cast(u64, hull.byteCount));
    return clone;
}

u64 b3HashHullData(b3HullData* hull) {
    return cast(u64, hull.hash) * 0x9E3779B97F4A7C15;
}

bool b3CompareHullData(b3HullData* hull1, b3HullData* hull2) {
    if hull1 == hull2 {
        return true;
    }
    if hull1.byteCount != hull2.byteCount {
        return false;
    }
    return memcmp(hull1, hull2, cast(u64, hull1.byteCount)) == 0;
}
// Hull identity covers every byte, so the structs carry explicit padding. These lock
// the layout, re-audit padding if a size changes.
/*------------------------------------------------- VERSTABLE v2.2.1 ---------------------------------------------------

Verstable is a C99-compatible, open-addressing hash table using quadratic probing and the following additions:

* All keys that hash (i.e. "belong") to the same bucket (their "home bucket") are linked together by an 11-bit integer
  specifying the quadratic displacement, relative to that bucket, of the next key in the chain.

* If a chain of keys exists for a given bucket, then it always begins at that bucket. To maintain this policy, a 1-bit
  flag is used to mark whether the key occupying a bucket belongs there. When inserting a new key, if the bucket it
  belongs to is occupied by a key that does not belong there, then the occupying key is evicted and the new key takes
  the bucket.

* A 4-bit fragment of each key's hash code is also stored.

* The aforementioned metadata associated with each bucket (the 4-bit hash fragment, the 1-bit flag, and the 11-bit link
  to the next key in the chain) are stored together in a uint16_t array rather than in the bucket alongside the key and
  (optionally) the value.

One way to conceptualize this scheme is as a chained hash table in which overflowing keys are stored not in separate
memory allocations but in otherwise unused buckets. In this regard, it shares similarities with Malte Skarupke's Bytell
hash table (https://www.youtube.com/watch?v=M2fKMP47slQ) and traditional "coalesced hashing".

Advantages of this scheme include:

* Fast lookups impervious to load factor: If the table contains any key belonging to the lookup key's home bucket, then
  that bucket contains the first in a traversable chain of all keys belonging to it. Hence, only the home bucket and
  other buckets containing keys belonging to it are ever probed. Moreover, the stored hash fragments allow skipping most
  non-matching keys in the chain without accessing the actual buckets array or calling the (potentially expensive) key
  comparison function.

* Fast insertions: Insertions are faster than they are in other schemes that move keys around (e.g. Robin Hood) because
  they only move, at most, one existing key.

* Fast, tombstone-free deletions: Deletions, which usually require tombstones in quadratic-probing hash tables, are
  tombstone-free and only move, at most, one existing key.

* Fast iteration: The separate metadata array allows keys in sparsely populated tables to be found without incurring the
  frequent cache misses that would result from traversing the buckets array.

Usage example:

  +---------------------------------------------------------+----------------------------------------------------------+
  | Using the generic macro API (C11 and later):            | Using the prefixed functions API (C99 and later):        |
  +---------------------------------------------------------+----------------------------------------------------------+
  | #include <stdio.h>                                      | #include <stdio.h>                                       |
  |                                                         |                                                          |
  | // Instantiating a set template.                        | // Instantiating a set template.                         |
  | #define NAME int_set                                    | #define NAME int_set                                     |
  | #define KEY_TY int                                      | #define KEY_TY int                                       |
  | #include "verstable.h"                                  | #define HASH_FN vt_hash_integer                          |
  |                                                         | #define CMPR_FN vt_cmpr_integer                          |
  | // Instantiating a map template.                        | #include "verstable.h"                                   |
  | #define NAME int_int_map                                |                                                          |
  | #define KEY_TY int                                      | // Instantiating a map template.                         |
  | #define VAL_TY int                                      | #define NAME int_int_map                                 |
  | #include "verstable.h"                                  | #define KEY_TY int                                       |
  |                                                         | #define VAL_TY int                                       |
  | int main( void )                                        | #define HASH_FN vt_hash_integer                          |
  | {                                                       | #define CMPR_FN vt_cmpr_integer                          |
  |   // Set.                                               | #include "verstable.h"                                   |
  |                                                         |                                                          |
  |   int_set our_set;                                      | int main( void )                                         |
  |   vt_init( &our_set );                                  | {                                                        |
  |                                                         |   // Set.                                                |
  |   // Inserting keys.                                    |                                                          |
  |   for( int i = 0; i < 10; ++i )                         |   int_set our_set;                                       |
  |   {                                                     |   int_set_init( &our_set );                              |
  |     int_set_itr itr = vt_insert( &our_set, i );         |                                                          |
  |     if( vt_is_end( itr ) )                              |   // Inserting keys.                                     |
  |     {                                                   |   for( int i = 0; i < 10; ++i )                          |
  |       // Out of memory, so abort.                       |   {                                                      |
  |       vt_cleanup( &our_set );                           |     int_set_itr itr =                                    |
  |       return 1;                                         |       int_set_insert( &our_set, i );                     |
  |     }                                                   |     if( int_set_is_end( itr ) )                          |
  |   }                                                     |     {                                                    |
  |                                                         |       // Out of memory, so abort.                        |
  |   // Erasing keys.                                      |       int_set_cleanup( &our_set );                       |
  |   for( int i = 0; i < 10; i += 3 )                      |       return 1;                                          |
  |     vt_erase( &our_set, i );                            |     }                                                    |
  |                                                         |   }                                                      |
  |   // Retrieving keys.                                   |                                                          |
  |   for( int i = 0; i < 10; ++i )                         |   // Erasing keys.                                       |
  |   {                                                     |   for( int i = 0; i < 10; i += 3 )                       |
  |     int_set_itr itr = vt_get( &our_set, i );            |     int_set_erase( &our_set, i );                        |
  |     if( !vt_is_end( itr ) )                             |                                                          |
  |       printf( "%d ", itr.data->key );                   |   // Retrieving keys.                                    |
  |   }                                                     |   for( int i = 0; i < 10; ++i )                          |
  |   // Printed: 1 2 4 5 7 8                               |   {                                                      |
  |                                                         |     int_set_itr itr = int_set_get( &our_set, i );        |
  |   // Iteration.                                         |     if( !int_set_is_end( itr ) )                         |
  |   for(                                                  |       printf( "%d ", itr.data->key );                    |
  |     int_set_itr itr = vt_first( &our_set );             |   }                                                      |
  |     !vt_is_end( itr );                                  |   // Printed: 1 2 4 5 7 8                                |
  |     itr = vt_next( itr )                                |                                                          |
  |   )                                                     |   // Iteration.                                          |
  |     printf( "%d ", itr.data->key );                     |   for(                                                   |
  |   // Printed: 2 4 7 1 5 8                               |     int_set_itr itr =                                    |
  |                                                         |       int_set_first( &our_set );                         |
  |   vt_cleanup( &our_set );                               |     !int_set_is_end( itr );                              |
  |                                                         |     itr = int_set_next( itr )                            |
  |   // Map.                                               |   )                                                      |
  |                                                         |     printf( "%d ", itr.data->key );                      |
  |   int_int_map our_map;                                  |   // Printed: 2 4 7 1 5 8                                |
  |   vt_init( &our_map );                                  |                                                          |
  |                                                         |   int_set_cleanup( &our_set );                           |
  |   // Inserting keys and values.                         |                                                          |
  |   for( int i = 0; i < 10; ++i )                         |   // Map.                                                |
  |   {                                                     |                                                          |
  |     int_int_map_itr itr =                               |   int_int_map our_map;                                   |
  |       vt_insert( &our_map, i, i + 1 );                  |   int_int_map_init( &our_map );                          |
  |     if( vt_is_end( itr ) )                              |                                                          |
  |     {                                                   |   // Inserting keys and values.                          |
  |       // Out of memory, so abort.                       |   for( int i = 0; i < 10; ++i )                          |
  |       vt_cleanup( &our_map );                           |   {                                                      |
  |       return 1;                                         |     int_int_map_itr itr =                                |
  |     }                                                   |       int_int_map_insert( &our_map, i, i + 1 );          |
  |   }                                                     |     if( int_int_map_is_end( itr ) )                      |
  |                                                         |     {                                                    |
  |   // Erasing keys and values.                           |       // Out of memory, so abort.                        |
  |   for( int i = 0; i < 10; i += 3 )                      |       int_int_map_cleanup( &our_map );                   |
  |     vt_erase( &our_map, i );                            |       return 1;                                          |
  |                                                         |     }                                                    |
  |   // Retrieving keys and values.                        |   }                                                      |
  |   for( int i = 0; i < 10; ++i )                         |                                                          |
  |   {                                                     |   // Erasing keys and values.                            |
  |     int_int_map_itr itr = vt_get( &our_map, i );        |   for( int i = 0; i < 10; i += 3 )                       |
  |     if( !vt_is_end( itr ) )                             |     int_int_map_erase( &our_map, i );                    |
  |       printf(                                           |                                                          |
  |         "%d:%d ",                                       |   // Retrieving keys and values.                         |
  |         itr.data->key,                                  |   for( int i = 0; i < 10; ++i )                          |
  |         itr.data->val                                   |   {                                                      |
  |       );                                                |     int_int_map_itr itr =                                |
  |   }                                                     |       int_int_map_get( &our_map, i );                    |
  |   // Printed: 1:2 2:3 4:5 5:6 7:8 8:9                   |     if( !int_int_map_is_end( itr ) )                     |
  |                                                         |       printf(                                            |
  |   // Iteration.                                         |         "%d:%d ",                                        |
  |   for(                                                  |         itr.data->key,                                   |
  |     int_int_map_itr itr = vt_first( &our_map );         |         itr.data->val                                    |
  |     !vt_is_end( itr );                                  |     );                                                   |
  |     itr = vt_next( itr )                                |   }                                                      |
  |   )                                                     |   // Printed: 1:2 2:3 4:5 5:6 7:8 8:9                    |
  |     printf(                                             |                                                          |
  |       "%d:%d ",                                         |   // Iteration.                                          |
  |       itr.data->key,                                    |   for(                                                   |
  |       itr.data->val                                     |     int_int_map_itr itr =                                |
  |     );                                                  |       int_int_map_first( &our_map );                     |
  |   // Printed: 2:3 4:5 7:8 1:2 5:6 8:9                   |     !int_int_map_is_end( itr );                          |
  |                                                         |     itr = int_int_map_next( itr )                        |
  |   vt_cleanup( &our_map );                               |   )                                                      |
  | }                                                       |     printf(                                              |
  |                                                         |       "%d:%d ",                                          |
  |                                                         |       itr.data->key,                                     |
  |                                                         |       itr.data->val                                      |
  |                                                         |     );                                                   |
  |                                                         |   // Printed: 2:3 4:5 7:8 1:2 5:6 8:9                    |
  |                                                         |                                                          |
  |                                                         |   int_int_map_cleanup( &our_map );                       |
  |                                                         | }                                                        |
  |                                                         |                                                          |
  +---------------------------------------------------------+----------------------------------------------------------+

API:

  Instantiating a hash table template:

    Create a new hash table type in the following manner:

      #define NAME   <your chosen type name>
      #define KEY_TY <type>
      #include "verstable.h"

    The NAME macro specifies the name of hash table type that the library will declare, the prefix for the functions
    associated with it, and the prefix for the associated iterator type.

    The KEY_TY macro specifies the key type.

    In C99, it is also always necessary to define HASH_FN and CMPR_FN (see below) before including the header.

    The following macros may also be defined before including the header:

      #define VAL_TY <type>

        The type of the value associated with each key.
        If this macro is defined, the hash table acts as a map associating keys with values.
        Otherwise, it acts as a set containing only keys.

      #define HASH_FN <function name>

        The name of the existing function used to hash each key.
        The function should have the signature uint64_t ( KEY_TY key ) and return a 64-bit hash code.
        For best performance, the hash function should provide a high level of entropy across all bits.
        There are two default hash functions: vt_hash_integer for all integer types up to 64 bits in size, and
        vt_hash_string for NULL-terminated strings (i.e. char *).
        When KEY_TY is one of such types and the compiler is in C11 mode or later, HASH_FN may be left undefined, in
        which case the appropriate default function is inferred from KEY_TY.
        Otherwise, HASH_FN must be defined.

      #define CMPR_FN <function name>

        The name of the existing function used to compare two keys.
        The function should have the signature bool ( KEY_TY key_1, KEY_TY key_2 ) and return true if the two keys are
        equal.
        There are two default comparison functions: vt_cmpr_integer for all integer types up to 64 bits in size, and
        vt_cmpr_string for NULL-terminated strings (i.e. char *).
        As with the default hash functions, in C11 or later the appropriate default comparison function is inferred if
        KEY_TY is one of such types and CMPR_FN is left undefined.
        Otherwise, CMPR_FN must be defined.

      #define MAX_LOAD <floating point value>

        The floating-point load factor at which the hash table automatically doubles the size of its internal buckets
        array.
        The default is 0.9, i.e. 90%.

      #define KEY_DTOR_FN <function name>

        The name of the existing destructor function, with the signature void ( KEY_TY key ), called on a key when it is
        erased from the table or replaced by a newly inserted key.
        The API functions that may call the key destructor are NAME_insert, NAME_erase, NAME_erase_itr, NAME_clear,
        and NAME_cleanup.

      #define VAL_DTOR_FN <function name>

        The name of the existing destructor function, with the signature void ( VAL_TY val ), called on a value when it
        is erased from the table or replaced by a newly inserted value.
        The API functions that may call the value destructor are NAME_insert, NAME_erase, NAME_erase_itr, NAME_clear,
        and NAME_cleanup.

      #define CTX_TY <type>

        The type of the hash table type's ctx (context) member.
        This member only exists if CTX_TY was defined.
        It is intended to be used in conjunction with MALLOC_FN and FREE_FN (see below).

      #define MALLOC_FN <function name>

        The name of the existing function used to allocate memory.
        If CTX_TY was defined, the signature should be void *( size_t size, CTX_TY *ctx ), where size is the number of
        bytes to allocate and ctx points to the table's ctx member.
        Otherwise, the signature should be void *( size_t size ).
        The default wraps stdlib.h's malloc.

      #define FREE_FN <function name>

        The name of the existing function used to free memory.
        If CTX_TY was defined, the signature should be void ( void *ptr, size_t size, CTX_TY *ctx ), where ptr points to
        the memory to free, size is the number of bytes that were allocated, and ctx points to the table's ctx member.
        Otherwise, the signature should be void ( void *ptr, size_t size ).
        The default wraps stdlib.h's free.

      #define HEADER_MODE
      #define IMPLEMENTATION_MODE

        By default, all hash table functions are defined as static inline functions, the intent being that a given hash
        table template should be instantiated once per translation unit; for best performance, this is the recommended
        way to use the library.
        However, it is also possible to separate the struct definitions and function declarations from the function
        definitions such that one implementation can be shared across all translation units (as in a traditional header
        and source file pair).
        In that case, instantiate a template wherever it is needed by defining HEADER_MODE, along with only NAME,
        KEY_TY, and (optionally) VAL_TY, CTX_TY, and header guards, and including the library, e.g.:

          #ifndef INT_INT_MAP_H
          #define INT_INT_MAP_H
          #define NAME   int_int_map
          #define KEY_TY int
          #define VAL_TY int
          #define HEADER_MODE
          #include "verstable.h"
          #endif

        In one source file, define IMPLEMENTATION_MODE, along with NAME, KEY_TY, and any of the aforementioned optional
        macros, and include the library, e.g.:

          #define NAME     int_int_map
          #define KEY_TY   int
          #define VAL_TY   int
          #define HASH_FN  vt_hash_integer // C99.
          #define CMPR_FN  vt_cmpr_integer // C99.
          #define MAX_LOAD 0.8
          #define IMPLEMENTATION_MODE
          #include "verstable.h"

    Including the library automatically undefines all the aforementioned macros after they have been used to instantiate
    the template.

  Functions:

    The functions associated with a hash table type are all prefixed with the name the user supplied via the NAME macro.
    In C11 and later, the generic "vt_"-prefixed macros may be used to automatically select the correct version of the
    specified function based on the arguments.

    void NAME_init( NAME *table )
    void NAME_init( NAME *table, CTX_TY ctx )
    // C11 generic macro: vt_init.

      Initializes the table for use.
      If CTX_TY was defined, ctx sets the table's ctx member.

    bool NAME_init_clone( NAME *table, NAME *source )
    bool NAME_init_clone( NAME *table, NAME *source, CTX_TY ctx )
    // C11 generic macro: vt_init_clone.

      Initializes the table as a shallow copy of the specified source table.
      If CTX_TY was defined, ctx sets the table's ctx member.
      Returns false in the case of memory allocation failure.

    size_t NAME_size( NAME *table ) // C11 generic macro: vt_size.

      Returns the number of keys currently in the table.

    size_t NAME_bucket_count( NAME *table ) // C11 generic macro: vt_bucket_count.

      Returns the table's current bucket count.

    NAME_itr NAME_insert( NAME *table, KEY_TY key )
    NAME_itr NAME_insert( NAME *table, KEY_TY key, VAL_TY val )
    // C11 generic macro: vt_insert.

      Inserts the specified key (and value, if VAL_TY was defined) into the hash table.
      If the same key already exists, then the new key (and value) replaces the existing key (and value).
      Returns an iterator to the new key, or an end iterator in the case of memory allocation failure.

    NAME_itr NAME_get_or_insert( NAME *table, KEY_TY key )
    NAME_itr NAME_get_or_insert( NAME *table, KEY_TY key, VAL_TY val )
    // C11 generic macro: vt_get_or_insert.

      Inserts the specified key (and value, if VAL_TY was defined) if it does not already exist in the table.
      Returns an iterator to the new key if it was inserted, or an iterator to the existing key, or an end iterator if
      the key did not exist but the new key could not be inserted because of memory allocation failure.
      Determine whether the key was inserted by comparing the table's size before and after the call.

    NAME_itr NAME_get( NAME *table, KEY_TY key ) // C11 generic macro: vt_get.

      Returns a iterator to the specified key, or an end iterator if no such key exists.

    bool NAME_erase( NAME *table, KEY_TY key ) // C11 generic macro: vt_erase.

      Erases the specified key (and associated value, if VAL_TY was defined), if it exists.
      Returns true if a key was erased.

    NAME_itr NAME_erase_itr( NAME *table, NAME_itr itr ) // C11 generic macro: vt_erase_itr.

      Erases the key (and associated value, if VAL_TY was defined) pointed to by the specified iterator.
      Returns an iterator to the next key in the table, or an end iterator if the erased key was the last one.

    bool NAME_reserve( NAME *table, size_t size ) // C11 generic macro: vt_reserve.

      Ensures that the bucket count is large enough to support the specified key count (i.e. size) without rehashing.
      Returns false if unsuccessful due to memory allocation failure.

    bool NAME_shrink( NAME *table ) // C11 generic macro: vt_shrink.

      Shrinks the bucket count to best accommodate the current size.
      Returns false if unsuccessful due to memory allocation failure.

    NAME_itr NAME_first( NAME *table ) // C11 generic macro: vt_first.

      Returns an iterator to the first key in the table, or an end iterator if the table is empty.

    bool NAME_is_end( NAME_itr itr ) // C11 generic macro: vt_is_end.

      Returns true if the iterator is an end iterator.

    NAME_itr NAME_next( NAME_itr itr ) // C11 generic macro: vt_next.

      Returns an iterator to the key after the one pointed to by the specified iterator, or an end iterator if the
      specified iterator points to the last key in the table.

    void NAME_clear( NAME *table ) // C11 generic macro: vt_clear.

      Erases all keys (and values, if VAL_TY was defined) in the table.

    void NAME_cleanup( NAME *table ) // C11 generic macro: vt_cleanup.

      Erases all keys (and values, if VAL_TY was defined) in the table, frees all memory associated with it, and
      initializes it for reuse.

  Iterators:

    Access the key (and value, if VAL_TY was defined) that an iterator points to using the NAME_itr struct's data
    member:

      itr.data->key
      itr.data->val

    Functions that may insert new keys (NAME_insert and NAME_get_or_insert), erase keys (NAME_erase and NAME_erase_itr),
    or reallocate the internal bucket array (NAME_reserve and NAME_shrink) invalidate all existing iterators.
    To delete keys during iteration and resume iterating, use the return value of NAME_erase_itr.

Version history:

  06/05/2025 2.2.1: Fixed incorrect signature of NAME_is_end in documentation.
  18/04/2025 2.2.0: Added const qualifier to the table parameter of NAME_size, NAME_bucket_count, NAME_get, and
                    NAME_first and to the source parameter of NAME_init_clone.
                    Added default support for const char * strings.
                    Added support for -Wextra.
                    Replaced FNV-1a with Wyhash as the default string hash function.
  18/06/2024 2.1.1: Fixed a bug affecting iteration on big-endian platforms under MSVC.
  27/05/2024 2.1.0: Replaced the Murmur3 mixer with the fast-hash mixer as the default integer hash function.
                    Fixed a bug that could theoretically cause a crash on rehash (triggerable in testing using
                    NAME_shrink with a maximum load factor significantly higher than 1.0).
  06/02/2024 2.0.0: Improved custom allocator support by introducing the CTX_TY option and allowing user-supplied free
                    functions to receive the allocation size.
                    Improved documentation.
                    Introduced various optimizations, including storing the buckets-array size mask instead of the
                    bucket count, eliminating empty-table checks, combining the buckets memory and metadata memory into
                    one allocation, and adding branch prediction macros.
                    Fixed a bug that caused a key to be used after destruction during erasure.
  12/12/2023 1.0.0: Initial release.

