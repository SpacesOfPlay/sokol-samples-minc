    }
    var newFlag = cast(u32, flag != 0 ? b3_bodyEnableContactRecycling : 0);
    b3Body* body = b3GetBodyFullId(world, bodyId);
    if (body.flags & cast(u32, b3_bodyEnableContactRecycling)) == newFlag {
