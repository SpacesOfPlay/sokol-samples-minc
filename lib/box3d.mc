            b3RecWrite_ShapeEnableSensorEvents(world.recording, &recArgs);
        }
        if !(0 != 0) { break; }
    }
    b3Shape* shape = b3GetShape(world, shapeId);
    shape.flags = cast(u8, flag != 0 ? shape.flags | b3_enableSensorEvents : shape.flags & ~b3_enableSensorEvents);
}

