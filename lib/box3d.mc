void b3RecDispatch_QueryCastRayClosest(b3RecArgs_QueryCastRayClosest* a, b3RecReader* rdr) {
    b3RayResult rec = b3RecR_RAYRESULT(rdr);
    if rdr.ok == 0 {
        return;
    }
    b3RayResult got = b3World_CastRayClosest(rdr.replayWorldId, a.origin, a.translation, a.filter);
    b3ShapeId recId = b3RecMakeShapeId(rdr, rec.shapeId);
    if got.hit != rec.hit || got.hit && (got.shapeId.index1 != recId.index1 || got.shapeId.generation != recId.generation || b3RecVec3Differs(b3SubPos(got.point, rec.point), b3Vec3_zero) || b3RecVec3Differs(got.normal, rec.normal) || b3RecF32Differs(got.fraction, rec.fraction) || got.userMaterialId != rec.userMaterialId) {
        rdr.diverged = true;
    }
    if rdr.owner != null {
        b3RecRecordedHit h;
        h.id = recId;
        h.point = rec.point;
        h.normal = rec.normal;
        h.fraction = rec.fraction;
        b3RecDrawQuery* q = b3RecStashQueryBegin(rdr.owner, B3_RECQ_CAST_RAY_CLOSEST, &h, rec.hit != 0 ? 1 : 0);
        q.filter = a.filter;
        q.origin = a.origin;
        q.translation = a.translation;
        q.rayResult = rec;
        b3RecComputeQueryBounds(q);
    }
}

void b3RecDispatch_QueryCastMover(b3RecArgs_QueryCastMover* a, b3RecReader* rdr) {
    u32 n = b3RecR_U32(rdr);
    b3RecEnsureHits(rdr, cast(i32, n));
    if rdr.ok == 0 {
        return;
    }
    for u32 i = 0; i < n; ++i {
        rdr.hits[i].id = b3RecMakeShapeId(rdr, b3RecR_SHAPEID(rdr));
        rdr.hits[i].userReturnB = b3RecR_BOOL(rdr);
    }
    f32 recFraction = b3RecR_F32(rdr);
    if rdr.ok == 0 {
        return;
    }
    var rc = b3RecReplayQueryCtx{rdr, rdr.hits, cast(i32, n), 0};
    f32 got = b3World_CastMover(rdr.replayWorldId, a.origin, &a.mover, a.translation, a.filter, cast(b3MoverFilterFcn, b3RecReplayMoverFilterTrampoline), &rc);
    if rc.cursor != cast(i32, n) || b3RecF32Differs(got, recFraction) {
        rdr.diverged = true;
    }
    if rdr.owner != null {
        b3RecDrawQuery* q = b3RecStashQueryBegin(rdr.owner, B3_RECQ_CAST_MOVER, null, 0);
        q.filter = a.filter;
        q.origin = a.origin;
        q.mover = a.mover;
        q.translation = a.translation;
        q.castFraction = recFraction;
        b3RecComputeQueryBounds(q);
    }
}

void b3RecDispatch_QueryCollideMover(b3RecArgs_QueryCollideMover* a, b3RecReader* rdr) {
    u32 shapeCount = b3RecR_U32(rdr);
    i32 total = 0;
    for u32 s = 0; s < shapeCount; ++s {
        b3ShapeId id = b3RecMakeShapeId(rdr, b3RecR_SHAPEID(rdr));
        i32 planeCount = b3RecR_I32(rdr);
        if planeCount < 0 {
            planeCount = 0;
        }
        b3RecEnsureHits(rdr, total + planeCount);
        if rdr.ok == 0 {
            return;
        }
        for i32 i = 0; i < planeCount; ++i {
            rdr.hits[total + i].plane = b3RecR_PLANERESULT(rdr);
        }
        bool ret = b3RecR_BOOL(rdr);
        for i32 i = 0; i < planeCount; ++i {
            rdr.hits[total + i].id = id;
            rdr.hits[total + i].planeCount = planeCount;
            rdr.hits[total + i].userReturnB = ret;
        }
        total += planeCount;
    }
    if rdr.ok == 0 {
        return;
    }
    var rc = b3RecReplayQueryCtx{rdr, rdr.hits, total, 0};
    b3World_CollideMover(rdr.replayWorldId, a.origin, &a.mover, a.filter, cast(b3PlaneResultFcn, b3RecReplayPlaneTrampoline), &rc);
    if rc.cursor != total {
        rdr.diverged = true;
    }
    if rdr.owner != null {
        b3RecDrawQuery* q = b3RecStashQueryBegin(rdr.owner, B3_RECQ_COLLIDE_MOVER, rdr.hits, total);
        q.filter = a.filter;
        q.origin = a.origin;
        q.mover = a.mover;
        b3RecComputeQueryBounds(q);
    }
}

// Stash the identity key of the query that immediately follows. Consumed by the next stash.
void b3RecDispatch_QueryTag(b3RecArgs_QueryTag* a, b3RecReader* rdr) {
    rdr.pendingQueryKey = a.key;
}

// X-macro dispatch switch: read opcode+u24 payloadSize, dispatch, skip unknown ops.
// Returns the opcode dispatched, or -1 when the stream is exhausted or broken.
i32 b3RecDispatchOne(b3RecReader* rdr) {
    if rdr.cursor >= rdr.size || !rdr.ok {
        return -1;
    }
    u8 opcode = b3RecR_U8(rdr);
    u32 payloadSize = b3RecR_U24(rdr);
    if rdr.ok == 0 {
        return -1;
    }
    i32 payloadStart = rdr.cursor;
    switch opcode {
        case 0x01: {
            {
                b3RecArgs_DestroyWorld a;
                a.world = b3RecR_WORLDID(rdr);
                if rdr.ok != 0 {
                    b3RecDispatch_DestroyWorld(&a, rdr);
                }
                break case;
            }
        }
        case 0x80: {
            {
                b3RecArgs_Step a;
                a.world = b3RecR_WORLDID(rdr);
                a.dt = b3RecR_F32(rdr);
                a.subStepCount = b3RecR_I32(rdr);
                if rdr.ok != 0 {
                    b3RecDispatch_Step(&a, rdr);
                }
                break case;
            }
        }
        case 0x02: {
            {
                b3RecArgs_WorldEnableSleeping a;
                a.world = b3RecR_WORLDID(rdr);
                a.flag = b3RecR_BOOL(rdr);
                if rdr.ok != 0 {
                    b3RecDispatch_WorldEnableSleeping(&a, rdr);
                }
                break case;
            }
        }
        case 0x03: {
            {
                b3RecArgs_WorldEnableContinuous a;
                a.world = b3RecR_WORLDID(rdr);
                a.flag = b3RecR_BOOL(rdr);
                if rdr.ok != 0 {
                    b3RecDispatch_WorldEnableContinuous(&a, rdr);
                }
                break case;
            }
        }
        case 0x04: {
            {
                b3RecArgs_WorldSetRestitutionThreshold a;
                a.world = b3RecR_WORLDID(rdr);
                a.value = b3RecR_F32(rdr);
                if rdr.ok != 0 {
                    b3RecDispatch_WorldSetRestitutionThreshold(&a, rdr);
                }
                break case;
            }
        }
        case 0x05: {
            {
                b3RecArgs_WorldSetHitEventThreshold a;
                a.world = b3RecR_WORLDID(rdr);
                a.value = b3RecR_F32(rdr);
                if rdr.ok != 0 {
                    b3RecDispatch_WorldSetHitEventThreshold(&a, rdr);
                }
                break case;
            }
        }
        case 0x06: {
            {
                b3RecArgs_WorldSetGravity a;
                a.world = b3RecR_WORLDID(rdr);
                a.gravity = b3RecR_VEC3(rdr);
                if rdr.ok != 0 {
                    b3RecDispatch_WorldSetGravity(&a, rdr);
                }
                break case;
            }
        }
        case 0x07: {
            {
                b3RecArgs_WorldExplode a;
                a.world = b3RecR_WORLDID(rdr);
                a.def = b3RecR_EXPLOSIONDEF(rdr);
                if rdr.ok != 0 {
                    b3RecDispatch_WorldExplode(&a, rdr);
                }
                break case;
            }
        }
        case 0x08: {
            {
                b3RecArgs_WorldSetContactTuning a;
                a.world = b3RecR_WORLDID(rdr);
                a.hertz = b3RecR_F32(rdr);
                a.dampingRatio = b3RecR_F32(rdr);
                a.contactSpeed = b3RecR_F32(rdr);
                if rdr.ok != 0 {
                    b3RecDispatch_WorldSetContactTuning(&a, rdr);
                }
                break case;
            }
        }
        case 0x09: {
            {
                b3RecArgs_WorldSetContactRecycleDistance a;
                a.world = b3RecR_WORLDID(rdr);
                a.recycleDistance = b3RecR_F32(rdr);
                if rdr.ok != 0 {
                    b3RecDispatch_WorldSetContactRecycleDistance(&a, rdr);
                }
                break case;
            }
        }
        case 0x0A: {
            {
                b3RecArgs_WorldSetMaximumLinearSpeed a;
                a.world = b3RecR_WORLDID(rdr);
                a.maximumLinearSpeed = b3RecR_F32(rdr);
                if rdr.ok != 0 {
                    b3RecDispatch_WorldSetMaximumLinearSpeed(&a, rdr);
                }
                break case;
            }
        }
        case 0x0B: {
            {
                b3RecArgs_WorldEnableWarmStarting a;
                a.world = b3RecR_WORLDID(rdr);
                a.flag = b3RecR_BOOL(rdr);
                if rdr.ok != 0 {
                    b3RecDispatch_WorldEnableWarmStarting(&a, rdr);
                }
                break case;
            }
        }
        case 0x0C: {
            {
                b3RecArgs_WorldRebuildStaticTree a;
                a.world = b3RecR_WORLDID(rdr);
                if rdr.ok != 0 {
                    b3RecDispatch_WorldRebuildStaticTree(&a, rdr);
                }
                break case;
            }
        }
        case 0x0D: {
            {
                b3RecArgs_WorldEnableSpeculative a;
                a.world = b3RecR_WORLDID(rdr);
                a.flag = b3RecR_BOOL(rdr);
                if rdr.ok != 0 {
                    b3RecDispatch_WorldEnableSpeculative(&a, rdr);
                }
                break case;
            }
        }
        case 0x10: {
            {
                b3RecArgs_CreateBody a;
                a.world = b3RecR_WORLDID(rdr);
                a.def = b3RecR_BODYDEF(rdr);
                if rdr.ok != 0 {
                    b3RecDispatch_CreateBody(&a, rdr);
                }
                break case;
            }
        }
        case 0x11: {
            {
                b3RecArgs_DestroyBody a;
                a.body = b3RecR_BODYID(rdr);
                if rdr.ok != 0 {
                    b3RecDispatch_DestroyBody(&a, rdr);
                }
                break case;
            }
        }
        case 0x20: {
            {
                b3RecArgs_BodySetTransform a;
                a.body = b3RecR_BODYID(rdr);
                a.position = b3RecR_POSITION(rdr);
                a.rotation = b3RecR_QUAT(rdr);
                if rdr.ok != 0 {
                    b3RecDispatch_BodySetTransform(&a, rdr);
                }
                break case;
            }
        }
        case 0x21: {
            {
                b3RecArgs_BodySetLinearVelocity a;
                a.body = b3RecR_BODYID(rdr);
                a.v = b3RecR_VEC3(rdr);
                if rdr.ok != 0 {
                    b3RecDispatch_BodySetLinearVelocity(&a, rdr);
                }
                break case;
            }
        }
        case 0x22: {
            {
                b3RecArgs_BodySetType a;
                a.body = b3RecR_BODYID(rdr);
                a.type = b3RecR_I32(rdr);
                if rdr.ok != 0 {
                    b3RecDispatch_BodySetType(&a, rdr);
                }
                break case;
            }
        }
        case 0x23: {
            {
                b3RecArgs_BodySetName a;
                a.body = b3RecR_BODYID(rdr);
                a.name = b3RecR_STR(rdr);
                if rdr.ok != 0 {
                    b3RecDispatch_BodySetName(&a, rdr);
                }
                break case;
            }
        }
        case 0x24: {
            {
                b3RecArgs_BodySetAngularVelocity a;
                a.body = b3RecR_BODYID(rdr);
                a.w = b3RecR_VEC3(rdr);
                if rdr.ok != 0 {
                    b3RecDispatch_BodySetAngularVelocity(&a, rdr);
                }
                break case;
            }
        }
        case 0x25: {
            {
                b3RecArgs_BodySetTargetTransform a;
                a.body = b3RecR_BODYID(rdr);
                a.target = b3RecR_WORLDXF(rdr);
                a.timeStep = b3RecR_F32(rdr);
                a.wake = b3RecR_BOOL(rdr);
                if rdr.ok != 0 {
                    b3RecDispatch_BodySetTargetTransform(&a, rdr);
                }
                break case;
            }
        }
        case 0x26: {
            {
                b3RecArgs_BodyApplyForce a;
                a.body = b3RecR_BODYID(rdr);
                a.force = b3RecR_VEC3(rdr);
                a.point = b3RecR_POSITION(rdr);
                a.wake = b3RecR_BOOL(rdr);
                if rdr.ok != 0 {
                    b3RecDispatch_BodyApplyForce(&a, rdr);
                }
                break case;
            }
        }
        case 0x27: {
            {
                b3RecArgs_BodyApplyForceToCenter a;
                a.body = b3RecR_BODYID(rdr);
                a.force = b3RecR_VEC3(rdr);
                a.wake = b3RecR_BOOL(rdr);
                if rdr.ok != 0 {
                    b3RecDispatch_BodyApplyForceToCenter(&a, rdr);
                }
                break case;
            }
        }
        case 0x28: {
            {
                b3RecArgs_BodyApplyTorque a;
                a.body = b3RecR_BODYID(rdr);
                a.torque = b3RecR_VEC3(rdr);
                a.wake = b3RecR_BOOL(rdr);
                if rdr.ok != 0 {
                    b3RecDispatch_BodyApplyTorque(&a, rdr);
                }
                break case;
            }
        }
        case 0x29: {
            {
                b3RecArgs_BodyApplyLinearImpulse a;
                a.body = b3RecR_BODYID(rdr);
                a.impulse = b3RecR_VEC3(rdr);
                a.point = b3RecR_POSITION(rdr);
                a.wake = b3RecR_BOOL(rdr);
                if rdr.ok != 0 {
                    b3RecDispatch_BodyApplyLinearImpulse(&a, rdr);
                }
                break case;
            }
        }
        case 0x2A: {
            {
                b3RecArgs_BodyApplyLinearImpulseToCenter a;
                a.body = b3RecR_BODYID(rdr);
                a.impulse = b3RecR_VEC3(rdr);
                a.wake = b3RecR_BOOL(rdr);
                if rdr.ok != 0 {
                    b3RecDispatch_BodyApplyLinearImpulseToCenter(&a, rdr);
                }
                break case;
            }
        }
        case 0x2B: {
            {
                b3RecArgs_BodyApplyAngularImpulse a;
                a.body = b3RecR_BODYID(rdr);
                a.impulse = b3RecR_VEC3(rdr);
                a.wake = b3RecR_BOOL(rdr);
                if rdr.ok != 0 {
                    b3RecDispatch_BodyApplyAngularImpulse(&a, rdr);
                }
                break case;
            }
        }
        case 0x2C: {
            {
                b3RecArgs_BodySetMassData a;
                a.body = b3RecR_BODYID(rdr);
                a.massData = b3RecR_MASSDATA(rdr);
                if rdr.ok != 0 {
                    b3RecDispatch_BodySetMassData(&a, rdr);
                }
                break case;
            }
        }
        case 0x2D: {
            {
                b3RecArgs_BodyApplyMassFromShapes a;
                a.body = b3RecR_BODYID(rdr);
                if rdr.ok != 0 {
                    b3RecDispatch_BodyApplyMassFromShapes(&a, rdr);
                }
                break case;
            }
        }
        case 0x2E: {
            {
                b3RecArgs_BodySetLinearDamping a;
                a.body = b3RecR_BODYID(rdr);
                a.damping = b3RecR_F32(rdr);
                if rdr.ok != 0 {
                    b3RecDispatch_BodySetLinearDamping(&a, rdr);
                }
                break case;
            }
        }
        case 0x2F: {
            {
                b3RecArgs_BodySetAngularDamping a;
                a.body = b3RecR_BODYID(rdr);
                a.damping = b3RecR_F32(rdr);
                if rdr.ok != 0 {
                    b3RecDispatch_BodySetAngularDamping(&a, rdr);
                }
                break case;
            }
        }
        case 0x30: {
            {
                b3RecArgs_BodySetGravityScale a;
                a.body = b3RecR_BODYID(rdr);
                a.scale = b3RecR_F32(rdr);
                if rdr.ok != 0 {
                    b3RecDispatch_BodySetGravityScale(&a, rdr);
                }
                break case;
            }
        }
        case 0x31: {
            {
                b3RecArgs_BodySetAwake a;
                a.body = b3RecR_BODYID(rdr);
                a.awake = b3RecR_BOOL(rdr);
                if rdr.ok != 0 {
                    b3RecDispatch_BodySetAwake(&a, rdr);
                }
                break case;
            }
        }
        case 0x32: {
            {
                b3RecArgs_BodyEnableSleep a;
                a.body = b3RecR_BODYID(rdr);
                a.flag = b3RecR_BOOL(rdr);
                if rdr.ok != 0 {
                    b3RecDispatch_BodyEnableSleep(&a, rdr);
                }
                break case;
            }
        }
        case 0x33: {
            {
                b3RecArgs_BodySetSleepThreshold a;
                a.body = b3RecR_BODYID(rdr);
                a.threshold = b3RecR_F32(rdr);
                if rdr.ok != 0 {
                    b3RecDispatch_BodySetSleepThreshold(&a, rdr);
                }
                break case;
            }
        }
        case 0x34: {
            {
                b3RecArgs_BodyDisable a;
                a.body = b3RecR_BODYID(rdr);
                if rdr.ok != 0 {
                    b3RecDispatch_BodyDisable(&a, rdr);
                }
                break case;
            }
        }
        case 0x35: {
            {
                b3RecArgs_BodyEnable a;
                a.body = b3RecR_BODYID(rdr);
                if rdr.ok != 0 {
                    b3RecDispatch_BodyEnable(&a, rdr);
                }
                break case;
