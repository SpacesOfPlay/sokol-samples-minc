    ignore color;
    ignore alpha;
    ignore context;
}

void b3EmptyDrawCapsule(b3Pos p1, b3Pos p2, f32 radius, b3HexColor color, f32 alpha, void* context) {
    ignore p1;
    ignore p2;
    ignore radius;
    ignore color;
    ignore alpha;
    ignore context;
}

void b3EmptyDrawBounds(b3AABB aabb, b3HexColor color, void* context) {
