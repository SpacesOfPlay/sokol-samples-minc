        case 0xEB: {
            {
                b3RecArgs_QueryCastShape a;
                a.world = b3RecR_WORLDID(rdr);
                a.origin = b3RecR_POSITION(rdr);
                a.proxy = b3RecR_SHAPEPROXY(rdr);
                a.translation = b3RecR_VEC3(rdr);
                a.filter = b3RecR_QUERYFILTER(rdr);
