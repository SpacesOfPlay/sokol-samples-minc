    b3JointSim* base = b3GetJointSimCheckType(jointId, b3_revoluteJoint);
    return world.inv_h * base.revoluteJoint.motorImpulse;
}

b3Vec3 b3GetRevoluteJointForce(b3World* world, b3JointSim* base) {
    b3Vec3 force = b3MulSV(world.inv_h, base.revoluteJoint.linearImpulse);
    return force;
}

b3Vec3 b3GetRevoluteJointTorque(b3World* world, b3JointSim* base) {
    b3WorldTransform transformA = b3GetBodyTransform(world, base.bodyIdA);
    b3RevoluteJoint* joint = &base.revoluteJoint;
    b3Vec3 axis = b3RotateVector(base.localFrameA.q, b3Vec3_axisZ);
    axis = b3RotateVector(transformA.q, axis);
    b3Quat relQ = b3InvMulQuat(joint.frameA.q, joint.frameB.q);
    joint.perpAxisX = b3MulSV(0.5f, b3RotateVector(joint.frameA.q, b3Add(b3MulSV(relQ.s, b3Vec3_axisX), b3Cross(relQ.v, b3Vec3_axisX))));
    joint.perpAxisY = b3MulSV(0.5f, b3RotateVector(joint.frameA.q, b3Add(b3MulSV(relQ.s, b3Vec3_axisY), b3Cross(relQ.v, b3Vec3_axisY))));
    f32 axialImpulse = joint.springImpulse + joint.motorImpulse + joint.lowerImpulse - joint.upperImpulse;
    b3Vec3 angularImpulse = b3Add(b3MulSV(joint.perpImpulse.x, joint.perpAxisX), b3MulSV(joint.perpImpulse.y, joint.perpAxisY));
    angularImpulse = b3MulAdd(angularImpulse, axialImpulse, joint.rotationAxisZ);
    b3Vec3 impulse = b3MulAdd(angularImpulse, joint.springImpulse + joint.motorImpulse + joint.lowerImpulse - joint.upperImpulse, axis);
    b3Vec3 torque = b3MulSV(world.inv_h, impulse);
    return torque;
}

void b3PrepareRevoluteJoint(b3JointSim* base, b3StepContext* context) {
    b3World* world = context.world;
    b3Body* bodyA = world.bodies.data + base.bodyIdA;
    b3Body* bodyB = world.bodies.data + base.bodyIdB;
    b3SolverSet* setA = world.solverSets.data + bodyA.setIndex;
    b3SolverSet* setB = world.solverSets.data + bodyB.setIndex;
    i32 localIndexA = bodyA.localIndex;
    i32 localIndexB = bodyB.localIndex;
    b3BodySim* bodySimA = setA.bodySims.data + localIndexA;
    b3BodySim* bodySimB = setB.bodySims.data + localIndexB;
    base.invMassA = bodySimA.invMass;
    base.invMassB = bodySimB.invMass;
    base.invIA = bodySimA.invInertiaWorld;
    base.invIB = bodySimB.invInertiaWorld;
    b3Matrix3 invInertiaSum = b3AddMM(base.invIA, base.invIB);
    base.fixedRotation = b3Det(invInertiaSum) < 1000.0f * FLT_MIN;
    b3RevoluteJoint* joint = &base.revoluteJoint;
    joint.indexA = bodyA.setIndex == b3_awakeSet ? localIndexA : -1;
    joint.indexB = bodyB.setIndex == b3_awakeSet ? localIndexB : -1;
    joint.frameA.q = b3MulQuat(bodySimA.transform.q, base.localFrameA.q);
    joint.frameA.p = b3RotateVector(bodySimA.transform.q, b3Sub(base.localFrameA.p, bodySimA.localCenter));
    joint.frameB.q = b3MulQuat(bodySimB.transform.q, base.localFrameB.q);
    joint.frameB.p = b3RotateVector(bodySimB.transform.q, b3Sub(base.localFrameB.p, bodySimB.localCenter));
    joint.deltaCenter = b3SubPos(bodySimB.center, bodySimA.center);
    {
        b3Vec3 rotationAxisZ = b3RotateVector(joint.frameA.q, b3Vec3_axisZ);
        f32 k = b3Dot(rotationAxisZ, b3MulMV(invInertiaSum, rotationAxisZ));
        joint.axialMass = k > 0.0f ? 1.0f / k : 0.0f;
        joint.rotationAxisZ = rotationAxisZ;
    }
    b3Quat relQ = b3InvMulQuat(joint.frameA.q, joint.frameB.q);
    {
        joint.perpAxisX = b3MulSV(0.5f, b3RotateVector(joint.frameA.q, b3Add(b3MulSV(relQ.s, b3Vec3_axisX), b3Cross(relQ.v, b3Vec3_axisX))));
        joint.perpAxisY = b3MulSV(0.5f, b3RotateVector(joint.frameA.q, b3Add(b3MulSV(relQ.s, b3Vec3_axisY), b3Cross(relQ.v, b3Vec3_axisY))));
    }
    joint.springSoftness = b3MakeSoft(joint.hertz, joint.dampingRatio, context.h);
    if context.enableWarmStarting == false {
        joint.linearImpulse = b3Vec3_zero;
        joint.perpImpulse = b3Vec2{0.0f, 0.0f};
        joint.motorImpulse = 0.0f;
        joint.springImpulse = 0.0f;
        joint.lowerImpulse = 0.0f;
        joint.upperImpulse = 0.0f;
    }
}

void b3WarmStartRevoluteJoint(b3JointSim* base, b3StepContext* context) {
    f32 mA = base.invMassA;
    f32 mB = base.invMassB;
    b3Matrix3 iA = base.invIA;
    b3Matrix3 iB = base.invIB;
    b3BodyState dummyState = b3_identityBodyState;
    b3RevoluteJoint* joint = &base.revoluteJoint;
    b3BodyState* stateA = joint.indexA == -1 ? &dummyState : context.states + joint.indexA;
    b3BodyState* stateB = joint.indexB == -1 ? &dummyState : context.states + joint.indexB;
    b3Vec3 vA = stateA.linearVelocity;
    b3Vec3 wA = stateA.angularVelocity;
    b3Vec3 vB = stateB.linearVelocity;
    b3Vec3 wB = stateB.angularVelocity;
    b3Vec3 rA = b3RotateVector(stateA.deltaRotation, joint.frameA.p);
    b3Vec3 rB = b3RotateVector(stateB.deltaRotation, joint.frameB.p);
    f32 axialImpulse = joint.springImpulse + joint.motorImpulse + joint.lowerImpulse - joint.upperImpulse;
    b3Vec3 angularImpulse = b3Add(b3MulSV(joint.perpImpulse.x, joint.perpAxisX), b3MulSV(joint.perpImpulse.y, joint.perpAxisY));
    angularImpulse = b3MulAdd(angularImpulse, axialImpulse, joint.rotationAxisZ);
    vA = b3MulSub(vA, mA, joint.linearImpulse);
    wA = b3Sub(wA, b3MulMV(iA, b3Add(b3Cross(rA, joint.linearImpulse), angularImpulse)));
    vB = b3MulAdd(vB, mB, joint.linearImpulse);
    wB = b3Add(wB, b3MulMV(iB, b3Add(b3Cross(rB, joint.linearImpulse), angularImpulse)));
    if (stateA.flags & cast(u32, b3_dynamicFlag)) != 0 {
        stateA.linearVelocity = vA;
        stateA.angularVelocity = wA;
    }
    if (stateB.flags & cast(u32, b3_dynamicFlag)) != 0 {
        stateB.linearVelocity = vB;
        stateB.angularVelocity = wB;
    }
}

void b3SolveRevoluteJoint(b3JointSim* base, b3StepContext* context, bool useBias) {
    f32 mA = base.invMassA;
    f32 mB = base.invMassB;
    b3Matrix3 iA = base.invIA;
    b3Matrix3 iB = base.invIB;
    b3BodyState dummyState = b3_identityBodyState;
    b3RevoluteJoint* joint = &base.revoluteJoint;
    b3BodyState* stateA = joint.indexA == -1 ? &dummyState : context.states + joint.indexA;
    b3BodyState* stateB = joint.indexB == -1 ? &dummyState : context.states + joint.indexB;
    b3Vec3 vA = stateA.linearVelocity;
    b3Vec3 wA = stateA.angularVelocity;
    b3Vec3 vB = stateB.linearVelocity;
    b3Vec3 wB = stateB.angularVelocity;
    bool fixedRotation = base.fixedRotation;
    b3Quat quatA = b3MulQuat(stateA.deltaRotation, joint.frameA.q);
    b3Quat quatB = b3MulQuat(stateB.deltaRotation, joint.frameB.q);
    if b3DotQuat(quatA, quatB) < 0.0f {
        quatB = b3NegateQuat(quatB);
    }
    b3Quat relQ = b3InvMulQuat(quatA, quatB);
    if joint.enableSpring && fixedRotation == false {
        f32 targetAngle = joint.targetAngle;
        f32 angle = b3GetTwistAngle(relQ);
        f32 c = angle - targetAngle;
        f32 bias = joint.springSoftness.biasRate * c;
        f32 massScale = joint.springSoftness.massScale;
        f32 impulseScale = joint.springSoftness.impulseScale;
        f32 cdot = b3Dot(b3Sub(wB, wA), joint.rotationAxisZ);
        f32 deltaImpulse = -massScale * joint.axialMass * (cdot + bias) - impulseScale * joint.springImpulse;
        joint.springImpulse += deltaImpulse;
        wA = b3MulSub(wA, deltaImpulse, b3MulMV(iA, joint.rotationAxisZ));
        wB = b3MulAdd(wB, deltaImpulse, b3MulMV(iB, joint.rotationAxisZ));
    }
    if joint.enableMotor && fixedRotation == false {
        f32 cdot = b3Dot(b3Sub(wB, wA), joint.rotationAxisZ) - joint.motorSpeed;
        f32 deltaImpulse = -joint.axialMass * cdot;
        f32 newImpulse = joint.motorImpulse + deltaImpulse;
        f32 maxImpulse = joint.maxMotorTorque * context.h;
        newImpulse = b3ClampFloat(newImpulse, -maxImpulse, maxImpulse);
        deltaImpulse = newImpulse - joint.motorImpulse;
        joint.motorImpulse = newImpulse;
        wA = b3MulSub(wA, deltaImpulse, b3MulMV(iA, joint.rotationAxisZ));
        wB = b3MulAdd(wB, deltaImpulse, b3MulMV(iB, joint.rotationAxisZ));
    }
    if joint.enableLimit && fixedRotation == false {
        f32 angle = b3GetTwistAngle(relQ);
        b3Vec3 axis = joint.rotationAxisZ;
        {
            f32 c = angle - joint.lowerAngle;
            f32 bias = 0.0f;
            f32 massScale = 1.0f;
            f32 impulseScale = 0.0f;
            if c > 0.0f {
                bias = c * context.inv_h;
            } else if useBias != 0 {
                bias = base.constraintSoftness.biasRate * c;
                massScale = base.constraintSoftness.massScale;
                impulseScale = base.constraintSoftness.impulseScale;
            }
            f32 cdot = b3Dot(b3Sub(wB, wA), axis);
            f32 oldImpulse = joint.lowerImpulse;
            f32 deltaImpulse = -massScale * joint.axialMass * (cdot + bias) - impulseScale * oldImpulse;
            joint.lowerImpulse = b3MaxFloat(oldImpulse + deltaImpulse, 0.0f);
            deltaImpulse = joint.lowerImpulse - oldImpulse;
            wA = b3MulSub(wA, deltaImpulse, b3MulMV(iA, axis));
            wB = b3MulAdd(wB, deltaImpulse, b3MulMV(iB, axis));
        }
        {
            f32 c = joint.upperAngle - angle;
            f32 bias = 0.0f;
            f32 massScale = 1.0f;
            f32 impulseScale = 0.0f;
            if c > 0.0f {
                bias = c * context.inv_h;
            } else if useBias != 0 {
                bias = base.constraintSoftness.biasRate * c;
                massScale = base.constraintSoftness.massScale;
                impulseScale = base.constraintSoftness.impulseScale;
            }
            f32 cdot = b3Dot(b3Sub(wA, wB), axis);
            f32 oldImpulse = joint.upperImpulse;
            f32 deltaImpulse = -massScale * joint.axialMass * (cdot + bias) - impulseScale * oldImpulse;
            joint.upperImpulse = b3MaxFloat(oldImpulse + deltaImpulse, 0.0f);
            deltaImpulse = joint.upperImpulse - oldImpulse;
            wA = b3MulAdd(wA, deltaImpulse, b3MulMV(iA, axis));
            wB = b3MulSub(wB, deltaImpulse, b3MulMV(iB, axis));
        }
    }
    if fixedRotation == false {
        var bias = b3Vec2{0.0f, 0.0f};
        f32 massScale = 1.0f;
        f32 impulseScale = 0.0f;
        if useBias != 0 {
            var c = b3Vec2{relQ.v.x, relQ.v.y};
            bias = b3MulSV2(base.constraintSoftness.biasRate, c);
            massScale = base.constraintSoftness.massScale;
            impulseScale = base.constraintSoftness.impulseScale;
        }
        b3Vec3 perpAxisX = b3MulSV(0.5f, b3RotateVector(quatA, b3Add(b3MulSV(relQ.s, b3Vec3_axisX), b3Cross(relQ.v, b3Vec3_axisX))));
        b3Vec3 perpAxisY = b3MulSV(0.5f, b3RotateVector(quatA, b3Add(b3MulSV(relQ.s, b3Vec3_axisY), b3Cross(relQ.v, b3Vec3_axisY))));
        joint.perpAxisX = perpAxisX;
        joint.perpAxisY = perpAxisY;
        b3Matrix3 invInertiaSum = b3AddMM(iA, iB);
        f32 kxx = b3Dot(perpAxisX, b3MulMV(invInertiaSum, perpAxisX));
        f32 kyy = b3Dot(perpAxisY, b3MulMV(invInertiaSum, perpAxisY));
        f32 kxy = b3Dot(perpAxisX, b3MulMV(invInertiaSum, perpAxisY));
        var k = b3Matrix2{b3Vec2{kxx, kxy}, b3Vec2{kxy, kyy}};
        b3Vec3 wRel = b3Sub(wB, wA);
        var cdot = b3Vec2{b3Dot(wRel, perpAxisX), b3Dot(wRel, perpAxisY)};
        b3Vec2 oldImpulse = joint.perpImpulse;
        b3Vec2 sol = b3Solve2(k, b3Add2(cdot, bias));
        b3Vec2 deltaImpulse = b3Sub2(b3MulSV2(-massScale, sol), b3MulSV2(impulseScale, oldImpulse));
        joint.perpImpulse = b3Add2(joint.perpImpulse, deltaImpulse);
        b3Vec3 angularImpulse = b3Add(b3MulSV(deltaImpulse.x, perpAxisX), b3MulSV(deltaImpulse.y, perpAxisY));
        wA = b3Sub(wA, b3MulMV(iA, angularImpulse));
        wB = b3Add(wB, b3MulMV(iB, angularImpulse));
    }
    {
        b3Vec3 rA = b3RotateVector(stateA.deltaRotation, joint.frameA.p);
        b3Vec3 rB = b3RotateVector(stateB.deltaRotation, joint.frameB.p);
        b3Vec3 cdot = b3Sub(b3Sub(b3Add(vB, b3Cross(wB, rB)), vA), b3Cross(wA, rA));
        b3Vec3 bias = b3Vec3_zero;
        f32 massScale = 1.0f;
        f32 impulseScale = 0.0f;
        if useBias != 0 {
            b3Vec3 dcA = stateA.deltaPosition;
            b3Vec3 dcB = stateB.deltaPosition;
            b3Vec3 separation = b3Add(b3Add(b3Sub(dcB, dcA), b3Sub(rB, rA)), joint.deltaCenter);
            bias = b3MulSV(base.constraintSoftness.biasRate, separation);
            massScale = base.constraintSoftness.massScale;
            impulseScale = base.constraintSoftness.impulseScale;
        }
        b3Matrix3 sA = b3Skew(rA);
        b3Matrix3 sB = b3Skew(rB);
        b3Matrix3 kA = b3MulMM(sA, b3MulMM(base.invIA, sA));
        b3Matrix3 kB = b3MulMM(sB, b3MulMM(base.invIB, sB));
        b3Matrix3 k = b3NegateMat3(b3AddMM(kA, kB));
        k.cx.x += mA + mB;
        k.cy.y += mA + mB;
        k.cz.z += mA + mB;
        b3Vec3 b = b3Solve3(k, b3Add(cdot, bias));
        b3Vec3 impulse = b3Sub(b3MulSV(-massScale, b), b3MulSV(impulseScale, joint.linearImpulse));
        joint.linearImpulse = b3Add(joint.linearImpulse, impulse);
        vA = b3MulSub(vA, mA, impulse);
        wA = b3Sub(wA, b3MulMV(iA, b3Cross(rA, impulse)));
        vB = b3MulAdd(vB, mB, impulse);
        wB = b3Add(wB, b3MulMV(iB, b3Cross(rB, impulse)));
    }
    if (stateA.flags & cast(u32, b3_dynamicFlag)) != 0 {
        stateA.linearVelocity = vA;
        stateA.angularVelocity = wA;
    }
    if (stateB.flags & cast(u32, b3_dynamicFlag)) != 0 {
        stateB.linearVelocity = vB;
        stateB.angularVelocity = wB;
    }
}

void b3DrawRevoluteJoint(b3DebugDraw* draw, b3JointSim* base, b3WorldTransform transformA, b3WorldTransform transformB, f32 scale) {
    b3WorldTransform frameA = b3MulWorldTransforms(transformA, base.localFrameA);
    f32 length1 = 0.1f * scale;
    draw.DrawSegmentFcn(frameA.p, b3OffsetPos(frameA.p, b3MulSV(length1, b3RotateVector(frameA.q, b3Vec3_axisX))), b3_colorRed, draw.context);
    draw.DrawSegmentFcn(frameA.p, b3OffsetPos(frameA.p, b3MulSV(length1, b3RotateVector(frameA.q, b3Vec3_axisY))), b3_colorGreen, draw.context);
    draw.DrawSegmentFcn(frameA.p, b3OffsetPos(frameA.p, b3MulSV(length1, b3RotateVector(frameA.q, b3Vec3_axisZ))), b3_colorBlue, draw.context);
    b3WorldTransform frameB = b3MulWorldTransforms(transformB, base.localFrameB);
    b3RevoluteJoint* joint = &base.revoluteJoint;
    if joint.enableLimit != 0 {
        b3Quat quatA = frameA.q;
        b3Quat quatB = frameB.q;
        if b3DotQuat(quatA, quatB) < 0.0f {
            quatB = b3NegateQuat(quatB);
        }
        b3Quat relQ = b3InvMulQuat(quatA, quatB);
        f32 wedgeRadius = 0.2f * scale;
        for i32 index = 0; index < kSliceCount; ++index {
            f32 t1 = cast(f32, index + 0) / cast(f32, kSliceCount);
            f32 alpha1 = (1.0f - t1) * joint.lowerAngle + t1 * joint.upperAngle;
            f32 t2 = cast(f32, index + 1) / cast(f32, kSliceCount);
            f32 alpha2 = (1.0f - t2) * joint.lowerAngle + t2 * joint.upperAngle;
            var vertex1 = b3Vec3{wedgeRadius * b3Cos(alpha1), wedgeRadius * b3Sin(alpha1), 0.0f};
            var vertex2 = b3Vec3{wedgeRadius * b3Cos(alpha2), wedgeRadius * b3Sin(alpha2), 0.0f};
            if index == 0 {
                draw.DrawSegmentFcn(frameA.p, b3TransformWorldPoint(frameA, vertex1), b3_colorCyan, draw.context);
            }
            if index == kSliceCount - 1 {
                draw.DrawSegmentFcn(b3TransformWorldPoint(frameA, vertex2), frameA.p, b3_colorCyan, draw.context);
            }
            draw.DrawSegmentFcn(b3TransformWorldPoint(frameA, vertex1), b3TransformWorldPoint(frameA, vertex2), b3_colorCyan, draw.context);
        }
        f32 twistAngle = b3GetTwistAngle(relQ);
        var p2 = b3Vec3{wedgeRadius * b3Cos(twistAngle), wedgeRadius * b3Sin(twistAngle), 0.0f};
        draw.DrawSegmentFcn(frameA.p, b3TransformWorldPoint(frameA, p2), b3_colorYellow, draw.context);
    }
}

// Try to claim and execute one pending task.
// Returns true if work was performed, false otherwise.
private {
bool b3SchedulerExecuteOne(b3Scheduler* scheduler) {
    i32 taskCount = b3AtomicLoadInt(&scheduler.nextSlot);
    for i32 t = 0; t < taskCount; ++t {
        b3SchedulerTask* task = scheduler.tasks + t;
        if b3AtomicLoadInt(&task.status) != b3_schedulerPending {
            continue;
        }
        if b3AtomicCompareExchangeInt(&task.status, b3_schedulerPending, b3_schedulerClaimed) == false {
            continue;
        }
        task.callback(task.taskContext);
        b3AtomicStoreInt(&task.status, b3_schedulerComplete);
        return true;
    }
    return false;
}

// Background worker thread entry point.
void b3SchedulerWorkerMain(void* context) {
    b3SchedulerWorkerContext* workerContext = context;
    b3Scheduler* scheduler = workerContext.scheduler;
    while true {
        b3WaitSemaphore(scheduler.taskSemaphore);
        if b3AtomicLoadInt(&scheduler.shutdown) != 0 {
            break;
        }
        while b3SchedulerExecuteOne(scheduler) != 0 {
        }
    }
}
}

b3Scheduler* b3CreateScheduler(i32 workerCount) {
    b3Scheduler* scheduler = b3Alloc(cast(u64, sizeof(b3Scheduler)));
    memset(scheduler, 0, cast(u64, sizeof(b3Scheduler)));
    scheduler.workerCount = workerCount;
    i32 threadCount = workerCount - 1;
    scheduler.threadCount = threadCount;
    scheduler.taskSemaphore = b3CreateSemaphore(0);
    b3AtomicStoreInt(&scheduler.shutdown, 0);
    b3AtomicStoreInt(&scheduler.nextSlot, 0);
    for i32 i = 0; i < threadCount; ++i {
        scheduler.workerContexts[i].scheduler = scheduler;
        scheduler.workerContexts[i].threadIndex = i + 1;
        noinit u8[16] name;
        snprintf(name, sizeof(name), "box2d_worker_%02d", i + 1);
        scheduler.threads[i] = b3CreateThread(cast(b3ThreadFunction, b3SchedulerWorkerMain), scheduler.workerContexts + i, name);
    }
    return scheduler;
}

void b3DestroyScheduler(b3Scheduler* scheduler) {
    b3AtomicStoreInt(&scheduler.shutdown, 1);
    for i32 i = 0; i < scheduler.threadCount; ++i {
        b3SignalSemaphore(scheduler.taskSemaphore);
    }
    for i32 i = 0; i < scheduler.threadCount; ++i {
        b3JoinThread(scheduler.threads[i]);
        scheduler.threads[i] = null;
    }
    b3DestroySemaphore(scheduler.taskSemaphore);
    b3Free(scheduler, cast(u64, sizeof(b3Scheduler)));
}

void b3ResetScheduler(b3Scheduler* scheduler) {
    b3AtomicStoreInt(&scheduler.nextSlot, 0);
}

void* b3SchedulerEnqueueTask(b3TaskCallback task, void* taskContext, void* userContext, u8* name) {
    ignore name;
    b3Scheduler* scheduler = userContext;
    i32 slot = b3AtomicFetchAddInt(&scheduler.nextSlot, 1);
    b3SchedulerTask* schedulerTask = scheduler.tasks + slot;
    schedulerTask.callback = task;
    schedulerTask.taskContext = taskContext;
    b3AtomicStoreInt(&schedulerTask.status, b3_schedulerPending);
    b3SignalSemaphore(scheduler.taskSemaphore);
    return schedulerTask;
}

void b3SchedulerFinishTask(void* userTask, void* userContext) {
    if userTask == null {
        return;
    }
    b3Scheduler* scheduler = userContext;
    b3SchedulerTask* waitTask = userTask;
    while b3AtomicLoadInt(&waitTask.status) != b3_schedulerComplete {
        if b3SchedulerExecuteOne(scheduler) == false {
            b3Yield();
        }
    }
}

private {
bool b3OverlapSensor(b3Shape* sensorShape, b3Transform sensorTransform, b3Shape* visitorShape, b3Transform visitorTransform) {
    b3ShapeType type = sensorShape.type;
    b3ShapeProxy proxy = b3MakeShapeProxy(visitorShape);
    b3Transform relativeTransform = b3InvMulTransforms(sensorTransform, visitorTransform);
    noinit b3Vec3[64] localPoints;
    noinit b3ShapeProxy localProxy;
    localProxy.count = b3MinInt(proxy.count, 64);
    for i32 i = 0; i < localProxy.count; ++i {
        localPoints[i] = b3TransformPoint(relativeTransform, proxy.points[i]);
    }
    localProxy.points = localPoints;
    localProxy.radius = proxy.radius;
    switch type {
        case b3_capsuleShape: {
            return b3OverlapCapsule(&sensorShape.capsule, b3Transform_identity, &localProxy);
        }
        case b3_compoundShape: {
            return b3OverlapCompound(sensorShape.compound, b3Transform_identity, &localProxy);
        }
        case b3_heightShape: {
            return b3OverlapHeightField(sensorShape.heightField, b3Transform_identity, &localProxy);
        }
        case b3_hullShape: {
            return b3OverlapHull(sensorShape.hull, b3Transform_identity, &localProxy);
        }
        case b3_meshShape: {
            return b3OverlapMesh(&sensorShape.mesh, b3Transform_identity, &localProxy);
        }
        case b3_sphereShape: {
            return b3OverlapSphere(&sensorShape.sphere, b3Transform_identity, &localProxy);
        }
        default: {
            return false;
        }
    }
}

// Sensor shapes need to
// - detect begin and end overlap events
// - events must be reported in deterministic order
// - maintain an active list of overlaps for query
// Assumption
// - sensors don't detect shapes on the same body
// Algorithm
// Query all sensors for overlaps
// Check against previous overlaps
// Data structures
// Each sensor has an double buffered array of overlaps
// These overlaps use a shape reference with index and generation
bool b3SensorQueryCallback(i32 proxyId, u64 userData, void* context) {
    ignore proxyId;
    var shapeId = cast(i32, userData);
    var queryContext = cast(b3SensorQueryContext*, context);
    b3Shape* sensorShape = queryContext.sensorShape;
    i32 sensorShapeId = sensorShape.id;
    if shapeId == sensorShapeId {
        return true;
    }
    b3World* world = queryContext.world;
    b3Shape* otherShape = world.shapes.data + shapeId;
    if (otherShape.type == b3_meshShape || otherShape.type == b3_heightShape) && (sensorShape.type == b3_meshShape || sensorShape.type == b3_heightShape) {
        return true;
    }
    if (otherShape.flags & b3_enableSensorEvents) == 0 {
        return true;
    }
    if otherShape.bodyId == sensorShape.bodyId {
        return true;
    }
    if b3ShouldShapesCollide(sensorShape.filter, otherShape.filter) == false {
        return true;
    }
    if sensorShape.flags & b3_enableCustomFiltering || otherShape.flags & b3_enableCustomFiltering {
        b3CustomFilterFcn customFilterFcn = queryContext.world.customFilterFcn;
        if customFilterFcn != null {
            var idA = b3ShapeId{sensorShapeId + 1, world.worldId, sensorShape.generation};
            var idB = b3ShapeId{shapeId + 1, world.worldId, otherShape.generation};
            bool shouldCollide = customFilterFcn(idA, idB, queryContext.world.customFilterContext) != 0;
            if shouldCollide == false {
                return true;
            }
        }
    }
    b3Transform otherTransform = b3ToRelativeTransform(b3GetBodyTransform(world, otherShape.bodyId), b3Pos_zero);
    bool overlap = b3OverlapSensor(sensorShape, queryContext.transform, otherShape, otherTransform);
    if overlap == false {
        return true;
    }
    b3Sensor* sensor = queryContext.sensor;
    b3Visitor* shapeRef = b3EmplaceHelper(cast(void**, &sensor.overlaps2.data), &sensor.overlaps2.count, &sensor.overlaps2.capacity, cast(i32, sizeof(*sensor.overlaps2.data)));
    shapeRef.shapeId = shapeId;
    shapeRef.generation = otherShape.generation;
    return true;
}

i32 b3CompareVisitors(void* a, void* b) {
    var sa = cast(b3Visitor*, a);
    var sb = cast(b3Visitor*, b);
    if sa.shapeId < sb.shapeId {
        return -1;
    }
    return 1;
}

void b3SensorTask(i32 startIndex, i32 endIndex, i32 workerIndex, void* context) {
    var world = cast(b3World*, context);
    b3SensorTaskContext* taskContext = world.sensorTaskContexts.data + workerIndex;
    b3DynamicTree* trees = world.broadPhase.trees;
    for i32 sensorIndex = startIndex; sensorIndex < endIndex; ++sensorIndex {
        b3Sensor* sensor = world.sensors.data + sensorIndex;
        b3Shape* sensorShape = world.shapes.data + sensor.shapeId;
        b3DynamicArray_b3Visitor temp = sensor.overlaps1;
        sensor.overlaps1 = sensor.overlaps2;
        sensor.overlaps2 = temp;
        while true {
            sensor.overlaps2.count = 0;
            if !(0 != 0) { break; }
        }
        while true {
            i32 _n = sensor.hits.count;
            if sensor.overlaps2.count + _n > sensor.overlaps2.capacity {
                i32 req = sensor.overlaps2.count + _n;
                i32 newCapacity = req > 2 ? req + (req >> 1) : 8;
                var oldSize = cast(i32, sensor.overlaps2.capacity * sizeof(*sensor.overlaps2.data));
                var newSize = cast(i32, newCapacity * sizeof(*sensor.overlaps2.data));
                sensor.overlaps2.data = b3GrowAlloc(sensor.overlaps2.data, oldSize, newSize);
                sensor.overlaps2.capacity = newCapacity;
            }
            memcpy(sensor.overlaps2.data + sensor.overlaps2.count, sensor.hits.data, cast(u64, _n * sizeof(*sensor.overlaps2.data)));
            sensor.overlaps2.count += _n;
            if !(0 != 0) { break; }
        }
        while true {
            sensor.hits.count = 0;
            if !(0 != 0) { break; }
        }
        b3Body* body = world.bodies.data + sensorShape.bodyId;
        if body.setIndex == b3_disabledSet || (sensorShape.flags & b3_enableSensorEvents) == 0 {
            if sensor.overlaps1.count != 0 {
                b3SetBit(&taskContext.eventBits, cast(u32, sensorIndex));
            }
            continue;
        }
        b3Transform transform = b3ToRelativeTransform(b3GetBodyTransformQuick(world, body), b3Pos_zero);
        var queryContext = b3SensorQueryContext{
            .world = world,
            .taskContext = taskContext,
            .sensor = sensor,
            .sensorShape = sensorShape,
            .transform = transform,
        };
        b3AABB queryBounds = sensorShape.aabb;
        b3DynamicTree_Query(trees + 0, queryBounds, sensorShape.filter.maskBits, false, cast(b3TreeQueryCallbackFcn, b3SensorQueryCallback), &queryContext);
        b3DynamicTree_Query(trees + 1, queryBounds, sensorShape.filter.maskBits, false, cast(b3TreeQueryCallbackFcn, b3SensorQueryCallback), &queryContext);
        b3DynamicTree_Query(trees + 2, queryBounds, sensorShape.filter.maskBits, false, cast(b3TreeQueryCallbackFcn, b3SensorQueryCallback), &queryContext);
        qsort(sensor.overlaps2.data, sensor.overlaps2.count, sizeof(b3Visitor), b3CompareVisitors);
        i32 uniqueCount = 0;
        i32 overlapCount = sensor.overlaps2.count;
        b3Visitor* overlapData = sensor.overlaps2.data;
        for i32 i = 0; i < overlapCount; ++i {
            if uniqueCount == 0 || overlapData[i].shapeId != overlapData[uniqueCount - 1].shapeId {
                overlapData[uniqueCount] = overlapData[i];
                uniqueCount += 1;
            }
        }
        sensor.overlaps2.count = uniqueCount;
        i32 count1 = sensor.overlaps1.count;
        i32 count2 = sensor.overlaps2.count;
        if count1 != count2 {
            b3SetBit(&taskContext.eventBits, cast(u32, sensorIndex));
        } else {
            for i32 i = 0; i < count1; ++i {
                b3Visitor* s1 = sensor.overlaps1.data + i;
                b3Visitor* s2 = sensor.overlaps2.data + i;
                if s1.shapeId != s2.shapeId || s1.generation != s2.generation {
                    b3SetBit(&taskContext.eventBits, cast(u32, sensorIndex));
                    break;
                }
            }
        }
    }
}
}

void b3OverlapSensors(b3World* world) {
    i32 sensorCount = world.sensors.count;
    if sensorCount == 0 {
        return;
    }
    for i32 i = 0; i < world.workerCount; ++i {
        b3SetBitCountAndClear(&world.sensorTaskContexts.data[i].eventBits, cast(u32, sensorCount));
    }
    i32 minRange = 16;
    b3ParallelFor(world, cast(b3ParallelForCallback, b3SensorTask), sensorCount, minRange, world, "sensors");
    b3BitSet* bitSet = &world.sensorTaskContexts.data[0].eventBits;
    for i32 i = 1; i < world.workerCount; ++i {
        b3InPlaceUnion(bitSet, &world.sensorTaskContexts.data[i].eventBits);
    }
    u64* bits = bitSet.bits;
    u32 blockCount = bitSet.blockCount;
    for u32 k = 0; k < blockCount; ++k {
        u64 word = bits[k];
        while word != 0 {
            u32 ctz = b3CTZ64(word);
            var sensorIndex = cast(i32, 64 * k + ctz);
            b3Sensor* sensor = world.sensors.data + sensorIndex;
            b3Shape* sensorShape = world.shapes.data + sensor.shapeId;
            var sensorId = b3ShapeId{sensor.shapeId + 1, world.worldId, sensorShape.generation};
            i32 count1 = sensor.overlaps1.count;
            i32 count2 = sensor.overlaps2.count;
            b3Visitor* refs1 = sensor.overlaps1.data;
            b3Visitor* refs2 = sensor.overlaps2.data;
            i32 index1 = 0;
            i32 index2 = 0;
            while index1 < count1 && index2 < count2 {
                b3Visitor* r1 = refs1 + index1;
                b3Visitor* r2 = refs2 + index2;
                if r1.shapeId == r2.shapeId {
                    if r1.generation < r2.generation {
                        var visitorId = b3ShapeId{r1.shapeId + 1, world.worldId, r1.generation};
                        var event = b3SensorEndTouchEvent{.sensorShapeId = sensorId, .visitorShapeId = visitorId};
                        while true {
                            if world.sensorEndEvents[world.endEventArrayIndex].count >= world.sensorEndEvents[world.endEventArrayIndex].capacity {
                                var oldSize = cast(i32, world.sensorEndEvents[world.endEventArrayIndex].capacity * sizeof(*world.sensorEndEvents[world.endEventArrayIndex].data));
                                i32 newCapacity = world.sensorEndEvents[world.endEventArrayIndex].capacity == 0 ? 8 : 2 * world.sensorEndEvents[world.endEventArrayIndex].capacity;
                                var newSize = cast(i32, newCapacity * sizeof(*world.sensorEndEvents[world.endEventArrayIndex].data));
                                world.sensorEndEvents[world.endEventArrayIndex].data = b3GrowAlloc(world.sensorEndEvents[world.endEventArrayIndex].data, oldSize, newSize);
                                world.sensorEndEvents[world.endEventArrayIndex].capacity = newCapacity;
                            }
                            world.sensorEndEvents[world.endEventArrayIndex].data[world.sensorEndEvents[world.endEventArrayIndex].count++] = event;
                            if !(0 != 0) { break; }
                        }
                        index1 += 1;
                    } else if r1.generation > r2.generation {
                        var visitorId = b3ShapeId{r2.shapeId + 1, world.worldId, r2.generation};
                        var event = b3SensorBeginTouchEvent{sensorId, visitorId};
                        while true {
                            if world.sensorBeginEvents.count >= world.sensorBeginEvents.capacity {
                                var oldSize = cast(i32, world.sensorBeginEvents.capacity * sizeof(*world.sensorBeginEvents.data));
                                i32 newCapacity = world.sensorBeginEvents.capacity == 0 ? 8 : 2 * world.sensorBeginEvents.capacity;
                                var newSize = cast(i32, newCapacity * sizeof(*world.sensorBeginEvents.data));
                                world.sensorBeginEvents.data = b3GrowAlloc(world.sensorBeginEvents.data, oldSize, newSize);
                                world.sensorBeginEvents.capacity = newCapacity;
                            }
                            world.sensorBeginEvents.data[world.sensorBeginEvents.count++] = event;
                            if !(0 != 0) { break; }
                        }
                        index2 += 1;
                    } else {
                        index1 += 1;
                        index2 += 1;
                    }
                } else if r1.shapeId < r2.shapeId {
                    var visitorId = b3ShapeId{r1.shapeId + 1, world.worldId, r1.generation};
                    var event = b3SensorEndTouchEvent{sensorId, visitorId};
                    while true {
                        if world.sensorEndEvents[world.endEventArrayIndex].count >= world.sensorEndEvents[world.endEventArrayIndex].capacity {
                            var oldSize = cast(i32, world.sensorEndEvents[world.endEventArrayIndex].capacity * sizeof(*world.sensorEndEvents[world.endEventArrayIndex].data));
                            i32 newCapacity = world.sensorEndEvents[world.endEventArrayIndex].capacity == 0 ? 8 : 2 * world.sensorEndEvents[world.endEventArrayIndex].capacity;
                            var newSize = cast(i32, newCapacity * sizeof(*world.sensorEndEvents[world.endEventArrayIndex].data));
                            world.sensorEndEvents[world.endEventArrayIndex].data = b3GrowAlloc(world.sensorEndEvents[world.endEventArrayIndex].data, oldSize, newSize);
                            world.sensorEndEvents[world.endEventArrayIndex].capacity = newCapacity;
                        }
                        world.sensorEndEvents[world.endEventArrayIndex].data[world.sensorEndEvents[world.endEventArrayIndex].count++] = event;
                        if !(0 != 0) { break; }
                    }
                    index1 += 1;
                } else {
                    var visitorId = b3ShapeId{r2.shapeId + 1, world.worldId, r2.generation};
                    var event = b3SensorBeginTouchEvent{sensorId, visitorId};
                    while true {
                        if world.sensorBeginEvents.count >= world.sensorBeginEvents.capacity {
                            var oldSize = cast(i32, world.sensorBeginEvents.capacity * sizeof(*world.sensorBeginEvents.data));
                            i32 newCapacity = world.sensorBeginEvents.capacity == 0 ? 8 : 2 * world.sensorBeginEvents.capacity;
                            var newSize = cast(i32, newCapacity * sizeof(*world.sensorBeginEvents.data));
                            world.sensorBeginEvents.data = b3GrowAlloc(world.sensorBeginEvents.data, oldSize, newSize);
                            world.sensorBeginEvents.capacity = newCapacity;
                        }
                        world.sensorBeginEvents.data[world.sensorBeginEvents.count++] = event;
                        if !(0 != 0) { break; }
                    }
                    index2 += 1;
                }
            }
            while index1 < count1 {
                b3Visitor* r1 = refs1 + index1;
                var visitorId = b3ShapeId{r1.shapeId + 1, world.worldId, r1.generation};
                var event = b3SensorEndTouchEvent{sensorId, visitorId};
                while true {
                    if world.sensorEndEvents[world.endEventArrayIndex].count >= world.sensorEndEvents[world.endEventArrayIndex].capacity {
                        var oldSize = cast(i32, world.sensorEndEvents[world.endEventArrayIndex].capacity * sizeof(*world.sensorEndEvents[world.endEventArrayIndex].data));
                        i32 newCapacity = world.sensorEndEvents[world.endEventArrayIndex].capacity == 0 ? 8 : 2 * world.sensorEndEvents[world.endEventArrayIndex].capacity;
                        var newSize = cast(i32, newCapacity * sizeof(*world.sensorEndEvents[world.endEventArrayIndex].data));
                        world.sensorEndEvents[world.endEventArrayIndex].data = b3GrowAlloc(world.sensorEndEvents[world.endEventArrayIndex].data, oldSize, newSize);
                        world.sensorEndEvents[world.endEventArrayIndex].capacity = newCapacity;
                    }
                    world.sensorEndEvents[world.endEventArrayIndex].data[world.sensorEndEvents[world.endEventArrayIndex].count++] = event;
                    if !(0 != 0) { break; }
                }
                index1 += 1;
            }
            while index2 < count2 {
                b3Visitor* r2 = refs2 + index2;
                var visitorId = b3ShapeId{r2.shapeId + 1, world.worldId, r2.generation};
                var event = b3SensorBeginTouchEvent{sensorId, visitorId};
                while true {
                    if world.sensorBeginEvents.count >= world.sensorBeginEvents.capacity {
                        var oldSize = cast(i32, world.sensorBeginEvents.capacity * sizeof(*world.sensorBeginEvents.data));
                        i32 newCapacity = world.sensorBeginEvents.capacity == 0 ? 8 : 2 * world.sensorBeginEvents.capacity;
                        var newSize = cast(i32, newCapacity * sizeof(*world.sensorBeginEvents.data));
                        world.sensorBeginEvents.data = b3GrowAlloc(world.sensorBeginEvents.data, oldSize, newSize);
                        world.sensorBeginEvents.capacity = newCapacity;
                    }
                    world.sensorBeginEvents.data[world.sensorBeginEvents.count++] = event;
                    if !(0 != 0) { break; }
                }
                index2 += 1;
            }
            word = word & word - 1;
        }
    }
}

void b3DestroySensor(b3World* world, b3Shape* sensorShape) {
    b3Sensor* sensor = world.sensors.data + sensorShape.sensorIndex;
    for i32 i = 0; i < sensor.overlaps2.count; ++i {
        b3Visitor* ref = sensor.overlaps2.data + i;
        var event = b3SensorEndTouchEvent{
            .sensorShapeId = b3ShapeId{
                .index1 = sensorShape.id + 1,
                .world0 = world.worldId,
                .generation = sensorShape.generation,
            },
            .visitorShapeId = b3ShapeId{
                .index1 = ref.shapeId + 1,
                .world0 = world.worldId,
                .generation = ref.generation,
            },
        };
        while true {
            if world.sensorEndEvents[world.endEventArrayIndex].count >= world.sensorEndEvents[world.endEventArrayIndex].capacity {
                var oldSize = cast(i32, world.sensorEndEvents[world.endEventArrayIndex].capacity * sizeof(*world.sensorEndEvents[world.endEventArrayIndex].data));
                i32 newCapacity = world.sensorEndEvents[world.endEventArrayIndex].capacity == 0 ? 8 : 2 * world.sensorEndEvents[world.endEventArrayIndex].capacity;
                var newSize = cast(i32, newCapacity * sizeof(*world.sensorEndEvents[world.endEventArrayIndex].data));
                world.sensorEndEvents[world.endEventArrayIndex].data = b3GrowAlloc(world.sensorEndEvents[world.endEventArrayIndex].data, oldSize, newSize);
                world.sensorEndEvents[world.endEventArrayIndex].capacity = newCapacity;
            }
            world.sensorEndEvents[world.endEventArrayIndex].data[world.sensorEndEvents[world.endEventArrayIndex].count++] = event;
            if !(0 != 0) { break; }
        }
    }
    while true {
        b3Free(sensor.hits.data, cast(u64, sensor.hits.capacity * sizeof(*sensor.hits.data)));
        sensor.hits.data = null;
        sensor.hits.count = 0;
        sensor.hits.capacity = 0;
        if !(0 != 0) { break; }
    }
    while true {
        b3Free(sensor.overlaps1.data, cast(u64, sensor.overlaps1.capacity * sizeof(*sensor.overlaps1.data)));
        sensor.overlaps1.data = null;
        sensor.overlaps1.count = 0;
        sensor.overlaps1.capacity = 0;
        if !(0 != 0) { break; }
    }
    while true {
        b3Free(sensor.overlaps2.data, cast(u64, sensor.overlaps2.capacity * sizeof(*sensor.overlaps2.data)));
        sensor.overlaps2.data = null;
        sensor.overlaps2.count = 0;
        sensor.overlaps2.capacity = 0;
        if !(0 != 0) { break; }
    }
    i32 movedIndex = b3RemoveHelper(world.sensors.data, &world.sensors.count, sensorShape.sensorIndex, cast(i32, sizeof(*world.sensors.data)));
    if movedIndex != -1 {
        b3Sensor* movedSensor = world.sensors.data + sensorShape.sensorIndex;
        b3Shape* otherSensorShape = world.shapes.data + movedSensor.shapeId;
        otherSensorShape.sensorIndex = sensorShape.sensorIndex;
    }
}

// SPDX-FileCopyrightText: 2025 Erin Catto
// SPDX-License-Identifier: MIT
// needed for dll export
private {
b3Shape* b3GetShape(b3World* world, b3ShapeId shapeId) {
    i32 id = shapeId.index1 - 1;
    b3Shape* shape = world.shapes.data + id;
    return shape;
}

f32 b3ComputeShapeMargin(b3Shape* shape) {
    f32 margin = 0.0f;
    switch shape.type {
        case b3_sphereShape: {
            {
                margin = shape.sphere.radius;
            }
        }
        case b3_capsuleShape: {
            {
                margin = 0.5f * b3Distance(shape.capsule.center2, shape.capsule.center1) + shape.capsule.radius;
            }
        }
        case b3_hullShape: {
            {
                b3HullData* hull = shape.hull;
                b3Vec3* points = b3GetHullPoints(hull);
                f32 maxExtentSqr = 0.0f;
                i32 count = hull.vertexCount;
                for i32 i = 0; i < count; ++i {
                    f32 distSqr = b3DistanceSquared(points[i], hull.center);
                    maxExtentSqr = b3MaxFloat(maxExtentSqr, distSqr);
                }
                margin = sqrtf(maxExtentSqr);
            }
        }
        case b3_meshShape, b3_heightShape, b3_compoundShape: {
            {
                return 0.05f * b3GetLengthUnitsPerMeter();
            }
        }
        default: {
            return 0.05f * b3GetLengthUnitsPerMeter();
        }
    }
    return b3MinFloat(0.05f * b3GetLengthUnitsPerMeter(), 0.125f * margin);
}

void b3UpdateShapeAABBs(b3Shape* shape, b3WorldTransform transform, b3BodyType proxyType) {
    f32 speculativeDistance = 4.0f * (0.005f * b3GetLengthUnitsPerMeter());
    f32 aabbMargin = shape.aabbMargin;
    b3AABB aabb = b3ComputeFatShapeAABB(shape, transform, speculativeDistance);
    shape.aabb = aabb;
    f32 margin = proxyType == b3_staticBody ? speculativeDistance : aabbMargin;
    noinit b3AABB fatAABB;
    fatAABB.lowerBound.x = aabb.lowerBound.x - margin;
    fatAABB.lowerBound.y = aabb.lowerBound.y - margin;
    fatAABB.lowerBound.z = aabb.lowerBound.z - margin;
    fatAABB.upperBound.x = aabb.upperBound.x + margin;
    fatAABB.upperBound.y = aabb.upperBound.y + margin;
    fatAABB.upperBound.z = aabb.upperBound.z + margin;
    shape.fatAABB = fatAABB;
}

b3Shape* b3CreateShapeInternal(b3World* world, b3Body* body, b3WorldTransform bodyTransform, b3ShapeDef* def, void* geometry, b3ShapeType shapeType, b3Transform shapeTransform, b3Vec3 scale, bool haveShapeTransform) {
    i32 shapeId = b3AllocId(&world.shapeIdPool);
    if shapeId == world.shapes.count {
        while true {
            if world.shapes.count >= world.shapes.capacity {
                var oldSize = cast(i32, world.shapes.capacity * sizeof(*world.shapes.data));
                i32 newCapacity = world.shapes.capacity == 0 ? 8 : 2 * world.shapes.capacity;
                var newSize = cast(i32, newCapacity * sizeof(*world.shapes.data));
                world.shapes.data = b3GrowAlloc(world.shapes.data, oldSize, newSize);
                world.shapes.capacity = newCapacity;
            }
            world.shapes.data[world.shapes.count++] = b3Shape{};
            if !(0 != 0) { break; }
        }
    } else {
    }
    b3Shape* shape = world.shapes.data + shapeId;
    switch shapeType {
        case b3_capsuleShape: {
            shape.capsule = *cast(b3Capsule*, geometry);
        }
        case b3_compoundShape: {
            shape.compound = cast(b3CompoundData*, geometry);
        }
        case b3_sphereShape: {
            shape.sphere = *cast(b3Sphere*, geometry);
        }
        case b3_hullShape: {
            if haveShapeTransform != 0 {
                b3HullData* baked = b3CloneAndTransformHull(cast(b3HullData*, geometry), shapeTransform, scale);
                if baked == null {
                    b3FreeId(&world.shapeIdPool, shapeId);
                    shape.id = -1;
                    return null;
                }
                shape.hull = b3AddOwnedHullToDatabase(world, baked);
            } else {
                shape.hull = b3AddHullToDatabase(world, cast(b3HullData*, geometry));
            }
        }
        case b3_meshShape: {
            {
                shape.mesh.data = cast(b3MeshData*, geometry);
                shape.mesh.scale = b3SafeScale(scale);
            }
        }
        case b3_heightShape: {
            shape.heightField = cast(b3HeightFieldData*, geometry);
        }
        default: {
        }
    }
    shape.id = shapeId;
    shape.bodyId = body.id;
    shape.type = shapeType;
    shape.density = def.density;
    shape.explosionScale = def.explosionScale;
    shape.filter = def.filter;
    shape.userData = def.userData;
    shape.userShape = null;
    shape.flags = 0;
    shape.flags |= cast(u8, def.enableSensorEvents != 0 ? b3_enableSensorEvents : 0);
    shape.flags |= cast(u8, def.enableContactEvents != 0 ? b3_enableContactEvents : 0);
    shape.flags |= cast(u8, def.enableCustomFiltering != 0 ? b3_enableCustomFiltering : 0);
    shape.flags |= cast(u8, def.enableHitEvents != 0 ? b3_enableHitEvents : 0);
    shape.flags |= cast(u8, def.enablePreSolveEvents != 0 ? b3_enablePreSolveEvents : 0);
    shape.flags |= cast(u8, def.enableSpeculativeContact != 0 ? b3_enableSpeculative : 0);
    shape.proxyKey = -1;
    shape.localCentroid = b3GetShapeCentroid(shape);
    shape.aabbMargin = b3ComputeShapeMargin(shape);
    shape.aabb = b3AABB{b3Vec3_zero, b3Vec3_zero};
    shape.fatAABB = b3AABB{b3Vec3_zero, b3Vec3_zero};
    shape.nameId = b3AddName(&world.names, def.name);
    shape.generation += 1;
    if shape.type == b3_compoundShape {
        i32 materialCount = shape.compound.materialCount;
        shape.materialCount = materialCount;
        shape.materials = b3Alloc(cast(u64, materialCount * sizeof(b3SurfaceMaterial)));
        memcpy(shape.materials, b3GetCompoundMaterials(shape.compound), cast(u64, materialCount * sizeof(b3SurfaceMaterial)));
    } else if def.materialCount > 1 && def.materials != null {
        shape.materialCount = def.materialCount;
        shape.materials = b3Alloc(cast(u64, def.materialCount * sizeof(b3SurfaceMaterial)));
        memcpy(shape.materials, def.materials, cast(u64, def.materialCount * sizeof(b3SurfaceMaterial)));
    } else {
        shape.material = def.materialCount == 1 && def.materials != null ? def.materials[0] : def.baseMaterial;
        shape.materialCount = 1;
        shape.materials = null;
    }
    if body.setIndex != b3_disabledSet {
        b3BodyType proxyType = body.type;
        bool forcePairCreation = def.invokeContactCreation && shape.type != b3_compoundShape;
        b3CreateShapeProxy(shape, &world.broadPhase, proxyType, bodyTransform, forcePairCreation);
    }
    if body.headShapeId != -1 {
        b3Shape* headShape = world.shapes.data + body.headShapeId;
        headShape.prevShapeId = shapeId;
    }
    shape.prevShapeId = -1;
    shape.nextShapeId = body.headShapeId;
    body.headShapeId = shapeId;
    body.shapeCount += 1;
    if def.isSensor != 0 {
        shape.sensorIndex = world.sensors.count;
        b3Sensor* sensor = b3EmplaceHelper(cast(void**, &world.sensors.data), &world.sensors.count, &world.sensors.capacity, cast(i32, sizeof(*world.sensors.data)));
        while true {
            sensor.hits.data = 4 > 0 ? b3GrowAlloc(null, 0, cast(i32, 4 * sizeof(*sensor.hits.data))) : null;
            sensor.hits.count = 0;
            sensor.hits.capacity = 4;
            if !(0 != 0) { break; }
        }
        while true {
            sensor.overlaps1.data = 16 > 0 ? b3GrowAlloc(null, 0, cast(i32, 16 * sizeof(*sensor.overlaps1.data))) : null;
            sensor.overlaps1.count = 0;
            sensor.overlaps1.capacity = 16;
            if !(0 != 0) { break; }
        }
        while true {
            sensor.overlaps2.data = 16 > 0 ? b3GrowAlloc(null, 0, cast(i32, 16 * sizeof(*sensor.overlaps2.data))) : null;
            sensor.overlaps2.count = 0;
            sensor.overlaps2.capacity = 16;
            if !(0 != 0) { break; }
        }
        sensor.shapeId = shapeId;
    } else {
        shape.sensorIndex = -1;
    }
    b3ValidateSolverSets(world);
    return shape;
}

b3ShapeId b3CreateShape(b3BodyId bodyId, b3ShapeDef* def, void* geometry, b3ShapeType shapeType, b3Transform transform, b3Vec3 scale, bool haveTransform) {
    b3World* world = b3GetUnlockedWorld(cast(i32, bodyId.world0));
    if world == null {
        return b3ShapeId{};
    }
    if world.shapes.count == 1 << 22 && world.shapeIdPool.freeArray.count == 0 {
        return b3_nullShapeId;
    }
    b3Body* body = b3GetBodyFullId(world, bodyId);
    if body.type != b3_staticBody && (shapeType == b3_compoundShape || shapeType == b3_heightShape) {
        return b3_nullShapeId;
    }
    world.locked = true;
    b3WorldTransform bodyTransform = b3GetBodyTransformQuick(world, body);
    b3Shape* shape = b3CreateShapeInternal(world, body, bodyTransform, def, geometry, shapeType, transform, scale, haveTransform);
    if shape == null {
        world.locked = false;
        return b3_nullShapeId;
    }
    if def.updateBodyMass == true {
        b3UpdateBodyMassData(world, body);
    } else if (body.flags & cast(u32, b3_dirtyMass)) == 0 {
        body.flags |= cast(u32, b3_dirtyMass);
        b3SyncBodyFlags(world, body);
    }
    b3ValidateSolverSets(world);
    var id = b3ShapeId{shape.id + 1, bodyId.world0, shape.generation};
    world.locked = false;
    return id;
}
}

b3ShapeId b3CreateSphereShape(b3BodyId bodyId, b3ShapeDef* def, b3Sphere* sphere) {
    b3ShapeId shapeId = b3CreateShape(bodyId, def, sphere, b3_sphereShape, b3Transform_identity, b3Vec3_one, false);
    if shapeId.index1 != 0 {
        b3World* world = b3GetUnlockedWorld(cast(i32, bodyId.world0));
        if world != null {
            while true {
                if world.recording != null {
                    var recCreateArgs = b3RecArgs_CreateSphereShape{bodyId, *def, *sphere};
                    b3RecWriteRet_CreateSphereShape(world.recording, &recCreateArgs, shapeId);
                }
                if !(0 != 0) { break; }
            }
        }
    }
    return shapeId;
}

b3ShapeId b3CreateCapsuleShape(b3BodyId bodyId, b3ShapeDef* def, b3Capsule* capsule) {
    f32 lengthSqr = b3DistanceSquared(capsule.center1, capsule.center2);
    noinit b3ShapeId shapeId;
    if lengthSqr <= 0.005f * b3GetLengthUnitsPerMeter() * (0.005f * b3GetLengthUnitsPerMeter()) {
        var sphere = b3Sphere{b3Lerp(capsule.center1, capsule.center2, 0.5f), capsule.radius};
        shapeId = b3CreateShape(bodyId, def, &sphere, b3_sphereShape, b3Transform_identity, b3Vec3_one, false);
    } else {
        shapeId = b3CreateShape(bodyId, def, capsule, b3_capsuleShape, b3Transform_identity, b3Vec3_one, false);
    }
    if shapeId.index1 != 0 {
        b3World* world = b3GetUnlockedWorld(cast(i32, bodyId.world0));
        if world != null {
            while true {
                if world.recording != null {
                    var recCreateArgs = b3RecArgs_CreateCapsuleShape{bodyId, *def, *capsule};
                    b3RecWriteRet_CreateCapsuleShape(world.recording, &recCreateArgs, shapeId);
                }
                if !(0 != 0) { break; }
            }
        }
    }
    return shapeId;
}

b3ShapeId b3CreateHullShape(b3BodyId bodyId, b3ShapeDef* def, b3HullData* hull) {
    b3ShapeId shapeId = b3CreateShape(bodyId, def, hull, b3_hullShape, b3Transform_identity, b3Vec3_one, false);
    if shapeId.index1 != 0 {
        b3World* world = b3GetUnlockedWorld(cast(i32, bodyId.world0));
        if world != null && world.recording != null {
            u32 geometryId = b3RecInternHull(world.recording, hull);
            var createArgs = b3RecArgs_CreateHullShape{bodyId, *def, geometryId};
            b3RecWriteRet_CreateHullShape(world.recording, &createArgs, shapeId);
        }
    }
    return shapeId;
}

b3ShapeId b3CreateTransformedHullShape(b3BodyId bodyId, b3ShapeDef* def, b3HullData* hull, b3Transform transform, b3Vec3 scale) {
    b3ShapeId shapeId = b3CreateShape(bodyId, def, hull, b3_hullShape, transform, scale, true);
    if shapeId.index1 != 0 {
        b3World* world = b3GetUnlockedWorld(cast(i32, bodyId.world0));
        if world != null && world.recording != null {
            b3Shape* shape = world.shapes.data + (shapeId.index1 - 1);
            u32 geometryId = b3RecInternHull(world.recording, shape.hull);
            var createArgs = b3RecArgs_CreateHullShape{bodyId, *def, geometryId};
            b3RecWriteRet_CreateHullShape(world.recording, &createArgs, shapeId);
        }
    }
    return shapeId;
}

b3ShapeId b3CreateMeshShape(b3BodyId bodyId, b3ShapeDef* def, b3MeshData* mesh, b3Vec3 scale) {
    b3ShapeId shapeId = b3CreateShape(bodyId, def, mesh, b3_meshShape, b3Transform_identity, scale, true);
    if shapeId.index1 != 0 {
        b3World* world = b3GetUnlockedWorld(cast(i32, bodyId.world0));
        if world != null && world.recording != null {
            u32 geometryId = b3RecInternMesh(world.recording, mesh);
            var createArgs = b3RecArgs_CreateMeshShape{bodyId, *def, geometryId, scale};
            b3RecWriteRet_CreateMeshShape(world.recording, &createArgs, shapeId);
        }
    }
    return shapeId;
}

b3ShapeId b3CreateHeightFieldShape(b3BodyId bodyId, b3ShapeDef* def, b3HeightFieldData* heightField) {
    b3ShapeId shapeId = b3CreateShape(bodyId, def, heightField, b3_heightShape, b3Transform_identity, b3Vec3_one, false);
    if shapeId.index1 != 0 {
        b3World* world = b3GetUnlockedWorld(cast(i32, bodyId.world0));
        if world != null && world.recording != null {
            u32 geometryId = b3RecInternHeightField(world.recording, heightField);
            var createArgs = b3RecArgs_CreateHeightFieldShape{bodyId, *def, geometryId};
            b3RecWriteRet_CreateHeightFieldShape(world.recording, &createArgs, shapeId);
        }
    }
    return shapeId;
}

b3ShapeId b3CreateBakedCompoundShape(b3BodyId bodyId, b3ShapeDef* def, b3CompoundData* compound) {
    b3ShapeId shapeId = b3CreateShape(bodyId, def, compound, b3_compoundShape, b3Transform_identity, b3Vec3_one, false);
    if shapeId.index1 != 0 {
        b3World* world = b3GetUnlockedWorld(cast(i32, bodyId.world0));
        if world != null && world.recording != null {
            u32 geometryId = b3RecInternCompound(world.recording, compound);
            var createArgs = b3RecArgs_CreateCompoundShape{bodyId, *def, geometryId};
            b3RecWriteRet_CreateCompoundShape(world.recording, &createArgs, shapeId);
        }
    }
    return shapeId;
}

// Destroy a shape on a body. This doesn't need to be called when destroying a body.
private {
void b3DestroyShapeInternal(b3World* world, b3Shape* shape, b3Body* body, bool wakeBodies) {
    i32 shapeId = shape.id;
    if shape.prevShapeId != -1 {
        b3Shape* prevShape = world.shapes.data + shape.prevShapeId;
        prevShape.nextShapeId = shape.nextShapeId;
    }
    if shape.nextShapeId != -1 {
        b3Shape* nextShape = world.shapes.data + shape.nextShapeId;
        nextShape.prevShapeId = shape.prevShapeId;
    }
    if shapeId == body.headShapeId {
        body.headShapeId = shape.nextShapeId;
    }
    body.shapeCount -= 1;
    b3DestroyShapeProxy(shape, &world.broadPhase);
    i32 contactKey = body.headContactKey;
    while contactKey != -1 {
        i32 contactId = contactKey >> 1;
        i32 edgeIndex = contactKey & 1;
        b3Contact* contact = world.contacts.data + contactId;
        contactKey = contact.edges[edgeIndex].nextKey;
        if contact.shapeIdA == shapeId || contact.shapeIdB == shapeId {
            b3DestroyContact(world, contact, wakeBodies);
        }
    }
    if shape.sensorIndex != -1 {
        b3Sensor* sensor = world.sensors.data + shape.sensorIndex;
        for i32 i = 0; i < sensor.overlaps2.count; ++i {
            b3Visitor* ref = sensor.overlaps2.data + i;
            var event = b3SensorEndTouchEvent{
                .sensorShapeId = b3ShapeId{
                    .index1 = shapeId + 1,
                    .world0 = world.worldId,
                    .generation = shape.generation,
                },
                .visitorShapeId = b3ShapeId{
                    .index1 = ref.shapeId + 1,
                    .world0 = world.worldId,
                    .generation = ref.generation,
                },
            };
            while true {
                if world.sensorEndEvents[world.endEventArrayIndex].count >= world.sensorEndEvents[world.endEventArrayIndex].capacity {
                    var oldSize = cast(i32, world.sensorEndEvents[world.endEventArrayIndex].capacity * sizeof(*world.sensorEndEvents[world.endEventArrayIndex].data));
                    i32 newCapacity = world.sensorEndEvents[world.endEventArrayIndex].capacity == 0 ? 8 : 2 * world.sensorEndEvents[world.endEventArrayIndex].capacity;
                    var newSize = cast(i32, newCapacity * sizeof(*world.sensorEndEvents[world.endEventArrayIndex].data));
                    world.sensorEndEvents[world.endEventArrayIndex].data = b3GrowAlloc(world.sensorEndEvents[world.endEventArrayIndex].data, oldSize, newSize);
                    world.sensorEndEvents[world.endEventArrayIndex].capacity = newCapacity;
                }
                world.sensorEndEvents[world.endEventArrayIndex].data[world.sensorEndEvents[world.endEventArrayIndex].count++] = event;
                if !(0 != 0) { break; }
            }
        }
        while true {
            b3Free(sensor.hits.data, cast(u64, sensor.hits.capacity * sizeof(*sensor.hits.data)));
            sensor.hits.data = null;
            sensor.hits.count = 0;
            sensor.hits.capacity = 0;
            if !(0 != 0) { break; }
        }
        while true {
            b3Free(sensor.overlaps1.data, cast(u64, sensor.overlaps1.capacity * sizeof(*sensor.overlaps1.data)));
            sensor.overlaps1.data = null;
            sensor.overlaps1.count = 0;
            sensor.overlaps1.capacity = 0;
            if !(0 != 0) { break; }
        }
        while true {
            b3Free(sensor.overlaps2.data, cast(u64, sensor.overlaps2.capacity * sizeof(*sensor.overlaps2.data)));
            sensor.overlaps2.data = null;
            sensor.overlaps2.count = 0;
            sensor.overlaps2.capacity = 0;
            if !(0 != 0) { break; }
        }
        i32 movedIndex = b3RemoveHelper(world.sensors.data, &world.sensors.count, shape.sensorIndex, cast(i32, sizeof(*world.sensors.data)));
        if movedIndex != -1 {
            b3Sensor* movedSensor = world.sensors.data + shape.sensorIndex;
            b3Shape* otherSensorShape = world.shapes.data + movedSensor.shapeId;
            otherSensorShape.sensorIndex = shape.sensorIndex;
        }
    }
    b3DestroyShapeAllocations(world, shape);
    b3FreeId(&world.shapeIdPool, shapeId);
    shape.id = -1;
    b3ValidateSolverSets(world);
}
}

void b3DestroyShape(b3ShapeId shapeId, bool updateBodyMass) {
    b3World* world = b3GetUnlockedWorld(cast(i32, shapeId.world0));
    if world == null {
        return;
    }
    while true {
        if world.recording != null {
            var recArgs = b3RecArgs_DestroyShape{shapeId, updateBodyMass};
            b3RecWrite_DestroyShape(world.recording, &recArgs);
        }
        if !(0 != 0) { break; }
    }
    world.locked = true;
    b3Shape* shape = b3GetShape(world, shapeId);
    bool wakeBodies = true;
    b3Body* body = world.bodies.data + shape.bodyId;
    b3DestroyShapeInternal(world, shape, body, wakeBodies);
    if updateBodyMass == true {
        b3UpdateBodyMassData(world, body);
    }
    world.locked = false;
}

b3AABB b3ComputeShapeAABB(b3Shape* shape, b3Transform transform) {
    switch shape.type {
        case b3_capsuleShape: {
            return b3ComputeCapsuleAABB(&shape.capsule, transform);
        }
        case b3_compoundShape: {
            return b3ComputeCompoundAABB(shape.compound, transform);
        }
        case b3_heightShape: {
            return b3ComputeHeightFieldAABB(shape.heightField, transform);
        }
        case b3_hullShape: {
            return b3ComputeHullAABB(shape.hull, transform);
        }
        case b3_meshShape: {
            return b3ComputeMeshAABB(shape.mesh.data, transform, shape.mesh.scale);
        }
        case b3_sphereShape: {
            return b3ComputeSphereAABB(&shape.sphere, transform);
        }
        default: {
            {
                var empty = b3AABB{transform.p, transform.p};
                return empty;
            }
        }
    }
}

b3AABB b3ComputeFatShapeAABB(b3Shape* shape, b3WorldTransform transform, f32 extra) {
    var r = b3Vec3{extra, extra, extra};
    b3AABB aabb = b3ComputeShapeAABB(shape, transform);
    aabb.lowerBound = b3Sub(aabb.lowerBound, r);
    aabb.upperBound = b3Add(aabb.upperBound, r);
    return aabb;
}

b3AABB b3ComputeSweptShapeAABB(b3Shape* shape, b3Sweep* sweep, f32 time) {
    var xf1 = b3Transform{b3Sub(sweep.c1, b3RotateVector(sweep.q1, sweep.localCenter)), sweep.q1};
    b3Transform xf2 = b3GetSweepTransform(sweep, time);
    switch shape.type {
        case b3_capsuleShape: {
            return b3ComputeSweptCapsuleAABB(&shape.capsule, xf1, xf2);
        }
        case b3_hullShape: {
            return b3ComputeSweptHullAABB(shape.hull, xf1, xf2);
        }
        case b3_sphereShape: {
            return b3ComputeSweptSphereAABB(&shape.sphere, xf1, xf2);
        }
        default: {
            return b3AABB{xf1.p, xf1.p};
        }
    }
}

b3Vec3 b3GetShapeCentroid(b3Shape* shape) {
    switch shape.type {
        case b3_capsuleShape: {
            return b3Lerp(shape.capsule.center1, shape.capsule.center2, 0.5f);
        }
        case b3_compoundShape: {
            {
                b3AABB aabb = b3ComputeCompoundAABB(shape.compound, b3Transform_identity);
                return b3AABB_Center(aabb);
            }
        }
        case b3_sphereShape: {
            return shape.sphere.center;
        }
        case b3_hullShape: {
            return shape.hull.center;
        }
        case b3_meshShape: {
            {
                b3AABB aabb = b3ComputeMeshAABB(shape.mesh.data, b3Transform_identity, shape.mesh.scale);
                return b3AABB_Center(aabb);
            }
        }
        case b3_heightShape: {
            {
                b3AABB aabb = b3ComputeHeightFieldAABB(shape.heightField, b3Transform_identity);
                return b3AABB_Center(aabb);
            }
        }
        default: {
            return b3Vec3_zero;
        }
    }
}

f32 b3GetShapeArea(b3Shape* shape) {
    switch shape.type {
        case b3_capsuleShape: {
            return 2.0f * b3Length(b3Sub(shape.capsule.center1, shape.capsule.center2)) + 2.0f * 3.14159265359f * shape.capsule.radius;
        }
        case b3_hullShape: {
            return shape.hull.surfaceArea;
        }
        case b3_sphereShape: {
            return 2.0f * 3.14159265359f * shape.sphere.radius;
        }
        default: {
            return 0.0f;
        }
    }
}

// This projects the shape surface area onto a plane
f32 b3GetShapeProjectedArea(b3Shape* shape, b3Vec3 planeNormal) {
    switch shape.type {
        case b3_capsuleShape: {
            {
                f32 radius = shape.capsule.radius;
                b3Vec3 axis = b3Sub(shape.capsule.center2, shape.capsule.center1);
                f32 projectedLength = b3Length(b3Cross(axis, planeNormal));
                f32 cylinderArea = 2.0f * radius * projectedLength;
                f32 sphereArea = 3.14159265359f * radius * radius;
                return sphereArea + cylinderArea;
            }
        }
        case b3_hullShape: {
            return b3ComputeHullProjectedArea(shape.hull, planeNormal);
        }
        case b3_sphereShape: {
            return 3.14159265359f * shape.sphere.radius * shape.sphere.radius;
        }
        default: {
            return 0.0f;
        }
    }
}

b3MassData b3ComputeShapeMass(b3Shape* shape) {
    switch shape.type {
        case b3_capsuleShape: {
            return b3ComputeCapsuleMass(&shape.capsule, shape.density);
        }
        case b3_hullShape: {
            return b3ComputeHullMass(shape.hull, shape.density);
        }
        case b3_sphereShape: {
            return b3ComputeSphereMass(&shape.sphere, shape.density);
        }
        default: {
            return b3MassData{};
        }
    }
}

b3ShapeExtent b3ComputeShapeExtent(b3Shape* shape, b3Vec3 localCenter) {
    b3ShapeExtent extent;
    switch shape.type {
        case b3_capsuleShape: {
            {
                f32 radius = shape.capsule.radius;
                extent.minExtent = radius;
                b3Vec3 c1 = b3Sub(shape.capsule.center1, localCenter);
                b3Vec3 c2 = b3Sub(shape.capsule.center2, localCenter);
                var r = b3Vec3{radius, radius, radius};
                extent.maxExtent = b3Add(b3Max(c1, c2), r);
            }
        }
        case b3_compoundShape: {
            {
                b3AABB aabb = b3ComputeCompoundAABB(shape.compound, b3Transform_identity);
                f32 r1 = b3Length(b3Sub(aabb.lowerBound, localCenter));
                f32 r2 = b3Length(b3Sub(aabb.upperBound, localCenter));
                extent.minExtent = b3MinFloat(r1, r2);
                b3Vec3 p = b3FarthestPointOnAABB(aabb, localCenter);
                extent.maxExtent = b3Abs(b3Sub(p, localCenter));
            }
        }
        case b3_sphereShape: {
            {
                f32 radius = shape.sphere.radius;
                extent.minExtent = radius;
                var r = b3Vec3{radius, radius, radius};
                b3Vec3 p = b3Add(b3Sub(shape.sphere.center, localCenter), r);
                extent.maxExtent = b3Abs(b3Sub(p, localCenter));
            }
        }
        case b3_hullShape: {
            extent = b3ComputeHullExtent(shape.hull, localCenter);
        }
        case b3_meshShape: {
            {
                b3AABB aabb = b3ComputeMeshAABB(shape.mesh.data, b3Transform_identity, shape.mesh.scale);
                f32 r1 = b3Length(b3Sub(aabb.lowerBound, localCenter));
                f32 r2 = b3Length(b3Sub(aabb.upperBound, localCenter));
                extent.minExtent = b3MinFloat(r1, r2);
                b3Vec3 p = b3FarthestPointOnAABB(aabb, localCenter);
                extent.maxExtent = b3Abs(p);
            }
        }
        default: {
        }
    }
    return extent;
}

b3CastOutput b3RayCastShape(b3Shape* shape, b3Transform transform, b3RayCastInput* input) {
    b3RayCastInput localInput = *input;
    localInput.origin = b3InvTransformPoint(transform, input.origin);
    localInput.translation = b3InvRotateVector(transform.q, input.translation);
    b3CastOutput output;
    switch shape.type {
        case b3_capsuleShape: {
            output = b3RayCastCapsule(&shape.capsule, &localInput);
        }
        case b3_compoundShape: {
            output = b3RayCastCompound(shape.compound, &localInput);
        }
        case b3_sphereShape: {
            output = b3RayCastSphere(&shape.sphere, &localInput);
        }
        case b3_hullShape: {
            output = b3RayCastHull(shape.hull, &localInput);
        }
        case b3_meshShape: {
            output = b3RayCastMesh(&shape.mesh, &localInput);
        }
        case b3_heightShape: {
            output = b3RayCastHeightField(shape.heightField, &localInput);
        }
        default: {
            return output;
        }
    }
    output.point = b3TransformPoint(transform, output.point);
    output.normal = b3RotateVector(transform.q, output.normal);
    return output;
}

b3CastOutput b3ShapeCastShape(b3Shape* shape, b3Transform transform, b3ShapeCastInput* input) {
    b3ShapeCastInput localInput = *input;
    noinit b3Vec3[64] localPoints;
    localInput.proxy.count = b3MinInt(input.proxy.count, 64);
    for i32 i = 0; i < localInput.proxy.count; ++i {
        localPoints[i] = b3InvTransformPoint(transform, input.proxy.points[i]);
    }
    localInput.proxy.points = localPoints;
    localInput.translation = b3InvRotateVector(transform.q, input.translation);
    b3CastOutput output;
    switch shape.type {
        case b3_capsuleShape: {
            output = b3ShapeCastCapsule(&shape.capsule, &localInput);
        }
        case b3_compoundShape: {
            output = b3ShapeCastCompound(shape.compound, &localInput);
        }
        case b3_heightShape: {
            output = b3ShapeCastHeightField(shape.heightField, &localInput);
        }
        case b3_hullShape: {
            output = b3ShapeCastHull(shape.hull, &localInput);
        }
        case b3_meshShape: {
            output = b3ShapeCastMesh(&shape.mesh, &localInput);
        }
        case b3_sphereShape: {
            output = b3ShapeCastSphere(&shape.sphere, &localInput);
        }
        default: {
            return output;
        }
    }
    output.point = b3TransformPoint(transform, output.point);
    output.normal = b3RotateVector(transform.q, output.normal);
    return output;
}

bool b3OverlapShape(b3Shape* shape, b3Transform transform, b3ShapeProxy* proxy) {
    b3ShapeType type = shape.type;
    switch type {
        case b3_capsuleShape: {
            return b3OverlapCapsule(&shape.capsule, transform, proxy);
        }
        case b3_compoundShape: {
            return b3OverlapCompound(shape.compound, transform, proxy);
        }
        case b3_heightShape: {
            return b3OverlapHeightField(shape.heightField, transform, proxy);
        }
        case b3_hullShape: {
            return b3OverlapHull(shape.hull, transform, proxy);
        }
        case b3_meshShape: {
            return b3OverlapMesh(&shape.mesh, transform, proxy);
        }
        case b3_sphereShape: {
            return b3OverlapSphere(&shape.sphere, transform, proxy);
        }
        default: {
            return false;
        }
    }
}

i32 b3CollideMover(b3PlaneResult* planes, i32 planeCapacity, b3Shape* shape, b3Transform transform, b3Capsule* mover) {
    if planeCapacity == 0 {
        return 0;
    }
    noinit b3Capsule localMover;
    localMover.center1 = b3InvTransformPoint(transform, mover.center1);
    localMover.center2 = b3InvTransformPoint(transform, mover.center2);
    localMover.radius = mover.radius;
    i32 planeCount = 0;
    switch shape.type {
        case b3_capsuleShape: {
            planeCount = b3CollideMoverAndCapsule(planes, &shape.capsule, &localMover);
        }
        case b3_compoundShape: {
            planeCount = b3CollideMoverAndCompound(planes, planeCapacity, shape.compound, &localMover);
        }
        case b3_sphereShape: {
            planeCount = b3CollideMoverAndSphere(planes, &shape.sphere, &localMover);
        }
        case b3_hullShape: {
            planeCount = b3CollideMoverAndHull(planes, shape.hull, &localMover);
        }
        case b3_meshShape: {
            planeCount = b3CollideMoverAndMesh(planes, planeCapacity, &shape.mesh, &localMover);
        }
        case b3_heightShape: {
            planeCount = b3CollideMoverAndHeightField(planes, planeCapacity, shape.heightField, &localMover);
        }
        default: {
        }
    }
    for i32 i = 0; i < planeCount; ++i {
        planes[i].plane.normal = b3RotateVector(transform.q, planes[i].plane.normal);
        planes[i].point = b3TransformPoint(transform, planes[i].point);
    }
    return planeCount;
}

void b3CreateShapeProxy(b3Shape* shape, b3BroadPhase* bp, b3BodyType type, b3WorldTransform transform, bool forcePairCreation) {
    b3UpdateShapeAABBs(shape, transform, type);
    shape.proxyKey = b3BroadPhase_CreateProxy(bp, type, shape.fatAABB, shape.filter.categoryBits, shape.id, forcePairCreation);
}

void b3DestroyShapeProxy(b3Shape* shape, b3BroadPhase* bp) {
    if shape.proxyKey != -1 {
        b3BroadPhase_DestroyProxy(bp, shape.proxyKey);
        shape.proxyKey = -1;
    }
}

private {
void b3DestroyShapeAllocationForShapeChange(b3World* world, b3Shape* shape) {
    b3ShapeType type = shape.type;
    switch type {
        case b3_hullShape: {
            b3RemoveHullFromDatabase(world, shape.hull);
            shape.hull = null;
        }
        default: {
        }
    }
    if shape.userShape != null {
        world.destroyDebugShape(shape.userShape, world.userDebugShapeContext);
        shape.userShape = null;
    }
}
}

void b3DestroyShapeAllocations(b3World* world, b3Shape* shape) {
    b3DestroyShapeAllocationForShapeChange(world, shape);
    if shape.materials != null {
        b3Free(shape.materials, cast(u64, shape.materialCount * sizeof(b3SurfaceMaterial)));
        shape.materials = null;
        shape.materialCount = 0;
    }
}

b3ShapeProxy b3MakeShapeProxy(b3Shape* shape) {
    switch shape.type {
        case b3_capsuleShape: {
            return b3ShapeProxy{&shape.capsule.center1, 2, shape.capsule.radius};
        }
        case b3_sphereShape: {
            return b3ShapeProxy{&shape.sphere.center, 1, shape.sphere.radius};
        }
        case b3_hullShape: {
            {
                b3HullData* hull = shape.hull;
                b3Vec3* points = b3GetHullPoints(hull);
                return b3ShapeProxy{points, hull.vertexCount, 0.0f};
            }
        }
        default: {
            {
                return b3ShapeProxy{};
            }
        }
    }
}

b3ShapeProxy b3MakeLocalProxy(b3ShapeProxy* proxy, b3Transform transform, b3Vec3* buffer) {
    b3Transform invTransform = b3InvertTransform(transform);
    b3Matrix3 R = b3MakeMatrixFromQuat(invTransform.q);
    i32 count = b3MinInt(proxy.count, 64);
    for i32 i = 0; i < count; ++i {
        buffer[i] = b3Add(b3MulMV(R, proxy.points[i]), invTransform.p);
    }
    return b3ShapeProxy{.points = buffer, .count = count, .radius = proxy.radius};
}

b3AABB b3ComputeProxyAABB(b3ShapeProxy* proxy) {
    b3Vec3* points = proxy.points;
    var aabb = b3AABB{.lowerBound = points[0], .upperBound = points[0]};
    for i32 i = 1; i < proxy.count; ++i {
        aabb.lowerBound = b3Min(aabb.lowerBound, points[i]);
        aabb.upperBound = b3Max(aabb.upperBound, points[i]);
    }
    var r = b3Vec3{proxy.radius, proxy.radius, proxy.radius};
    aabb.lowerBound = b3Sub(aabb.lowerBound, r);
    aabb.upperBound = b3Add(aabb.upperBound, r);
    return aabb;
}

b3BodyId b3Shape_GetBody(b3ShapeId shapeId) {
    b3World* world = b3GetWorld(cast(i32, shapeId.world0));
    b3Shape* shape = b3GetShape(world, shapeId);
    return b3MakeBodyId(world, shape.bodyId);
}

b3WorldId b3Shape_GetWorld(b3ShapeId shapeId) {
    b3World* world = b3GetWorld(cast(i32, shapeId.world0));
    return b3WorldId{cast(u16, shapeId.world0 + 1), world.generation};
}

void b3Shape_SetUserData(b3ShapeId shapeId, void* userData) {
    b3World* world = b3GetWorld(cast(i32, shapeId.world0));
    b3Shape* shape = b3GetShape(world, shapeId);
    shape.userData = userData;
}

void* b3Shape_GetUserData(b3ShapeId shapeId) {
    b3World* world = b3GetWorld(cast(i32, shapeId.world0));
    b3Shape* shape = b3GetShape(world, shapeId);
    return shape.userData;
}

void b3Shape_SetName(b3ShapeId shapeId, u8* name) {
    b3World* world = b3GetWorld(cast(i32, shapeId.world0));
    while true {
        if world.recording != null {
            var recArgs = b3RecArgs_ShapeSetName{shapeId, name};
            b3RecWrite_ShapeSetName(world.recording, &recArgs);
        }
        if !(0 != 0) { break; }
    }
    b3Shape* shape = b3GetShape(world, shapeId);
    shape.nameId = b3AddName(&world.names, name);
}

