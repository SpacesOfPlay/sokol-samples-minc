            .wgsl_group0_binding_n = 0,
            .spirv_set0_binding_n = 0,
            .glsl_uniforms[0] = {
                .type = SG_UNIFORMTYPE_FLOAT4,
                .array_count = 1,
                .glsl_name = "offscreen_vs_params",
            },
        },
        .views[0] = {
            .texture = {
