void sdtx_putc(u8 chr) {
    assert(0xACBAABCA == _sdtx.init_cookie);
    _sdtx_context_t* ctx = _sdtx.cur_ctx;
    if ctx != null {
        _sdtx_put_char(ctx, chr);
    }
}

void sdtx_puts(u8* str_var) {
    assert(0xACBAABCA == _sdtx.init_cookie);
    _sdtx_context_t* ctx = _sdtx.cur_ctx;
    if ctx != null {
        u8 chr;
        while true {
            chr = *str_var++;
            if 0 != chr == 0 {
                break;
            }
            _sdtx_put_char(ctx, chr);
        }
    }
}

void sdtx_putr(u8* str_var, i32 len) {
    assert(0xACBAABCA == _sdtx.init_cookie);
    _sdtx_context_t* ctx = _sdtx.cur_ctx;
    if ctx != null {
        for i32 i = 0; i < len; i++ {
            u8 chr = str_var[i];
            if 0 == chr {
                break;
            }
            _sdtx_put_char(ctx, chr);
        }
    }
}

i32 sdtx_vprintf(u8* fmt, void* args) {
    assert(0xACBAABCA == _sdtx.init_cookie);
    assert(_sdtx.fmt_buf && _sdtx.fmt_buf_size >= 2);
    i32 res = vsnprintf(_sdtx.fmt_buf, _sdtx.fmt_buf_size, fmt, cast(&..., args));
    _sdtx.fmt_buf[_sdtx.fmt_buf_size - 1] = 0;
    sdtx_puts(_sdtx.fmt_buf);
    return res;
}

i32 sdtx_printf(u8* fmt, ...) {
    assert(0xACBAABCA == _sdtx.init_cookie);
    assert(_sdtx.fmt_buf && _sdtx.fmt_buf_size >= 2);
    i32 res = vsnprintf(_sdtx.fmt_buf, _sdtx.fmt_buf_size, fmt, &...);
    _sdtx.fmt_buf[_sdtx.fmt_buf_size - 1] = 0;
    sdtx_puts(_sdtx.fmt_buf);
    return res;
}

sdtx_range sdtx_get_cleared_fmt_buffer() {
    assert(0xACBAABCA == _sdtx.init_cookie);
    assert(_sdtx.fmt_buf && _sdtx.fmt_buf_size >= 2);
    memset(_sdtx.fmt_buf, 0, cast(u64, _sdtx.fmt_buf_size));
    noinit sdtx_range res;
    _sdtx_clear(&res, cast(u64, sizeof(res)));
    res.ptr = _sdtx.fmt_buf;
    res.size = _sdtx.fmt_buf_size - 1;
    return res;
}

