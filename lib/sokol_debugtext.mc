    assert(size > 0);
    void* ptr;
    if _sdtx.desc.allocator.alloc_fn != null {
        ptr = _sdtx.desc.allocator.alloc_fn(size, _sdtx.desc.allocator.user_data);
    } else {
        ptr = alloc(cast(i64, size));
    }
    if null == ptr {
        _sdtx_log(SDTX_LOGITEM_MALLOC_FAILED, 0, 3711);
    }
    return ptr;
}

void* _sdtx_malloc_clear(u64 size) {
    void* ptr = _sdtx_malloc(size);
    _sdtx_clear(ptr, size);
    return ptr;
}

void _sdtx_free(void* ptr) {
    if _sdtx.desc.allocator.free_fn != null {
        _sdtx.desc.allocator.free_fn(ptr, _sdtx.desc.allocator.user_data);
    } else {
        free(ptr);
    }
}

//  ██████  ██████  ███    ██ ████████ ███████ ██   ██ ████████     ██████   ██████   ██████  ██
// ██      ██    ██ ████   ██    ██    ██       ██ ██     ██        ██   ██ ██    ██ ██    ██ ██
// ██      ██    ██ ██ ██  ██    ██    █████     ███      ██        ██████  ██    ██ ██    ██ ██
// ██      ██    ██ ██  ██ ██    ██    ██       ██ ██     ██        ██      ██    ██ ██    ██ ██
//  ██████  ██████  ██   ████    ██    ███████ ██   ██    ██        ██       ██████   ██████  ███████
//
// >>context pool
void _sdtx_init_pool(_sdtx_pool_t* pool, i32 num) {
    assert(pool && num >= 1);
    pool.size = num + 1;
    pool.queue_top = 0;
    u64 gen_ctrs_size = cast(u64, sizeof(u32)) * cast(u64, pool.size);
    pool.gen_ctrs = cast(u32*, _sdtx_malloc_clear(gen_ctrs_size));
    pool.free_queue = cast(i32*, _sdtx_malloc_clear(cast(u64, sizeof(i32)) * cast(u64, num)));
    for i32 i = pool.size - 1; i >= 1; i-- {
        pool.free_queue[pool.queue_top++] = i;
    }
}

void _sdtx_discard_pool(_sdtx_pool_t* pool) {
    assert(cast(i64, pool));
    assert(cast(i64, pool.free_queue));
    _sdtx_free(pool.free_queue);
    pool.free_queue = null;
    assert(cast(i64, pool.gen_ctrs));
    _sdtx_free(pool.gen_ctrs);
    pool.gen_ctrs = null;
    pool.size = 0;
    pool.queue_top = 0;
}

i32 _sdtx_pool_alloc_index(_sdtx_pool_t* pool) {
    assert(cast(i64, pool));
    assert(cast(i64, pool.free_queue));
    if pool.queue_top > 0 {
        i32 slot_index = pool.free_queue[--pool.queue_top];
        assert(slot_index > 0 && slot_index < pool.size);
        return slot_index;
    } else {
        return 0;
    }
}

void _sdtx_pool_free_index(_sdtx_pool_t* pool, i32 slot_index) {
    assert(slot_index > 0 && slot_index < pool.size);
    assert(cast(i64, pool));
    assert(cast(i64, pool.free_queue));
    assert(pool.queue_top < pool.size);
    when defined(SOKOL_DEBUG) {
        for i32 i = 0; i < pool.queue_top; i++ {
            assert(pool.free_queue[i] != slot_index);
        }
    }
    pool.free_queue[pool.queue_top++] = slot_index;
    assert(pool.queue_top <= pool.size - 1);
}

void _sdtx_setup_context_pool(sdtx_desc_t* desc) {
    assert(cast(i64, desc));
    assert(desc.context_pool_size > 0 && desc.context_pool_size < 1 << 16);
    _sdtx_init_pool(&_sdtx.context_pool.pool, desc.context_pool_size);
    u64 pool_byte_size = cast(u64, sizeof(_sdtx_context_t)) * cast(u64, _sdtx.context_pool.pool.size);
    _sdtx.context_pool.contexts = cast(_sdtx_context_t*, _sdtx_malloc_clear(pool_byte_size));
}

void _sdtx_discard_context_pool() {
    assert(cast(i64, _sdtx.context_pool.contexts));
    _sdtx_free(_sdtx.context_pool.contexts);
    _sdtx.context_pool.contexts = null;
    _sdtx_discard_pool(&_sdtx.context_pool.pool);
}

/* allocate the slot at slot_index:
    - bump the slot's generation counter
    - create a resource id from the generation counter and slot index
    - set the slot's id to this id
    - set the slot's state to ALLOC
    - return the resource id
*/
u32 _sdtx_slot_alloc(_sdtx_pool_t* pool, _sdtx_slot_t* slot, i32 slot_index) {
    assert(pool && pool.gen_ctrs);
    assert(slot_index > 0 && slot_index < pool.size);
    assert(slot.state == SG_RESOURCESTATE_INITIAL && slot.id == cast(u32, SG_INVALID_ID));
    u32 ctr = ++pool.gen_ctrs[slot_index];
    slot.id = ctr << 16 | cast(u32, slot_index & (1 << 16) - 1);
    slot.state = SG_RESOURCESTATE_ALLOC;
    return slot.id;
}

// extract slot index from id
i32 _sdtx_slot_index(u32 id) {
    var slot_index = cast(i32, id & cast(u32, (1 << 16) - 1));
    assert(0 != slot_index);
    return slot_index;
}

// get context pointer without id-check
_sdtx_context_t* _sdtx_context_at(u32 ctx_id) {
    assert(cast(u32, SG_INVALID_ID) != ctx_id);
    i32 slot_index = _sdtx_slot_index(ctx_id);
    assert(slot_index > 0 && slot_index < _sdtx.context_pool.pool.size);
    return &_sdtx.context_pool.contexts[slot_index];
}

// get context pointer with id-check, returns 0 if no match
_sdtx_context_t* _sdtx_lookup_context(u32 ctx_id) {
    if cast(u32, SG_INVALID_ID) != ctx_id {
        _sdtx_context_t* ctx = _sdtx_context_at(ctx_id);
        if ctx.slot.id == ctx_id {
            return ctx;
        }
    }
    return null;
}

// make context handle from raw uint32_t id
sdtx_context _sdtx_make_ctx_id(u32 ctx_id) {
    noinit sdtx_context ctx;
    ctx.id = ctx_id;
    return ctx;
}

sdtx_context _sdtx_alloc_context() {
    noinit sdtx_context ctx_id;
    i32 slot_index = _sdtx_pool_alloc_index(&_sdtx.context_pool.pool);
    if 0 != slot_index {
        ctx_id = _sdtx_make_ctx_id(_sdtx_slot_alloc(&_sdtx.context_pool.pool, &_sdtx.context_pool.contexts[slot_index].slot, slot_index));
    } else {
        ctx_id = _sdtx_make_ctx_id(cast(u32, SG_INVALID_ID));
    }
    return ctx_id;
}

sdtx_context_desc_t _sdtx_context_desc_defaults(sdtx_context_desc_t* desc) {
    sdtx_context_desc_t res = *desc;
    res.max_commands = res.max_commands == 0 ? 4096 : res.max_commands;
    res.char_buf_size = res.char_buf_size == 0 ? 4096 : res.char_buf_size;
    res.canvas_width = cast(f32, res.canvas_width == 0.0f ? 640.0f : res.canvas_width);
    res.canvas_height = cast(f32, res.canvas_height == 0.0f ? 480.0f : res.canvas_height);
    res.tab_width = res.tab_width == 0 ? 4 : res.tab_width;
    assert(res.char_buf_size > 0);
    assert(cast(i64, !isnan(res.canvas_width)));
    assert(cast(i64, !isnan(res.canvas_height)));
    assert(res.canvas_width > 0.0f);
    assert(res.canvas_height > 0.0f);
    return res;
}
}

private {
void _sdtx_rewind(_sdtx_context_t* ctx) {
    assert(cast(i64, ctx));
    ctx.frame_id++;
    ctx.vertices.next = 0;
    ctx.commands.next = 0;
    _sdtx_set_layer(ctx, 0);
    ctx.cur_font = 0;
    ctx.pos.x = 0.0f;
    ctx.pos.y = 0.0f;
}

void _sdtx_commit_listener(void* userdata) {
    _sdtx_context_t* ctx = _sdtx_lookup_context(cast(u32, cast(u64, userdata)));
    if ctx != null {
        _sdtx_rewind(ctx);
    }
}

sg_commit_listener _sdtx_make_commit_listener(_sdtx_context_t* ctx) {
    var listener = sg_commit_listener{_sdtx_commit_listener, cast(void*, cast(u64, ctx.slot.id))};
    return listener;
}

void _sdtx_init_context(sdtx_context ctx_id, sdtx_context_desc_t* in_desc) {
    sg_push_debug_group("sokol-debugtext");
    assert(ctx_id.id != cast(u32, SG_INVALID_ID) && in_desc);
    _sdtx_context_t* ctx = _sdtx_lookup_context(ctx_id.id);
    assert(cast(i64, ctx));
    ctx.desc = _sdtx_context_desc_defaults(in_desc);
    ctx.frame_id = 1;
    ctx.vertices.cap = 6 * ctx.desc.char_buf_size;
    u64 vbuf_size = cast(u64, ctx.vertices.cap) * cast(u64, sizeof(_sdtx_vertex_t));
    ctx.vertices.ptr = cast(_sdtx_vertex_t*, _sdtx_malloc(vbuf_size));
    ctx.commands.cap = ctx.desc.max_commands;
    ctx.commands.ptr = cast(_sdtx_command_t*, _sdtx_malloc(cast(u64, ctx.commands.cap) * cast(u64, sizeof(_sdtx_command_t))));
    _sdtx_set_layer(ctx, 0);
    noinit sg_buffer_desc vbuf_desc;
    _sdtx_clear(&vbuf_desc, cast(u64, sizeof(vbuf_desc)));
    vbuf_desc.size = vbuf_size;
    vbuf_desc.usage.vertex_buffer = true;
    vbuf_desc.usage.stream_update = true;
    vbuf_desc.label = "sdtx-vbuf";
    ctx.vbuf = sg_make_buffer(&vbuf_desc);
    assert(cast(u32, SG_INVALID_ID) != ctx.vbuf.id);
    noinit sg_pipeline_desc pip_desc;
    _sdtx_clear(&pip_desc, cast(u64, sizeof(pip_desc)));
    pip_desc.layout.buffers[0].stride = cast(i32, sizeof(_sdtx_vertex_t));
    pip_desc.layout.attrs[0].format = SG_VERTEXFORMAT_FLOAT2;
    pip_desc.layout.attrs[1].format = SG_VERTEXFORMAT_USHORT2N;
    pip_desc.layout.attrs[2].format = SG_VERTEXFORMAT_UBYTE4N;
    pip_desc.shader = _sdtx.shader;
    pip_desc.index_type = SG_INDEXTYPE_NONE;
    pip_desc.sample_count = ctx.desc.sample_count;
    pip_desc.depth.pixel_format = ctx.desc.depth_format;
    pip_desc.colors[0].pixel_format = ctx.desc.color_format;
    pip_desc.colors[0].blend.enabled = true;
    pip_desc.colors[0].blend.src_factor_rgb = SG_BLENDFACTOR_SRC_ALPHA;
    pip_desc.colors[0].blend.dst_factor_rgb = SG_BLENDFACTOR_ONE_MINUS_SRC_ALPHA;
    pip_desc.colors[0].blend.src_factor_alpha = SG_BLENDFACTOR_ONE;
    pip_desc.colors[0].blend.dst_factor_alpha = SG_BLENDFACTOR_ZERO;
    pip_desc.label = "sdtx-pipeline";
    ctx.pip = sg_make_pipeline(&pip_desc);
    assert(cast(u32, SG_INVALID_ID) != ctx.pip.id);
    ctx.canvas_size.x = ctx.desc.canvas_width;
    ctx.canvas_size.y = ctx.desc.canvas_height;
    ctx.glyph_size.x = 8.0f / ctx.canvas_size.x;
    ctx.glyph_size.y = 8.0f / ctx.canvas_size.y;
    ctx.tab_width = cast(f32, ctx.desc.tab_width);
    ctx.color = 0xFF00FFFF;
    if sg_add_commit_listener(_sdtx_make_commit_listener(ctx)) == 0 {
        _sdtx_log(SDTX_LOGITEM_ADD_COMMIT_LISTENER_FAILED, 1, 3712);
    }
    sg_pop_debug_group();
}

void _sdtx_destroy_context(sdtx_context ctx_id) {
    _sdtx_context_t* ctx = _sdtx_lookup_context(ctx_id.id);
    if ctx != null {
        if ctx.vertices.ptr != null {
            _sdtx_free(ctx.vertices.ptr);
            ctx.vertices.ptr = null;
            ctx.vertices.cap = 0;
            ctx.vertices.next = 0;
        }
        if ctx.commands.ptr != null {
            _sdtx_free(ctx.commands.ptr);
            ctx.commands.ptr = null;
            ctx.commands.cap = 0;
            ctx.commands.next = 0;
        }
        sg_push_debug_group("sokol_debugtext");
        sg_destroy_buffer(ctx.vbuf);
        sg_destroy_pipeline(ctx.pip);
        sg_remove_commit_listener(_sdtx_make_commit_listener(ctx));
        sg_pop_debug_group();
        _sdtx_clear(ctx, cast(u64, sizeof(*ctx)));
        _sdtx_pool_free_index(&_sdtx.context_pool.pool, _sdtx_slot_index(ctx_id.id));
    }
}

bool _sdtx_is_default_context(sdtx_context ctx_id) {
    return ctx_id.id == SDTX_DEFAULT_CONTEXT.id;
}

// ███    ███ ██ ███████  ██████
// ████  ████ ██ ██      ██
// ██ ████ ██ ██ ███████ ██
// ██  ██  ██ ██      ██ ██
// ██      ██ ██ ███████  ██████
//
// >>misc
// unpack linear 8x8 bits-per-pixel font data into 2D byte-per-pixel texture data
void _sdtx_unpack_font(sdtx_font_desc_t* font_desc, u8* out_pixels) {
    assert(cast(i64, font_desc.data.ptr));
    assert(font_desc.data.size > 0 && font_desc.data.size % 8 == 0);
    assert(font_desc.first_char <= font_desc.last_char);
    assert(cast(u64, (font_desc.last_char - font_desc.first_char + 1) * 8) == font_desc.data.size);
    var ptr = cast(u8*, font_desc.data.ptr);
    for i32 chr = cast(i32, font_desc.first_char); chr <= cast(i32, font_desc.last_char); chr++ {
        for i32 line = 0; line < 8; line++ {
            u8 bits = *ptr++;
            for i32 x = 0; x < 8; x++ {
                out_pixels[line * 256 * 8 + chr * 8 + x] = cast(u8, (cast(i32, bits) >> 7 - x & 1) != 0 ? 0xFF : 0x00);
            }
        }
    }
}

void _sdtx_setup_common() {
    _sdtx.fmt_buf_size = cast(u32, _sdtx.desc.printf_buf_size) + 1;
    _sdtx.fmt_buf = cast(u8*, _sdtx_malloc_clear(_sdtx.fmt_buf_size));
    sg_push_debug_group("sokol-debugtext");
    noinit sg_shader_desc shd_desc;
    _sdtx_clear(&shd_desc, cast(u64, sizeof(shd_desc)));
    shd_desc.label = "sokol-debugtext-shader";
    shd_desc.attrs[0].glsl_name = "position";
    shd_desc.attrs[1].glsl_name = "texcoord0";
    shd_desc.attrs[2].glsl_name = "color0";
    shd_desc.attrs[0].hlsl_sem_name = "TEXCOORD";
    shd_desc.attrs[0].hlsl_sem_index = 0;
    shd_desc.attrs[1].hlsl_sem_name = "TEXCOORD";
    shd_desc.attrs[1].hlsl_sem_index = 1;
    shd_desc.attrs[2].hlsl_sem_name = "TEXCOORD";
    shd_desc.attrs[2].hlsl_sem_index = 2;
    shd_desc.attrs[0].base_type = SG_SHADERATTRBASETYPE_FLOAT;
    shd_desc.attrs[1].base_type = SG_SHADERATTRBASETYPE_FLOAT;
    shd_desc.attrs[2].base_type = SG_SHADERATTRBASETYPE_FLOAT;
    shd_desc.views[0].texture.stage = SG_SHADERSTAGE_FRAGMENT;
    shd_desc.views[0].texture.image_type = SG_IMAGETYPE_2D;
    shd_desc.views[0].texture.sample_type = SG_IMAGESAMPLETYPE_FLOAT;
    shd_desc.views[0].texture.hlsl_register_t_n = 0;
    shd_desc.views[0].texture.msl_texture_n = 0;
    shd_desc.views[0].texture.wgsl_group1_binding_n = 0;
    shd_desc.views[0].texture.spirv_set1_binding_n = 0;
    shd_desc.samplers[0].stage = SG_SHADERSTAGE_FRAGMENT;
    shd_desc.samplers[0].sampler_type = SG_SAMPLERTYPE_FILTERING;
    shd_desc.samplers[0].hlsl_register_s_n = 0;
    shd_desc.samplers[0].msl_sampler_n = 0;
    shd_desc.samplers[0].wgsl_group1_binding_n = 32;
    shd_desc.samplers[0].spirv_set1_binding_n = 32;
    shd_desc.texture_sampler_pairs[0].stage = SG_SHADERSTAGE_FRAGMENT;
    shd_desc.texture_sampler_pairs[0].view_slot = 0;
    shd_desc.texture_sampler_pairs[0].sampler_slot = 0;
    shd_desc.texture_sampler_pairs[0].glsl_name = "tex_smp";
    when defined(SOKOL_GLCORE) {
        shd_desc.vertex_func.source = cast(u8*, _sdtx_shd_vs_source_glsl410);
        shd_desc.fragment_func.source = cast(u8*, _sdtx_shd_fs_source_glsl410);
    } else when defined(SOKOL_GLES3) {
        shd_desc.vertex_func.source = cast(u8*, _sdtx_shd_vs_source_glsl300es);
        shd_desc.fragment_func.source = cast(u8*, _sdtx_shd_fs_source_glsl300es);
    } else when defined(SOKOL_METAL) {
        shd_desc.vertex_func.entry = "main0";
        shd_desc.fragment_func.entry = "main0";
        switch sg_query_backend() {
            case SG_BACKEND_METAL_MACOS: {
                shd_desc.vertex_func.bytecode = sg_range{
                    &_sdtx_shd_vs_bytecode_metal_macos, sizeof(_sdtx_shd_vs_bytecode_metal_macos),
                };
                shd_desc.fragment_func.bytecode = sg_range{
                    &_sdtx_shd_fs_bytecode_metal_macos, sizeof(_sdtx_shd_fs_bytecode_metal_macos),
                };
            }
            case SG_BACKEND_METAL_IOS: {
                shd_desc.vertex_func.bytecode = sg_range{
                    &_sdtx_shd_vs_bytecode_metal_ios, sizeof(_sdtx_shd_vs_bytecode_metal_ios),
                };
                shd_desc.fragment_func.bytecode = sg_range{
                    &_sdtx_shd_fs_bytecode_metal_ios, sizeof(_sdtx_shd_fs_bytecode_metal_ios),
                };
            }
            default: {
                shd_desc.vertex_func.source = cast(u8*, _sdtx_shd_vs_source_metal_sim);
                shd_desc.fragment_func.source = cast(u8*, _sdtx_shd_fs_source_metal_sim);
            }
        }
    } else when defined(SOKOL_D3D11) {
        shd_desc.vertex_func.bytecode = sg_range{
            &_sdtx_shd_vs_bytecode_hlsl4, sizeof(_sdtx_shd_vs_bytecode_hlsl4),
        };
        shd_desc.fragment_func.bytecode = sg_range{
            &_sdtx_shd_fs_bytecode_hlsl4, sizeof(_sdtx_shd_fs_bytecode_hlsl4),
        };
    } else when defined(SOKOL_WGPU) {
        shd_desc.vertex_func.source = cast(u8*, _sdtx_shd_vs_source_wgsl);
        shd_desc.fragment_func.source = cast(u8*, _sdtx_shd_fs_source_wgsl);
    } else when defined(SOKOL_VULKAN) {
        shd_desc.vertex_func.bytecode = sg_range{
            &_sdtx_shd_vs_bytecode_spirv_vk, sizeof(_sdtx_shd_vs_bytecode_spirv_vk),
        };
        shd_desc.vertex_func.entry = "main";
        shd_desc.fragment_func.bytecode = sg_range{
            &_sdtx_shd_fs_bytecode_spirv_vk, sizeof(_sdtx_shd_fs_bytecode_spirv_vk),
        };
        shd_desc.fragment_func.entry = "main";
    } else {
        shd_desc.vertex_func.source = _sdtx_shd_vs_source_dummy;
        shd_desc.fragment_func.source = _sdtx_shd_fs_source_dummy;
    }
    _sdtx.shader = sg_make_shader(&shd_desc);
    assert(cast(u32, SG_INVALID_ID) != _sdtx.shader.id);
    memset(_sdtx.font_pixels, 0xFF, cast(u64, sizeof(_sdtx.font_pixels)));
    var unpacked_font_size = cast(i32, sizeof(_sdtx.font_pixels) / 8);
    for i32 i = 0; i < 8; i++ {
        if _sdtx.desc.fonts[i].data.ptr != null {
            _sdtx_unpack_font(&_sdtx.desc.fonts[i], &_sdtx.font_pixels[i * unpacked_font_size]);
        }
    }
    noinit sg_image_desc img_desc;
    _sdtx_clear(&img_desc, cast(u64, sizeof(img_desc)));
    img_desc.width = 256 * 8;
    img_desc.height = 8 * 8;
    img_desc.pixel_format = SG_PIXELFORMAT_R8;
    img_desc.data.mip_levels[0] = sg_range{&_sdtx.font_pixels, sizeof(_sdtx.font_pixels)};
    img_desc.label = "sdtx-font-texture";
    _sdtx.font_img = sg_make_image(&img_desc);
    assert(cast(u32, SG_INVALID_ID) != _sdtx.font_img.id);
    noinit sg_view_desc view_desc;
    _sdtx_clear(&view_desc, cast(u64, sizeof(view_desc)));
    view_desc.texture.image = _sdtx.font_img;
    view_desc.label = "sdtx-font-texture-view";
    _sdtx.font_view = sg_make_view(&view_desc);
    assert(cast(u32, SG_INVALID_ID) != _sdtx.font_view.id);
    noinit sg_sampler_desc smp_desc;
    _sdtx_clear(&smp_desc, cast(u64, sizeof(smp_desc)));
    smp_desc.min_filter = SG_FILTER_NEAREST;
    smp_desc.mag_filter = SG_FILTER_NEAREST;
    smp_desc.wrap_u = SG_WRAP_CLAMP_TO_EDGE;
    smp_desc.wrap_v = SG_WRAP_CLAMP_TO_EDGE;
    smp_desc.label = "sdtx-font-sampler";
    _sdtx.font_smp = sg_make_sampler(&smp_desc);
    assert(cast(u32, SG_INVALID_ID) != _sdtx.font_smp.id);
    sg_pop_debug_group();
}

void _sdtx_discard_common() {
    sg_push_debug_group("sokol-debugtext");
    sg_destroy_sampler(_sdtx.font_smp);
    sg_destroy_view(_sdtx.font_view);
    sg_destroy_image(_sdtx.font_img);
    sg_destroy_shader(_sdtx.shader);
    if _sdtx.fmt_buf != null {
        _sdtx_free(_sdtx.fmt_buf);
        _sdtx.fmt_buf = null;
    }
    sg_pop_debug_group();
}

u32 _sdtx_pack_rgbab(u8 r, u8 g, u8 b, u8 a) {
    return cast(u32, a) << 24 | cast(u32, b) << 16 | cast(u32, g) << 8 | r;
}

f32 _sdtx_clamp(f32 v, f32 lo, f32 hi) {
    if v < lo {
        return lo;
    } else if v > hi {
        return hi;
    } else {
        return v;
    }
}

u32 _sdtx_pack_rgbaf(f32 r, f32 g, f32 b, f32 a) {
    var r_u8 = cast(u8, _sdtx_clamp(r, 0.0f, 1.0f) * 255.0f);
    var g_u8 = cast(u8, _sdtx_clamp(g, 0.0f, 1.0f) * 255.0f);
    var b_u8 = cast(u8, _sdtx_clamp(b, 0.0f, 1.0f) * 255.0f);
    var a_u8 = cast(u8, _sdtx_clamp(a, 0.0f, 1.0f) * 255.0f);
    return _sdtx_pack_rgbab(r_u8, g_u8, b_u8, a_u8);
}

void _sdtx_ctrl_char(_sdtx_context_t* ctx, u8 c) {
    switch c {
        case 13: {
            ctx.pos.x = 0.0f;
        }
        case 10: {
            ctx.pos.x = 0.0f;
            ctx.pos.y += 1.0f;
        }
        case 9: {
            ctx.pos.x = ctx.pos.x - fmodf(ctx.pos.x, ctx.tab_width) + ctx.tab_width;
        }
        case 32: {
            ctx.pos.x += 1.0f;
        }
    }
}

_sdtx_vertex_t* _sdtx_next_vertex(_sdtx_context_t* ctx) {
    if ctx.vertices.next + 6 <= ctx.vertices.cap {
        _sdtx_vertex_t* vx = &ctx.vertices.ptr[ctx.vertices.next];
        ctx.vertices.next += 6;
        return vx;
    } else {
        return null;
    }
}

_sdtx_command_t* _sdtx_cur_command(_sdtx_context_t* ctx) {
    if ctx.commands.next > 0 {
        return &ctx.commands.ptr[ctx.commands.next - 1];
    } else {
        return null;
    }
}

_sdtx_command_t* _sdtx_next_command(_sdtx_context_t* ctx) {
    if ctx.commands.next < ctx.commands.cap {
        return &ctx.commands.ptr[ctx.commands.next++];
    } else {
        _sdtx_log(SDTX_LOGITEM_COMMAND_BUFFER_FULL, 1, 3712);
        return null;
    }
}

void _sdtx_set_layer(_sdtx_context_t* ctx, i32 layer_id) {
    ctx.cur_layer_id = layer_id;
    _sdtx_command_t* cur_cmd = _sdtx_cur_command(ctx);
    if cur_cmd != null {
        if cur_cmd.num_vertices == 0 || cur_cmd.layer_id == layer_id {
            cur_cmd.layer_id = layer_id;
        } else {
            _sdtx_command_t* next_cmd = _sdtx_next_command(ctx);
            if next_cmd != null {
                next_cmd.layer_id = layer_id;
                next_cmd.first_vertex = cur_cmd.first_vertex + cur_cmd.num_vertices;
                next_cmd.num_vertices = 0;
            }
        }
    } else {
        _sdtx_command_t* next_cmd = _sdtx_next_command(ctx);
        if next_cmd != null {
            next_cmd.layer_id = layer_id;
            next_cmd.first_vertex = 0;
            next_cmd.num_vertices = 0;
        }
    }
}

void _sdtx_render_char(_sdtx_context_t* ctx, u8 c) {
    _sdtx_vertex_t* vx = _sdtx_next_vertex(ctx);
    _sdtx_command_t* cmd = _sdtx_cur_command(ctx);
    if vx && cmd {
        cmd.num_vertices += 6;
        f32 x0 = (ctx.origin.x + ctx.pos.x) * ctx.glyph_size.x;
        f32 y0 = (ctx.origin.y + ctx.pos.y) * ctx.glyph_size.y;
        f32 x1 = x0 + ctx.glyph_size.x;
        f32 y1 = y0 + ctx.glyph_size.y;
        var uvw = cast(u16, 0x10000 / 0x100);
        var uvh = cast(u16, 0x10000 / 8);
        var u0 = cast(u16, cast(u16, c) * uvw + 1);
        var v0 = cast(u16, cast(u16, ctx.cur_font) * uvh + 1);
        var u1 = cast(u16, u0 + uvw - 2);
        var v1 = cast(u16, v0 + uvh - 2);
        u32 color = ctx.color;
        vx.x = x0;
        vx.y = y0;
        vx.u = u0;
        vx.v = v0;
        vx.color = color;
        vx++;
        vx.x = x1;
        vx.y = y0;
        vx.u = u1;
        vx.v = v0;
        vx.color = color;
        vx++;
        vx.x = x1;
        vx.y = y1;
        vx.u = u1;
        vx.v = v1;
        vx.color = color;
        vx++;
        vx.x = x0;
        vx.y = y0;
        vx.u = u0;
        vx.v = v0;
        vx.color = color;
        vx++;
        vx.x = x1;
        vx.y = y1;
        vx.u = u1;
        vx.v = v1;
        vx.color = color;
        vx++;
        vx.x = x0;
        vx.y = y1;
        vx.u = u0;
        vx.v = v1;
        vx.color = color;
        vx++;
    }
    ctx.pos.x += 1.0f;
}

void _sdtx_put_char(_sdtx_context_t* ctx, u8 c) {
    var c_u8 = cast(u8, c);
    if c_u8 <= 32 {
        _sdtx_ctrl_char(ctx, c_u8);
    } else {
        _sdtx_render_char(ctx, c_u8);
    }
}
}

void _sdtx_draw_layer(_sdtx_context_t* ctx, i32 layer_id) {
    assert(0xACBAABCA == _sdtx.init_cookie);
    assert(cast(i64, ctx));
    if ctx.vertices.next > 0 && ctx.commands.next > 0 {
        sg_push_debug_group("sokol-debugtext");
        if ctx.update_frame_id != ctx.frame_id {
            ctx.update_frame_id = ctx.frame_id;
            var range = sg_range{
                ctx.vertices.ptr, cast(u64, ctx.vertices.next) * cast(u64, sizeof(_sdtx_vertex_t)),
            };
            sg_update_buffer(ctx.vbuf, &range);
        }
        sg_apply_pipeline(ctx.pip);
        noinit sg_bindings bindings;
        _sdtx_clear(&bindings, cast(u64, sizeof(bindings)));
        bindings.vertex_buffers[0] = ctx.vbuf;
        bindings.views[0] = _sdtx.font_view;
        bindings.samplers[0] = _sdtx.font_smp;
        sg_apply_bindings(&bindings);
        for i32 cmd_index = 0; cmd_index < ctx.commands.next; cmd_index++ {
            _sdtx_command_t* cmd = &ctx.commands.ptr[cmd_index];
            if cmd.layer_id != layer_id {
                continue;
            }
            assert(cmd.num_vertices % 6 == 0);
            sg_draw(cmd.first_vertex, cmd.num_vertices, 1);
        }
        sg_pop_debug_group();
    }
}

private {
sdtx_desc_t _sdtx_desc_defaults(sdtx_desc_t* desc) {
    assert(desc.allocator.alloc_fn && desc.allocator.free_fn || !desc.allocator.alloc_fn && !desc.allocator.free_fn);
    sdtx_desc_t res = *desc;
    res.context_pool_size = res.context_pool_size == 0 ? 8 : res.context_pool_size;
    res.printf_buf_size = res.printf_buf_size == 0 ? 4096 : res.printf_buf_size;
    for i32 i = 0; i < 8; i++ {
        if res.fonts[i].data.ptr != null {
            res.fonts[i].last_char = cast(u8, res.fonts[i].last_char == 0 ? 255 : res.fonts[i].last_char);
        }
    }
    res.context = _sdtx_context_desc_defaults(&res.context);
    assert(res.context_pool_size > 0);
    assert(res.printf_buf_size > 0);
    assert(res.context.char_buf_size > 0);
    return res;
}
}

// ██████  ██    ██ ██████  ██      ██  ██████
// ██   ██ ██    ██ ██   ██ ██      ██ ██
// ██████  ██    ██ ██████  ██      ██ ██
// ██      ██    ██ ██   ██ ██      ██ ██
// ██       ██████  ██████  ███████ ██  ██████
//
// >>public
void sdtx_setup(sdtx_desc_t* desc) {
    assert(cast(i64, desc));
    _sdtx_clear(&_sdtx, cast(u64, sizeof(_sdtx)));
    _sdtx.init_cookie = 0xACBAABCA;
    _sdtx.desc = _sdtx_desc_defaults(desc);
    _sdtx_setup_context_pool(&_sdtx.desc);
    _sdtx_setup_common();
    _sdtx.def_ctx_id = sdtx_make_context(&_sdtx.desc.context);
    assert(SDTX_DEFAULT_CONTEXT.id == _sdtx.def_ctx_id.id);
    sdtx_set_context(_sdtx.def_ctx_id);
}

void sdtx_shutdown() {
    assert(0xACBAABCA == _sdtx.init_cookie);
    for i32 i = 0; i < _sdtx.context_pool.pool.size; i++ {
        _sdtx_context_t* ctx = &_sdtx.context_pool.contexts[i];
        _sdtx_destroy_context(_sdtx_make_ctx_id(ctx.slot.id));
    }
    _sdtx_discard_common();
    _sdtx_discard_context_pool();
    _sdtx.init_cookie = 0;
}

sdtx_font_desc_t sdtx_font_kc853() {
    var desc = sdtx_font_desc_t{sdtx_range{_sdtx_font_kc853, sizeof(_sdtx_font_kc853)}, 0, 255};
    return desc;
}

