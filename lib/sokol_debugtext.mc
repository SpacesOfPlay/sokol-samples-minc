sdtx_context sdtx_make_context(sdtx_context_desc_t* desc) {
    assert(0xACBAABCA == _sdtx.init_cookie);
    assert(cast(i64, desc));
    sdtx_context ctx_id = _sdtx_alloc_context();
    if ctx_id.id != cast(u32, SG_INVALID_ID) {
        _sdtx_init_context(ctx_id, desc);
    } else {
        _sdtx_log(SDTX_LOGITEM_CONTEXT_POOL_EXHAUSTED, 1, 3712);
    }
    return ctx_id;
}

void sdtx_destroy_context(sdtx_context ctx_id) {
    assert(0xACBAABCA == _sdtx.init_cookie);
    if _sdtx_is_default_context(ctx_id) != 0 {
        _sdtx_log(SDTX_LOGITEM_CANNOT_DESTROY_DEFAULT_CONTEXT, 1, 3712);
        return;
    }
    _sdtx_destroy_context(ctx_id);
    _sdtx.cur_ctx = _sdtx_lookup_context(_sdtx.cur_ctx_id.id);
}

void sdtx_set_context(sdtx_context ctx_id) {
    assert(0xACBAABCA == _sdtx.init_cookie);
    if _sdtx_is_default_context(ctx_id) != 0 {
        _sdtx.cur_ctx_id = _sdtx.def_ctx_id;
    } else {
        _sdtx.cur_ctx_id = ctx_id;
    }
    _sdtx.cur_ctx = _sdtx_lookup_context(_sdtx.cur_ctx_id.id);
}

sdtx_context sdtx_get_context() {
    assert(0xACBAABCA == _sdtx.init_cookie);
    return _sdtx.cur_ctx_id;
}

sdtx_context sdtx_default_context() {
    return SDTX_DEFAULT_CONTEXT;
}

void sdtx_layer(i32 layer_id) {
    assert(0xACBAABCA == _sdtx.init_cookie);
    _sdtx_context_t* ctx = _sdtx.cur_ctx;
    if ctx != null {
        _sdtx_set_layer(ctx, layer_id);
    }
}

void sdtx_font(i32 font_index) {
    assert(0xACBAABCA == _sdtx.init_cookie);
    assert(font_index >= 0 && font_index < 8);
    _sdtx_context_t* ctx = _sdtx.cur_ctx;
    if ctx != null {
        ctx.cur_font = font_index;
    }
}

void sdtx_canvas(f32 w, f32 h) {
    assert(0xACBAABCA == _sdtx.init_cookie);
    assert(cast(i64, !isnan(w)));
    assert(cast(i64, !isnan(h)));
    assert(w > 0.0f && h > 0.0f);
    _sdtx_context_t* ctx = _sdtx.cur_ctx;
    if ctx != null {
        ctx.canvas_size.x = w;
        ctx.canvas_size.y = h;
        ctx.glyph_size.x = 8.0f / ctx.canvas_size.x;
        ctx.glyph_size.y = 8.0f / ctx.canvas_size.y;
        ctx.origin.x = 0.0f;
        ctx.origin.y = 0.0f;
        ctx.pos.x = 0.0f;
        ctx.pos.y = 0.0f;
    }
}

void sdtx_origin(f32 x, f32 y) {
    assert(0xACBAABCA == _sdtx.init_cookie);
    _sdtx_context_t* ctx = _sdtx.cur_ctx;
    if ctx != null {
        ctx.origin.x = x;
        ctx.origin.y = y;
    }
}

