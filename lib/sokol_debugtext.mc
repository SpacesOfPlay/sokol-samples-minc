// >>logging
u8*[6] _sdtx_log_messages = {
    "OK: Ok", "MALLOC_FAILED: memory allocation failed",
    "ADD_COMMIT_LISTENER_FAILED: sg_add_commit_listener() failed",
    "COMMAND_BUFFER_FULL: command buffer full (adjust via sdtx_context_desc_t.max_commands)",
    "CONTEXT_POOL_EXHAUSTED: context pool exhausted (adjust via sdtx_desc_t.context_pool_size)",
    "CANNOT_DESTROY_DEFAULT_CONTEXT: cannot destroy default context",
};

void _sdtx_log(sdtx_log_item_t log_item, u32 log_level, u32 line_nr) {
    if _sdtx.desc.logger.func != null {
        u8* filename = "sokol_debugtext.h";
        u8* message = _sdtx_log_messages[log_item];
        _sdtx.desc.logger.func("sdtx", log_level, cast(u32, log_item), message, line_nr, filename, _sdtx.desc.logger.user_data);
    } else {
        if log_level == 0 {
            abort();
        }
    }
}

