}
private { _sspine_t _sspine; }

// dummy spine-c platform implementation functions
void _spAtlasPage_createTexture(spAtlasPage* self, u8* path) {
    ignore self;
    ignore path;
}

void _spAtlasPage_disposeTexture(spAtlasPage* self) {
    _sspine_delete_image_view_sampler(cast(_sspine_image_view_sampler_t*, self.rendererObject));
}

u8* _spUtil_readFile(u8* path, i32* length) {
    ignore path;
    *length = 0;
    return null;
}
