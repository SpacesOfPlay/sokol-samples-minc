// sokol_spine
import sokol_all;
import spine_c;

enum __enum_SSPINE_INVALID_ID {
    SSPINE_INVALID_ID = 0,
    SSPINE_MAX_SKINSET_SKINS = 32,
    SSPINE_MAX_STRING_SIZE = 61,
}

enum sspine_resource_state {
    SSPINE_RESOURCESTATE_INITIAL = 0,
    SSPINE_RESOURCESTATE_ALLOC = 1,
    SSPINE_RESOURCESTATE_VALID = 2,
    SSPINE_RESOURCESTATE_FAILED = 3,
    SSPINE_RESOURCESTATE_INVALID = 4,
    _SSPINE_RESOURCESTATE_FORCE_U32 = 2147483647,
}

// log item codes via x-macro magic
enum sspine_log_item {
    SSPINE_LOGITEM_OK = 0,
    SSPINE_LOGITEM_MALLOC_FAILED = 1,
    SSPINE_LOGITEM_CONTEXT_POOL_EXHAUSTED = 2,
    SSPINE_LOGITEM_ATLAS_POOL_EXHAUSTED = 3,
    SSPINE_LOGITEM_SKELETON_POOL_EXHAUSTED = 4,
    SSPINE_LOGITEM_SKINSET_POOL_EXHAUSTED = 5,
    SSPINE_LOGITEM_INSTANCE_POOL_EXHAUSTED = 6,
    SSPINE_LOGITEM_CANNOT_DESTROY_DEFAULT_CONTEXT = 7,
    SSPINE_LOGITEM_ATLAS_DESC_NO_DATA = 8,
    SSPINE_LOGITEM_SPINE_ATLAS_CREATION_FAILED = 9,
    SSPINE_LOGITEM_SG_ALLOC_IMAGE_FAILED = 10,
    SSPINE_LOGITEM_SG_ALLOC_VIEW_FAILED = 11,
    SSPINE_LOGITEM_SG_ALLOC_SAMPLER_FAILED = 12,
    SSPINE_LOGITEM_SKELETON_DESC_NO_DATA = 13,
    SSPINE_LOGITEM_SKELETON_DESC_NO_ATLAS = 14,
    SSPINE_LOGITEM_SKELETON_ATLAS_NOT_VALID = 15,
    SSPINE_LOGITEM_CREATE_SKELETON_DATA_FROM_JSON_FAILED = 16,
    SSPINE_LOGITEM_CREATE_SKELETON_DATA_FROM_BINARY_FAILED = 17,
    SSPINE_LOGITEM_SKINSET_DESC_NO_SKELETON = 18,
    SSPINE_LOGITEM_SKINSET_SKELETON_NOT_VALID = 19,
    SSPINE_LOGITEM_SKINSET_INVALID_SKIN_HANDLE = 20,
    SSPINE_LOGITEM_INSTANCE_DESC_NO_SKELETON = 21,
    SSPINE_LOGITEM_INSTANCE_SKELETON_NOT_VALID = 22,
    SSPINE_LOGITEM_INSTANCE_ATLAS_NOT_VALID = 23,
    SSPINE_LOGITEM_SPINE_SKELETON_CREATION_FAILED = 24,
    SSPINE_LOGITEM_SPINE_ANIMATIONSTATE_CREATION_FAILED = 25,
    SSPINE_LOGITEM_SPINE_SKELETONCLIPPING_CREATION_FAILED = 26,
    SSPINE_LOGITEM_COMMAND_BUFFER_FULL = 27,
    SSPINE_LOGITEM_VERTEX_BUFFER_FULL = 28,
    SSPINE_LOGITEM_INDEX_BUFFER_FULL = 29,
    SSPINE_LOGITEM_STRING_TRUNCATED = 30,
    SSPINE_LOGITEM_ADD_COMMIT_LISTENER_FAILED = 31,
}

type sspine_color = sg_color;
struct sspine_context {
    u32 id;
}

struct sspine_atlas {
    u32 id;
}

struct sspine_skeleton {
    u32 id;
}

struct sspine_instance {
    u32 id;
}

struct sspine_skinset {
    u32 id;
}

struct sspine_image {
    u32 atlas_id;
    i32 index;
}

struct sspine_atlas_page {
    u32 atlas_id;
    i32 index;
}

struct sspine_anim {
    u32 skeleton_id;
    i32 index;
}

struct sspine_bone {
    u32 skeleton_id;
    i32 index;
}

struct sspine_slot {
    u32 skeleton_id;
    i32 index;
}

struct sspine_event {
    u32 skeleton_id;
    i32 index;
}

struct sspine_iktarget {
    u32 skeleton_id;
    i32 index;
}

struct sspine_skin {
    u32 skeleton_id;
    i32 index;
}

struct sspine_range {
    void* ptr;
    u64 size;
}

struct sspine_vec2 {
    f32 x;
    f32 y;
}

struct sspine_mat4 {
    f32[16] m;
}

struct sspine_string {
    bool valid;
    bool truncated;
    u8 len;
    u8[61] cstr;
}

struct sspine_layer_transform {
    sspine_vec2 size;
    sspine_vec2 origin;
}

struct sspine_bone_transform {
    sspine_vec2 position;
    f32 rotation;
    sspine_vec2 scale;
    sspine_vec2 shear;
}

struct sspine_context_desc {
    i32 max_vertices;
    i32 max_commands;
    sg_pixel_format color_format;
    sg_pixel_format depth_format;
    i32 sample_count;
    sg_color_mask color_write_mask;
}

struct sspine_context_info {
    i32 num_vertices;
    i32 num_indices;
    i32 num_commands;
}

struct sspine_image_info {
    bool valid;
    sg_image sgimage;
    sg_view sgview;
    sg_sampler sgsampler;
    sg_filter min_filter;
    sg_filter mag_filter;
    sg_filter mipmap_filter;
    sg_wrap wrap_u;
    sg_wrap wrap_v;
    i32 width;
    i32 height;
    bool premul_alpha;
    sspine_string filename;
}

struct sspine_atlas_overrides {
    sg_filter min_filter;
    sg_filter mag_filter;
    sg_filter mipmap_filter;
    sg_wrap wrap_u;
    sg_wrap wrap_v;
    bool premul_alpha_enabled;
    bool premul_alpha_disabled;
}

struct sspine_atlas_desc {
    sspine_range data;
    sspine_atlas_overrides override;
}

struct sspine_atlas_page_info {
    bool valid;
    sspine_atlas atlas;
    sspine_image_info image;
    sspine_atlas_overrides overrides;
}

struct sspine_skeleton_desc {
    sspine_atlas atlas;
    f32 prescale;
    f32 anim_default_mix;
    u8* json_data;
    sspine_range binary_data;
}

struct sspine_skinset_desc {
    sspine_skeleton skeleton;
    sspine_skin[32] skins;
}

struct sspine_anim_info {
    bool valid;
    i32 index;
    f32 duration;
    sspine_string name;
}

struct sspine_bone_info {
    bool valid;
    i32 index;
    sspine_bone parent_bone;
    f32 length;
    sspine_bone_transform pose;
    sspine_color color;
    sspine_string name;
}

struct sspine_slot_info {
    bool valid;
    i32 index;
    sspine_bone bone;
    sspine_color color;
    sspine_string attachment_name;
    sspine_string name;
}

struct sspine_iktarget_info {
    bool valid;
    i32 index;
    sspine_bone target_bone;
    sspine_string name;
}

struct sspine_skin_info {
    bool valid;
    i32 index;
    sspine_string name;
}

struct sspine_event_info {
    bool valid;
    i32 index;
    i32 int_value;
    f32 float_value;
    f32 volume;
    f32 balance;
    sspine_string name;
    sspine_string string_value;
    sspine_string audio_path;
}

struct sspine_triggered_event_info {
    bool valid;
    sspine_event event;
    f32 time;
    i32 int_value;
    f32 float_value;
    f32 volume;
    f32 balance;
    sspine_string string_value;
}

struct sspine_instance_desc {
    sspine_skeleton skeleton;
}

struct sspine_allocator {
    fn(u64, void*): void* alloc_fn;
    fn(void*, void*): void free_fn;
    void* user_data;
}

struct sspine_logger {
    fn(u8*, u32, u32, u8*, u32, u8*, void*): void func;
    void* user_data;
}

struct sspine_desc {
    i32 max_vertices;
    i32 max_commands;
    i32 context_pool_size;
    i32 atlas_pool_size;
    i32 skeleton_pool_size;
    i32 skinset_pool_size;
    i32 instance_pool_size;
    sg_pixel_format color_format;
    sg_pixel_format depth_format;
    i32 sample_count;
    sg_color_mask color_write_mask;
    sspine_allocator allocator;
    sspine_logger logger;
}

//<#shdgen
// ███████ ████████ ██████  ██    ██  ██████ ████████ ███████
// ██         ██    ██   ██ ██    ██ ██         ██    ██
// ███████    ██    ██████  ██    ██ ██         ██    ███████
