// ███████ ██   ██ ██ ███    ██ ███████ ███████ ████████
// ██      ██  ██  ██ ████   ██ ██      ██         ██
// ███████ █████   ██ ██ ██  ██ ███████ █████      ██
//      ██ ██  ██  ██ ██  ██ ██      ██ ██         ██
// ███████ ██   ██ ██ ██   ████ ███████ ███████    ██
//
// >>skinset
void _sspine_setup_skinset_pool(i32 pool_size) {
    _sspine_skinset_pool_t* p = &_sspine.skinset_pool;
    _sspine_init_item_pool(&p.pool, pool_size, cast(void**, &p.items), cast(u64, sizeof(_sspine_skinset_t)));
}

void _sspine_discard_skinset_pool() {
    _sspine_skinset_pool_t* p = &_sspine.skinset_pool;
    _sspine_discard_item_pool(&p.pool, cast(void**, &p.items));
}

sspine_skinset _sspine_make_skinset_handle(u32 id) {
    var handle = sspine_skinset{id};
    return handle;
}

_sspine_skinset_t* _sspine_skinset_at(u32 id) {
    _sspine_skinset_pool_t* p = &_sspine.skinset_pool;
    i32 slot_index = _sspine_slot_index(id);
    return &p.items[slot_index];
}

_sspine_skinset_t* _sspine_lookup_skinset(u32 id) {
    if cast(u32, SSPINE_INVALID_ID) != id {
        _sspine_skinset_t* skinset = _sspine_skinset_at(id);
        if skinset.slot.id == id {
            return skinset;
        }
    }
    return null;
}

sspine_skinset _sspine_alloc_skinset() {
    _sspine_skinset_pool_t* p = &_sspine.skinset_pool;
    i32 slot_index = _sspine_pool_alloc_index(&p.pool);
    if 0 != slot_index {
        u32 id = _sspine_slot_init(&p.pool, &p.items[slot_index].slot, slot_index);
        return _sspine_make_skinset_handle(id);
    } else {
        return _sspine_make_skinset_handle(cast(u32, SSPINE_INVALID_ID));
    }
}

sspine_resource_state _sspine_init_skinset(_sspine_skinset_t* skinset, sspine_skinset_desc* desc) {
    if desc.skeleton.id == cast(u32, SSPINE_INVALID_ID) {
        _sspine_log(SSPINE_LOGITEM_SKINSET_DESC_NO_SKELETON, 1, 3125);
        return SSPINE_RESOURCESTATE_FAILED;
    }
    skinset.skel.id = desc.skeleton.id;
    skinset.skel.ptr = _sspine_lookup_skeleton(desc.skeleton.id);
    if _sspine_skeleton_ref_valid(&skinset.skel) == 0 {
        _sspine_log(SSPINE_LOGITEM_SKINSET_SKELETON_NOT_VALID, 1, 3125);
        return SSPINE_RESOURCESTATE_FAILED;
    }
    _sspine_skeleton_t* skel = skinset.skel.ptr;
    if SSPINE_RESOURCESTATE_VALID != skel.slot.state {
        _sspine_log(SSPINE_LOGITEM_SKINSET_SKELETON_NOT_VALID, 1, 3125);
        return SSPINE_RESOURCESTATE_FAILED;
    }
    skinset.sp_skin = spSkin_create("skinset");
    for i32 i = 0; i < SSPINE_MAX_SKINSET_SKINS; i++ {
        if desc.skins[i].skeleton_id != cast(u32, SSPINE_INVALID_ID) {
            spSkin* skin = _sspine_lookup_skin(desc.skins[i].skeleton_id, desc.skins[i].index);
            if null == skin {
                _sspine_log(SSPINE_LOGITEM_SKINSET_INVALID_SKIN_HANDLE, 1, 3125);
                return SSPINE_RESOURCESTATE_FAILED;
            }
            spSkin_addSkin(skinset.sp_skin, skin);
        }
    }
    return SSPINE_RESOURCESTATE_VALID;
}

void _sspine_deinit_skinset(_sspine_skinset_t* skinset) {
    if skinset.sp_skin != null {
        spSkin_clear(skinset.sp_skin);
        spSkin_dispose(skinset.sp_skin);
        skinset.sp_skin = null;
    }
}

void _sspine_destroy_skinset(sspine_skinset skinset_id) {
    _sspine_skinset_t* skinset = _sspine_lookup_skinset(skinset_id.id);
    if skinset != null {
        _sspine_deinit_skinset(skinset);
        _sspine_skinset_pool_t* p = &_sspine.skinset_pool;
        _sspine_clear(skinset, cast(u64, sizeof(_sspine_skinset_t)));
        _sspine_pool_free_index(&p.pool, _sspine_slot_index(skinset_id.id));
    }
}

void _sspine_destroy_all_skinsets() {
    _sspine_skinset_pool_t* p = &_sspine.skinset_pool;
    for i32 i = 0; i < p.pool.size; i++ {
        _sspine_skinset_t* skinset = &p.items[i];
        _sspine_destroy_skinset(_sspine_make_skinset_handle(skinset.slot.id));
    }
}

sspine_skinset_desc _sspine_skinset_desc_defaults(sspine_skinset_desc* desc) {
    sspine_skinset_desc res = *desc;
    return res;
}

// ██ ███    ██ ███████ ████████  █████  ███    ██  ██████ ███████
// ██ ████   ██ ██         ██    ██   ██ ████   ██ ██      ██
// ██ ██ ██  ██ ███████    ██    ███████ ██ ██  ██ ██      █████
// ██ ██  ██ ██      ██    ██    ██   ██ ██  ██ ██ ██      ██
// ██ ██   ████ ███████    ██    ██   ██ ██   ████  ██████ ███████
//
// >>instance
void _sspine_setup_instance_pool(i32 pool_size) {
    _sspine_instance_pool_t* p = &_sspine.instance_pool;
    _sspine_init_item_pool(&p.pool, pool_size, cast(void**, &p.items), cast(u64, sizeof(_sspine_instance_t)));
}

void _sspine_discard_instance_pool() {
    _sspine_instance_pool_t* p = &_sspine.instance_pool;
    _sspine_discard_item_pool(&p.pool, cast(void**, &p.items));
}

sspine_instance _sspine_make_instance_handle(u32 id) {
    var handle = sspine_instance{id};
    return handle;
}

_sspine_instance_t* _sspine_instance_at(u32 id) {
    _sspine_instance_pool_t* p = &_sspine.instance_pool;
    i32 slot_index = _sspine_slot_index(id);
    return &p.items[slot_index];
}

_sspine_instance_t* _sspine_lookup_instance(u32 id) {
    if cast(u32, SSPINE_INVALID_ID) != id {
        _sspine_instance_t* instance = _sspine_instance_at(id);
        if instance.slot.id == id {
            return instance;
        }
    }
    return null;
}

sspine_instance _sspine_alloc_instance() {
    _sspine_instance_pool_t* p = &_sspine.instance_pool;
    noinit sspine_instance res;
    i32 slot_index = _sspine_pool_alloc_index(&p.pool);
    if 0 != slot_index {
        u32 id = _sspine_slot_init(&p.pool, &p.items[slot_index].slot, slot_index);
        res = _sspine_make_instance_handle(id);
    } else {
        res = _sspine_make_instance_handle(cast(u32, SSPINE_INVALID_ID));
    }
    return res;
}

void _sspine_rewind_triggered_events(_sspine_instance_t* instance) {
    instance.cur_triggered_event_index = 0;
    _sspine_clear(instance.triggered_events, cast(u64, sizeof(instance.triggered_events)));
}

sspine_triggered_event_info* _sspine_next_triggered_event_info(_sspine_instance_t* instance) {
    if instance.cur_triggered_event_index < 16 {
        return &instance.triggered_events[instance.cur_triggered_event_index++];
    } else {
        return null;
    }
}

void _sspine_event_listener(spAnimationState* sp_anim_state, spEventType sp_event_type, spTrackEntry* sp_track_entry, spEvent* sp_event) {
    if sp_event_type == SP_ANIMATION_EVENT {
        ignore sp_track_entry;
        _sspine_instance_t* instance = _sspine_lookup_instance(cast(u32, cast(u64, sp_anim_state.userData)));
        if _sspine_instance_and_deps_valid(instance) != 0 {
            sspine_triggered_event_info* info = _sspine_next_triggered_event_info(instance);
            if info != null {
                _sspine_skeleton_t* skeleton = _sspine_lookup_skeleton(instance.skel.id);
                spEventData* sp_event_data = sp_event.data;
                for i32 i = 0; i < skeleton.sp_skel_data.eventsCount; i++ {
                    if sp_event_data == skeleton.sp_skel_data.events[i] {
                        info.event = _sspine_event(skeleton.slot.id, i);
                        break;
                    }
                }
                info.valid = true;
                info.time = sp_event.time;
                info.int_value = sp_event.intValue;
                info.float_value = sp_event.floatValue;
                info.volume = sp_event.volume;
                info.balance = sp_event.balance;
                info.string_value = _sspine_string(sp_event.stringValue);
                if info.string_value.truncated != 0 {
                    _sspine_log(SSPINE_LOGITEM_STRING_TRUNCATED, 2, 3126);
                }
            }
        }
    }
}

sspine_resource_state _sspine_init_instance(_sspine_instance_t* instance, sspine_instance_desc* desc) {
    if desc.skeleton.id == cast(u32, SSPINE_INVALID_ID) {
        _sspine_log(SSPINE_LOGITEM_INSTANCE_DESC_NO_SKELETON, 1, 3125);
        return SSPINE_RESOURCESTATE_FAILED;
    }
    instance.skel.id = desc.skeleton.id;
    instance.skel.ptr = _sspine_lookup_skeleton(instance.skel.id);
    if _sspine_skeleton_ref_valid(&instance.skel) == 0 {
        _sspine_log(SSPINE_LOGITEM_INSTANCE_SKELETON_NOT_VALID, 1, 3125);
        return SSPINE_RESOURCESTATE_FAILED;
    }
    _sspine_skeleton_t* skel = instance.skel.ptr;
    if SSPINE_RESOURCESTATE_VALID != skel.slot.state {
        _sspine_log(SSPINE_LOGITEM_INSTANCE_SKELETON_NOT_VALID, 1, 3125);
        return SSPINE_RESOURCESTATE_FAILED;
    }
    instance.atlas = skel.atlas;
    if _sspine_atlas_ref_valid(&instance.atlas) == 0 {
        _sspine_log(SSPINE_LOGITEM_INSTANCE_ATLAS_NOT_VALID, 1, 3125);
        return SSPINE_RESOURCESTATE_FAILED;
    }
    if SSPINE_RESOURCESTATE_VALID != instance.atlas.ptr.slot.state {
        _sspine_log(SSPINE_LOGITEM_INSTANCE_ATLAS_NOT_VALID, 1, 3125);
        return SSPINE_RESOURCESTATE_FAILED;
    }
    instance.sp_skel = spSkeleton_create(skel.sp_skel_data);
    if null == instance.sp_skel {
        _sspine_log(SSPINE_LOGITEM_SPINE_SKELETON_CREATION_FAILED, 1, 3125);
        return SSPINE_RESOURCESTATE_FAILED;
    }
    instance.sp_anim_state = spAnimationState_create(skel.sp_anim_data);
    if null == instance.sp_anim_state {
        _sspine_log(SSPINE_LOGITEM_SPINE_ANIMATIONSTATE_CREATION_FAILED, 1, 3125);
        return SSPINE_RESOURCESTATE_FAILED;
    }
    instance.sp_clip = spSkeletonClipping_create();
    if null == instance.sp_clip {
        _sspine_log(SSPINE_LOGITEM_SPINE_SKELETONCLIPPING_CREATION_FAILED, 1, 3125);
        return SSPINE_RESOURCESTATE_FAILED;
    }
    instance.sp_anim_state.userData = cast(void*, cast(u64, instance.slot.id));
    instance.sp_anim_state.listener = _sspine_event_listener;
    spSkeleton_setToSetupPose(instance.sp_skel);
    spAnimationState_update(instance.sp_anim_state, 0.0f);
    spAnimationState_apply(instance.sp_anim_state, instance.sp_skel);
    spSkeleton_update(instance.sp_skel, 0.0f);
    spSkeleton_updateWorldTransform(instance.sp_skel, SP_PHYSICS_UPDATE);
    return SSPINE_RESOURCESTATE_VALID;
}

void _sspine_deinit_instance(_sspine_instance_t* instance) {
    if instance.sp_clip != null {
        spSkeletonClipping_dispose(instance.sp_clip);
        instance.sp_clip = null;
    }
    if instance.sp_anim_state != null {
        spAnimationState_dispose(instance.sp_anim_state);
        instance.sp_anim_state = null;
    }
    if instance.sp_skel != null {
        spSkeleton_dispose(instance.sp_skel);
        instance.sp_skel = null;
    }
}

void _sspine_destroy_instance(sspine_instance instance_id) {
    _sspine_instance_t* instance = _sspine_lookup_instance(instance_id.id);
    if instance != null {
        _sspine_deinit_instance(instance);
        _sspine_instance_pool_t* p = &_sspine.instance_pool;
        _sspine_clear(instance, cast(u64, sizeof(_sspine_instance_t)));
        _sspine_pool_free_index(&p.pool, _sspine_slot_index(instance_id.id));
    }
}

void _sspine_destroy_all_instances() {
    _sspine_instance_pool_t* p = &_sspine.instance_pool;
    for i32 i = 0; i < p.pool.size; i++ {
        _sspine_instance_t* instance = &p.items[i];
        _sspine_destroy_instance(_sspine_make_instance_handle(instance.slot.id));
    }
}

