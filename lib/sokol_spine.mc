void _sspine_setup_skeleton_pool(i32 pool_size) {
    _sspine_skeleton_pool_t* p = &_sspine.skeleton_pool;
    _sspine_init_item_pool(&p.pool, pool_size, cast(void**, &p.items), cast(u64, sizeof(_sspine_skeleton_t)));
}

void _sspine_discard_skeleton_pool() {
    _sspine_skeleton_pool_t* p = &_sspine.skeleton_pool;
    _sspine_discard_item_pool(&p.pool, cast(void**, &p.items));
}

sspine_skeleton _sspine_make_skeleton_handle(u32 id) {
    var handle = sspine_skeleton{id};
    return handle;
}

_sspine_skeleton_t* _sspine_skeleton_at(u32 id) {
    _sspine_skeleton_pool_t* p = &_sspine.skeleton_pool;
    i32 slot_index = _sspine_slot_index(id);
    return &p.items[slot_index];
}

_sspine_skeleton_t* _sspine_lookup_skeleton(u32 id) {
    if cast(u32, SSPINE_INVALID_ID) != id {
        _sspine_skeleton_t* skeleton = _sspine_skeleton_at(id);
        if skeleton.slot.id == id {
            return skeleton;
        }
    }
    return null;
}

sspine_skeleton _sspine_alloc_skeleton() {
    _sspine_skeleton_pool_t* p = &_sspine.skeleton_pool;
    i32 slot_index = _sspine_pool_alloc_index(&p.pool);
    if 0 != slot_index {
        u32 id = _sspine_slot_init(&p.pool, &p.items[slot_index].slot, slot_index);
        return _sspine_make_skeleton_handle(id);
    } else {
        return _sspine_make_skeleton_handle(cast(u32, SSPINE_INVALID_ID));
    }
}

sspine_resource_state _sspine_init_skeleton(_sspine_skeleton_t* skeleton, sspine_skeleton_desc* desc) {
    if null == desc.json_data && (null == desc.binary_data.ptr || 0 == desc.binary_data.size) {
        _sspine_log(SSPINE_LOGITEM_SKELETON_DESC_NO_DATA, 1, 3125);
        return SSPINE_RESOURCESTATE_FAILED;
    }
    if desc.atlas.id == cast(u32, SSPINE_INVALID_ID) {
        _sspine_log(SSPINE_LOGITEM_SKELETON_DESC_NO_ATLAS, 1, 3125);
        return SSPINE_RESOURCESTATE_FAILED;
    }
    skeleton.atlas.id = desc.atlas.id;
    skeleton.atlas.ptr = _sspine_lookup_atlas(skeleton.atlas.id);
    if _sspine_atlas_ref_valid(&skeleton.atlas) == 0 {
        _sspine_log(SSPINE_LOGITEM_SKELETON_ATLAS_NOT_VALID, 1, 3125);
        return SSPINE_RESOURCESTATE_FAILED;
    }
    _sspine_atlas_t* atlas = skeleton.atlas.ptr;
    if SSPINE_RESOURCESTATE_VALID != atlas.slot.state {
        _sspine_log(SSPINE_LOGITEM_SKELETON_ATLAS_NOT_VALID, 1, 3125);
        return SSPINE_RESOURCESTATE_FAILED;
    }
    if desc.json_data != null {
        spSkeletonJson* skel_json = spSkeletonJson_create(atlas.sp_atlas);
        skel_json.scale = desc.prescale;
        skeleton.sp_skel_data = spSkeletonJson_readSkeletonData(skel_json, desc.json_data);
        spSkeletonJson_dispose(skel_json);
        skel_json = null;
        if null == skeleton.sp_skel_data {
            _sspine_log(SSPINE_LOGITEM_CREATE_SKELETON_DATA_FROM_JSON_FAILED, 1, 3125);
            return SSPINE_RESOURCESTATE_FAILED;
        }
    } else {
        spSkeletonBinary* skel_bin = spSkeletonBinary_create(atlas.sp_atlas);
        skel_bin.scale = desc.prescale;
        skeleton.sp_skel_data = spSkeletonBinary_readSkeletonData(skel_bin, cast(u8*, desc.binary_data.ptr), cast(i32, desc.binary_data.size));
        spSkeletonBinary_dispose(skel_bin);
        skel_bin = null;
        if null == skeleton.sp_skel_data {
            _sspine_log(SSPINE_LOGITEM_CREATE_SKELETON_DATA_FROM_BINARY_FAILED, 1, 3125);
            return SSPINE_RESOURCESTATE_FAILED;
        }
    }
    skeleton.sp_anim_data = spAnimationStateData_create(skeleton.sp_skel_data);
    skeleton.sp_anim_data.defaultMix = desc.anim_default_mix;
    i32 max_vertex_count = 4;
    spSkeletonData* sp_skel_data = skeleton.sp_skel_data;
    for i32 skinIndex = 0; skinIndex < sp_skel_data.skinsCount; skinIndex++ {
        spSkin* sp_skin = sp_skel_data.skins[skinIndex];
        spSkinEntry* skin_entry = spSkin_getAttachments(sp_skin);
        if skin_entry != null {
            while true {
                if skin_entry.attachment != null {
                    if skin_entry.attachment.type == SP_ATTACHMENT_MESH {
                        var mesh_attachment = cast(spMeshAttachment*, skin_entry.attachment);
                        i32 num_vertices = mesh_attachment.super.worldVerticesLength / 2;
                        if num_vertices > max_vertex_count {
                            max_vertex_count = num_vertices;
                        }
                    }
                }
                skin_entry = skin_entry.next;
                if !(skin_entry != null) { break; }
            }
        }
    }
    skeleton.tform_buf.cap = max_vertex_count;
    skeleton.tform_buf.ptr = cast(sspine_vec2*, _sspine_malloc(cast(u64, skeleton.tform_buf.cap) * cast(u64, sizeof(sspine_vec2))));
    return SSPINE_RESOURCESTATE_VALID;
}

void _sspine_deinit_skeleton(_sspine_skeleton_t* skeleton) {
    if skeleton.tform_buf.ptr != null {
        _sspine_free(skeleton.tform_buf.ptr);
        skeleton.tform_buf.ptr = null;
    }
    if skeleton.sp_anim_data != null {
        spAnimationStateData_dispose(skeleton.sp_anim_data);
        skeleton.sp_anim_data = null;
    }
    if skeleton.sp_skel_data != null {
        spSkeletonData_dispose(skeleton.sp_skel_data);
        skeleton.sp_skel_data = null;
    }
}

void _sspine_destroy_skeleton(sspine_skeleton skeleton_id) {
    _sspine_skeleton_t* skeleton = _sspine_lookup_skeleton(skeleton_id.id);
    if skeleton != null {
        _sspine_deinit_skeleton(skeleton);
        _sspine_skeleton_pool_t* p = &_sspine.skeleton_pool;
        _sspine_clear(skeleton, cast(u64, sizeof(_sspine_skeleton_t)));
        _sspine_pool_free_index(&p.pool, _sspine_slot_index(skeleton_id.id));
    }
}

void _sspine_destroy_all_skeletons() {
    _sspine_skeleton_pool_t* p = &_sspine.skeleton_pool;
    for i32 i = 0; i < p.pool.size; i++ {
        _sspine_skeleton_t* skeleton = &p.items[i];
        _sspine_destroy_skeleton(_sspine_make_skeleton_handle(skeleton.slot.id));
    }
}

sspine_skeleton_desc _sspine_skeleton_desc_defaults(sspine_skeleton_desc* desc) {
    sspine_skeleton_desc res = *desc;
    res.prescale = desc.prescale == 0.0f ? 1.0f : desc.prescale;
    res.anim_default_mix = desc.anim_default_mix == 0.0f ? 0.2f : desc.anim_default_mix;
    return res;
}

spBoneData* _sspine_lookup_bone_data(u32 skeleton_id, i32 bone_index) {
