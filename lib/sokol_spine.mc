_sspine_atlas_t* _sspine_lookup_atlas(u32 id) {
    if cast(u32, SSPINE_INVALID_ID) != id {
        _sspine_atlas_t* atlas = _sspine_atlas_at(id);
        if atlas.slot.id == id {
            return atlas;
        }
    }
    return null;
}

sspine_atlas _sspine_alloc_atlas() {
    _sspine_atlas_pool_t* p = &_sspine.atlas_pool;
    i32 slot_index = _sspine_pool_alloc_index(&p.pool);
    if 0 != slot_index {
        u32 id = _sspine_slot_init(&p.pool, &p.items[slot_index].slot, slot_index);
        return _sspine_make_atlas_handle(id);
    } else {
        return _sspine_make_atlas_handle(cast(u32, SSPINE_INVALID_ID));
    }
}

_sspine_image_view_sampler_t* _sspine_new_image_view_sampler(sg_image img, sg_view view, sg_sampler smp) {
    var ivs = cast(_sspine_image_view_sampler_t*, _sspine_malloc_clear(cast(u64, sizeof(_sspine_image_view_sampler_t))));
    ivs.img = img;
    ivs.view = view;
    ivs.smp = smp;
    return ivs;
}

void _sspine_delete_image_view_sampler(_sspine_image_view_sampler_t* ivs) {
    if ivs != null {
        sg_destroy_sampler(ivs.smp);
        sg_destroy_view(ivs.view);
        sg_destroy_image(ivs.img);
        _sspine_free(cast(void*, ivs));
    }
}

sg_image _sspine_image_from_renderer_object(void* renderer_object) {
    var ivs = cast(_sspine_image_view_sampler_t*, renderer_object);
    return ivs.img;
}

sg_view _sspine_view_from_renderer_object(void* renderer_object) {
    var ivs = cast(_sspine_image_view_sampler_t*, renderer_object);
    return ivs.view;
}

sg_sampler _sspine_sampler_from_renderer_object(void* renderer_object) {
    var ivs = cast(_sspine_image_view_sampler_t*, renderer_object);
    return ivs.smp;
}

sspine_resource_state _sspine_init_atlas(_sspine_atlas_t* atlas, sspine_atlas_desc* desc) {
    if null == desc.data.ptr || 0 == desc.data.size {
        _sspine_log(SSPINE_LOGITEM_ATLAS_DESC_NO_DATA, 1, 3125);
        return SSPINE_RESOURCESTATE_FAILED;
    }
    atlas.overrides = desc.override;
    atlas.sp_atlas = spAtlas_create(cast(u8*, desc.data.ptr), cast(i32, desc.data.size), "", null);
    if null == atlas.sp_atlas {
        _sspine_log(SSPINE_LOGITEM_SPINE_ATLAS_CREATION_FAILED, 1, 3125);
        return SSPINE_RESOURCESTATE_FAILED;
    }
    for spAtlasPage* page = atlas.sp_atlas.pages; page != null; page = page.next {
        atlas.num_pages++;
        sg_image img = sg_alloc_image();
        if sg_query_image_state(img) != SG_RESOURCESTATE_ALLOC {
            _sspine_log(SSPINE_LOGITEM_SG_ALLOC_IMAGE_FAILED, 1, 3125);
            return SSPINE_RESOURCESTATE_FAILED;
        }
        sg_view view = sg_alloc_view();
        if sg_query_view_state(view) != SG_RESOURCESTATE_ALLOC {
            _sspine_log(SSPINE_LOGITEM_SG_ALLOC_VIEW_FAILED, 1, 3125);
            return SSPINE_RESOURCESTATE_FAILED;
        }
        sg_sampler smp = sg_alloc_sampler();
        if sg_query_sampler_state(smp) != SG_RESOURCESTATE_ALLOC {
            _sspine_log(SSPINE_LOGITEM_SG_ALLOC_SAMPLER_FAILED, 1, 3125);
            return SSPINE_RESOURCESTATE_FAILED;
        }
        page.rendererObject = cast(void*, _sspine_new_image_view_sampler(img, view, smp));
        if desc.override.premul_alpha_enabled != 0 {
            page.pma = -1;
        } else if desc.override.premul_alpha_disabled != 0 {
            page.pma = 0;
        }
    }
    return SSPINE_RESOURCESTATE_VALID;
}

void _sspine_deinit_atlas(_sspine_atlas_t* atlas) {
    if atlas.sp_atlas != null {
        spAtlas_dispose(atlas.sp_atlas);
        atlas.sp_atlas = null;
    }
}

void _sspine_destroy_atlas(sspine_atlas atlas_id) {
    _sspine_atlas_t* atlas = _sspine_lookup_atlas(atlas_id.id);
    if atlas != null {
        _sspine_deinit_atlas(atlas);
        _sspine_atlas_pool_t* p = &_sspine.atlas_pool;
        _sspine_clear(atlas, cast(u64, sizeof(_sspine_atlas_t)));
        _sspine_pool_free_index(&p.pool, _sspine_slot_index(atlas_id.id));
    }
}

void _sspine_destroy_all_atlases() {
    _sspine_atlas_pool_t* p = &_sspine.atlas_pool;
    for i32 i = 0; i < p.pool.size; i++ {
        _sspine_atlas_t* atlas = &p.items[i];
        _sspine_destroy_atlas(_sspine_make_atlas_handle(atlas.slot.id));
    }
}

sspine_atlas_desc _sspine_atlas_desc_defaults(sspine_atlas_desc* desc) {
    sspine_atlas_desc res = *desc;
    return res;
}

spAtlasPage* _sspine_lookup_atlas_page(u32 atlas_id, i32 page_index) {
    _sspine_atlas_t* atlas = _sspine_lookup_atlas(atlas_id);
    if atlas != null {
        if page_index >= 0 && page_index < atlas.num_pages {
            i32 i = 0;
            for spAtlasPage* page = atlas.sp_atlas.pages; page != null; page = page.next {
                if i == page_index {
                    return page;
                }
                i++;
            }
        }
    }
    return null;
}

// ███████ ██   ██ ███████ ██      ███████ ████████  ██████  ███    ██
// ██      ██  ██  ██      ██      ██         ██    ██    ██ ████   ██
// ███████ █████   █████   ██      █████      ██    ██    ██ ██ ██  ██
//      ██ ██  ██  ██      ██      ██         ██    ██    ██ ██  ██ ██
// ███████ ██   ██ ███████ ███████ ███████    ██     ██████  ██   ████
