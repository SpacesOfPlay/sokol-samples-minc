sspine_skin sspine_skin_by_name(sspine_skeleton skeleton_id, u8* name) {
    _sspine_skeleton_t* skeleton = _sspine_lookup_skeleton(skeleton_id.id);
    if _sspine_skeleton_and_deps_valid(skeleton) != 0 {
        for i32 i = 0; i < skeleton.sp_skel_data.skinsCount; i++ {
            if 0 == strcmp(skeleton.sp_skel_data.skins[i].name, name) {
                return _sspine_skin(skeleton_id.id, i);
            }
        }
    }
    return _sspine_skin(0, 0);
}

sspine_skin sspine_skin_by_index(sspine_skeleton skeleton_id, i32 index) {
