}

bool sspine_skin_valid(sspine_skin skin) {
    _sspine_skeleton_t* skeleton = _sspine_lookup_skeleton(skin.skeleton_id);
    if _sspine_skeleton_and_deps_valid(skeleton) != 0 {
        return skin.index >= 0 && skin.index < skeleton.sp_skel_data.skinsCount;
    }
    return false;
}

bool sspine_skin_equal(sspine_skin first, sspine_skin second) {
    return first.skeleton_id == second.skeleton_id && first.index == second.index;
}

sspine_skin_info sspine_get_skin_info(sspine_skin skin) {
    noinit sspine_skin_info res;
    _sspine_clear(&res, cast(u64, sizeof(res)));
    spSkin* sp_skin = _sspine_lookup_skin(skin.skeleton_id, skin.index);
    if sp_skin != null {
        res.valid = true;
        res.index = skin.index;
        res.name = _sspine_string(sp_skin.name);
        if res.name.truncated != 0 {
            _sspine_log(SSPINE_LOGITEM_STRING_TRUNCATED, 2, 3126);
        }
    }
    return res;
}

void sspine_set_skin(sspine_instance instance_id, sspine_skin skin) {
    _sspine_instance_t* instance = _sspine_lookup_instance(instance_id.id);
    if _sspine_instance_and_deps_valid(instance) && instance.skel.id == skin.skeleton_id {
        instance.skinset.id = cast(u32, SSPINE_INVALID_ID);
        instance.skinset.ptr = null;
        spSkin* sp_skin = _sspine_lookup_skin(skin.skeleton_id, skin.index);
        if sp_skin != null {
            spSkeleton_setSkin(instance.sp_skel, null);
            spSkeleton_setSkin(instance.sp_skel, sp_skin);
            spSkeleton_setSlotsToSetupPose(instance.sp_skel);
            spAnimationState_apply(instance.sp_anim_state, instance.sp_skel);
        }
    }
}
private { u16[6] _sspine_draw_instance__quad_indices = {0, 1, 2, 2, 3, 0}; }

