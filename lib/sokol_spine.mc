}

void sspine_set_bone_rotation(sspine_instance instance_id, sspine_bone bone, f32 rotation) {
    spBone* sp_bone = _sspine_lookup_bone(instance_id.id, bone.skeleton_id, bone.index);
    if sp_bone != null {
        sp_bone.rotation = rotation;
