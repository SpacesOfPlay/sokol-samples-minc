    _sspine_discard_item_pool(&p.pool, cast(void**, &p.items));
}

sspine_atlas _sspine_make_atlas_handle(u32 id) {
    var handle = sspine_atlas{id};
    return handle;
}

_sspine_atlas_t* _sspine_atlas_at(u32 id) {
    _sspine_atlas_pool_t* p = &_sspine.atlas_pool;
    i32 slot_index = _sspine_slot_index(id);
    return &p.items[slot_index];
