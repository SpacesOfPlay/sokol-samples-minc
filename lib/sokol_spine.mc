//
// >>logging
private {
u8*[32] _sspine_log_messages = {
    "OK: Ok", "MALLOC_FAILED: memory allocation failed",
    "CONTEXT_POOL_EXHAUSTED: context pool exhausted (adjust via sspine_desc.context_pool_size)",
    "ATLAS_POOL_EXHAUSTED: atlas pool exhausted (adjust via sspine_desc.atlas_pool_size)",
    "SKELETON_POOL_EXHAUSTED: skeleton pool exhausted (adjust via sspine_desc.skeleton_pool_size)",
    "SKINSET_POOL_EXHAUSTED: skinset pool exhausted (adjust via sspine_desc.skinset_pool_size)",
    "INSTANCE_POOL_EXHAUSTED: instance pool exhausted (adjust via sspine_desc.instance_pool_size)",
    "CANNOT_DESTROY_DEFAULT_CONTEXT: cannot destroy default context",
    "ATLAS_DESC_NO_DATA: no data provided in sspine_atlas_desc.data",
    "SPINE_ATLAS_CREATION_FAILED: spAtlas_create() failed",
    "SG_ALLOC_IMAGE_FAILED: sg_alloc_image() failed",
    "SG_ALLOC_VIEW_FAILED: sg_alloc_view() failed",
    "SG_ALLOC_SAMPLER_FAILED: sg_alloc_sampler() failed",
    "SKELETON_DESC_NO_DATA: no data provided in sspine_skeleton_desc.json_data or .binary_data",
    "SKELETON_DESC_NO_ATLAS: no atlas object provided in sspine_skeleton_desc.atlas",
    "SKELETON_ATLAS_NOT_VALID: sspine_skeleton_desc.atlas is not in valid state",
    "CREATE_SKELETON_DATA_FROM_JSON_FAILED: spSkeletonJson_readSkeletonData() failed",
    "CREATE_SKELETON_DATA_FROM_BINARY_FAILED: spSkeletonBinary_readSkeletonData() failed",
    "SKINSET_DESC_NO_SKELETON: no skeleton object provided in sspine_skinset_desc.skeleton",
    "SKINSET_SKELETON_NOT_VALID: sspine_skinset_desc.skeleton is not in valid state",
    "SKINSET_INVALID_SKIN_HANDLE: invalid skin handle in sspine_skinset_desc.skins[]",
    "INSTANCE_DESC_NO_SKELETON: no skeleton object provided in sspine_instance_desc.skeleton",
    "INSTANCE_SKELETON_NOT_VALID: sspine_instance_desc.skeleton is not in valid state",
    "INSTANCE_ATLAS_NOT_VALID: skeleton's atlas object no longer valid via sspine_instance_desc.skeleton",
    "SPINE_SKELETON_CREATION_FAILED: spSkeleton_create() failed",
    "SPINE_ANIMATIONSTATE_CREATION_FAILED: spAnimationState_create() failed",
    "SPINE_SKELETONCLIPPING_CREATION_FAILED: spSkeletonClipping_create() failed",
    "COMMAND_BUFFER_FULL: command buffer full (adjust via sspine_desc.max_commands)",
    "VERTEX_BUFFER_FULL: vertex buffer (adjust via sspine_desc.max_vertices)",
    "INDEX_BUFFER_FULL: index buffer full (adjust via sspine_desc.max_vertices)",
    "STRING_TRUNCATED: a string has been truncated",
    "ADD_COMMIT_LISTENER_FAILED: sg_add_commit_listener() failed",
};

void _sspine_log(sspine_log_item log_item, u32 log_level, u32 line_nr) {
    if _sspine.desc.logger.func != null {
        u8* filename = "sokol_spine.h";
        u8* message = _sspine_log_messages[log_item];
        _sspine.desc.logger.func("sspine", log_level, cast(u32, log_item), message, line_nr, filename, _sspine.desc.logger.user_data);
    } else {
        if log_level == 0 {
            abort();
        }
    }
}

// ███    ███ ███████ ███    ███  ██████  ██████  ██    ██
// ████  ████ ██      ████  ████ ██    ██ ██   ██  ██  ██
// ██ ████ ██ █████   ██ ████ ██ ██    ██ ██████    ████
// ██  ██  ██ ██      ██  ██  ██ ██    ██ ██   ██    ██
// ██      ██ ███████ ██      ██  ██████  ██   ██    ██
//
// >>memory
void _sspine_clear(void* ptr, u64 size) {
    memset(ptr, 0, size);
}

/* Copy a string into a fixed size buffer with guaranteed zero-
   termination.

   Return false if the string didn't fit into the buffer and had to be clamped.

   FIXME: Currently UTF-8 strings might become invalid if the string
   is clamped, because the last zero-byte might be written into
   the middle of a multi-byte sequence.
*/
bool _sspine_strcpy(u8* src, u8* dst, i32 max_len) {
    u8* end = &dst[max_len - 1];
    u8 c = 0;
    for i32 i = 0; i < max_len; i++ {
        c = *src;
        if c != 0 {
            src++;
        }
        *dst++ = c;
    }
    if c != 0 {
        *end = 0;
        return false;
    } else {
        return true;
    }
}

sspine_string _sspine_string(u8* cstr) {
    noinit sspine_string res;
    _sspine_clear(&res, cast(u64, sizeof(res)));
    if cstr != null {
        res.valid = true;
        res.truncated = !_sspine_strcpy(cstr, res.cstr, cast(i32, sizeof(res.cstr)));
        res.len = cast(u8, strlen(res.cstr));
    }
    return res;
}

void* _sspine_malloc(u64 size) {
    void* ptr;
    if _sspine.desc.allocator.alloc_fn != null {
        ptr = _sspine.desc.allocator.alloc_fn(size, _sspine.desc.allocator.user_data);
    } else {
        ptr = alloc(cast(i64, size));
    }
    if null == ptr {
        _sspine_log(SSPINE_LOGITEM_MALLOC_FAILED, 0, 3124);
    }
    return ptr;
}

void* _sspine_malloc_clear(u64 size) {
    void* ptr = _sspine_malloc(size);
    _sspine_clear(ptr, size);
    return ptr;
}

void _sspine_free(void* ptr) {
    if _sspine.desc.allocator.free_fn != null {
        _sspine.desc.allocator.free_fn(ptr, _sspine.desc.allocator.user_data);
    } else {
        free(ptr);
    }
}

// ██████  ███████ ███████ ███████
// ██   ██ ██      ██      ██
// ██████  █████   █████   ███████
// ██   ██ ██      ██           ██
// ██   ██ ███████ ██      ███████
//
// >>refs
bool _sspine_atlas_ref_valid(_sspine_atlas_ref_t* ref) {
    return ref.ptr && ref.ptr.slot.id == ref.id;
}

bool _sspine_skeleton_ref_valid(_sspine_skeleton_ref_t* ref) {
    return ref.ptr && ref.ptr.slot.id == ref.id;
}

bool _sspine_skinset_ref_valid(_sspine_skinset_ref_t* ref) {
    return ref.ptr && ref.ptr.slot.id == ref.id;
}

bool _sspine_skeleton_and_deps_valid(_sspine_skeleton_t* skeleton) {
    return skeleton && _sspine_atlas_ref_valid(&skeleton.atlas);
}

bool _sspine_skinset_and_deps_valid(_sspine_skinset_t* skinset) {
    return skinset && _sspine_skeleton_ref_valid(&skinset.skel);
}

bool _sspine_instance_and_deps_valid(_sspine_instance_t* instance) {
    return instance && _sspine_atlas_ref_valid(&instance.atlas) && _sspine_skeleton_ref_valid(&instance.skel) && (instance.skinset.id == cast(u32, SSPINE_INVALID_ID) || _sspine_skinset_ref_valid(&instance.skinset));
}

sspine_image _sspine_image(u32 atlas_id, i32 index) {
    var img = sspine_image{atlas_id, index};
    return img;
}

sspine_atlas_page _sspine_atlas_page(u32 atlas_id, i32 index) {
    var page = sspine_atlas_page{atlas_id, index};
    return page;
}

sspine_anim _sspine_anim(u32 skeleton_id, i32 index) {
    var anim = sspine_anim{skeleton_id, index};
    return anim;
}

sspine_bone _sspine_bone(u32 skeleton_id, i32 index) {
    var bone = sspine_bone{skeleton_id, index};
    return bone;
}

sspine_slot _sspine_slot(u32 skeleton_id, i32 index) {
    var slot = sspine_slot{skeleton_id, index};
    return slot;
}

sspine_event _sspine_event(u32 skeleton_id, i32 index) {
    var event = sspine_event{skeleton_id, index};
    return event;
}

sspine_iktarget _sspine_iktarget(u32 skeleton_id, i32 index) {
    var iktarget = sspine_iktarget{skeleton_id, index};
    return iktarget;
}

sspine_skin _sspine_skin(u32 skeleton_id, i32 index) {
    var skin = sspine_skin{skeleton_id, index};
    return skin;
}

// ██████   ██████   ██████  ██
// ██   ██ ██    ██ ██    ██ ██
// ██████  ██    ██ ██    ██ ██
// ██      ██    ██ ██    ██ ██
// ██       ██████   ██████  ███████
//
// >>pool
void _sspine_init_pool(_sspine_pool_t* pool, i32 num) {
    pool.size = num + 1;
    pool.queue_top = 0;
    u64 gen_ctrs_size = cast(u64, sizeof(u32)) * cast(u64, pool.size);
    pool.gen_ctrs = cast(u32*, _sspine_malloc_clear(gen_ctrs_size));
    pool.free_queue = cast(i32*, _sspine_malloc_clear(cast(u64, sizeof(i32)) * cast(u64, num)));
    for i32 i = pool.size - 1; i >= 1; i-- {
        pool.free_queue[pool.queue_top++] = i;
    }
}

void _sspine_discard_pool(_sspine_pool_t* pool) {
    _sspine_free(pool.free_queue);
    pool.free_queue = null;
    _sspine_free(pool.gen_ctrs);
    pool.gen_ctrs = null;
    pool.size = 0;
    pool.queue_top = 0;
}

i32 _sspine_pool_alloc_index(_sspine_pool_t* pool) {
    if pool.queue_top > 0 {
        i32 slot_index = pool.free_queue[--pool.queue_top];
        return slot_index;
    } else {
        return 0;
    }
}

void _sspine_pool_free_index(_sspine_pool_t* pool, i32 slot_index) {
    when defined(SOKOL_DEBUG) {
        for i32 i = 0; i < pool.queue_top; i++ {
        }
    }
    pool.free_queue[pool.queue_top++] = slot_index;
}

/* initialize a pool slot:
    - bump the slot's generation counter
    - create a resource id from the generation counter and slot index
    - set the slot's id to this id
    - set the slot's state to ALLOC
    - return the handle id
*/
u32 _sspine_slot_init(_sspine_pool_t* pool, _sspine_slot_t* slot, i32 slot_index) {
    u32 ctr = ++pool.gen_ctrs[slot_index];
    slot.id = ctr << 16 | cast(u32, slot_index & (1 << 16) - 1);
    slot.state = SSPINE_RESOURCESTATE_ALLOC;
    return slot.id;
}

// extract slot index from id
i32 _sspine_slot_index(u32 id) {
    var slot_index = cast(i32, id & cast(u32, (1 << 16) - 1));
    return slot_index;
}

void _sspine_init_item_pool(_sspine_pool_t* pool, i32 pool_size, void** items_ptr, u64 item_size_bytes) {
    _sspine_init_pool(pool, pool_size);
    u64 pool_size_bytes = item_size_bytes * cast(u64, pool.size);
    *items_ptr = _sspine_malloc_clear(pool_size_bytes);
}

void _sspine_discard_item_pool(_sspine_pool_t* pool, void** items_ptr) {
    _sspine_free(*items_ptr);
    *items_ptr = null;
    _sspine_discard_pool(pool);
}

//  ██████  ██████  ███    ██ ████████ ███████ ██   ██ ████████
// ██      ██    ██ ████   ██    ██    ██       ██ ██     ██
// ██      ██    ██ ██ ██  ██    ██    █████     ███      ██
// ██      ██    ██ ██  ██ ██    ██    ██       ██ ██     ██
//  ██████  ██████  ██   ████    ██    ███████ ██   ██    ██
//
// >>context
void _sspine_setup_context_pool(i32 pool_size) {
    _sspine_context_pool_t* p = &_sspine.context_pool;
    _sspine_init_item_pool(&p.pool, pool_size, cast(void**, &p.items), cast(u64, sizeof(_sspine_context_t)));
}

void _sspine_discard_context_pool() {
    _sspine_context_pool_t* p = &_sspine.context_pool;
    _sspine_discard_item_pool(&p.pool, cast(void**, &p.items));
}

sspine_context _sspine_make_context_handle(u32 id) {
    var handle = sspine_context{id};
    return handle;
}

_sspine_context_t* _sspine_context_at(u32 id) {
    _sspine_context_pool_t* p = &_sspine.context_pool;
    i32 slot_index = _sspine_slot_index(id);
    return &p.items[slot_index];
}

_sspine_context_t* _sspine_lookup_context(u32 id) {
    if cast(u32, SSPINE_INVALID_ID) != id {
        _sspine_context_t* ctx = _sspine_context_at(id);
        if ctx.slot.id == id {
            return ctx;
        }
    }
    return null;
}

sspine_context _sspine_alloc_context() {
    _sspine_context_pool_t* p = &_sspine.context_pool;
    i32 slot_index = _sspine_pool_alloc_index(&p.pool);
    if 0 != slot_index {
        u32 id = _sspine_slot_init(&p.pool, &p.items[slot_index].slot, slot_index);
        return _sspine_make_context_handle(id);
    } else {
        return _sspine_make_context_handle(cast(u32, SSPINE_INVALID_ID));
    }
}

sspine_resource_state _sspine_init_context(_sspine_context_t* ctx, sspine_context_desc* desc) {
    ctx.vertices.cap = desc.max_vertices;
    ctx.indices.cap = ctx.vertices.cap * 3;
    ctx.commands.cap = desc.max_commands;
    u64 vbuf_size = cast(u64, ctx.vertices.cap) * cast(u64, sizeof(_sspine_vertex_t));
    u64 ibuf_size = cast(u64, ctx.indices.cap) * cast(u64, sizeof(u32));
    u64 cbuf_size = cast(u64, ctx.commands.cap) * cast(u64, sizeof(_sspine_command_t));
    ctx.vertices.ptr = cast(_sspine_vertex_t*, _sspine_malloc(vbuf_size));
    ctx.indices.ptr = cast(u32*, _sspine_malloc(ibuf_size));
    ctx.commands.ptr = cast(_sspine_command_t*, _sspine_malloc(cbuf_size));
    noinit sg_buffer_desc vbuf_desc;
    _sspine_clear(&vbuf_desc, cast(u64, sizeof(vbuf_desc)));
    vbuf_desc.usage.vertex_buffer = true;
    vbuf_desc.usage.stream_update = true;
    vbuf_desc.size = vbuf_size;
    vbuf_desc.label = "sspine-vbuf";
    ctx.vbuf = sg_make_buffer(&vbuf_desc);
    ctx.bind.vertex_buffers[0] = ctx.vbuf;
    noinit sg_buffer_desc ibuf_desc;
    _sspine_clear(&ibuf_desc, cast(u64, sizeof(ibuf_desc)));
    ibuf_desc.usage.index_buffer = true;
    ibuf_desc.usage.stream_update = true;
    ibuf_desc.size = ibuf_size;
    ibuf_desc.label = "sspine-ibuf";
    ctx.ibuf = sg_make_buffer(&ibuf_desc);
    ctx.bind.index_buffer = ctx.ibuf;
    noinit sg_pipeline_desc pip_desc;
    _sspine_clear(&pip_desc, cast(u64, sizeof(pip_desc)));
    pip_desc.shader = _sspine.shd;
    pip_desc.layout.buffers[0].stride = cast(i32, sizeof(_sspine_vertex_t));
    pip_desc.layout.attrs[0].format = SG_VERTEXFORMAT_FLOAT2;
    pip_desc.layout.attrs[1].format = SG_VERTEXFORMAT_FLOAT2;
    pip_desc.layout.attrs[2].format = SG_VERTEXFORMAT_UBYTE4N;
    pip_desc.index_type = SG_INDEXTYPE_UINT32;
    pip_desc.sample_count = desc.sample_count;
    pip_desc.depth.pixel_format = desc.depth_format;
    pip_desc.colors[0].pixel_format = desc.color_format;
    pip_desc.colors[0].write_mask = desc.color_write_mask;
    pip_desc.colors[0].blend.enabled = true;
    pip_desc.colors[0].blend.src_factor_rgb = SG_BLENDFACTOR_ONE;
    pip_desc.colors[0].blend.dst_factor_rgb = SG_BLENDFACTOR_ONE_MINUS_SRC_ALPHA;
    pip_desc.colors[0].blend.src_factor_alpha = SG_BLENDFACTOR_ONE;
    pip_desc.colors[0].blend.dst_factor_alpha = SG_BLENDFACTOR_ONE_MINUS_SRC_ALPHA;
    pip_desc.label = "sspine-pip-normal/additive";
    ctx.pip.normal_additive = sg_make_pipeline(&pip_desc);
    pip_desc.colors[0].blend.src_factor_rgb = SG_BLENDFACTOR_DST_COLOR;
    pip_desc.colors[0].blend.dst_factor_rgb = SG_BLENDFACTOR_ONE_MINUS_SRC_COLOR;
    pip_desc.colors[0].blend.src_factor_alpha = SG_BLENDFACTOR_DST_ALPHA;
    pip_desc.colors[0].blend.dst_factor_alpha = SG_BLENDFACTOR_ONE_MINUS_SRC_ALPHA;
    pip_desc.label = "sspine-pip-multiply";
    ctx.pip.multiply = sg_make_pipeline(&pip_desc);
    return SSPINE_RESOURCESTATE_VALID;
}

void _sspine_deinit_context(_sspine_context_t* ctx) {
    sg_destroy_pipeline(ctx.pip.normal_additive);
    sg_destroy_pipeline(ctx.pip.multiply);
    sg_destroy_buffer(ctx.ibuf);
    sg_destroy_buffer(ctx.vbuf);
    if ctx.commands.ptr != null {
        _sspine_free(ctx.commands.ptr);
        ctx.commands.ptr = null;
    }
    if ctx.indices.ptr != null {
        _sspine_free(ctx.indices.ptr);
        ctx.indices.ptr = null;
    }
    if ctx.vertices.ptr != null {
        _sspine_free(ctx.vertices.ptr);
        ctx.vertices.ptr = null;
    }
}

void _sspine_destroy_context(sspine_context ctx_id) {
    _sspine_context_t* ctx = _sspine_lookup_context(ctx_id.id);
    if ctx != null {
        _sspine_deinit_context(ctx);
        _sspine_context_pool_t* p = &_sspine.context_pool;
        _sspine_clear(ctx, cast(u64, sizeof(_sspine_context_t)));
        _sspine_pool_free_index(&p.pool, _sspine_slot_index(ctx_id.id));
    }
}

void _sspine_destroy_all_contexts() {
    _sspine_context_pool_t* p = &_sspine.context_pool;
    for i32 i = 0; i < p.pool.size; i++ {
        _sspine_context_t* ctx = &p.items[i];
        _sspine_destroy_context(_sspine_make_context_handle(ctx.slot.id));
    }
}

sspine_context_desc _sspine_context_desc_defaults(sspine_context_desc* desc) {
    sspine_context_desc res = *desc;
    res.max_vertices = desc.max_vertices == 0 ? 1 << 16 : desc.max_vertices;
    res.max_commands = desc.max_commands == 0 ? 1 << 14 : desc.max_commands;
    return res;
}

bool _sspine_is_default_context(sspine_context ctx_id) {
    return ctx_id.id == 0x00010001;
}

